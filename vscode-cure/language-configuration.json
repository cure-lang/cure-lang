{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(mod|fn|type|typealias|rec|interface|implementation|proto|impl|actor|sup|app|fsm|macro|match|pickup|if|elif|else|try|catch|finally|receive|after|on_[a-z_]+)\\b|(=|->|=>|\\bdo)\\s*$",
    "decreaseIndentPattern": "^\\s*(elif|else|catch|finally|after)\\b"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_$]*\\??|:[a-zA-Z_][a-zA-Z0-9_]*[?!]?"
}
