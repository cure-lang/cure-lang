{
  "name": "vscode-cure",
  "displayName": "Cure Language Support",
  "description": "Rich language support, LSP diagnostics, MCP AI tooling, and interactive REPL for Cure",
  "version": "0.34.0",
  "publisher": "cure-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/cure-lang/cure.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cure",
    "onCommand:cure.openRepl",
    "onCommand:cure.mcp.getDocs",
    "onCommand:cure.mcp.getHelp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cure",
        "aliases": [
          "Cure",
          "cure"
        ],
        "extensions": [
          ".cure"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cure",
        "scopeName": "source.cure",
        "path": "./syntaxes/cure.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cure",
        "path": "./snippets/cure.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "cure.restartLsp",
        "title": "Cure: Restart LSP Server",
        "category": "Cure"
      },
      {
        "command": "cure.openRepl",
        "title": "Cure: Open Interactive REPL",
        "category": "Cure"
      },
      {
        "command": "cure.mcp.getDocs",
        "title": "Cure MCP: View Stdlib Documentation",
        "category": "Cure"
      },
      {
        "command": "cure.mcp.getHelp",
        "title": "Cure MCP: View Syntax Help Topic",
        "category": "Cure"
      },
      {
        "command": "cure.mcp.typeCheck",
        "title": "Cure MCP: Type-Check Current Document",
        "category": "Cure"
      },
      {
        "command": "cure.mcp.parse",
        "title": "Cure MCP: View MetaAST Summary",
        "category": "Cure"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Cure Configuration",
      "properties": {
        "cure.lsp.path": {
          "type": "string",
          "default": "cure-lsp",
          "description": "Path to the cure-lsp executable binary or script."
        },
        "cure.mcp.path": {
          "type": "string",
          "default": "cure",
          "description": "Path to the cure executable binary used to launch cure mcp."
        },
        "cure.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Model Context Protocol (MCP) integration over stdio."
        },
        "cure.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Cure LSP server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.3"
  }
}
