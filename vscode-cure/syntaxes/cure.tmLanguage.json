{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cure",
  "scopeName": "source.cure",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#atoms"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#otp_keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.cure",
          "begin": "#\\|",
          "end": "\\|#"
        },
        {
          "name": "comment.line.number-sign.cure",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cure",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cure",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.line.cure",
          "begin": "#\\{",
          "end": "\\}",
          "captures": {
            "0": {
              "name": "punctuation.section.embedded.cure"
            }
          },
          "patterns": [
            {
              "include": "source.cure"
            }
          ]
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "name": "constant.other.symbol.cure",
          "match": ":[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "constant.other.symbol.cure",
          "match": ":\"[^\"]*\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cure",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.cure",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.cure",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.cure",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cure",
          "match": "\\b(match|pickup|if|elif|else|then|for|do|end|in|try|catch|finally|throw|return|yield|spawn|send|receive|after|when|where)\\b"
        },
        {
          "name": "keyword.other.declaration.cure",
          "match": "\\b(mod|use|as|type|typealias|opaque|primitive|indexed|indices|rec|proto|impl|local|interface|implementation|deriving)\\b"
        },
        {
          "name": "keyword.other.function.cure",
          "match": "\\b(fn|let|extern|proof|unsafe|quote)\\b"
        },
        {
          "name": "storage.type.quantity.cure",
          "match": "\\b(erased|linear|affine)\\b"
        },
        {
          "name": "keyword.operator.logical.cure",
          "match": "\\b(and|or|not|band|bor|bxor|bsl|bsr|bnot)\\b"
        },
        {
          "name": "constant.language.cure",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "otp_keywords": {
      "patterns": [
        {
          "name": "keyword.other.otp.cure",
          "match": "\\b(actor|sup|app|fsm|state|event|transition|on_transition|on_enter|on_exit|on_failure|on_timer)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.cure",
          "match": "\\b(Int|Float|String|Atom|Bool|List|Map|Tuple|Result|Option|Effect|Unit|Pid|Reference|Port)\\b"
        },
        {
          "name": "entity.name.type.cure",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "name": "constant.language.constructor.cure",
          "match": "\\b(Ok|Error|Some|None|True|False)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.melquiades.cure",
          "match": "(<-\\||✉)"
        },
        {
          "name": "keyword.operator.arrow.cure",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.cure",
          "match": "([:=|&\\-+*/%<>!^~]+)"
        }
      ]
    }
  }
}
