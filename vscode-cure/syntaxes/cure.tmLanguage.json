{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cure",
  "scopeName": "source.cure",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#regexes"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#contextual"
        },
        {
          "include": "#macro_vocabulary"
        },
        {
          "include": "#decorators"
        },
        {
          "include": "#transitions"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#atoms"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#holes"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#identifiers"
        },
        {
          "include": "#types"
        },
        {
          "include": "#groups"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.cure",
          "begin": "###",
          "end": "^\\s*###.*$"
        },
        {
          "name": "comment.line.documentation.cure",
          "match": "##.*$"
        },
        {
          "name": "comment.line.number-sign.cure",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cure",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cure",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.line.cure",
          "contentName": "source.cure",
          "begin": "#\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.cure"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.cure"
            }
          },
          "patterns": [
            {
              "include": "#code"
            }
          ]
        }
      ]
    },
    "chars": {
      "name": "constant.character.cure",
      "match": "'''|'[^'\\\\\\n]'|'\\\\.[^'\\n]*'"
    },
    "regexes": {
      "match": "(?:(?<=[^=<>!:|&^~\\\\+\\-*/.%$?]=)|(?<=[^-]->)|(?<==>)|(?<=\\|>)|(?<=[^:]:)|(?<=[^|\\-]\\|)|(?<=[,;(\\[{])|(?<=\\breturn))\\s*(/(?:[^/\\\\\\n]|\\\\.)*/[imsxufrUE]*)",
      "captures": {
        "1": {
          "name": "string.regexp.cure"
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(mod)\\s+([A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            },
            "2": {
              "name": "entity.name.namespace.cure"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([a-z_][a-zA-Z0-9_$]*\\??|`[^`\\n]*`)",
          "captures": {
            "1": {
              "name": "storage.type.function.cure"
            },
            "2": {
              "name": "entity.name.function.cure"
            }
          }
        },
        {
          "match": "(\\b(?:type|typealias|rec|interface|implementation|proto|impl)\\b)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            },
            "2": {
              "name": "entity.name.type.cure"
            }
          }
        },
        {
          "match": "(\\b(?:actor|app|behavior|fsm|sup|proof)\\b)\\s+([A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "storage.type.cure"
            },
            "2": {
              "name": "entity.name.type.cure"
            }
          }
        },
        {
          "match": "\\b(macro)\\s+([A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-z_][a-zA-Z0-9_$]*\\??)",
          "captures": {
            "1": {
              "name": "storage.type.cure"
            },
            "2": {
              "name": "entity.name.function.macro.cure"
            }
          }
        }
      ]
    },
    "contextual": {
      "patterns": [
        {
          "match": "^\\s*(have)\\s+(?=[a-z_])",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "\\b(requires)\\s+(?=[A-Z])",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "^\\s*(precedencegroup)\\s+(?=[A-Z])",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "^\\s*(infix|prefix|postfix)\\s+(?=`)",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "\\b(proof)\\s+(chain)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            },
            "2": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "^\\s*(because)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "^\\s*(on_[a-z_]+)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.special.cure"
            }
          }
        }
      ]
    },
    "macro_vocabulary": {
      "patterns": [
        {
          "match": "^\\s*(syntax)\\s+(family)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            },
            "2": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "^\\s*(syntax|example|literal)\\s+((?!\\b(?:mod|fn|let|type|typealias|opaque|primitive|indexed|indices|rec|proto|impl|local|use|as|interface|implementation|deriving|match|pickup|if|elif|else|then|for|do|end|in|try|catch|finally|throw|return|yield|spawn|send|receive|after|when|where|and|or|not|band|bor|bxor|bsl|bsr|bnot|extern|quote|unsafe|actor|app|behavior|fsm|sup|proof|macro)\\b)[a-z_][a-zA-Z0-9_$]*\\??)",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            },
            "2": {
              "name": "entity.name.function.macro.cure"
            }
          }
        },
        {
          "match": "(?:^\\s*)?\\b(expands\\s+with|computed(?:\\s+directly)?\\s+by)\\s+([a-z_][a-zA-Z0-9_$]*\\??)",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            },
            "2": {
              "name": "entity.name.function.cure"
            }
          }
        },
        {
          "match": "^\\s*(optional|repeated|one_or_more)\\s+((?!\\b(?:mod|fn|let|type|typealias|opaque|primitive|indexed|indices|rec|proto|impl|local|use|as|interface|implementation|deriving|match|pickup|if|elif|else|then|for|do|end|in|try|catch|finally|throw|return|yield|spawn|send|receive|after|when|where|and|or|not|band|bor|bxor|bsl|bsr|bnot|extern|quote|unsafe|actor|app|behavior|fsm|sup|proof|macro)\\b)[a-z_][a-zA-Z0-9_$]*\\??)",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            },
            "2": {
              "name": "variable.other.property.cure"
            }
          }
        },
        {
          "match": "^\\s*(accepts|expands|explain|fail|open|includes|keyword)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            }
          }
        },
        {
          "match": "\\b(becomes|contextual|expands)\\b",
          "name": "keyword.control.cure"
        },
        {
          "match": "^\\s*((?!\\b(?:mod|fn|let|type|typealias|opaque|primitive|indexed|indices|rec|proto|impl|local|use|as|interface|implementation|deriving|match|pickup|if|elif|else|then|for|do|end|in|try|catch|finally|throw|return|yield|spawn|send|receive|after|when|where|and|or|not|band|bor|bxor|bsl|bsr|bnot|extern|quote|unsafe|actor|app|behavior|fsm|sup|proof|macro)\\b)[a-z_][a-zA-Z0-9_$]*\\??)\\s+([A-Z][a-zA-Z0-9_]*)\\s*$",
          "captures": {
            "1": {
              "name": "variable.other.property.cure"
            },
            "2": {
              "name": "entity.name.type.cure"
            }
          }
        },
        {
          "match": "(?<=<)([a-z_][a-zA-Z0-9_$]*\\??)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "variable.parameter.cure"
            }
          }
        },
        {
          "match": "(?<=>)\\s*(is)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.cure"
            }
          }
        }
      ]
    },
    "decorators": {
      "match": "(@)([a-z_][a-zA-Z0-9_$]*\\??)",
      "captures": {
        "1": {
          "name": "punctuation.definition.decorator.cure"
        },
        "2": {
          "name": "entity.name.function.decorator.cure"
        }
      }
    },
    "transitions": {
      "patterns": [
        {
          "match": "(--)([a-zA-Z_][a-zA-Z0-9_]*\\??)",
          "captures": {
            "1": {
              "name": "keyword.operator.transition.cure"
            },
            "2": {
              "name": "entity.name.label.cure"
            }
          }
        },
        {
          "name": "keyword.operator.transition.cure",
          "match": "!?-->"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cure",
          "match": "\\b(?:mod|fn|let|type|typealias|opaque|primitive|indexed|indices|rec|proto|impl|local|use|as|interface|implementation|deriving|match|pickup|if|elif|else|then|for|do|end|in|try|catch|finally|throw|return|yield|spawn|send|receive|after|when|where|extern|quote|unsafe)\\b"
        },
        {
          "name": "keyword.operator.word.cure",
          "match": "\\b(?:and|or|not|band|bor|bxor|bsl|bsr|bnot)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cure",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.nil.cure",
          "match": "\\bnil\\b"
        },
        {
          "name": "support.constant.constructor.cure",
          "match": "\\b(?:Ok|Error|Some|None|True|False|Z|S)\\b"
        }
      ]
    },
    "atoms": {
      "name": "constant.other.symbol.cure",
      "match": ":[a-zA-Z_][a-zA-Z0-9_]*[?!]?"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.cure",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.cure",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.cure",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.cure",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "holes": {
      "name": "variable.language.hole.cure",
      "match": "\\?[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "calls": {
      "match": "\\b([a-z_][a-zA-Z0-9_$]*\\??)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.cure"
        }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.quoted.cure",
          "match": "`[^`\\n]*`"
        },
        {
          "name": "variable.other.cure",
          "match": "\\b[a-z_][a-zA-Z0-9_$]*\\??"
        }
      ]
    },
    "types": {
      "name": "entity.name.type.cure",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.send.cure",
          "match": "<-\\||✉"
        },
        {
          "name": "keyword.operator.pipe.cure",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.cure",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.cure",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.cure",
          "match": "::|[+\\-*/=<>!|&^~\\\\]+|[:.%$?]"
        }
      ]
    },
    "groups": {
      "patterns": [
        {
          "begin": "%?\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.begin.cure"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.end.cure"
            }
          },
          "patterns": [
            {
              "include": "#code"
            }
          ]
        },
        {
          "name": "punctuation.section.parens.cure",
          "match": "\\$?\\(|\\)"
        },
        {
          "name": "punctuation.section.brackets.cure",
          "match": "%?\\[|\\]"
        }
      ]
    },
    "punctuation": {
      "name": "punctuation.separator.cure",
      "match": "[,;]"
    }
  }
}
