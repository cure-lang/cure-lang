mod JsonDerive
  use Std.Json
  use Std.Result

  ###
  `@derive(ToJSON, FromJSON)` generates ordinary interface implementations.
  Encoding constructs a structured `Value.Object`; decoding looks up each
  required member and routes its value through that field's `FromJSON`
  implementation. Derivation never concatenates or reparses field JSON.
  ###

  @derive(ToJSON, FromJSON)
  rec Person
    name: String
    age: Int

  fn main() -> String = to_json(Person{name: "Ada", age: 36})

  fn decode_person(source: String) -> Result(Person, DecodeError) =
    assert_type decode_as(source) : Result(Person, DecodeError)
