mod Pool.Test
  ###
  Positive tests for `Pool.Core`, run by `cure test`.

  These assert the *runtime* behaviour that the types predict: a two-slot pool
  can be cycled, the task result is computed, and the pool comes back to its
  starting shape. The compile-time guarantees (over-checkout, double-return,
  leak) are proven by the fixtures under `negative/`, which must fail to
  compile -- see `negative/run_negative.sh`.

  Bindings use inference rather than explicit `Pool(...)` annotations, for the
  cross-file reason documented in `docs/POOL.md`.
  ###

  use Std.Test
  use Pool.Core

  ## A fresh two-slot pool reports its runtime capacity.
  fn test_capacity() -> Unit =
    let p = make(S(S(Z())), 2)
    Std.Test.assert_eq(capacity(S(S(Z())), Z(), p), 2)

  ## One full checkout/use/checkin cycle returns the task result.
  fn test_cycle_result() -> Unit =
    let p0 = make(S(S(Z())), 2)
    let cycle = with_resource(S(Z()), Z(), S(Z()), 7, 3, p0)
    Std.Test.assert_eq(cycle.1, 10)

  ## The pool comes back exactly as it started: `Pool(2,0)`.
  fn test_cycle_restores_the_pool() -> Unit =
    let p0 = make(S(S(Z())), 2)
    let cycle = with_resource(S(Z()), Z(), S(Z()), 7, 3, p0)
    Std.Test.assert_eq(capacity(S(S(Z())), Z(), cycle.2), 2)

  ## The index-level `+` is total and computes: `2 + 1 = 3`.
  fn test_plus_is_total() -> Unit =
    Std.Test.assert_eq(to_int(plus(S(S(Z())), S(Z()))), 3)

  ## A one-slot pool can be checked out exactly once.
  fn test_single_slot_cycle() -> Unit =
    let p0 = make(S(Z()), 1)
    let cycle = with_resource(Z(), Z(), Z(), 5, 2, p0)
    Std.Test.assert_eq(cycle.1, 7)

  ## Render a `Nat` index as an `Int` for assertions. Structural and total.
  local fn to_int(n: Nat) -> Int =
    match n
      Z() -> 0
      S(k) -> to_int(k) + 1
