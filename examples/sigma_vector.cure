mod SigmaVector
  use Std.{List, Tuple}

  ## Sigma-style sized list example.
  #
  # `Std.Vector` is now a real indexed family checked by the dependent
  # kernel. This example stays on the legacy runtime compiler path and
  # uses a plain tuple `%[length, items]` instead of the old tuple-backed
  # Vector helper API.

  ## Build a "sized list" -- a pair whose first component is the
  ## claimed length, and whose second component is the list data.
  fn make_sized(items: List(Int)) -> Tuple(Int, List(Int)) =
    %[Std.List.length(items), items]

  ## Project the length out of a sized list.
  fn claimed_length(sv: Tuple(Int, List(Int))) -> Int =
    Std.Tuple.first(sv)

  ## Project the payload out of a sized vector.
  fn payload(sv: Tuple(Int, List(Int))) -> List(Int) =
    Std.Tuple.second(sv)

  ## Total length of two sized lists.
  fn combined_length(a: Tuple(Int, List(Int)), b: Tuple(Int, List(Int))) -> Int =
    claimed_length(a) + claimed_length(b)

  ## Demonstration entry point:
  ##   combined_length(make_sized([1, 2, 3]), make_sized([10, 20])) = 5
  fn main() -> Int =
    combined_length(
      make_sized([1, 2, 3]),
      make_sized([10, 20])
    )
