mod DerivedShow
  use Std.Show
  use Std.Equatable
  use Std.Comparable

  ## @derive(Show, Equatable, Ord) on records (v0.19.0).
  ##
  ## The decorator synthesises a `show/1`, `eq/2`, and `compare/2`
  ## function per record, exported as regular module functions and
  ## plugged into the protocol registry.

  @derive(Show, Equatable, Ord)
  rec Point
    x: Int
    y: Int

  fn origin() -> Point = Point{x: 0, y: 0}

  fn main() -> Int =
    let p = Point{x: 1, y: 2}
    let q = Point{x: 1, y: 2}
    let r = Point{x: 2, y: 0}
    # All calls resolve through the synthesised implementations.
    pickup
      p == q and p < r and show(p) == "Point{x: 1, y: 2}" -> 1
      else                                                 -> 0
