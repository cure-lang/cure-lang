mod LengthIndexed
  ## Standalone indexed-data example.
  ##
  ## `Std.Vector.empty()` still needs expected-type implicit solving for its
  ## all-erased constructor arguments, so this example uses a smaller indexed
  ## family whose constructors carry enough information at the call site.

  type Nat = Z | S(Nat)

  type Length indices (n: Nat)
    zero_len : Length(Z)
    succ_len : Length(n) -> Length(S(n))

  fn zero() -> Length(Z) =
    zero_len()

  fn one() -> Length(S(Z)) =
    succ_len(zero())

  fn two() -> Length(S(S(Z))) =
    succ_len(one())

  fn main() -> Length(S(S(Z))) =
    two()
