mod Mt03
  type Nat = Z | S(Nat)
  fn plus(m: Nat, n: Nat) -> Nat = match m
    Z() -> n
    S(k) -> S(plus(k, n))
  fn plus_zero_right(n: Nat) -> Equivalent(Nat, plus(n, Z), n) = match n
    Z() -> reflexive(Z)
    S(k) -> rewrite plus_zero_right(k) in match k
      Z() -> reflexive(S(Z))
      S(j) -> reflexive(S(S(j)))
end
