mod Dep06
  type Nat = Zero | Suc(Nat)
  type Vector(a: Type) indices (n: Nat)
    empty : Vector(a, Zero)
    prepend : a -> Vector(a, n) -> Vector(a, Suc(n))
  type Fin indices (n: Nat)
    fz : Fin(Suc(m))
    fs : Fin(m) -> Fin(Suc(m))
  fn lookup({a: Type},{n: Nat}, i: Fin(n), v: Vector(a, n)) -> a = match i
    fz() -> match v
      prepend(x, xs) -> x
    fs(j) -> match v
      prepend(x, xs) -> lookup(j, xs)
  fn vec() -> Vector(Nat, Suc(Suc(Zero))) = prepend(Suc(Zero()), prepend(Zero(), empty()))
  fn at0() -> Nat = lookup(fz(), vec())
  fn at1() -> Nat = lookup(fs(fz()), vec())
end
