## Compile-time parser for regex literal patterns. It validates the complete
## literal and returns a structured syntax-tree error when parsing stops early.
@group(:text)
mod Std.Regex.Syntax.Parser
  use Std.Regex.Syntax.Model
  use Std.Regex.Syntax.Class
  use Std.Char

  fn parse_literal(input: List(Char)) -> LiteralParse =
    match input
      ['(', '*', 'L', 'F', ')' | rest] -> parse_literal_with_policy(LiteralLFPolicy, rest)
      ['(', '*', 'C', 'R', ')' | rest] -> parse_literal_with_policy(LiteralCRPolicy, rest)
      ['(', '*', 'C', 'R', 'L', 'F', ')' | rest] -> parse_literal_with_policy(LiteralCRLFPolicy, rest)
      ['(', '*', 'A', 'N', 'Y', 'C', 'R', 'L', 'F', ')' | rest] -> parse_literal_with_policy(LiteralAnyCRLFPolicy, rest)
      ['(', '*', 'A', 'N', 'Y', ')' | rest] -> parse_literal_with_policy(LiteralAnyUnicodePolicy, rest)
      ['(', '*', 'B', 'S', 'R', '_', 'A', 'N', 'Y', 'C', 'R', 'L', 'F', ')' | rest] -> parse_literal_with_policy(LiteralAnyCRLFPolicy, rest)
      ['(', '*', 'B', 'S', 'R', '_', 'U', 'N', 'I', 'C', 'O', 'D', 'E', ')' | rest] -> parse_literal_with_policy(LiteralAnyUnicodePolicy, rest)
      _ -> parse_literal_complete(parse_literal_alternate_fuel(input, literal_fuel(input)), input)

  fn parse_literal_with_policy(policy: LiteralNewlinePolicy, input: List(Char)) -> LiteralParse =
    match parse_literal_complete(parse_literal_alternate_fuel(input, literal_fuel(input)), input)
      LiteralParsed(pattern, rest) -> LiteralParsed(LiteralConfigured(policy, pattern), rest)
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_complete(result: LiteralParse, original: List(Char)) -> LiteralParse = match result
    LiteralParsed(pattern, rest) -> match rest
      [] -> LiteralParsed(pattern, [])
      _ -> LiteralLocatedInvalid(:UnexpectedRegexToken, literal_suffix_offset(original, rest), 1)
    LiteralInvalid(reason) -> LiteralInvalid(reason)
    LiteralAtInvalid(reason, suffix, width) -> LiteralLocatedInvalid(reason, literal_suffix_offset(original, suffix), width)
    LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_alternate_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_sequence_fuel(input, next_fuel)
      LiteralParsed(left, rest) -> parse_literal_alternate_tail_fuel(left, rest, next_fuel)
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_alternate_tail_fuel(left: LiteralPattern, input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralParsed(left, input)
    S(next_fuel) -> match input
      ['|' | rest] -> match parse_literal_sequence_fuel(rest, next_fuel)
        LiteralParsed(right, tail) -> parse_literal_alternate_tail_fuel(LiteralAlternate(left, right), tail, next_fuel)
        LiteralInvalid(reason) -> LiteralInvalid(reason)
        LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
        LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)
      _ -> LiteralParsed(left, input)

  fn parse_literal_sequence_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralParsed(LiteralEmpty, [])
      [head | _] -> pickup
        is_literal_stop(head) -> LiteralParsed(LiteralEmpty, input)
        else -> match parse_literal_repetition_fuel(input, next_fuel)
          LiteralParsed(first, rest) -> parse_literal_sequence_tail_fuel(first, rest, next_fuel)
          LiteralInvalid(reason) -> LiteralInvalid(reason)
          LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
          LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_sequence_tail_fuel(left: LiteralPattern, input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralParsed(left, input)
    S(next_fuel) -> match input
      [] -> LiteralParsed(left, [])
      [head | _] -> pickup
        is_literal_stop(head) -> LiteralParsed(left, input)
        else -> match parse_literal_repetition_fuel(input, next_fuel)
          LiteralParsed(right, rest) -> parse_literal_sequence_tail_fuel(LiteralSequence(left, right), rest, next_fuel)
          LiteralInvalid(reason) -> LiteralInvalid(reason)
          LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
          LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_repetition_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_atom_fuel(input, next_fuel)
      LiteralParsed(atom, ['*', '+' | rest]) -> LiteralParsed(LiteralAtomic(LiteralRepeat(atom, false)), rest)
      LiteralParsed(atom, ['+', '+' | rest]) -> LiteralParsed(LiteralAtomic(LiteralPlus(atom, false)), rest)
      LiteralParsed(atom, ['?', '+' | rest]) -> LiteralParsed(LiteralAtomic(LiteralOptional(atom, false)), rest)
      LiteralParsed(atom, ['*', '?' | rest]) -> LiteralParsed(LiteralRepeat(atom, true), rest)
      LiteralParsed(atom, ['+', '?' | rest]) -> LiteralParsed(LiteralPlus(atom, true), rest)
      LiteralParsed(atom, ['?', '?' | rest]) -> LiteralParsed(LiteralOptional(atom, true), rest)
      LiteralParsed(atom, ['*' | rest]) -> LiteralParsed(LiteralRepeat(atom, false), rest)
      LiteralParsed(atom, ['+' | rest]) -> LiteralParsed(LiteralPlus(atom, false), rest)
      LiteralParsed(atom, ['?' | rest]) -> LiteralParsed(LiteralOptional(atom, false), rest)
      LiteralParsed(atom, ['{' | rest]) -> parse_literal_bounded(atom, rest, ['{' | rest])
      result -> result

  fn parse_literal_count(input: List(Char), value: Nat, seen: Bool) -> LiteralCountParse = match input
    [] -> LiteralCountParsed(value, seen, [])
    [char | rest] -> match literal_decimal_digit(char)
      Some(digit) -> parse_literal_count(rest, plus(literal_nat_times_ten(value), digit), true)
      None() -> LiteralCountParsed(value, seen, input)

  fn bounded_count_allowed(value: Nat) -> Bool =
    not literal_nat_less(literal_quantifier_limit(), value)

  fn literal_bounded_failure(reason: Atom, origin: List(Char)) -> LiteralParse =
    LiteralAtInvalid(reason, origin, literal_delimited_width(origin, '}'))

  fn finish_literal_exact_bounded(atom: LiteralPattern, count: Nat, rest: List(Char), origin: List(Char)) -> LiteralParse = pickup
    bounded_count_allowed(count) -> match rest
      ['?' | tail] -> LiteralParsed(LiteralBoundedExact(atom, count), tail)
      ['+' | tail] -> LiteralParsed(LiteralAtomic(LiteralBoundedExact(atom, count)), tail)
      _ -> LiteralParsed(LiteralBoundedExact(atom, count), rest)
    else -> literal_bounded_failure(:RegexQuantifierTooLarge, origin)

  fn finish_literal_at_least_bounded(atom: LiteralPattern, count: Nat, rest: List(Char), origin: List(Char)) -> LiteralParse = pickup
    bounded_count_allowed(count) -> match rest
      ['?' | tail] -> LiteralParsed(LiteralBoundedAtLeast(atom, count, true), tail)
      ['+' | tail] -> LiteralParsed(LiteralAtomic(LiteralBoundedAtLeast(atom, count, false)), tail)
      _ -> LiteralParsed(LiteralBoundedAtLeast(atom, count, false), rest)
    else -> literal_bounded_failure(:RegexQuantifierTooLarge, origin)

  fn finish_literal_between_bounded(atom: LiteralPattern, minimum: Nat, maximum: Nat, rest: List(Char), origin: List(Char)) -> LiteralParse = pickup
    not bounded_count_allowed(minimum) or not bounded_count_allowed(maximum) -> literal_bounded_failure(:RegexQuantifierTooLarge, origin)
    literal_nat_less(maximum, minimum) -> literal_bounded_failure(:RegexQuantifierRangeReversed, origin)
    else -> match rest
      ['?' | tail] -> LiteralParsed(LiteralBoundedBetween(atom, minimum, maximum, true), tail)
      ['+' | tail] -> LiteralParsed(LiteralAtomic(LiteralBoundedBetween(atom, minimum, maximum, false)), tail)
      _ -> LiteralParsed(LiteralBoundedBetween(atom, minimum, maximum, false), rest)

  fn parse_literal_bounded_maximum(atom: LiteralPattern, minimum: Nat, input: List(Char), origin: List(Char)) -> LiteralParse = match parse_literal_count(input, Z(), false)
    LiteralCountInvalid(reason) -> literal_bounded_failure(reason, origin)
    LiteralCountParsed(maximum, seen, rest) -> pickup
      not seen -> literal_bounded_failure(:MissingRegexQuantifierMaximum, origin)
      else -> match rest
        ['}' | tail] -> finish_literal_between_bounded(atom, minimum, maximum, tail, origin)
        [] -> literal_bounded_failure(:UnclosedRegexQuantifier, origin)
        _ -> literal_bounded_failure(:MalformedRegexQuantifier, origin)

  fn parse_literal_bounded(atom: LiteralPattern, input: List(Char), origin: List(Char)) -> LiteralParse = match parse_literal_count(input, Z(), false)
    LiteralCountInvalid(reason) -> literal_bounded_failure(reason, origin)
    LiteralCountParsed(minimum, seen, rest) -> pickup
      not seen -> literal_bounded_failure(:MissingRegexQuantifierMinimum, origin)
      else -> match rest
        ['}' | tail] -> finish_literal_exact_bounded(atom, minimum, tail, origin)
        [',' , '}' | tail] -> finish_literal_at_least_bounded(atom, minimum, tail, origin)
        [',' | tail] -> parse_literal_bounded_maximum(atom, minimum, tail, origin)
        [] -> literal_bounded_failure(:UnclosedRegexQuantifier, origin)
        _ -> literal_bounded_failure(:MalformedRegexQuantifier, origin)

  fn parse_literal_atom_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralInvalid(:MissingRegexAtom)
      ['.' | rest] -> LiteralParsed(LiteralAny, rest)
      ['^' | rest] -> LiteralParsed(LiteralStart, rest)
      ['$' | rest] -> LiteralParsed(LiteralEnd, rest)
      ['(' | rest] -> parse_literal_group_fuel(rest, next_fuel, ['(' | rest])
      ['[' | rest] -> parse_literal_class(rest, ['[' | rest])
      ['\\' | rest] -> parse_literal_escape(rest, ['\\' | rest])
      ['*' | rest] -> LiteralAtInvalid(:QuantifierWithoutAtom, ['*' | rest], 1)
      ['+' | rest] -> LiteralAtInvalid(:QuantifierWithoutAtom, ['+' | rest], 1)
      ['?' | rest] -> LiteralAtInvalid(:QuantifierWithoutAtom, ['?' | rest], 1)
      ['{' | rest] -> LiteralAtInvalid(:QuantifierWithoutAtom, ['{' | rest], literal_delimited_width(['{' | rest], '}'))
      [char | rest] -> LiteralParsed(LiteralExact(char), rest)

  fn parse_literal_group_fuel(input: List(Char), fuel: Nat, origin: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      ['*', 'C', 'R', ')' | _] -> LiteralAtInvalid(:UnsupportedRegexNewlineControl, origin, literal_delimited_width(origin, ')'))
      ['*', 'L', 'F', ')' | _] -> LiteralAtInvalid(:UnsupportedRegexNewlineControl, origin, literal_delimited_width(origin, ')'))
      ['*', 'C', 'R', 'L', 'F', ')' | _] -> LiteralAtInvalid(:UnsupportedRegexNewlineControl, origin, literal_delimited_width(origin, ')'))
      ['*', 'A', 'N', 'Y', 'C', 'R', 'L', 'F', ')' | _] -> LiteralAtInvalid(:UnsupportedRegexNewlineControl, origin, literal_delimited_width(origin, ')'))
      ['*', 'A', 'N', 'Y', ')' | _] -> LiteralAtInvalid(:UnsupportedRegexNewlineControl, origin, literal_delimited_width(origin, ')'))
      ['*', 'B', 'S', 'R', '_', 'A', 'N', 'Y', 'C', 'R', 'L', 'F', ')' | _] -> LiteralAtInvalid(:UnsupportedRegexNewlineControl, origin, literal_delimited_width(origin, ')'))
      ['*', 'B', 'S', 'R', '_', 'U', 'N', 'I', 'C', 'O', 'D', 'E', ')' | _] -> LiteralAtInvalid(:UnsupportedRegexNewlineControl, origin, literal_delimited_width(origin, ')'))
      ['?', ':' | rest] -> parse_literal_non_capture_fuel(rest, next_fuel, origin)
      ['?', '|' | rest] -> parse_literal_branch_reset_fuel(rest, next_fuel, origin, [])
      ['?', 'R' | _] -> LiteralAtInvalid(:UnsupportedRegexRecursion, origin, 3)
      ['?', '0' | _] -> LiteralAtInvalid(:UnsupportedRegexRecursion, origin, 3)
      ['?', '(' | rest] -> parse_literal_conditional_header(rest, next_fuel, origin, [])
      ['?', '<', '=' | _] -> LiteralAtInvalid(:UnsupportedRegexLookbehind, origin, 4)
      ['?', '<', '!' | _] -> LiteralAtInvalid(:UnsupportedRegexLookbehind, origin, 4)
      ['?', '<', first | rest] -> parse_literal_named_capture_angle(first, rest, next_fuel, origin, [])
      ['?', '=' | _] -> LiteralAtInvalid(:UnsupportedRegexLookahead, origin, 3)
      ['?', '!' | _] -> LiteralAtInvalid(:UnsupportedRegexLookahead, origin, 3)
      ['?', '>' | rest] -> parse_literal_atomic_fuel(rest, next_fuel, origin)
      ['?', '\'' | rest] -> parse_literal_named_capture_quote(rest, next_fuel, origin, [])
      ['?', 'P', '<' | rest] -> parse_literal_named_capture_angle_tail(rest, next_fuel, origin, [])
      ['?', 'i' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', 'm' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', 's' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', 'x' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', 'u' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', 'f' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', 'U' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', 'E' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', '-' | _] -> LiteralAtInvalid(:UnsupportedRegexInlineOptions, origin, 3)
      ['?', char | _] -> match literal_decimal_digit(char)
        Some(_) -> LiteralAtInvalid(:UnsupportedRegexRecursion, origin, 3)
        None() -> parse_literal_capture_fuel(input, next_fuel, origin)
      _ -> parse_literal_capture_fuel(input, next_fuel, origin)

  fn parse_literal_named_capture_angle(first: Char, input: List(Char), fuel: Nat, origin: List(Char), reversed: List(Char)) -> LiteralParse =
    parse_literal_named_capture_angle_tail([first | input], fuel, origin, reversed)

  fn parse_literal_named_capture_angle_tail(input: List(Char), fuel: Nat, origin: List(Char), reversed: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralAtInvalid(:UnclosedRegexCaptureName, origin, literal_delimited_width(origin, '>'))
      ['>' | rest] -> match reversed
        [] -> LiteralAtInvalid(:EmptyRegexCaptureName, origin, literal_delimited_width(origin, '>'))
        _ -> match capture_name_is_valid(reverse_chars(reversed))
          true -> parse_literal_named_capture_body(rest, next_fuel, origin, Std.String.from_characters(reverse_chars(reversed)))
          false -> LiteralAtInvalid(:MalformedRegexCaptureName, origin, literal_delimited_width(origin, '>'))
      [char | rest] -> pickup
        char == '>' or char == ')' -> LiteralAtInvalid(:MalformedRegexCaptureName, origin, literal_delimited_width(origin, '>'))
        else -> parse_literal_named_capture_angle_tail(rest, next_fuel, origin, [char | reversed])

  fn parse_literal_named_capture_quote(input: List(Char), fuel: Nat, origin: List(Char), reversed: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralAtInvalid(:UnclosedRegexCaptureName, origin, literal_delimited_width(origin, '\''))
      ['\'' | rest] -> match reversed
        [] -> LiteralAtInvalid(:EmptyRegexCaptureName, origin, literal_delimited_width(origin, '\''))
        _ -> match capture_name_is_valid(reverse_chars(reversed))
          true -> parse_literal_named_capture_body(rest, next_fuel, origin, Std.String.from_characters(reverse_chars(reversed)))
          false -> LiteralAtInvalid(:MalformedRegexCaptureName, origin, literal_delimited_width(origin, '\''))
      [char | rest] -> pickup
        char == ')' or char == '>' -> LiteralAtInvalid(:MalformedRegexCaptureName, origin, literal_delimited_width(origin, '\''))
        else -> parse_literal_named_capture_quote(rest, next_fuel, origin, [char | reversed])

  fn parse_literal_named_capture_body(input: List(Char), fuel: Nat, origin: List(Char), name: String) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_alternate_fuel(input, next_fuel)
      LiteralParsed(pattern, [')' | rest]) -> LiteralParsed(LiteralNamedCapture(name, pattern), rest)
      LiteralParsed(_, _) -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_branch_reset_fuel(input: List(Char), fuel: Nat, origin: List(Char), reversed: List(LiteralPattern)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_sequence_fuel(input, next_fuel)
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)
      LiteralParsed(arm, rest) -> match rest
        ['|' | tail] -> parse_literal_branch_reset_fuel(tail, next_fuel, origin, [arm | reversed])
        [')' | tail] -> LiteralParsed(LiteralBranchReset(reverse_literal_patterns([arm | reversed])), tail)
        [] -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
        _ -> LiteralAtInvalid(:UnexpectedRegexToken, origin, literal_length(origin))

  fn reverse_literal_patterns(values: List(LiteralPattern)) -> List(LiteralPattern) = match values
    [] -> []
    [head | rest] -> append_literal_patterns(reverse_literal_patterns(rest), [head])

  fn append_literal_patterns(left: List(LiteralPattern), right: List(LiteralPattern)) -> List(LiteralPattern) = match left
    [] -> right
    [head | rest] -> [head | append_literal_patterns(rest, right)]

  fn parse_literal_conditional_header(input: List(Char), fuel: Nat, origin: List(Char), reversed: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
      ['?' | _] -> LiteralAtInvalid(:UnsupportedRegexConditional, origin, 3)
      ['<' | rest] -> parse_literal_conditional_named_header(rest, next_fuel, origin, [])
      [char | rest] -> match literal_decimal_digit(char)
        Some(_) -> parse_literal_conditional_numeric_header(input, next_fuel, origin)
        None() -> parse_literal_conditional_name_header(rest, next_fuel, origin, [char | reversed])

  fn parse_literal_conditional_numeric_header(input: List(Char), fuel: Nat, origin: List(Char)) -> LiteralParse = match parse_literal_count(input, Z(), false)
    LiteralCountParsed(value, seen, [')' | rest]) -> pickup
      not seen -> LiteralAtInvalid(:MalformedRegexConditional, origin, 3)
      else -> match literal_nat_predecessor(value)
        None() -> LiteralAtInvalid(:UnknownRegexCaptureReference, origin, 3)
        Some(slot) -> parse_literal_conditional_body(rest, fuel, origin, LiteralCaptureSlotReference(slot))
    LiteralCountParsed(_, _, _) -> LiteralAtInvalid(:MalformedRegexConditional, origin, 3)
    LiteralCountInvalid(reason) -> LiteralAtInvalid(reason, input, 1)

  fn literal_nat_predecessor(value: Nat) -> Option(Nat) = match value
    Z() -> None()
    S(rest) -> Some(rest)

  fn parse_literal_conditional_named_header(input: List(Char), fuel: Nat, origin: List(Char), reversed: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralAtInvalid(:UnclosedRegexCaptureName, origin, literal_delimited_width(origin, '>'))
      ['>' | rest] -> match reversed
        [] -> LiteralAtInvalid(:EmptyRegexCaptureName, origin, literal_delimited_width(origin, '>'))
        _ -> match capture_name_is_valid(reverse_chars(reversed))
          false -> LiteralAtInvalid(:MalformedRegexCaptureName, origin, literal_delimited_width(origin, '>'))
          true -> match rest
            [')' | body] -> parse_literal_conditional_body(body, next_fuel, origin, LiteralCaptureNameReference(Std.String.from_characters(reverse_chars(reversed))))
            _ -> LiteralAtInvalid(:MalformedRegexConditional, origin, 3)
      [char | rest] -> parse_literal_conditional_named_header(rest, next_fuel, origin, [char | reversed])

  fn parse_literal_conditional_name_header(input: List(Char), fuel: Nat, origin: List(Char), reversed: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
      [')' | rest] -> match capture_name_is_valid(reverse_chars(reversed))
        false -> LiteralAtInvalid(:MalformedRegexCaptureName, origin, 3)
        true -> parse_literal_conditional_body(rest, next_fuel, origin, LiteralCaptureNameReference(Std.String.from_characters(reverse_chars(reversed))))
      [char | rest] -> parse_literal_conditional_name_header(rest, next_fuel, origin, [char | reversed])

  fn parse_literal_conditional_body(input: List(Char), fuel: Nat, origin: List(Char), reference: LiteralCaptureReference) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_sequence_fuel(input, next_fuel)
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)
      LiteralParsed(yes, rest) -> match rest
        [')' | tail] -> LiteralParsed(LiteralConditional(reference, yes, None()), tail)
        ['|' | no_input] -> match parse_literal_sequence_fuel(no_input, next_fuel)
          LiteralParsed(no, [')' | conditional_tail]) -> LiteralParsed(LiteralConditional(reference, yes, Some(no)), conditional_tail)
          LiteralParsed(_, _) -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
          LiteralInvalid(reason) -> LiteralInvalid(reason)
          LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
          LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)
        _ -> LiteralAtInvalid(:UnexpectedRegexToken, origin, 3)


  fn capture_name_is_valid(name: List(Char)) -> Bool = match name
    [] -> false
    [first | rest] -> capture_name_start(first) and capture_name_tail_is_valid(rest)

  fn capture_name_tail_is_valid(name: List(Char)) -> Bool = match name
    [] -> true
    [head | rest] -> capture_name_continue(head) and capture_name_tail_is_valid(rest)

  fn capture_name_start(char: Char) -> Bool =
    Std.Char.between(char, 'A', 'Z') or Std.Char.between(char, 'a', 'z') or char == '_'

  fn capture_name_continue(char: Char) -> Bool =
    capture_name_start(char) or Std.Char.between(char, '0', '9')

  fn parse_literal_capture_fuel(input: List(Char), fuel: Nat, origin: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_alternate_fuel(input, next_fuel)
      LiteralParsed(pattern, [')' | rest]) -> LiteralParsed(LiteralCapture(pattern), rest)
      LiteralParsed(_, _) -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_non_capture_fuel(input: List(Char), fuel: Nat, origin: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_alternate_fuel(input, next_fuel)
      LiteralParsed(pattern, [')' | rest]) -> LiteralParsed(pattern, rest)
      LiteralParsed(_, _) -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_atomic_fuel(input: List(Char), fuel: Nat, origin: List(Char)) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_alternate_fuel(input, next_fuel)
      LiteralParsed(pattern, [')' | rest]) -> LiteralParsed(LiteralAtomic(pattern), rest)
      LiteralParsed(_, _) -> LiteralAtInvalid(:UnclosedRegexGroup, origin, literal_length(origin))
      LiteralInvalid(reason) -> LiteralInvalid(reason)
      LiteralAtInvalid(reason, suffix, width) -> LiteralAtInvalid(reason, suffix, width)
      LiteralLocatedInvalid(reason, start, width) -> LiteralLocatedInvalid(reason, start, width)

  fn parse_literal_escape(input: List(Char), origin: List(Char)) -> LiteralParse = match input
    [] -> LiteralAtInvalid(:TrailingRegexEscape, origin, 1)
    ['d' | rest] -> LiteralParsed(LiteralDigit(false), rest)
    ['D' | rest] -> LiteralParsed(LiteralDigit(true), rest)
    ['w' | rest] -> LiteralParsed(LiteralWord(false), rest)
    ['W' | rest] -> LiteralParsed(LiteralWord(true), rest)
    ['s' | rest] -> LiteralParsed(LiteralSpace(false), rest)
    ['S' | rest] -> LiteralParsed(LiteralSpace(true), rest)
    ['h' | rest] -> LiteralParsed(LiteralHorizontal(false), rest)
    ['H' | rest] -> LiteralParsed(LiteralHorizontal(true), rest)
    ['v' | rest] -> LiteralParsed(LiteralVertical(false), rest)
    ['V' | rest] -> LiteralParsed(LiteralVertical(true), rest)
    ['R' | rest] -> LiteralParsed(LiteralLineBreak(), rest)
    ['A' | rest] -> LiteralParsed(LiteralAbsoluteStart, rest)
    ['z' | rest] -> LiteralParsed(LiteralStrictEnd, rest)
    ['Z' | rest] -> LiteralParsed(LiteralFinalEnd, rest)
    ['b' | rest] -> LiteralParsed(LiteralWordBoundary(false), rest)
    ['B' | rest] -> LiteralParsed(LiteralWordBoundary(true), rest)
    ['a' | rest] -> LiteralParsed(LiteralExact('\a'), rest)
    ['e' | rest] -> LiteralParsed(LiteralExact('\e'), rest)
    ['f' | rest] -> LiteralParsed(LiteralExact('\f'), rest)
    ['n' | rest] -> LiteralParsed(LiteralExact('\n'), rest)
    ['r' | rest] -> LiteralParsed(LiteralExact('\r'), rest)
    ['t' | rest] -> LiteralParsed(LiteralExact('\t'), rest)
    ['x' | rest] -> match parse_literal_hex_scalar(rest)
      LiteralScalarParsed(scalar, tail) -> LiteralParsed(LiteralExact(scalar), tail)
      LiteralScalarInvalid(reason) -> LiteralAtInvalid(reason, origin, literal_scalar_escape_width(origin))
    ['N' | rest] -> parse_literal_unicode_name(rest, origin, [])
    ['p' | rest] -> match parse_literal_unicode_property(rest)
      LiteralPropertyParsed(property, tail) -> LiteralParsed(LiteralProperty(property, false), tail)
      LiteralPropertyInvalid(reason) -> LiteralAtInvalid(reason, origin, literal_property_escape_width(origin))
    ['P' | rest] -> match parse_literal_unicode_property(rest)
      LiteralPropertyParsed(property, tail) -> LiteralParsed(LiteralProperty(property, true), tail)
      LiteralPropertyInvalid(reason) -> LiteralAtInvalid(reason, origin, literal_property_escape_width(origin))
    ['g' | _] -> LiteralAtInvalid(:UnsupportedRegexBackreference, origin, 2)
    ['k' | _] -> LiteralAtInvalid(:UnsupportedRegexBackreference, origin, 2)
    [char | rest] -> match literal_decimal_digit(char)
      Some(_) -> LiteralAtInvalid(:UnsupportedRegexNumericEscape, origin, literal_numeric_escape_width(origin))
      None() -> LiteralParsed(LiteralExact(char), rest)

  fn parse_literal_unicode_name(input: List(Char), origin: List(Char), reversed: List(Char)) -> LiteralParse = match input
    ['{' | rest] -> parse_literal_unicode_name_body(rest, origin, reversed)
    _ -> LiteralAtInvalid(:MalformedRegexUnicodeName, origin, literal_prefix_width(origin, 3))

  fn parse_literal_unicode_name_body(input: List(Char), origin: List(Char), reversed: List(Char)) -> LiteralParse = match input
    [] -> LiteralAtInvalid(:UnclosedRegexUnicodeName, origin, literal_delimited_width(origin, '}'))
    ['}' | rest] -> match reversed
      [] -> LiteralAtInvalid(:EmptyRegexUnicodeName, origin, literal_delimited_width(origin, '}'))
      _ -> match Std.Char.from_unicode_name(reverse_chars(reversed))
        Some(named_char) -> LiteralParsed(LiteralExact(named_char), rest)
        None() -> LiteralAtInvalid(:UnknownRegexUnicodeName, origin, literal_delimited_width(origin, '}'))
    ['{' | _] -> LiteralAtInvalid(:MalformedRegexUnicodeName, origin, literal_delimited_width(origin, '}'))
    [char | rest] -> parse_literal_unicode_name_body(rest, origin, [char | reversed])
