## Compile-time parser for regex literal patterns. It validates the complete
## literal and returns a structured syntax-tree error when parsing stops early.
@group(:text)
mod Std.Regex.Syntax.Parser
  use Std.Regex.Syntax.Model
  use Std.Regex.Syntax.Class

  fn parse_literal(input: List(Char)) -> LiteralParse =
    parse_literal_complete(parse_literal_alternate_fuel(input, literal_fuel(input)))

  fn parse_literal_complete(result: LiteralParse) -> LiteralParse = match result
    LiteralParsed(pattern, rest) -> match rest
      [] -> LiteralParsed(pattern, [])
      _ -> LiteralInvalid(:UnexpectedRegexToken)
    LiteralInvalid(reason) -> LiteralInvalid(reason)

  fn parse_literal_alternate_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_sequence_fuel(input, next_fuel)
      LiteralParsed(left, rest) -> parse_literal_alternate_tail_fuel(left, rest, next_fuel)
      LiteralInvalid(reason) -> LiteralInvalid(reason)

  fn parse_literal_alternate_tail_fuel(left: LiteralPattern, input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralParsed(left, input)
    S(next_fuel) -> match input
      ['|' | rest] -> match parse_literal_sequence_fuel(rest, next_fuel)
        LiteralParsed(right, tail) -> parse_literal_alternate_tail_fuel(LiteralAlternate(left, right), tail, next_fuel)
        LiteralInvalid(reason) -> LiteralInvalid(reason)
      _ -> LiteralParsed(left, input)

  fn parse_literal_sequence_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralParsed(LiteralEmpty, [])
      [head | _] -> pickup
        is_literal_stop(head) -> LiteralParsed(LiteralEmpty, input)
        else -> match parse_literal_repetition_fuel(input, next_fuel)
          LiteralParsed(first, rest) -> parse_literal_sequence_tail_fuel(first, rest, next_fuel)
          LiteralInvalid(reason) -> LiteralInvalid(reason)

  fn parse_literal_sequence_tail_fuel(left: LiteralPattern, input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralParsed(left, input)
    S(next_fuel) -> match input
      [] -> LiteralParsed(left, [])
      [head | _] -> pickup
        is_literal_stop(head) -> LiteralParsed(left, input)
        else -> match parse_literal_repetition_fuel(input, next_fuel)
          LiteralParsed(right, rest) -> parse_literal_sequence_tail_fuel(LiteralSequence(left, right), rest, next_fuel)
          LiteralInvalid(reason) -> LiteralInvalid(reason)

  fn parse_literal_repetition_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_atom_fuel(input, next_fuel)
      LiteralParsed(atom, ['*', '?' | rest]) -> LiteralParsed(LiteralRepeat(atom, true), rest)
      LiteralParsed(atom, ['+', '?' | rest]) -> LiteralParsed(LiteralPlus(atom, true), rest)
      LiteralParsed(atom, ['?', '?' | rest]) -> LiteralParsed(LiteralOptional(atom, true), rest)
      LiteralParsed(atom, ['*' | rest]) -> LiteralParsed(LiteralRepeat(atom, false), rest)
      LiteralParsed(atom, ['+' | rest]) -> LiteralParsed(LiteralPlus(atom, false), rest)
      LiteralParsed(atom, ['?' | rest]) -> LiteralParsed(LiteralOptional(atom, false), rest)
      LiteralParsed(atom, ['{' | rest]) -> parse_literal_bounded(atom, rest)
      result -> result

  fn parse_literal_count(input: List(Char), value: Nat, seen: Bool) -> LiteralCountParse = match input
    [] -> LiteralCountParsed(value, seen, [])
    [char | rest] -> match literal_decimal_digit(char)
      Some(digit) -> parse_literal_count(rest, plus(literal_nat_times_ten(value), digit), true)
      None() -> LiteralCountParsed(value, seen, input)

  fn bounded_count_allowed(value: Nat) -> Bool =
    not literal_nat_less(literal_quantifier_limit(), value)

  fn finish_literal_exact_bounded(atom: LiteralPattern, count: Nat, rest: List(Char)) -> LiteralParse = pickup
    bounded_count_allowed(count) -> match rest
      ['?' | tail] -> LiteralParsed(LiteralBoundedExact(atom, count), tail)
      _ -> LiteralParsed(LiteralBoundedExact(atom, count), rest)
    else -> LiteralInvalid(:RegexQuantifierTooLarge)

  fn finish_literal_at_least_bounded(atom: LiteralPattern, count: Nat, rest: List(Char)) -> LiteralParse = pickup
    bounded_count_allowed(count) -> match rest
      ['?' | tail] -> LiteralParsed(LiteralBoundedAtLeast(atom, count, true), tail)
      _ -> LiteralParsed(LiteralBoundedAtLeast(atom, count, false), rest)
    else -> LiteralInvalid(:RegexQuantifierTooLarge)

  fn finish_literal_between_bounded(atom: LiteralPattern, minimum: Nat, maximum: Nat, rest: List(Char)) -> LiteralParse = pickup
    not bounded_count_allowed(minimum) or not bounded_count_allowed(maximum) -> LiteralInvalid(:RegexQuantifierTooLarge)
    literal_nat_less(maximum, minimum) -> LiteralInvalid(:RegexQuantifierRangeReversed)
    else -> match rest
      ['?' | tail] -> LiteralParsed(LiteralBoundedBetween(atom, minimum, maximum, true), tail)
      _ -> LiteralParsed(LiteralBoundedBetween(atom, minimum, maximum, false), rest)

  fn parse_literal_bounded_maximum(atom: LiteralPattern, minimum: Nat, input: List(Char)) -> LiteralParse = match parse_literal_count(input, Z(), false)
    LiteralCountInvalid(reason) -> LiteralInvalid(reason)
    LiteralCountParsed(maximum, seen, rest) -> pickup
      not seen -> LiteralInvalid(:MissingRegexQuantifierMaximum)
      else -> match rest
        ['}' | tail] -> finish_literal_between_bounded(atom, minimum, maximum, tail)
        [] -> LiteralInvalid(:UnclosedRegexQuantifier)
        _ -> LiteralInvalid(:MalformedRegexQuantifier)

  fn parse_literal_bounded(atom: LiteralPattern, input: List(Char)) -> LiteralParse = match parse_literal_count(input, Z(), false)
    LiteralCountInvalid(reason) -> LiteralInvalid(reason)
    LiteralCountParsed(minimum, seen, rest) -> pickup
      not seen -> LiteralInvalid(:MissingRegexQuantifierMinimum)
      else -> match rest
        ['}' | tail] -> finish_literal_exact_bounded(atom, minimum, tail)
        [',' , '}' | tail] -> finish_literal_at_least_bounded(atom, minimum, tail)
        [',' | tail] -> parse_literal_bounded_maximum(atom, minimum, tail)
        [] -> LiteralInvalid(:UnclosedRegexQuantifier)
        _ -> LiteralInvalid(:MalformedRegexQuantifier)

  fn parse_literal_atom_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      [] -> LiteralInvalid(:MissingRegexAtom)
      ['.' | rest] -> LiteralParsed(LiteralAny, rest)
      ['^' | rest] -> LiteralParsed(LiteralStart, rest)
      ['$' | rest] -> LiteralParsed(LiteralEnd, rest)
      ['(' | rest] -> parse_literal_group_fuel(rest, next_fuel)
      ['[' | rest] -> parse_literal_class(rest)
      ['\\' | rest] -> parse_literal_escape(rest)
      ['*' | _] -> LiteralInvalid(:QuantifierWithoutAtom)
      ['+' | _] -> LiteralInvalid(:QuantifierWithoutAtom)
      ['?' | _] -> LiteralInvalid(:QuantifierWithoutAtom)
      ['{' | _] -> LiteralInvalid(:QuantifierWithoutAtom)
      [char | rest] -> LiteralParsed(LiteralExact(char), rest)

  fn parse_literal_group_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match input
      ['?', ':' | rest] -> parse_literal_non_capture_fuel(rest, next_fuel)
      _ -> parse_literal_capture_fuel(input, next_fuel)

  fn parse_literal_capture_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_alternate_fuel(input, next_fuel)
      LiteralParsed(pattern, [')' | rest]) -> LiteralParsed(LiteralCapture(pattern), rest)
      LiteralParsed(_, _) -> LiteralInvalid(:UnclosedRegexGroup)
      LiteralInvalid(reason) -> LiteralInvalid(reason)

  fn parse_literal_non_capture_fuel(input: List(Char), fuel: Nat) -> LiteralParse = match fuel
    Z() -> LiteralInvalid(:RegexParseLimit)
    S(next_fuel) -> match parse_literal_alternate_fuel(input, next_fuel)
      LiteralParsed(pattern, [')' | rest]) -> LiteralParsed(pattern, rest)
      LiteralParsed(_, _) -> LiteralInvalid(:UnclosedRegexGroup)
      LiteralInvalid(reason) -> LiteralInvalid(reason)

  fn parse_literal_escape(input: List(Char)) -> LiteralParse = match input
    [] -> LiteralInvalid(:TrailingRegexEscape)
    ['d' | rest] -> LiteralParsed(LiteralDigit(false), rest)
    ['D' | rest] -> LiteralParsed(LiteralDigit(true), rest)
    ['w' | rest] -> LiteralParsed(LiteralWord(false), rest)
    ['W' | rest] -> LiteralParsed(LiteralWord(true), rest)
    ['s' | rest] -> LiteralParsed(LiteralSpace(false), rest)
    ['S' | rest] -> LiteralParsed(LiteralSpace(true), rest)
    ['h' | rest] -> LiteralParsed(LiteralHorizontal(false), rest)
    ['H' | rest] -> LiteralParsed(LiteralHorizontal(true), rest)
    ['v' | rest] -> LiteralParsed(LiteralVertical(false), rest)
    ['V' | rest] -> LiteralParsed(LiteralVertical(true), rest)
    ['A' | rest] -> LiteralParsed(LiteralAbsoluteStart, rest)
    ['z' | rest] -> LiteralParsed(LiteralStrictEnd, rest)
    ['Z' | rest] -> LiteralParsed(LiteralFinalEnd, rest)
    ['b' | rest] -> LiteralParsed(LiteralWordBoundary(false), rest)
    ['B' | rest] -> LiteralParsed(LiteralWordBoundary(true), rest)
    ['a' | rest] -> LiteralParsed(LiteralExact('\a'), rest)
    ['e' | rest] -> LiteralParsed(LiteralExact('\e'), rest)
    ['f' | rest] -> LiteralParsed(LiteralExact('\f'), rest)
    ['n' | rest] -> LiteralParsed(LiteralExact('\n'), rest)
    ['r' | rest] -> LiteralParsed(LiteralExact('\r'), rest)
    ['t' | rest] -> LiteralParsed(LiteralExact('\t'), rest)
    ['x' | rest] -> match parse_literal_hex_scalar(rest)
      LiteralScalarParsed(scalar, tail) -> LiteralParsed(LiteralExact(scalar), tail)
      LiteralScalarInvalid(reason) -> LiteralInvalid(reason)
    ['p' | rest] -> match parse_literal_unicode_property(rest)
      LiteralPropertyParsed(property, tail) -> LiteralParsed(LiteralProperty(property, false), tail)
      LiteralPropertyInvalid(reason) -> LiteralInvalid(reason)
    ['P' | rest] -> match parse_literal_unicode_property(rest)
      LiteralPropertyParsed(property, tail) -> LiteralParsed(LiteralProperty(property, true), tail)
      LiteralPropertyInvalid(reason) -> LiteralInvalid(reason)
    [char | rest] -> LiteralParsed(LiteralExact(char), rest)
