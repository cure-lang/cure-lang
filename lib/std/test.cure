@group(:test)
mod Std.Test
  ## Test assertion primitives plus a shrinking-aware property runner.
  ##
  ## Assertions raise an Erlang error with a descriptive atom on
  ## failure (`:assertion_failed`, `:not_equal`, etc.). The
  ## property-based helpers pair with `Std.Gen` generators.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## mod MyTest
  ##   use Std.Test
  ##
  ##   fn test_sanity() -> Unit =
  ##     assert_eq(1 + 1, 2)
  ## ```
  ##
  ## ```cure
  ## # Property: reversing a list twice is the identity.
  ## use Std.Test
  ## use Std.Gen
  ## use Std.List
  ##
  ## let prop = fn(xs: List(Int)) -> Bool =
  ##   reverse(reverse(xs)) == xs
  ##
  ## forall_default(fn(_) -> list_int(10, 0, 100), prop)
  ## # => :ok
  ## ```

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  use Std.Comparable
  use Std.Result

  ## Private: raise `reason` as an Erlang error.
  @extern(:erlang, :error, 1)
  local fn raise_error(reason: Atom) -> Unit

  ## Assert `condition` is `true`; raises `:assertion_failed` on false.
  fn assert(condition: Bool) -> Unit =
    pickup
      condition -> ()
      else      -> raise_error(:assertion_failed)

  ## Assert structural equality; raises `:not_equal` on mismatch. Assertions are
  ## intentionally available for every runtime value, including generic
  ## containers whose element dictionary is not otherwise in lexical scope.
  fn assert_eq(a: t, b: t) -> Unit =
    pickup
      Std.Builtin.struct_eq(t, a, b) -> ()
      else   -> raise_error(:not_equal)

  ## Assert `a != b`; raises `:unexpectedly_equal` when they match.
  fn assert_ne(a: t, b: t) -> Unit =
    pickup
      Std.Builtin.struct_eq(t, a, b) -> raise_error(:unexpectedly_equal)
      else   -> ()

  ## Assert `a > b`; raises `:not_greater` otherwise.
  fn assert_gt(a: t, b: t) -> Unit requires Comparable(t) =
    pickup
      a > b -> ()
      else  -> raise_error(:not_greater)

  ## Assert `a < b`; raises `:not_less` otherwise.
  fn assert_lt(a: t, b: t) -> Unit requires Comparable(t) =
    pickup
      a < b -> ()
      else  -> raise_error(:not_less)

  # -- Property-based testing (v0.19.0) --------------------------------------

  ## Run `property` against `runs` random samples drawn from `gen`.
  ## Returns `:ok` when every sample satisfies the property, or
  ## raises `:property_failed` on the first counterexample.
  ##
  ## `gen` is a zero-argument function (e.g.
  ## `fn(_) -> Std.Gen.int_in(0, 100)`) that returns a fresh value
  ## on every call.
  fn forall(gen: Unit -> t, property: t -> Bool, runs: Int) -> Unit =
    match runs
      0 -> ()
      _ ->
        match property(gen(()))
          true  -> forall(gen, property, runs - 1)
          false -> raise_error(:property_failed)

  ## Convenience wrapper that uses 100 runs by default.
  fn forall_default(gen: Unit -> t, property: t -> Bool) -> Unit =
    forall(gen, property, 100)

  # -- Shrinking-aware property runner (v0.23.0) -----------------------------

  ## Run `property` against `runs` random samples. On the first failure,
  ## shrink the counterexample until no smaller value also fails.
  ##
  ## Returns `Ok(:ok)` when every sample satisfied the property, and
  ## `Error(minimal)` carrying the minimised counterexample otherwise.
  ## Unlike `forall/3`, a failing property is a value, not a raise — including a
  ## property that itself throws (treated as a failure). Given a total generator
  ## and property this never raises; a generator that throws has no witness
  ## value to return and is a caller error.
  @extern(:cure_std_test, :forall_shrunk, 3)
  fn forall_shrunk(gen: Unit -> t, property: t -> Bool, runs: Int) -> Result(Unit, t)

  ## Same as `forall_shrunk/3` but with a 100-run default.
  fn forall_shrunk_default(gen: Unit -> t, property: t -> Bool) -> Result(Unit, t) =
    forall_shrunk(gen, property, 100)
