## Compile-time emitter for regex syntax trees. It turns parsed patterns into
## the matcher representation consumed by `Std.Regex`.
@group(:text)
mod Std.Regex.Syntax.Emitter
  use Std.Regex.Syntax.Model
  use Std.Syntax

  fn literal_shape(pattern: LiteralPattern) -> LiteralShapeCode = match pattern
    LiteralEmpty -> UnitC
    LiteralExact(_) -> UnitC
    LiteralAny -> CharC
    LiteralClass(_, _, _, _) -> CharC
    LiteralProperty(_, _) -> CharC
    LiteralDigit(_) -> CharC
    LiteralWord(_) -> CharC
    LiteralSpace(_) -> CharC
    LiteralHorizontal(_) -> CharC
    LiteralVertical(_) -> CharC
    LiteralSequence(left, right) -> PairC(literal_shape(left), literal_shape(right))
    LiteralAlternate(left, right) -> ChoiceC(literal_shape(left), literal_shape(right))
    LiteralRepeat(inner, _) -> ListC(literal_shape(inner))
    LiteralPlus(inner, _) -> ListC(literal_shape(inner))
    LiteralOptional(inner, _) -> ChoiceC(literal_shape(inner), UnitC)
    LiteralBoundedExact(inner, _) -> ListC(literal_shape(inner))
    LiteralBoundedAtLeast(inner, _, _) -> ListC(literal_shape(inner))
    LiteralBoundedBetween(inner, _, _, _) -> ListC(literal_shape(inner))
    LiteralCapture(_) -> StringC
    LiteralStart -> UnitC
    LiteralEnd -> UnitC
    LiteralAbsoluteStart -> UnitC
    LiteralStrictEnd -> UnitC
    LiteralFinalEnd -> UnitC
    LiteralWordBoundary(_) -> UnitC

  fn emit_shape(shape: LiteralShapeCode) -> Syntax = match shape
    UnitC -> call("Std.Regex.UnitC", [])
    CharC -> call("Std.Regex.CharC", [])
    StringC -> call("Std.Regex.StringC", [])
    BoolC -> call("Std.Regex.BoolC", [])
    NatC -> call("Std.Regex.NatC", [])
    IntC -> call("Std.Regex.IntC", [])
    PairC(left, right) -> call("Std.Regex.PairC", [emit_shape(left), emit_shape(right)])
    ChoiceC(left, right) -> call("Std.Regex.ChoiceC", [emit_shape(left), emit_shape(right)])
    OptionC(inner) -> call("Std.Regex.OptionC", [emit_shape(inner)])
    ListC(inner) -> call("Std.Regex.ListC", [emit_shape(inner)])

  fn emit_literal(pattern: LiteralPattern) -> Syntax = match pattern
    LiteralEmpty -> call("Std.Regex.empty", [])
    LiteralExact(char) -> call("Std.Regex.exactly", [char_literal(char)])
    LiteralAny -> call("Std.Regex.any_char", [])
    LiteralClass(chars, ranges, kinds, negated) ->
      call("Std.Regex.extended_unicode_property_class", [emit_chars(chars), emit_ranges(ranges), emit_class_kinds(kinds), emit_unicode_property_matches(literal_class_properties(kinds)), emit_posix_class_matches(literal_class_posix(kinds)), bool_literal(negated), bool_literal(false), bool_literal(false)])
    LiteralProperty(property, negated) -> call("Std.Regex.unicode_property_class", [emit_unicode_property(property), bool_literal(negated)])
    LiteralDigit(negated) -> call("Std.Regex.digit_class", [bool_literal(negated)])
    LiteralWord(negated) -> call("Std.Regex.word_class", [bool_literal(negated)])
    LiteralSpace(negated) -> call("Std.Regex.space_class", [bool_literal(negated)])
    LiteralHorizontal(negated) -> call("Std.Regex.horizontal_class", [bool_literal(negated)])
    LiteralVertical(negated) -> call("Std.Regex.vertical_class", [bool_literal(negated)])
    LiteralSequence(left, right) -> call("Std.Regex.concatenate", [emit_literal(left), emit_literal(right)])
    LiteralAlternate(left, right) -> call("Std.Regex.alternate", [emit_literal(left), emit_literal(right)])
    LiteralRepeat(inner, lazy) -> call("Std.Regex.repeated_pattern", [emit_literal(inner), bool_literal(lazy)])
    LiteralPlus(inner, lazy) -> call("Std.Regex.one_or_more_pattern", [emit_literal(inner), bool_literal(lazy)])
    LiteralOptional(inner, lazy) -> call("Std.Regex.optional_literal", [emit_literal(inner), bool_literal(lazy)])
    LiteralBoundedExact(inner, count) -> call("Std.Regex.bounded_exact_pattern", [emit_literal(inner), emit_nat(count)])
    LiteralBoundedAtLeast(inner, count, lazy) -> call("Std.Regex.bounded_at_least_pattern", [emit_literal(inner), emit_nat(count), bool_literal(lazy)])
    LiteralBoundedBetween(inner, minimum, maximum, lazy) -> call("Std.Regex.bounded_between_pattern", [emit_literal(inner), emit_nat(minimum), emit_nat(maximum), bool_literal(lazy)])
    LiteralCapture(inner) -> call("Std.Regex.captured", [emit_literal(inner)])
    LiteralStart -> call("Std.Regex.start_anchor", [])
    LiteralEnd -> call("Std.Regex.end_anchor", [])
    LiteralAbsoluteStart -> call("Std.Regex.start_anchor", [])
    LiteralStrictEnd -> call("Std.Regex.strict_end_anchor", [])
    LiteralFinalEnd -> call("Std.Regex.end_anchor", [])
    LiteralWordBoundary(negated) -> call("Std.Regex.word_boundary", [bool_literal(false), bool_literal(negated)])

  fn emit_literal_with_options(pattern: LiteralPattern, options: LiteralRegexOptions) -> Syntax =
    let caseless = has_modifier(options, CaselessModifier)
    let multiline = has_modifier(options, MultilineModifier)
    let dotall = has_modifier(options, DotallModifier)
    let unicode = has_modifier(options, UnicodeModifier)
    let ungreedy = has_modifier(options, UngreedyModifier)
    match pattern
      LiteralEmpty -> call("Std.Regex.empty", [])
      LiteralExact(char) -> call("Std.Regex.exactly_with_options", [char_literal(char), bool_literal(caseless), bool_literal(unicode)])
      LiteralAny -> call("Std.Regex.dot_with_options", [bool_literal(dotall)])
      LiteralClass(chars, ranges, kinds, negated) ->
        call("Std.Regex.extended_unicode_property_class", [emit_chars(chars), emit_ranges(ranges), emit_class_kinds(kinds), emit_unicode_property_matches(literal_class_properties(kinds)), emit_posix_class_matches(literal_class_posix(kinds)), bool_literal(negated), bool_literal(caseless), bool_literal(unicode)])
      LiteralProperty(property, negated) -> call("Std.Regex.unicode_property_class", [emit_unicode_property(property), bool_literal(negated)])
      LiteralDigit(negated) -> call("Std.Regex.digit_class_with_options", [bool_literal(negated), bool_literal(unicode)])
      LiteralWord(negated) -> call("Std.Regex.word_class_with_options", [bool_literal(negated), bool_literal(unicode)])
      LiteralSpace(negated) -> call("Std.Regex.space_class_with_options", [bool_literal(negated), bool_literal(unicode)])
      LiteralHorizontal(negated) -> call("Std.Regex.horizontal_class", [bool_literal(negated)])
      LiteralVertical(negated) -> call("Std.Regex.vertical_class", [bool_literal(negated)])
      LiteralSequence(left, right) -> call("Std.Regex.concatenate", [emit_literal_with_options(left, options), emit_literal_with_options(right, options)])
      LiteralAlternate(left, right) -> call("Std.Regex.alternate", [emit_literal_with_options(left, options), emit_literal_with_options(right, options)])
      LiteralRepeat(inner, lazy) -> call("Std.Regex.repeated_pattern", [emit_literal_with_options(inner, options), bool_literal(lazy != ungreedy)])
      LiteralPlus(inner, lazy) -> call("Std.Regex.one_or_more_pattern", [emit_literal_with_options(inner, options), bool_literal(lazy != ungreedy)])
      LiteralOptional(inner, lazy) -> call("Std.Regex.optional_literal", [emit_literal_with_options(inner, options), bool_literal(lazy != ungreedy)])
      LiteralBoundedExact(inner, count) -> call("Std.Regex.bounded_exact_pattern", [emit_literal_with_options(inner, options), emit_nat(count)])
      LiteralBoundedAtLeast(inner, count, lazy) -> call("Std.Regex.bounded_at_least_pattern", [emit_literal_with_options(inner, options), emit_nat(count), bool_literal(lazy != ungreedy)])
      LiteralBoundedBetween(inner, minimum, maximum, lazy) -> call("Std.Regex.bounded_between_pattern", [emit_literal_with_options(inner, options), emit_nat(minimum), emit_nat(maximum), bool_literal(lazy != ungreedy)])
      LiteralCapture(inner) -> call("Std.Regex.captured", [emit_literal_with_options(inner, options)])
      LiteralStart -> call("Std.Regex.start_anchor_with_options", [bool_literal(multiline)])
      LiteralEnd -> call("Std.Regex.end_anchor_with_options", [bool_literal(multiline)])
      LiteralAbsoluteStart -> call("Std.Regex.start_anchor", [])
      LiteralStrictEnd -> call("Std.Regex.strict_end_anchor", [])
      LiteralFinalEnd -> call("Std.Regex.end_anchor", [])
      LiteralWordBoundary(negated) -> call("Std.Regex.word_boundary", [bool_literal(unicode), bool_literal(negated)])

  fn emit_chars(chars: List(Char)) -> Syntax = match chars
    [] -> list([])
    [head | rest] -> prepend_syntax(char_literal(head), emit_chars(rest))

  fn emit_nat(value: Nat) -> Syntax = match value
    Z() -> call("Std.Nat.Z", [])
    S(rest) -> call("Std.Nat.S", [emit_nat(rest)])

  fn emit_ranges(ranges: List(LiteralCharacterRange)) -> Syntax = match ranges
    [] -> list([])
    [LiteralCharacterRange(first, last) | rest] ->
      prepend_syntax(call("Std.Regex.CharacterRange", [char_literal(first), char_literal(last)]), emit_ranges(rest))

  fn emit_class_kinds(kinds: LiteralClassKinds) -> Syntax =
    call("Std.Regex.ClassKinds", [
      bool_literal(has_class_kind(kinds, DigitKind)),
      bool_literal(has_class_kind(kinds, NotDigitKind)),
      bool_literal(has_class_kind(kinds, WordKind)),
      bool_literal(has_class_kind(kinds, NotWordKind)),
      bool_literal(has_class_kind(kinds, SpaceKind)),
      bool_literal(has_class_kind(kinds, NotSpaceKind)),
      bool_literal(has_class_kind(kinds, HorizontalKind)),
      bool_literal(has_class_kind(kinds, NotHorizontalKind)),
      bool_literal(has_class_kind(kinds, VerticalKind)),
      bool_literal(has_class_kind(kinds, NotVerticalKind))
    ])

  fn emit_unicode_property(property: LiteralUnicodeProperty) -> Syntax = match property
    PropertyAny -> call("Std.Regex.PropertyAny", [])
    PropertyLetter -> call("Std.Regex.PropertyLetter", [])
    PropertyLowercaseLetter -> call("Std.Regex.PropertyLowercaseLetter", [])
    PropertyUppercaseLetter -> call("Std.Regex.PropertyUppercaseLetter", [])
    PropertyTitlecaseLetter -> call("Std.Regex.PropertyTitlecaseLetter", [])
    PropertyModifierLetter -> call("Std.Regex.PropertyModifierLetter", [])
    PropertyOtherLetter -> call("Std.Regex.PropertyOtherLetter", [])
    PropertyMark -> call("Std.Regex.PropertyMark", [])
    PropertySpacingMark -> call("Std.Regex.PropertySpacingMark", [])
    PropertyEnclosingMark -> call("Std.Regex.PropertyEnclosingMark", [])
    PropertyNonspacingMark -> call("Std.Regex.PropertyNonspacingMark", [])
    PropertyNumber -> call("Std.Regex.PropertyNumber", [])
    PropertyDecimalNumber -> call("Std.Regex.PropertyDecimalNumber", [])
    PropertyLetterNumber -> call("Std.Regex.PropertyLetterNumber", [])
    PropertyOtherNumber -> call("Std.Regex.PropertyOtherNumber", [])
    PropertyPunctuation -> call("Std.Regex.PropertyPunctuation", [])
    PropertyConnectorPunctuation -> call("Std.Regex.PropertyConnectorPunctuation", [])
    PropertyDashPunctuation -> call("Std.Regex.PropertyDashPunctuation", [])
    PropertyClosePunctuation -> call("Std.Regex.PropertyClosePunctuation", [])
    PropertyFinalPunctuation -> call("Std.Regex.PropertyFinalPunctuation", [])
    PropertyInitialPunctuation -> call("Std.Regex.PropertyInitialPunctuation", [])
    PropertyOtherPunctuation -> call("Std.Regex.PropertyOtherPunctuation", [])
    PropertyOpenPunctuation -> call("Std.Regex.PropertyOpenPunctuation", [])
    PropertySymbol -> call("Std.Regex.PropertySymbol", [])
    PropertyCurrencySymbol -> call("Std.Regex.PropertyCurrencySymbol", [])
    PropertyModifierSymbol -> call("Std.Regex.PropertyModifierSymbol", [])
    PropertyMathSymbol -> call("Std.Regex.PropertyMathSymbol", [])
    PropertyOtherSymbol -> call("Std.Regex.PropertyOtherSymbol", [])
    PropertySeparator -> call("Std.Regex.PropertySeparator", [])
    PropertyLineSeparator -> call("Std.Regex.PropertyLineSeparator", [])
    PropertyParagraphSeparator -> call("Std.Regex.PropertyParagraphSeparator", [])
    PropertySpaceSeparator -> call("Std.Regex.PropertySpaceSeparator", [])
    PropertyOther -> call("Std.Regex.PropertyOther", [])
    PropertyControl -> call("Std.Regex.PropertyControl", [])
    PropertyFormat -> call("Std.Regex.PropertyFormat", [])
    PropertyUnassigned -> call("Std.Regex.PropertyUnassigned", [])
    PropertyPrivateUse -> call("Std.Regex.PropertyPrivateUse", [])
    PropertySurrogate -> call("Std.Regex.PropertySurrogate", [])

  fn emit_unicode_property_matches(values: List(LiteralUnicodePropertyMatch)) -> Syntax = match values
    [] -> list([])
    [LiteralUnicodePropertyMatch(property, negated) | rest] ->
      prepend_syntax(call("Std.Regex.UnicodePropertyMatch", [emit_unicode_property(property), bool_literal(negated)]), emit_unicode_property_matches(rest))

  fn emit_posix_class(posix_class: LiteralPosixClass) -> Syntax = match posix_class
    PosixAlnum -> call("Std.Regex.PosixAlnum", [])
    PosixAlpha -> call("Std.Regex.PosixAlpha", [])
    PosixAscii -> call("Std.Regex.PosixAscii", [])
    PosixBlank -> call("Std.Regex.PosixBlank", [])
    PosixCntrl -> call("Std.Regex.PosixCntrl", [])
    PosixDigit -> call("Std.Regex.PosixDigit", [])
    PosixGraph -> call("Std.Regex.PosixGraph", [])
    PosixLower -> call("Std.Regex.PosixLower", [])
    PosixPrint -> call("Std.Regex.PosixPrint", [])
    PosixPunct -> call("Std.Regex.PosixPunct", [])
    PosixSpace -> call("Std.Regex.PosixSpace", [])
    PosixUpper -> call("Std.Regex.PosixUpper", [])
    PosixWord -> call("Std.Regex.PosixWord", [])
    PosixXdigit -> call("Std.Regex.PosixXdigit", [])

  fn emit_posix_class_matches(values: List(LiteralPosixClassMatch)) -> Syntax = match values
    [] -> list([])
    [LiteralPosixClassMatch(posix_class, negated) | rest] ->
      prepend_syntax(call("Std.Regex.PosixClassMatch", [emit_posix_class(posix_class), bool_literal(negated)]), emit_posix_class_matches(rest))

  fn emit_options(options: LiteralRegexOptions) -> Syntax =
    call("Std.Regex.RegexOptions", [
      bool_literal(has_modifier(options, CaselessModifier)),
      bool_literal(has_modifier(options, MultilineModifier)),
      bool_literal(has_modifier(options, DotallModifier)),
      bool_literal(has_modifier(options, ExtendedModifier)),
      bool_literal(has_modifier(options, UnicodeModifier)),
      bool_literal(has_modifier(options, FirstlineModifier)),
      bool_literal(has_modifier(options, UngreedyModifier)),
      bool_literal(has_modifier(options, ExportModifier))
    ])

  fn prepend_syntax(head: Syntax, tail: Syntax) -> Syntax = match tail
    Node(tag, attrs, children) -> pickup
      tag == :list -> Node(tag, attrs, [head | children])
      else -> list([head])
    _ -> list([head])
