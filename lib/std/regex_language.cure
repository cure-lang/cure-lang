@group(:text)
mod Std.Regex.Language
  use Std.Regex
  use Std.Regex.Proof
  use Std.Proof.IntMath

  ## Structural membership in the language of a typed pattern.  The relation is
  ## indexed by the exact consumed input, the contextual suffix, and the
  ## position at which matching began; boundary assertions therefore remain
  ## part of the language rather than an unchecked side condition.
  type NonEmptyCharacters indices (input: List(Char))
    CharactersPresent : (head: Char) -> (tail: List(Char)) -> NonEmptyCharacters(Cons(head, tail))

  type PatternDenotation indices (shape: ShapeCode, pattern: Pattern(shape), position: InitialPosition, input: List(Char), after_input: List(Char))
    DenotesEmpty : PatternDenotation(UnitC, PatternEmpty(), position, Nil(), after_input)
    DenotesPredicate : (proof: Equivalent(Bool, test(char), True())) -> PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
    DenotesBoundary : (proof: IsTrue(constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input)))) -> PatternDenotation(UnitC, PatternBoundary(constraint), position, Nil(), after_input)

  ## Constructive completeness packages the runtime outputs existentially while
  ## retaining the erased certificate that those outputs came from the verified
  ## machine.  Callers do not have to guess the evidence stream or routine.
  type PredicateAcceptance indices (test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition)
    PredicateAccepted : (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (@erased acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input, final_evidence, routine)) -> PredicateAcceptance(test, char, after_input, position)

  fn predicate_result_member(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    predicate_holds: Equivalent(Bool, test(char), True())
  ) -> ListMember(MachineState(S(Z())), predicate_accepting_destination(char), machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, transition_boundary_before(char, Nil(), after_input))) =
    rewrite predicate_holds in member_here(predicate_accepting_destination(char), Nil())

  fn predicate_acceptance_truth(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input, final_evidence, routine)
  ) -> Equivalent(Bool, test(char), True()) = match acceptance
    MachineAccepted(_, _, _, _, initial_edge, initial_execution, _, path) -> match predicate_starts_view(test, position, Cons(char, Nil()), after_input)
      PredicateStartsExact() -> match initial_edge
        ListMemberHere() -> match initial_execution
          RoutineDone() -> match path
            AcceptingNextActive(destination, regular, constraints, _, _, _, edge, _, _) ->
              match predicate_transition_truth(test, char, transition_boundary_before(char, Nil(), after_input), Active(destination, regular, constraints), edge)
                PredicateTransitionHeld(predicate_holds) -> predicate_holds
            AcceptingNextAccepted(regular, constraints, _, _, _, edge, _, _) ->
              match predicate_transition_truth(test, char, transition_boundary_before(char, Nil(), after_input), Accepted(regular, constraints), edge)
                PredicateTransitionHeld(predicate_holds) -> predicate_holds
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_acceptance_is_sound(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input, final_evidence, routine)
  ) -> PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input) =
    DenotesPredicate(predicate_acceptance_truth(test, char, after_input, position, final_evidence, routine, acceptance))

  fn predicate_denotation_is_complete(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PredicateAcceptance(test, char, after_input, position) = match denotation
    DenotesPredicate(predicate_holds) ->
      let no_evidence: List(Evidence) = Nil()
      let no_captures: List(CaptureFrame) = Nil()
      let no_regular: List(EvidenceInstruction) = Nil()
      let no_extended: List(ExtendedInstruction) = Nil()
      let final_evidence: List(Evidence) = Cons(CharacterEvidence(char), Nil())
      let final_captures: List(CaptureFrame) = Nil()
      let predicate_regular: List(EvidenceInstruction) = Cons(EmitChar(char), Nil())
      let path_routine: List(ExtendedInstruction) = transition_routine(char, predicate_regular)
      let no_initial_states: List(MachineState(S(Z()))) = Nil()
      let initial_edge: ListMember(MachineState(S(Z())), predicate_machine_start(), initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input)) = member_here(predicate_machine_start(), no_initial_states)
      let transition_edge: ListMember(MachineState(S(Z())), predicate_accepting_destination(char), machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, transition_boundary_before(char, Nil(), after_input))) = predicate_result_member(test, char, after_input, predicate_holds)
      let initial_execution: RoutineExecution(no_regular, Nil(), Nil(), no_evidence, no_captures) = RoutineDone()
      let transition_execution: RoutineExecution(predicate_regular, no_evidence, record_capture_char(no_captures, char), final_evidence, final_captures) = RoutineStep(EmitChar(char), RoutineDone())
      let transition_extended: ExtendedEvidenceRoutineExecution(regular_routine(predicate_regular), no_evidence, record_capture_char(no_captures, char), final_evidence, final_captures) = ExtendedEvidenceRegular(EmitChar(char), ExtendedEvidenceDone())
      let path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), no_evidence, no_captures, final_evidence, path_routine) = AcceptingNextAccepted(predicate_regular, Nil(), final_evidence, final_captures, no_extended, transition_edge, transition_execution, AcceptingNow())
      let path_certificate: CertifiedPathRoutine(path_routine, no_evidence, no_captures, final_evidence) = PathRoutineTransition(char, predicate_regular, no_extended, final_evidence, final_captures, transition_extended, PathRoutineDone())
      let complete_routine = append_extended_routines(regular_routine(no_regular), path_routine)
      let routine_certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(no_regular, path_routine, no_evidence, no_captures, ExtendedEvidenceDone(), path_certificate)
      PredicateAccepted(final_evidence, complete_routine, MachineAccepted(predicate_machine_start(), no_evidence, no_captures, path_routine, initial_edge, initial_execution, routine_certificate, path))
