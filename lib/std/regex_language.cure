  @reducible
  fn grouped_predicate_accepting(char: Char) -> MachineState(S(Z())) =
    let regular: List(EvidenceInstruction) = Cons(EmitChar(char), Cons(EndCapture(), Nil()))
    let constraints: List(BoundaryConstraint) = Nil()
    Accepted(regular, constraints)

  fn grouped_predicate_result_member(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    holds: Equivalent(Bool, test(char), True())
  ) -> ListMember(MachineState(S(Z())), grouped_predicate_accepting(char), machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, transition_boundary_before(char, Nil(), after_input))) =
    lift_filtered_finish_capture_member(
      S(Z()),
      predicate_machine_next(test)(First(), char),
      transition_boundary_before(char, Nil(), after_input),
      predicate_accepting_destination(char),
      predicate_result_member(test, char, after_input, holds)
    )

  fn grouped_predicate_denotation_is_complete(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PatternAcceptance(StringC, PatternGroup(PatternPredicate(test)), position, Cons(char, Nil()), after_input) =
    let holds = predicate_denotation_truth(test, char, after_input, position, denotation)
    let no_evidence: List(Evidence) = Nil()
    let no_captures: List(CaptureFrame) = Nil()
    let opened_captures: List(CaptureFrame) = Cons(CaptureFrame(Nil(), Nil()), Nil())
    let recorded_captures: List(CaptureFrame) = record_capture_char(opened_captures, char)
    let no_extended: List(ExtendedInstruction) = Nil()
    let initial_regular: List(EvidenceInstruction) = Cons(BeginCapture(), Nil())
    let transition_regular: List(EvidenceInstruction) = Cons(EmitChar(char), Cons(EndCapture(), Nil()))
    let final_evidence: List(Evidence) = Cons(StringEvidence(Std.String.from_characters(Cons(char, Nil()))), Nil())
    let path_routine = transition_routine(char, transition_regular)
    let initial_edge: ListMember(MachineState(S(Z())), Active(First(), initial_regular, Nil()), initial_machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, Cons(char, Nil()), after_input)) = member_here(Active(First(), initial_regular, Nil()), Nil())
    let transition_edge = grouped_predicate_result_member(test, char, after_input, holds)
    let initial_execution: RoutineExecution(initial_regular, no_evidence, no_captures, no_evidence, opened_captures) = RoutineStep(BeginCapture(), RoutineDone())
    let transition_execution: RoutineExecution(transition_regular, no_evidence, recorded_captures, final_evidence, no_captures) = RoutineStep(EmitChar(char), RoutineStep(EndCapture(), RoutineDone()))
    let initial_extended: ExtendedEvidenceRoutineExecution(regular_routine(initial_regular), no_evidence, no_captures, no_evidence, opened_captures) = ExtendedEvidenceRegular(BeginCapture(), ExtendedEvidenceDone())
    let transition_extended: ExtendedEvidenceRoutineExecution(regular_routine(transition_regular), no_evidence, recorded_captures, final_evidence, no_captures) = ExtendedEvidenceRegular(EmitChar(char), ExtendedEvidenceRegular(EndCapture(), ExtendedEvidenceDone()))
    let path: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Cons(char, Nil()), after_input, ThreadActive(First()), no_evidence, opened_captures, final_evidence, path_routine) = AcceptingNextAccepted(transition_regular, Nil(), final_evidence, no_captures, no_extended, transition_edge, transition_execution, AcceptingNow())
    let path_certificate: CertifiedPathRoutine(path_routine, no_evidence, opened_captures, final_evidence) = PathRoutineTransition(char, transition_regular, no_extended, final_evidence, no_captures, transition_extended, PathRoutineDone())
    let complete_routine = append_extended_routines(regular_routine(initial_regular), path_routine)
    let certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(initial_regular, path_routine, no_evidence, opened_captures, initial_extended, path_certificate)
    PatternAccepted(final_evidence, complete_routine, MachineAccepted(Active(First(), initial_regular, Nil()), no_evidence, opened_captures, path_routine, initial_edge, initial_execution, certificate, path))

  type PredicateRepeatAcceptance indices (test: Char -> Bool, lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition)
    PredicateRepeatAccepted : (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (@erased acceptance: MachineAcceptance(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, input, after_input, final_evidence, routine)) -> PredicateRepeatAcceptance(test, lazy, input, after_input, position)

  @reducible
  fn predicate_repeat_empty_start() -> MachineState(S(Z())) =
    Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil())

  @reducible
  fn predicate_repeat_consuming_start() -> MachineState(S(Z())) =
    Active(First(), Cons(BeginList(), Nil()), Nil())

  fn predicate_repeat_empty_initial_member(
    test: Char -> Bool,
    lazy: Bool,
    position: InitialPosition,
    after_input: List(Char)
  ) -> ListMember(MachineState(S(Z())), predicate_repeat_empty_start(), initial_machine_destinations(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, Nil(), after_input)) = match lazy
    False() -> member_there(predicate_repeat_consuming_start(), member_here(predicate_repeat_empty_start(), Nil()))
    True() -> member_here(predicate_repeat_empty_start(), Cons(predicate_repeat_consuming_start(), Nil()))

  fn predicate_repeat_mode_empty_acceptance_is_complete(
    test: Char -> Bool,
    lazy: Bool,
    after_input: List(Char),
    position: InitialPosition
  ) -> PredicateRepeatAcceptance(test, lazy, Nil(), after_input, position) =
    let no_captures: List(CaptureFrame) = Nil()
    let no_path_routine: List(ExtendedInstruction) = Nil()
    let final_evidence: List(Evidence) = Cons(EndListEvidence(), Cons(BeginListEvidence(), Nil()))
    let regular: List(EvidenceInstruction) = Cons(BeginList(), Cons(EndList(), Nil()))
    let edge = predicate_repeat_empty_initial_member(test, lazy, position, after_input)
    let execution: RoutineExecution(regular, Nil(), Nil(), final_evidence, no_captures) = RoutineStep(BeginList(), RoutineStep(EndList(), RoutineDone()))
    let extended_execution: ExtendedEvidenceRoutineExecution(regular_routine(regular), Nil(), Nil(), final_evidence, no_captures) = ExtendedEvidenceRegular(BeginList(), ExtendedEvidenceRegular(EndList(), ExtendedEvidenceDone()))
    let certificate: CertifiedPathRoutine(regular_routine(regular), Nil(), Nil(), final_evidence) = PathRoutineInitial(regular, no_path_routine, final_evidence, no_captures, extended_execution, PathRoutineDone())
    PredicateRepeatAccepted(final_evidence, regular_routine(regular), MachineAccepted(predicate_repeat_empty_start(), final_evidence, no_captures, no_path_routine, edge, execution, certificate, AcceptingNow()))

  fn predicate_repeat_mode_empty_denotation_is_complete(
    test: Char -> Bool,
    lazy: Bool,
    after_input: List(Char),
    position: InitialPosition,
    @erased denotation: PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, Nil(), after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, Nil(), after_input) = match predicate_repeat_mode_empty_acceptance_is_complete(test, lazy, after_input, position)
    PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  fn predicate_repeat_empty_denotation_is_complete(
    test: Char -> Bool,
    after_input: List(Char),
    position: InitialPosition,
    @erased denotation: PatternDenotation(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, Nil(), after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, Nil(), after_input) = match predicate_repeat_mode_empty_acceptance_is_complete(test, False(), after_input, position)
    PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  @reducible
  fn predicate_repeat_singleton_accepting(char: Char) -> MachineState(S(Z())) =
    Accepted(Cons(EmitChar(char), Cons(EndList(), Nil())), Nil())

  @reducible
  fn predicate_repeat_singleton_reentry(char: Char) -> MachineState(S(Z())) =
    Active(First(), Cons(EmitChar(char), Nil()), Nil())

  fn predicate_repeat_consuming_initial_member(
    test: Char -> Bool,
    lazy: Bool,
    position: InitialPosition,
    char: Char,
    rest: List(Char),
    after_input: List(Char)
  ) -> ListMember(MachineState(S(Z())), predicate_repeat_consuming_start(), initial_machine_destinations(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, Cons(char, rest), after_input)) = match lazy
    False() -> member_here(predicate_repeat_consuming_start(), Cons(predicate_repeat_empty_start(), Nil()))
    True() -> member_there(predicate_repeat_empty_start(), member_here(predicate_repeat_consuming_start(), Nil()))

  fn predicate_repeat_singleton_result_member(
    test: Char -> Bool,
    lazy: Bool,
    char: Char,
    after_input: List(Char),
    holds: Equivalent(Bool, test(char), True())
  ) -> ListMember(MachineState(S(Z())), predicate_repeat_singleton_accepting(char), machine_destinations(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), ThreadActive(First()), char, transition_boundary_before(char, Nil(), after_input))) = match lazy
    False() -> rewrite holds in member_there(predicate_repeat_singleton_reentry(char), member_here(predicate_repeat_singleton_accepting(char), Nil()))
    True() -> rewrite holds in member_here(predicate_repeat_singleton_accepting(char), Cons(predicate_repeat_singleton_reentry(char), Nil()))

  fn predicate_repeat_mode_singleton_acceptance_is_complete(
    test: Char -> Bool,
    lazy: Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PredicateRepeatAcceptance(test, lazy, Cons(char, Nil()), after_input, position) =
    let holds = predicate_denotation_truth(test, char, after_input, position, denotation)
    let no_captures: List(CaptureFrame) = Nil()
    let no_extended: List(ExtendedInstruction) = Nil()
    let initial_evidence: List(Evidence) = Cons(BeginListEvidence(), Nil())
    let final_evidence: List(Evidence) = Cons(EndListEvidence(), Cons(CharacterEvidence(char), initial_evidence))
    let initial_regular: List(EvidenceInstruction) = Cons(BeginList(), Nil())
    let transition_regular: List(EvidenceInstruction) = Cons(EmitChar(char), Cons(EndList(), Nil()))
    let path_routine = transition_routine(char, transition_regular)
    let initial_edge = predicate_repeat_consuming_initial_member(test, lazy, position, char, Nil(), after_input)
    let transition_edge = predicate_repeat_singleton_result_member(test, lazy, char, after_input, holds)
    let initial_execution: RoutineExecution(initial_regular, Nil(), Nil(), initial_evidence, no_captures) = RoutineStep(BeginList(), RoutineDone())
    let transition_execution: RoutineExecution(transition_regular, initial_evidence, record_capture_char(no_captures, char), final_evidence, no_captures) = RoutineStep(EmitChar(char), RoutineStep(EndList(), RoutineDone()))
    let initial_extended: ExtendedEvidenceRoutineExecution(regular_routine(initial_regular), Nil(), Nil(), initial_evidence, no_captures) = ExtendedEvidenceRegular(BeginList(), ExtendedEvidenceDone())
    let transition_extended: ExtendedEvidenceRoutineExecution(regular_routine(transition_regular), initial_evidence, record_capture_char(no_captures, char), final_evidence, no_captures) = ExtendedEvidenceRegular(EmitChar(char), ExtendedEvidenceRegular(EndList(), ExtendedEvidenceDone()))
    let path: AcceptingFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), Cons(char, Nil()), after_input, ThreadActive(First()), initial_evidence, no_captures, final_evidence, path_routine) = AcceptingNextAccepted(transition_regular, Nil(), final_evidence, no_captures, no_extended, transition_edge, transition_execution, AcceptingNow())
    let path_certificate: CertifiedPathRoutine(path_routine, initial_evidence, no_captures, final_evidence) = PathRoutineTransition(char, transition_regular, no_extended, final_evidence, no_captures, transition_extended, PathRoutineDone())
    let complete_routine = append_extended_routines(regular_routine(initial_regular), path_routine)
    let certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(initial_regular, path_routine, initial_evidence, no_captures, initial_extended, path_certificate)
    PredicateRepeatAccepted(final_evidence, complete_routine, MachineAccepted(predicate_repeat_consuming_start(), initial_evidence, no_captures, path_routine, initial_edge, initial_execution, certificate, path))

  fn predicate_repeat_mode_singleton_is_complete(
    test: Char -> Bool,
    lazy: Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, Cons(char, Nil()), after_input) =
    match predicate_repeat_mode_singleton_acceptance_is_complete(test, lazy, char, after_input, position, denotation)
      PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  fn predicate_repeat_singleton_is_complete(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, Cons(char, Nil()), after_input) =
    match predicate_repeat_mode_singleton_acceptance_is_complete(test, False(), char, after_input, position, denotation)
      PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  fn predicate_repeat_reentry_result_member(
    test: Char -> Bool,
    lazy: Bool,
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    holds: Equivalent(Bool, test(char), True())
  ) -> ListMember(MachineState(S(Z())), predicate_repeat_singleton_reentry(char), machine_destinations(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), ThreadActive(First()), char, transition_boundary_before(char, rest, after_input))) = match lazy
    False() -> rewrite holds in member_here(predicate_repeat_singleton_reentry(char), Cons(predicate_repeat_singleton_accepting(char), Nil()))
    True() -> rewrite holds in member_there(predicate_repeat_singleton_accepting(char), member_here(predicate_repeat_singleton_reentry(char), Nil()))

  fn predicate_repeat_mode_pair_acceptance_is_complete(
    test: Char -> Bool,
    lazy: Bool,
    first_char: Char,
    second_char: Char,
    after_input: List(Char),
    position: InitialPosition,
    first_denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(first_char, Nil()), Cons(second_char, after_input)),
    second_denotation: PatternDenotation(CharC, PatternPredicate(test), advance_initial_position(position, Cons(first_char, Nil())), Cons(second_char, Nil()), after_input)
  ) -> PredicateRepeatAcceptance(test, lazy, Cons(first_char, Cons(second_char, Nil())), after_input, position) =
    let first_holds = predicate_denotation_truth(test, first_char, Cons(second_char, after_input), position, first_denotation)
    let second_holds = predicate_denotation_truth(test, second_char, after_input, advance_initial_position(position, Cons(first_char, Nil())), second_denotation)
    let no_captures: List(CaptureFrame) = Nil()
    let no_extended: List(ExtendedInstruction) = Nil()
    let initial_evidence: List(Evidence) = Cons(BeginListEvidence(), Nil())
    let first_evidence: List(Evidence) = Cons(CharacterEvidence(first_char), initial_evidence)
    let final_evidence: List(Evidence) = Cons(EndListEvidence(), Cons(CharacterEvidence(second_char), first_evidence))
    let initial_regular: List(EvidenceInstruction) = Cons(BeginList(), Nil())
    let first_regular: List(EvidenceInstruction) = Cons(EmitChar(first_char), Nil())
    let second_regular: List(EvidenceInstruction) = Cons(EmitChar(second_char), Cons(EndList(), Nil()))
    let initial_edge = predicate_repeat_consuming_initial_member(test, lazy, position, first_char, Cons(second_char, Nil()), after_input)
    let first_edge = predicate_repeat_reentry_result_member(test, lazy, first_char, Cons(second_char, Nil()), after_input, first_holds)
    let second_edge = predicate_repeat_singleton_result_member(test, lazy, second_char, after_input, second_holds)
    let initial_execution: RoutineExecution(initial_regular, Nil(), Nil(), initial_evidence, no_captures) = RoutineStep(BeginList(), RoutineDone())
    let first_execution: RoutineExecution(first_regular, initial_evidence, record_capture_char(no_captures, first_char), first_evidence, no_captures) = RoutineStep(EmitChar(first_char), RoutineDone())
    let second_execution: RoutineExecution(second_regular, first_evidence, record_capture_char(no_captures, second_char), final_evidence, no_captures) = RoutineStep(EmitChar(second_char), RoutineStep(EndList(), RoutineDone()))
    let initial_extended: ExtendedEvidenceRoutineExecution(regular_routine(initial_regular), Nil(), Nil(), initial_evidence, no_captures) = ExtendedEvidenceRegular(BeginList(), ExtendedEvidenceDone())
    let first_extended: ExtendedEvidenceRoutineExecution(regular_routine(first_regular), initial_evidence, record_capture_char(no_captures, first_char), first_evidence, no_captures) = ExtendedEvidenceRegular(EmitChar(first_char), ExtendedEvidenceDone())
    let second_extended: ExtendedEvidenceRoutineExecution(regular_routine(second_regular), first_evidence, record_capture_char(no_captures, second_char), final_evidence, no_captures) = ExtendedEvidenceRegular(EmitChar(second_char), ExtendedEvidenceRegular(EndList(), ExtendedEvidenceDone()))
    let second_path_routine = transition_routine(second_char, second_regular)
    let second_path: AcceptingFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), Cons(second_char, Nil()), after_input, ThreadActive(First()), first_evidence, no_captures, final_evidence, second_path_routine) = AcceptingNextAccepted(second_regular, Nil(), final_evidence, no_captures, no_extended, second_edge, second_execution, AcceptingNow())
    let second_certificate: CertifiedPathRoutine(second_path_routine, first_evidence, no_captures, final_evidence) = PathRoutineTransition(second_char, second_regular, no_extended, final_evidence, no_captures, second_extended, PathRoutineDone())
    let complete_path_routine = append_extended_routines(transition_routine(first_char, first_regular), second_path_routine)
    let complete_path: AcceptingFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), Cons(first_char, Cons(second_char, Nil())), after_input, ThreadActive(First()), initial_evidence, no_captures, final_evidence, complete_path_routine) = AcceptingNextActive(First(), first_regular, Nil(), first_evidence, no_captures, second_path_routine, first_edge, first_execution, second_path)
    let path_certificate: CertifiedPathRoutine(complete_path_routine, initial_evidence, no_captures, final_evidence) = PathRoutineTransition(first_char, first_regular, second_path_routine, first_evidence, no_captures, first_extended, second_certificate)
    let complete_routine = append_extended_routines(regular_routine(initial_regular), complete_path_routine)
    let certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(initial_regular, complete_path_routine, initial_evidence, no_captures, initial_extended, path_certificate)
    PredicateRepeatAccepted(final_evidence, complete_routine, MachineAccepted(predicate_repeat_consuming_start(), initial_evidence, no_captures, complete_path_routine, initial_edge, initial_execution, certificate, complete_path))

  fn predicate_repeat_mode_pair_is_complete(
    test: Char -> Bool,
    lazy: Bool,
    first_char: Char,
    second_char: Char,
    after_input: List(Char),
    position: InitialPosition,
    first_denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(first_char, Nil()), Cons(second_char, after_input)),
    second_denotation: PatternDenotation(CharC, PatternPredicate(test), advance_initial_position(position, Cons(first_char, Nil())), Cons(second_char, Nil()), after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, Cons(first_char, Cons(second_char, Nil())), after_input) =
    match predicate_repeat_mode_pair_acceptance_is_complete(test, lazy, first_char, second_char, after_input, position, first_denotation, second_denotation)
      PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  fn predicate_repeat_pair_is_complete(
    test: Char -> Bool,
    first_char: Char,
    second_char: Char,
    after_input: List(Char),
    position: InitialPosition,
    first_denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(first_char, Nil()), Cons(second_char, after_input)),
    second_denotation: PatternDenotation(CharC, PatternPredicate(test), advance_initial_position(position, Cons(first_char, Nil())), Cons(second_char, Nil()), after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, Cons(first_char, Cons(second_char, Nil())), after_input) =
    match predicate_repeat_mode_pair_acceptance_is_complete(test, False(), first_char, second_char, after_input, position, first_denotation, second_denotation)
      PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  type PredicateRepeatContinuation indices (test: Char -> Bool, lazy: Bool, input: List(Char), after_input: List(Char), current_evidence: List(Evidence))
    PredicateRepeatContinued : (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (path: AcceptingFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), input, after_input, ThreadActive(First()), current_evidence, Nil(), final_evidence, routine)) -> (certificate: CertifiedPathRoutine(routine, current_evidence, Nil(), final_evidence)) -> PredicateRepeatContinuation(test, lazy, input, after_input, current_evidence)

  fn predicate_repeat_mode_continuation(
    test: Char -> Bool,
    lazy: Bool,
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    current_evidence: List(Evidence),
    position: InitialPosition,
    denotation: PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, Cons(char, rest), after_input)
  ) -> PredicateRepeatContinuation(test, lazy, Cons(char, rest), after_input, current_evidence) = match denotation
    DenotesRepeatModeMore(_, _, _, _, _, partition, item_denotation, remaining_denotation) -> match item_denotation
      DenotesPredicate(_, _, singleton, holds) -> match singleton
        IsSingleCharacter(_, _, exact) -> match exact
          reflexive() -> match partition
            InputPartitionThere(_, prior) -> match prior
              InputPartitionHere(_) -> match rest
                Nil() ->
                  let no_captures: List(CaptureFrame) = Nil()
                  let no_extended: List(ExtendedInstruction) = Nil()
                  let regular: List(EvidenceInstruction) = Cons(EmitChar(char), Cons(EndList(), Nil()))
                  let final_evidence: List(Evidence) = Cons(EndListEvidence(), Cons(CharacterEvidence(char), current_evidence))
                  let edge = predicate_repeat_singleton_result_member(test, lazy, char, after_input, holds)
                  let execution: RoutineExecution(regular, current_evidence, record_capture_char(no_captures, char), final_evidence, no_captures) = RoutineStep(EmitChar(char), RoutineStep(EndList(), RoutineDone()))
                  let extended: ExtendedEvidenceRoutineExecution(regular_routine(regular), current_evidence, record_capture_char(no_captures, char), final_evidence, no_captures) = ExtendedEvidenceRegular(EmitChar(char), ExtendedEvidenceRegular(EndList(), ExtendedEvidenceDone()))
                  let routine = transition_routine(char, regular)
                  let path: AcceptingFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), Cons(char, Nil()), after_input, ThreadActive(First()), current_evidence, no_captures, final_evidence, routine) = AcceptingNextAccepted(regular, Nil(), final_evidence, no_captures, no_extended, edge, execution, AcceptingNow())
                  let certificate: CertifiedPathRoutine(routine, current_evidence, no_captures, final_evidence) = PathRoutineTransition(char, regular, no_extended, final_evidence, no_captures, extended, PathRoutineDone())
                  PredicateRepeatContinued(final_evidence, routine, path, certificate)
                Cons(next_char, tail) ->
                  let no_captures: List(CaptureFrame) = Nil()
                  let regular: List(EvidenceInstruction) = Cons(EmitChar(char), Nil())
                  let next_evidence: List(Evidence) = Cons(CharacterEvidence(char), current_evidence)
                  let edge = predicate_repeat_reentry_result_member(test, lazy, char, Cons(next_char, tail), after_input, holds)
                  let execution: RoutineExecution(regular, current_evidence, record_capture_char(no_captures, char), next_evidence, no_captures) = RoutineStep(EmitChar(char), RoutineDone())
                  let extended: ExtendedEvidenceRoutineExecution(regular_routine(regular), current_evidence, record_capture_char(no_captures, char), next_evidence, no_captures) = ExtendedEvidenceRegular(EmitChar(char), ExtendedEvidenceDone())
                  match predicate_repeat_mode_continuation(test, lazy, next_char, tail, after_input, next_evidence, advance_initial_position(position, Cons(char, Nil())), remaining_denotation)
                    PredicateRepeatContinued(final_evidence, suffix_routine, suffix, suffix_certificate) ->
                      let routine = append_extended_routines(transition_routine(char, regular), suffix_routine)
                      let path: AcceptingFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), Cons(char, Cons(next_char, tail)), after_input, ThreadActive(First()), current_evidence, no_captures, final_evidence, routine) = AcceptingNextActive(First(), regular, Nil(), next_evidence, no_captures, suffix_routine, edge, execution, suffix)
                      let certificate: CertifiedPathRoutine(routine, current_evidence, no_captures, final_evidence) = PathRoutineTransition(char, regular, suffix_routine, next_evidence, no_captures, extended, suffix_certificate)
                      PredicateRepeatContinued(final_evidence, routine, path, certificate)

  fn predicate_repeat_mode_acceptance_from_denotation(
    test: Char -> Bool,
    lazy: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input)
  ) -> PredicateRepeatAcceptance(test, lazy, input, after_input, position) = match input
    Nil() -> predicate_repeat_mode_empty_acceptance_is_complete(test, lazy, after_input, position)
    Cons(char, rest) ->
      let no_captures: List(CaptureFrame) = Nil()
      let initial_evidence: List(Evidence) = Cons(BeginListEvidence(), Nil())
      let initial_regular: List(EvidenceInstruction) = Cons(BeginList(), Nil())
      let initial_edge = predicate_repeat_consuming_initial_member(test, lazy, position, char, rest, after_input)
      let initial_execution: RoutineExecution(initial_regular, Nil(), Nil(), initial_evidence, no_captures) = RoutineStep(BeginList(), RoutineDone())
      let initial_extended: ExtendedEvidenceRoutineExecution(regular_routine(initial_regular), Nil(), Nil(), initial_evidence, no_captures) = ExtendedEvidenceRegular(BeginList(), ExtendedEvidenceDone())
      match predicate_repeat_mode_continuation(test, lazy, char, rest, after_input, initial_evidence, position, denotation)
        PredicateRepeatContinued(final_evidence, path_routine, path, path_certificate) ->
          let complete_routine = append_extended_routines(regular_routine(initial_regular), path_routine)
          let certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(initial_regular, path_routine, initial_evidence, no_captures, initial_extended, path_certificate)
          PredicateRepeatAccepted(final_evidence, complete_routine, MachineAccepted(predicate_repeat_consuming_start(), initial_evidence, no_captures, path_routine, initial_edge, initial_execution, certificate, path))

  fn repeat_default_denotation_is_false_mode(
    {inner_shape: ShapeCode},
    inner: Pattern(inner_shape),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    denotation: PatternDenotation(ListC(inner_shape), PatternRepeat(inner), position, input, after_input)
  ) -> PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, False()), position, input, after_input) = match denotation
    DenotesRepeatEmpty(_) -> DenotesRepeatModeEmpty(inner, False())
    DenotesRepeatMore(_, item_input, remaining_input, nonempty, partition, item_denotation, remaining_denotation) ->
      DenotesRepeatModeMore(inner, False(), item_input, remaining_input, nonempty, partition, item_denotation, repeat_default_denotation_is_false_mode(inner, advance_initial_position(position, item_input), remaining_input, after_input, remaining_denotation))

  fn predicate_repeat_mode_denotation_is_complete(
    test: Char -> Bool,
    lazy: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input) = match predicate_repeat_mode_acceptance_from_denotation(test, lazy, input, after_input, position, denotation)
    PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  fn predicate_repeat_denotation_is_complete(
    test: Char -> Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, input, after_input)
  ) -> PatternAcceptance(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, input, after_input) =
    match predicate_repeat_mode_acceptance_from_denotation(test, False(), input, after_input, position, repeat_default_denotation_is_false_mode(PatternPredicate(test), position, input, after_input, denotation))
      PredicateRepeatAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)
