@group(:text)
mod Std.Regex.Language
  use Std.Regex
  use Std.Regex.Proof
  use Std.Proof.IntMath

  ## Structural membership in the language of a typed pattern.  The relation is
  ## indexed by the exact consumed input, the contextual suffix, and the
  ## position at which matching began; boundary assertions therefore remain
  ## part of the language rather than an unchecked side condition.
  type NonEmptyCharacters indices (input: List(Char))
    CharactersPresent : (head: Char) -> (tail: List(Char)) -> NonEmptyCharacters(Cons(head, tail))

  type SingleCharacter indices (input: List(Char), char: Char)
    IsSingleCharacter : (input: List(Char)) -> (char: Char) -> (@erased exact: Equivalent(List(Char), input, Cons(char, Nil()))) -> SingleCharacter(input, char)

  type PatternDenotation indices (shape: ShapeCode, pattern: Pattern(shape), position: InitialPosition, input: List(Char), after_input: List(Char))
    DenotesEmpty : PatternDenotation(UnitC, PatternEmpty(), position, Nil(), after_input)
    DenotesPredicate : (input: List(Char)) -> (char: Char) -> (@erased singleton: SingleCharacter(input, char)) -> (proof: Equivalent(Bool, test(char), True())) -> PatternDenotation(CharC, PatternPredicate(test), position, input, after_input)
    DenotesBoundary : (proof: IsTrue(constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input)))) -> PatternDenotation(UnitC, PatternBoundary(constraint), position, Nil(), after_input)
    DenotesConcat : (left: Pattern(left_shape)) -> (right: Pattern(right_shape)) -> (left_input: List(Char)) -> (right_input: List(Char)) -> (@erased partition: InputPartition(input, left_input, right_input)) -> (@erased left_denotation: PatternDenotation(left_shape, left, position, left_input, append_characters(right_input, after_input))) -> (@erased right_denotation: PatternDenotation(right_shape, right, advance_initial_position(position, left_input), right_input, after_input)) -> PatternDenotation(PairC(left_shape, right_shape), PatternConcat(left, right), position, input, after_input)
    DenotesGroup : (inner: Pattern(inner_shape)) -> (@erased inner_denotation: PatternDenotation(inner_shape, inner, position, input, after_input)) -> PatternDenotation(StringC, PatternGroup(inner), position, input, after_input)
    DenotesAlternateLeft : (left: Pattern(left_shape)) -> (right: Pattern(right_shape)) -> (@erased left_denotation: PatternDenotation(left_shape, left, position, input, after_input)) -> PatternDenotation(ChoiceC(left_shape, right_shape), PatternAlternate(left, right), position, input, after_input)
    DenotesAlternateRight : (left: Pattern(left_shape)) -> (right: Pattern(right_shape)) -> (@erased right_denotation: PatternDenotation(right_shape, right, position, input, after_input)) -> PatternDenotation(ChoiceC(left_shape, right_shape), PatternAlternate(left, right), position, input, after_input)
    DenotesAlternateModeLeft : (left: Pattern(left_shape)) -> (right: Pattern(right_shape)) -> (prefer_right: Bool) -> (@erased left_denotation: PatternDenotation(left_shape, left, position, input, after_input)) -> PatternDenotation(ChoiceC(left_shape, right_shape), PatternAlternateMode(left, right, prefer_right), position, input, after_input)
    DenotesAlternateModeRight : (left: Pattern(left_shape)) -> (right: Pattern(right_shape)) -> (prefer_right: Bool) -> (@erased right_denotation: PatternDenotation(right_shape, right, position, input, after_input)) -> PatternDenotation(ChoiceC(left_shape, right_shape), PatternAlternateMode(left, right, prefer_right), position, input, after_input)
    DenotesRepeatEmpty : (inner: Pattern(inner_shape)) -> PatternDenotation(ListC(inner_shape), PatternRepeat(inner), position, Nil(), after_input)
    DenotesRepeatMore : (inner: Pattern(inner_shape)) -> (item_input: List(Char)) -> (remaining_input: List(Char)) -> (@erased nonempty: NonEmptyCharacters(item_input)) -> (@erased partition: InputPartition(input, item_input, remaining_input)) -> (@erased item_denotation: PatternDenotation(inner_shape, inner, position, item_input, append_characters(remaining_input, after_input))) -> (@erased remaining_denotation: PatternDenotation(ListC(inner_shape), PatternRepeat(inner), advance_initial_position(position, item_input), remaining_input, after_input)) -> PatternDenotation(ListC(inner_shape), PatternRepeat(inner), position, input, after_input)
    DenotesRepeatModeEmpty : (inner: Pattern(inner_shape)) -> (lazy: Bool) -> PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, Nil(), after_input)
    DenotesRepeatModeMore : (inner: Pattern(inner_shape)) -> (lazy: Bool) -> (item_input: List(Char)) -> (remaining_input: List(Char)) -> (@erased nonempty: NonEmptyCharacters(item_input)) -> (@erased partition: InputPartition(input, item_input, remaining_input)) -> (@erased item_denotation: PatternDenotation(inner_shape, inner, position, item_input, append_characters(remaining_input, after_input))) -> (@erased remaining_denotation: PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), advance_initial_position(position, item_input), remaining_input, after_input)) -> PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, input, after_input)

  ## Constructive completeness packages the runtime outputs existentially while
  ## retaining the erased certificate that those outputs came from the verified
  ## machine.  Callers do not have to guess the evidence stream or routine.
  type PredicateAcceptance indices (test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition)
    PredicateAccepted : (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (@erased acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input, final_evidence, routine)) -> PredicateAcceptance(test, char, after_input, position)

  type EmptyAcceptance indices (after_input: List(Char), position: InitialPosition)
    EmptyAccepted : (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (@erased acceptance: MachineAcceptance(Z(), empty_pattern_machine(), position, Nil(), after_input, final_evidence, routine)) -> EmptyAcceptance(after_input, position)

  type BoundaryAcceptance indices (constraint: BoundaryConstraint, after_input: List(Char), position: InitialPosition)
    BoundaryAccepted : (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (@erased acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, Nil(), after_input, final_evidence, routine)) -> BoundaryAcceptance(constraint, after_input, position)

  type PatternAcceptance indices (shape: ShapeCode, pattern: Pattern(shape), position: InitialPosition, input: List(Char), after_input: List(Char))
    PatternAccepted : {accepted_shape: ShapeCode} -> {accepted_pattern: Pattern(accepted_shape)} -> {accepted_position: InitialPosition} -> {accepted_input: List(Char)} -> {accepted_after_input: List(Char)} -> (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (@erased acceptance: MachineAcceptance(thompson_state_count(certify_thompson(accepted_pattern)), thompson_machine(certify_thompson(accepted_pattern)), accepted_position, accepted_input, accepted_after_input, final_evidence, routine)) -> PatternAcceptance(accepted_shape, accepted_pattern, accepted_position, accepted_input, accepted_after_input)

  fn predicate_result_member(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    predicate_holds: Equivalent(Bool, test(char), True())
  ) -> ListMember(MachineState(S(Z())), predicate_accepting_destination(char), machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, transition_boundary_before(char, Nil(), after_input))) =
    rewrite predicate_holds in member_here(predicate_accepting_destination(char), Nil())

  fn boundary_result_member(
    constraint: BoundaryConstraint,
    after_input: List(Char),
    position: InitialPosition,
    holds: IsTrue(constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input)))
  ) -> ListMember(MachineState(Z()), boundary_accepting_destination(), initial_machine_destinations(Z(), boundary_pattern_machine(constraint), position, Nil(), after_input)) =
    let routine: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
    let constraints: List(BoundaryConstraint) = Cons(constraint, Nil())
    let states: List(MachineState(Z())) = Cons(Accepted(routine, constraints), Nil())
    let raw_edge = member_here(Accepted(routine, constraints), Nil())
    let boundary = initial_position_boundary(position, after_input)
    let equality = is_true_equivalence(constraints_hold(constraints, boundary), holds)
    filter_accepted_member(Z(), states, boundary, routine, constraints, raw_edge, equality)

  fn is_true_equivalence(claim: Bool, proof: IsTrue(claim)) -> Equivalent(Bool, claim, True()) = match proof
    Confirmed() -> reflexive(True())

  fn equivalent_true_is_true(claim: Bool, equality: Equivalent(Bool, claim, True())) -> IsTrue(claim) = match equality
    reflexive() -> Confirmed()

  fn singleton_from_empty_rest(char: Char, rest: List(Char), rest_empty: Equivalent(List(Char), rest, Nil())) -> SingleCharacter(Cons(char, rest), char) = match rest_empty
    reflexive() -> IsSingleCharacter(Cons(char, Nil()), char, reflexive(Cons(char, Nil())))

  fn boundary_acceptance_truth(
    constraint: BoundaryConstraint,
    after_input: List(Char),
    position: InitialPosition,
    destination: MachineState(Z()),
    edge: ListMember(MachineState(Z()), destination, initial_machine_destinations(Z(), boundary_pattern_machine(constraint), position, Nil(), after_input))
  ) -> Equivalent(Bool, constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input)), True()) =
    let filtered_edge = filtered_starts_from_initial_edge(Z(), boundary_pattern_machine(constraint), position, Nil(), after_input, destination, edge)
    match filtered_state_origin(Z(), Cons(Accepted(Cons(EmitUnit(), Nil()), Cons(constraint, Nil())), Nil()), initial_position_boundary(position, after_input), destination, filtered_edge)
      FilteredActiveStateOrigin(_, _, _, raw_edge, _) -> match raw_edge
        ListMemberThere(prior) -> impossible_list_member(prior)
      FilteredAcceptedStateOrigin(_, _, raw_edge, holds) -> match raw_edge
        ListMemberHere() -> holds
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_acceptance_truth(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input, final_evidence, routine)
  ) -> Equivalent(Bool, test(char), True()) = match acceptance
    MachineAccepted(_, _, _, _, initial_edge, initial_execution, _, path) -> match predicate_starts_view(test, position, Cons(char, Nil()), after_input)
      PredicateStartsExact() -> match initial_edge
        ListMemberHere() -> match initial_execution
          RoutineDone() -> match path
            AcceptingNextActive(destination, regular, constraints, _, _, _, edge, _, _) ->
              match predicate_transition_truth(test, char, transition_boundary_before(char, Nil(), after_input), Active(destination, regular, constraints), edge)
                PredicateTransitionHeld(predicate_holds) -> predicate_holds
            AcceptingNextAccepted(regular, constraints, _, _, _, edge, _, _) ->
              match predicate_transition_truth(test, char, transition_boundary_before(char, Nil(), after_input), Accepted(regular, constraints), edge)
                PredicateTransitionHeld(predicate_holds) -> predicate_holds
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_acceptance_path_truth(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input, input_evidence, input_captures, final_evidence)
  ) -> Equivalent(Bool, test(char), True()) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(initial_edge, mk_pair(initial_execution, path)))))) ->
      match predicate_starts_view(test, position, Cons(char, Nil()), after_input)
        PredicateStartsExact() -> match initial_edge
          ListMemberHere() -> match initial_execution
            RoutineDone() -> match path
              AcceptingNextActive(next_destination, regular, constraints, _, _, _, edge, _, _) ->
                match predicate_transition_truth(test, char, transition_boundary_before(char, Nil(), after_input), Active(next_destination, regular, constraints), edge)
                  PredicateTransitionHeld(predicate_holds) -> predicate_holds
              AcceptingNextAccepted(regular, constraints, _, _, _, edge, _, _) ->
                match predicate_transition_truth(test, char, transition_boundary_before(char, Nil(), after_input), Accepted(regular, constraints), edge)
                  PredicateTransitionHeld(predicate_holds) -> predicate_holds
          ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_active_path_is_sound(
    test: Char -> Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    current_evidence: List(Evidence),
    current_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), input, after_input, predicate_machine_thread(), current_evidence, current_captures, final_evidence, routine)
  ) -> PatternDenotation(CharC, PatternPredicate(test), position, input, after_input) = match input
    Nil() -> match path
        AcceptingNow() -> impossible
        AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
        AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(destination, regular, constraints, _, _, _, edge, _, _) -> predicate_active_capture_impossible(test, char, transition_boundary_before(char, rest, after_input), edge)
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, _, suffix) -> match predicate_transition_truth(test, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
        PredicateTransitionHeld(predicate_holds) ->
          let rest_empty = accepted_path_input_empty(S(Z()), predicate_pattern_machine(test), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
          DenotesPredicate(Cons(char, rest), char, singleton_from_empty_rest(char, rest, rest_empty), predicate_holds)

  fn predicate_acceptance_path_is_sound(test: Char -> Bool, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), @erased final_evidence: List(Evidence), acceptance: AcceptancePathFrom(S(Z()), predicate_pattern_machine(test), position, input, after_input, input_evidence, input_captures, final_evidence)) -> PatternDenotation(CharC, PatternPredicate(test), position, input, after_input) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(initial_edge, mk_pair(initial_execution, path)))))) -> match predicate_starts_view(test, position, input, after_input)
      PredicateStartsExact() -> match initial_edge
        ListMemberHere() -> match initial_execution
          RoutineDone() -> predicate_active_path_is_sound(test, input, after_input, position, input_evidence, input_captures, final_evidence, path_routine, path)
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_acceptance_is_sound(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input, final_evidence, routine)
  ) -> PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input) =
    DenotesPredicate(Cons(char, Nil()), char, IsSingleCharacter(Cons(char, Nil()), char, reflexive(Cons(char, Nil()))), predicate_acceptance_truth(test, char, after_input, position, final_evidence, routine, acceptance))

  fn empty_acceptance_is_sound(
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    _acceptance: MachineAcceptance(Z(), empty_pattern_machine(), position, Nil(), after_input, final_evidence, routine)
  ) -> PatternDenotation(UnitC, PatternEmpty(), position, Nil(), after_input) = DenotesEmpty()

  fn boundary_acceptance_is_sound(
    constraint: BoundaryConstraint,
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, Nil(), after_input, final_evidence, routine)
  ) -> PatternDenotation(UnitC, PatternBoundary(constraint), position, Nil(), after_input) = match acceptance
    MachineAccepted(destination, _, _, _, edge, _, _, _) ->
      let truth = boundary_acceptance_truth(constraint, after_input, position, destination, edge)
      DenotesBoundary(equivalent_true_is_true(constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input)), truth))

  fn grouped_predicate_acceptance_is_sound(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, Cons(char, Nil()), after_input, final_evidence, routine)
  ) -> PatternDenotation(StringC, PatternGroup(PatternPredicate(test)), position, Cons(char, Nil()), after_input) =
    let no_evidence: List(Evidence) = Nil()
    let no_captures: List(CaptureFrame) = Nil()
    let opened_captures: List(CaptureFrame) = Cons(CaptureFrame(Nil(), no_evidence), no_captures)
    match project_group_acceptance_from(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test), position, Cons(char, Nil()), after_input, no_evidence, no_captures, machine_acceptance_path(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, Cons(char, Nil()), after_input, acceptance))
      ProjectedGroupAcceptanceMissingFrame(child_final_evidence, AcceptedWithExecution(child_acceptance, _), _, _, _, _) ->
        DenotesGroup(PatternPredicate(test), DenotesPredicate(Cons(char, Nil()), char, IsSingleCharacter(Cons(char, Nil()), char, reflexive(Cons(char, Nil()))), predicate_acceptance_path_truth(test, char, after_input, position, no_evidence, opened_captures, child_final_evidence, child_acceptance)))
      ProjectedGroupAcceptanceClosedFrame(child_final_evidence, _, _, _, AcceptedWithExecution(child_acceptance, _), _, _, _, _) ->
        DenotesGroup(PatternPredicate(test), DenotesPredicate(Cons(char, Nil()), char, IsSingleCharacter(Cons(char, Nil()), char, reflexive(Cons(char, Nil()))), predicate_acceptance_path_truth(test, char, after_input, position, no_evidence, opened_captures, child_final_evidence, child_acceptance)))

  fn predicate_alternate_mode_acceptance_is_sound(
    left_test: Char -> Bool,
    right_test: Char -> Bool,
    prefer_right: Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(plus(S(Z()), S(Z())), alternate_pattern_machine(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test), prefer_right), position, Cons(char, Nil()), after_input, final_evidence, routine)
  ) -> PatternDenotation(ChoiceC(CharC, CharC), PatternAlternateMode(PatternPredicate(left_test), PatternPredicate(right_test), prefer_right), position, Cons(char, Nil()), after_input) =
    let no_evidence: List(Evidence) = Nil()
    let no_captures: List(CaptureFrame) = Nil()
    match project_alternate_acceptance_from(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test), prefer_right, position, Cons(char, Nil()), after_input, no_evidence, no_captures, machine_acceptance_path(plus(S(Z()), S(Z())), alternate_pattern_machine(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test), prefer_right), position, Cons(char, Nil()), after_input, acceptance))
      mk_pair(False(), ProjectedAlternateFromLeft(mk_pair(child_final_evidence, mk_pair(child_acceptance, _)))) ->
        DenotesAlternateModeLeft(PatternPredicate(left_test), PatternPredicate(right_test), prefer_right, DenotesPredicate(Cons(char, Nil()), char, IsSingleCharacter(Cons(char, Nil()), char, reflexive(Cons(char, Nil()))), predicate_acceptance_path_truth(left_test, char, after_input, position, no_evidence, no_captures, child_final_evidence, child_acceptance)))
      mk_pair(True(), ProjectedAlternateFromRight(mk_pair(child_final_evidence, mk_pair(child_acceptance, _)))) ->
        DenotesAlternateModeRight(PatternPredicate(left_test), PatternPredicate(right_test), prefer_right, DenotesPredicate(Cons(char, Nil()), char, IsSingleCharacter(Cons(char, Nil()), char, reflexive(Cons(char, Nil()))), predicate_acceptance_path_truth(right_test, char, after_input, position, no_evidence, no_captures, child_final_evidence, child_acceptance)))

  fn predicate_concat_acceptance_is_sound(
    left_test: Char -> Bool,
    right_test: Char -> Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(plus(S(Z()), S(Z())), concat_pattern_machine(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test)), position, input, after_input, final_evidence, routine)
  ) -> PatternDenotation(PairC(CharC, CharC), PatternConcat(PatternPredicate(left_test), PatternPredicate(right_test)), position, input, after_input) =
    let no_evidence: List(Evidence) = Nil()
    let no_captures: List(CaptureFrame) = Nil()
    match project_concat_acceptance_from(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test), position, input, after_input, no_evidence, no_captures, machine_acceptance_path(plus(S(Z()), S(Z())), concat_pattern_machine(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test)), position, input, after_input, acceptance))
      ProjectedConcatAcceptance(left_input, right_input, partition, left_final_evidence, left_final_captures, left_acceptance, _, right_final_evidence, right_acceptance, _) ->
        DenotesConcat(
          PatternPredicate(left_test), PatternPredicate(right_test), left_input, right_input, partition,
          predicate_acceptance_path_is_sound(left_test, left_input, append_characters(right_input, after_input), position, no_evidence, no_captures, left_final_evidence, left_acceptance),
          predicate_acceptance_path_is_sound(right_test, right_input, after_input, advance_initial_position(position, left_input), left_final_evidence, left_final_captures, right_final_evidence, right_acceptance)
        )

  fn input_partition_all_left(input: List(Char)) -> InputPartition(input, input, Nil()) = match input
    Nil() -> InputPartitionHere(Nil())
    Cons(char, rest) -> InputPartitionThere(char, input_partition_all_left(rest))

  fn active_accepting_path_nonempty(
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    current_evidence: List(Evidence),
    current_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    path: AcceptingFrom(n, machine, input, after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine)
  ) -> NonEmptyCharacters(input) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> CharactersPresent(char, rest)

  fn predicate_repeat_mode_projection_is_sound(
    test: Char -> Bool,
    lazy: Bool,
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    item_input_evidence: List(Evidence),
    item_input_captures: List(CaptureFrame),
    state: Bounded(S(Z())),
    initial_routine: List(EvidenceInstruction),
    initial_evidence: List(Evidence),
    initial_captures: List(CaptureFrame),
    initial_edge: ListMember(MachineState(S(Z())), Active(state, initial_routine, Nil()), initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, input, after_input)),
    initial_execution: RoutineExecution(initial_routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures),
    @erased final_evidence: List(Evidence),
    {final_captures: List(CaptureFrame)},
    projection: RepeatActivePathProjection(S(Z()), predicate_pattern_machine(test), lazy, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)
  ) -> PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input) = match projection
    ProjectedRepeatFinalItem(child_final_evidence, _, child_routine, child_path, _, _, _, _, _) ->
      let child_acceptance = active_acceptance_from_path(S(Z()), predicate_pattern_machine(test), position, input, after_input, item_input_evidence, item_input_captures, state, initial_routine, initial_evidence, initial_captures, child_routine, initial_edge, initial_execution, child_path)
      let child_denotation = predicate_acceptance_path_is_sound(test, input, after_input, position, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance)
      DenotesRepeatModeMore(PatternPredicate(test), lazy, input, Nil(), active_accepting_path_nonempty(S(Z()), predicate_pattern_machine(test), input, after_input, state, initial_evidence, initial_captures, child_final_evidence, child_routine, child_path), input_partition_all_left(input), child_denotation, DenotesRepeatModeEmpty(PatternPredicate(test), lazy))
    ProjectedRepeatMoreItems(child_input, remaining_input, partition, child_final_evidence, child_final_captures, child_routine, child_path, _, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, combined_final_captures, continuation) ->
      let original_filtered_edge = filtered_starts_from_initial_edge(S(Z()), predicate_pattern_machine(test), position, input, after_input, Active(state, initial_routine, Nil()), initial_edge)
      let child_filtered_edge = transport_filtered_start_subject(S(Z()), predicate_pattern_machine(test), position, append_characters(input, after_input), append_characters(child_input, append_characters(remaining_input, after_input)), Active(state, initial_routine, Nil()), partition_append_after(after_input, partition), original_filtered_edge)
      let child_initial_edge = initial_edge_from_filtered_starts(S(Z()), predicate_pattern_machine(test), position, child_input, append_characters(remaining_input, after_input), Active(state, initial_routine, Nil()), child_filtered_edge)
      let child_acceptance = active_acceptance_from_path(S(Z()), predicate_pattern_machine(test), position, child_input, append_characters(remaining_input, after_input), item_input_evidence, item_input_captures, state, initial_routine, initial_evidence, initial_captures, child_routine, child_initial_edge, initial_execution, child_path)
      let child_denotation = predicate_acceptance_path_is_sound(test, child_input, append_characters(remaining_input, after_input), position, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance)
      let remaining_denotation = predicate_repeat_mode_projection_is_sound(test, lazy, advance_initial_position(position, child_input), remaining_input, after_input, child_final_evidence, child_final_captures, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, continuation)
      DenotesRepeatModeMore(PatternPredicate(test), lazy, child_input, remaining_input, active_accepting_path_nonempty(S(Z()), predicate_pattern_machine(test), child_input, append_characters(remaining_input, after_input), state, initial_evidence, initial_captures, child_final_evidence, child_routine, child_path), partition, child_denotation, remaining_denotation)

  fn predicate_repeat_mode_acceptance_path_is_sound(
    test: Char -> Bool,
    lazy: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, input, after_input, Nil(), Nil(), final_evidence)
  ) -> PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input) =
    let no_evidence: List(Evidence) = Nil()
    let no_captures: List(CaptureFrame) = Nil()
    match project_repeat_acceptance_from_machine(S(Z()), predicate_pattern_machine(test), lazy, position, input, after_input, no_evidence, no_captures, acceptance)
      ProjectedRepeatEmptyAcceptance(input_empty, _, _, _, _) -> match input_empty
        reflexive() -> DenotesRepeatModeEmpty(PatternPredicate(test), lazy)
      ProjectedRepeatItemsAcceptance(state, initial_routine, list_evidence, list_captures, initial_evidence, initial_captures, initial_edge, initial_execution, projection, _, _) -> predicate_repeat_mode_projection_is_sound(test, lazy, position, input, after_input, list_evidence, list_captures, state, initial_routine, initial_evidence, initial_captures, initial_edge, initial_execution, final_evidence, projection)

  fn predicate_repeat_mode_acceptance_is_sound(
    test: Char -> Bool,
    lazy: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, input, after_input, final_evidence, routine)
  ) -> PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input) =
    predicate_repeat_mode_acceptance_path_is_sound(test, lazy, input, after_input, position, final_evidence, machine_acceptance_path(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, input, after_input, acceptance))

  fn repeat_false_denotation_is_default(
    {inner_shape: ShapeCode},
    inner: Pattern(inner_shape),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    denotation: PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, False()), position, input, after_input)
  ) -> PatternDenotation(ListC(inner_shape), PatternRepeat(inner), position, input, after_input) = match denotation
    DenotesRepeatModeEmpty(_, _) -> DenotesRepeatEmpty(inner)
    DenotesRepeatModeMore(_, _, item_input, remaining_input, nonempty, partition, item_denotation, remaining_denotation) ->
      DenotesRepeatMore(inner, item_input, remaining_input, nonempty, partition, item_denotation, repeat_false_denotation_is_default(inner, advance_initial_position(position, item_input), remaining_input, after_input, remaining_denotation))

  fn predicate_repeat_acceptance_is_sound(
    test: Char -> Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), False()), position, input, after_input, final_evidence, routine)
  ) -> PatternDenotation(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, input, after_input) =
    repeat_false_denotation_is_default(PatternPredicate(test), position, input, after_input, predicate_repeat_mode_acceptance_is_sound(test, False(), input, after_input, position, final_evidence, routine, acceptance))

  fn predicate_denotation_truth(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> Equivalent(Bool, test(char), True()) = match denotation
    DenotesPredicate(_, _, singleton, predicate_holds) -> match singleton
      IsSingleCharacter(_, _, exact) -> match exact
        reflexive() -> predicate_holds

  fn predicate_denotation_is_complete(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PredicateAcceptance(test, char, after_input, position) =
      let predicate_holds = predicate_denotation_truth(test, char, after_input, position, denotation)
      let no_evidence: List(Evidence) = Nil()
      let no_captures: List(CaptureFrame) = Nil()
      let no_regular: List(EvidenceInstruction) = Nil()
      let no_extended: List(ExtendedInstruction) = Nil()
      let final_evidence: List(Evidence) = Cons(CharacterEvidence(char), Nil())
      let final_captures: List(CaptureFrame) = Nil()
      let predicate_regular: List(EvidenceInstruction) = Cons(EmitChar(char), Nil())
      let path_routine: List(ExtendedInstruction) = transition_routine(char, predicate_regular)
      let no_initial_states: List(MachineState(S(Z()))) = Nil()
      let initial_edge: ListMember(MachineState(S(Z())), predicate_machine_start(), initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input)) = member_here(predicate_machine_start(), no_initial_states)
      let transition_edge: ListMember(MachineState(S(Z())), predicate_accepting_destination(char), machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, transition_boundary_before(char, Nil(), after_input))) = predicate_result_member(test, char, after_input, predicate_holds)
      let initial_execution: RoutineExecution(no_regular, Nil(), Nil(), no_evidence, no_captures) = RoutineDone()
      let transition_execution: RoutineExecution(predicate_regular, no_evidence, record_capture_char(no_captures, char), final_evidence, final_captures) = RoutineStep(EmitChar(char), RoutineDone())
      let transition_extended: ExtendedEvidenceRoutineExecution(regular_routine(predicate_regular), no_evidence, record_capture_char(no_captures, char), final_evidence, final_captures) = ExtendedEvidenceRegular(EmitChar(char), ExtendedEvidenceDone())
      let path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), no_evidence, no_captures, final_evidence, path_routine) = AcceptingNextAccepted(predicate_regular, Nil(), final_evidence, final_captures, no_extended, transition_edge, transition_execution, AcceptingNow())
      let path_certificate: CertifiedPathRoutine(path_routine, no_evidence, no_captures, final_evidence) = PathRoutineTransition(char, predicate_regular, no_extended, final_evidence, final_captures, transition_extended, PathRoutineDone())
      let complete_routine = append_extended_routines(regular_routine(no_regular), path_routine)
      let routine_certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(no_regular, path_routine, no_evidence, no_captures, ExtendedEvidenceDone(), path_certificate)
      PredicateAccepted(final_evidence, complete_routine, MachineAccepted(predicate_machine_start(), no_evidence, no_captures, path_routine, initial_edge, initial_execution, routine_certificate, path))

  fn predicate_pattern_denotation_is_complete(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PatternAcceptance(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input) =
    match predicate_denotation_is_complete(test, char, after_input, position, denotation)
      PredicateAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  fn empty_denotation_is_complete(
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(UnitC, PatternEmpty(), position, Nil(), after_input)
  ) -> EmptyAcceptance(after_input, position) = match denotation
    DenotesEmpty() ->
      let no_captures: List(CaptureFrame) = Nil()
      let no_extended: List(ExtendedInstruction) = Nil()
      let final_evidence: List(Evidence) = Cons(UnitEvidence(), Nil())
      let regular: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
      let destination = boundary_accepting_destination()
      let edge: ListMember(MachineState(Z()), destination, initial_machine_destinations(Z(), empty_pattern_machine(), position, Nil(), after_input)) = member_here(destination, Nil())
      let execution: RoutineExecution(regular, Nil(), Nil(), final_evidence, no_captures) = RoutineStep(EmitUnit(), RoutineDone())
      let extended_execution: ExtendedEvidenceRoutineExecution(regular_routine(regular), Nil(), Nil(), final_evidence, no_captures) = ExtendedEvidenceRegular(EmitUnit(), ExtendedEvidenceDone())
      let complete_routine = regular_routine(regular)
      let certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(regular, no_extended, final_evidence, no_captures, extended_execution, PathRoutineDone())
      EmptyAccepted(final_evidence, complete_routine, MachineAccepted(destination, final_evidence, no_captures, no_extended, edge, execution, certificate, AcceptingNow()))

  fn empty_pattern_denotation_is_complete(
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(UnitC, PatternEmpty(), position, Nil(), after_input)
  ) -> PatternAcceptance(UnitC, PatternEmpty(), position, Nil(), after_input) =
    match empty_denotation_is_complete(after_input, position, denotation)
      EmptyAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

  fn boundary_denotation_is_complete(
    constraint: BoundaryConstraint,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(UnitC, PatternBoundary(constraint), position, Nil(), after_input)
  ) -> BoundaryAcceptance(constraint, after_input, position) = match denotation
    DenotesBoundary(holds) ->
      let no_captures: List(CaptureFrame) = Nil()
      let no_extended: List(ExtendedInstruction) = Nil()
      let final_evidence: List(Evidence) = Cons(UnitEvidence(), Nil())
      let regular: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
      let destination = boundary_accepting_destination()
      let edge = boundary_result_member(constraint, after_input, position, holds)
      let execution: RoutineExecution(regular, Nil(), Nil(), final_evidence, no_captures) = RoutineStep(EmitUnit(), RoutineDone())
      let extended_execution: ExtendedEvidenceRoutineExecution(regular_routine(regular), Nil(), Nil(), final_evidence, no_captures) = ExtendedEvidenceRegular(EmitUnit(), ExtendedEvidenceDone())
      let complete_routine = regular_routine(regular)
      let certificate: CertifiedPathRoutine(complete_routine, Nil(), Nil(), final_evidence) = PathRoutineInitial(regular, no_extended, final_evidence, no_captures, extended_execution, PathRoutineDone())
      BoundaryAccepted(final_evidence, complete_routine, MachineAccepted(destination, final_evidence, no_captures, no_extended, edge, execution, certificate, AcceptingNow()))

  fn boundary_pattern_denotation_is_complete(
    constraint: BoundaryConstraint,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(UnitC, PatternBoundary(constraint), position, Nil(), after_input)
  ) -> PatternAcceptance(UnitC, PatternBoundary(constraint), position, Nil(), after_input) =
    match boundary_denotation_is_complete(constraint, after_input, position, denotation)
      BoundaryAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)
