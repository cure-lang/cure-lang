@group(:text)
mod Std.Regex.Proof
  use Std.Regex

  ## Structural execution law for the evidence VM. Thompson constructors append
  ## their own evidence instructions to child routines; this view recovers the
  ## exact intermediate evidence/capture state and both checked executions.
  type AppendedRoutineExecution indices (left: List(EvidenceInstruction), right: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    AppendedRoutineExecuted : (middle_evidence: List(Evidence)) -> (middle_captures: List(CaptureFrame)) -> (left_execution: RoutineExecution(left, input_evidence, input_captures, middle_evidence, middle_captures)) -> (right_execution: RoutineExecution(right, middle_evidence, middle_captures, output_evidence, output_captures)) -> AppendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures)

  fn split_appended_routine_execution(left: List(EvidenceInstruction), right: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: RoutineExecution(append_routine(left, right), input_evidence, input_captures, output_evidence, output_captures)) -> AppendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> AppendedRoutineExecuted(input_evidence, input_captures, RoutineDone(), execution)
    Cons(instruction, rest) -> match execution
      RoutineStep(_, suffix) -> match split_appended_routine_execution(rest, right, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), suffix)
        AppendedRoutineExecuted(middle_evidence, middle_captures, left_execution, right_execution) -> AppendedRoutineExecuted(middle_evidence, middle_captures, RoutineStep(instruction, left_execution), right_execution)

  fn append_routine_execution(left: List(EvidenceInstruction), right: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), middle_evidence: List(Evidence), middle_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), left_execution: RoutineExecution(left, input_evidence, input_captures, middle_evidence, middle_captures), right_execution: RoutineExecution(right, middle_evidence, middle_captures, output_evidence, output_captures)) -> RoutineExecution(append_routine(left, right), input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> match left_execution
      RoutineDone() -> right_execution
    Cons(instruction, rest) -> match left_execution
      RoutineStep(_, suffix) -> RoutineStep(instruction, append_routine_execution(rest, right, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), middle_evidence, middle_captures, output_evidence, output_captures, suffix, right_execution))

  fn strip_begin_capture_execution(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(Cons(BeginCapture(), routine), input_evidence, input_captures, output_evidence, output_captures)) -> RoutineExecution(routine, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), output_evidence, output_captures) = match execution
    RoutineStep(_, suffix) -> suffix

  @reducible
  fn captured_string(chars: List(Char)) -> String = Std.String.from_characters(evidence_reverse_chars(chars))

  type EndCaptureExecutionView indices (routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    EndCaptureWithoutFrame : (middle_evidence: List(Evidence)) -> (inner: RoutineExecution(routine, input_evidence, input_captures, middle_evidence, Nil())) -> (view_output_evidence: List(Evidence)) -> (evidence_exact: Equivalent(List(Evidence), view_output_evidence, middle_evidence)) -> (view_output_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), view_output_captures, Nil())) -> EndCaptureExecutionView(routine, input_evidence, input_captures, view_output_evidence, view_output_captures)
    EndCaptureWithFrame : (middle_evidence: List(Evidence)) -> (chars: List(Char)) -> (saved: List(Evidence)) -> (outer: List(CaptureFrame)) -> (inner: RoutineExecution(routine, input_evidence, input_captures, middle_evidence, Cons(CaptureFrame(chars, saved), outer))) -> (view_output_evidence: List(Evidence)) -> (evidence_exact: Equivalent(List(Evidence), view_output_evidence, Cons(StringEvidence(captured_string(chars)), saved))) -> (view_output_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), view_output_captures, outer)) -> EndCaptureExecutionView(routine, input_evidence, input_captures, view_output_evidence, view_output_captures)

  fn split_end_capture_execution(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: RoutineExecution(append_routine(routine, Cons(EndCapture(), Nil())), input_evidence, input_captures, output_evidence, output_captures)) -> EndCaptureExecutionView(routine, input_evidence, input_captures, output_evidence, output_captures) = match split_appended_routine_execution(routine, Cons(EndCapture(), Nil()), input_evidence, input_captures, execution)
    AppendedRoutineExecuted(middle_evidence, middle_captures, inner, ending) -> match middle_captures
      Nil() -> match ending
        RoutineStep(_, suffix) -> match suffix
          RoutineDone() ->
            let no_captures: List(CaptureFrame) = Nil()
            EndCaptureWithoutFrame(middle_evidence, inner, middle_evidence, reflexive(middle_evidence), no_captures, reflexive(no_captures))
      Cons(CaptureFrame(chars, saved), outer) -> match ending
        RoutineStep(_, suffix) -> match suffix
          RoutineDone() -> EndCaptureWithFrame(middle_evidence, chars, saved, outer, inner, Cons(StringEvidence(captured_string(chars)), saved), reflexive(Cons(StringEvidence(captured_string(chars)), saved)), outer, reflexive(outer))

  @reducible
  fn end_capture_view_captures(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), view: EndCaptureExecutionView(routine, input_evidence, input_captures, output_evidence, output_captures)) -> List(CaptureFrame) = match view
    EndCaptureWithoutFrame(_, _, _, _, _, _) -> Nil()
    EndCaptureWithFrame(_, _, _, outer, _, _, _, _, _) -> outer

  fn end_capture_view_captures_exact(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), view: EndCaptureExecutionView(routine, input_evidence, input_captures, output_evidence, output_captures)) -> Equivalent(List(CaptureFrame), output_captures, end_capture_view_captures(routine, input_evidence, input_captures, output_evidence, output_captures, view)) = match view
    EndCaptureWithoutFrame(_, _, _, _, _, captures_exact) -> captures_exact
    EndCaptureWithFrame(_, _, _, _, _, _, _, _, captures_exact) -> captures_exact

  @reducible
  fn end_capture_view_evidence(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), view: EndCaptureExecutionView(routine, input_evidence, input_captures, output_evidence, output_captures)) -> List(Evidence) = match view
    EndCaptureWithoutFrame(middle_evidence, _, _, _, _, _) -> middle_evidence
    EndCaptureWithFrame(_, chars, saved, _, _, _, _, _, _) -> Cons(StringEvidence(captured_string(chars)), saved)

  fn end_capture_view_evidence_exact(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), view: EndCaptureExecutionView(routine, input_evidence, input_captures, output_evidence, output_captures)) -> Equivalent(List(Evidence), output_evidence, end_capture_view_evidence(routine, input_evidence, input_captures, output_evidence, output_captures, view)) = match view
    EndCaptureWithoutFrame(_, _, _, evidence_exact, _, _) -> evidence_exact
    EndCaptureWithFrame(_, _, _, _, _, _, evidence_exact, _, _) -> evidence_exact

  typealias ExecutionOutputsEqual(first_evidence: List(Evidence), first_captures: List(CaptureFrame), second_evidence: List(Evidence), second_captures: List(CaptureFrame)) = Sigma(evidence_equal: Equivalent(List(Evidence), first_evidence, second_evidence), Equivalent(List(CaptureFrame), first_captures, second_captures))

  fn routine_execution_unique(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {first_evidence: List(Evidence)}, {first_captures: List(CaptureFrame)}, {second_evidence: List(Evidence)}, {second_captures: List(CaptureFrame)}, first: RoutineExecution(routine, input_evidence, input_captures, first_evidence, first_captures), second: RoutineExecution(routine, input_evidence, input_captures, second_evidence, second_captures)) -> ExecutionOutputsEqual(first_evidence, first_captures, second_evidence, second_captures) = match routine
    Nil() -> match first
      RoutineDone() -> match second
        RoutineDone() -> %[reflexive(input_evidence), reflexive(input_captures)]
    Cons(instruction, rest) -> match first
      RoutineStep(_, first_suffix) -> match second
        RoutineStep(_, second_suffix) -> routine_execution_unique(rest, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), first_suffix, second_suffix)

  fn extended_routine_execution_unique({routine: List(ExtendedInstruction)}, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {first_evidence: List(Evidence)}, {first_captures: List(CaptureFrame)}, {second_evidence: List(Evidence)}, {second_captures: List(CaptureFrame)}, first: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, first_evidence, first_captures), second: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, second_evidence, second_captures)) -> ExecutionOutputsEqual(first_evidence, first_captures, second_evidence, second_captures) = match first
    ExtendedEvidenceDone() -> match second
      ExtendedEvidenceDone() -> %[reflexive(input_evidence), reflexive(input_captures)]
    ExtendedEvidenceObserve(char, first_suffix) -> match second
      ExtendedEvidenceObserve(_, second_suffix) -> extended_routine_execution_unique(input_evidence, record_capture_char(input_captures, char), first_suffix, second_suffix)
    ExtendedEvidenceRegular(regular, first_suffix) -> match second
      ExtendedEvidenceRegular(_, second_suffix) -> extended_routine_execution_unique(executed_evidence(execute_instruction(regular, input_evidence, input_captures)), executed_captures(execute_instruction(regular, input_evidence, input_captures)), first_suffix, second_suffix)

  fn extend_routine_execution(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> ExtendedEvidenceRoutineExecution(regular_routine(routine), input_evidence, input_captures, output_evidence, output_captures) = match routine
    Nil() -> match execution
      RoutineDone() -> ExtendedEvidenceDone()
    Cons(instruction, rest) -> match execution
      RoutineStep(_, suffix) -> ExtendedEvidenceRegular(instruction, extend_routine_execution(rest, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), output_evidence, output_captures, suffix))

  fn append_extended_routine_execution(left: List(ExtendedInstruction), right: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), middle_evidence: List(Evidence), middle_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), left_execution: ExtendedEvidenceRoutineExecution(left, input_evidence, input_captures, middle_evidence, middle_captures), right_execution: ExtendedEvidenceRoutineExecution(right, middle_evidence, middle_captures, output_evidence, output_captures)) -> ExtendedEvidenceRoutineExecution(append_extended_routines(left, right), input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> match left_execution
      ExtendedEvidenceDone() -> right_execution
    Cons(instruction, rest) -> match instruction
      Observe(char) -> match left_execution
        ExtendedEvidenceObserve(_, suffix) -> ExtendedEvidenceObserve(char, append_extended_routine_execution(rest, right, input_evidence, record_capture_char(input_captures, char), middle_evidence, middle_captures, output_evidence, output_captures, suffix, right_execution))
      Regular(regular) -> match left_execution
        ExtendedEvidenceRegular(_, suffix) -> ExtendedEvidenceRegular(regular, append_extended_routine_execution(rest, right, executed_evidence(execute_instruction(regular, input_evidence, input_captures)), executed_captures(execute_instruction(regular, input_evidence, input_captures)), middle_evidence, middle_captures, output_evidence, output_captures, suffix, right_execution))

  ## Proof-oriented append whose output indices remain erased. This avoids
  ## reifying evidence and capture indices merely to compose certificates.
  fn append_extended_routine_execution_inferred(left: List(ExtendedInstruction), right: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), middle_evidence: List(Evidence), middle_captures: List(CaptureFrame), {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, left_execution: ExtendedEvidenceRoutineExecution(left, input_evidence, input_captures, middle_evidence, middle_captures), right_execution: ExtendedEvidenceRoutineExecution(right, middle_evidence, middle_captures, output_evidence, output_captures)) -> ExtendedEvidenceRoutineExecution(append_extended_routines(left, right), input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> match left_execution
      ExtendedEvidenceDone() -> right_execution
    Cons(instruction, rest) -> match instruction
      Observe(char) -> match left_execution
        ExtendedEvidenceObserve(_, suffix) -> ExtendedEvidenceObserve(char, append_extended_routine_execution_inferred(rest, right, input_evidence, record_capture_char(input_captures, char), middle_evidence, middle_captures, suffix, right_execution))
      Regular(regular) -> match left_execution
        ExtendedEvidenceRegular(_, suffix) -> ExtendedEvidenceRegular(regular, append_extended_routine_execution_inferred(rest, right, executed_evidence(execute_instruction(regular, input_evidence, input_captures)), executed_captures(execute_instruction(regular, input_evidence, input_captures)), middle_evidence, middle_captures, suffix, right_execution))

  fn empty_extended_execution(evidence: List(Evidence), captures: List(CaptureFrame)) -> ExtendedEvidenceRoutineExecution(Nil(), evidence, captures, evidence, captures) = ExtendedEvidenceDone()

  ## Inverse of append_extended_routine_execution. Composite Thompson proofs use
  ## this view to recover the exact evidence/capture boundary between child
  ## routines without recomputing or guessing either indexed state.
  type AppendedExtendedRoutineExecution indices (left: List(ExtendedInstruction), right: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    AppendedExtendedRoutineExecuted : (middle_evidence: List(Evidence)) -> (middle_captures: List(CaptureFrame)) -> (left_execution: ExtendedEvidenceRoutineExecution(left, input_evidence, input_captures, middle_evidence, middle_captures)) -> (right_execution: ExtendedEvidenceRoutineExecution(right, middle_evidence, middle_captures, output_evidence, output_captures)) -> AppendedExtendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures)

  fn split_appended_extended_routine_execution(left: List(ExtendedInstruction), right: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: ExtendedEvidenceRoutineExecution(append_extended_routines(left, right), input_evidence, input_captures, output_evidence, output_captures)) -> AppendedExtendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> AppendedExtendedRoutineExecuted(input_evidence, input_captures, ExtendedEvidenceDone(), execution)
    Cons(instruction, rest) -> match instruction
      Observe(char) -> match execution
        ExtendedEvidenceObserve(_, suffix) -> match split_appended_extended_routine_execution(rest, right, input_evidence, record_capture_char(input_captures, char), suffix)
          AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, left_execution, right_execution) -> AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, ExtendedEvidenceObserve(char, left_execution), right_execution)
      Regular(regular) -> match execution
        ExtendedEvidenceRegular(_, suffix) -> match split_appended_extended_routine_execution(rest, right, executed_evidence(execute_instruction(regular, input_evidence, input_captures)), executed_captures(execute_instruction(regular, input_evidence, input_captures)), suffix)
          AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, left_execution, right_execution) -> AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, ExtendedEvidenceRegular(regular, left_execution), right_execution)

  fn left_marker_execution_encodes({left: ShapeCode}, {right: ShapeCode}, {branch_evidence: List(Evidence)}, {rest: List(Evidence)}, {captures: List(CaptureFrame)}, @erased branch: Encodes(left, branch_evidence, rest), execution: RoutineExecution(Cons(EmitLeft(), Nil()), branch_evidence, captures, Cons(LeftEvidence(), branch_evidence), captures)) -> Encodes(ChoiceC(left, right), Cons(LeftEvidence(), branch_evidence), rest) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> EncodesLeft(branch)

  fn left_marker_execution_captures(input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(Cons(EmitLeft(), Nil()), input_evidence, input_captures, output_evidence, output_captures)) -> Equivalent(List(CaptureFrame), output_captures, input_captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> reflexive(input_captures)

  fn right_marker_execution_encodes({left: ShapeCode}, {right: ShapeCode}, {branch_evidence: List(Evidence)}, {rest: List(Evidence)}, {captures: List(CaptureFrame)}, @erased branch: Encodes(right, branch_evidence, rest), execution: RoutineExecution(Cons(EmitRight(), Nil()), branch_evidence, captures, Cons(RightEvidence(), branch_evidence), captures)) -> Encodes(ChoiceC(left, right), Cons(RightEvidence(), branch_evidence), rest) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> EncodesRight(branch)

  fn right_marker_execution_captures(input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(Cons(EmitRight(), Nil()), input_evidence, input_captures, output_evidence, output_captures)) -> Equivalent(List(CaptureFrame), output_captures, input_captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> reflexive(input_captures)

  fn pair_marker_execution_captures(input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(Cons(EmitPair(), Nil()), input_evidence, input_captures, output_evidence, output_captures)) -> Equivalent(List(CaptureFrame), output_captures, input_captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> reflexive(input_captures)

  fn end_list_execution_captures(input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(Cons(EndList(), Nil()), input_evidence, input_captures, output_evidence, output_captures)) -> Equivalent(List(CaptureFrame), output_captures, input_captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> reflexive(input_captures)

  fn end_list_execution_evidence(input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(Cons(EndList(), Nil()), input_evidence, input_captures, output_evidence, output_captures)) -> Equivalent(List(Evidence), output_evidence, Cons(EndListEvidence(), input_evidence)) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> reflexive(Cons(EndListEvidence(), input_evidence))

  ## The proof-relevant core of MachineAcceptance. The replay certificate is an
  ## execution artifact; Thompson induction needs only the checked initial edge,
  ## its routine execution, and the accepting path that follows it.
  typealias AcceptancePathFrom(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence)) = Sigma(destination: MachineState(n), Sigma(initial_evidence: List(Evidence), Sigma(initial_captures: List(CaptureFrame), Sigma(path_routine: List(ExtendedInstruction), Sigma(edge: ListMember(MachineState(n), destination, initial_machine_destinations(n, machine, position, input, after_input)), Sigma(execution: RoutineExecution(machine_state_routine(n, destination), input_evidence, input_captures, initial_evidence, initial_captures), AcceptingFrom(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine)))))))

  typealias AcceptancePath(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = AcceptancePathFrom(n, machine, position, input, after_input, Nil(), Nil(), final_evidence)

  @reducible
  fn acceptance_extended_routine(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> List(ExtendedInstruction) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> append_extended_routines(regular_routine(machine_state_routine(n, destination)), path_routine)

  @reducible
  fn accepting_final_captures(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, state, current_evidence, captures, final_evidence, routine)) -> List(CaptureFrame) = match input
    Nil() -> match path
      AcceptingNow() -> captures
    Cons(char, rest) -> match path
      AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> accepting_final_captures(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> accepting_final_captures(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)

  type PathExecution indices (routine: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence))
    PathExecuted : (final_captures: List(CaptureFrame)) -> (execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, final_evidence, final_captures)) -> PathExecution(routine, input_evidence, input_captures, final_evidence)

  type AcceptanceExecution indices (routine: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence))
    AcceptanceExecuted : (final_captures: List(CaptureFrame)) -> (execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, final_evidence, final_captures)) -> AcceptanceExecution(routine, input_evidence, input_captures, final_evidence)

  fn accepting_path_execution(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, state, current_evidence, captures, final_evidence, routine)) -> PathExecution(routine, current_evidence, captures, final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> PathExecuted(captures, ExtendedEvidenceDone())
    Cons(char, rest) -> match path
      AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match accepting_path_execution(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
        PathExecuted(final_captures, suffix_execution) -> PathExecuted(final_captures, ExtendedEvidenceObserve(char, append_extended_routine_execution(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, final_evidence, final_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), suffix_execution)))
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match accepting_path_execution(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
        PathExecuted(final_captures, suffix_execution) -> PathExecuted(final_captures, ExtendedEvidenceObserve(char, append_extended_routine_execution(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, final_evidence, final_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), suffix_execution)))

  fn accepting_path_execution_exact(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, state, current_evidence, captures, final_evidence, routine)) -> ExtendedEvidenceRoutineExecution(routine, current_evidence, captures, final_evidence, accepting_final_captures(n, machine, input, after_input, state, current_evidence, captures, final_evidence, routine, path)) = match input
    Nil() -> match path
      AcceptingNow() -> ExtendedEvidenceDone()
    Cons(char, rest) -> match path
      AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> ExtendedEvidenceObserve(char, append_extended_routine_execution_inferred(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), accepting_path_execution_exact(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)))
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> ExtendedEvidenceObserve(char, append_extended_routine_execution_inferred(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), accepting_path_execution_exact(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)))

  fn accepting_next_active_final_captures(
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    current_evidence: List(Evidence),
