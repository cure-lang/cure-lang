                let combined_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
                let combined_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, combined_transition_execution, combined_suffix_execution)
