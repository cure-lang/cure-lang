  fn acceptance_execution_witness(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> SomeAcceptanceExecutionWitness(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance, True()) = match acceptance_path_execution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)
    AcceptanceExecuted(final_captures, execution) -> SomeWitnessedAcceptanceExecution(final_captures, WitnessedAcceptanceExecution(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), execution, reflexive(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance))))

  @reducible
  fn acceptance_path_final_captures(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> List(CaptureFrame) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> accepting_final_captures(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine, path)

  fn acceptance_path_execution_exact(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> ExtendedEvidenceRoutineExecution(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), input_evidence, input_captures, final_evidence, acceptance_path_final_captures(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) ->
      let initial_routine = machine_state_routine(n, destination)
      append_extended_routine_execution(regular_routine(initial_routine), path_routine, input_evidence, input_captures, initial_evidence, initial_captures, final_evidence, accepting_final_captures(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine, path), extend_routine_execution(initial_routine, input_evidence, input_captures, initial_evidence, initial_captures, initial_execution), accepting_path_execution_exact(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine, path))

  fn machine_acceptance_path(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, acceptance: MachineAcceptance(n, machine, position, input, after_input, final_evidence, routine)) -> AcceptancePath(n, machine, position, input, after_input, final_evidence) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, execution, _, path) -> %[destination, initial_evidence, initial_captures, path_routine, edge, execution, path]

  ## The atomic case of the thesis's generalized Thompson theorem. It is
  ## independent of the NFA and of any evidence/captures already in the VM.
  fn predicate_transition_routine_encodes(char: Char, {input_evidence: List(Evidence)}, {input_captures: List(CaptureFrame)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: ExtendedEvidenceRoutineExecution(transition_routine(char, Cons(EmitChar(char), Nil())), input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(CharC, output_evidence, input_evidence) = match execution
    ExtendedEvidenceObserve(_, after_observe) -> match after_observe
      ExtendedEvidenceRegular(_, after_emit) -> match after_emit
        ExtendedEvidenceDone() -> EncodesCharacter(char)

  ## Grouping discards the inner evidence program and replaces it with the text
  ## observed by the capture frame. This one-transition lemma pins the crucial
  ## compositional boundary: even though EmitChar mutates the temporary evidence,
  ## EndCapture restores the saved suffix before emitting StringEvidence.
  fn group_character_routine_encodes(char: Char, {input_evidence: List(Evidence)}, {input_captures: List(CaptureFrame)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: ExtendedEvidenceRoutineExecution(Cons(Regular(BeginCapture()), transition_routine(char, Cons(EmitChar(char), Cons(EndCapture(), Nil())))), input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(StringC, output_evidence, input_evidence) = match execution
    ExtendedEvidenceRegular(_, after_begin) -> match after_begin
      ExtendedEvidenceObserve(_, after_observe) -> match after_observe
        ExtendedEvidenceRegular(_, after_emit) -> match after_emit
          ExtendedEvidenceRegular(_, after_end) -> match after_end
            ExtendedEvidenceDone() -> EncodesString(Std.String.from_characters(Cons(char, Nil())))

  type PredicateRoutineView indices (char: Char, routine: List(ExtendedInstruction))
    PredicateRoutineExact : PredicateRoutineView(char, transition_routine(char, Cons(EmitChar(char), Nil())))

  type PredicatePathView indices (char: Char, final_evidence: List(Evidence), routine: List(ExtendedInstruction))
    PredicatePathExact : PredicatePathView(char, Cons(CharacterEvidence(char), Nil()), transition_routine(char, Cons(EmitChar(char), Nil())))

  type PredicateEvidenceView indices (char: Char, evidence: List(Evidence), captures: List(CaptureFrame))
    PredicateEvidenceExact : PredicateEvidenceView(char, Cons(CharacterEvidence(char), Nil()), Nil())

  type PredicateDestinationsView indices (test: Char -> Bool, char: Char, boundary: Boundary, destinations: List(MachineState(S(Z()))))
    PredicateRejects : PredicateDestinationsView(test, char, boundary, Nil())
    PredicateAccepts : PredicateDestinationsView(test, char, boundary, Cons(predicate_accepting_destination(char), Nil()))

  type PredicateStartsView indices (starts: List(MachineState(S(Z()))))
    PredicateStartsExact : PredicateStartsView(Cons(predicate_machine_start(), Nil()))

  @reducible
  fn boundary_accepting_destination() -> MachineState(Z()) =
    let routine: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
    let constraints: List(BoundaryConstraint) = Nil()
    Accepted(routine, constraints)

  type BoundaryStartsView indices (holds: Bool, starts: List(MachineState(Z())))
    BoundaryStartsUnavailable : BoundaryStartsView(false, Nil())
    BoundaryStartsExact : BoundaryStartsView(true, Cons(boundary_accepting_destination(), Nil()))

  @reducible
  fn predicate_concat_machine(left: Char -> Bool, right: Char -> Bool) -> PatternMachine(plus(S(Z()), S(Z()))) =
    let right_starts: List(MachineState(S(Z()))) = Cons(predicate_machine_start(), Nil())
    let starts: List(MachineState(plus(S(Z()), S(Z())))) = continue_with_right(S(Z()), Cons(predicate_machine_start(), Nil()), right_starts)
    MkPatternMachine(starts, concat_machine_next(S(Z()), predicate_machine_next(left), right_starts, predicate_machine_next(right)))

  @reducible
  fn predicate_concat_start() -> MachineState(plus(S(Z()), S(Z()))) =
    Active(First(), Nil(), Nil())

  @reducible
  fn predicate_concat_middle(char: Char) -> MachineState(plus(S(Z()), S(Z()))) =
    Active(1, Cons(EmitChar(char), Nil()), Nil())

  @reducible
  fn predicate_concat_start_thread() -> ThreadState(plus(S(Z()), S(Z()))) =
    machine_state_thread(plus(S(Z()), S(Z())), predicate_concat_start())

  @reducible
  fn predicate_concat_middle_thread() -> ThreadState(plus(S(Z()), S(Z()))) =
    ThreadActive(Next(First()))

  @reducible
  fn predicate_concat_accepting(char: Char) -> MachineState(plus(S(Z()), S(Z()))) =
    Accepted(Cons(EmitChar(char), Cons(EmitPair(), Nil())), Nil())

  type PredicateConcatStartsView indices (starts: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatStartsExact : PredicateConcatStartsView(Cons(predicate_concat_start(), Nil()))

  type PredicateConcatInitialDestinationView indices (destination: MachineState(plus(S(Z()), S(Z()))))
    PredicateConcatInitialDestinationExact : PredicateConcatInitialDestinationView(predicate_concat_start())

  type PredicateConcatFirstView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatFirstRejects : PredicateConcatFirstView(false, char, Nil())
    PredicateConcatFirstAccepts : PredicateConcatFirstView(true, char, Cons(predicate_concat_middle(char), Nil()))

  type PredicateConcatSecondView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatSecondRejects : PredicateConcatSecondView(false, char, Nil())
    PredicateConcatSecondAccepts : PredicateConcatSecondView(true, char, Cons(predicate_concat_accepting(char), Nil()))

  type PredicateConcatAcceptedEdgeView indices (char: Char, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint))
    PredicateConcatAcceptedEdgeExact : PredicateConcatAcceptedEdgeView(char, Cons(EmitChar(char), Cons(EmitPair(), Nil())), Nil())

  type PredicateConcatActiveEdgeView indices (char: Char, destination: Bounded(plus(S(Z()), S(Z()))), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint))
    PredicateConcatActiveEdgeExact : PredicateConcatActiveEdgeView(char, 1, Cons(EmitChar(char), Nil()), Nil())

  fn impossible_list_member({item_type: Type}, {item: item_type}, {result: Type}, membership: ListMember(item_type, item, Nil())) -> result = match membership

  type AcceptedPathView(n: Nat, machine: PatternMachine(n), after_input: List(Char)) indices (input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction))
    AcceptedPathNow : AcceptedPathView(n, machine, after_input, Nil(), evidence, captures, evidence, Nil())

  fn accepted_path_view(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), @erased current_evidence: List(Evidence), @erased captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> AcceptedPathView(n, machine, after_input, input, current_evidence, captures, final_evidence, routine) = match path
    AcceptingNow() -> AcceptedPathNow()
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  fn accepted_path_final_captures(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> Equivalent(List(CaptureFrame), accepting_final_captures(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine, path), captures) = match path
    AcceptingNow() -> reflexive(captures)
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  fn accepted_path_transport_captures(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine), left: List(CaptureFrame), equality: Equivalent(List(CaptureFrame), left, accepting_final_captures(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine, path))) -> Equivalent(List(CaptureFrame), left, captures) = match path
    AcceptingNow() -> equality
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  fn accepted_path_final_evidence(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> Equivalent(List(Evidence), final_evidence, current_evidence) = match path
    AcceptingNow() -> reflexive(current_evidence)
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  @reducible
  fn proof_empty_characters() -> List(Char) = Nil()

  fn accepted_path_input_empty(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> Equivalent(List(Char), input, proof_empty_characters()) = match path
    AcceptingNow() -> reflexive(proof_empty_characters())
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  type AcceptedPathFacts(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) indices ()
    AcceptedPathFactsExact : (input_empty: Equivalent(List(Char), input, proof_empty_characters())) -> (evidence_exact: Equivalent(List(Evidence), final_evidence, current_evidence)) -> (captures_exact: Equivalent(List(CaptureFrame), accepting_final_captures(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine, path), captures)) -> AcceptedPathFacts(n, machine, input, after_input, current_evidence, captures, final_evidence, routine, path)

  fn accepted_path_facts(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> AcceptedPathFacts(n, machine, input, after_input, current_evidence, captures, final_evidence, routine, path) =
    AcceptedPathFactsExact(accepted_path_input_empty(n, machine, input, after_input, current_evidence, captures, final_evidence, routine, path), accepted_path_final_evidence(n, machine, input, after_input, current_evidence, captures, final_evidence, routine, path), accepted_path_final_captures(n, machine, input, after_input, current_evidence, captures, final_evidence, routine, path))

  @reducible
  fn empty_evidence() -> List(Evidence) = Nil()

  @reducible
  fn empty_captures() -> List(CaptureFrame) = Nil()

  @reducible
  fn empty_characters() -> List(Char) = Nil()

  fn empty_constraints() -> List(BoundaryConstraint) = Nil()

  fn encodes_character_empty(char: Char) -> Encodes(CharC, Cons(CharacterEvidence(char), empty_evidence()), empty_evidence()) = EncodesCharacter(char)

  fn encodes_character_on(char: Char, @erased rest: List(Evidence)) -> Encodes(CharC, Cons(CharacterEvidence(char), rest), rest) = EncodesCharacter(char)

  fn encodes_character_pair(left_char: Char, right_char: Char) -> Encodes(PairC(CharC, CharC), Cons(PairEvidence(), Cons(CharacterEvidence(right_char), Cons(CharacterEvidence(left_char), empty_evidence()))), empty_evidence()) =
    EncodesPair(encodes_character_on(right_char, Cons(CharacterEvidence(left_char), empty_evidence())), encodes_character_empty(left_char))

  fn encodes_many_characters_empty() -> EncodesMany(CharC, Cons(BeginListEvidence(), empty_evidence()), empty_evidence()) = EncodesManyEmpty()

  fn encodes_many_empty(@erased shape: ShapeCode, @erased rest: List(Evidence)) -> EncodesMany(shape, Cons(BeginListEvidence(), rest), rest) = EncodesManyEmpty()

  fn encodes_character_list_empty() -> Encodes(ListC(CharC), Cons(EndListEvidence(), Cons(BeginListEvidence(), empty_evidence())), empty_evidence()) = EncodesList(encodes_many_characters_empty())

  fn predicate_execution_view(char: Char, {evidence: List(Evidence)}, {captures: List(CaptureFrame)}, execution: RoutineExecution(Cons(EmitChar(char), Nil()), Nil(), Nil(), evidence, captures)) -> PredicateEvidenceView(char, evidence, captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> PredicateEvidenceExact()

  fn predicate_starts_view(test: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateStartsView(initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, input, after_input)) = PredicateStartsExact()

  fn predicate_concat_starts_view(left: Char -> Bool, right: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateConcatStartsView(initial_machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), position, input, after_input)) = PredicateConcatStartsExact()

  fn predicate_concat_initial_destination_view(left: Char -> Bool, right: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(S(Z()), S(Z()))), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), position, input, after_input))) -> PredicateConcatInitialDestinationView(destination) = match predicate_concat_starts_view(left, right, position, input, after_input)
    PredicateConcatStartsExact() -> match edge
      ListMemberHere() -> PredicateConcatInitialDestinationExact()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_concat_first_view(left: Char -> Bool, right: Char -> Bool, char: Char, boundary: Boundary) -> PredicateConcatFirstView(left(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), predicate_concat_start_thread(), char, boundary)) = match left(char)
    False() -> PredicateConcatFirstRejects()
    True() -> PredicateConcatFirstAccepts()

  fn predicate_concat_second_view(left: Char -> Bool, right: Char -> Bool, char: Char, boundary: Boundary) -> PredicateConcatSecondView(right(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), predicate_concat_middle_thread(), char, boundary)) = match right(char)
    False() -> PredicateConcatSecondRejects()
    True() -> PredicateConcatSecondAccepts()

  fn boundary_starts_view(constraint: BoundaryConstraint, position: InitialPosition, after_input: List(Char)) -> BoundaryStartsView(constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input)), initial_machine_destinations(Z(), boundary_pattern_machine(constraint), position, empty_characters(), after_input)) = match constraints_hold(Cons(constraint, Nil()), initial_position_boundary(position, after_input))
    False() -> BoundaryStartsUnavailable()
    True() -> BoundaryStartsExact()

  ## The nullable base case of the generalized Thompson theorem.  Unlike the
  ## predicate case, its evidence is emitted by the initial accepting edge and
  ## the accepting path consumes no input.
  fn empty_machine_acceptance_encodes(position: InitialPosition, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, acceptance: MachineAcceptance(Z(), empty_pattern_machine(), position, Nil(), after_input, final_evidence, routine), execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(UnitC, output_evidence, input_evidence) = match acceptance
    MachineAccepted(_, _, _, _, edge, _, _, path) -> match edge
      ListMemberHere() -> match path
        AcceptingNow() -> match execution
          ExtendedEvidenceRegular(_, suffix) -> match suffix
            ExtendedEvidenceDone() -> EncodesUnit()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_machine_acceptance_encodes(constraint: BoundaryConstraint, position: InitialPosition, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, empty_characters(), after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, _, _, _, edge, initial_execution, _, path) -> match boundary_starts_view(constraint, position, after_input)
      BoundaryStartsUnavailable() -> impossible_list_member(edge)
      BoundaryStartsExact() -> match edge
        ListMemberHere() -> match path
          AcceptingNow() -> match initial_execution
            RoutineStep(_, after_emit) -> match after_emit
              RoutineDone() -> EncodesUnit()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn empty_machine_arbitrary_acceptance_encodes(input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), empty_pattern_machine(), position, input, after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> match edge
      ListMemberHere() -> match initial_execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineDone() -> match accepted_path_view(Z(), empty_pattern_machine(), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
            AcceptedPathNow() -> EncodesUnit()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_machine_arbitrary_acceptance_encodes(constraint: BoundaryConstraint, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, input, after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> match boundary_starts_view(constraint, position, append_characters(input, after_input))
      BoundaryStartsUnavailable() -> impossible_list_member(edge)
      BoundaryStartsExact() -> match edge
        ListMemberHere() -> match initial_execution
          RoutineStep(_, after_emit) -> match after_emit
            RoutineDone() -> match accepted_path_view(Z(), boundary_pattern_machine(constraint), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
              AcceptedPathNow() -> EncodesUnit()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_destinations_view(test: Char -> Bool, char: Char, boundary: Boundary) -> PredicateDestinationsView(test, char, boundary, machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, boundary)) = match test(char)
    False() -> PredicateRejects()
    True() -> PredicateAccepts()

  ## Any actual member of the predicate transition relation certifies that its
  ## predicate held.  The dependent edge is transported by `with`; in the false
  ## branch its destination list is definitionally empty.
  type PredicateTransitionTruth indices (test: Char -> Bool, char: Char)
    PredicateTransitionHeld : (proof: Equivalent(Bool, test(char), True())) -> PredicateTransitionTruth(test, char)

  fn predicate_transition_truth(test: Char -> Bool, char: Char, boundary: Boundary, destination: MachineState(S(Z())), edge: ListMember(MachineState(S(Z())), destination, machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, boundary))) -> PredicateTransitionTruth(test, char) = with test(char) proof predicate_holds
    True() -> PredicateTransitionHeld(predicate_holds)
    False() -> impossible_list_member(edge)

  fn predicate_path_routine_encodes(test: Char -> Bool, char: Char, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {path_evidence: List(Evidence)}, {path_captures: List(CaptureFrame)}, {path_final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), path_evidence, path_captures, path_final_evidence, routine), execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(CharC, output_evidence, input_evidence) =
    match predicate_path_routine_view(test, char, after_input, path)
      PredicateRoutineExact() -> predicate_transition_routine_encodes(char, execution)

  fn predicate_exact_path_view(test: Char -> Bool, char: Char, after_input: List(Char), {final_evidence: List(Evidence)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), Nil(), Nil(), final_evidence, transition_routine(char, Cons(EmitChar(char), Nil())))) -> PredicatePathView(char, final_evidence, transition_routine(char, Cons(EmitChar(char), Nil()))) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberHere() -> match predicate_execution_view(char, execution)
          PredicateEvidenceExact() -> match suffix
            AcceptingNow() -> PredicatePathExact()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_path_view(test: Char -> Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), Nil(), Nil(), final_evidence, routine)) -> PredicatePathView(char, final_evidence, routine) = match predicate_path_routine_view(test, char, after_input, path)
    PredicateRoutineExact() -> predicate_exact_path_view(test, char, after_input, path)

  fn predicate_initial_path_view(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, destination: MachineState(S(Z())), {initial_evidence: List(Evidence)}, {initial_captures: List(CaptureFrame)}, @erased final_evidence: List(Evidence), @erased path_routine: List(ExtendedInstruction), edge: ListMember(MachineState(S(Z())), destination, initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, Cons(char, Nil()), after_input)), initial_execution: RoutineExecution(machine_state_routine(S(Z()), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, machine_state_thread(S(Z()), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> PredicatePathView(char, final_evidence, path_routine) = match predicate_starts_view(test, position, [char], after_input)
    PredicateStartsExact() -> match edge
      ListMemberHere() -> match initial_execution
        RoutineDone() -> match path
          AcceptingNextActive(_, _, _, _, _, _, path_edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
            PredicateRejects() -> impossible_list_member(path_edge)
            PredicateAccepts() -> match path_edge
              ListMemberThere(prior) -> impossible_list_member(prior)
          AcceptingNextAccepted(_, _, _, _, _, path_edge, execution, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
            PredicateRejects() -> impossible_list_member(path_edge)
            PredicateAccepts() -> match path_edge
              ListMemberHere() -> match predicate_execution_view(char, execution)
                PredicateEvidenceExact() -> match suffix
                  AcceptingNow() -> PredicatePathExact()
              ListMemberThere(prior) -> impossible_list_member(prior)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_machine_acceptance_encodes(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, empty_characters()), after_input, final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, routine_certificate, path) ->
      match predicate_initial_path_view(test, char, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)
        PredicatePathExact() -> encodes_character_empty(char)

  fn predicate_arbitrary_path_encodes(test: Char -> Bool, input: List(Char), after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), input, after_input, predicate_machine_thread(), empty_evidence(), Nil(), final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, rest, after_input))
        PredicateRejects() -> impossible_list_member(edge)
        PredicateAccepts() -> match edge
          ListMemberThere(prior) -> impossible_list_member(prior)
      AcceptingNextAccepted(_, _, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, rest, after_input))
        PredicateRejects() -> impossible_list_member(edge)
        PredicateAccepts() -> match edge
          ListMemberHere() -> match predicate_execution_view(char, execution)
            PredicateEvidenceExact() -> match accepted_path_view(S(Z()), predicate_pattern_machine(test), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> encodes_character_empty(char)
          ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_machine_arbitrary_acceptance_encodes(test: Char -> Bool, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, input, after_input, final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, _, _, path_routine, edge, initial_execution, _, path) -> match predicate_starts_view(test, position, input, after_input)
      PredicateStartsExact() -> match edge
        ListMemberHere() -> match initial_execution
          RoutineDone() -> predicate_arbitrary_path_encodes(test, input, after_input, final_evidence, path_routine, path)
        ListMemberThere(prior) -> impossible_list_member(prior)

  ## Invert the two list transformations used by Thompson alternation.  The
  ## result retains the exact child edge and records whether the combined state
  ## is an injected active state or an accepting state whose routine has the
  ## branch marker appended.  Recursive path projection uses these relations
  ## instead of guessing from a combined state's runtime representation.
  type AppendMemberOrigin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) indices (value: MachineState(n))
    AppendMemberLeft : (edge: ListMember(MachineState(n), value, left)) -> AppendMemberOrigin(n, left, right, value)
    AppendMemberRight : (edge: ListMember(MachineState(n), value, right)) -> AppendMemberOrigin(n, left, right, value)

  fn append_member_left({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, left)) -> AppendMemberOrigin(n, left, right, value) = AppendMemberLeft(edge)

  fn append_member_right({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, right)) -> AppendMemberOrigin(n, left, right, value) = AppendMemberRight(edge)

  fn append_member_origin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, append_machine_states(n, left, right))) -> AppendMemberOrigin(n, left, right, value) = match left
    Nil() -> append_member_right(left, right, value, edge)
    Cons(head, rest) -> match edge
      ListMemberHere() -> append_member_left(left, right, value, member_here(head, rest))
      ListMemberThere(prior) -> match append_member_origin(n, rest, right, value, prior)
        AppendMemberLeft(origin) -> append_member_left(left, right, value, member_there(head, origin))
        AppendMemberRight(origin) -> append_member_right(left, right, value, origin)

  ## Repetition re-enters only active child starts.  This inversion retains the
  ## exact child start edge and the routine/constraint prefix contributed by the
  ## just-completed iteration.
  type EnterRepeatStateOrigin(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n))) indices (entered: MachineState(n))
    EnterRepeatActiveOrigin : (state: Bounded(n)) -> (start_routine: List(EvidenceInstruction)) -> (start_constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> EnterRepeatStateOrigin(n, routine, constraints, starts, Active(state, append_routine(routine, start_routine), append_constraints(constraints, start_constraints)))

  fn prepend_enter_repeat_origin(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), head: MachineState(n), starts: List(MachineState(n)), entered: MachineState(n), origin: EnterRepeatStateOrigin(n, routine, constraints, starts, entered)) -> EnterRepeatStateOrigin(n, routine, constraints, Cons(head, starts), entered) = match origin
    EnterRepeatActiveOrigin(state, start_routine, start_constraints, edge) -> EnterRepeatActiveOrigin(state, start_routine, start_constraints, ListMemberThere(edge))

  fn enter_repeat_state_origin(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n)), entered: MachineState(n), edge: ListMember(MachineState(n), entered, enter_repeat_with_constraints(routine, constraints, starts))) -> EnterRepeatStateOrigin(n, routine, constraints, starts, entered) = match starts
    Nil() -> impossible_list_member(edge)
    Cons(Accepted(start_routine, start_constraints), rest) -> prepend_enter_repeat_origin(n, routine, constraints, Accepted(start_routine, start_constraints), rest, entered, enter_repeat_state_origin(n, routine, constraints, rest, entered, edge))
    Cons(Active(state, start_routine, start_constraints), rest) -> match edge
      ListMemberHere() -> EnterRepeatActiveOrigin(state, start_routine, start_constraints, ListMemberHere())
      ListMemberThere(prior) -> prepend_enter_repeat_origin(n, routine, constraints, Active(state, start_routine, start_constraints), rest, entered, enter_repeat_state_origin(n, routine, constraints, rest, entered, prior))

  type RepeatDestinationOrderOrigin(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n)), lazy: Bool) indices (destination: MachineState(n))
    RepeatDestinationAcceptingOrigin : RepeatDestinationOrderOrigin(n, routine, constraints, starts, lazy, Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints))
    RepeatDestinationReenteredOrigin : (origin: EnterRepeatStateOrigin(n, routine, constraints, starts, destination)) -> RepeatDestinationOrderOrigin(n, routine, constraints, starts, lazy, destination)

  fn repeat_destination_order_origin(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n)), lazy: Bool, destination: MachineState(n), edge: ListMember(MachineState(n), destination, repeat_destination_order(routine, constraints, starts, lazy))) -> RepeatDestinationOrderOrigin(n, routine, constraints, starts, lazy, destination) = match lazy
    False() -> match append_member_origin(n, enter_repeat_with_constraints(routine, constraints, starts), repeat_accepting(routine, constraints), destination, edge)
      AppendMemberLeft(entered_edge) -> RepeatDestinationReenteredOrigin(enter_repeat_state_origin(n, routine, constraints, starts, destination, entered_edge))
      AppendMemberRight(accepting_edge) -> match accepting_edge
        ListMemberHere() -> RepeatDestinationAcceptingOrigin()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
    True() -> match append_member_origin(n, repeat_accepting(routine, constraints), enter_repeat_with_constraints(routine, constraints, starts), destination, edge)
      AppendMemberLeft(accepting_edge) -> match accepting_edge
        ListMemberHere() -> RepeatDestinationAcceptingOrigin()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
      AppendMemberRight(entered_edge) -> RepeatDestinationReenteredOrigin(enter_repeat_state_origin(n, routine, constraints, starts, destination, entered_edge))

  ## Invert the full `repeat_destinations` map while retaining the exact child
  ## edge. Active child destinations pass through unchanged; accepted child
  ## destinations either close the list or re-enter an active child start.
  type RepeatDestinationsOrigin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool) indices (destination: MachineState(n))
    RepeatChildActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), destinations)) -> RepeatDestinationsOrigin(n, destinations, starts, lazy, Active(state, routine, constraints))
    RepeatChildClosingOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> RepeatDestinationsOrigin(n, destinations, starts, lazy, Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints))
    RepeatChildReenteredOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> (state: Bounded(n)) -> (start_routine: List(EvidenceInstruction)) -> (start_constraints: List(BoundaryConstraint)) -> (start_edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> RepeatDestinationsOrigin(n, destinations, starts, lazy, Active(state, append_routine(routine, start_routine), append_constraints(constraints, start_constraints)))

  fn prepend_repeat_destinations_origin(n: Nat, head: MachineState(n), destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, destination: MachineState(n), origin: RepeatDestinationsOrigin(n, destinations, starts, lazy, destination)) -> RepeatDestinationsOrigin(n, Cons(head, destinations), starts, lazy, destination) = match origin
    RepeatChildActiveOrigin(state, routine, constraints, edge) -> RepeatChildActiveOrigin(state, routine, constraints, ListMemberThere(edge))
    RepeatChildClosingOrigin(routine, constraints, edge) -> RepeatChildClosingOrigin(routine, constraints, ListMemberThere(edge))
    RepeatChildReenteredOrigin(routine, constraints, edge, state, start_routine, start_constraints, start_edge) -> RepeatChildReenteredOrigin(routine, constraints, ListMemberThere(edge), state, start_routine, start_constraints, start_edge)

  fn repeat_destinations_origin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, destination: MachineState(n), edge: ListMember(MachineState(n), destination, repeat_destinations(destinations, starts, lazy))) -> RepeatDestinationsOrigin(n, destinations, starts, lazy, destination) = match destinations
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> RepeatChildActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> prepend_repeat_destinations_origin(n, Active(state, routine, constraints), rest, starts, lazy, destination, repeat_destinations_origin(n, rest, starts, lazy, destination, prior))
    Cons(Accepted(routine, constraints), rest) -> match append_member_origin(n, repeat_destination_order(routine, constraints, starts, lazy), repeat_destinations(rest, starts, lazy), destination, edge)
      AppendMemberLeft(order_edge) -> match repeat_destination_order_origin(n, routine, constraints, starts, lazy, destination, order_edge)
        RepeatDestinationAcceptingOrigin() -> RepeatChildClosingOrigin(routine, constraints, ListMemberHere())
        RepeatDestinationReenteredOrigin(EnterRepeatActiveOrigin(restart_state, start_routine, start_constraints, start_edge)) -> RepeatChildReenteredOrigin(routine, constraints, ListMemberHere(), restart_state, start_routine, start_constraints, start_edge)
      AppendMemberRight(rest_edge) -> prepend_repeat_destinations_origin(n, Accepted(routine, constraints), rest, starts, lazy, destination, repeat_destinations_origin(n, rest, starts, lazy, destination, rest_edge))

  type FilteredRepeatDestinationsOrigin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, boundary: Boundary) indices (filtered: MachineState(n))
    FilteredRepeatChildActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), destinations)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Active(state, routine, Nil()))
    FilteredRepeatAcceptingOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Accepted(append_routine(routine, Cons(EndList(), Nil())), Nil()))
    FilteredRepeatReenteredOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> (state: Bounded(n)) -> (start_routine: List(EvidenceInstruction)) -> (start_constraints: List(BoundaryConstraint)) -> (start_edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> (holds: Equivalent(Bool, constraints_hold(append_constraints(constraints, start_constraints), boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Active(state, append_routine(routine, start_routine), Nil()))

  fn filtered_repeat_active_origin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, state: Bounded(n), combined_routine: List(EvidenceInstruction), combined_constraints: List(BoundaryConstraint), transformed_edge: ListMember(MachineState(n), Active(state, combined_routine, combined_constraints), repeat_destinations(destinations, starts, lazy)), holds: Equivalent(Bool, constraints_hold(combined_constraints, boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Active(state, combined_routine, Nil())) = match repeat_destinations_origin(n, destinations, starts, lazy, Active(state, combined_routine, combined_constraints), transformed_edge)
      RepeatChildActiveOrigin(_, routine, constraints, child_edge) -> FilteredRepeatChildActiveOrigin(state, routine, constraints, child_edge, holds)
      RepeatChildReenteredOrigin(routine, constraints, child_edge, _, start_routine, start_constraints, start_edge) -> FilteredRepeatReenteredOrigin(routine, constraints, child_edge, state, start_routine, start_constraints, start_edge, holds)

  fn filtered_repeat_accepted_origin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, combined_routine: List(EvidenceInstruction), combined_constraints: List(BoundaryConstraint), transformed_edge: ListMember(MachineState(n), Accepted(combined_routine, combined_constraints), repeat_destinations(destinations, starts, lazy)), holds: Equivalent(Bool, constraints_hold(combined_constraints, boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Accepted(combined_routine, Nil())) = match repeat_destinations_origin(n, destinations, starts, lazy, Accepted(combined_routine, combined_constraints), transformed_edge)
      RepeatChildClosingOrigin(routine, constraints, child_edge) -> FilteredRepeatAcceptingOrigin(routine, constraints, child_edge, holds)

  fn filtered_repeat_destinations_origin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, repeat_destinations(destinations, starts, lazy), boundary))) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, filtered) = match filtered_state_origin(n, repeat_destinations(destinations, starts, lazy), boundary, filtered, edge)
    FilteredActiveStateOrigin(state, combined_routine, combined_constraints, transformed_edge, holds) -> filtered_repeat_active_origin(n, destinations, starts, lazy, boundary, state, combined_routine, combined_constraints, transformed_edge, holds)
    FilteredAcceptedStateOrigin(combined_routine, combined_constraints, transformed_edge, holds) -> filtered_repeat_accepted_origin(n, destinations, starts, lazy, boundary, combined_routine, combined_constraints, transformed_edge, holds)

  type RepeatStartsOrigin(n: Nat, starts: List(MachineState(n)), lazy: Bool) indices (destination: MachineState(n))
    RepeatEmptyStartOrigin : RepeatStartsOrigin(n, starts, lazy, Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()))
    RepeatEnteredStartOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> RepeatStartsOrigin(n, starts, lazy, Active(state, Cons(BeginList(), routine), constraints))

  fn repeat_starts_origin(n: Nat, starts: List(MachineState(n)), lazy: Bool, destination: MachineState(n), edge: ListMember(MachineState(n), destination, repeat_machine_starts(starts, lazy))) -> RepeatStartsOrigin(n, starts, lazy, destination) = match lazy
    False() -> match append_member_origin(n, enter_repeat(Cons(BeginList(), Nil()), starts), Cons(Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()), Nil()), destination, edge)
      AppendMemberLeft(entered_edge) -> match enter_repeat_state_origin(n, Cons(BeginList(), Nil()), Nil(), starts, destination, entered_edge)
        EnterRepeatActiveOrigin(state, routine, constraints, start_edge) -> RepeatEnteredStartOrigin(state, routine, constraints, start_edge)
      AppendMemberRight(empty_edge) -> match empty_edge
        ListMemberHere() -> RepeatEmptyStartOrigin()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
    True() -> match append_member_origin(n, Cons(Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()), Nil()), enter_repeat(Cons(BeginList(), Nil()), starts), destination, edge)
      AppendMemberLeft(empty_edge) -> match empty_edge
        ListMemberHere() -> RepeatEmptyStartOrigin()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
      AppendMemberRight(entered_edge) -> match enter_repeat_state_origin(n, Cons(BeginList(), Nil()), Nil(), starts, destination, entered_edge)
        EnterRepeatActiveOrigin(state, routine, constraints, start_edge) -> RepeatEnteredStartOrigin(state, routine, constraints, start_edge)

  type FilteredRepeatStartsOrigin(n: Nat, starts: List(MachineState(n)), lazy: Bool, boundary: Boundary) indices (filtered: MachineState(n))
    FilteredRepeatEmptyStartOrigin : FilteredRepeatStartsOrigin(n, starts, lazy, boundary, Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()))
    FilteredRepeatEnteredStartOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredRepeatStartsOrigin(n, starts, lazy, boundary, Active(state, Cons(BeginList(), routine), Nil()))

  fn filtered_repeat_starts_origin(n: Nat, starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, repeat_machine_starts(starts, lazy), boundary))) -> FilteredRepeatStartsOrigin(n, starts, lazy, boundary, filtered) = match filtered_state_origin(n, repeat_machine_starts(starts, lazy), boundary, filtered, edge)
    FilteredActiveStateOrigin(state, combined_routine, constraints, transformed_edge, holds) -> match repeat_starts_origin(n, starts, lazy, Active(state, combined_routine, constraints), transformed_edge)
      RepeatEnteredStartOrigin(_, routine, child_constraints, child_edge) -> FilteredRepeatEnteredStartOrigin(state, routine, child_constraints, child_edge, holds)
    FilteredAcceptedStateOrigin(combined_routine, constraints, transformed_edge, holds) -> match repeat_starts_origin(n, starts, lazy, Accepted(combined_routine, constraints), transformed_edge)
      RepeatEmptyStartOrigin() -> FilteredRepeatEmptyStartOrigin()

  type FilteredAppendMemberOrigin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) indices (value: MachineState(n))
    FilteredAppendMemberLeft : (edge: ListMember(MachineState(n), value, left)) -> FilteredAppendMemberOrigin(n, left, right, value)
    FilteredAppendMemberRight : (edge: ListMember(MachineState(n), value, right)) -> FilteredAppendMemberOrigin(n, left, right, value)

  fn filtered_append_member_left({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, left)) -> FilteredAppendMemberOrigin(n, left, right, value) = FilteredAppendMemberLeft(edge)

  fn filtered_append_member_right({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, right)) -> FilteredAppendMemberOrigin(n, left, right, value) = FilteredAppendMemberRight(edge)

  fn prepend_filtered_append_member({n: Nat}, head: MachineState(n), left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), origin: FilteredAppendMemberOrigin(n, left, right, value)) -> FilteredAppendMemberOrigin(n, Cons(head, left), right, value) = match origin
    FilteredAppendMemberLeft(edge) -> filtered_append_member_left(Cons(head, left), right, value, member_there(head, edge))
    FilteredAppendMemberRight(edge) -> filtered_append_member_right(Cons(head, left), right, value, edge)

  fn filtered_append_active_true_origin(n: Nat, state: Bounded(n), routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Active(state, routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_accepted_true_origin(n: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Accepted(routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_member_origin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary))) -> FilteredAppendMemberOrigin(n, filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value) = match left
    Nil() -> filtered_append_member_right(filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value, edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_active_true_origin(n, state, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_accepted_true_origin(n, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)

  fn lift_filtered_append_left_member(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, left, boundary))) -> ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary)) = match left
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Active(state, routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary))
        ListMemberThere(prior) -> member_there(Active(state, routine, Nil()), lift_filtered_append_left_member(n, rest, right, boundary, value, prior))
      False() -> lift_filtered_append_left_member(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Accepted(routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary))
        ListMemberThere(prior) -> member_there(Accepted(routine, Nil()), lift_filtered_append_left_member(n, rest, right, boundary, value, prior))
      False() -> lift_filtered_append_left_member(n, rest, right, boundary, value, edge)

  fn lift_filtered_append_right_member(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, right, boundary))) -> ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary)) = match left
    Nil() -> edge
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> member_there(Active(state, routine, Nil()), lift_filtered_append_right_member(n, rest, right, boundary, value, edge))
      False() -> lift_filtered_append_right_member(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> member_there(Accepted(routine, Nil()), lift_filtered_append_right_member(n, rest, right, boundary, value, edge))
      False() -> lift_filtered_append_right_member(n, rest, right, boundary, value, edge)

  type LeftMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count))) indices (combined: MachineState(plus(left_count, right_count)))
    LeftMarkedActiveOrigin : (state: Bounded(left_count)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Active(state, routine, constraints), states)) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_left(left_count, right_count, state), routine, constraints))
    LeftMarkedAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Accepted(routine, constraints), states)) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), constraints))

  type RightMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(right_count))) indices (combined: MachineState(plus(left_count, right_count)))
    RightMarkedActiveOrigin : (state: Bounded(right_count)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(right_count), Active(state, routine, constraints), states)) -> RightMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_right(left_count, right_count, state), routine, constraints))
    RightMarkedAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(right_count), Accepted(routine, constraints), states)) -> RightMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), constraints))

  fn left_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, alternate_left_states(left_count, right_count, states, marker))) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> LeftMarkedActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match left_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))
    Cons(Accepted(routine, constraints), rest) -> match edge
      ListMemberHere() -> LeftMarkedAcceptedOrigin(routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match left_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> LeftMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> LeftMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))

  fn right_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, alternate_right_states(left_count, right_count, states, marker))) -> RightMarkedStateOrigin(left_count, right_count, marker, states, combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> RightMarkedActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match right_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        RightMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> RightMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))
    Cons(Accepted(routine, constraints), rest) -> match edge
      ListMemberHere() -> RightMarkedAcceptedOrigin(routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match right_marked_state_origin(left_count, right_count, rest, marker, combined, prior)
        RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> RightMarkedActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        RightMarkedAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> RightMarkedAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))

  type FilteredLeftMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction) indices (filtered_states: List(MachineState(left_count)), combined: MachineState(plus(left_count, right_count)))
    FilteredLeftActiveOrigin : (state: Bounded(left_count)) -> (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), filtered_states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filtered_states, Active(inject_alternate_left(left_count, right_count, state), routine, Nil()))
    FilteredLeftAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), filtered_states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filtered_states, Accepted(append_branch_marker(routine, marker), Nil()))

  type FilteredRightMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction) indices (filtered_states: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)))
    FilteredRightActiveOrigin : (state: Bounded(right_count)) -> (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(right_count), Active(state, routine, Nil()), filtered_states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, filtered_states, Active(inject_alternate_right(left_count, right_count, state), routine, Nil()))
    FilteredRightAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (edge: ListMember(MachineState(right_count), Accepted(routine, Nil()), filtered_states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, filtered_states, Accepted(append_branch_marker(routine, marker), Nil()))

  fn filtered_left_active_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count)), state: Bounded(left_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_left(left_count, right_count, state), routine, Nil())) =
    FilteredLeftActiveOrigin(state, routine, edge)

  fn filtered_left_accepted_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count)), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), Nil())) =
    FilteredLeftAcceptedOrigin(routine, edge)

  fn filtered_right_active_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(right_count)), state: Bounded(right_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Active(state, routine, Nil()), states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_right(left_count, right_count, state), routine, Nil())) =
    FilteredRightActiveOrigin(state, routine, edge)

  fn filtered_right_accepted_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(right_count)), routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Accepted(routine, Nil()), states)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), Nil())) =
    FilteredRightAcceptedOrigin(routine, edge)

  fn prepend_filtered_left_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, head: MachineState(left_count), tail: List(MachineState(left_count)), combined: MachineState(plus(left_count, right_count)), origin: FilteredLeftMarkedStateOrigin(left_count, right_count, marker, tail, combined)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(head, tail), combined) = match origin
    FilteredLeftActiveOrigin(state, routine, edge) -> filtered_left_active_origin(left_count, right_count, marker, Cons(head, tail), state, routine, member_there(head, edge))
    FilteredLeftAcceptedOrigin(routine, edge) -> filtered_left_accepted_origin(left_count, right_count, marker, Cons(head, tail), routine, member_there(head, edge))

  fn prepend_filtered_right_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, head: MachineState(right_count), tail: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)), origin: FilteredRightMarkedStateOrigin(left_count, right_count, marker, tail, combined)) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, Cons(head, tail), combined) = match origin
    FilteredRightActiveOrigin(state, routine, edge) -> filtered_right_active_origin(left_count, right_count, marker, Cons(head, tail), state, routine, member_there(head, edge))
    FilteredRightAcceptedOrigin(routine, edge) -> filtered_right_accepted_origin(left_count, right_count, marker, Cons(head, tail), routine, member_there(head, edge))

  fn filtered_left_active_true_origin(left_count: Nat, right_count: Nat, state: Bounded(left_count), routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_active_origin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), state, routine, member_here(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_left_accepted_true_origin(left_count: Nat, right_count: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_accepted_origin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), routine, member_here(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_right_active_true_origin(left_count: Nat, right_count: Nat, state: Bounded(right_count), routine: List(EvidenceInstruction), rest: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Active(inject_alternate_right(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary)))) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_right_active_origin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary)), state, routine, member_here(Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_right_origin(left_count, right_count, marker, Active(state, routine, Nil()), filter_machine_states(right_count, rest, boundary), combined, filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_right_accepted_true_origin(left_count: Nat, right_count: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary)))) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_right_accepted_origin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary)), routine, member_here(Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_right_origin(left_count, right_count, marker, Accepted(routine, Nil()), filter_machine_states(right_count, rest, boundary), combined, filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_left_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filter_machine_states(left_count, states, boundary), combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_active_true_origin(left_count, right_count, state, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_accepted_true_origin(left_count, right_count, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)

  fn filtered_right_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary))) -> FilteredRightMarkedStateOrigin(left_count, right_count, marker, filter_machine_states(right_count, states, boundary), combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_right_active_true_origin(left_count, right_count, state, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_right_accepted_true_origin(left_count, right_count, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_right_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)

  ## Constructive inverses of the origin views above. Completeness uses these
  ## to embed a certified child edge into an alternate machine while preserving
  ## filtering, state injection, and the branch evidence marker exactly.
  fn lift_filtered_left_active_member(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(left_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), filter_machine_states(left_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Active(inject_alternate_left(left_count, right_count, head_state), head_routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Active(inject_alternate_left(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)

  fn lift_filtered_left_accepted_member(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), filter_machine_states(left_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Active(inject_alternate_left(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Accepted(append_branch_marker(head_routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)

  fn lift_filtered_right_active_member(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(right_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Active(state, routine, Nil()), filter_machine_states(right_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_right(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Active(inject_alternate_right(left_count, right_count, head_state), head_routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Active(inject_alternate_right(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)

  fn lift_filtered_right_accepted_member(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Accepted(routine, Nil()), filter_machine_states(right_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Active(inject_alternate_right(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Accepted(append_branch_marker(head_routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)

  typealias AlternateLeftActivePathEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence)) = Sigma(combined_routine: List(ExtendedInstruction), AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, Cons(LeftEvidence(), child_final_evidence), combined_routine))

  fn lift_alternate_left_active_edge(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(left_count), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(left_count), Active(state, routine, constraints), filter_machine_states(left_count, states, boundary)), origin: FilteredStateOrigin(left_count, states, boundary, Active(state, routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> lift_filtered_left_active_member(left_count, right_count, states, marker, boundary, state, routine, edge)
    FilteredAcceptedStateOrigin(_, _, _, _) -> impossible

  fn lift_alternate_left_accepted_edge(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(left_count), Accepted(routine, constraints), filter_machine_states(left_count, states, boundary)), origin: FilteredStateOrigin(left_count, states, boundary, Accepted(routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> impossible
    FilteredAcceptedStateOrigin(_, _, _, _) -> lift_filtered_left_accepted_member(left_count, right_count, states, marker, boundary, routine, edge)

  fn lift_alternate_left_active_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), child_routine: List(ExtendedInstruction), path: AcceptingFrom(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> AlternateLeftActivePathEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, child_final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNow() -> impossible
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match lift_alternate_left_active_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, destination, destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix)
            mk_pair(combined_suffix_routine, combined_suffix) ->
              let origin = filtered_state_origin(left_count, left_next(source, char), transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_left_active_edge(left_count, right_count, left_next(source, char), EmitLeft(), transition_boundary_before(char, rest, after_input), destination, regular, constraints, edge, origin)
              let combined_edge = alternate_left_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(inject_alternate_left(left_count, right_count, destination), regular, Nil()), filtered_combined_edge)
              let combined_routine = append_extended_routines(transition_routine(char, regular), combined_suffix_routine)
              %[combined_routine, AcceptingNextActive(inject_alternate_left(left_count, right_count, destination), regular, empty_constraints(), destination_evidence, destination_captures, combined_suffix_routine, combined_edge, execution, combined_suffix)]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match suffix
            AcceptingNow() ->
              let marker_execution: RoutineExecution(Cons(EmitLeft(), Nil()), destination_evidence, destination_captures, Cons(LeftEvidence(), destination_evidence), destination_captures) = RoutineStep(EmitLeft(), RoutineDone())
              let combined_execution = append_routine_execution(regular, Cons(EmitLeft(), Nil()), current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, Cons(LeftEvidence(), destination_evidence), destination_captures, execution, marker_execution)
              let origin = filtered_state_origin(left_count, left_next(source, char), transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_left_accepted_edge(left_count, right_count, left_next(source, char), EmitLeft(), transition_boundary_before(char, rest, after_input), regular, constraints, edge, origin)
              let combined_edge = alternate_left_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(append_branch_marker(regular, EmitLeft()), Nil()), filtered_combined_edge)
              let no_extended: List(ExtendedInstruction) = Nil()
              let combined_routine = append_extended_routines(transition_routine(char, append_branch_marker(regular, EmitLeft())), no_extended)
              %[combined_routine, AcceptingNextAccepted(append_branch_marker(regular, EmitLeft()), empty_constraints(), Cons(LeftEvidence(), destination_evidence), destination_captures, no_extended, combined_edge, combined_execution, AcceptingNow())]
            AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
            AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible

  typealias AlternateRightActivePathEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence)) = Sigma(combined_routine: List(ExtendedInstruction), AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, Cons(RightEvidence(), child_final_evidence), combined_routine))

  fn lift_alternate_right_active_edge(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(right_count), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(right_count), Active(state, routine, constraints), filter_machine_states(right_count, states, boundary)), origin: FilteredStateOrigin(right_count, states, boundary, Active(state, routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_right(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> lift_filtered_right_active_member(left_count, right_count, states, marker, boundary, state, routine, edge)
    FilteredAcceptedStateOrigin(_, _, _, _) -> impossible

  fn lift_alternate_right_accepted_edge(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(right_count), Accepted(routine, constraints), filter_machine_states(right_count, states, boundary)), origin: FilteredStateOrigin(right_count, states, boundary, Accepted(routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> impossible
    FilteredAcceptedStateOrigin(_, _, _, _) -> lift_filtered_right_accepted_member(left_count, right_count, states, marker, boundary, routine, edge)

  fn lift_alternate_right_active_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), child_routine: List(ExtendedInstruction), path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> AlternateRightActivePathEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, child_final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNow() -> impossible
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match lift_alternate_right_active_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, destination, destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix)
            mk_pair(combined_suffix_routine, combined_suffix) ->
              let origin = filtered_state_origin(right_count, right_next(source, char), transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_right_active_edge(left_count, right_count, right_next(source, char), EmitRight(), transition_boundary_before(char, rest, after_input), destination, regular, constraints, edge, origin)
              let combined_edge = alternate_right_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(inject_alternate_right(left_count, right_count, destination), regular, Nil()), filtered_combined_edge)
              let combined_routine = append_extended_routines(transition_routine(char, regular), combined_suffix_routine)
              %[combined_routine, AcceptingNextActive(inject_alternate_right(left_count, right_count, destination), regular, empty_constraints(), destination_evidence, destination_captures, combined_suffix_routine, combined_edge, execution, combined_suffix)]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match suffix
            AcceptingNow() ->
              let marker_execution: RoutineExecution(Cons(EmitRight(), Nil()), destination_evidence, destination_captures, Cons(RightEvidence(), destination_evidence), destination_captures) = RoutineStep(EmitRight(), RoutineDone())
              let combined_execution = append_routine_execution(regular, Cons(EmitRight(), Nil()), current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, Cons(RightEvidence(), destination_evidence), destination_captures, execution, marker_execution)
              let origin = filtered_state_origin(right_count, right_next(source, char), transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_right_accepted_edge(left_count, right_count, right_next(source, char), EmitRight(), transition_boundary_before(char, rest, after_input), regular, constraints, edge, origin)
              let combined_edge = alternate_right_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(append_branch_marker(regular, EmitRight()), Nil()), filtered_combined_edge)
              let no_extended: List(ExtendedInstruction) = Nil()
              let combined_routine = append_extended_routines(transition_routine(char, append_branch_marker(regular, EmitRight())), no_extended)
              %[combined_routine, AcceptingNextAccepted(append_branch_marker(regular, EmitRight()), empty_constraints(), Cons(RightEvidence(), destination_evidence), destination_captures, no_extended, combined_edge, combined_execution, AcceptingNow())]
            AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
            AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible

  ## Once an alternate thread is known to inhabit one injection image, every
  ## outgoing edge comes from that same child machine. The Bounded inverse laws
  ## rewrite the combined source before the transition is classified; no raw-Nat
  ## comparison or unchecked projection is involved.
  fn alternate_left_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(left_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary)) =
    rewrite split_injected_left_at(right_count, source) in reflexive(filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary))

  fn alternate_left_transition_member(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(left_count), char: Char, boundary: Boundary, destination: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), destination, filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary))) -> ListMember(MachineState(plus(left_count, right_count)), destination, machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary)) = match alternate_left_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, boundary)
    reflexive() -> edge

  fn alternate_right_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(right_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_right(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitRight()), boundary)) =
