    rewrite split_injected_right(left_count, source) in rewrite finish_pair_is_mark_branch(right_next(source, char)) in reflexive(filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitPair()), boundary))

  fn concat_right_transition_origin(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), source: Bounded(right_count), char: Char, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, machine_destinations(plus(left_count, right_count), concat_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next)), ThreadActive(inject_alternate_right(left_count, right_count, source)), char, boundary))) -> FilteredRightMarkedStateOrigin(left_count, right_count, EmitPair(), filter_machine_states(right_count, right_next(source, char), boundary), combined) =
    filtered_right_marked_state_origin(left_count, right_count, right_next(source, char), EmitPair(), boundary, combined, transport_alternate_edge(concat_right_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, boundary), edge))

  typealias ConcatRightPathProjection(right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence)) = Sigma(child_final_evidence: List(Evidence), Sigma(child_routine: List(ExtendedInstruction), Sigma(child_path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, captures, child_final_evidence, child_routine), Equivalent(List(Evidence), final_evidence, Cons(PairEvidence(), child_final_evidence)))))

  fn project_concat_right_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, captures, final_evidence, routine)) -> ConcatRightPathProjection(right_count, right_machine, input, after_input, source, current_evidence, captures, final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match concat_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredRightActiveOrigin(child_destination, child_regular, child_edge) -> match project_concat_right_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              mk_pair(child_final_evidence, mk_pair(child_suffix_routine, mk_pair(child_suffix, final_is_paired))) -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), AcceptingNextActive(child_destination, child_regular, Nil(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix), final_is_paired]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match concat_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredRightAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), concat_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next)), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitPair(), Nil()), current_evidence, record_capture_char(captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), Nil()), AcceptingNextAccepted(child_regular, Nil(), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()), reflexive(Cons(PairEvidence(), child_final_evidence))]

  type ConcatRightSharedExecutionProjection(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), final_evidence: List(Evidence), combined_routine: List(ExtendedInstruction), combined_path: AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) indices ()
    ProjectedConcatRightSharedExecution : (child_final_evidence: List(Evidence)) -> (child_routine: List(ExtendedInstruction)) -> (child_path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> (shared_final_captures: List(CaptureFrame)) -> (child_execution: ExtendedEvidenceRoutineExecution(child_routine, current_evidence, current_captures, child_final_evidence, shared_final_captures)) -> (combined_execution: ExtendedEvidenceRoutineExecution(combined_routine, current_evidence, current_captures, final_evidence, shared_final_captures)) -> (final_is_paired: Equivalent(List(Evidence), final_evidence, Cons(PairEvidence(), child_final_evidence))) -> ConcatRightSharedExecutionProjection(left_count, left_machine, right_count, right_machine, input, after_input, source, current_evidence, current_captures, final_evidence, combined_routine, combined_path)

  fn project_concat_right_shared_execution(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {combined_routine: List(ExtendedInstruction)}, combined_path: AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) -> ConcatRightSharedExecutionProjection(left_count, left_machine, right_count, right_machine, input, after_input, source, current_evidence, current_captures, final_evidence, combined_routine, combined_path) = match input
    Nil() -> match combined_path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match combined_path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match concat_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredRightActiveOrigin(child_destination, child_regular, child_edge) -> match project_concat_right_shared_execution(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              ProjectedConcatRightSharedExecution(child_final_evidence, child_suffix_routine, child_suffix, shared_final_captures, child_suffix_execution, combined_suffix_execution, final_is_paired) ->
                let child_path = AcceptingNextActive(child_destination, child_regular, empty_boundary_constraints(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix)
                let child_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
                let child_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), child_suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, child_transition_execution, child_suffix_execution)
                let combined_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
                let combined_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, combined_transition_execution, combined_suffix_execution)
                ProjectedConcatRightSharedExecution(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), child_path, shared_final_captures, child_execution, combined_execution, final_is_paired)
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match concat_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredRightAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), concat_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next)), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitPair(), Nil()), current_evidence, record_capture_char(current_captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution_regular, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() ->
                      let child_path = one_step_accepted_path(right_count, MkPatternMachine(right_starts, right_next), char, after_input, source, current_evidence, current_captures, child_regular, child_final_evidence, child_final_captures, child_edge, child_execution_regular)
                      let child_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), child_final_evidence, child_final_captures, child_execution_regular))
                      let child_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), empty_extended_routine(), current_evidence, current_captures, child_final_evidence, child_final_captures, child_transition_execution, empty_extended_execution(child_final_evidence, child_final_captures))
                      let combined_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(append_branch_marker(child_regular, EmitPair()), current_evidence, record_capture_char(current_captures, char), destination_evidence, child_final_captures, execution))
                      let combined_execution = append_extended_routine_execution_inferred(transition_routine(char, append_branch_marker(child_regular, EmitPair())), empty_extended_routine(), current_evidence, current_captures, destination_evidence, child_final_captures, combined_transition_execution, empty_extended_execution(destination_evidence, child_final_captures))
                      ProjectedConcatRightSharedExecution(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), empty_extended_routine()), child_path, child_final_captures, child_execution, combined_execution, reflexive(Cons(PairEvidence(), child_final_evidence)))

  type ConcatRightCapturedPathProjection(right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence), combined_final_captures: List(CaptureFrame))
    CapturedConcatRightPath : (child_final_evidence: List(Evidence)) -> (child_routine: List(ExtendedInstruction)) -> (child_path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> (final_is_paired: Equivalent(List(Evidence), final_evidence, Cons(PairEvidence(), child_final_evidence))) -> (captures_exact: Equivalent(List(CaptureFrame), accepting_final_captures(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path), combined_final_captures)) -> ConcatRightCapturedPathProjection(right_count, right_machine, input, after_input, source, current_evidence, current_captures, final_evidence, combined_final_captures)

  fn concat_right_active_path_captures(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {combined_routine: List(ExtendedInstruction)}, combined_path: AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) -> ConcatRightCapturedPathProjection(right_count, right_machine, input, after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine, combined_path)) = match project_concat_right_shared_execution(left_count, left_machine, right_count, right_machine, input, after_input, source, current_evidence, current_captures, combined_path)
    ProjectedConcatRightSharedExecution(child_final_evidence, child_routine, child_path, shared_final_captures, child_execution, combined_execution, final_is_paired) -> CapturedConcatRightPath(child_final_evidence, child_routine, child_path, final_is_paired, shared_execution_final_captures(current_evidence, current_captures, accepting_final_captures(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path), accepting_final_captures(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine, combined_path), shared_final_captures, accepting_path_execution_exact(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path), accepting_path_execution_exact(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine, combined_path), child_execution, combined_execution))

  type EnterRightStateOrigin(left_count: Nat, right_count: Nat, left_routine: List(EvidenceInstruction), left_constraints: List(BoundaryConstraint), right_starts: List(MachineState(right_count))) indices (combined: MachineState(plus(left_count, right_count)))
    EnterRightActiveOrigin : (state: Bounded(right_count)) -> (right_routine: List(EvidenceInstruction)) -> (right_constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(right_count), Active(state, right_routine, right_constraints), right_starts)) -> EnterRightStateOrigin(left_count, right_count, left_routine, left_constraints, right_starts, Active(inject_alternate_right(left_count, right_count, state), append_routine(left_routine, right_routine), append_constraints(left_constraints, right_constraints)))
    EnterRightAcceptedOrigin : (right_routine: List(EvidenceInstruction)) -> (right_constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(right_count), Accepted(right_routine, right_constraints), right_starts)) -> EnterRightStateOrigin(left_count, right_count, left_routine, left_constraints, right_starts, Accepted(append_routine(append_routine(left_routine, right_routine), Cons(EmitPair(), Nil())), append_constraints(left_constraints, right_constraints)))

  fn enter_right_state_origin(left_count: Nat, right_count: Nat, left_routine: List(EvidenceInstruction), left_constraints: List(BoundaryConstraint), right_starts: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, enter_right_with_constraints(left_count, left_routine, left_constraints, right_starts))) -> EnterRightStateOrigin(left_count, right_count, left_routine, left_constraints, right_starts, combined) = match right_starts
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, right_routine, right_constraints), rest) -> match edge
      ListMemberHere() -> EnterRightActiveOrigin(state, right_routine, right_constraints, ListMemberHere())
      ListMemberThere(prior) -> match enter_right_state_origin(left_count, right_count, left_routine, left_constraints, rest, combined, prior)
        EnterRightActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> EnterRightActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        EnterRightAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> EnterRightAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))
    Cons(Accepted(right_routine, right_constraints), rest) -> match edge
      ListMemberHere() -> EnterRightAcceptedOrigin(right_routine, right_constraints, ListMemberHere())
      ListMemberThere(prior) -> match enter_right_state_origin(left_count, right_count, left_routine, left_constraints, rest, combined, prior)
        EnterRightActiveOrigin(origin_state, origin_routine, origin_constraints, origin_edge) -> EnterRightActiveOrigin(origin_state, origin_routine, origin_constraints, ListMemberThere(origin_edge))
        EnterRightAcceptedOrigin(origin_routine, origin_constraints, origin_edge) -> EnterRightAcceptedOrigin(origin_routine, origin_constraints, ListMemberThere(origin_edge))

  type ContinueWithRightStateOrigin(left_count: Nat, right_count: Nat, left_states: List(MachineState(left_count)), right_starts: List(MachineState(right_count))) indices (combined: MachineState(plus(left_count, right_count)))
    ContinueLeftActiveOrigin : (state: Bounded(left_count)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Active(state, routine, constraints), left_states)) -> ContinueWithRightStateOrigin(left_count, right_count, left_states, right_starts, Active(inject_alternate_left(left_count, right_count, state), routine, constraints))
    ContinueEnteredRightOrigin : (left_routine: List(EvidenceInstruction)) -> (left_constraints: List(BoundaryConstraint)) -> (left_edge: ListMember(MachineState(left_count), Accepted(left_routine, left_constraints), left_states)) -> (right_origin: EnterRightStateOrigin(left_count, right_count, left_routine, left_constraints, right_starts, combined)) -> ContinueWithRightStateOrigin(left_count, right_count, left_states, right_starts, combined)

  fn prepend_continue_with_right_origin(left_count: Nat, right_count: Nat, head: MachineState(left_count), tail: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)), origin: ContinueWithRightStateOrigin(left_count, right_count, tail, right_starts, combined)) -> ContinueWithRightStateOrigin(left_count, right_count, Cons(head, tail), right_starts, combined) = match origin
    ContinueLeftActiveOrigin(state, routine, constraints, edge) -> ContinueLeftActiveOrigin(state, routine, constraints, ListMemberThere(edge))
    ContinueEnteredRightOrigin(left_routine, left_constraints, left_edge, right_origin) -> ContinueEnteredRightOrigin(left_routine, left_constraints, ListMemberThere(left_edge), right_origin)

  fn continue_with_right_state_origin(left_count: Nat, right_count: Nat, left_states: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, continue_with_right(left_count, left_states, right_starts))) -> ContinueWithRightStateOrigin(left_count, right_count, left_states, right_starts, combined) = match left_states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> ContinueLeftActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> prepend_continue_with_right_origin(left_count, right_count, Active(state, routine, constraints), rest, right_starts, combined, continue_with_right_state_origin(left_count, right_count, rest, right_starts, combined, prior))
    Cons(Accepted(left_routine, left_constraints), rest) -> match append_member_origin(plus(left_count, right_count), enter_right_with_constraints(left_count, left_routine, left_constraints, right_starts), continue_with_right(left_count, rest, right_starts), combined, edge)
      AppendMemberLeft(right_edge) -> ContinueEnteredRightOrigin(left_routine, left_constraints, ListMemberHere(), enter_right_state_origin(left_count, right_count, left_routine, left_constraints, right_starts, combined, right_edge))
      AppendMemberRight(rest_edge) -> prepend_continue_with_right_origin(left_count, right_count, Accepted(left_routine, left_constraints), rest, right_starts, combined, continue_with_right_state_origin(left_count, right_count, rest, right_starts, combined, rest_edge))

  type FilteredStateOrigin(n: Nat, states: List(MachineState(n)), boundary: Boundary) indices (filtered: MachineState(n))
    FilteredActiveStateOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), states)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredStateOrigin(n, states, boundary, Active(state, routine, Nil()))
    FilteredAcceptedStateOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), states)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredStateOrigin(n, states, boundary, Accepted(routine, Nil()))

  fn filtered_active_state_origin({n: Nat}, states: List(MachineState(n)), boundary: Boundary, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, routine, constraints), states), holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredStateOrigin(n, states, boundary, Active(state, routine, Nil())) = FilteredActiveStateOrigin(state, routine, constraints, edge, holds)

  fn filtered_accepted_state_origin({n: Nat}, states: List(MachineState(n)), boundary: Boundary, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Accepted(routine, constraints), states), holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredStateOrigin(n, states, boundary, Accepted(routine, Nil())) = FilteredAcceptedStateOrigin(routine, constraints, edge, holds)

  fn prepend_filtered_state_origin({n: Nat}, head: MachineState(n), tail: List(MachineState(n)), boundary: Boundary, filtered: MachineState(n), origin: FilteredStateOrigin(n, tail, boundary, filtered)) -> FilteredStateOrigin(n, Cons(head, tail), boundary, filtered) = match origin
    FilteredActiveStateOrigin(state, routine, constraints, edge, holds) -> FilteredActiveStateOrigin(state, routine, constraints, ListMemberThere(edge), holds)
    FilteredAcceptedStateOrigin(routine, constraints, edge, holds) -> FilteredAcceptedStateOrigin(routine, constraints, ListMemberThere(edge), holds)

  fn filtered_active_cons_origin(n: Nat, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), rest: List(MachineState(n)), boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, Cons(Active(state, routine, constraints), rest), boundary))) -> FilteredStateOrigin(n, Cons(Active(state, routine, constraints), rest), boundary, filtered) = with constraints_hold(constraints, boundary) proof holds
    True() -> match edge
      ListMemberHere() -> filtered_active_state_origin(Cons(Active(state, routine, constraints), rest), boundary, state, routine, constraints, member_here(Active(state, routine, constraints), rest), holds)
      ListMemberThere(prior) -> prepend_filtered_state_origin(Active(state, routine, constraints), rest, boundary, filtered, filtered_state_origin(n, rest, boundary, filtered, prior))
    False() -> prepend_filtered_state_origin(Active(state, routine, constraints), rest, boundary, filtered, filtered_state_origin(n, rest, boundary, filtered, edge))

  fn filtered_accepted_cons_origin(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), rest: List(MachineState(n)), boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, Cons(Accepted(routine, constraints), rest), boundary))) -> FilteredStateOrigin(n, Cons(Accepted(routine, constraints), rest), boundary, filtered) = with constraints_hold(constraints, boundary) proof holds
    True() -> match edge
      ListMemberHere() -> filtered_accepted_state_origin(Cons(Accepted(routine, constraints), rest), boundary, routine, constraints, member_here(Accepted(routine, constraints), rest), holds)
      ListMemberThere(prior) -> prepend_filtered_state_origin(Accepted(routine, constraints), rest, boundary, filtered, filtered_state_origin(n, rest, boundary, filtered, prior))
    False() -> prepend_filtered_state_origin(Accepted(routine, constraints), rest, boundary, filtered, filtered_state_origin(n, rest, boundary, filtered, edge))

  fn filtered_state_origin(n: Nat, states: List(MachineState(n)), boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, states, boundary))) -> FilteredStateOrigin(n, states, boundary, filtered) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> filtered_active_cons_origin(n, state, routine, constraints, rest, boundary, filtered, edge)
    Cons(Accepted(routine, constraints), rest) -> filtered_accepted_cons_origin(n, routine, constraints, rest, boundary, filtered, edge)

  fn impossible_false_is_true({a: Type}, equality: Equivalent(Bool, False(), True())) -> a = match equality
    reflexive() -> impossible

  fn and_true_left(a: Bool, b: Bool, equality: Equivalent(Bool, a and b, True())) -> Equivalent(Bool, a, True()) = match a
    True() -> reflexive(True())
    False() -> impossible_false_is_true(equality)

  fn and_true_right(a: Bool, b: Bool, equality: Equivalent(Bool, a and b, True())) -> Equivalent(Bool, b, True()) = match a
    True() -> equality
    False() -> impossible_false_is_true(equality)

  fn and_associative(a: Bool, b: Bool, c: Bool) -> Equivalent(Bool, a and (b and c), (a and b) and c) = match a
    True() -> reflexive(b and c)
    False() -> reflexive(False())

  fn transport_equivalent_source({a: Type}, x: a, y: a, z: a, xy: Equivalent(a, x, y), xz: Equivalent(a, x, z)) -> Equivalent(a, y, z) = match xy
    reflexive() -> xz

  fn constraints_hold_append(left: List(BoundaryConstraint), right: List(BoundaryConstraint), boundary: Boundary) -> Equivalent(Bool, constraints_hold(append_constraints(left, right), boundary), constraints_hold(left, boundary) and constraints_hold(right, boundary)) = match left
    Nil() -> reflexive(constraints_hold(right, boundary))
    Cons(head, rest) -> rewrite constraints_hold_append(rest, right, boundary) in and_associative(constraint_holds(head, boundary), constraints_hold(rest, boundary), constraints_hold(right, boundary))

  fn appended_constraints_left_hold(left: List(BoundaryConstraint), right: List(BoundaryConstraint), boundary: Boundary, equality: Equivalent(Bool, constraints_hold(append_constraints(left, right), boundary), True())) -> Equivalent(Bool, constraints_hold(left, boundary), True()) =
    and_true_left(constraints_hold(left, boundary), constraints_hold(right, boundary), transport_equivalent_source(constraints_hold(append_constraints(left, right), boundary), constraints_hold(left, boundary) and constraints_hold(right, boundary), True(), constraints_hold_append(left, right, boundary), equality))

  fn appended_constraints_right_hold(left: List(BoundaryConstraint), right: List(BoundaryConstraint), boundary: Boundary, equality: Equivalent(Bool, constraints_hold(append_constraints(left, right), boundary), True())) -> Equivalent(Bool, constraints_hold(right, boundary), True()) =
    and_true_right(constraints_hold(left, boundary), constraints_hold(right, boundary), transport_equivalent_source(constraints_hold(append_constraints(left, right), boundary), constraints_hold(left, boundary) and constraints_hold(right, boundary), True(), constraints_hold_append(left, right, boundary), equality))

  fn filter_active_member(n: Nat, states: List(MachineState(n)), boundary: Boundary, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, routine, constraints), states), holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> ListMember(MachineState(n), Active(state, routine, Nil()), filter_machine_states(n, states, boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, head_constraints), rest) -> with constraints_hold(head_constraints, boundary) proof head_holds
      True() -> match edge
        ListMemberHere() -> ListMemberHere()
        ListMemberThere(prior) -> ListMemberThere(filter_active_member(n, rest, boundary, state, routine, constraints, prior, holds))
      False() -> match edge
        ListMemberHere() -> impossible_false_is_true(transport_equivalent_source(constraints_hold(head_constraints, boundary), False(), True(), head_holds, holds))
        ListMemberThere(prior) -> filter_active_member(n, rest, boundary, state, routine, constraints, prior, holds)
    Cons(Accepted(head_routine, head_constraints), rest) -> with constraints_hold(head_constraints, boundary) proof head_holds
      True() -> match edge
        ListMemberThere(prior) -> ListMemberThere(filter_active_member(n, rest, boundary, state, routine, constraints, prior, holds))
      False() -> match edge
        ListMemberThere(prior) -> filter_active_member(n, rest, boundary, state, routine, constraints, prior, holds)

  fn filter_accepted_member(n: Nat, states: List(MachineState(n)), boundary: Boundary, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Accepted(routine, constraints), states), holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> ListMember(MachineState(n), Accepted(routine, Nil()), filter_machine_states(n, states, boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, head_constraints), rest) -> with constraints_hold(head_constraints, boundary) proof head_holds
      True() -> match edge
        ListMemberThere(prior) -> ListMemberThere(filter_accepted_member(n, rest, boundary, routine, constraints, prior, holds))
      False() -> match edge
        ListMemberThere(prior) -> filter_accepted_member(n, rest, boundary, routine, constraints, prior, holds)
    Cons(Accepted(head_routine, head_constraints), rest) -> with constraints_hold(head_constraints, boundary) proof head_holds
      True() -> match edge
        ListMemberHere() -> ListMemberHere()
        ListMemberThere(prior) -> ListMemberThere(filter_accepted_member(n, rest, boundary, routine, constraints, prior, holds))
      False() -> match edge
        ListMemberHere() -> impossible_false_is_true(transport_equivalent_source(constraints_hold(head_constraints, boundary), False(), True(), head_holds, holds))
        ListMemberThere(prior) -> filter_accepted_member(n, rest, boundary, routine, constraints, prior, holds)

  type FilteredContinueWithRightStateOrigin(left_count: Nat, right_count: Nat, left_states: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), boundary: Boundary) indices (filtered: MachineState(plus(left_count, right_count)))
    FilteredContinueLeftActiveOrigin : (state: Bounded(left_count)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Active(state, routine, constraints), left_states)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredContinueWithRightStateOrigin(left_count, right_count, left_states, right_starts, boundary, Active(inject_alternate_left(left_count, right_count, state), routine, Nil()))
    FilteredContinueEnteredRightActiveOrigin : (left_routine: List(EvidenceInstruction)) -> (left_constraints: List(BoundaryConstraint)) -> (left_edge: ListMember(MachineState(left_count), Accepted(left_routine, left_constraints), left_states)) -> (state: Bounded(right_count)) -> (right_routine: List(EvidenceInstruction)) -> (right_constraints: List(BoundaryConstraint)) -> (right_edge: ListMember(MachineState(right_count), Active(state, right_routine, right_constraints), right_starts)) -> (holds: Equivalent(Bool, constraints_hold(append_constraints(left_constraints, right_constraints), boundary), True())) -> FilteredContinueWithRightStateOrigin(left_count, right_count, left_states, right_starts, boundary, Active(inject_alternate_right(left_count, right_count, state), append_routine(left_routine, right_routine), Nil()))
    FilteredContinueEnteredRightAcceptedOrigin : (left_routine: List(EvidenceInstruction)) -> (left_constraints: List(BoundaryConstraint)) -> (left_edge: ListMember(MachineState(left_count), Accepted(left_routine, left_constraints), left_states)) -> (right_routine: List(EvidenceInstruction)) -> (right_constraints: List(BoundaryConstraint)) -> (right_edge: ListMember(MachineState(right_count), Accepted(right_routine, right_constraints), right_starts)) -> (holds: Equivalent(Bool, constraints_hold(append_constraints(left_constraints, right_constraints), boundary), True())) -> FilteredContinueWithRightStateOrigin(left_count, right_count, left_states, right_starts, boundary, Accepted(append_routine(append_routine(left_routine, right_routine), Cons(EmitPair(), Nil())), Nil()))

  fn filtered_continue_with_right_state_origin(left_count: Nat, right_count: Nat, left_states: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), boundary: Boundary, filtered: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), filtered, filter_machine_states(plus(left_count, right_count), continue_with_right(left_count, left_states, right_starts), boundary))) -> FilteredContinueWithRightStateOrigin(left_count, right_count, left_states, right_starts, boundary, filtered) = match filtered_state_origin(plus(left_count, right_count), continue_with_right(left_count, left_states, right_starts), boundary, filtered, edge)
    FilteredActiveStateOrigin(combined_state, combined_routine, combined_constraints, combined_edge, holds) -> match continue_with_right_state_origin(left_count, right_count, left_states, right_starts, Active(combined_state, combined_routine, combined_constraints), combined_edge)
      ContinueLeftActiveOrigin(state, routine, constraints, left_edge) -> FilteredContinueLeftActiveOrigin(state, routine, constraints, left_edge, holds)
      ContinueEnteredRightOrigin(left_routine, left_constraints, left_edge, right_origin) -> match right_origin
        EnterRightActiveOrigin(state, right_routine, right_constraints, right_edge) -> FilteredContinueEnteredRightActiveOrigin(left_routine, left_constraints, left_edge, state, right_routine, right_constraints, right_edge, holds)
    FilteredAcceptedStateOrigin(combined_routine, combined_constraints, combined_edge, holds) -> match continue_with_right_state_origin(left_count, right_count, left_states, right_starts, Accepted(combined_routine, combined_constraints), combined_edge)
      ContinueEnteredRightOrigin(left_routine, left_constraints, left_edge, right_origin) -> match right_origin
        EnterRightAcceptedOrigin(right_routine, right_constraints, right_edge) -> FilteredContinueEnteredRightAcceptedOrigin(left_routine, left_constraints, left_edge, right_routine, right_constraints, right_edge, holds)

  fn concat_left_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), source: Bounded(left_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), concat_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next)), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), continue_with_right(left_count, left_next(source, char), right_starts), boundary)) =
    rewrite split_injected_left_at(right_count, source) in reflexive(filter_machine_states(plus(left_count, right_count), continue_with_right(left_count, left_next(source, char), right_starts), boundary))

  fn concat_left_transition_origin(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), source: Bounded(left_count), char: Char, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, machine_destinations(plus(left_count, right_count), concat_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next)), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary))) -> FilteredContinueWithRightStateOrigin(left_count, right_count, left_next(source, char), right_starts, boundary, combined) =
    filtered_continue_with_right_state_origin(left_count, right_count, left_next(source, char), right_starts, boundary, combined, transport_alternate_edge(concat_left_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, boundary), edge))

  @reducible
  fn proof_machine_starts({n: Nat}, machine: PatternMachine(n)) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, next) -> starts

  fn concat_initial_origin(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, initial_machine_destinations(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), position, input, after_input))) -> FilteredContinueWithRightStateOrigin(left_count, right_count, proof_machine_starts(left_machine), proof_machine_starts(right_machine), initial_position_boundary(position, append_characters(input, after_input)), combined) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> filtered_continue_with_right_state_origin(left_count, right_count, left_starts, right_starts, initial_position_boundary(position, append_characters(input, after_input)), combined, edge)

  @reducible
  fn position_after_character(char: Char) -> InitialPosition =
    InitialPosition(False(), Std.Char.is_newline(char), ascii_word(char), option_word(char, True()))

  @reducible
  fn advance_initial_position(position: InitialPosition, input: List(Char)) -> InitialPosition = match input
    Nil() -> position
    Cons(char, rest) -> advance_initial_position(position_after_character(char), rest)

  fn advance_initial_position_cons(position: InitialPosition, char: Char, rest: List(Char)) -> Equivalent(InitialPosition, advance_initial_position(advance_initial_position(position, Cons(char, Nil())), rest), advance_initial_position(position, Cons(char, rest))) =
    reflexive(advance_initial_position(position_after_character(char), rest))

  fn advanced_position_boundary(position: InitialPosition, char: Char, rest: List(Char), after_input: List(Char)) -> Equivalent(Boundary, initial_position_boundary(advance_initial_position(position, Cons(char, Nil())), append_characters(rest, after_input)), transition_boundary_before(char, rest, after_input)) =
    reflexive(transition_boundary_before(char, rest, after_input))

  type InputPartition indices (input: List(Char), left: List(Char), right: List(Char))
    InputPartitionHere : (right: List(Char)) -> InputPartition(right, Nil(), right)
    InputPartitionThere : (char: Char) -> (proof: InputPartition(input, left, right)) -> InputPartition(Cons(char, input), Cons(char, left), right)

  fn input_partition_here(right: List(Char)) -> InputPartition(right, empty_characters(), right) = InputPartitionHere(right)

  fn input_partition_there(char: Char, {input: List(Char)}, {left: List(Char)}, {right: List(Char)}, proof: InputPartition(input, left, right)) -> InputPartition(Cons(char, input), Cons(char, left), right) = InputPartitionThere(char, proof)

  ## A repeat path is partitioned into exact child acceptances. A completed
  ## child either closes the list, or supplies the start edge and execution for
  ## the next child in the same transition. Keeping those witnesses in one
  ## indexed relation prevents evidence boundaries from being reconstructed by
  ## inspecting the emitted instruction stream.
  type RepeatActivePathProjection(n: Nat, machine: PatternMachine(n), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence), final_captures: List(CaptureFrame))
    ProjectedRepeatFinalItem : (child_final_evidence: List(Evidence)) -> (child_final_captures: List(CaptureFrame)) -> (child_routine: List(ExtendedInstruction)) -> (child_path: AcceptingFrom(n, machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> (child_captures_exact: Equivalent(List(CaptureFrame), child_final_captures, accepting_final_captures(n, machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path))) -> (combined_final_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), combined_final_captures, child_final_captures)) -> (@erased projected_final_evidence: List(Evidence)) -> (final_is_closed: Equivalent(List(Evidence), projected_final_evidence, Cons(EndListEvidence(), child_final_evidence))) -> RepeatActivePathProjection(n, machine, lazy, position, input, after_input, source, current_evidence, current_captures, projected_final_evidence, combined_final_captures)
    ProjectedRepeatMoreItems : (child_input: List(Char)) -> (remaining_input: List(Char)) -> (partition: InputPartition(input, child_input, remaining_input)) -> (child_final_evidence: List(Evidence)) -> (child_final_captures: List(CaptureFrame)) -> (child_routine: List(ExtendedInstruction)) -> (child_path: AcceptingFrom(n, machine, child_input, append_characters(remaining_input, after_input), ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> (child_captures_exact: Equivalent(List(CaptureFrame), child_final_captures, accepting_final_captures(n, machine, child_input, append_characters(remaining_input, after_input), ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path))) -> (next_state: Bounded(n)) -> (next_routine: List(EvidenceInstruction)) -> (next_evidence: List(Evidence)) -> (next_captures: List(CaptureFrame)) -> (next_edge: ListMember(MachineState(n), Active(next_state, next_routine, Nil()), initial_machine_destinations(n, machine, advance_initial_position(position, child_input), remaining_input, after_input))) -> (next_execution: RoutineExecution(next_routine, child_final_evidence, child_final_captures, next_evidence, next_captures)) -> (@erased projected_final_evidence: List(Evidence)) -> (combined_final_captures: List(CaptureFrame)) -> (continuation: RepeatActivePathProjection(n, machine, lazy, advance_initial_position(position, child_input), remaining_input, after_input, next_state, next_evidence, next_captures, projected_final_evidence, combined_final_captures)) -> RepeatActivePathProjection(n, machine, lazy, position, input, after_input, source, current_evidence, current_captures, projected_final_evidence, combined_final_captures)

