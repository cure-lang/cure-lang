  @reducible
  fn empty_boundary_constraints() -> List(BoundaryConstraint) = Nil()

  @reducible
  fn empty_extended_routine() -> List(ExtendedInstruction) = Nil()

  fn accepted_without_constraints(n: Nat, routine: List(EvidenceInstruction)) -> MachineState(n) = Accepted(routine, empty_boundary_constraints())

