  fn thompson_repeat_acceptance_from_encodes(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(inner), repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(ListC(inner_shape), final_evidence, input_evidence) = match project_repeat_acceptance_from_machine(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, input_evidence, input_captures, acceptance)
