  fn group_empty_child_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), routine: List(EvidenceInstruction), final_evidence: List(Evidence), final_captures: List(CaptureFrame), edge: ListMember(MachineState(n), accepted_without_constraints(n, routine), initial_machine_destinations(n, machine, position, empty_characters(), after_input)), execution: RoutineExecution(routine, input_evidence, input_captures, final_evidence, final_captures)) -> AcceptanceWithExecution(n, machine, position, empty_characters(), after_input, input_evidence, input_captures, final_evidence, final_captures) =
