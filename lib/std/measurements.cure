@group(:system)
mod Std.Measurements
  ## Literal units of measure (design 2026-07-08-units-macro-design).
  ##
  ## A number written immediately before a registered suffix expands, at parse
  ## time, into the matching constructor call — no runtime cost beyond the
  ## wrapped integer. The suffixes are globally active (like `:syntax` macros),
  ## so `use Std.Measurements` is only needed to bring the operations and the wrapper
  ## types into scope, not to enable the sugar.
  ##
  ##   500ms   ==>  Std.Measurements.ms(500)     # a Duration of 500_000 microseconds
  ##   3khz    ==>  Std.Measurements.khz(3)      # a Frequency of 3_000 hertz
  ##   80pct   ==>  Std.Measurements.pct(80)     # a Percent
  ##   9600baud ==> Std.Measurements.baud(9600)  # a Baud rate
  ##
  ## Each quantity is a closed record over one `Int`, so arithmetic stays
  ## same-unit: `add`/`sub`/`scale` are defined per quantity and there is no
  ## cross-quantity operation, which is what makes `500ms` and `3khz` unmixable.
  ##
  ## ## Example
  ##
  ## ```cure
  ## use Std.Measurements
  ##
  ## let budget = add(500ms, 250ms)      # a Duration of 750_000 microseconds
  ## as_ms(budget)                        # => 750
  ## ```

  ## A length of time, stored as microseconds.
  rec Duration
    micros: Int

  ## A rate, stored as hertz.
  rec Frequency
    hertz: Int

  ## A percentage. The wrapper keeps percentages from being mixed with bare
  ## integers or other quantities; range enforcement (0..100) awaits the return
  ## of refinement/`Bounded` literals and is not checked here.
  rec Percent
    percent: Int

  ## A serial signalling rate, stored as symbols per second.
  rec Baud
    rate: Int

  # -- Constructors (literal-rule targets) ------------------------------------

  ## A Duration of `n` microseconds.
  fn us(n: Int) -> Duration = Duration{micros: n}

  ## A Duration of `n` milliseconds.
  fn ms(n: Int) -> Duration = Duration{micros: n * 1000}

  ## A Duration of `n` seconds.
  fn s(n: Int) -> Duration = Duration{micros: n * 1000000}

  ## A Frequency of `n` hertz.
  fn hz(n: Int) -> Frequency = Frequency{hertz: n}

  ## A Frequency of `n` kilohertz.
  fn khz(n: Int) -> Frequency = Frequency{hertz: n * 1000}

  ## A Percent of `n`.
  fn pct(n: Int) -> Percent = Percent{percent: n}

  ## A Baud rate of `n` symbols per second.
  fn baud(n: Int) -> Baud = Baud{rate: n}

  # -- Literal rules ----------------------------------------------------------

  macro Measurements
    literal <n: Number> us becomes Std.Measurements.us(n)
    literal <n: Number> ms becomes Std.Measurements.ms(n)
    literal <n: Number> s becomes Std.Measurements.s(n)
    literal <n: Number> hz becomes Std.Measurements.hz(n)
    literal <n: Number> khz becomes Std.Measurements.khz(n)
    literal <n: Number> pct becomes Std.Measurements.pct(n)
    literal <n: Number> baud becomes Std.Measurements.baud(n)

  # -- Duration arithmetic (same-unit) ----------------------------------------

  ## Sum of two Durations.
  fn add(a: Duration, b: Duration) -> Duration = Duration{micros: a.micros + b.micros}

  ## Difference of two Durations (`a - b`).
  fn sub(a: Duration, b: Duration) -> Duration = Duration{micros: a.micros - b.micros}

  ## A Duration scaled by an integer factor.
  fn scale(d: Duration, k: Int) -> Duration = Duration{micros: d.micros * k}

  # -- Duration conversions ---------------------------------------------------

  ## The Duration as a whole number of microseconds.
  fn as_us(d: Duration) -> Int = d.micros

  ## The Duration truncated to whole milliseconds.
  fn as_ms(d: Duration) -> Int = d.micros / 1000

  ## The Duration truncated to whole seconds.
  fn as_s(d: Duration) -> Int = d.micros / 1000000
