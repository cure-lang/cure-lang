@group(:system)
mod Std.Io
  ## Standard I/O operations for printing to stdout.
  ##
  ## Wall-clock stdout primitives. Every entry that actually writes
  ## carries the `! Io` effect so callers are forced to declare it
  ## in their own signatures.
  ##
  ## ## Examples
  ##
  ## ```cure
  ## use Std.Io
  ##
  ## println("Hello, Cure!")                # Hello, Cure!
  ## print_int(42)                          # 42
  ## print_float(3.14)                      # 3.14
  ## ```
  ##
  ## ```cure
  ## use Std.Io
  ##
  ## fn greet(name: String) -> Unit ! Io =
  ##   println("Hello, " <> name <> "!")
  ## ```

  ## `<>` on `String` desugars to `Std.Semigroup.combine`, which resolves to
  ## `Std.String`'s own instance -- `String` is nominal, not a `List(Char)` alias.
  use Std.String
  use Std.Semigroup

  ## Group tag consumed by `Cure.Stdlib.Preload`.
  ## Print a string to stdout without a trailing newline.
  ## Wraps `:io.put_chars/1`.
  @extern(:io, :put_chars, 1)
  local fn raw_put_chars(text: List(Char)) -> Atom ! Io

  fn put_chars(text: String) -> Unit ! Io =
    let _ = raw_put_chars(Std.String.characters(text))
    ()

  ## Print a string to stdout with a trailing newline.
  fn println(text: String) -> Unit ! Io =
    put_chars(text <> "\n")

  ## Print a string to stdout without a trailing newline. Alias for
  ## `put_chars/1`; kept for readability at call sites.
  fn print(text: String) -> Unit ! Io =
    put_chars(text)

  ## An `@extern` is a direct Erlang remote call with no marshalling, so the
  ## types written here are claims about the ERASED shape that crosses the
  ## boundary. `String` is nominal (`rec String { characters: List(Char) }`) and
  ## erases to the tagged pair `{String, chars}`, which no OTP function knows how
  ## to read or produce; `List(Char)` erases to a bare charlist, which they do.
  ## So the externs below are declared at `List(Char)` and the public functions
  ## wrap -- the same convention `Std.String` documents and follows.

  ## Render an integer as its decimal string (`:erlang.integer_to_list/1`).
  @extern(:erlang, :integer_to_list, 1)
  local fn int_to_charlist(n: Int) -> List(Char)

  fn int_to_string(n: Int) -> String = Std.String.from_characters(int_to_charlist(n))

  ## Render a float as its decimal string (`:erlang.float_to_list/1`).
  @extern(:erlang, :float_to_list, 1)
  local fn float_to_charlist(f: Float) -> List(Char)

  fn float_to_string(f: Float) -> String = Std.String.from_characters(float_to_charlist(f))

  ## Render an atom as its name (`:erlang.atom_to_list/1`).
  @extern(:erlang, :atom_to_list, 1)
  local fn atom_to_charlist(a: Atom) -> List(Char)

  fn atom_to_string(a: Atom) -> String = Std.String.from_characters(atom_to_charlist(a))

  ## Print an integer followed by a newline.
  fn print_int(n: Int) -> Unit ! Io =
    println(int_to_string(n))

  ## Print a float followed by a newline.
  fn print_float(f: Float) -> Unit ! Io =
    println(float_to_string(f))
