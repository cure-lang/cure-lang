@group(:text)
mod Std.Regex.Runtime
  ## Executable Regex machine, evidence VM, typed compiler, and combinators.
  use Std.Regex.Core
  use Std.Char
  use Std.Option
  use Std.String
  use Std.Syntax
  use Std.Bounded
  use Std.Equivalent
  use Std.Sigma

  fn build_transition_rows(remaining: Nat, {total: Nat}, inject: (Bounded(remaining)) -> Bounded(total), next: (Bounded(total)) -> Char -> List(MachineState(total))) -> TransitionRowsFrom(remaining, total) = match remaining
    Z() -> NoTransitionRows()
    S(rest) ->
      MoreTransitionRows(
        fn(char) -> next(inject(First()), char),
        build_transition_rows(rest, fn(state) -> inject(Next(state)), next)
      )

  fn compile_transition_rows(n: Nat, machine: PatternMachine(n)) -> TransitionRows(n) = match machine
    MkPatternMachine(_, next) -> TransitionRows(build_transition_rows(n, fn(state) -> state, next))

  fn transition_rows_from_next({remaining: Nat}, {total: Nat}, rows: TransitionRowsFrom(remaining, total), state: Bounded(remaining), char: Char) -> List(MachineState(total)) = match rows
    NoTransitionRows() -> match state
    MoreTransitionRows(row, rest) -> match state
      First() -> row(char)
      Next(index) -> transition_rows_from_next(rest, index, char)

  fn transition_rows_next({n: Nat}, rows: TransitionRows(n), state: Bounded(n), char: Char) -> List(MachineState(n)) = match rows
    TransitionRows(values) -> transition_rows_from_next(values, state, char)

  ## A table-backed machine exposes the same indexed machine interface as the
  ## reference closure machine.  The only runtime closure is this single row
  ## lookup adapter; transition construction itself is performed once when
  ## the table is built, not by recursively rebuilding Thompson combinators
  ## for each input character.
  fn transition_rows_machine({n: Nat}, starts: List(MachineState(n)), rows: TransitionRows(n)) -> PatternMachine(n) =
    MkPatternMachine(starts, fn(state) -> fn(char) -> transition_rows_next(rows, state, char))

  @reducible
  fn machine_state_routine(n: Nat, state: MachineState(n)) -> List(EvidenceInstruction) = match state
    Active(_, routine, _) -> routine
    Accepted(routine, _) -> routine

  fn append_routine(left: List(EvidenceInstruction), right: List(EvidenceInstruction)) -> List(EvidenceInstruction) = match left
    [] -> right
    [head | rest] -> [head | append_routine(rest, right)]

  @reducible
  fn append_states({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n))) -> List(MachineState(n)) = match left
    [] -> right
    [head | rest] -> [head | append_states(rest, right)]

  @reducible
  fn append_machine_states(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) -> List(MachineState(n)) =
    append_states(left, right)

  fn append_constraints(left: List(BoundaryConstraint), right: List(BoundaryConstraint)) -> List(BoundaryConstraint) = match left
    [] -> right
    [head | rest] -> [head | append_constraints(rest, right)]

  @reducible
  fn inject_left_states({left_count: Nat}, {right_count: Nat}, states: List(MachineState(left_count))) -> List(MachineState(plus(left_count, right_count))) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(routine, constraints) | inject_left_states(rest)]
    [Active(state, routine, constraints) | rest] -> [Active(inject_left_at(left_count, right_count, state), routine, constraints) | inject_left_states(rest)]

  @reducible
  fn inject_alternate_left(left_count: Nat, right_count: Nat, state: Bounded(left_count)) -> Bounded(plus(left_count, right_count)) =
    inject_left(state)

  @reducible
  fn inject_alternate_right(left_count: Nat, right_count: Nat, state: Bounded(right_count)) -> Bounded(plus(left_count, right_count)) =
    inject_right(left_count, state)

  fn alternate_left_injection_is_widening({left_count: Nat}, @erased right_count: Nat, state: Bounded(left_count)) -> Equivalent(Bounded(plus(left_count, right_count)), inject_alternate_left(left_count, right_count, state), inject_left_at(left_count, right_count, state)) =
    reflexive(inject_left_at(left_count, right_count, state))

  fn alternate_left_widening_is_injection({left_count: Nat}, @erased right_count: Nat, state: Bounded(left_count)) -> Equivalent(Bounded(plus(left_count, right_count)), inject_left_at(left_count, right_count, state), inject_alternate_left(left_count, right_count, state)) =
    reflexive(inject_left_at(left_count, right_count, state))

  fn alternate_right_injection_is_inject_right(left_count: Nat, {right_count: Nat}, state: Bounded(right_count)) -> Equivalent(Bounded(plus(left_count, right_count)), inject_alternate_right(left_count, right_count, state), inject_right_at(left_count, right_count, state)) =
    reflexive(inject_right_at(left_count, right_count, state))

  @reducible
  fn inject_right_states(left_count: Nat, {right_count: Nat}, states: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(routine, constraints) | inject_right_states(left_count, rest)]
    [Active(state, routine, constraints) | rest] -> [Active(inject_right(left_count, state), routine, constraints) | inject_right_states(left_count, rest)]

  @reducible
  fn enter_right_with_constraints(left_count: Nat, {right_count: Nat}, left_routine: List(EvidenceInstruction), left_constraints: List(BoundaryConstraint), right_starts: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) = match right_starts
    [] -> []
    [Accepted(right_routine, right_constraints) | rest] ->
      [Accepted(append_routine(append_routine(left_routine, right_routine), [EmitPair()]), append_constraints(left_constraints, right_constraints)) | enter_right_with_constraints(left_count, left_routine, left_constraints, rest)]
    [Active(state, right_routine, right_constraints) | rest] ->
      [Active(inject_right(left_count, state), append_routine(left_routine, right_routine), append_constraints(left_constraints, right_constraints)) | enter_right_with_constraints(left_count, left_routine, left_constraints, rest)]

  fn enter_right(left_count: Nat, {right_count: Nat}, left_routine: List(EvidenceInstruction), right_starts: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) =
    enter_right_with_constraints(left_count, left_routine, [], right_starts)

  @reducible
  fn continue_with_right(left_count: Nat, {right_count: Nat}, left_states: List(MachineState(left_count)), right_starts: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) = match left_states
    [] -> []
    [Accepted(left_routine, constraints) | rest] -> append_states(enter_right_with_constraints(left_count, left_routine, constraints, right_starts), continue_with_right(left_count, rest, right_starts))
    [Active(state, routine, constraints) | rest] -> [Active(inject_left_at(left_count, right_count, state), routine, constraints) | continue_with_right(left_count, rest, right_starts)]

  @reducible
  fn finish_pair({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [EmitPair()]), constraints) | finish_pair(rest)]
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | finish_pair(rest)]

  @reducible
  fn mark_branch({n: Nat}, states: List(MachineState(n)), marker: EvidenceInstruction) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [marker]), constraints) | mark_branch(rest, marker)]
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | mark_branch(rest, marker)]

  @reducible
  fn append_branch_marker(routine: List(EvidenceInstruction), marker: EvidenceInstruction) -> List(EvidenceInstruction) =
    append_routine(routine, Cons(marker, Nil()))

  @reducible
  fn alternate_left_states(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction) -> List(MachineState(plus(left_count, right_count))) =
    inject_left_states(mark_branch(states, marker))

  @reducible
  fn alternate_right_states(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction) -> List(MachineState(plus(left_count, right_count))) =
    inject_right_states(left_count, mark_branch(states, marker))

  fn prefix_routine({n: Nat}, instruction: EvidenceInstruction, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted([instruction | routine], constraints) | prefix_routine(instruction, rest)]
    [Active(state, routine, constraints) | rest] -> [Active(state, [instruction | routine], constraints) | prefix_routine(instruction, rest)]

  fn finish_capture({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [EndCapture()]), constraints) | finish_capture(rest)]
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | finish_capture(rest)]

  @reducible
  fn repeat_accepting({n: Nat}, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint)) -> List(MachineState(n)) =
    [Accepted(append_routine(routine, [EndList()]), constraints)]

  @reducible
  fn repeat_destination_order({n: Nat}, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) = pickup
    lazy -> append_states(repeat_accepting(routine, constraints), enter_repeat_with_constraints(routine, constraints, starts))
    else -> append_states(enter_repeat_with_constraints(routine, constraints, starts), repeat_accepting(routine, constraints))

  @reducible
  fn repeat_destinations({n: Nat}, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) = match destinations
    [] -> []
    [Accepted(routine, constraints) | rest] ->
      append_states(repeat_destination_order(routine, constraints, starts, lazy), repeat_destinations(rest, starts, lazy))
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | repeat_destinations(rest, starts, lazy)]

  @reducible
  fn enter_repeat_with_constraints({n: Nat}, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n))) -> List(MachineState(n)) = match starts
    [] -> []
    [Accepted(_, _) | rest] -> enter_repeat_with_constraints(routine, constraints, rest)
    [Active(state, next_routine, next_constraints) | rest] ->
      [Active(state, append_routine(routine, next_routine), append_constraints(constraints, next_constraints)) | enter_repeat_with_constraints(routine, constraints, rest)]

  @reducible
  fn enter_repeat({n: Nat}, routine: List(EvidenceInstruction), starts: List(MachineState(n))) -> List(MachineState(n)) =
    enter_repeat_with_constraints(routine, [], starts)

  @reducible
  fn predicate_machine_destinations(holds: Bool, char: Char) -> List(MachineState(S(Z()))) = match holds
    False() -> []
    True() -> [Accepted([EmitChar(char)], [])]

  @reducible
  fn predicate_machine_next(test: Char -> Bool, _state: Bounded(S(Z())), char: Char) -> List(MachineState(S(Z()))) =
    predicate_machine_destinations(test(char), char)

  fn empty_machine_next({n: Nat}, _state: Bounded(n), _char: Char) -> List(MachineState(n)) = []

  @reducible
  fn group_machine_next({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    match next(state, char)
      [] -> []
      [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [EndCapture()]), constraints) | finish_capture(rest)]
      [Active(active, routine, constraints) | rest] -> [Active(active, routine, constraints) | finish_capture(rest)]

  @reducible
  fn concat_machine_next(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    fold_sum(
      split_sum(left_count, state),
      fn(left_state) -> continue_with_right(left_count, left_next(left_state, char), right_starts),
      fn(right_state) -> inject_right_states(left_count, finish_pair(right_next(right_state, char)))
    )

  @reducible
  fn alternate_machine_next(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    fold_sum(
      split_sum(left_count, state),
      fn(left_state) -> inject_left_states(mark_branch(left_next(left_state, char), EmitLeft())),
      fn(right_state) -> inject_right_states(left_count, mark_branch(right_next(right_state, char), EmitRight()))
    )

  @reducible
  fn alternate_starts_order({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), prefer_right: Bool) -> List(MachineState(n)) = match prefer_right
    True() -> append_states(right, left)
    False() -> append_states(left, right)

  @reducible
  fn alternate_machine_starts(left_count: Nat, {right_count: Nat}, left_starts: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), prefer_right: Bool) -> List(MachineState(plus(left_count, right_count))) =
    let marked_left: List(MachineState(plus(left_count, right_count))) = inject_left_states(mark_branch(left_starts, EmitLeft()))
    let marked_right: List(MachineState(plus(left_count, right_count))) = inject_right_states(left_count, mark_branch(right_starts, EmitRight()))
    alternate_starts_order(marked_left, marked_right, prefer_right)

  @reducible
  fn alternate_pattern_machine(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool) -> PatternMachine(plus(left_count, right_count)) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        MkPatternMachine(
          alternate_machine_starts(left_count, left_starts, right_starts, prefer_right),
          alternate_machine_next(left_count, left_next, right_next)
        )

  @reducible
  fn repeat_machine_starts({n: Nat}, starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) =
    let empty: List(MachineState(n)) = [Accepted([BeginList(), EndList()], [])]
    let consuming: List(MachineState(n)) = enter_repeat([BeginList()], starts)
    pickup
      lazy -> append_states(empty, consuming)
      else -> append_states(consuming, empty)

  @reducible
  fn repeat_machine_next({n: Nat}, starts: List(MachineState(n)), lazy: Bool, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    repeat_destinations(next(state, char), starts, lazy)

  fn empty_pattern_machine() -> PatternMachine(Z()) =
    let starts: List(MachineState(Z())) = [Accepted([EmitUnit()], [])]
    MkPatternMachine(starts, empty_machine_next)

  @reducible
  fn boundary_pattern_machine(constraint: BoundaryConstraint) -> PatternMachine(Z()) =
    let routine: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
    let constraints: List(BoundaryConstraint) = Cons(constraint, Nil())
    let starts: List(MachineState(Z())) = Cons(Accepted(routine, constraints), Nil())
    MkPatternMachine(starts, empty_machine_next)

  @reducible
  fn predicate_machine_start() -> MachineState(S(Z())) =
    let routine: List(EvidenceInstruction) = []
    let constraints: List(BoundaryConstraint) = []
    Active(First(), routine, constraints)

  @reducible
  fn predicate_machine_thread() -> ThreadState(S(Z())) = ThreadActive(First())

  @reducible
  fn predicate_accepting_destination(char: Char) -> MachineState(S(Z())) =
    let routine: List(EvidenceInstruction) = [EmitChar(char)]
    let constraints: List(BoundaryConstraint) = []
    Accepted(routine, constraints)

  @reducible
  fn predicate_pattern_machine(test: Char -> Bool) -> PatternMachine(S(Z())) =
    let starts: List(MachineState(S(Z()))) = [predicate_machine_start()]
    MkPatternMachine(starts, predicate_machine_next(test))

  @reducible
  fn group_pattern_machine(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n))) -> PatternMachine(n) =
    MkPatternMachine(
      finish_capture(prefix_routine(BeginCapture(), starts)),
      group_machine_next(next)
    )

  @reducible
  fn concat_pattern_machine(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count)) -> PatternMachine(plus(left_count, right_count)) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        MkPatternMachine(
          continue_with_right(left_count, left_starts, right_starts),
          concat_machine_next(left_count, left_next, right_starts, right_next)
        )

  @reducible
  fn repeat_pattern_machine(n: Nat, machine: PatternMachine(n), lazy: Bool) -> PatternMachine(n) = match machine
    MkPatternMachine(starts, next) ->
      MkPatternMachine(
        repeat_machine_starts(starts, lazy),
        repeat_machine_next(starts, lazy, next)
      )

  ## Constructor-preserving Thompson IR. Both runtime compilation and the
  ## evidence theorem consume this same tree, so proof code never reconstructs
  ## machine provenance from a function-valued transition table.
  type ThompsonCompilation indices (shape: ShapeCode)
    ThompsonPredicate : (test: (Char -> Bool)) -> ThompsonCompilation(CharC)
    ThompsonEmpty : ThompsonCompilation(UnitC)
    ThompsonBoundary : (constraint: BoundaryConstraint) -> ThompsonCompilation(UnitC)
    ThompsonConcat : (left: ThompsonCompilation(left_shape)) -> (right: ThompsonCompilation(right_shape)) -> ThompsonCompilation(PairC(left_shape, right_shape))
    ThompsonGroup : (inner: ThompsonCompilation(inner_shape)) -> ThompsonCompilation(StringC)
    ThompsonAlternate : (left: ThompsonCompilation(left_shape)) -> (right: ThompsonCompilation(right_shape)) -> (prefer_right: Bool) -> ThompsonCompilation(ChoiceC(left_shape, right_shape))
    ThompsonRepeat : (inner: ThompsonCompilation(inner_shape)) -> (lazy: Bool) -> ThompsonCompilation(ListC(inner_shape))

  @reducible
  fn thompson_state_count({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> Nat = match compilation
    ThompsonPredicate(_) -> S(Z())
    ThompsonEmpty() -> Z()
    ThompsonBoundary(_) -> Z()
    ThompsonConcat(left, right) -> plus(thompson_state_count(left), thompson_state_count(right))
    ThompsonGroup(inner) -> thompson_state_count(inner)
    ThompsonAlternate(left, right, _) -> plus(thompson_state_count(left), thompson_state_count(right))
    ThompsonRepeat(inner, _) -> thompson_state_count(inner)

  @reducible
  fn pattern_machine_starts({n: Nat}, machine: PatternMachine(n)) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, next) -> starts

  @reducible
  fn pattern_machine_next({n: Nat}, machine: PatternMachine(n)) -> (Bounded(n)) -> Char -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, next) -> next

  fn pattern_machine_eta({n: Nat}, machine: PatternMachine(n)) -> Equivalent(PatternMachine(n), machine, MkPatternMachine(pattern_machine_starts(machine), pattern_machine_next(machine))) = match machine
    MkPatternMachine(starts, next) -> reflexive(MkPatternMachine(starts, next))

  @reducible
  ## Reference constructor retained for differential tests.
  fn reference_thompson_machine({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> PatternMachine(thompson_state_count(compilation)) = match compilation
    ThompsonPredicate(test) -> predicate_pattern_machine(test)
    ThompsonEmpty() -> empty_pattern_machine()
    ThompsonBoundary(constraint) -> boundary_pattern_machine(constraint)
    ThompsonConcat(left, right) -> concat_pattern_machine(thompson_state_count(left), reference_thompson_machine(left), thompson_state_count(right), reference_thompson_machine(right))
    ThompsonGroup(inner) -> group_pattern_machine(thompson_state_count(inner), pattern_machine_starts(reference_thompson_machine(inner)), pattern_machine_next(reference_thompson_machine(inner)))
    ThompsonAlternate(left, right, prefer_right) -> alternate_pattern_machine(thompson_state_count(left), reference_thompson_machine(left), thompson_state_count(right), reference_thompson_machine(right), prefer_right)
    ThompsonRepeat(inner, lazy) -> repeat_pattern_machine(thompson_state_count(inner), reference_thompson_machine(inner), lazy)

  ## Canonical constructor.  The reference copy above is deliberately kept
  ## separate so transition-row implementations can be compared without
  ## changing the proof theorem's original definitional equations.
  fn thompson_machine({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> PatternMachine(thompson_state_count(compilation)) = match compilation
    ThompsonPredicate(test) -> predicate_pattern_machine(test)
    ThompsonEmpty() -> empty_pattern_machine()
    ThompsonBoundary(constraint) -> boundary_pattern_machine(constraint)
    ThompsonConcat(left, right) -> concat_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right))
    ThompsonGroup(inner) -> group_pattern_machine(thompson_state_count(inner), pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner)))
    ThompsonAlternate(left, right, prefer_right) -> alternate_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right)
    ThompsonRepeat(inner, lazy) -> repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy)

  fn certify_thompson({@erased shape: ShapeCode}, pattern: Pattern(shape)) -> ThompsonCompilation(shape) = match pattern
    PatternPredicate(test) -> ThompsonPredicate(test)
    PatternEmpty() -> ThompsonEmpty()
    PatternBoundary(constraint) -> ThompsonBoundary(constraint)
    PatternConcat(left, right) -> ThompsonConcat(certify_thompson(left), certify_thompson(right))
    PatternGroup(inner) -> ThompsonGroup(certify_thompson(inner))
    PatternAlternate(left, right) -> ThompsonAlternate(certify_thompson(left), certify_thompson(right), false)
    PatternAlternateMode(left, right, prefer_right) -> ThompsonAlternate(certify_thompson(left), certify_thompson(right), prefer_right)
    PatternRepeat(inner) -> ThompsonRepeat(certify_thompson(inner), false)
    PatternRepeatMode(inner, lazy) -> ThompsonRepeat(certify_thompson(inner), lazy)

  @reducible
  fn thompson_compiled({shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> Sigma(n: Nat, PatternMachine(n)) =
    %[thompson_state_count(compilation), thompson_machine(compilation)]

  fn compile_pattern({shape: ShapeCode}, pattern: Pattern(shape)) -> Sigma(n: Nat, PatternMachine(n)) =
    thompson_compiled(certify_thompson(pattern))

  fn machine_has_accept({n: Nat}, states: List(MachineState(n))) -> Bool = match states
    [] -> false
    [Accepted(_, _) | _] -> true
    [Active(_, _, _) | rest] -> machine_has_accept(rest)

  fn machine_step_one({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, current: MachineState(n)) -> List(MachineState(n)) = match current
    Accepted(_, _) -> []
    Active(state, _, _) -> next(state, char)

  fn machine_step({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, current: List(MachineState(n))) -> List(MachineState(n)) = match current
    [] -> []
    [head | rest] -> append_states(machine_step_one(next, char, head), machine_step(next, char, rest))

  fn constraint_holds(constraint: BoundaryConstraint, boundary: Boundary) -> Bool = match boundary
    Boundary(subject_start, subject_end, strict_subject_end, line_start, line_end, ascii_boundary, unicode_boundary) -> match constraint
      BoundaryConstraint(require_subject_start, require_subject_end, require_strict_end, require_line_start, require_line_end, check_ascii, expected_ascii, check_unicode, expected_unicode) ->
        (not require_subject_start or subject_start) and
          (not require_subject_end or subject_end) and
          (not require_strict_end or strict_subject_end) and
          (not require_line_start or line_start) and
          (not require_line_end or line_end) and
          (not check_ascii or ascii_boundary == expected_ascii) and
          (not check_unicode or unicode_boundary == expected_unicode)

  fn subject_start_constraint() -> BoundaryConstraint =
    BoundaryConstraint(true, false, false, false, false, false, false, false, false)

  fn subject_end_constraint() -> BoundaryConstraint =
    BoundaryConstraint(false, true, false, false, false, false, false, false, false)

  fn strict_end_constraint() -> BoundaryConstraint =
    BoundaryConstraint(false, false, true, false, false, false, false, false, false)

  fn line_start_constraint() -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, true, false, false, false, false, false)

  fn line_end_constraint() -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, true, false, false, false, false)

  fn ascii_word_constraint(expected: Bool) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, true, expected, false, false)

  fn unicode_word_constraint(expected: Bool) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, true, expected)

  @reducible
  fn constraints_hold(constraints: List(BoundaryConstraint), boundary: Boundary) -> Bool = match constraints
    [] -> true
    [head | rest] -> constraint_holds(head, boundary) and constraints_hold(rest, boundary)

  @reducible
  fn filter_active_decision({n: Nat}, keep: Bool, state: Bounded(n), routine: List(EvidenceInstruction), rest: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) = match keep
    True() -> Cons(Active(state, routine, Nil()), filter_boundary_states(rest, boundary))
    False() -> filter_boundary_states(rest, boundary)

  @reducible
  fn filter_accepted_decision({n: Nat}, keep: Bool, routine: List(EvidenceInstruction), rest: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) = match keep
    True() -> Cons(Accepted(routine, Nil()), filter_boundary_states(rest, boundary))
    False() -> filter_boundary_states(rest, boundary)

  @reducible
  fn filter_boundary_states({n: Nat}, states: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> filter_accepted_decision(constraints_hold(constraints, boundary), routine, rest, boundary)
    [Active(state, routine, constraints) | rest] -> filter_active_decision(constraints_hold(constraints, boundary), state, routine, rest, boundary)

  @reducible
  fn filter_machine_states(n: Nat, states: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) =
    filter_boundary_states(states, boundary)

  fn position_line_end(input: List(Char)) -> Bool = match input
    [] -> true
    [char | _] -> Std.Char.is_newline(char)

  fn position_subject_end(input: List(Char)) -> Bool = match input
    [] -> true
    [char] -> Std.Char.is_newline(char)
    _ -> false

  fn next_ascii_word(input: List(Char)) -> Bool = match input
    [] -> false
    [char | _] -> ascii_word(char)

  fn next_unicode_word(input: List(Char)) -> Bool = match input
    [] -> false
    [char | _] -> option_word(char, true)

  fn position_boundary(subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool, input: List(Char)) -> Boundary =
    Boundary(
      subject_start,
      position_subject_end(input),
      position_strict_subject_end(input),
      line_start,
      position_line_end(input),
      previous_ascii_word != next_ascii_word(input),
      previous_unicode_word != next_unicode_word(input)
    )

  fn position_strict_subject_end(input: List(Char)) -> Bool = match input
    [] -> true
    _ -> false

  fn machine_accepts_chars({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), current: List(MachineState(n))) -> Bool = match input
    [] -> machine_has_accept(current)
    [char | rest] ->
      machine_accepts_chars(next, rest, filter_boundary_states(machine_step(next, char, current), position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), rest)))

  fn pattern_accepts({shape: ShapeCode}, pattern: Pattern(shape), input: String) -> Bool =
    match compile_pattern(pattern)
      mk_pair(count, machine) ->
        let chars = Std.String.characters(input)
        match search_machine_acceptance(count, machine, subject_initial_position(), chars, [])
          MachineNoAcceptingPath() -> false
          MachineAcceptingPath(_, _, _) -> true

  ## Match positions are zero-based Unicode-scalar offsets, not UTF-8 byte
  ## offsets. `start` and `length` are native Int values so large subjects do
  ## not allocate unary Nat structures at runtime.
  type Match(result: Type) = Match(result, String, String, String, Int, Int)

  type SplitInclusion = ExcludeSeparators | IncludeSeparators
  type SplitTrimming = KeepEmptyParts | TrimEmptyParts
  type SplitLimit = UnlimitedSplit | AtMostSplitParts(Int)
  type SplitOptions = SplitOptions(SplitInclusion, SplitTrimming, SplitLimit)

  @reducible
  fn execute_instruction(instruction: EvidenceInstruction, evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match instruction
    EmitChar(char) -> EvidenceExecution([CharacterEvidence(char) | evidence], captures)
    EmitUnit() -> EvidenceExecution([UnitEvidence() | evidence], captures)
    EmitPair() -> EvidenceExecution([PairEvidence() | evidence], captures)
    EmitLeft() -> EvidenceExecution([LeftEvidence() | evidence], captures)
    EmitRight() -> EvidenceExecution([RightEvidence() | evidence], captures)
    BeginList() -> EvidenceExecution([BeginListEvidence() | evidence], captures)
    EndList() -> EvidenceExecution([EndListEvidence() | evidence], captures)
    BeginCapture() -> EvidenceExecution(evidence, [CaptureFrame([], evidence) | captures])
    EndCapture() -> match captures
      [] -> EvidenceExecution(evidence, [])
      [CaptureFrame(chars, saved) | rest] -> EvidenceExecution([StringEvidence(Std.String.from_characters(evidence_reverse_chars(chars))) | saved], rest)

  @reducible
  fn execute_routine(routine: List(EvidenceInstruction), evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match routine
    [] -> EvidenceExecution(evidence, captures)
    [instruction | rest] ->
      execute_routine(
        rest,
        executed_evidence(execute_instruction(instruction, evidence, captures)),
        executed_captures(execute_instruction(instruction, evidence, captures))
      )

  @reducible
  fn executed_evidence(execution: EvidenceExecution) -> List(Evidence) = match execution
    EvidenceExecution(evidence, _) -> evidence

  @reducible
  fn executed_captures(execution: EvidenceExecution) -> List(CaptureFrame) = match execution
    EvidenceExecution(_, captures) -> captures

  ## The generalized Thompson proof uses an NFA-independent stream. `Observe`
  ## advances capture input; `Regular` embeds the evidence VM language.
  type ExtendedInstruction = Regular(EvidenceInstruction) | Observe(Char)

  @reducible
  fn regular_routine(routine: List(EvidenceInstruction)) -> List(ExtendedInstruction) = match routine
    [] -> []
    [instruction | rest] -> [Regular(instruction) | regular_routine(rest)]

  type ExtendedEvidenceRoutineExecution indices (routine: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    ExtendedEvidenceDone : {input_evidence: List(Evidence)} -> {input_captures: List(CaptureFrame)} -> ExtendedEvidenceRoutineExecution(Nil(), input_evidence, input_captures, input_evidence, input_captures)
    ExtendedEvidenceObserve : (char: Char) -> {input_captures: List(CaptureFrame)} -> (suffix : ExtendedEvidenceRoutineExecution(rest, input_evidence, record_capture_char(input_captures, char), output_evidence, output_captures)) -> ExtendedEvidenceRoutineExecution(Cons(Observe(char), rest), input_evidence, input_captures, output_evidence, output_captures)
    ExtendedEvidenceRegular : (instruction: EvidenceInstruction) -> {input_evidence: List(Evidence)} -> {input_captures: List(CaptureFrame)} -> (suffix : ExtendedEvidenceRoutineExecution(rest, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), output_evidence, output_captures)) -> ExtendedEvidenceRoutineExecution(Cons(Regular(instruction), rest), input_evidence, input_captures, output_evidence, output_captures)

  type RoutineExecution indices (routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    RoutineDone : {evidence: List(Evidence)} -> {captures: List(CaptureFrame)} -> RoutineExecution(Nil(), evidence, captures, evidence, captures)
    RoutineStep : (instruction: EvidenceInstruction) -> {input_evidence: List(Evidence)} -> {input_captures: List(CaptureFrame)} -> (suffix : RoutineExecution(rest, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), output_evidence, output_captures)) -> RoutineExecution(Cons(instruction, rest), input_evidence, input_captures, output_evidence, output_captures)

  type CertifiedRoutineExecution indices (routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame))
    CertifiedRoutineExecuted : (output_evidence: List(Evidence)) -> (output_captures: List(CaptureFrame)) -> (certificate : RoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> (extended_certificate : ExtendedEvidenceRoutineExecution(regular_routine(routine), input_evidence, input_captures, output_evidence, output_captures)) -> CertifiedRoutineExecution(routine, input_evidence, input_captures)

  fn execute_routine_certified(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) -> CertifiedRoutineExecution(routine, input_evidence, input_captures) =
    match routine
      [] -> CertifiedRoutineExecuted(input_evidence, input_captures, RoutineDone(), ExtendedEvidenceDone())
      [instruction | rest] ->
        let instruction_execution = execute_instruction(instruction, input_evidence, input_captures)
        let next_evidence = executed_evidence(instruction_execution)
        let next_captures = executed_captures(instruction_execution)
        match execute_routine_certified(rest, next_evidence, next_captures)
          CertifiedRoutineExecuted(output_evidence, output_captures, suffix, extended_suffix) ->
            CertifiedRoutineExecuted(output_evidence, output_captures, RoutineStep(instruction, suffix), ExtendedEvidenceRegular(instruction, extended_suffix))

  ## Thompson's evidence proof reasons over one NFA-independent instruction
  ## stream. `Observe` records the consumed character (and advances open capture
  ## frames); `Regular` embeds the existing VM instruction language.
  type ExtendedExecution = ExtendedExecution(Option(Char), List(Evidence), List(CaptureFrame))

  @reducible
  fn transition_routine(char: Char, routine: List(EvidenceInstruction)) -> List(ExtendedInstruction) =
    [Observe(char) | regular_routine(routine)]

  @reducible
  fn append_extended_routines(left: List(ExtendedInstruction), right: List(ExtendedInstruction)) -> List(ExtendedInstruction) = match left
    [] -> right
    [instruction | rest] -> [instruction | append_extended_routines(rest, right)]

  fn execute_extended_instruction(instruction: ExtendedInstruction, current: Option(Char), evidence: List(Evidence), captures: List(CaptureFrame)) -> ExtendedExecution = match instruction
    Observe(char) -> ExtendedExecution(Some(char), evidence, record_capture_char(captures, char))
    Regular(regular) -> match execute_instruction(regular, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> ExtendedExecution(current, next_evidence, next_captures)

  fn execute_extended_routine(routine: List(ExtendedInstruction), current: Option(Char), evidence: List(Evidence), captures: List(CaptureFrame)) -> ExtendedExecution = match routine
    [] -> ExtendedExecution(current, evidence, captures)
    [instruction | rest] -> match execute_extended_instruction(instruction, current, evidence, captures)
      ExtendedExecution(next_current, next_evidence, next_captures) -> execute_extended_routine(rest, next_current, next_evidence, next_captures)

  fn extended_evidence(execution: ExtendedExecution) -> List(Evidence) = match execution
    ExtendedExecution(_, evidence, _) -> evidence

  fn extended_captures(execution: ExtendedExecution) -> List(CaptureFrame) = match execution
    ExtendedExecution(_, _, captures) -> captures

  fn extended_current(execution: ExtendedExecution) -> Option(Char) = match execution
    ExtendedExecution(current, _, _) -> current

  type ExtendedRoutineExecution indices (routine: List(ExtendedInstruction), input_current: Option(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_current: Option(Char), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    ExtendedRoutineExecuted : ExtendedRoutineExecution(routine, input_current, input_evidence, input_captures, extended_current(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_evidence(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_captures(execute_extended_routine(routine, input_current, input_evidence, input_captures)))

  fn certify_extended_routine(routine: List(ExtendedInstruction), input_current: Option(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) -> ExtendedRoutineExecution(routine, input_current, input_evidence, input_captures, extended_current(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_evidence(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_captures(execute_extended_routine(routine, input_current, input_evidence, input_captures))) = ExtendedRoutineExecuted()

  ## Evidence execution deliberately forgets `ExtendedExecution.current`.
  ## `Observe` still advances every open capture frame, while the current
  ## character is observational bookkeeping and cannot affect evidence.
  fn execute_extended_evidence_instruction(instruction: ExtendedInstruction, evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match instruction
    Observe(char) -> EvidenceExecution(evidence, record_capture_char(captures, char))
    Regular(regular) -> execute_instruction(regular, evidence, captures)

  fn execute_extended_evidence_routine(routine: List(ExtendedInstruction), evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match routine
    [] -> EvidenceExecution(evidence, captures)
    [instruction | rest] -> match execute_extended_evidence_instruction(instruction, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> execute_extended_evidence_routine(rest, next_evidence, next_captures)

  type CertifiedPathRoutine indices (routine: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence))
    PathRoutineDone : CertifiedPathRoutine(Nil(), evidence, captures, evidence)
    PathRoutineTransition : (char: Char) -> (regular: List(EvidenceInstruction)) -> (suffix_routine: List(ExtendedInstruction)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (regular_execution : ExtendedEvidenceRoutineExecution(regular_routine(regular), source_evidence, record_capture_char(source_captures, char), destination_evidence, destination_captures)) -> (suffix : CertifiedPathRoutine(suffix_routine, destination_evidence, destination_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(transition_routine(char, regular), suffix_routine), source_evidence, source_captures, final_evidence)
    PathRoutineInitial : (regular: List(EvidenceInstruction)) -> (suffix_routine: List(ExtendedInstruction)) -> (initial_evidence: List(Evidence)) -> (initial_captures: List(CaptureFrame)) -> (regular_execution : ExtendedEvidenceRoutineExecution(regular_routine(regular), Nil(), Nil(), initial_evidence, initial_captures)) -> (suffix : CertifiedPathRoutine(suffix_routine, initial_evidence, initial_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(regular_routine(regular), suffix_routine), Nil(), Nil(), final_evidence)

  fn initial_thread({n: Nat}, destination: MachineState(n)) -> EvidenceThread(n) = match destination
    Active(state, routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> EvidenceThread(ThreadActive(state), evidence, captures)
    Accepted(routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> EvidenceThread(ThreadAccepted(), evidence, captures)

  fn initial_threads({n: Nat}, starts: List(MachineState(n))) -> List(EvidenceThread(n)) = match starts
    [] -> []
    [head | rest] -> [initial_thread(head) | initial_threads(rest)]

  fn destination_thread({n: Nat}, destination: MachineState(n), evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceThread(n) = match destination
    Active(state, routine, _) -> match execute_routine(routine, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> EvidenceThread(ThreadActive(state), next_evidence, next_captures)
    Accepted(routine, _) -> match execute_routine(routine, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> EvidenceThread(ThreadAccepted(), next_evidence, next_captures)

  fn destination_threads({n: Nat}, destinations: List(MachineState(n)), evidence: List(Evidence), captures: List(CaptureFrame)) -> List(EvidenceThread(n)) = match destinations
    [] -> []
    [head | rest] -> [destination_thread(head, evidence, captures) | destination_threads(rest, evidence, captures)]

  fn step_evidence_thread({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, boundary: Boundary, thread: EvidenceThread(n)) -> List(EvidenceThread(n)) = match thread
    EvidenceThread(ThreadAccepted(), _, _) -> []
    EvidenceThread(ThreadActive(state), evidence, captures) ->
      destination_threads(filter_boundary_states(next(state, char), boundary), evidence, record_capture_char(captures, char))

  fn append_threads({n: Nat}, left: List(EvidenceThread(n)), right: List(EvidenceThread(n))) -> List(EvidenceThread(n)) = match left
    [] -> right
    [head | rest] -> [head | append_threads(rest, right)]

  fn step_evidence_threads({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, boundary: Boundary, threads: List(EvidenceThread(n))) -> List(EvidenceThread(n)) = match threads
    [] -> []
    [head | rest] -> append_threads(step_evidence_thread(next, char, boundary, head), step_evidence_threads(next, char, boundary, rest))

  fn transition_boundary(char: Char, rest: List(Char)) -> Boundary =
    position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), rest)

  @reducible
  fn append_characters(left: List(Char), right: List(Char)) -> List(Char) = match left
    [] -> right
    [head | rest] -> [head | append_characters(rest, right)]

  fn transition_boundary_before(char: Char, rest: List(Char), after_input: List(Char)) -> Boundary =
    transition_boundary(char, append_characters(rest, after_input))

  @reducible
  fn position_after_character(char: Char) -> InitialPosition =
    InitialPosition(False(), Std.Char.is_newline(char), ascii_word(char), option_word(char, True()))

  @reducible
  fn advance_initial_position(position: InitialPosition, input: List(Char)) -> InitialPosition = match input
    Nil() -> position
    Cons(char, rest) -> advance_initial_position(position_after_character(char), rest)

  fn initial_position_boundary(position: InitialPosition, input: List(Char)) -> Boundary = match position
    InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word) ->
      position_boundary(subject_start, line_start, previous_ascii_word, previous_unicode_word, input)

  fn subject_initial_position() -> InitialPosition = InitialPosition(true, true, false, false)

  @reducible
  fn machine_destinations(n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, boundary: Boundary) -> List(MachineState(n)) = match state
    ThreadAccepted() -> []
    ThreadActive(active) -> match machine
      MkPatternMachine(_, next) -> filter_boundary_states(next(active, char), boundary)

  ## Intrinsic list membership. The witness is erased at every accepting-run
  ## boundary; its only purpose is to make every path edge name a destination
  ## that the checked transition relation actually produced.
  type ListMember(a: Type) indices (value: a, values: List(a))
    ListMemberHere : ListMember(a, value, Cons(value, rest))
    ListMemberThere : (prior : ListMember(a, value, rest)) -> ListMember(a, value, Cons(other, rest))

  fn member_here({a: Type}, value: a, rest: List(a)) -> ListMember(a, value, Cons(value, rest)) = ListMemberHere()

  fn member_there({a: Type}, head: a, {value: a}, {rest: List(a)}, member: ListMember(a, value, rest)) -> ListMember(a, value, Cons(head, rest)) = ListMemberThere(member)

  ## A candidate list whose every element is paired with erased evidence that it
  ## belongs to the original transition result. State and proof are introduced by
  ## the same constructor, so dependent pattern refinement never has to relate two
  ## sibling scrutinees.
  type MachineStateMembers(n: Nat) indices (whole: List(MachineState(n)), remaining_values: List(MachineState(n)))
    MachineStateMembersNil : MachineStateMembers(n, whole, Nil())
    MachineStateMembersActive : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member : ListMember(MachineState(n), Active(state, routine, constraints), whole)) -> (remaining: MachineStateMembers(n, whole, values)) -> MachineStateMembers(n, whole, Cons(Active(state, routine, constraints), values))
    MachineStateMembersAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member : ListMember(MachineState(n), Accepted(routine, constraints), whole)) -> (remaining: MachineStateMembers(n, whole, values)) -> MachineStateMembers(n, whole, Cons(Accepted(routine, constraints), values))

  fn weaken_machine_state_members({n: Nat}, head: MachineState(n), {whole: List(MachineState(n))}, {values: List(MachineState(n))}, members: MachineStateMembers(n, whole, values)) -> MachineStateMembers(n, Cons(head, whole), values) = match members
    MachineStateMembersNil() -> MachineStateMembersNil()
    MachineStateMembersActive(state, routine, constraints, member, remaining) -> MachineStateMembersActive(state, routine, constraints, member_there(head, member), weaken_machine_state_members(head, remaining))
    MachineStateMembersAccepted(routine, constraints, member, remaining) -> MachineStateMembersAccepted(routine, constraints, member_there(head, member), weaken_machine_state_members(head, remaining))

  fn machine_state_members({n: Nat}, values: List(MachineState(n))) -> MachineStateMembers(n, values, values) = match values
    [] -> MachineStateMembersNil()
    [Active(state, routine, constraints) | rest] -> MachineStateMembersActive(state, routine, constraints, member_here(Active(state, routine, constraints), rest), weaken_machine_state_members(Active(state, routine, constraints), machine_state_members(rest)))
    [Accepted(routine, constraints) | rest] -> MachineStateMembersAccepted(routine, constraints, member_here(Accepted(routine, constraints), rest), weaken_machine_state_members(Accepted(routine, constraints), machine_state_members(rest)))

  ## A single winning NFA path through the evidence VM.  Both the starting
  ## thread and final evidence are indices: `AcceptingNow` can close only at an
  ## accepted thread carrying exactly that evidence, while `AcceptingNext` can
  ## advance only to a member of `step_evidence_thread`.  Consequently a path
  ## cannot invent a state, skip an input character, or claim evidence different
  ## from the VM thread it reaches.
  ##
  ## Boundary filtering is part of the indexed edge, including the exact suffix
  ## used by the runtime boundary calculation. This covers zero-width boundary
  ## constraints without adding an unchecked side condition to the theorem.
  ## One evidence-preserving transition. It separates machine reachability from
  ## routine execution: `edge` proves the destination came from the checked
  ## bounded transition relation, and `execution` proves that destination's
  ## routine produced exactly the evidence/capture state named by the result.
  type EvidenceStep(n: Nat, machine: PatternMachine(n)) indices (char: Char, boundary: Boundary, source_state: ThreadState(n), source_evidence: List(Evidence), source_captures: List(CaptureFrame), destination_state: ThreadState(n), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame))
    EvidenceStepActive : (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Active(destination, routine, constraints), machine_destinations(n, machine, source_state, char, boundary))) -> (execution : RoutineExecution(routine, source_evidence, record_capture_char(source_captures, char), result_evidence, result_captures)) -> EvidenceStep(n, machine, char, boundary, source_state, source_evidence, source_captures, ThreadActive(destination), result_evidence, result_captures)
    EvidenceStepAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Accepted(routine, constraints), machine_destinations(n, machine, source_state, char, boundary))) -> (execution : RoutineExecution(routine, source_evidence, record_capture_char(source_captures, char), result_evidence, result_captures)) -> EvidenceStep(n, machine, char, boundary, source_state, source_evidence, source_captures, ThreadAccepted(), result_evidence, result_captures)

  type AcceptingFrom(n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), extended_routine: List(ExtendedInstruction))
    AcceptingNow : AcceptingFrom(n, machine, Nil(), after_input, ThreadAccepted(), evidence, captures, evidence, Nil())
    AcceptingNextActive : (destination: Bounded(n)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge : ListMember(MachineState(n), Active(destination, regular, constraints), machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input)))) -> (execution : RoutineExecution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures)) -> (suffix : AcceptingFrom(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> AcceptingFrom(n, machine, Cons(char, rest), after_input, state, current_evidence, captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine))
    AcceptingNextAccepted : (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge : ListMember(MachineState(n), Accepted(regular, constraints), machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input)))) -> (execution : RoutineExecution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures)) -> (suffix : AcceptingFrom(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> AcceptingFrom(n, machine, Cons(char, rest), after_input, state, current_evidence, captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine))

  type AcceptingSearch(n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame))
    NoAcceptingPath : AcceptingSearch(n, machine, input, after_input, state, current_evidence, captures)
    AcceptingPath : (final_evidence: List(Evidence)) -> (extended_routine: List(ExtendedInstruction)) -> (routine_certificate : CertifiedPathRoutine(extended_routine, current_evidence, captures, final_evidence)) -> (@erased path : AcceptingFrom(n, machine, input, after_input, state, current_evidence, captures, final_evidence, extended_routine)) -> AcceptingSearch(n, machine, input, after_input, state, current_evidence, captures)

  fn prepend_transition_certificate(char: Char, routine: List(EvidenceInstruction), suffix_routine: List(ExtendedInstruction), source_evidence: List(Evidence), source_captures: List(CaptureFrame), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, regular_execution: ExtendedEvidenceRoutineExecution(regular_routine(routine), source_evidence, record_capture_char(source_captures, char), destination_evidence, destination_captures), suffix_certificate: CertifiedPathRoutine(suffix_routine, destination_evidence, destination_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(transition_routine(char, routine), suffix_routine), source_evidence, source_captures, final_evidence) =
    PathRoutineTransition(char, routine, suffix_routine, destination_evidence, destination_captures, regular_execution, suffix_certificate)

  fn search_accepting_from(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame)) -> AcceptingSearch(n, machine, input, after_input, state, current_evidence, captures) = match input
    [] -> match state
      ThreadAccepted() -> AcceptingPath(current_evidence, [], PathRoutineDone(), AcceptingNow())
      ThreadActive(_) -> NoAcceptingPath()
    [char | rest] ->
      let destinations = machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input))
      search_accepting_members(n, machine, char, rest, after_input, state, current_evidence, captures, machine_state_members(destinations))

  fn search_accepting_members(n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), source_evidence: List(Evidence), source_captures: List(CaptureFrame), {current: List(MachineState(n))}, members: MachineStateMembers(n, machine_destinations(n, machine, source_state, char, transition_boundary_before(char, rest, after_input)), current)) -> AcceptingSearch(n, machine, Cons(char, rest), after_input, source_state, source_evidence, source_captures) = match members
    MachineStateMembersNil() -> NoAcceptingPath()
    MachineStateMembersActive(state, routine, constraints, edge, remaining) -> match execute_routine_certified(routine, source_evidence, record_capture_char(source_captures, char))
      CertifiedRoutineExecuted(next_evidence, next_captures, execution, regular_execution) -> match search_accepting_from(n, machine, rest, after_input, ThreadActive(state), next_evidence, next_captures)
        NoAcceptingPath() -> search_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, remaining)
        AcceptingPath(final_evidence, suffix_routine, suffix_certificate, suffix) -> AcceptingPath(final_evidence, append_extended_routines(transition_routine(char, routine), suffix_routine), prepend_transition_certificate(char, routine, suffix_routine, source_evidence, source_captures, next_evidence, next_captures, regular_execution, suffix_certificate), AcceptingNextActive(state, routine, constraints, next_evidence, next_captures, suffix_routine, edge, execution, suffix))
    MachineStateMembersAccepted(routine, constraints, edge, remaining) -> match execute_routine_certified(routine, source_evidence, record_capture_char(source_captures, char))
      CertifiedRoutineExecuted(next_evidence, next_captures, execution, regular_execution) -> match search_accepting_from(n, machine, rest, after_input, ThreadAccepted(), next_evidence, next_captures)
        NoAcceptingPath() -> search_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, remaining)
        AcceptingPath(final_evidence, suffix_routine, suffix_certificate, suffix) -> AcceptingPath(final_evidence, append_extended_routines(transition_routine(char, routine), suffix_routine), prepend_transition_certificate(char, routine, suffix_routine, source_evidence, source_captures, next_evidence, next_captures, regular_execution, suffix_certificate), AcceptingNextAccepted(routine, constraints, next_evidence, next_captures, suffix_routine, edge, execution, suffix))

  @reducible
  fn initial_machine_destinations(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> filter_boundary_states(starts, initial_position_boundary(position, append_characters(input, after_input)))

  type InitialEvidenceStep(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), destination_state: ThreadState(n), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame))
    InitialEvidenceActive : (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Active(destination, routine, constraints), initial_machine_destinations(n, machine, position, input, after_input))) -> (execution : RoutineExecution(routine, Nil(), Nil(), result_evidence, result_captures)) -> InitialEvidenceStep(n, machine, position, input, after_input, ThreadActive(destination), result_evidence, result_captures)
    InitialEvidenceAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Accepted(routine, constraints), initial_machine_destinations(n, machine, position, input, after_input))) -> (execution : RoutineExecution(routine, Nil(), Nil(), result_evidence, result_captures)) -> InitialEvidenceStep(n, machine, position, input, after_input, ThreadAccepted(), result_evidence, result_captures)

  type MachineAcceptance(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence), extended_routine: List(ExtendedInstruction))
    MachineAccepted : (destination: MachineState(n)) -> (initial_evidence: List(Evidence)) -> (initial_captures: List(CaptureFrame)) -> (path_routine: List(ExtendedInstruction)) -> (edge : ListMember(MachineState(n), destination, initial_machine_destinations(n, machine, position, input, after_input))) -> (execution : RoutineExecution(machine_state_routine(n, destination), Nil(), Nil(), initial_evidence, initial_captures)) -> (routine_certificate : CertifiedPathRoutine(append_extended_routines(regular_routine(machine_state_routine(n, destination)), path_routine), Nil(), Nil(), final_evidence)) -> (path : AcceptingFrom(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> MachineAcceptance(n, machine, position, input, after_input, final_evidence, append_extended_routines(regular_routine(machine_state_routine(n, destination)), path_routine))

  type MachineAcceptingSearch(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char))
    MachineNoAcceptingPath : MachineAcceptingSearch(n, machine, position, input, after_input)
    MachineAcceptingPath : (final_evidence: List(Evidence)) -> (extended_routine: List(ExtendedInstruction)) -> (@erased acceptance : MachineAcceptance(n, machine, position, input, after_input, final_evidence, extended_routine)) -> MachineAcceptingSearch(n, machine, position, input, after_input)

  fn prepend_initial_certificate(routine: List(EvidenceInstruction), path_routine: List(ExtendedInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, regular_execution: ExtendedEvidenceRoutineExecution(regular_routine(routine), Nil(), Nil(), initial_evidence, initial_captures), path_certificate: CertifiedPathRoutine(path_routine, initial_evidence, initial_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(regular_routine(routine), path_routine), Nil(), Nil(), final_evidence) =
    PathRoutineInitial(routine, path_routine, initial_evidence, initial_captures, regular_execution, path_certificate)

  fn search_machine_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> MachineAcceptingSearch(n, machine, position, input, after_input) =
    let starts = initial_machine_destinations(n, machine, position, input, after_input)
    search_initial_members(n, machine, position, input, after_input, machine_state_members(starts))

  fn search_initial_members(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), {current: List(MachineState(n))}, members: MachineStateMembers(n, initial_machine_destinations(n, machine, position, input, after_input), current)) -> MachineAcceptingSearch(n, machine, position, input, after_input) = match members
    MachineStateMembersNil() -> MachineNoAcceptingPath()
    MachineStateMembersActive(state, routine, constraints, edge, remaining) -> match execute_routine_certified(routine, [], [])
      CertifiedRoutineExecuted(initial_evidence, initial_captures, execution, regular_execution) -> match search_accepting_from(n, machine, input, after_input, ThreadActive(state), initial_evidence, initial_captures)
        NoAcceptingPath() -> search_initial_members(n, machine, position, input, after_input, remaining)
        AcceptingPath(final_evidence, path_routine, path_certificate, path) ->
          let extended_routine = append_extended_routines(regular_routine(routine), path_routine)
          let routine_certificate = prepend_initial_certificate(routine, path_routine, initial_evidence, initial_captures, regular_execution, path_certificate)
          MachineAcceptingPath(final_evidence, extended_routine, MachineAccepted(Active(state, routine, constraints), initial_evidence, initial_captures, path_routine, edge, execution, routine_certificate, path))
    MachineStateMembersAccepted(routine, constraints, edge, remaining) -> match execute_routine_certified(routine, [], [])
      CertifiedRoutineExecuted(initial_evidence, initial_captures, execution, regular_execution) -> match search_accepting_from(n, machine, input, after_input, ThreadAccepted(), initial_evidence, initial_captures)
        NoAcceptingPath() -> search_initial_members(n, machine, position, input, after_input, remaining)
        AcceptingPath(final_evidence, path_routine, path_certificate, path) ->
          let extended_routine = append_extended_routines(regular_routine(routine), path_routine)
          let routine_certificate = prepend_initial_certificate(routine, path_routine, initial_evidence, initial_captures, regular_execution, path_certificate)
          MachineAcceptingPath(final_evidence, extended_routine, MachineAccepted(Accepted(routine, constraints), initial_evidence, initial_captures, path_routine, edge, execution, routine_certificate, path))

  type CertifiedPrefixSearch(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition)
    NoCertifiedPrefix : CertifiedPrefixSearch(n, machine, position)
    CertifiedPrefixPath : (matched_input: List(Char)) -> (remaining_input: List(Char)) -> (final_evidence: List(Evidence)) -> (extended_routine: List(ExtendedInstruction)) -> (@erased acceptance : MachineAcceptance(n, machine, position, matched_input, remaining_input, final_evidence, extended_routine)) -> CertifiedPrefixSearch(n, machine, position)

  fn search_first_machine_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> CertifiedPrefixSearch(n, machine, position) =
    search_first_machine_prefix_loop(n, machine, position, [], input)

  fn search_first_machine_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char)) -> CertifiedPrefixSearch(n, machine, position) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      MachineAcceptingPath(evidence, routine, acceptance) -> CertifiedPrefixPath(matched_input, remaining_input, evidence, routine, acceptance)
      MachineNoAcceptingPath() -> match remaining_input
        [] -> NoCertifiedPrefix()
        [char | rest] -> search_first_machine_prefix_loop(n, machine, position, [char | reversed_prefix], rest)

  fn search_last_machine_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> CertifiedPrefixSearch(n, machine, position) =
    search_last_machine_prefix_loop(n, machine, position, [], input, NoCertifiedPrefix())

  fn search_last_machine_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: CertifiedPrefixSearch(n, machine, position)) -> CertifiedPrefixSearch(n, machine, position) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      MachineNoAcceptingPath() -> continue_last_machine_prefix(n, machine, position, reversed_prefix, remaining_input, previous)
      MachineAcceptingPath(evidence, routine, acceptance) -> continue_last_machine_prefix(n, machine, position, reversed_prefix, remaining_input, CertifiedPrefixPath(matched_input, remaining_input, evidence, routine, acceptance))

  fn continue_last_machine_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: CertifiedPrefixSearch(n, machine, position)) -> CertifiedPrefixSearch(n, machine, position) = match remaining_input
    [] -> previous
    [char | rest] -> search_last_machine_prefix_loop(n, machine, position, [char | reversed_prefix], rest, previous)

  fn bounded_same({n: Nat}, left: Bounded(n), right: Bounded(n)) -> Bool = match left
    First() -> match right
      First() -> true
      Next(_) -> false
    Next(left_rest) -> match right
      First() -> false
      Next(right_rest) -> bounded_same(left_rest, right_rest)

  fn same_thread_state({n: Nat}, left: ThreadState(n), right: ThreadState(n)) -> Bool = match left
    ThreadAccepted() -> match right
      ThreadAccepted() -> true
      ThreadActive(_) -> false
    ThreadActive(left_state) -> match right
      ThreadAccepted() -> false
      ThreadActive(right_state) -> bounded_same(left_state, right_state)

  ## One winner slot per encountered intrinsic active state plus one accepted-state bit.
  ## Traversal is left-to-right, so setting a slot preserves the first (highest
  ## priority) thread and discards every later duplicate without rescanning the
  ## growing winner list. `Bounded(n)` structurally indexes the slot spine: no
  ## unchecked Nat conversion enters the machine and the erased bound need not
  ## be materialized at runtime.
  type ActiveWinnerSlots = NoWinnerSlots | ActiveWinnerSlot(Bool, ActiveWinnerSlots)
  type ThreadWinnerTable = ThreadWinnerTable(Bool, ActiveWinnerSlots)

  type DistinctThreadResult indices (n: Nat)
    DistinctThreadResult : ThreadWinnerTable -> List(EvidenceThread(n)) -> DistinctThreadResult(n)

  fn active_winner_seen({n: Nat}, slots: ActiveWinnerSlots, index: Bounded(n)) -> Bool = match index
    First() -> match slots
      NoWinnerSlots() -> false
      ActiveWinnerSlot(seen, _) -> seen
    Next(rest) -> match slots
      NoWinnerSlots() -> false
      ActiveWinnerSlot(_, tail) -> active_winner_seen(tail, rest)

  fn record_active_winner({n: Nat}, slots: ActiveWinnerSlots, index: Bounded(n)) -> ActiveWinnerSlots = match index
    First() -> match slots
      NoWinnerSlots() -> ActiveWinnerSlot(true, NoWinnerSlots())
      ActiveWinnerSlot(_, tail) -> ActiveWinnerSlot(true, tail)
    Next(rest) -> match slots
      NoWinnerSlots() -> ActiveWinnerSlot(false, record_active_winner(NoWinnerSlots(), rest))
      ActiveWinnerSlot(seen, tail) -> ActiveWinnerSlot(seen, record_active_winner(tail, rest))

  fn empty_thread_winners() -> ThreadWinnerTable = ThreadWinnerTable(false, NoWinnerSlots())

  fn thread_winner_seen({n: Nat}, table: ThreadWinnerTable, state: ThreadState(n)) -> Bool = match table
    ThreadWinnerTable(accepted, active) -> match state
      ThreadAccepted() -> accepted
      ThreadActive(index) -> active_winner_seen(active, index)

  fn record_thread_winner({n: Nat}, table: ThreadWinnerTable, state: ThreadState(n)) -> ThreadWinnerTable = match table
    ThreadWinnerTable(accepted, active) -> match state
      ThreadAccepted() -> ThreadWinnerTable(true, active)
      ThreadActive(index) -> ThreadWinnerTable(accepted, record_active_winner(active, index))

  fn distinct_threads({n: Nat}, threads: List(EvidenceThread(n))) -> List(EvidenceThread(n)) = match distinct_threads_with(threads, empty_thread_winners())
    DistinctThreadResult(_, winners) -> winners

  fn distinct_threads_with({n: Nat}, threads: List(EvidenceThread(n)), table: ThreadWinnerTable) -> DistinctThreadResult(n) = match threads
    [] -> DistinctThreadResult(table, [])
    [EvidenceThread(state, evidence, captures) | rest] -> pickup
      thread_winner_seen(table, state) -> distinct_threads_with(rest, table)
      else -> match distinct_threads_with(rest, record_thread_winner(table, state))
        DistinctThreadResult(final_table, winners) -> DistinctThreadResult(final_table, [EvidenceThread(state, evidence, captures) | winners])

  fn first_accepted_evidence({n: Nat}, threads: List(EvidenceThread(n))) -> Option(List(Evidence)) = match threads
    [] -> None()
    [EvidenceThread(ThreadAccepted(), evidence, _) | _] -> Some(evidence)
    [_ | rest] -> first_accepted_evidence(rest)

  fn run_evidence({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), threads: List(EvidenceThread(n))) -> Option(List(Evidence)) = match input
    [] -> first_accepted_evidence(threads)
    [char | rest] ->
      let boundary = position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), rest)
      run_evidence(next, rest, distinct_threads(step_evidence_threads(next, char, boundary, threads)))

  fn run_first_prefix_evidence({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), threads: List(EvidenceThread(n))) -> Option(EvidencePrefix) = match first_accepted_evidence(threads)
    Some(evidence) -> Some(EvidencePrefix(evidence, input))
    None() -> match input
      [] -> None()
      [char | rest] ->
        let boundary = position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), rest)
        run_first_prefix_evidence(next, rest, distinct_threads(step_evidence_threads(next, char, boundary, threads)))

  fn remember_prefix({n: Nat}, threads: List(EvidenceThread(n)), rest: List(Char), previous: Option(EvidencePrefix)) -> Option(EvidencePrefix) = match first_accepted_evidence(threads)
    Some(evidence) -> Some(EvidencePrefix(evidence, rest))
    None() -> previous

  fn run_last_prefix_evidence({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), threads: List(EvidenceThread(n)), previous: Option(EvidencePrefix)) -> Option(EvidencePrefix) =
    let remembered = remember_prefix(threads, input, previous)
    match input
      [] -> remembered
      [char | rest] -> match threads
        [] -> remembered
        _ ->
          let boundary = position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), rest)
          run_last_prefix_evidence(next, rest, distinct_threads(step_evidence_threads(next, char, boundary, threads)), remembered)

  fn pattern_evidence({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char)) -> Option(List(Evidence)) = match compile_pattern(pattern)
    mk_pair(count, machine) -> match search_machine_acceptance(count, machine, subject_initial_position(), input, [])
      MachineNoAcceptingPath() -> None()
      MachineAcceptingPath(evidence, _, _) -> Some(evidence)

  fn pattern_prefix_evidence_at({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char), greedy: Bool, subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool) -> Option(EvidencePrefix) = match compile_pattern(pattern)
    mk_pair(count, machine) ->
      let position = InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word)
      let result = pickup
        greedy -> search_last_machine_prefix(count, machine, position, input)
        else -> search_first_machine_prefix(count, machine, position, input)
      match result
        NoCertifiedPrefix() -> None()
        CertifiedPrefixPath(_, remaining, evidence, _, _) -> Some(EvidencePrefix(evidence, remaining))

  fn pattern_prefix_evidence({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char), greedy: Bool) -> Option(EvidencePrefix) =
    pattern_prefix_evidence_at(pattern, input, greedy, true, true, false, false)

  ## Public typed combinator layer. `Mapped` is the semantic bridge from a
  ## structurally extracted Pattern value to the user-facing result type. It is
  ## one-way: regex parsing does not imply an unparser.
  type OneOrMore(value: Type) = OneOrMore(value, List(value))

  type CharacterRange = CharacterRange(Char, Char)
  type ClassKinds = ClassKinds(Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool)
  type ClassKind = DigitKind | NotDigitKind | WordKind | NotWordKind | SpaceKind | NotSpaceKind | HorizontalKind | NotHorizontalKind | VerticalKind | NotVerticalKind

  type UnicodeProperty =
    | PropertyAny
    | PropertyLetter | PropertyLowercaseLetter | PropertyUppercaseLetter | PropertyTitlecaseLetter | PropertyModifierLetter | PropertyOtherLetter
    | PropertyMark | PropertySpacingMark | PropertyEnclosingMark | PropertyNonspacingMark
    | PropertyNumber | PropertyDecimalNumber | PropertyLetterNumber | PropertyOtherNumber
    | PropertyPunctuation | PropertyConnectorPunctuation | PropertyDashPunctuation | PropertyClosePunctuation | PropertyFinalPunctuation | PropertyInitialPunctuation | PropertyOtherPunctuation | PropertyOpenPunctuation
    | PropertySymbol | PropertyCurrencySymbol | PropertyModifierSymbol | PropertyMathSymbol | PropertyOtherSymbol
    | PropertySeparator | PropertyLineSeparator | PropertyParagraphSeparator | PropertySpaceSeparator
    | PropertyOther | PropertyControl | PropertyFormat | PropertyUnassigned | PropertyPrivateUse | PropertySurrogate

  type UnicodePropertyMatch = UnicodePropertyMatch(UnicodeProperty, Bool)

  type PosixClass =
    | PosixAlnum | PosixAlpha | PosixAscii | PosixBlank | PosixCntrl
    | PosixDigit | PosixGraph | PosixLower | PosixPrint | PosixPunct
    | PosixSpace | PosixUpper | PosixWord | PosixXdigit

  type PosixClassMatch = PosixClassMatch(PosixClass, Bool)

  fn no_class_kinds() -> ClassKinds =
    ClassKinds(false, false, false, false, false, false, false, false, false, false)

  fn enable_class_kind(kind: ClassKind, kinds: ClassKinds) -> ClassKinds = match kinds
    ClassKinds(d, nd, w, nw, s, ns, h, nh, v, nv) -> match kind
      DigitKind -> ClassKinds(true, nd, w, nw, s, ns, h, nh, v, nv)
      NotDigitKind -> ClassKinds(d, true, w, nw, s, ns, h, nh, v, nv)
      WordKind -> ClassKinds(d, nd, true, nw, s, ns, h, nh, v, nv)
      NotWordKind -> ClassKinds(d, nd, w, true, s, ns, h, nh, v, nv)
      SpaceKind -> ClassKinds(d, nd, w, nw, true, ns, h, nh, v, nv)
      NotSpaceKind -> ClassKinds(d, nd, w, nw, s, true, h, nh, v, nv)
      HorizontalKind -> ClassKinds(d, nd, w, nw, s, ns, true, nh, v, nv)
      NotHorizontalKind -> ClassKinds(d, nd, w, nw, s, ns, h, true, v, nv)
      VerticalKind -> ClassKinds(d, nd, w, nw, s, ns, h, nh, true, nv)
      NotVerticalKind -> ClassKinds(d, nd, w, nw, s, ns, h, nh, v, true)

  ## Elixir-compatible literal modifiers, in `i m s x u f U` order. Repeated
  ## letters are idempotent and modifier order is irrelevant. No accepted flag
  ## is metadata-only: each one must affect parsing or machine execution.
  type RegexOptions = RegexOptions(Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool)

  fn default_options() -> RegexOptions =
    RegexOptions(false, false, false, false, false, false, false, false)

  ## A staged literal carries its checked machine and the erased equality that
  ## relates that machine to the canonical Thompson construction.  The wrapper
  ## is indexed by the public shape (rather than by the dependent compilation
  ## itself) because that is the representation the constructor elaborator can
  ## refine without introducing an existential dependent constructor.
  type StagedMachine indices (shape: ShapeCode)
    StagedMachineValue : (compilation: ThompsonCompilation(shape)) -> (machine: PatternMachine(thompson_state_count(compilation))) -> (@erased equality: Equivalent(PatternMachine(thompson_state_count(compilation)), machine, thompson_machine(compilation))) -> StagedMachine(shape)

  type Regex indices (result: Type)
    FromPattern : (shape: ShapeCode) -> Pattern(shape) -> Regex(Sem(shape))
    ## A literal may publish its constructor-preserving Thompson IR directly.
    ## The proof layer certifies this IR structurally, so runtime compilation
    ## does not need to rediscover it from a Pattern value.
    StagedRegex : (shape: ShapeCode) -> Pattern(shape) -> ThompsonCompilation(shape) -> StagedMachine(shape) -> Conversion(Sem(shape), result) -> Regex(result)
    Mapped : (a -> b) -> Regex(a) -> Regex(b)
    Concatenated : Regex(a) -> Regex(b) -> Regex(Tuple(a, b))
    Alternated : Regex(a) -> Regex(b) -> Regex(Choice(a, b))
    Repeated : Regex(a) -> Regex(List(a))
    MatchedText : Regex(a) -> Regex(String)
    KeptRight : Regex(a) -> Regex(b) -> Regex(b)
    KeptLeft : Regex(a) -> Regex(b) -> Regex(a)
    SameAlternative : Regex(a) -> Regex(a) -> Regex(a)
    OptionalRegex : Regex(a) -> Regex(Option(a))
    OneOrMoreRegex : Regex(a) -> Regex(OneOrMore(a))
    SimplifiedRegex : (shape: ShapeCode) -> Regex(Sem(shape)) -> Regex(Sem(Simplify(shape)))
    OptionalPattern : Regex(a) -> Regex(Choice(a, Unit))
    PlusPattern : Regex(a) -> Regex(List(a))
    RepeatedPattern : Regex(a) -> Bool -> Regex(List(a))
    OneOrMorePattern : Regex(a) -> Bool -> Regex(List(a))
    OptionalLiteral : Regex(a) -> Bool -> Regex(Choice(a, Unit))
    ConfiguredRegex : RegexOptions -> Regex(a) -> Regex(a)
    StartAnchor : Bool -> Regex(Unit)
    EndAnchor : Bool -> Regex(Unit)
    StrictEndAnchor : Regex(Unit)

  type Conversion indices (raw: Type, result: Type)
    IdentityConversion : Conversion(value, value)
    ApplyConversion : (raw -> result) -> Conversion(raw, result)
    ComposedConversion : Conversion(raw, middle) -> Conversion(middle, result) -> Conversion(raw, result)
    PairConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Tuple(left_raw, right_raw), Tuple(left_result, right_result))
    ChoiceConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Choice(left_raw, right_raw), Choice(left_result, right_result))
    ListConversion : Conversion(raw, result) -> Conversion(List(raw), List(result))
    LeftPairConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Tuple(left_raw, right_raw), left_result)
    RightPairConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Tuple(left_raw, right_raw), right_result)
    SameChoiceConversion : Conversion(left_raw, result) -> Conversion(right_raw, result) -> Conversion(Choice(left_raw, right_raw), result)
    OptionalConversion : Conversion(raw, result) -> Conversion(Choice(raw, Unit), Option(result))
    OneOrMoreConversion : Conversion(raw, result) -> Conversion(Tuple(raw, List(raw)), OneOrMore(result))
    PrependConversion : Conversion(raw, result) -> Conversion(Tuple(raw, List(raw)), List(result))
    SimplifyConversion : (shape: ShapeCode) -> Conversion(Sem(shape), Sem(Simplify(shape)))

  type RegexProgram indices (result: Type)
    BuiltRegex : (shape: ShapeCode) -> Pattern(shape) -> Conversion(Sem(shape), result) -> CompilationHint(shape) -> RegexProgram(result)

  type CompilationHint indices (shape: ShapeCode)
    NoCompilationHint : CompilationHint(shape)
    StagedCompilationHint : StagedMachine(shape) -> CompilationHint(shape)

  ## `Option` is a `Type`-level family, so it cannot hold a `RegexProgram(result)`:
  ## a family INDEXED by `Type` lives one universe up (`level: 1`), exactly as an
  ## Agda `data … : Set → Set₁` does. Cure has no universe polymorphism, so the
  ## large case needs its own carrier rather than a `Type`-level `Option`.
  type CompiledRegex indices (result: Type)
    NoProgram : CompiledRegex(result)
    SomeProgram : RegexProgram(result) -> CompiledRegex(result)

  fn execute_left_choice_conversion({left_raw: Type}, {left_result: Type}, {right_raw: Type}, {right_result: Type}, left: Conversion(left_raw, left_result), _right: Conversion(right_raw, right_result), value: left_raw) -> Choice(left_result, right_result) =
    assert_type ChoseLeft(execute_conversion(left, value)) : Choice(left_result, right_result)

  fn execute_right_choice_conversion({left_raw: Type}, {left_result: Type}, {right_raw: Type}, {right_result: Type}, _left: Conversion(left_raw, left_result), right: Conversion(right_raw, right_result), value: right_raw) -> Choice(left_result, right_result) =
    assert_type ChoseRight(execute_conversion(right, value)) : Choice(left_result, right_result)

  fn execute_conversion({raw: Type}, {result: Type}, conversion: Conversion(raw, result), value: raw) -> result = match conversion
    IdentityConversion() -> value
    ApplyConversion(transform) -> transform(value)
    ComposedConversion(first, second) -> execute_conversion(second, execute_conversion(first, value))
    PairConversion(left, right) -> %[execute_conversion(left, value.1), execute_conversion(right, value.2)]
    ChoiceConversion(left, right) -> match value
      ChoseLeft(left_value) -> execute_left_choice_conversion(left, right, left_value)
      ChoseRight(right_value) -> execute_right_choice_conversion(left, right, right_value)
    ListConversion(inner) -> execute_list_conversion(inner, value)
    LeftPairConversion(left, _right) -> execute_conversion(left, value.1)
    RightPairConversion(_left, right) -> execute_conversion(right, value.2)
    SameChoiceConversion(left, right) -> match value
      ChoseLeft(left_value) -> execute_conversion(left, left_value)
      ChoseRight(right_value) -> execute_conversion(right, right_value)
    OptionalConversion(inner) -> match value
      ChoseLeft(inner_value) -> Some(execute_conversion(inner, inner_value))
      ChoseRight(_) -> None()
    OneOrMoreConversion(inner) -> OneOrMore(execute_conversion(inner, value.1), execute_list_conversion(inner, value.2))
    PrependConversion(inner) -> [execute_conversion(inner, value.1) | execute_list_conversion(inner, value.2)]
    SimplifyConversion(shape) -> simplify_value(shape, value)

  fn execute_list_conversion({raw: Type}, {result: Type}, conversion: Conversion(raw, result), values: List(raw)) -> List(result) = match values
    [] -> []
    [head | rest] -> [execute_conversion(conversion, head) | execute_list_conversion(conversion, rest)]

  ## Conversion values used by the literal emitter's staged IR. Keeping these
  ## small adapters here lets generated literals publish a first-order
  ## Thompson tree without rebuilding a Regex/Pattern wrapper at runtime.
  fn discard_char_conversion() -> Conversion(Char, Unit) = ApplyConversion(discard_char)

  fn empty_list_conversion({a: Type}) -> Conversion(Unit, List(a)) = ApplyConversion(fn(_) -> [])

  fn prepend_repetition_conversion({a: Type}) -> Conversion(Tuple(a, List(a)), List(a)) =
    ApplyConversion(prepend_repetition_result)

  fn prepend_optional_repetition_conversion({a: Type}) -> Conversion(Tuple(Choice(a, Unit), List(a)), List(a)) =
    ApplyConversion(prepend_optional_repetition_result)

  fn simplify_program(shape: ShapeCode, program: RegexProgram(Sem(shape))) -> RegexProgram(Sem(Simplify(shape))) = match program
    BuiltRegex(raw_shape, pattern, conversion, hint) ->
      BuiltRegex(raw_shape, pattern, ComposedConversion(conversion, SimplifyConversion(shape)), hint)

  fn simplify_compiled(shape: ShapeCode, program: CompiledRegex(Sem(shape))) -> CompiledRegex(Sem(Simplify(shape))) = match program
    NoProgram() -> NoProgram()
    SomeProgram(compiled) -> SomeProgram(simplify_program(shape, compiled))

  fn sem_identity_conversion(shape: ShapeCode) -> Conversion(Sem(shape), Sem(shape)) = IdentityConversion()
  fn string_identity_conversion() -> Conversion(String, String) = IdentityConversion()
  fn unit_identity_conversion() -> Conversion(Unit, Unit) = IdentityConversion()

  fn compile_regex({result: Type}, regex: Regex(result)) -> CompiledRegex(result) = match regex
    FromPattern(shape, pattern) -> SomeProgram(BuiltRegex(shape, pattern, sem_identity_conversion(shape), NoCompilationHint()))
    StagedRegex(shape, pattern, _compilation, machine, conversion) -> SomeProgram(BuiltRegex(shape, pattern, conversion, StagedCompilationHint(machine)))
    Mapped(transform, inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) -> SomeProgram(BuiltRegex(shape, pattern, ComposedConversion(convert, ApplyConversion(transform)), NoCompilationHint()))
    Concatenated(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(PairC(left_shape, right_shape), PatternConcat(left_pattern, right_pattern), PairConversion(left_convert, right_convert), NoCompilationHint()))
    Alternated(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(ChoiceC(left_shape, right_shape), PatternAlternate(left_pattern, right_pattern), ChoiceConversion(left_convert, right_convert), NoCompilationHint()))
    Repeated(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) -> SomeProgram(BuiltRegex(ListC(shape), PatternRepeat(pattern), ListConversion(convert), NoCompilationHint()))
    MatchedText(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(_shape, pattern, _convert, _hint)) -> SomeProgram(BuiltRegex(StringC, PatternGroup(pattern), string_identity_conversion(), NoCompilationHint()))
    KeptRight(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(PairC(left_shape, right_shape), PatternConcat(left_pattern, right_pattern), RightPairConversion(left_convert, right_convert), NoCompilationHint()))
    KeptLeft(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(PairC(left_shape, right_shape), PatternConcat(left_pattern, right_pattern), LeftPairConversion(left_convert, right_convert), NoCompilationHint()))
    SameAlternative(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(ChoiceC(left_shape, right_shape), PatternAlternate(left_pattern, right_pattern), SameChoiceConversion(left_convert, right_convert), NoCompilationHint()))
    OptionalRegex(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ChoiceC(shape, UnitC), PatternAlternate(pattern, PatternEmpty()), OptionalConversion(convert), NoCompilationHint()))
    OneOrMoreRegex(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(PairC(shape, ListC(shape)), PatternConcat(pattern, PatternRepeat(pattern)), OneOrMoreConversion(convert), NoCompilationHint()))
    SimplifiedRegex(shape, inner) -> simplify_compiled(shape, compile_regex(inner))
    OptionalPattern(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ChoiceC(shape, UnitC), PatternAlternate(pattern, PatternEmpty()), ChoiceConversion(convert, unit_identity_conversion()), NoCompilationHint()))
    PlusPattern(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(PairC(shape, ListC(shape)), PatternConcat(pattern, PatternRepeat(pattern)), PrependConversion(convert), NoCompilationHint()))
    RepeatedPattern(inner, lazy) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ListC(shape), PatternRepeatMode(pattern, lazy), ListConversion(convert), NoCompilationHint()))
    OneOrMorePattern(inner, lazy) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(PairC(shape, ListC(shape)), PatternConcat(pattern, PatternRepeatMode(pattern, lazy)), PrependConversion(convert), NoCompilationHint()))
    OptionalLiteral(inner, lazy) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ChoiceC(shape, UnitC), PatternAlternateMode(pattern, PatternEmpty(), lazy), ChoiceConversion(convert, unit_identity_conversion()), NoCompilationHint()))
    ConfiguredRegex(_options, inner) -> compile_regex(inner)
    StartAnchor(multiline) -> pickup
      multiline -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(line_start_constraint()), unit_identity_conversion(), NoCompilationHint()))
      else -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(subject_start_constraint()), unit_identity_conversion(), NoCompilationHint()))
    EndAnchor(multiline) -> pickup
      multiline -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(line_end_constraint()), unit_identity_conversion(), NoCompilationHint()))
      else -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(subject_end_constraint()), unit_identity_conversion(), NoCompilationHint()))
    StrictEndAnchor() -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(strict_end_constraint()), unit_identity_conversion(), NoCompilationHint()))

  fn empty() -> Regex(Unit) = FromPattern(UnitC, PatternEmpty())

  fn predicate(test: Char -> Bool) -> Regex(Char) =
    FromPattern(CharC, PatternPredicate(test))

  fn concatenate({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(Tuple(a, b)) =
    Concatenated(left, right)

  fn alternate({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(Choice(a, b)) =
    Alternated(left, right)

  fn repeat({a: Type}, regex: Regex(a)) -> Regex(List(a)) = Repeated(regex)

  fn map({a: Type}, {b: Type}, regex: Regex(a), transform: a -> b) -> Regex(b) =
    Mapped(transform, regex)

  fn discard_left({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(b) =
    KeptRight(left, right)

  fn discard_right({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(a) =
    KeptLeft(left, right)

  fn or_same({a: Type}, left: Regex(a), right: Regex(a)) -> Regex(a) =
    SameAlternative(left, right)

  fn optional({a: Type}, regex: Regex(a)) -> Regex(Option(a)) =
    OptionalRegex(regex)

  fn one_or_more({a: Type}, regex: Regex(a)) -> Regex(OneOrMore(a)) =
    OneOrMoreRegex(regex)

  fn captured({a: Type}, regex: Regex(a)) -> Regex(String) = MatchedText(regex)

  fn as_string({a: Type}, regex: Regex(a)) -> Regex(String) = MatchedText(regex)

  fn simplified(shape: ShapeCode, regex: Regex(Sem(shape))) -> Regex(Sem(Simplify(shape))) =
    SimplifiedRegex(shape, regex)

  fn optional_pattern({a: Type}, regex: Regex(a)) -> Regex(Choice(a, Unit)) = OptionalPattern(regex)

  fn plus_pattern({a: Type}, regex: Regex(a)) -> Regex(List(a)) = PlusPattern(regex)

  fn repeated_pattern({a: Type}, regex: Regex(a), lazy: Bool) -> Regex(List(a)) =
    RepeatedPattern(regex, lazy)

  fn one_or_more_pattern({a: Type}, regex: Regex(a), lazy: Bool) -> Regex(List(a)) =
    OneOrMorePattern(regex, lazy)

  fn optional_literal({a: Type}, regex: Regex(a), lazy: Bool) -> Regex(Choice(a, Unit)) =
    OptionalLiteral(regex, lazy)

  fn empty_repetition_transform({a: Type}, _: Regex(a)) -> (Unit -> List(a)) =
    fn(_) -> []

  fn prepend_repetition_result({a: Type}, value: Tuple(a, List(a))) -> List(a) = match value
    %[head, rest] -> [head | rest]

  fn prepend_optional_repetition_result({a: Type}, value: Tuple(Choice(a, Unit), List(a))) -> List(a) = match value
    %[choice, rest] -> match choice
      ChoseLeft(head) -> [head | rest]
      ChoseRight(_) -> rest

  fn bounded_exact_pattern({a: Type}, regex: Regex(a), count: Nat) -> Regex(List(a)) = match count
    Z() -> Mapped(empty_repetition_transform(regex), FromPattern(UnitC, PatternEmpty()))
    S(rest) -> Mapped(prepend_repetition_result, Concatenated(regex, bounded_exact_pattern(regex, rest)))

  fn bounded_at_least_pattern({a: Type}, regex: Regex(a), minimum: Nat, lazy: Bool) -> Regex(List(a)) = match minimum
    Z() -> repeated_pattern(regex, lazy)
    S(rest) -> Mapped(prepend_repetition_result, Concatenated(regex, bounded_at_least_pattern(regex, rest, lazy)))

  fn bounded_up_to_pattern({a: Type}, regex: Regex(a), maximum: Nat, lazy: Bool) -> Regex(List(a)) = match maximum
    Z() -> Mapped(empty_repetition_transform(regex), FromPattern(UnitC, PatternEmpty()))
    S(rest) -> Mapped(prepend_optional_repetition_result, Concatenated(optional_literal(regex, lazy), bounded_up_to_pattern(regex, rest, lazy)))

  fn bounded_between_pattern({a: Type}, regex: Regex(a), minimum: Nat, maximum: Nat, lazy: Bool) -> Regex(List(a)) = match minimum
    Z() -> bounded_up_to_pattern(regex, maximum, lazy)
    S(minimum_rest) -> match maximum
      Z() -> bounded_exact_pattern(regex, S(minimum_rest))
      S(maximum_rest) -> Mapped(prepend_repetition_result, Concatenated(regex, bounded_between_pattern(regex, minimum_rest, maximum_rest, lazy)))

  fn configured({a: Type}, options: RegexOptions, regex: Regex(a)) -> Regex(a) =
    ConfiguredRegex(options, regex)

  fn start_anchor() -> Regex(Unit) = StartAnchor(false)

  fn start_anchor_with_options(multiline: Bool) -> Regex(Unit) = StartAnchor(multiline)

  fn end_anchor() -> Regex(Unit) = EndAnchor(false)

  fn end_anchor_with_options(multiline: Bool) -> Regex(Unit) = EndAnchor(multiline)

  fn strict_end_anchor() -> Regex(Unit) = StrictEndAnchor()

  fn word_boundary(unicode: Bool, negated: Bool) -> Regex(Unit) = pickup
    unicode -> pickup
      negated -> FromPattern(UnitC, PatternBoundary(unicode_word_constraint(false)))
      else -> FromPattern(UnitC, PatternBoundary(unicode_word_constraint(true)))
    else -> pickup
      negated -> FromPattern(UnitC, PatternBoundary(ascii_word_constraint(false)))
      else -> FromPattern(UnitC, PatternBoundary(ascii_word_constraint(true)))

  fn always(_char: Char) -> Bool = true

  fn any_char() -> Regex(Char) = predicate(always)

  fn exact_predicate(expected: Char, actual: Char) -> Bool = Std.Char.same(expected, actual)

  fn exact_test(expected: Char) -> Char -> Bool = fn(actual) -> exact_predicate(expected, actual)

  fn discard_char(_char: Char) -> Unit = ()

  fn exactly(expected: Char) -> Regex(Unit) = map(predicate(exact_test(expected)), discard_char)

  fn same_chars(left: List(Char), right: List(Char)) -> Bool = match left
    [] -> match right
      [] -> true
      _ -> false
    [left_char | left_rest] -> match right
      [] -> false
      [right_char | right_rest] -> pickup
        Std.Char.same(left_char, right_char) -> same_chars(left_rest, right_rest)
        else -> false

  fn lowercased_characters(value: Char) -> List(Char) =
    Std.String.characters(Std.Char.lowercased(value))

  fn caseless_same(expected: Char, actual: Char, unicode: Bool) -> Bool = pickup
    unicode -> same_chars(lowercased_characters(expected), lowercased_characters(actual))
    else -> Std.Char.same(Std.Char.ascii_lowercased(expected), Std.Char.ascii_lowercased(actual))

  fn option_exact_predicate(expected: Char, caseless: Bool, unicode: Bool, actual: Char) -> Bool = pickup
    caseless -> caseless_same(expected, actual, unicode)
    else -> Std.Char.same(expected, actual)

  fn option_exact_test(expected: Char, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> option_exact_predicate(expected, caseless, unicode, actual)

  fn exactly_with_options(expected: Char, caseless: Bool, unicode: Bool) -> Regex(Unit) =
    map(predicate(option_exact_test(expected, caseless, unicode)), discard_char)

  fn dot_predicate(dotall: Bool, char: Char) -> Bool = pickup
    dotall -> true
    Std.Char.is_newline(char) -> false
    else -> true

  fn dot_test(dotall: Bool) -> Char -> Bool = fn(char) -> dot_predicate(dotall, char)
  fn dot_with_options(dotall: Bool) -> Regex(Char) = predicate(dot_test(dotall))

  fn contains_char(chars: List(Char), actual: Char) -> Bool = match chars
    [] -> false
    [head | rest] -> pickup
      Std.Char.same(head, actual) -> true
      else -> contains_char(rest, actual)

  fn contains_char_with_options(chars: List(Char), actual: Char, caseless: Bool, unicode: Bool) -> Bool = match chars
    [] -> false
    [head | rest] -> pickup
      caseless and caseless_same(head, actual, unicode) -> true
      Std.Char.same(head, actual) -> true
      else -> contains_char_with_options(rest, actual, caseless, unicode)

  fn set_test(chars: List(Char)) -> Char -> Bool = fn(actual) -> contains_char(chars, actual)

  fn one_of(chars: List(Char)) -> Regex(Char) = predicate(set_test(chars))

  fn range_predicate(first: Char, last: Char, actual: Char) -> Bool =
    Std.Char.between(actual, first, last)

  fn range_test(first: Char, last: Char) -> Char -> Bool =
    fn(actual) -> range_predicate(first, last, actual)

  fn range(first: Char, last: Char) -> Regex(Char) = predicate(range_test(first, last))

  fn in_ranges(ranges: List(CharacterRange), actual: Char) -> Bool = match ranges
    [] -> false
    [CharacterRange(first, last) | rest] -> pickup
      Std.Char.between(actual, first, last) -> true
      else -> in_ranges(rest, actual)

  fn folded_range_match(first: Char, last: Char, actual: Char, unicode: Bool) -> Bool = pickup
    Std.Char.between(actual, first, last) -> true
    unicode -> match Std.String.characters(Std.Char.lowercased(actual))
      [folded] -> Std.Char.between(folded, first, last)
      _ -> false
    else -> Std.Char.between(Std.Char.ascii_lowercased(actual), Std.Char.ascii_lowercased(first), Std.Char.ascii_lowercased(last))

  fn in_ranges_with_options(ranges: List(CharacterRange), actual: Char, caseless: Bool, unicode: Bool) -> Bool = match ranges
    [] -> false
    [CharacterRange(first, last) | rest] -> pickup
      caseless and folded_range_match(first, last, actual, unicode) -> true
      Std.Char.between(actual, first, last) -> true
      else -> in_ranges_with_options(rest, actual, caseless, unicode)

  fn class_predicate(chars: List(Char), ranges: List(CharacterRange), negated: Bool, actual: Char) -> Bool =
    let found = contains_char(chars, actual) or in_ranges(ranges, actual)
    pickup
      found == negated -> false
      else -> true

  fn class_test(chars: List(Char), ranges: List(CharacterRange), negated: Bool) -> Char -> Bool =
    fn(actual) -> class_predicate(chars, ranges, negated, actual)

  fn character_class(chars: List(Char), ranges: List(CharacterRange), negated: Bool) -> Regex(Char) =
    predicate(class_test(chars, ranges, negated))

  fn option_class_predicate(chars: List(Char), ranges: List(CharacterRange), negated: Bool, caseless: Bool, unicode: Bool, actual: Char) -> Bool =
    let found = contains_char_with_options(chars, actual, caseless, unicode) or in_ranges_with_options(ranges, actual, caseless, unicode)
    pickup
      found == negated -> false
      else -> true

  fn option_class_test(chars: List(Char), ranges: List(CharacterRange), negated: Bool, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> option_class_predicate(chars, ranges, negated, caseless, unicode, actual)

  fn character_class_with_options(chars: List(Char), ranges: List(CharacterRange), negated: Bool, caseless: Bool, unicode: Bool) -> Regex(Char) =
    predicate(option_class_test(chars, ranges, negated, caseless, unicode))

  fn class_kinds_match(kinds: ClassKinds, actual: Char, unicode: Bool) -> Bool = match kinds
    ClassKinds(digit, not_digit, word, not_word, space, not_space, horizontal, not_horizontal, vertical, not_vertical) ->
      (digit and option_digit(actual, unicode)) or
        (not_digit and not option_digit(actual, unicode)) or
        (word and option_word(actual, unicode)) or
        (not_word and not option_word(actual, unicode)) or
        (space and option_space(actual, unicode)) or
        (not_space and not option_space(actual, unicode)) or
        (horizontal and Std.Char.is_horizontal_space(actual)) or
        (not_horizontal and not Std.Char.is_horizontal_space(actual)) or
        (vertical and Std.Char.is_vertical_space(actual)) or
        (not_vertical and not Std.Char.is_vertical_space(actual))

  fn unicode_category_in(category: Atom, values: List(Atom)) -> Bool = match values
    [] -> false
    [head | rest] -> pickup
      category == head -> true
      else -> unicode_category_in(category, rest)

  fn unicode_property_matches(property: UnicodeProperty, actual: Char) -> Bool =
    let category = Std.Char.unicode_category(actual)
    match property
      PropertyAny -> true
      PropertyLetter -> unicode_category_in(category, [:Lu, :Ll, :Lt, :Lm, :Lo])
      PropertyLowercaseLetter -> category == :Ll
      PropertyUppercaseLetter -> category == :Lu
      PropertyTitlecaseLetter -> category == :Lt
      PropertyModifierLetter -> category == :Lm
      PropertyOtherLetter -> category == :Lo
      PropertyMark -> unicode_category_in(category, [:Mc, :Me, :Mn])
      PropertySpacingMark -> category == :Mc
      PropertyEnclosingMark -> category == :Me
      PropertyNonspacingMark -> category == :Mn
      PropertyNumber -> unicode_category_in(category, [:Nd, :Nl, :No])
      PropertyDecimalNumber -> category == :Nd
      PropertyLetterNumber -> category == :Nl
      PropertyOtherNumber -> category == :No
      PropertyPunctuation -> unicode_category_in(category, [:Pc, :Pd, :Pe, :Pf, :Pi, :Po, :Ps])
      PropertyConnectorPunctuation -> category == :Pc
      PropertyDashPunctuation -> category == :Pd
      PropertyClosePunctuation -> category == :Pe
      PropertyFinalPunctuation -> category == :Pf
      PropertyInitialPunctuation -> category == :Pi
      PropertyOtherPunctuation -> category == :Po
      PropertyOpenPunctuation -> category == :Ps
      PropertySymbol -> unicode_category_in(category, [:Sc, :Sk, :Sm, :So])
      PropertyCurrencySymbol -> category == :Sc
      PropertyModifierSymbol -> category == :Sk
      PropertyMathSymbol -> category == :Sm
      PropertyOtherSymbol -> category == :So
      PropertySeparator -> unicode_category_in(category, [:Zl, :Zp, :Zs])
      PropertyLineSeparator -> category == :Zl
      PropertyParagraphSeparator -> category == :Zp
      PropertySpaceSeparator -> category == :Zs
      PropertyOther -> unicode_category_in(category, [:Cc, :Cf, :Cn, :Co, :Cs])
      PropertyControl -> category == :Cc
      PropertyFormat -> category == :Cf
      PropertyUnassigned -> category == :Cn
      PropertyPrivateUse -> category == :Co
      PropertySurrogate -> category == :Cs

  fn unicode_property_match_matches(value: UnicodePropertyMatch, actual: Char) -> Bool = match value
    UnicodePropertyMatch(property, negated) -> unicode_property_matches(property, actual) != negated

  fn unicode_property_matches_any(values: List(UnicodePropertyMatch), actual: Char) -> Bool = match values
    [] -> false
    [head | rest] -> pickup
      unicode_property_match_matches(head, actual) -> true
      else -> unicode_property_matches_any(rest, actual)

  fn ascii_alpha(actual: Char) -> Bool =
    Std.Char.between(actual, 'a', 'z') or Std.Char.between(actual, 'A', 'Z')

  fn ascii_alnum(actual: Char) -> Bool =
    ascii_alpha(actual) or ascii_digit(actual)

  fn ascii_blank(actual: Char) -> Bool =
    Std.Char.same(actual, ' ') or Std.Char.same(actual, '\t')

  fn ascii_control(actual: Char) -> Bool =
    Std.Char.is_ascii(actual) and Std.Char.unicode_category(actual) == :Cc

  fn ascii_graph(actual: Char) -> Bool =
    Std.Char.between(actual, '!', '~')

  fn ascii_print(actual: Char) -> Bool =
    Std.Char.between(actual, ' ', '~')

  fn ascii_punct(actual: Char) -> Bool =
    ascii_graph(actual) and not ascii_alnum(actual)

  fn unicode_alpha(actual: Char) -> Bool =
    unicode_property_matches(PropertyLetter, actual) or unicode_property_matches(PropertyMark, actual)

  fn unicode_alnum(actual: Char) -> Bool =
    unicode_alpha(actual) or unicode_property_matches(PropertyNumber, actual)

  fn unicode_graph(actual: Char) -> Bool =
    unicode_alnum(actual) or unicode_property_matches(PropertyPunctuation, actual) or unicode_property_matches(PropertySymbol, actual)

  fn unicode_print(actual: Char) -> Bool =
    unicode_graph(actual) or unicode_property_matches(PropertySpaceSeparator, actual)

  fn posix_class_matches(posix_class: PosixClass, actual: Char, unicode: Bool) -> Bool = match posix_class
    PosixAlnum -> pickup
      unicode -> unicode_alnum(actual)
      else -> ascii_alnum(actual)
    PosixAlpha -> pickup
      unicode -> unicode_alpha(actual)
      else -> ascii_alpha(actual)
    PosixAscii -> Std.Char.is_ascii(actual)
    PosixBlank -> pickup
      unicode -> Std.Char.is_horizontal_space(actual)
      else -> ascii_blank(actual)
    PosixCntrl -> pickup
      unicode -> Std.Char.unicode_category(actual) == :Cc
      else -> ascii_control(actual)
    PosixDigit -> option_digit(actual, unicode)
    PosixGraph -> pickup
      unicode -> unicode_graph(actual)
      else -> ascii_graph(actual)
    PosixLower -> pickup
      unicode -> Std.Char.is_lowercase(actual)
      else -> Std.Char.between(actual, 'a', 'z')
    PosixPrint -> pickup
      unicode -> unicode_print(actual)
      else -> ascii_print(actual)
    PosixPunct -> pickup
      unicode -> unicode_property_matches(PropertyPunctuation, actual)
      else -> ascii_punct(actual)
    PosixSpace -> option_space(actual, unicode)
    PosixUpper -> pickup
      unicode -> Std.Char.is_uppercase(actual)
      else -> Std.Char.between(actual, 'A', 'Z')
    PosixWord -> option_word(actual, unicode)
    PosixXdigit -> pickup
      unicode -> Std.Char.is_hex_digit(actual)
      else -> ascii_digit(actual) or Std.Char.between(actual, 'a', 'f') or Std.Char.between(actual, 'A', 'F')

  fn posix_class_match_matches(value: PosixClassMatch, actual: Char, unicode: Bool) -> Bool = match value
    PosixClassMatch(posix_class, negated) -> posix_class_matches(posix_class, actual, unicode) != negated

  fn posix_class_matches_any(values: List(PosixClassMatch), actual: Char, unicode: Bool) -> Bool = match values
    [] -> false
    [head | rest] -> pickup
      posix_class_match_matches(head, actual, unicode) -> true
      else -> posix_class_matches_any(rest, actual, unicode)

  fn unicode_property_test(property: UnicodeProperty, negated: Bool) -> Char -> Bool =
    fn(actual) -> unicode_property_matches(property, actual) != negated

  fn unicode_property_class(property: UnicodeProperty, negated: Bool) -> Regex(Char) =
    predicate(unicode_property_test(property, negated))

  fn extended_class_predicate(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, negated: Bool, caseless: Bool, unicode: Bool, actual: Char) -> Bool =
    let found =
      contains_char_with_options(chars, actual, caseless, unicode) or
        in_ranges_with_options(ranges, actual, caseless, unicode) or
        class_kinds_match(kinds, actual, unicode)
    found != negated

  fn extended_class_test(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, negated: Bool, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> extended_class_predicate(chars, ranges, kinds, negated, caseless, unicode, actual)

  fn extended_character_class(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, negated: Bool, caseless: Bool, unicode: Bool) -> Regex(Char) =
    predicate(extended_class_test(chars, ranges, kinds, negated, caseless, unicode))

  fn extended_property_class_predicate(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, properties: List(UnicodePropertyMatch), posix: List(PosixClassMatch), negated: Bool, caseless: Bool, unicode: Bool, actual: Char) -> Bool =
    let found =
      contains_char_with_options(chars, actual, caseless, unicode) or
        in_ranges_with_options(ranges, actual, caseless, unicode) or
        class_kinds_match(kinds, actual, unicode) or
        unicode_property_matches_any(properties, actual) or
        posix_class_matches_any(posix, actual, unicode)
    found != negated

  fn extended_property_class_test(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, properties: List(UnicodePropertyMatch), posix: List(PosixClassMatch), negated: Bool, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> extended_property_class_predicate(chars, ranges, kinds, properties, posix, negated, caseless, unicode, actual)

  fn extended_unicode_property_class(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, properties: List(UnicodePropertyMatch), posix: List(PosixClassMatch), negated: Bool, caseless: Bool, unicode: Bool) -> Regex(Char) =
    predicate(extended_property_class_test(chars, ranges, kinds, properties, posix, negated, caseless, unicode))

  fn ascii_digit(char: Char) -> Bool = Std.Char.between(char, '0', '9')

  fn ascii_word(char: Char) -> Bool =
    Std.Char.between(char, 'a', 'z') or
      Std.Char.between(char, 'A', 'Z') or
      Std.Char.between(char, '0', '9') or
      Std.Char.same(char, '_')

  fn ascii_space(char: Char) -> Bool =
    Std.Char.same(char, ' ') or Std.Char.same(char, '\t') or
      Std.Char.same(char, '\n') or Std.Char.same(char, '\r') or
      Std.Char.same(char, '\f') or Std.Char.same(char, '\v')

  fn negate_test(test: Char -> Bool) -> Char -> Bool = fn(char) -> not test(char)

  fn digit_class(negated: Bool) -> Regex(Char) = pickup
    negated -> predicate(negate_test(ascii_digit))
    else -> predicate(ascii_digit)

  fn option_digit(char: Char, unicode: Bool) -> Bool = pickup
    unicode -> Std.Char.is_unicode_digit(char)
    else -> ascii_digit(char)

  fn option_word(char: Char, unicode: Bool) -> Bool = pickup
    unicode -> Std.Char.is_unicode_word(char)
    else -> ascii_word(char)

  fn option_space(char: Char, unicode: Bool) -> Bool = pickup
    unicode -> Std.Char.is_unicode_space(char)
    else -> ascii_space(char)

  fn option_class_negated(test: Char -> Bool, negated: Bool, char: Char) -> Bool = pickup
    negated -> not test(char)
    else -> test(char)

  fn digit_option_predicate(negated: Bool, unicode: Bool, char: Char) -> Bool = pickup
    negated -> not option_digit(char, unicode)
    else -> option_digit(char, unicode)

  fn word_option_predicate(negated: Bool, unicode: Bool, char: Char) -> Bool = pickup
    negated -> not option_word(char, unicode)
    else -> option_word(char, unicode)

  fn space_option_predicate(negated: Bool, unicode: Bool, char: Char) -> Bool = pickup
    negated -> not option_space(char, unicode)
    else -> option_space(char, unicode)

  fn digit_options_test(negated: Bool, unicode: Bool) -> Char -> Bool = fn(char) -> digit_option_predicate(negated, unicode, char)
  fn word_options_test(negated: Bool, unicode: Bool) -> Char -> Bool = fn(char) -> word_option_predicate(negated, unicode, char)
  fn space_options_test(negated: Bool, unicode: Bool) -> Char -> Bool = fn(char) -> space_option_predicate(negated, unicode, char)

  fn digit_class_with_options(negated: Bool, unicode: Bool) -> Regex(Char) = predicate(digit_options_test(negated, unicode))
  fn word_class_with_options(negated: Bool, unicode: Bool) -> Regex(Char) = predicate(word_options_test(negated, unicode))
  fn space_class_with_options(negated: Bool, unicode: Bool) -> Regex(Char) = predicate(space_options_test(negated, unicode))

  fn horizontal_predicate(negated: Bool, char: Char) -> Bool = pickup
    negated -> not Std.Char.is_horizontal_space(char)
    else -> Std.Char.is_horizontal_space(char)

  fn vertical_predicate(negated: Bool, char: Char) -> Bool = pickup
    negated -> not Std.Char.is_vertical_space(char)
    else -> Std.Char.is_vertical_space(char)

  fn horizontal_test(negated: Bool) -> Char -> Bool = fn(char) -> horizontal_predicate(negated, char)
  fn vertical_test(negated: Bool) -> Char -> Bool = fn(char) -> vertical_predicate(negated, char)
  fn horizontal_class(negated: Bool) -> Regex(Char) = predicate(horizontal_test(negated))
  fn vertical_class(negated: Bool) -> Regex(Char) = predicate(vertical_test(negated))

  fn word_class(negated: Bool) -> Regex(Char) = pickup
    negated -> predicate(negate_test(ascii_word))
    else -> predicate(ascii_word)

  fn space_class(negated: Bool) -> Regex(Char) = pickup
    negated -> predicate(negate_test(ascii_space))
    else -> predicate(ascii_space)
