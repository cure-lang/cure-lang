  fn lookaround_accepting_step_accepted(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Accepted(routine, constraints), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), {values: List(MachineState(n))}, members: MachineStateMembers(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Accepted(routine, constraints), values)), cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Accepted(routine, constraints), values)), child_cursor_suffix: MachineStateCursorSuffix(n, empty_machine_states(n), empty_machine_states(n)), suffix: LookaroundAcceptingPath(depth, n, machine, append_routine(capture_context, routine), empty_machine_states(n), rest, after_input, ThreadAccepted(), history_push_bounded(history, char), policy)) -> LookaroundAcceptingPath(depth, n, machine, capture_context, Cons(Accepted(routine, constraints), values), Cons(char, rest), after_input, ThreadActive(source), history, policy) = assert_type LookaroundAcceptedNextAccepted(source, char, rest, routine, constraints, lookaround_nested_decisions(depth, constraints, lookaround_transition_boundary(char, rest, after_input, policy), append_characters(rest, after_input), history, capture_context, policy), members, cursor, reflexive(Cons(Accepted(routine, constraints), values)), machine_state_members_accepted_current_edge(routine, constraints, members), child_cursor_suffix, suffix) : LookaroundAcceptingPath(depth, n, machine, capture_context, Cons(Accepted(routine, co