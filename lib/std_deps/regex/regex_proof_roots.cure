    CapturedAlternateLeftAcceptance : (child_final_evidence: List(Evidence)) -> (child_acceptance: AcceptancePathFrom(left_count, left_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence)) -> (final_is_marked: Equivalent(List(Evidence), final_evidence, Cons(LeftEvidence(), child_final_evidence))) -> (captures_exact: Equivalent(List(CaptureFrame), acceptance_path_final_captures(left_count, left_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance), combined_final_captures)) -> AlternateLeftCapturedAcceptance(left_count, left_machine, position, input, after_input, input_evidence, input_captures, final_evidence, combined_final_captures)

  type AlternateRightCapturedAcceptance(right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence), combined_final_captures: List(CaptureFrame))
    CapturedAlternateRightAcceptance : (child_final_evidence: List(Evidence)) -> (child_acceptance: AcceptancePathFrom(right_count, right_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence)) -> (final_is_marked: Equivalent(List(Evidence), final_evidence, Cons(RightEvidence(), child_final_evidence))) -> (captures_exact: Equivalent(List(CaptureFrame), acceptance_path_final_captures(right_count, right_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance), combined_final_captures)) -> AlternateRightCapturedAcceptance(right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence, combined_final_captures)

  type AlternateLeftExecutedAcceptanceProjection(left_count: Nat, left_machine: PatternMachine(left_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence))
    ProjectedAlternateLeftExecutedAcceptance : (child_final_evidence: List(Evidence)) -> (child_final_captures: List(CaptureFrame)) -> (child_acceptance: AcceptancePathFrom(left_count, left_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence)) -> (child_execution: ExtendedEvidenceRoutineExecution(acceptance_extended_routine(left_count, left_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance), input_evidence, input_captures, child_final_evidence, child_final_captures)) -> (final_is_marked: Equivalent(List(Evidence), final_evidence, Cons(LeftEvidence(), child_final_evidence))) -> AlternateLeftExecutedAcceptanceProjection(left_count, left_machine, position, input, after_input, input_evidence, input_captures, final_evidence)

  typealias AlternateLeftAcceptanceProjection(left_count: Nat, left_machine: PatternMachine(left_count), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = AlternateLeftAcceptanceFromProjection(left_count, left_machine, position, input, after_input, Nil(), Nil(), final_evidence)

  type AlternateRightExecutedAcceptanceProjection(right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence))
    ProjectedAlternateRightExecutedAcceptance : (child_final_evidence: List(Evidence)) -> (child_final_captures: List(CaptureFrame)) -> (child_acceptance: AcceptancePathFrom(right_count, right_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence)) -> (child_execution: ExtendedEvidenceRoutineExecution(acceptance_extended_routine(right_count, right_machine, position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance), input_evidence, input_captures, child_final_evidence, child_final_captures)) -> (final_is_marked: Equivalent(List(Evidence), final_evidence, Cons(RightEvidence(), child_final_evidence))) -> AlternateRightExecutedAcceptanceProjection(right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence)

  typealias AlternateRightAcceptanceProjection(right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = AlternateRightAcceptanceFromProjection(right_count, right_machine, position, input, after_input, Nil(), Nil(), final_evidence)

  type AlternateInitialOrigin(left_count: Nat, right_count: Nat, left_states: List(MachineState(left_count)), right_states: List(MachineState(right_count))) indices (combined: MachineState(plus(left_count, right_count)))
    AlternateInitialFromLeft : (origin: FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), left_states, combined)) -> AlternateInitialOrigin(left_count, right_count, left_states, right_states, combined)
    AlternateInitialFromRight : (origin: FilteredRightMarkedStateOrigin(left_count, right_count, EmitRight(), right_states, combined)) -> AlternateInitialOrigin(left_count, right_count, left_states, right_states, combined)

  type AlternateAcceptanceFromBranch(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence)) indices (right_branch: Bool)
    ProjectedAlternateFromLeft : (projection: AlternateLeftAcceptanceFromProjection(left_count, left_machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AlternateAcceptanceFromBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence, False())
    ProjectedAlternateFromRight : (projection: AlternateRightAcceptanceFromProjection(right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AlternateAcceptanceFromBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence, True())

  fn empty_acceptance_path_from_encodes(input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(Z(), empty_pattern_machine(), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(UnitC(), final_evidence, input_evidence) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> match edge
      ListMemberHere() -> match initial_execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineDone() -> match accepted_path_view(Z(), empty_pattern_machine(), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
            AcceptedPathNow() -> EncodesUnit()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn record_capture_partition({input: List(Char)}, {left: List(Char)}, {right: List(Char)}, captures: List(CaptureFrame), partition: InputPartition(input, left, right)) -> Equivalent(List(CaptureFrame), record_capture_input(record_capture_input(captures, left), right), record_capture_input(captures, input)) = match partition
    InputPartitionHere(parts_right) -> reflexive(record_capture_input(captures, parts_right))
    InputPartitionThere(char, prior) -> record_capture_partition(record_capture_char(captures, char), prior)

  type RecordedOpenCapture(chars: List(Char), saved: List(Evidence), captures: List(CaptureFrame), input: List(Char)) indices (final_captures: List(CaptureFrame))
    RecordedOpenCaptureExact : RecordedOpenCapture(chars, saved, captures, input, Cons(CaptureFrame(evidence_reverse_chars_into(input, chars), saved), record_capture_input(captures, input)))

  fn record_capture_single(captures: List(CaptureFrame), char: Char) -> Equivalent(List(CaptureFrame), record_capture_char(captures, char), record_capture_input(captures, Cons(char, Nil()))) = reflexive(record_capture_char(captures, char))

  fn empty_acceptance_captures(input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(Z(), empty_pattern_machine(), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(Z(), empty_pattern_machine(), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> match edge
      ListMemberHere() -> match initial_execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineDone() -> match path
            AcceptingNow() -> reflexive(input_captures)
            AcceptingNextActive(_, _, _, _, _, _, impossible_edge, _, _) -> impossible_list_member(impossible_edge)
            AcceptingNextAccepted(_, _, _, _, _, impossible_edge, _, _) -> impossible_list_member(impossible_edge)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_capture_execution_view(test: Char -> Bool, char: Char, input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(Cons(EmitChar(char), Nil()), input_evidence, input_captures, output_evidence, output_captures)) -> PredicateCaptureExecutionView(test, char, input_evidence, input_captures, output_evidence, output_captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> PredicateCaptureExecutionExact()

  fn prefix_routine_origin({n: Nat}, instruction: EvidenceInstruction, states: List(MachineState(n)), prefixed: MachineState(n), edge: ListMember(MachineState(n), prefixed, prefix_routine(instruction, states))) -> PrefixRoutineOrigin(n, instruction, states, prefixed) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> PrefixedActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match prefix_routine_origin(instruction, rest, prefixed, prior)
        PrefixedActiveOrigin(child_state, child_routine, child_constraints, child_edge) -> PrefixedActiveOrigin(child_state, child_routine, child_constraints, ListMemberThere(child_edge))
        PrefixedAcceptedOrigin(child_routine, child_constraints, child_edge) -> PrefixedAcceptedOrigin(child_routine, child_constraints, ListMemberThere(child_edge))
    Cons(Accepted(routine, constraints), rest) -> match edge
      ListMemberHere() -> PrefixedAcceptedOrigin(routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match prefix_routine_origin(instruction, rest, prefixed, prior)
        PrefixedActiveOrigin(child_state, child_routine, child_constraints, child_edge) -> PrefixedActiveOrigin(child_state, child_routine, child_constraints, ListMemberThere(child_edge))
        PrefixedAcceptedOrigin(child_routine, child_constraints, child_edge) -> PrefixedAcceptedOrigin(child_routine, child_constraints, ListMemberThere(child_edge))

  fn finish_capture_origin({n: Nat}, states: List(MachineState(n)), finished: MachineState(n), edge: ListMember(MachineState(n), finished, finish_capture(states))) -> FinishCaptureOrigin(n, states, finished) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> match edge
      ListMemberHere() -> CaptureActiveOrigin(state, routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match finish_capture_origin(rest, finished, prior)
        CaptureActiveOrigin(child_state, child_routine, child_constraints, child_edge) -> CaptureActiveOrigin(child_state, child_routine, child_constraints, ListMemberThere(child_edge))
        CaptureAcceptedOrigin(child_routine, child_constraints, child_edge) -> CaptureAcceptedOrigin(child_routine, child_constraints, ListMemberThere(child_edge))
    Cons(Accepted(routine, constraints), rest) -> match edge
      ListMemberHere() -> CaptureAcceptedOrigin(routine, constraints, ListMemberHere())
      ListMemberThere(prior) -> match finish_capture_origin(rest, finished, prior)
        CaptureActiveOrigin(child_state, child_routine, child_constraints, child_edge) -> CaptureActiveOrigin(child_state, child_routine, child_constraints, ListMemberThere(child_edge))
        CaptureAcceptedOrigin(child_routine, child_constraints, child_edge) -> CaptureAcceptedOrigin(child_routine, child_constraints, ListMemberThere(child_edge))

  @reducible
  fn group_active_projection_captures(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), final_evidence: List(Evidence), final_captures: List(CaptureFrame), projection: GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, final_captures)) -> List(CaptureFrame) = match projection
    ProjectedGroupMissingFrame(_, _, _, _, combined, _, _, _, _, _) -> combined
    ProjectedGroupClosedFrame(_, _, _, _, _, _, _, combined, _, _, _, _, _) -> combined

  @reducible
  fn group_active_projection_evidence(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), final_evidence: List(Evidence), final_captures: List(CaptureFrame), projection: GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, final_captures)) -> List(Evidence) = match projection
    ProjectedGroupMissingFrame(child_final_evidence, _, _, _, _, _, _, _, _, _) -> child_final_evidence
    ProjectedGroupClosedFrame(_, _, chars, saved, _, _, _, _, _, _, _, _, _) -> Cons(StringEvidence(captured_string(chars)), saved)

  fn transport_group_active_projection_captures(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), @erased final_evidence: List(Evidence), left: List(CaptureFrame), right: List(CaptureFrame), equality: Equivalent(List(CaptureFrame), left, right), projection: GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, right)) -> GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, left) = match equality
    reflexive() -> projection

  fn transport_group_active_projection_to_path(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), @erased final_evidence: List(Evidence), routine: List(ExtendedInstruction), path: AcceptingFrom(n, group_pattern_machine(n, starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine), right: List(CaptureFrame), equality: Equivalent(List(CaptureFrame), accepting_final_captures(n, group_pattern_machine(n, starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine, path), right), projection: GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, right)) -> GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, group_pattern_machine(n, starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine, path)) = match equality
    reflexive() -> projection

  fn transport_group_active_projection_evidence(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), @erased left_evidence: List(Evidence), @erased right_evidence: List(Evidence), final_captures: List(CaptureFrame), evidence_exact: Equivalent(List(Evidence), left_evidence, right_evidence), projection: GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, right_evidence, final_captures)) -> GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, left_evidence, final_captures) = match evidence_exact
    reflexive() -> projection

  fn project_group_missing_one_step(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, rest: List(Char), rest_empty: Equivalent(List(Char), rest, empty_characters()), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_regular: List(EvidenceInstruction), middle_evidence: List(Evidence), edge: ListMember(MachineState(n), Accepted(child_regular, empty_boundary_constraints()), machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input))), inner: RoutineExecution(child_regular, current_evidence, record_capture_char(current_captures, char), middle_evidence, empty_captures())) -> GroupActivePathProjection(n, starts, next, Cons(char, rest), after_input, source, current_evidence, current_captures, middle_evidence, empty_captures()) = match rest_empty
    reflexive() ->
      let child_path = one_step_accepted_path(n, MkPatternMachine(starts, next), char, after_input, source, current_evidence, current_captures, child_regular, middle_evidence, empty_captures(), edge, inner)
      let transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), middle_evidence, empty_captures(), inner))
      let child_routine = append_extended_routines(transition_routine(char, child_regular), empty_extended_routine())
      let child_execution = append_extended_routine_execution(transition_routine(char, child_regular), empty_extended_routine(), current_evidence, current_captures, middle_evidence, empty_captures(), middle_evidence, empty_captures(), transition_execution, ExtendedEvidenceDone())
      ProjectedGroupMissingFrame(middle_evidence, child_routine, child_path, child_execution, empty_captures(), reflexive(empty_captures()), middle_evidence, reflexive(middle_evidence), empty_captures(), reflexive(empty_captures()))

  fn project_group_closed_one_step(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, rest: List(Char), rest_empty: Equivalent(List(Char), rest, empty_characters()), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_regular: List(EvidenceInstruction), middle_evidence: List(Evidence), chars: List(Char), saved: List(Evidence), outer: List(CaptureFrame), edge: ListMember(MachineState(n), Accepted(child_regular, empty_boundary_constraints()), machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input))), inner: RoutineExecution(child_regular, current_evidence, record_capture_char(current_captures, char), middle_evidence, Cons(CaptureFrame(chars, saved), outer))) -> GroupActivePathProjection(n, starts, next, Cons(char, rest), after_input, source, current_evidence, current_captures, Cons(StringEvidence(captured_string(chars)), saved), outer) = match rest_empty
    reflexive() ->
      let final_captures = Cons(CaptureFrame(chars, saved), outer)
      let child_path = one_step_accepted_path(n, MkPatternMachine(starts, next), char, after_input, source, current_evidence, current_captures, child_regular, middle_evidence, final_captures, edge, inner)
      let transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), middle_evidence, final_captures, inner))
      let child_routine = append_extended_routines(transition_routine(char, child_regular), empty_extended_routine())
      let child_execution = append_extended_routine_execution(transition_routine(char, child_regular), empty_extended_routine(), current_evidence, current_captures, middle_evidence, final_captures, middle_evidence, final_captures, transition_execution, ExtendedEvidenceDone())
      ProjectedGroupClosedFrame(middle_evidence, child_routine, chars, saved, outer, child_path, child_execution, outer, reflexive(outer), Cons(StringEvidence(captured_string(chars)), saved), reflexive(Cons(StringEvidence(captured_string(chars)), saved)), outer, reflexive(outer))

  type AcceptanceWithExecution(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence), final_captures: List(CaptureFrame))
    AcceptedWithExecution : (acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> (execution: ExtendedEvidenceRoutineExecution(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), input_evidence, input_captures, final_evidence, final_captures)) -> AcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures)

  type CanonicalAcceptanceWithExecution(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence), final_captures: List(CaptureFrame))
    CanonicalAcceptedWithExecution : (acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> (captures_exact: Equivalent(List(CaptureFrame), acceptance_path_final_captures(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), final_captures)) -> CanonicalAcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures)

  type TransportedCertifiedAcceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), expected_captures: List(CaptureFrame)) indices ()
    CertifiedAcceptanceTransported : (acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> (captures_exact: Equivalent(List(CaptureFrame), acceptance_path_final_captures(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), expected_captures)) -> TransportedCertifiedAcceptance(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, expected_captures)

  fn staged_thread_destinations_equivalent(
    {shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    source: ThreadState(thompson_state_count(compilation)),
    char: Char,
    boundary: Boundary
  ) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    machine_destinations(thompson_state_count(compilation), staged_machine_from_compilation(compilation), source, char, boundary),
    machine_destinations(thompson_state_count(compilation), thompson_machine(compilation), source, char, boundary)
  ) = match source
    ThreadAccepted() -> reflexive(machine_destinations(thompson_state_count(compilation), staged_machine_from_compilation(compilation), ThreadAccepted(), char, boundary))
    ThreadActive(state) -> staged_machine_destinations_equivalent(compilation, state, char, boundary)

  fn record_capture_input_congruent(left: List(CaptureFrame), right: List(CaptureFrame), input: List(Char), equality: Equivalent(List(CaptureFrame), left, right)) -> Equivalent(List(CaptureFrame), record_capture_input(left, input), record_capture_input(right, input)) = match equality
    reflexive() -> reflexive(record_capture_input(left, input))

  ## Compilation and its structural evidence theorem are constructed together.
  ## The existential package avoids asking conversion to rediscover that two
  ## independent recursive traversals of `pattern` produced the same indexed
  ## compilation.
  type CertifiedThompsonCompilation indices (shape: ShapeCode, compilation: ThompsonCompilation(shape))
    CertifiedThompson : (compilation: ThompsonCompilation(shape)) -> (proof: ThompsonEvidenceProof(shape, compilation)) -> CertifiedThompsonCompilation(shape, compilation)

  ## A staged literal publishes the constructor-preserving Thompson IR rather
  ## than its source Pattern.  The IR is itself the complete regular algebra,
  ## so its evidence certificate can be rebuilt structurally without traversing
  ## a second source representation or reconstructing aliases at the use site.
  fn proof_for_compilation({shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> ThompsonEvidenceProof(shape, compilation) = match compilation
    ThompsonPredicate(test) -> ThompsonEvidencePredicate(test)
    ThompsonEmpty() -> ThompsonEvidenceEmpty()
    ThompsonBoundary(constraint) -> ThompsonEvidenceBoundary(constraint)
    ThompsonConcat(left, right) -> ThompsonEvidenceConcat(left, right, proof_for_compilation(left), proof_for_compilation(right))
    ThompsonGroup(inner) -> ThompsonEvidenceGroup(inner, proof_for_compilation(inner))
    ThompsonAlternate(left, right, prefer_right) -> ThompsonEvidenceAlternate(left, right, prefer_right, proof_for_compilation(left), proof_for_compilation(right))
    ThompsonRepeat(inner, lazy) -> ThompsonEvidenceRepeat(inner, lazy, proof_for_compilation(inner))

  fn grouped_predicate_starts_view(test: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> GroupedPredicateStartsView(initial_machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, input, after_input)) = GroupedPredicateStartsExact()

  fn grouped_predicate_destinations_view(test: Char -> Bool, char: Char, boundary: Boundary) -> GroupedPredicateDestinationsView(test(char), char, machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, boundary)) = match test(char)
    False() -> GroupedPredicateRejects()
    True() -> GroupedPredicateAccepts()

  fn grouped_predicate_initial_view({evidence: List(Evidence)}, {captures: List(CaptureFrame)}, execution: RoutineExecution(Cons(BeginCapture(), Nil()), Nil(), Nil(), evidence, captures)) -> GroupedPredicateInitialView(evidence, captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> GroupedPredicateInitialExact()

  fn grouped_predicate_final_encodes(char: Char) -> Encodes(StringC, executed_evidence(execute_instruction(EndCapture(), Cons(CharacterEvidence(char), Nil()), record_capture_char(Cons(CaptureFrame(Nil(), Nil()), Nil()), char))), empty_evidence()) =
    have final_evidence_exact = proof chain
      Cons(StringEvidence(Std.String.from_characters(evidence_reverse_chars(Cons(char, Nil())))), Nil()) == executed_evidence(execute_instruction(EndCapture(), Cons(CharacterEvidence(char), Nil()), record_capture_char(Cons(CaptureFrame(Nil(), Nil()), Nil()), char)))
      because simplify
    transport_encodes_output(final_evidence_exact, EncodesString(Std.String.from_characters(evidence_reverse_chars(Cons(char, Nil())))))

  fn predicate_concat_accepted_edge_view(char: Char, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), Accepted(regular, constraints), Cons(predicate_concat_accepting(char), Nil()))) -> PredicateConcatAcceptedEdgeView(char, regular, constraints) = match edge
    ListMemberHere() -> PredicateConcatAcceptedEdgeExact()
    ListMemberThere(prior) -> impossible_concat_accepted_tail(regular, constraints, prior)

  fn predicate_concat_active_edge_view(char: Char, destination: Bounded(plus(S(Z()), S(Z()))), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), Active(destination, regular, constraints), Cons(predicate_concat_middle(char), Nil()))) -> PredicateConcatActiveEdgeView(char, destination, regular, constraints) = match edge
    ListMemberHere() -> PredicateConcatActiveEdgeExact()
    ListMemberThere(prior) -> impossible_concat_active_tail(destination, regular, constraints, prior)

  @reducible
  fn predicate_alternate_machine(left: Char -> Bool, right: Char -> Bool) -> PatternMachine(plus(S(Z()), S(Z()))) = predicate_alternate_mode_machine(left, right, false)

  type PredicateAlternateStartsView indices (prefer_right: Bool, starts: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateAlternateStartsLeftFirst : PredicateAlternateStartsView(false, Cons(predicate_alternate_left_start(), Cons(predicate_alternate_right_start(), Nil())))
    PredicateAlternateStartsRightFirst : PredicateAlternateStartsView(true, Cons(predicate_alternate_right_start(), Cons(predicate_alternate_left_start(), Nil())))

  type PredicateAlternateInitialView indices (prefer_right: Bool, destination: MachineState(plus(S(Z()), S(Z()))))
    PredicateAlternateInitialLeft : PredicateAlternateInitialView(prefer_right, predicate_alternate_left_start())
    PredicateAlternateInitialRight : PredicateAlternateInitialView(prefer_right, predicate_alternate_right_start())

  fn predicate_alternate_left_destinations_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, boundary: Boundary) -> PredicateAlternateLeftDestinationsView(left(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), ThreadActive(First()), char, boundary)) = match left(char)
    False() -> PredicateAlternateLeftRejects()
    True() -> PredicateAlternateLeftAccepts()

  fn predicate_alternate_right_destinations_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, boundary: Boundary) -> PredicateAlternateRightDestinationsView(right(char), char, machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), ThreadActive(Next(First())), char, boundary)) = match right(char)
    False() -> PredicateAlternateRightRejects()
    True() -> PredicateAlternateRightAccepts()
end
