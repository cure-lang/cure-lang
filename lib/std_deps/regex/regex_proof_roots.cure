                let entered_edge = lift_enter_right_accepted_member(left_count, right_count, raw_left_regular, raw_left_constraints, right_starts, raw_right_regular, raw_right_constraints, raw_right_edge)
                let combined_regular = append_routine(append_routine(raw_left_regular, raw_right_regular), Cons(EmitPair(), Nil()))
                let combined_constraints = append_constraints(raw_left_constraints, raw_right_constraints)
                let continued_edge = lift_continue_entered_right_member(left_count, right_count, left_starts, right_starts, raw_left_regular, raw_left_constraints, raw_left_edge, Accepted(combined_regular, combined_constraints), entered_edge)
                let combined_holds = appended_constraints_hold(raw_left_constraints, raw_right_constraints, boundary, left_holds, right_holds)
                let combined_edge = filter_accepted_member(plus(left_count, right_count), continue_with_right(left_count, left_starts, right_starts), boundary, combined_regular, combined_constraints, continued_edge, combined_holds)
                let left_right_execution = append_routine_execution(left_regular, right_regular, input_evidence, input_captures, left_final_evidence, left_final_captures, right_initial_evidence, right_initial_captures, left_execution, right_execution)
                let marker_execution: RoutineExecution(Cons(EmitPair(), Nil()), right_initial_evidence, right_initial_captures, Cons(PairEvidence(), right_initial_evidence), right_initial_captures) = RoutineStep(EmitPair(), RoutineDone())
                let combined_execution = append_routine_execution(append_routine(left_regular, right_regular), Cons(EmitPair(), Nil()), input_evidence, input_captures, right_initial_evidence, right_initial_captures, Cons(PairEvidence(), right_initial_evidence), right_initial_captures, left_right_execution, marker_execution)
                %[Accepted(combined_regular, Nil()), Cons(PairEvidence(), right_initial_evidence), right_initial_captures, Nil(), combined_edge, combined_execution, AcceptingNow()]

