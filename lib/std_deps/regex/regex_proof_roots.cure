  use Std.Equivalent

  @reducible
  fn end_capture_view_captures(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), view: EndCaptureExecutionView(routine, input_evidence, input_captures, output_evidence, output_captures)) -> List(CaptureFrame) = match view
    EndCaptureWithoutFrame(_, _, _, _, _, _) -> Nil()
    EndCaptureWithFrame(_, _, _, outer, _, _, _, _, _) -> outer

  @reducible
  fn end_capture_view_evidence(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), view: EndCaptureExecutionView(routine, input_evidence, input_captures, output_evidence, output_captures)) -> List(Evidence) = match view
    EndCaptureWithoutFrame(middle_evidence, _, _, _, _, _) -> middle_evidence
    EndCaptureWithFrame(_, chars, saved, _, _, _, _, _, _) -> Cons(StringEvidence(captured_string(chars)), saved)

  fn acceptance_path_execution(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AcceptanceExecution(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), input_evidence, input_captures, final_evidence) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> match accepting_path_execution(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine, path)
      PathExecuted(final_captures, path_execution) ->
        let initial_routine = machine_state_routine(n, destination)
        let initial_extended = extend_routine_execution(initial_routine, input_evidence, input_captures, initial_evidence, initial_captures, initial_execution)
        AcceptanceExecuted(final_captures, append_extended_routine_execution(regular_routine(initial_routine), path_routine, input_evidence, input_captures, initial_evidence, initial_captures, final_evidence, final_captures, initial_extended, path_execution))

  type AcceptanceExecutionWitness(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) indices (final_captures: List(CaptureFrame))
    WitnessedAcceptanceExecution : (routine: List(ExtendedInstruction)) -> (execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, final_evidence, final_captures)) -> (routine_exact: Equivalent(List(ExtendedInstruction), routine, acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance))) -> AcceptanceExecutionWitness(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance, final_captures)

  fn acceptance_path_execution_exact(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> ExtendedEvidenceRoutineExecution(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), input_evidence, input_captures, final_evidence, acceptance_path_final_captures(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) ->
      let initial_routine = machine_state_routine(n, destination)
      append_extended_routine_execution(regular_routine(initial_routine), path_routine, input_evidence, input_captures, initial_evidence, initial_captures, final_evidence, accepting_final_captures(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine, path), extend_routine_execution(initial_routine, input_evidence, input_captures, initial_evidence, initial_captures, initial_execution), accepting_path_execution_exact(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine, path))

  fn machine_acceptance_path(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, acceptance: MachineAcceptance(n, machine, position, input, after_input, final_evidence, routine)) -> AcceptancePath(n, machine, position, input, after_input, final_evidence) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, execution, _, path) -> %[destination, initial_evidence, initial_captures, path_routine, edge, execution, path]

  type BoundaryStartsView indices (holds: Bool, starts: List(MachineState(Z())))
    BoundaryStartsUnavailable : BoundaryStartsView(false, Nil())
    BoundaryStartsExact : BoundaryStartsView(true, Cons(boundary_accepting_destination(), Nil()))

  @reducible
  fn predicate_concat_start_thread() -> ThreadState(plus(S(Z()), S(Z()))) =
    machine_state_thread(plus(S(Z()), S(Z())), predicate_concat_start())

  type PredicateConcatStartsView indices (starts: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatStartsExact : PredicateConcatStartsView(Cons(predicate_concat_start(), Nil()))

  type PredicateConcatInitialDestinationView indices (destination: MachineState(plus(S(Z()), S(Z()))))
    PredicateConcatInitialDestinationExact : PredicateConcatInitialDestinationView(predicate_concat_start())

  type PredicateConcatFirstView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatFirstRejects : PredicateConcatFirstView(false, char, Nil())
    PredicateConcatFirstAccepts : PredicateConcatFirstView(true, char, Cons(predicate_concat_middle(char), Nil()))

  type PredicateConcatSecondView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateConcatSecondRejects : PredicateConcatSecondView(false, char, Nil())
    PredicateConcatSecondAccepts : PredicateConcatSecondView(true, char, Cons(predicate_concat_accepting(char), Nil()))

  fn exact_accepted_path_view(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), @erased current_evidence: List(Evidence), @erased captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> ExactAcceptedPathView(n, machine, after_input, input, current_evidence, captures, final_evidence, routine, path) = match path
    AcceptingNow() -> ExactAcceptedPathNow()
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  fn accepted_path_transport_captures(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine), left: List(CaptureFrame), equality: Equivalent(List(CaptureFrame), left, accepting_final_captures(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine, path))) -> Equivalent(List(CaptureFrame), left, captures) = match path
    AcceptingNow() -> equality
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  fn encodes_character_empty(char: Char) -> Encodes(CharC, Cons(CharacterEvidence(char), empty_evidence()), empty_evidence()) = EncodesCharacter(char)

  fn encodes_many_characters_empty() -> EncodesMany(CharC, Cons(BeginListEvidence(), empty_evidence()), empty_evidence()) = EncodesManyEmpty()

  fn predicate_execution_view(char: Char, {evidence: List(Evidence)}, {captures: List(CaptureFrame)}, execution: RoutineExecution(Cons(EmitChar(char), Nil()), Nil(), Nil(), evidence, captures)) -> PredicateEvidenceView(char, evidence, captures) = match execution
    RoutineStep(_, suffix) -> match suffix
      RoutineDone() -> PredicateEvidenceExact()

  fn predicate_starts_view(test: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateStartsView(initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, input, after_input)) = PredicateStartsExact()

  fn empty_machine_arbitrary_acceptance_encodes(input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), empty_pattern_machine(), position, input, after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> match edge
      ListMemberHere() -> match initial_execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineDone() -> match accepted_path_view(Z(), empty_pattern_machine(), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
            AcceptedPathNow() -> EncodesUnit()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_destinations_view(test: Char -> Bool, char: Char, boundary: Boundary) -> PredicateDestinationsView(test, char, boundary, machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, boundary)) = match test(char)
    False() -> PredicateRejects()
    True() -> PredicateAccepts()

  ## Embed the accepting alternative contributed by a completed child
  ## iteration.  This is the constructive counterpart of
  ## `repeat_destination_order_origin`: completeness proofs must be able to
  ## build the closing edge, not merely recover its origin from an existing
  ## Repeat execution.
  fn lift_repeat_destination_closing_order_member(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n)), lazy: Bool) -> ListMember(MachineState(n), Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints), repeat_destination_order(routine, constraints, starts, lazy)) = match lazy
    False() -> lift_append_right_member(n, enter_repeat_with_constraints(routine, constraints, starts), repeat_accepting(routine, constraints), Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints), member_here(Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints), Nil()))
    True() -> lift_append_left_member(n, repeat_accepting(routine, constraints), enter_repeat_with_constraints(routine, constraints, starts), Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints), member_here(Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints), Nil()))

  ## Active child destinations are preserved verbatim by Repeat.  Accepted
  ## destinations before the selected child expand into closing/re-entry
  ## alternatives, so membership in the transformed tail must be lifted across
  ## those prefixes.
  fn lift_repeat_destinations_active_member(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, routine, constraints), destinations)) -> ListMember(MachineState(n), Active(state, routine, constraints), repeat_destinations(destinations, starts, lazy)) = match destinations
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, head_constraints), rest) -> match edge
      ListMemberHere() -> member_here(Active(head_state, head_routine, head_constraints), repeat_destinations(rest, starts, lazy))
      ListMemberThere(prior) -> member_there(Active(head_state, head_routine, head_constraints), lift_repeat_destinations_active_member(n, rest, starts, lazy, state, routine, constraints, prior))
    Cons(Accepted(head_routine, head_constraints), rest) -> match edge
      ListMemberThere(prior) -> lift_append_right_member(n, repeat_destination_order(head_routine, head_constraints, starts, lazy), repeat_destinations(rest, starts, lazy), Active(state, routine, constraints), lift_repeat_destinations_active_member(n, rest, starts, lazy, state, routine, constraints, prior))

  ## Construct the active restart selected after one child acceptance.  This is
  ## the forward counterpart of EnterRepeatActiveOrigin and retains the exact
  ## start edge while prefixing the completed iteration's routine/constraints.
  fn lift_enter_repeat_active_member(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n)), state: Bounded(n), start_routine: List(EvidenceInstruction), start_constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> ListMember(MachineState(n), Active(state, append_routine(routine, start_routine), append_constraints(constraints, start_constraints)), enter_repeat_with_constraints(routine, constraints, starts)) = match starts
    Nil() -> impossible_list_member(edge)
    Cons(Accepted(head_routine, head_constraints), rest) -> match edge
      ListMemberThere(prior) -> lift_enter_repeat_active_member(n, routine, constraints, rest, state, start_routine, start_constraints, prior)
    Cons(Active(head_state, head_routine, head_constraints), rest) -> match edge
      ListMemberHere() -> member_here(Active(head_state, append_routine(routine, head_routine), append_constraints(constraints, head_constraints)), enter_repeat_with_constraints(routine, constraints, rest))
      ListMemberThere(prior) -> member_there(Active(head_state, append_routine(routine, head_routine), append_constraints(constraints, head_constraints)), lift_enter_repeat_active_member(n, routine, constraints, rest, state, start_routine, start_constraints, prior))

  fn exact_repeat_child_active_path_view(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), routine: List(ExtendedInstruction), path: AcceptingFrom(n, MkPatternMachine(starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, routine)) -> ExactRepeatChildActivePathView(n, starts, next, after_input, source, current_evidence, current_captures, child_final_evidence, input, routine, path) = match path
    AcceptingNow() -> impossible
    AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match input
      Cons(char, rest) -> ExactRepeatChildNextActive(char, rest, destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix)
    AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match input
      Cons(char, rest) -> ExactRepeatChildNextAccepted(char, rest, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix)

  fn transport_repeat_continuation_position(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, first_position: InitialPosition, second_position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), equality: Equivalent(InitialPosition, first_position, second_position), continuation: RepeatContinuationFrom(n, starts, next, lazy, first_position, input, after_input, input_evidence, input_captures)) -> RepeatContinuationFrom(n, starts, next, lazy, second_position, input, after_input, input_evidence, input_captures) = match equality
    reflexive() -> continuation

  fn transport_repeat_continuation_captures(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), first_captures: List(CaptureFrame), second_captures: List(CaptureFrame), equality: Equivalent(List(CaptureFrame), first_captures, second_captures), continuation: RepeatContinuationFrom(n, starts, next, lazy, position, input, after_input, input_evidence, first_captures)) -> RepeatContinuationFrom(n, starts, next, lazy, position, input, after_input, input_evidence, second_captures) = match equality
    reflexive() -> continuation

  fn repeat_starts_origin(n: Nat, starts: List(MachineState(n)), lazy: Bool, destination: MachineState(n), edge: ListMember(MachineState(n), destination, repeat_machine_starts(starts, lazy))) -> RepeatStartsOrigin(n, starts, lazy, destination) = match lazy
    False() -> match append_member_origin(n, enter_repeat(Cons(BeginList(), Nil()), starts), Cons(Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()), Nil()), destination, edge)
      AppendMemberLeft(entered_edge) -> match enter_repeat_state_origin(n, Cons(BeginList(), Nil()), Nil(), starts, destination, entered_edge)
        EnterRepeatActiveOrigin(state, routine, constraints, start_edge) -> RepeatEnteredStartOrigin(state, routine, constraints, start_edge)
      AppendMemberRight(empty_edge) -> match empty_edge
        ListMemberHere() -> RepeatEmptyStartOrigin()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
    True() -> match append_member_origin(n, Cons(Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()), Nil()), enter_repeat(Cons(BeginList(), Nil()), starts), destination, edge)
      AppendMemberLeft(empty_edge) -> match empty_edge
        ListMemberHere() -> RepeatEmptyStartOrigin()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
      AppendMemberRight(entered_edge) -> match enter_repeat_state_origin(n, Cons(BeginList(), Nil()), Nil(), starts, destination, entered_edge)
        EnterRepeatActiveOrigin(state, routine, constraints, start_edge) -> RepeatEnteredStartOrigin(state, routine, constraints, start_edge)

  fn filtered_append_member_left({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, left)) -> FilteredAppendMemberOrigin(n, left, right, value) = FilteredAppendMemberLeft(edge)

  fn filtered_append_member_right({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, right)) -> FilteredAppendMemberOrigin(n, left, right, value) = FilteredAppendMemberRight(edge)

  fn lift_filtered_append_left_member(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, left, boundary))) -> ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary)) = match left
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Active(state, routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary))
        ListMemberThere(prior) -> member_there(Active(state, routine, Nil()), lift_filtered_append_left_member(n, rest, right, boundary, value, prior))
      False() -> lift_filtered_append_left_member(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Accepted(routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary))
        ListMemberThere(prior) -> member_there(Accepted(routine, Nil()), lift_filtered_append_left_member(n, rest, right, boundary, value, prior))
      False() -> lift_filtered_append_left_member(n, rest, right, boundary, value, edge)

  fn filtered_left_active_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count)), state: Bounded(left_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_left(left_count, right_count, state), routine, Nil())) =
    FilteredLeftActiveOrigin(state, routine, edge)

  fn filtered_left_accepted_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count)), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), states)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), Nil())) =
    FilteredLeftAcceptedOrigin(routine, edge)

  ## Constructive inverses of the origin views above. Completeness uses these
  ## to embed a certified child edge into an alternate machine while preserving
  ## filtering, state injection, and the branch evidence marker exactly.
  fn lift_filtered_left_active_member(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(left_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), filter_machine_states(left_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Active(inject_alternate_left(left_count, right_count, head_state), head_routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Active(inject_alternate_left(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_left_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)

  fn lift_filtered_left_accepted_member(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), filter_machine_states(left_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Active(inject_alternate_left(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Accepted(append_branch_marker(head_routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_left_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)

  fn alternate_left_transition_member(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(left_count), char: Char, boundary: Boundary, destination: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), destination, filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary))) -> ListMember(MachineState(plus(left_count, right_count)), destination, machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary)) = match alternate_left_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, boundary)
