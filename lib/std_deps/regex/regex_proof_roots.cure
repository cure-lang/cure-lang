  fn splice_nullable_left_active_right(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), left_regular: List(EvidenceInstruction), left_final_evidence: List(Evidence), left_final_captures: List(CaptureFrame), left_edge: ListMember(MachineState(left_count), Accepted(left_regular, Nil()), initial_machine_destinations(left_count, left_machine, position, empty_characters(), append_characters(input, after_input))), left_execution: RoutineExecution(left_regular, input_evidence, input_captures, left_final_evidence, left_final_captures), right_state: Bounded(right_count), right_regular: List(EvidenceInstruction), right_initial_evidence: List(Evidence), right_initial_captures: List(CaptureFrame), right_path_routine: List(ExtendedInstruction), right_edge: ListMember(MachineState(right_count), Active(right_state, right_regular, Nil()), initial_machine_destinations(right_count, right_machine, position, input, after_input)), right_execution: RoutineExecution(right_regular, left_final_evidence, left_final_captures, right_initial_evidence, right_initial_captures), right_final_evidence: List(Evidence), right_path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(right_state), right_initial_evidence, right_initial_captures, right_final_evidence, right_path_routine)) -> NullableLeftActiveRightConcatEmbedding(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, right_final_evidence) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        let boundary = initial_position_boundary(position, append_characters(input, after_input))
        match filtered_state_origin(left_count, left_starts, boundary, Accepted(left_regular, Nil()), left_edge)
          FilteredAcceptedStateOrigin(raw_left_regular, raw_left_constraints, raw_left_edge, left_holds) -> match filtered_state_origin(right_count, right_starts, boundary, Active(right_state, right_regular, Nil()), right_edge)
            FilteredActiveStateOrigin(_, raw_right_regular, raw_right_constraints, raw_right_edge, right_holds) -> match lift_concat_right_active_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), input, after_input, right_state, right_initial_evidence, right_initial_captures, right_final_evidence, right_path_routine, right_path)
              mk_pair(combined_path_routine, combined_path) ->
                let entered_edge = lift_enter_right_active_member(left_count, right_count, raw_left_regular, raw_left_constraints, right_starts, right_state, raw_right_regular, raw_right_constraints, raw_right_edge)
                let combined_state = inject_alternate_right(left_count, right_count, right_state)
                let combined_regular = append_routine(raw_left_regular, raw_right_regular)
                let combined_constraints = append_constraints(raw_left_constraints, raw_right_constraints)
                let continued_edge = lift_continue_entered_right_member(left_count, right_count, left_starts, right_starts, raw_left_regular, raw_left_constraints, raw_left_edge, Active(combined_state, combined_regular, combined_constraints), entered_edge)
                let combined_holds = appended_constraints_hold(raw_left_constraints, raw_right_constraints, boundary, left_holds, right_holds)
                let combined_edge = filter_active_member(plus(left_count, right_count), continue_with_right(left_count, left_starts, right_starts), boundary, combined_state, combined_regular, combined_constraints, continued_edge, combined_holds)
                let combined_execution = append_routine_execution(left_regular, right_regular, input_evidence, input_captures, left_final_evidence, left_final_captures, right_initial_evidence, right_initial_captures, left_execution, right_execution)
                %[Active(combined_state, combined_regular, Nil()), right_initial_evidence, right_initial_captures, combined_path_routine, combined_edge, combined_execution, combined_path]

  fn splice_nullable_left_accepted_right(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), left_regular: List(EvidenceInstruction), left_final_evidence: List(Evidence), left_final_captures: List(CaptureFrame), left_edge: ListMember(MachineState(left_count), Accepted(left_regular, Nil()), initial_machine_destinations(left_count, left_machine, position, empty_characters(), append_characters(input, after_input))), left_execution: RoutineExecution(left_regular, input_evidence, input_captures, left_final_evidence, left_final_captures), right_regular: List(EvidenceInstruction), right_initial_evidence: List(Evidence), right_initial_captures: List(CaptureFrame), right_path_routine: List(ExtendedInstruction), right_edge: ListMember(MachineState(right_count), Accepted(right_regular, Nil()), initial_machine_destinations(right_count, right_machine, position, input, after_input)), right_execution: RoutineExecution(right_regular, left_final_evidence, left_final_captures, right_initial_evidence, right_initial_captures), right_final_evidence: List(Evidence), right_path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadAccepted(), right_initial_evidence, right_initial_captures, right_final_evidence, right_path_routine)) -> NullableLeftAcceptedRightConcatEmbedding(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, right_final_evidence) = match accepted_path_view(right_count, right_machine, input, after_input, right_initial_evidence, right_initial_captures, right_final_evidence, right_path_routine, right_path)
    AcceptedPathNow() -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) ->
          let boundary = initial_position_boundary(position, after_input)
          match filtered_state_origin(left_count, left_starts, boundary, Accepted(left_regular, Nil()), left_edge)
            FilteredAcceptedStateOrigin(raw_left_regular, raw_left_constraints, raw_left_edge, left_holds) -> match filtered_state_origin(right_count, right_starts, boundary, Accepted(right_regular, Nil()), right_edge)
