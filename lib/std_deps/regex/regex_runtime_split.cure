@group(:text)
mod Std.Regex.Runtime.Split
  use Std.Regex.Core.Capture

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Char

  use Std.Option

  use Std.List

  use Std.String

  use Std.Syntax

  use Std.Bounded

  use Std.Equivalent

  use Std.Sigma

  use Std.Decision

  type SplitInclusion = ExcludeSeparators | IncludeSeparators

  type SplitTrimming = KeepEmptyParts | TrimEmptyParts

  type SplitLimit = UnlimitedSplit | AtMostSplitParts(Int)

  type SplitOptions = SplitOptions(SplitInclusion, SplitTrimming, SplitLimit)
end
