  ## Every cursor-location constructor closes for this paired case. The
  ## contradiction is semantic (blocking close versus continuation), so it
  ## does not depend on whether the independently compared cursor is equal,
  ## earlier, or later; the relevant location carrier merely guarantees that
  ## all four authorities came from one comparison.
  @reducible
  fn atomic_path_commit_after_failure_excludes_selected_rejected_location_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_kind: AtomicPathSkippedPrefixKind},
    {commit_cursor_package: Type}, {selected_trace_package: Type},
    package: AtomicPathCommitSelectedLocationPackage(
      n,
      AtomicPathCommitStructureExistentialPackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, whole, Cons(candidate, remaining),
        commit_depth,
        AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind)
      ),
      commit_cursor_package,
      selected_trace_package,
      AtomicPathSkippedPrefixStructurePackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, whole, Cons(candidate, remaining),
        selected_current,
        AtomicPathSkippedPrefixRejectedConsKind(
          child_prefix_kind,
          child_kind,
          tail_kind
        )
      ),
      Cons(candidate, remaining),
      selected_current
    )
  ) -> Empty = match package
    AtomicPathCommitSelectedSamePacked(commit_package, _, _, skipped_structure, _) ->
      atomic_path_commit_after_failure_excludes_selected_rejected_packages(
        commit_package,
        skipped_structure
      )
    AtomicPathCommitSelectedLeftAfterPacked(commit_package, _, _, skipped_structure, _) ->
      atomic_path_commit_after_failure_excludes_selected_rejected_packages(
        commit_package,
        skipped_structure
      )
    AtomicPathCommitSelectedRightAfterPacked(commit_package, _, _, skipped_structure, _) ->
      atomic_path_commit_after_failure_excludes_selected_rejected_packages(
        commit_package,
        skipped_structure
      )

  ## Dispatch the reverse-cursor proof from its indexed construction source.
  ## Root failures close by finite suffix asymmetry. Only a genuinely skipped
  ## prefix is delegated to the recursive mixed-prefix consumer.
  @reducible
  fn atomic_path_failure_prefix_reverse_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    whole: List(LookaroundAdmittedState(n)),
    current: List(LookaroundAdmittedState(n)),
    selected: List(LookaroundAdmittedState(n)),
    kind: AtomicPathFailurePrefixKind,
    @erased prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, kind),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current),
    after_skipped_case: () -> Empty
  ) -> Empty = match kind
    AtomicPathFailureAtRootKind() -> match prefix
      AtomicPathFailureAtRoot(_) -> atomic_path_failure_at_root_excludes_strict_selection(
        whole,
        current,
        selected,
        prefix,
        selected_suffix,
        strict
      )
    AtomicPathFailureAfterSkippedKind(skipped_kind) -> match skipped_kind
      AtomicPathSkippedPrefixEmptyKind() -> match prefix
        AtomicPathFailureAfterSkipped(_, _) -> atomic_path_failure_after_empty_skipped_excludes_strict_selection(
          whole,
          current,
          selected,
          prefix,
          selected_suffix,
          strict
        )
      AtomicPathSkippedPrefixEscapedOneKind(_) -> after_skipped_case()
      AtomicPathSkippedPrefixEscapedConsKind(_, _) -> after_skipped_case()
      AtomicPathSkippedPrefixRejectedConsKind(_, _, _) -> after_skipped_case()

  ## Refine a non-empty existential tail at its proof-only construction
  ## boundary.  A tail package whose current spine starts with `candidate`
  ## can only contain a destination-rejection refutation.  The contradiction
  ## is consumed here rather than returned as an erased runtime value.
  @reducible
  fn atomic_path_rejected_tail_refinement(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil())
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match package
    AtomicPathTailPackagePacked(failure) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        atomic_path_destinations_exhausted_tail_refinement(
          machine,
          char,
          rest,
          after_input,
          source,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          atomic_path_destination_rejected_tail_package(
            machine,
            char,
            rest,
            after_input,
            source,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            failure
          ),
          matched,
          remaining_input,
          routine,
          LookaroundAdmittedStateCursorSuffixHere(
            reflexive(empty_lookaround_admitted_states(n))
          ),
          path
        )

  ## Root blocked failures retain their exact parent failure/evidence pair
  ## while entering the typed non-empty-tail dispatcher.  The package is
  ## constructed at this boundary, and the later-sibling obligation remains a
  ## zero-argument proof-only continuation; no existential tail kind or
  ## commitment tag is promoted into runtime control.
  @reducible
  fn atomic_start_root_blocked_tail_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(candidate, remaining)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> result =
    let package: AtomicStartTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining)
    ) = AtomicStartTailPackagePacked(failure, evidence)
    lookaround_absurd(atomic_start_rejected_member_there_nonempty_tail_blocked_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      candidate,
      package,
      failure,
      evidence,
      skip,
      allowed,
      membership,
      path,
      tail_case
    ))

  ## The concrete active root case supplies the first head continuation to the
  ## shared rejected-root fold.  Its child input is definitionally empty, so
  ## the existing active-child consumer can eliminate the selected trace; a
  ## later sibling receives the exact root-tail package through `tail_case`.
  @reducible
  fn atomic_start_refutation_rejected_active_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_rejected_member_here_excludes_trace(
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    path,
    tail_case
  )
end
