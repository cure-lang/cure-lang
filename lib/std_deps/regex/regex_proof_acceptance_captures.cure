          acceptance_path_final_captures(thompson_state_count(left), thompson_machine(left), position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance),
          record_capture_input(input_captures, input),
          capture_equivalent_symmetric(
            acceptance_path_final_captures(thompson_state_count(left), thompson_machine(left), position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance),
            combined_captures,
            captures_exact
          ),
          child_captures
        )
      AlternateInitialFromRight(right_origin) -> match alternate_right_origin_acceptance_captures(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right, position, input, after_input, input_evidence, input_captures, destination, initial_evidence, initial_captures, path_routine, right_origin, execution, path)
        CapturedAlternateRightAcceptance(child_final_evidence, child_acceptance, final_is_right, captures_exact) ->
          let child_captures = thompson_evidence_acceptance_captures_explicit(right_shape, right, right_proof, input, after_input, position, input_evidence, input_captures, child_acceptance)
          let combined_captures = accepting_final_captures(plus(thompson_state_count(left), thompson_state_count(right)), alternate_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right), input, after_input, machine_state_thread(plus(thompson_state_count(left), thompson_state_count(right)), destination), initial_evidence, initial_captures, final_evidence, path_routine, path)
          capture_equivalent_transitive(
          combined_captures,
          acceptance_path_final_captures(thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance),
          record_capture_input(input_captures, input),
          capture_equivalent_symmetric(
            acceptance_path_final_captures(thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, child_final_evidence, child_acceptance),
            combined_captures,
            captures_exact
          ),
          child_captures
        )

  fn thompson_repeat_projection_captures(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), item_input_evidence: List(Evidence), item_input_captures: List(CaptureFrame), state: Bounded(thompson_state_count(inner)), routine: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), initial_edge: ListMember(MachineState(thompson_state_count(inner)), Active(state, routine, Nil()), initial_machine_destinations(thompson_state_count(inner), thompson_machine(inner), position, input, after_input)), initial_execution: RoutineExecution(routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures), {final_evidence: List(Evidence)}, {final_captures: List(CaptureFrame)}, projection: RepeatActivePathProjection(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)) -> Equivalent(List(CaptureFrame), final_captures, record_capture_input(item_input_captures, input)) = match projection
    ProjectedRepeatFinalItem(child_final_evidence, child_final_captures, child_routine, child_path, child_captures_exact, combined_final_captures, captures_exact, _, _) ->
      let child_acceptance = active_acceptance_from_path(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, child_routine, initial_edge, initial_execution, child_path)
      let child_recorded = thompson_evidence_acceptance_captures_explicit(inner_shape, inner, inner_proof, input, after_input, position, item_input_evidence, item_input_captures, child_acceptance)
      capture_equivalent_transitive(combined_final_captures, child_final_captures, record_capture_input(item_input_captures, input), captures_exact, capture_equivalent_transitive(child_final_captures, acceptance_path_final_captures(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance), record_capture_input(item_input_captures, input), child_captures_exact, child_recorded))
    ProjectedRepeatMoreItems(child_input, remaining_input, partition, child_final_evidence, child_final_captures, child_routine, child_path, child_captures_exact, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, combined_final_captures, continuation) ->
      let original_filtered_edge = filtered_starts_from_initial_edge(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, Active(state, routine, Nil()), initial_edge)
      let child_filtered_edge = transport_filtered_start_subject(thompson_state_count(inner), thompson_machine(inner), position, append_characters(input, after_input), append_characters(child_input, append_characters(remaining_input, after_input)), Active(state, routine, Nil()), partition_append_after(after_input, partition), original_filtered_edge)
      let child_initial_edge = initial_edge_from_filtered_starts(thompson_state_count(inner), thompson_machine(inner), position, child_input, append_characters(remaining_input, after_input), Active(state, routine, Nil()), child_filtered_edge)
      let child_acceptance = active_acceptance_from_path(thompson_state_count(inner), thompson_machine(inner), position, child_input, append_characters(remaining_input, after_input), item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, child_routine, child_initial_edge, initial_execution, child_path)
      let child_recorded = thompson_evidence_acceptance_captures_explicit(inner_shape, inner, inner_proof, child_input, append_characters(remaining_input, after_input), position, item_input_evidence, item_input_captures, child_acceptance)
      let child_final_recorded = capture_equivalent_transitive(child_final_captures, acceptance_path_final_captures(thompson_state_count(inner), thompson_machine(inner), position, child_input, append_characters(remaining_input, after_input), item_input_evidence, item_input_captures, child_final_evidence, child_acceptance), record_capture_input(item_input_captures, child_input), child_captures_exact, child_recorded)
      let continuation_recorded = thompson_repeat_projection_captures(inner_shape, inner, inner_proof, lazy, advance_initial_position(position, child_input), remaining_input, after_input, child_final_evidence, child_final_captures, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, continuation)
      let nested_recorded = capture_equivalent_transitive(combined_final_captures, record_capture_input(child_final_captures, remaining_input), record_capture_input(record_capture_input(item_input_captures, child_input), remaining_input), continuation_recorded, record_capture_input_congruent(child_final_captures, record_capture_input(item_input_captures, child_input), remaining_input, child_final_recorded))
      capture_equivalent_transitive(combined_final_captures, record_capture_input(record_capture_input(item_input_captures, child_input), remaining_input), record_capture_input(item_input_captures, input), nested_recorded, record_capture_partition(item_input_captures, partition))

  fn thompson_repeat_acceptance_captures(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(inner), repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(thompson_state_count(inner), repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = match project_repeat_acceptance_from_machine(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, input_evidence, input_captures, acceptance)
    ProjectedRepeatEmptyAcceptance(input_empty, _, _, combined_final_captures, captures_exact) -> match input_empty
      reflexive() -> captures_exact
    ProjectedRepeatItemsAcceptance(state, routine, list_evidence, list_captures, initial_evidence, initial_captures, initial_edge, initial_execution, projection, list_evidence_exact, list_captures_exact) -> match list_evidence_exact
      reflexive() -> match list_captures_exact
        reflexive() -> thompson_repeat_projection_captures(inner_shape, inner, inner_proof, lazy, position, input, after_input, Cons(BeginListEvidence(), input_evidence), input_captures, state, routine, initial_evidence, initial_captures, initial_edge, initial_execution, projection)

  fn thompson_evidence_acceptance_captures_explicit(@erased shape: ShapeCode, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = match proof
    ThompsonEvidenceEmpty() -> empty_acceptance_captures(input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceBoundary(constraint) -> boundary_acceptance_captures(constraint, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidencePredicate(test) -> predicate_acceptance_captures(test, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceConcat({left_shape = left_shape}, {right_shape = right_shape}, left, right, left_proof, right_proof) -> thompson_concat_acceptance_captures(left, right, left_proof, right_proof, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceGroup({inner_shape = inner_shape}, inner, inner_proof) -> thompson_group_acceptance_captures(inner, inner_proof, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceAlternate({left_shape = left_shape}, {right_shape = right_shape}, left, right, prefer_right, left_proof, right_proof) -> thompson_alternate_acceptance_captures(left, right, prefer_right, left_proof, right_proof, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceRepeat({inner_shape = inner_shape}, inner, lazy, inner_proof) -> thompson_repeat_acceptance_captures(inner_shape, inner, inner_proof, lazy, input, after_input, position, input_evidence, input_captures, acceptance)

  fn thompson_evidence_acceptance_captures({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = thompson_evidence_acceptance_captures_explicit(shape, compilation, proof, input, after_input, position, input_evidence, input_captures, acceptance)
end
