  fn group_child_supplied_captures(
    {inner_shape: ShapeCode},
    inner: ThompsonCompilation(inner_shape),
    inner_proof: ThompsonEvidenceProof(inner_shape, inner),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    final_evidence: List(Evidence),
    final_captures: List(CaptureFrame),
    accepted: AcceptanceWithExecution(
      thompson_state_count(inner),
      MkPatternMachine(pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner))),
      position,
      input,
      after_input,
      input_evidence,
      input_captures,
      final_evidence,
      final_captures
    )
  ) -> Equivalent(List(CaptureFrame), final_captures, record_capture_input(input_captures, input)) = match transport_acceptance_with_execution(
    thompson_machine(inner),
    MkPatternMachine(pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner))),
    position,
    input,
    after_input,
    input_evidence,
    input_captures,
    final_evidence,
    final_captures,
    pattern_machine_eta(thompson_machine(inner)),
    accepted
  )
    AcceptedWithExecution(child_acceptance, supplied_execution) -> match extended_routine_execution_unique(
      input_evidence,
      input_captures,
      acceptance_path_execution_exact(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, input_evidence, input_captures, final_evidence, child_acceptance),
      supplied_execution
    )
      mk_pair(evidence_exact, captures_exact) -> rewrite captures_exact in
        thompson_evidence_acceptance_captures(inner, inner_proof, input, after_input, position, input_evidence, input_captures, child_acceptance)

  fn thompson_group_acceptance_captures(
    {inner_shape: ShapeCode},
    inner: ThompsonCompilation(inner_shape),
    inner_proof: ThompsonEvidenceProof(inner_shape, inner),
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    {final_evidence: List(Evidence)},
    acceptance: AcceptancePathFrom(
      thompson_state_count(inner),
      thompson_machine(ThompsonGroup(inner)),
      position,
      input,
      after_input,
      input_evidence,
      input_captures,
      final_evidence
    )
  ) -> Equivalent(
    List(CaptureFrame),
    acceptance_path_final_captures(thompson_state_count(inner), thompson_machine(ThompsonGroup(inner)), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance),
    record_capture_input(input_captures, input)
  ) = match project_group_acceptance_from(thompson_state_count(inner), pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner)), position, input, after_input, input_evidence, input_captures, acceptance)
    ProjectedGroupAcceptanceMissingFrame(child_final_evidence, projected_child, combined_final_captures, captures_exact, _, _) -> impossible_missing_group_capture(
        input_evidence,
        input_captures,
        input,
        group_child_supplied_captures(inner, inner_proof, position, input, after_input, input_evidence, Cons(CaptureFrame(empty_characters(), input_evidence), input_captures), child_final_evidence, empty_captures(), projected_child)
    )
    ProjectedGroupAcceptanceClosedFrame(child_final_evidence, chars, saved, outer, projected_child, combined_final_captures, captures_exact, _, _) -> match recorded_open_capture_view(
        empty_characters(),
        input_evidence,
        input_captures,
        input,
        Cons(CaptureFrame(chars, saved), outer),
        group_child_supplied_captures(inner, inner_proof, position, input, after_input, input_evidence, Cons(CaptureFrame(empty_characters(), input_evidence), input_captures), child_final_evidence, Cons(CaptureFrame(chars, saved), outer), projected_child)
    )
      RecordedOpenCaptureExact() -> captures_exact

  fn thompson_concat_acceptance_captures({@erased left_shape: ShapeCode}, {@erased right_shape: ShapeCode}, left: ThompsonCompilation(left_shape), right: ThompsonCompilation(right_shape), left_proof: ThompsonEvidenceProof(left_shape, left), right_proof: ThompsonEvidenceProof(right_shape, right), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(plus(thompson_state_count(left), thompson_state_count(right)), concat_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right)), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(plus(thompson_state_count(left), thompson_state_count(right)), concat_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right)), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = match execute_concat_acceptance_projection(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, project_concat_acceptance_from(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, acceptance))
    ProjectedExecutedConcatAcceptance(left_input, right_input, partition, left_final_evidence, left_final_captures, left_acceptance, left_captures_exact, right_final_evidence, right_final_captures, right_acceptance, right_execution, right_captures_exact, final_is_paired) ->
      let left_recorded = capture_equivalent_transitive_inferred(
        left_final_captures,
        record_capture_input(input_captures, left_input),
        left_captures_exact,
        thompson_evidence_acceptance_captures_explicit(left_shape, left, left_proof, left_input, append_characters(right_input, after_input), position, input_evidence, input_captures, left_acceptance)
      )
      let right_recorded = capture_equivalent_transitive_inferred(
        right_final_captures,
        record_capture_input(left_final_captures, right_input),
        right_captures_exact,
        thompson_evidence_acceptance_captures_explicit(right_shape, right, right_proof, right_input, after_input, advance_initial_position(position, left_input), left_final_evidence, left_final_captures, right_acceptance)
      )
      capture_equivalent_transitive(
        right_final_captures,
        record_capture_input(left_final_captures, right_input),
        record_capture_input(input_captures, input),
        right_recorded,
        capture_equivalent_transitive(
          record_capture_input(left_final_captures, right_input),
          record_capture_input(record_capture_input(input_captures, left_input), right_input),
          record_capture_input(input_captures, input),
          record_capture_input_congruent(left_final_captures, record_capture_input(input_captures, left_input), right_input, left_recorded),
          record_capture_partition(input_captures, partition)
        )
      )

  fn thompson_alternate_acceptance_captures({left_shape: ShapeCode}, {right_shape: ShapeCode}, left: ThompsonCompilation(left_shape), right: ThompsonCompilation(right_shape), prefer_right: Bool, left_proof: ThompsonEvidenceProof(left_shape, left), right_proof: ThompsonEvidenceProof(right_shape, right), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(plus(thompson_state_count(left), thompson_state_count(right)), alternate_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(plus(thompson_state_count(left), thompson_state_count(right)), alternate_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(execution, path)))))) -> match alternate_initial_origin_for_machines(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right, position, input, after_input, destination, edge)
      AlternateInitialFromLeft(left_origin) -> match alternate_left_origin_acceptance_captures(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right, position, input, after_input, input_evidence, input_captures, destination, initial_evidence, initial_captures, path_routine, left_origin, execution, path)
        CapturedAlternateLeftAcceptance(child_final_evidence, child_acceptance, final_is_left, captures_exact) ->
          let child_captures = thompson_evidence_acceptance_captures_explicit(left_shape, left, left_proof, input, after_input, position, input_evidence, input_captures, child_acceptance)
          let combined_captures = accepting_final_captures(plus(thompson_state_count(left), thompson_state_count(right)), alternate_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right), input, after_input, machine_state_thread(plus(thompson_state_count(left), thompson_state_count(right)), destination), initial_evidence, initial_captures, final_evidence, path_routine, path)
          capture_equivalent_transitive(
