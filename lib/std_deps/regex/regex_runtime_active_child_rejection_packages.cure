@group(:text)
mod Std.Regex.Runtime.ActiveChildRejectionPackages
  use Std.Regex.Runtime.LeafCluster27
  use Std.Regex.Runtime.LeafCluster23
  use Std.Regex.Runtime.LeafCluster04
  use Std.Regex.Runtime.LeafAuthorities
  use Std.Regex.Runtime.CursorShapeAuthority
  use Std.Regex.Runtime.CursorShape
  use Std.Regex.Core

  ## The exact-empty continuation is intentionally a separate first-order
  ## stage.  It prevents directional dispatch from reopening the complete
  ## outer existential merely to recover the commit/refutation package.
  type AtomicPathActiveChildExactEmptyPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathActiveChildExactEmptyPacked : (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> AtomicPathActiveChildExactEmptyPackage(depth, n, machine)

  ## The first stage of destination-rejection correspondence.  The exact
  ## skipped-empty package and selected-child package are captured while both
  ## constructors are open in the destination-rejection fold.  Keeping the
  ## selected shape as an index means a later directional constructor cannot
  ## pair a `Here` callback with a non-Here selected cursor.
  type AtomicPathActiveChildCanonicalPairPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildCanonicalPairPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> (empty: AtomicPathActiveChildExactEmptyPackage(depth, n, machine)) -> (selected: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, selected_shape)) -> (availability: AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)) -> AtomicPathActiveChildCanonicalPairPackage(depth, n, machine, selected_shape)

  ## The second stage gives the canonical pair a stable proof-only boundary.
  ## Availability is retained rather than projected to an optional existential:
  ## the unavailable case is itself the relevant result of the selected
  ## skipped-prefix traversal, and no downstream consumer may invent a pair.
  type AtomicPathActiveChildProofPairPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildProofPairPacked : (canonical: AtomicPathActiveChildCanonicalPairPackage(depth, n, machine, selected_shape)) -> AtomicPathActiveChildProofPairPackage(depth, n, machine, selected_shape)

  type AtomicPathActiveChildDirectionalPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathActiveChildDirectionalHerePacked : (proof: AtomicPathActiveChildProofPairPackage(depth, n, machine, LookaroundAdmittedStateCursorShapeHere())) -> AtomicPathActiveChildDirectionalPackage(depth, n, machine)
    AtomicPathActiveChildDirectionalTherePacked : {@erased failure_shape: LookaroundAdmittedStateCursorShape} -> {@erased selected_shape: LookaroundAdmittedStateCursorShape} -> (proof: AtomicPathActiveChildProofPairPackage(depth, n, machine, selected_shape)) -> (direction: AtomicPathActiveChildShapeThereAuthority(failure_shape, selected_shape)) -> AtomicPathActiveChildDirectionalPackage(depth, n, machine)
    AtomicPathActiveChildDirectionalReversePacked : {@erased failure_shape: LookaroundAdmittedStateCursorShape} -> {@erased selected_shape: LookaroundAdmittedStateCursorShape} -> (proof: AtomicPathActiveChildProofPairPackage(depth, n, machine, selected_shape)) -> (direction: AtomicPathCursorShapesLeftAfterAuthority(failure_shape, selected_shape)) -> AtomicPathActiveChildDirectionalPackage(depth, n, machine)

  ## A Here direction has already fixed the selected skipped-prefix shape to
  ## `Here`; opening that indexed package leaves exactly the empty selected
  ## prefix. This wrapper is owned by the package-native boundary so the
  ## dispatcher does not depend on the module that consumes the branch.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked : (source: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(depth, n, machine)

  ## Later-sibling and reverse directions retain their indexed authorities in
  ## the same fixed-Empty transport as Here.  The wrappers deliberately do
  ## not project or reclassify the selected shape; that correlation remains
  ## owned by the directional package constructed at the alignment site.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPacked : (source: AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPackage(depth, n, machine)

  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPacked : (source: AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPackage(depth, n, machine)

  ## The rejected-selection pair is published as an explicit availability
  ## result.  Consumers must open this result before attempting the recursive
  ## contradiction: the unavailable constructor is a real structural case,
  ## while the available constructor carries the exact existential pair made
  ## at the sibling-search construction site.
  @reducible
  fn atomic_path_active_child_rejection_availability_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    availability: AtomicPathRejectedSelectedTracePairAvailability(
      depth, n, machine
    ),
    unavailable_case: () -> result,
    available_case: (AtomicPathRejectedSelectedTracePairExistentialPackage(
      depth, n, machine
    )) -> result
  ) -> result = match availability
    AtomicPathRejectedSelectedTracePairUnavailable() -> unavailable_case()
    AtomicPathRejectedSelectedTracePairAvailable(pair) -> available_case(pair)

  ## Eliminate the child failure carried by an available pair only into
  ## `Empty`.  The failure constructors are proof-only control information;
  ## restricting every branch to contradiction prevents this helper from
  ## turning an erased proof tag into runtime behavior.  The destination-
  ## rejected branch returns the original existential so the recursive
  ## consumer can open the retained child proof and selected trace together.
  @reducible
  fn atomic_path_active_child_rejection_pair_failure_elim(
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    pair: AtomicPathRejectedSelectedTracePairExistentialPackage(
      depth, n, machine
    ),
    input_exhausted_case: () -> Empty,
    exact_accepted_case: () -> Empty,
    destinations_exhausted_case: () -> Empty,
    destination_rejected_case: (
      AtomicPathRejectedSelectedTracePairExistentialPackage(depth, n, machine)
    ) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match pair
    AtomicPathRejectedSelectedTracePairExistentialPacked(package) -> match package
      AtomicPathRejectedSelectedTracePairPacked(
        _, _, _, _, _, _, _, _, _, _, _, _, _, _,
        child_failure,
        _, _, _, _, _, _
      ) -> match child_failure
        AtomicPathInputExhausted(_, _) -> input_exhausted_case()
        AtomicPathExactAcceptedWithInput(_, _, _, _) -> exact_accepted_case()
        AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> destinations_exhausted_case()
        AtomicPathDestinationRejected(
          _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
        ) -> destination_rejected_case(pair)
end

  ## Directional pair consumers retain the branch package while opening its
  ## availability.  This is the first proof-facing boundary: the recursive
  ## induction receives the published sibling pair and the exact directional
  ## package that carried it, rather than reconstructing either from erased
  ## failure evidence.
  @reducible
  fn atomic_path_active_child_rejection_here_empty_pair_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(
      depth, n, machine
    ),
    unavailable_case: () -> result,
    available_case: (
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
        depth, n, machine
      ),
      AtomicPathRejectedSelectedTracePairExistentialPackage(depth, n, machine)
    ) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked(source) -> match source
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(_, _, availability) ->
        atomic_path_active_child_rejection_availability_dispatch(
          availability,
          unavailable_case,
          fn(pair) -> available_case(source, pair)
        )

  @reducible
  fn atomic_path_active_child_rejection_there_empty_pair_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPackage(
      depth, n, machine
    ),
    unavailable_case: () -> result,
    available_case: (
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
        depth, n, machine
      ),
      AtomicPathRejectedSelectedTracePairExistentialPackage(depth, n, machine)
    ) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPacked(source) -> match source
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePacked(_, _, _, _, _, availability) ->
        atomic_path_active_child_rejection_availability_dispatch(
          availability,
          unavailable_case,
          fn(pair) -> available_case(source, pair)
        )

  @reducible
  fn atomic_path_active_child_rejection_reverse_empty_pair_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPackage(
      depth, n, machine
    ),
    unavailable_case: () -> result,
    available_case: (
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
        depth, n, machine
      ),
      AtomicPathRejectedSelectedTracePairExistentialPackage(depth, n, machine)
    ) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPacked(source) -> match source
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePacked(_, _, _, _, _, availability) ->
        atomic_path_active_child_rejection_availability_dispatch(
          availability,
          unavailable_case,
          fn(pair) -> available_case(source, pair)
        )

  ## Directional consumers refine only the relevant authority.  The payload
  ## remains the exact package built at the alignment site, so later proof
  ## steps cannot recover a direction by rematching erased cursor evidence.
  @reducible
  fn atomic_path_active_child_rejection_there_empty_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPackage(depth, n, machine),
    same_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(depth, n, machine)) -> result,
    right_after_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(depth, n, machine)) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPacked(source) -> match source
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePacked(_, _, _, _, direction, _) -> match direction
        AtomicPathActiveChildShapeThereSameDrop(_) -> same_case(source)
        AtomicPathActiveChildShapeThereRightAfter(_) -> right_after_case(source)

  @reducible
  fn atomic_path_active_child_rejection_reverse_empty_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPackage(depth, n, machine),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(depth, n, machine)) -> result,
    drop_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(depth, n, machine)) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPacked(source) -> match source
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePacked(_, _, _, _, direction, _) -> match direction
        AtomicPathCursorShapesLeftAfterHere() -> here_case(source)
        AtomicPathCursorShapesLeftAfterDrop(_) -> drop_case(source)

  ## Constructor-directed dispatch for the package-native sibling of the old
  ## nullary canonical rejection dispatcher.  Every callback receives the
  ## existing typed branch package reconstructed from one correlated carrier;
  ## no erased evidence is used to choose runtime control and no nullary
  ## callback can discard the child/selected correlation before entry.
  @reducible
  fn atomic_path_active_child_rejection_package_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathActiveChildDirectionalPackage(depth, n, machine),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine), AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(depth, n, machine)) -> result,
    there_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine), AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPackage(depth, n, machine)) -> result,
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine), AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPackage(depth, n, machine)) -> result
  ) -> result = match package
    AtomicPathActiveChildDirectionalHerePacked(
      AtomicPathActiveChildProofPairPacked(
        AtomicPathActiveChildCanonicalPairPacked(
          aligned,
          AtomicPathActiveChildExactEmptyPacked(empty),
          selected,
          availability
        )
      )
    ) -> match selected
      AtomicPathSkippedPrefixCursorShapedExistentialPacked(selected_payload) -> match selected_payload
        AtomicPathSkippedPrefixCursorShapedEmptyPacked(structure) -> match structure
          AtomicPathSkippedPrefixStructureEmptyPacked(_) -> here_case(aligned,
            AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked(
              AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(
                empty,
                selected,
                availability
              )
            )
          )
    AtomicPathActiveChildDirectionalTherePacked(
      AtomicPathActiveChildProofPairPacked(
        AtomicPathActiveChildCanonicalPairPacked(
          aligned,
          AtomicPathActiveChildExactEmptyPacked(empty),
          selected,
          availability
        )
      ),
      direction
    ) -> there_case(aligned,
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPacked(
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePacked(
          empty,
          selected,
          direction,
          availability
        )
      )
    )
    AtomicPathActiveChildDirectionalReversePacked(
      AtomicPathActiveChildProofPairPacked(
        AtomicPathActiveChildCanonicalPairPacked(
          aligned,
          AtomicPathActiveChildExactEmptyPacked(empty),
          selected,
          availability
        )
      ),
      direction
    ) -> reverse_case(aligned,
      AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPacked(
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePacked(
          empty,
          selected,
          direction,
          availability
        )
      )
    )
end
