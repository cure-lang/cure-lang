  ## When a sibling tail rejects an accepted candidate, its exact child
  ## refutation can be consumed by the same accepted-child eliminator. The
  ## parent rejection is retained as an index witness; the tail constructor
  ## exposes the child proof at this construction site. The accepted child
  ## contradiction is routed through the generic dispatcher: the parent
  ## selected suffix is a `Drop(head, ...)`, so the indexed cursor selects the
  ## tail result rather than treating this accepted sibling as head-selected.
  fn atomic_path_tail_rejection_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased head: LookaroundAdmittedState(n)},
    tail_routine: List(EvidenceInstruction),
    tail_constraints: List(BoundaryConstraint),
    tail_assertion_routine: List(ExtendedInstruction),
    tail_assertion_markers: List(EvidenceInstruction),
    tail_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    @erased _failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty =
    let accepted_candidate: LookaroundAdmittedState(n) = LookaroundAdmittedAccepted(
      tail_routine,
      tail_constraints,
      tail_assertion_routine,
      tail_assertion_markers,
      tail_nested_decisions
    )
    atomic_path_rejected_tail_fold_to_accepted(
      machine,
      char,
      rest,
      after_input,
      source,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      accepted_candidate,
      tail_failure,
      tail_routine,
      tail_constraints,
      tail_assertion_routine,
      tail_assertion_markers,
      tail_nested_decisions,
      _tail_selected_suffix,
      path
    )

  ## A non-empty rejected tail may reach a recursively rejected active child.
  ## Both failure kinds are fixed by the constructor indices before this
  ## boundary is entered; matching them therefore introduces no runtime tag.
  ## The selected transition carries the child cursor and trace needed by the
  ## next child-alignment theorem, which is supplied as a proof-only closure.
  fn atomic_path_tail_active_child_rejection_excludes_selected_suffix_base(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased head: LookaroundAdmittedState(n),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    @erased tail_remaining: List(LookaroundAdmittedState(n)),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_current: List(LookaroundAdmittedState(n)),
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      AtomicPathFailureDestinationRejected()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_head: LookaroundAdmittedState(n),
    child_failure_tail: List(LookaroundAdmittedState(n)),
    child_failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      Cons(child_failure_head, child_failure_tail)
    ),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    {child_selected_current: List(LookaroundAdmittedState(n))},
    child_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    child_left_case: () -> Empty,
    child_left_tail_case: () -> Empty,
    child_right_case: () -> Empty
  ) -> Empty = match child_rest
    Nil() -> match child_current
      Nil() -> match child_failure
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      Cons(child_candidate, child_failure_remaining) -> match tail_failure
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_scope_alignment, _, _, _, _) -> match path
          AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match child_scope_alignment
            LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) ->
              atomic_path_active_child_rejection_singleton_aligned_excludes_trace(
                child_whole,
                child_candidate,
                child_failure,
                child_failure_suffix,
                reflexive(child_whole),
                atomic_path_failed_selected_child_suffix(
                  child_failure_origin_equivalence,
                  child_failure_origin_canonical,
                  child_selected_origin_canonical,
                  child_selected_suffix
                ),
                child_path,
                child_left_case,
                child_right_case
              )
    Cons(_, _) -> match tail_failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_scope_alignment, _, _, _, _) -> match path
        AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match child_scope_alignment
          LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) ->
            atomic_path_active_child_selection_package_consume(
              machine,
              char,
              child_char,
              child_rest,
              after_input,
              source,
              history,
              capture_context,
              policy,
              scope_depth,
              prefix_mode,
              reversed_prefix,
              atomic_path_active_child_selection_package(
                machine,
                char,
                Cons(child_char, child_rest),
                after_input,
                source,
                history,
                capture_context,
                policy,
                scope_depth,
                prefix_mode,
                reversed_prefix,
                active_state,
                active_routine,
                active_constraints,
                active_assertion_routine,
                active_assertion_markers,
                active_nested_decisions,
                path
              ),
              atomic_path_active_child_rejection_canonical_dispatch(
                child_failure_origin_equivalence,
                child_failure_origin_canonical,
                child_failure_suffix,
                child_selected_origin_canonical,
                child_selected_suffix,
                LookaroundAdmittedNonemptyPacked(
                  child_failure_head,
                  child_failure_tail,
                  child_failure_nonempty_equivalence
                ),
                child_left_case,
                child_left_tail_case,
                child_right_case
              )
            )

  @reducible
  fn atomic_path_active_child_rejection_excludes_destination_rejected(
    {n: Nat},
    @erased failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure_current: List(LookaroundAdmittedState(n)),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    @erased selected_whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_tail_fold(
    atomic_path_active_child_alignment_from_nonempty(
      failure_nonempty,
      failure_suffix,
      selected_whole_equivalence,
      selected_suffix
    ),
    left_case,
    left_tail_case,
    right_case
  )

  ## Generic selected-trace dispatcher for a rejected destination. The parent
  ## refutation is indexed at `Cons(candidate, remaining)` while the selected
  ## trace may begin at either that candidate or a later sibling. The cursor
  ## relation selects a proof-only head or tail branch; the tail branch keeps
  ## the recursive failure, suffix, and selected path together for the next
  ## induction step. No runtime state tag or erased failure payload is
  ## inspected.
  @reducible
  fn atomic_path_destination_rejection_excludes_recursive_tail(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    @erased matched: List(Char),
    @erased remaining_input: List(Char),
    @erased routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      candidate_current
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    ),
    head_case: result
  ) -> AtomicPathSelectedTailDispatch(
    result,
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(state),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining,
    candidate_current,
    matched,
    remaining_input,
    routine
  ) = atomic_path_destination_rejection_selected_suffix_dispatch(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    failure,
    matched,
    remaining_input,
    routine,
    selection_from_current,
    path,
    head_case
  )
end
