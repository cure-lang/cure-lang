  public use Std.Regex.Syntax.Emitter.NamedPrimitives
  public use Std.Regex.Syntax.Emitter.Options
  public use Std.Regex.Syntax.Emitter.LookaroundPrimitives
  public use Std.Regex.Syntax.Emitter.Foundation
