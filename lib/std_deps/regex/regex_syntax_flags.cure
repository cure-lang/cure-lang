## Parser helpers for regex literal modifiers such as `i`, `m`, and `u`.
@group(:text)
mod Std.Regex.Syntax.Flags
  use Std.Regex.Syntax.Model

  fn parse_literal_flags(flags: List(Char), options: LiteralRegexOptions) -> LiteralFlags = match flags
    [] -> LiteralFlagsParsed(options)
    ['i' | rest] -> parse_literal_flags(rest, enable_modifier(CaselessModifier, options))
    ['m' | rest] -> parse_literal_flags(rest, enable_modifier(MultilineModifier, options))
    ['s' | rest] -> parse_literal_flags(rest, enable_modifier(DotallModifier, options))
    ['x' | rest] -> parse_literal_flags(rest, enable_modifier(ExtendedModifier, options))
    ['u' | rest] -> parse_literal_flags(rest, enable_modifier(UnicodeModifier, options))
    ['f' | rest] -> parse_literal_flags(rest, enable_modifier(FirstlineModifier, options))
    ['U' | rest] -> parse_literal_flags(rest, enable_modifier(UngreedyModifier, options))
    ['E' | rest] -> parse_literal_flags(rest, enable_modifier(ExportModifier, options))
    [_ | _] -> LiteralFlagsInvalid(:InvalidRegexModifier)

  fn prepare_literal(pattern: List(Char), options: LiteralRegexOptions) -> LiteralPrepared =
    let mapped = pickup
      has_modifier(options, ExtendedModifier) -> strip_extended(pattern, Z())
      else -> map_literal_source(pattern, Z())
    match mapped
      LiteralSourceMap(chars, positions) -> LiteralPrepared(chars, positions, literal_length(pattern))

  fn prepend_literal_source(char: Char, position: Nat, mapped: LiteralSourceMap) -> LiteralSourceMap = match mapped
    LiteralSourceMap(chars, positions) -> LiteralSourceMap([char | chars], [position | positions])

  fn map_literal_source(input: List(Char), position: Nat) -> LiteralSourceMap = match input
    [] -> LiteralSourceMap([], [])
    [char | rest] -> prepend_literal_source(char, position, map_literal_source(rest, S(position)))

  fn strip_extended(input: List(Char), position: Nat) -> LiteralSourceMap = match input
    [] -> LiteralSourceMap([], [])
    [char | rest] -> pickup
      char == '\\' -> prepend_literal_source(char, position, strip_extended_escaped(rest, S(position)))
      char == '[' -> prepend_literal_source(char, position, strip_extended_class(rest, S(position)))
      char == '#' -> strip_extended_comment(rest, S(position))
      literal_extended_space(char) -> strip_extended(rest, S(position))
      else -> prepend_literal_source(char, position, strip_extended(rest, S(position)))

  fn literal_extended_space(char: Char) -> Bool =
    char == ' ' or char == '\t' or char == '\n' or char == '\r' or
      char == '\f' or char == '\v'

  fn strip_extended_escaped(input: List(Char), position: Nat) -> LiteralSourceMap = match input
    [] -> LiteralSourceMap([], [])
    [char | rest] -> prepend_literal_source(char, position, strip_extended(rest, S(position)))

  fn strip_extended_class(input: List(Char), position: Nat) -> LiteralSourceMap = match input
    [] -> LiteralSourceMap([], [])
    [char | rest] -> pickup
      char == '\\' -> prepend_literal_source(char, position, strip_extended_class_escaped(rest, S(position)))
      char == ']' -> prepend_literal_source(char, position, strip_extended(rest, S(position)))
      else -> prepend_literal_source(char, position, strip_extended_class(rest, S(position)))

  fn strip_extended_class_escaped(input: List(Char), position: Nat) -> LiteralSourceMap = match input
    [] -> LiteralSourceMap([], [])
    [char | rest] -> prepend_literal_source(char, position, strip_extended_class(rest, S(position)))

  fn strip_extended_comment(input: List(Char), position: Nat) -> LiteralSourceMap = match input
    [] -> LiteralSourceMap([], [])
    [char | rest] -> pickup
      char == '\n' -> strip_extended(rest, S(position))
      else -> strip_extended_comment(rest, S(position))
