## Compile-time emitter for regex syntax trees. It turns parsed patterns into
## the matcher representation consumed by `Std.Regex`.
@group(:text)
mod Std.Regex.Syntax.Emitter.Lookaround
  use Std.Regex.Syntax.Emitter.Assertions

  use Std.Regex.Syntax.Emitter.Options

  use Std.Regex.Syntax.Emitter.LookaroundPrimitives

  use Std.Regex.Syntax.Emitter.Foundation

  use Std.Regex.Syntax.Model.LiteralBranchReset

  use Std.Regex.Syntax.Model.Width

  use Std.Regex.Syntax.Model.Options

  use Std.Regex.Syntax.Model.Modifiers

  use Std.Regex.Syntax.Model.ClassPredicates

  use Std.Regex.Syntax.Model.Shape

  use Std.Regex.Syntax.Model.Utilities

  use Std.Regex.Syntax.Model.ClassKinds

  use Std.Regex.Syntax.Model.Predicates

  use Std.Regex.Syntax.Model.Types

  use Std.Regex.Syntax.Model

  use Std.String

  use Std.Syntax

  fn emit_lookaround_staged_compilation(pattern: LiteralPattern, options: LiteralRegexOptions) -> Syntax = match pattern
    LiteralEmpty -> runtime_call("LookaroundEmpty", [])
    LiteralExact(char) -> runtime_call("LookaroundPredicate", [runtime_call("option_exact_test", [char_literal(char), bool_literal(has_modifier(options, CaselessModifier)), bool_literal(has_modifier(options, UnicodeModifier))])])
    LiteralAny -> runtime_call("LookaroundPredicate", [runtime_call("dot_test_with_policy", [bool_literal(has_modifier(options, DotallModifier)), emit_newline_policy(options)])])
    LiteralClass(chars, ranges, kinds, negated) -> runtime_call("LookaroundPredicate", [runtime_call("extended_property_class_test", [emit_chars(chars), emit_ranges(ranges), emit_class_kinds(kinds), emit_unicode_property_matches(literal_class_properties(kinds)), emit_posix_class_matches(literal_class_posix(kinds)), bool_literal(negated), bool_literal(has_modifier(options, CaselessModifier)), bool_literal(has_modifier(options, UnicodeModifier))])])
    LiteralProperty(property, negated) -> runtime_call("LookaroundPredicate", [runtime_call("unicode_property_test", [emit_unicode_property(property), bool_literal(negated)])])
    LiteralDigit(negated) -> runtime_call("LookaroundPredicate", [runtime_call("digit_options_test", [bool_literal(negated), bool_literal(has_modifier(options, UnicodeModifier))])])
    LiteralWord(negated) -> runtime_call("LookaroundPredicate", [runtime_call("word_options_test", [bool_literal(negated), bool_literal(has_modifier(options, UnicodeModifier))])])
    LiteralSpace(negated) -> runtime_call("LookaroundPredicate", [runtime_call("space_options_test", [bool_literal(negated), bool_literal(has_modifier(options, UnicodeModifier))])])
    LiteralHorizontal(negated) -> runtime_call("LookaroundPredicate", [runtime_call("horizontal_test", [bool_literal(negated)])])
    LiteralVertical(negated) -> runtime_call("LookaroundPredicate", [runtime_call("vertical_test", [bool_literal(negated)])])
    LiteralLineBreak() -> emit_lookaround_line_break_compilation(options)
    LiteralSequence(left, right) -> runtime_call("LookaroundConcat", [emit_lookaround_staged_compilation(left, options), emit_lookaround_staged_compilation(right, options)])
    LiteralAlternate(left, right) -> runtime_call("LookaroundAlternate", [emit_lookaround_staged_compilation(left, options), emit_lookaround_staged_compilation(right, options), bool_literal(false)])
    LiteralConditional(reference, yes, no) -> emit_lookaround_conditional(reference, yes, no, options)
    LiteralAtomic(inner) -> runtime_call("LookaroundAtomic", [emit_lookaround_staged_compilation(inner, options)])
    LiteralLookahead(polarity, inner) -> runtime_call("LookaroundBoundary", [runtime_call("lookahead_constraint", [emit_lookaround_staged_compilation(inner, options), emit_lookaround_polarity(polarity), emit_newline_policy(options)])])
    LiteralLookbehind(polarity, inner) -> runtime_call("LookaroundBoundary", [runtime_call("lookbehind_constraint", [emit_lookaround_staged_compilation(inner, options), emit_lookaround_polarity(polarity), emit_nat(literal_pattern_exact_width_value(inner)), emit_newline_policy(options)])])
    LiteralBranchReset(arms) -> emit_lookaround_staged_compilation(literal_branch_reset_alternate(arms), options)
    LiteralRepeat(inner, lazy) -> runtime_call("LookaroundRepeat", [emit_lookaround_staged_compilation(inner, options), bool_literal(lazy != has_modifier(options, UngreedyModifier))])
    LiteralPlus(inner, lazy) -> runtime_call("LookaroundConcat", [emit_lookaround_staged_compilation(inner, options), runtime_call("LookaroundRepeat", [emit_lookaround_staged_compilation(inner, options), bool_literal(lazy != has_modifier(options, UngreedyModifier))])])
    LiteralOptional(inner, lazy) -> runtime_call("LookaroundAlternate", [emit_lookaround_staged_compilation(inner, options), runtime_call("LookaroundEmpty", []), bool_literal(lazy != has_modifier(options, UngreedyModifier))])
    LiteralBoundedExact(inner, count) -> emit_lookaround_bounded_exact(inner, count, options)
    LiteralBoundedAtLeast(inner, count, lazy) -> emit_lookaround_bounded_at_least(inner, count, lazy != has_modifier(options, UngreedyModifier), options)
    LiteralBoundedBetween(inner, minimum, maximum, lazy) -> emit_lookaround_bounded_between(inner, minimum, maximum, lazy != has_modifier(options, UngreedyModifier), options)
    LiteralCapture(inner) -> runtime_call("LookaroundGroup", [emit_lookaround_staged_compilation(inner, options)])
    LiteralNamedCapture(_, inner) -> runtime_call("LookaroundGroup", [emit_lookaround_staged_compilation(inner, options)])
    LiteralCaptureIndexed(slot, _, inner) -> runtime_call("LookaroundGroupSlot", [emit_nat(slot), emit_lookaround_staged_compilation(inner, options)])
    LiteralStart -> runtime_call("LookaroundBoundary", [emit_staged_start_constraint(options)])
    LiteralEnd -> runtime_call("LookaroundBoundary", [emit_staged_end_constraint(options)])
    LiteralAbsoluteStart -> runtime_call("LookaroundBoundary", [runtime_call("subject_start_constraint_with_policy", [emit_newline_policy(options)])])
    LiteralStrictEnd -> runtime_call("LookaroundBoundary", [runtime_call("strict_end_constraint_with_policy", [emit_newline_policy(options)])])
    LiteralFinalEnd -> runtime_call("LookaroundBoundary", [runtime_call("subject_end_constraint_with_policy", [emit_newline_policy(options)])])
    LiteralWordBoundary(negated) -> runtime_call("LookaroundBoundary", [emit_staged_word_constraint(negated, options)])
    LiteralConfigured(_, inner) -> emit_lookaround_staged_compilation(inner, options)
    LiteralScopedOptions(enabled, disabled, inner) -> emit_lookaround_staged_compilation(inner, apply_literal_scoped_options(enabled, disabled, options))

  fn emit_lookaround_staged_compilation_or_empty(pattern: Option(LiteralPattern), options: LiteralRegexOptions) -> Syntax = match pattern
    None() -> runtime_call("LookaroundEmpty", [])
    Some(inner) -> emit_lookaround_staged_compilation(inner, options)

  fn emit_lookaround_conditional(reference: LiteralConditionalReference, yes: LiteralPattern, no: Option(LiteralPattern), options: LiteralRegexOptions) -> Syntax = match reference
    LiteralAssertionCondition(assertion) -> emit_lookaround_assertion_conditional(assertion, yes, no, options)
    LiteralConditionalSlotReference(slot) -> runtime_call("LookaroundAlternate", [runtime_call("LookaroundGuard", [emit_nat(slot), bool_literal(true), emit_lookaround_staged_compilation(yes, options)]), runtime_call("LookaroundGuard", [emit_nat(slot), bool_literal(false), emit_lookaround_staged_compilation_or_empty(no, options)]), bool_literal(false)])
    LiteralConditionalNameReference(_) -> runtime_call("LookaroundAlternate", [emit_lookaround_staged_compilation(yes, options), emit_lookaround_staged_compilation_or_empty(no, options), bool_literal(false)])

  fn emit_lookaround_assertion_conditional(assertion: LiteralPattern, yes: LiteralPattern, no: Option(LiteralPattern), options: LiteralRegexOptions) -> Syntax =
    runtime_call("LookaroundAlternate", [
      emit_assertion_guarded_lookaround(assertion, yes, true, options),
      emit_assertion_guarded_lookaround(assertion, literal_option_or_empty(no), false, options),
      bool_literal(false)
    ])

  fn emit_assertion_guarded_lookaround(assertion: LiteralPattern, branch: LiteralPattern, positive: Bool, options: LiteralRegexOptions) -> Syntax =
    runtime_call("LookaroundBoundaryGuard", [emit_assertion_constraint(assertion, positive, options), emit_lookaround_staged_compilation(branch, options)])

  fn emit_assertion_constraint(assertion: LiteralPattern, positive: Bool, options: LiteralRegexOptions) -> Syntax = match assertion
    LiteralLookahead(polarity, inner) -> runtime_call("lookahead_constraint", [emit_lookaround_staged_compilation(inner, options), emit_assertion_polarity(polarity, positive), emit_newline_policy(options)])
    LiteralLookbehind(polarity, inner) -> runtime_call("lookbehind_constraint", [emit_lookaround_staged_compilation(inner, options), emit_assertion_polarity(polarity, positive), emit_nat(literal_pattern_exact_width_value(inner)), emit_newline_policy(options)])
    _ -> runtime_call("lookahead_constraint", [emit_lookaround_staged_compilation(assertion, options), bool_literal(positive), emit_newline_policy(options)])

  fn emit_lookaround_bounded_exact(inner: LiteralPattern, count: Nat, options: LiteralRegexOptions) -> Syntax = match count
    Z() -> runtime_call("LookaroundEmpty", [])
    S(rest) -> runtime_call("LookaroundConcat", [emit_lookaround_staged_compilation(inner, options), emit_lookaround_bounded_exact(inner, rest, options)])

  fn emit_lookaround_bounded_at_least(inner: LiteralPattern, count: Nat, lazy: Bool, options: LiteralRegexOptions) -> Syntax = match count
    Z() -> runtime_call("LookaroundRepeat", [emit_lookaround_staged_compilation(inner, options), bool_literal(lazy)])
    S(rest) -> runtime_call("LookaroundConcat", [emit_lookaround_staged_compilation(inner, options), emit_lookaround_bounded_at_least(inner, rest, lazy, options)])

  fn emit_lookaround_bounded_between(inner: LiteralPattern, minimum: Nat, maximum: Nat, lazy: Bool, options: LiteralRegexOptions) -> Syntax = match minimum
    Z() -> emit_lookaround_bounded_up_to(inner, maximum, lazy, options)
    S(rest) -> match maximum
      Z() -> emit_lookaround_bounded_exact(inner, S(rest), options)
      S(maximum_rest) -> runtime_call("LookaroundConcat", [emit_lookaround_staged_compilation(inner, options), emit_lookaround_bounded_between(inner, rest, maximum_rest, lazy, options)])

  fn emit_lookaround_bounded_up_to(inner: LiteralPattern, maximum: Nat, lazy: Bool, options: LiteralRegexOptions) -> Syntax = match maximum
    Z() -> runtime_call("LookaroundEmpty", [])
    S(rest) -> runtime_call("LookaroundConcat", [runtime_call("LookaroundAlternate", [emit_lookaround_staged_compilation(inner, options), runtime_call("LookaroundEmpty", []), bool_literal(lazy)]), emit_lookaround_bounded_up_to(inner, rest, lazy, options)])
end
