  ## The skipped-prefix kind fixes the evidence constructor, so these erased
  ## eliminators expose only structural facts needed by the recursive mixed
  ## sibling fold. No runtime discriminator or second traversal is added.
  @reducible
  fn atomic_path_skipped_prefix_empty_equivalent(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    @erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, AtomicPathSkippedPrefixEmptyKind())
  ) -> Equivalent(List(LookaroundAdmittedState(n)), front, current) = match evidence
    AtomicPathSkippedPrefixEmpty() -> reflexive(current)

  type AtomicPathSkippedPrefixTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), front: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), kind: AtomicPathSkippedPrefixKind)
    AtomicPathSkippedPrefixTailPacked : (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind)) -> AtomicPathSkippedPrefixTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind)

  ## Constructor-refined view of the single escaped skipped head. The cause,
  ## canonical child origin, cursor, scope, and escape comparison remain one
  ## erased correlated witness while the commit-cause kind is fixed outside.
  type AtomicPathEscapedSkippedHeadPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), front: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), kind: AtomicPathSkippedPrefixKind)
    AtomicPathEscapedSkippedHeadPacked : (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind)) -> AtomicPathEscapedSkippedHeadPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind)

  ## Relevant-package form of the aligned input-exhaustion commit leaf. The
  ## outer active constructor exposes its recursive child package directly;
  ## an active child with empty input has no package constructor.
  @reducible
  fn atomic_path_commit_after_input_exhausted_excludes_aligned_selected_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased active_state: Bounded(n)},
    {@erased active_routine: List(EvidenceInstruction)},
    {@erased active_constraints: List(BoundaryConstraint)},
    {@erased active_assertion_routine: List(ExtendedInstruction)},
    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased _cause: AtomicPathCommitCause(
      depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
      commit_depth,
      AtomicPathCommitAfterFailureKind(child_prefix_kind, AtomicPathFailureInputExhausted())
    ),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(
      depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedPathTracePackage(
      depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
      matched, remaining_input, selected_routine, path
    )
  ) -> Empty = match trace_package
    AtomicSelectedPathTracePrefixDonePacked() -> impossible
    AtomicSelectedPathTraceExactDonePacked() -> impossible
    AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix_package, _) -> match suffix_package
      AtomicSelectedPathTracePrefixDonePacked() -> impossible
      AtomicSelectedPathTraceExactDonePacked() -> impossible
      AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  @reducible
  fn atomic_path_commit_after_exact_accepted_excludes_aligned_selected_trace(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased child_char: Char},
    {@erased child_rest: List(Char)}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased accepted_routine: List(EvidenceInstruction)},
    {@erased accepted_constraints: List(BoundaryConstraint)},
    {@erased accepted_assertion_routine: List(ExtendedInstruction)},
    {@erased accepted_assertion_markers: List(EvidenceInstruction)},
    {@erased accepted_nested_decisions: List(LookaroundNestedDecision)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased cause: AtomicPathCommitCause(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, False(), reversed_prefix, whole, Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining), commit_depth, AtomicPathCommitAfterFailureKind(child_prefix_kind, AtomicPathFailureExactAccepted())),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, False(), reversed_prefix, Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining), matched, remaining_input, selected_routine)
  ) -> Empty = match cause
    AtomicPathCommitAfterFailure(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match path
      AtomicSelectedPrefixDone() -> impossible
      AtomicSelectedExactDone() -> impossible
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_trace) -> match child_trace
        AtomicSelectedPrefixDone() -> impossible
        AtomicSelectedExactDone() -> impossible
        AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
        AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## Relevant-package dual for an accepted child rejected in exact mode while
  ## child input remains. No accepted-thread recursive package can inhabit
  ## that index, so the commit cause remains proof-only context.
  @reducible
  fn atomic_path_commit_after_exact_accepted_excludes_aligned_selected_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased child_char: Char},
    {@erased child_rest: List(Char)}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased accepted_routine: List(EvidenceInstruction)},
    {@erased accepted_constraints: List(BoundaryConstraint)},
    {@erased accepted_assertion_routine: List(ExtendedInstruction)},
    {@erased accepted_assertion_markers: List(EvidenceInstruction)},
    {@erased accepted_nested_decisions: List(LookaroundNestedDecision)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased _cause: AtomicPathCommitCause(
      depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input,
      ThreadActive(source), history, capture_context, policy, scope_depth,
      False(), reversed_prefix, whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      commit_depth,
      AtomicPathCommitAfterFailureKind(child_prefix_kind, AtomicPathFailureExactAccepted())
    ),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(
      depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input,
      ThreadActive(source), history, capture_context, policy, scope_depth,
      False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedPathTracePackage(
      depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input,
      ThreadActive(source), history, capture_context, policy, scope_depth,
      False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      matched, remaining_input, selected_routine, path
    )
  ) -> Empty = match trace_package
    AtomicSelectedPathTracePrefixDonePacked() -> impossible
    AtomicSelectedPathTraceExactDonePacked() -> impossible
    AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix_package, _) -> match suffix_package
      AtomicSelectedPathTracePrefixDonePacked() -> impossible
      AtomicSelectedPathTraceExactDonePacked() -> impossible
      AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## Constructor-refined view of a rejected skipped head. The child prefix,
  ## refutation, origin, cursor, scope, and continuation remain erased and
  ## correlated in one package; no proof payload crosses into runtime data.
  type AtomicPathRejectedSkippedHeadPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), front: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), kind: AtomicPathSkippedPrefixKind)
    AtomicPathRejectedSkippedHeadPacked : (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind)) -> AtomicPathRejectedSkippedHeadPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind)

  ## A root-relative exhausted-destinations child has no skipped child cursor:
  ## its failure whole is definitionally the empty current. Canonical origin
  ## alignment transports the selected child suffix to that empty spine, so a
  ## selected trace at the rejected parent head is impossible as well.
  @reducible
  fn atomic_path_active_child_destinations_exhausted_excludes_trace_erased(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)}, {@erased char: Char},
    {@erased rest: List(Char)}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)}, {@erased remaining_input: List(Char)},
    {@erased routine: List(ExtendedInstruction)},
    @erased _failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil(), AtomicPathFailureDestinationsExhausted()),
    @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), matched, remaining_input, routine)
  ) -> result = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## Correlated recursive state for the propagated commit/prefix cases. The
  ## commit origin and cursor travel with both exact tail proofs, preventing a
  ## caller from pairing evidence produced at different sibling suffixes.
  type AtomicPathCommitSkippedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), front: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitSkippedTailPacked : (@erased commit_depth: Nat) -> {@erased origin: List(LookaroundAdmittedState(n))} -> (@erased origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, origin)) -> (@erased origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, origin)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, front)) -> (@erased commit_kind: AtomicPathCommitCauseKind) -> (@erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, commit_depth, commit_kind)) -> (@erased skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased skipped: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, skipped_kind)) -> AtomicPathCommitSkippedTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current)

  ## Constructor-refined projection of the exact skipped prefix that precedes
  ## a suffix-local failure. Keeping it in an erased package avoids returning
  ## erased evidence through a relevant expression, which E104 forbids.
  type AtomicPathFailureSkippedPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), skipped_kind: AtomicPathSkippedPrefixKind)
    AtomicPathFailureSkippedPacked : (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, whole, current, skipped_kind)) -> AtomicPathFailureSkippedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, skipped_kind)

  fn atomic_runtime_accepts(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> Bool = match machine
    MkPatternMachine(starts, _) -> match atomic_runtime_initial_members(n, machine, input, after_input, filter_boundary_states(starts, initial_position_boundary(position, append_characters(input, after_input))))
      AtomicSearchYes() -> true
      AtomicSearchNo() -> false
      AtomicSearchCommit(_) -> false

  ## Atomic assertion search is the same finite ordered search as the ordinary
  ## assertion path, but every destination is first passed through the
  ## depth-aware lookaround constraint filter. This is what makes an assertion
  ## inside an atomic scope observable without introducing a host backtracking
  ## stack or rebuilding a child machine per attempt.
  fn atomic_lookaround_accepting_from(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat) -> AtomicSearchResult = match input
    [] -> match state
      ThreadAccepted() -> AtomicSearchYes()
      ThreadActive(_) -> AtomicSearchNo()
    [char | rest] -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, state, history, capture_context, policy, scope_depth, lookaround_machine_destinations(depth, n, machine, state, char, rest, after_input, history, capture_context, policy))

  fn atomic_lookaround_accepting_members(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, destinations: List(MachineState(n))) -> AtomicSearchResult = match destinations
    [] -> AtomicSearchNo()
    [Active(state, routine, _) | remaining] -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, scope_depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_lookaround_accepting_from(depth, n, machine, rest, after_input, ThreadActive(state), history_push_bounded(history, char), append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
    [Accepted(routine, _) | remaining] -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, scope_depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_lookaround_accepting_from(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
end
