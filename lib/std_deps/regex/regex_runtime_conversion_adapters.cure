@group(:text)
mod Std.Regex.Runtime.ConversionAdapters
  use Std.Decision
  use Std.Sigma
  use Std.Equivalent
  use Std.Bounded
  use Std.Syntax
  use Std.String
  use Std.List
  use Std.Option
  use Std.Char
  use Std.Regex.Core
  use Std.Regex.Core.Limits
  use Std.Regex.Core.Evidence
  use Std.Regex.Core.Newline
  use Std.Regex.Core.Initial
  use Std.Regex.Core.Boundary
  use Std.Regex.Core.Capture
  use Std.Regex.Runtime.Split
  use Std.Regex.Runtime.Named
  use Std.Regex.Runtime.ClassKinds
  use Std.Regex.Runtime.AtomicDiagnostics
  use Std.Regex.Runtime.Boundaries
  use Std.Regex.Runtime.CaptureConditions
  use Std.Regex.Runtime.TransitionRows
  use Std.Regex.Runtime.StateOps
  use Std.Regex.Runtime.PatternMachines
  use Std.Regex.Runtime.StagedOps
  use Std.Regex.Runtime.Compilation
  use Std.Regex.Runtime.MachineLaws
  use Std.Regex.Runtime.MachineFilters
  use Std.Regex.Runtime.SubjectContext
  use Std.Regex.Runtime.CharacterPredicates
  use Std.Regex.Runtime.Position
  use Std.Regex.Runtime.Evidence
  use Std.Regex.Runtime.NamedCapture
  use Std.Regex.Runtime.Compiler
  use Std.Regex.Runtime.AtomicPlan
  use Std.Regex.Runtime.LookaroundContext
  use Std.Regex.Runtime.EvidenceThreads
  use Std.Regex.Runtime.NewlinePolicy
  use Std.Regex.Runtime.PublicTypes
  use Std.Regex.Runtime.ProgramTypes
  use Std.Regex.Runtime.Conversion
  use Std.Regex.Runtime.CharacterSemantics
  use Std.Regex.Runtime.RegexType
  use Std.Regex.Runtime.NamedTypes
  use Std.Regex.Runtime.ThreadDedup
































































  ## Conversion values used by the literal emitter's staged IR. Keeping these
  ## small adapters here lets generated literals publish a first-order
  ## Thompson tree without rebuilding a Regex/Pattern wrapper at runtime.
  fn discard_char_conversion() -> Conversion(Char, Unit) = ApplyConversion(discard_char)

  fn empty_list_conversion({a: Type}) -> Conversion(Unit, List(a)) = ApplyConversion(fn(_) -> [])

  ## Shape-indexed adapters keep generated bounded-literal conversions fully
  ## inferable.  The emitter knows the inner shape, while the polymorphic
  ## convenience form above has no expected type at the generated call site.
  fn empty_list_conversion_for(shape: ShapeCode) -> Conversion(Unit, List(Sem(shape))) =
    ApplyConversion(fn(_) -> [])

  fn prepend_repetition_conversion({a: Type}) -> Conversion(Tuple(a, List(a)), List(a)) =
    ApplyConversion(prepend_repetition_result)

  fn prepend_repetition_conversion_for(shape: ShapeCode) -> Conversion(Tuple(Sem(shape), List(Sem(shape))), List(Sem(shape))) =
    ApplyConversion(prepend_repetition_result)

  fn prepend_optional_repetition_conversion({a: Type}) -> Conversion(Tuple(Choice(a, Unit), List(a)), List(a)) =
    ApplyConversion(prepend_optional_repetition_result)

  fn prepend_optional_repetition_conversion_for(shape: ShapeCode) -> Conversion(Tuple(Choice(Sem(shape), Unit), List(Sem(shape))), List(Sem(shape))) =
    ApplyConversion(prepend_optional_repetition_result)

  fn simplify_program(shape: ShapeCode, program: RegexProgram(Sem(shape))) -> RegexProgram(Sem(Simplify(shape))) = match program
    BuiltRegex(raw_shape, pattern, conversion, hint) ->
      BuiltRegex(raw_shape, pattern, ComposedConversion(conversion, SimplifyConversion(shape)), hint)

  fn simplify_compiled(shape: ShapeCode, program: CompiledRegex(Sem(shape))) -> CompiledRegex(Sem(Simplify(shape))) = match program
    NoProgram() -> NoProgram()
    SomeProgram(compiled) -> SomeProgram(simplify_program(shape, compiled))

  fn sem_identity_conversion(shape: ShapeCode) -> Conversion(Sem(shape), Sem(shape)) = IdentityConversion()

  fn string_identity_conversion() -> Conversion(String, String) = IdentityConversion()

  fn unit_identity_conversion() -> Conversion(Unit, Unit) = IdentityConversion()

  fn empty_repetition_transform({a: Type}, _: Regex(a)) -> (Unit -> List(a)) =
    fn(_) -> []

  fn prepend_repetition_result({a: Type}, value: Tuple(a, List(a))) -> List(a) = match value
    %[head, rest] -> [head | rest]

  fn prepend_optional_repetition_result({a: Type}, value: Tuple(Choice(a, Unit), List(a))) -> List(a) = match value
    %[choice, rest] -> match choice
      ChoseLeft(head) -> [head | rest]
      ChoseRight(_) -> rest

  fn discard_char(_char: Char) -> Unit = ()
end
