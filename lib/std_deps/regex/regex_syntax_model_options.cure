## Compile-time-only literal syntax tree. It is consumed by `expand_literal`
## and never appears in generated matching code.

@group(:text)
mod Std.Regex.Syntax.Model.Options
  use Std.Regex.Syntax.Model.Collections

  use Std.Regex.Syntax.Model.Modifiers

  use Std.Regex.Syntax.Model.ClassPredicates

  use Std.Regex.Syntax.Model.Shape

  use Std.Regex.Syntax.Model.Utilities

  use Std.Regex.Syntax.Model.ClassKinds

  use Std.Regex.Syntax.Model.Predicates

  use Std.Regex.Syntax.Model.Types

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.String

  fn apply_literal_scoped_options(enabled: List(LiteralModifier), disabled: List(LiteralModifier), options: LiteralRegexOptions) -> LiteralRegexOptions =
      apply_literal_scoped_enabled(enabled, apply_literal_scoped_disabled(disabled, options))

  fn apply_literal_scoped_disabled(disabled: List(LiteralModifier), options: LiteralRegexOptions) -> LiteralRegexOptions = match disabled
      [] -> options
      [head | rest] -> apply_literal_scoped_disabled(rest, disable_modifier(head, options))

  fn apply_literal_scoped_enabled(enabled: List(LiteralModifier), options: LiteralRegexOptions) -> LiteralRegexOptions = match enabled
      [] -> options
      [head | rest] -> apply_literal_scoped_enabled(rest, enable_modifier(head, options))

  fn set_literal_newline_policy(policy: LiteralNewlinePolicy, options: LiteralRegexOptions) -> LiteralRegexOptions = match options
      LiteralRegexOptions(values, _) -> LiteralRegexOptions(values, policy)

  fn literal_pattern_options(pattern: LiteralPattern, options: LiteralRegexOptions) -> LiteralPatternOptions = match pattern
      LiteralConfigured(policy, inner) -> LiteralPatternOptions(inner, set_literal_newline_policy(policy, options))
      _ -> LiteralPatternOptions(pattern, options)
end
