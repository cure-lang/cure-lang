  ## Internal start-list results keep the exact current suffix. The public
  ## routine result is produced only after the root map below wraps a complete
  ## whole-to-whole refutation.
  type AtomicStartMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicStartMembersNo : (@erased kind: AtomicStartFailureKind) -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, kind)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current)
    ## The active root/empty branch retains its stronger child proof package at
    ## the evaluator result boundary.  The parent and child contexts stay
    ## separate in the package indices, while the ordinary failure/evidence
    ## values remain available to existing runtime adapters.  The explicit
    ## `active_current_equivalence` field records that the current spine at
    ## this construction site is exactly the active head followed by its
    ## recursive tail; consumers must refine that equality before publishing
    ## a root result.
    AtomicStartMembersActiveRootNo : (@erased active_state: Bounded(n)) -> (@erased thread_refinement: AtomicStartActiveThreadRefinement(n, ThreadActive(active_state), active_state)) -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, AtomicStartFailureRejected())) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, AtomicStartFailureRejected())) -> (@erased child_scope_depth: Nat) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_kind: AtomicPathFailureKind) -> (@erased active_current_equivalence: Equivalent(List(LookaroundAdmittedState(n)), current, Cons(LookaroundAdmittedActive(active_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased package: AtomicStartActiveRootTailProofPackageAt(depth, n, machine, position, capture_context, append_routine(append_routine(capture_context, routine), assertion_markers), input, after_input, history, policy, prefix_mode, reversed_prefix, ThreadActive(active_state), routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_whole, child_current, child_kind, child_scope_depth)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current)
    ## A recursive no-result branch remembers that its tail was active-headed;
    ## both the parent and recursive-tail refutation payloads remain indexed.
    AtomicStartMembersTailActiveNo : (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased kind: AtomicStartFailureKind) -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), kind)) -> (@erased tail_kind: AtomicStartFailureKind) -> (@erased tail_failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> (@erased tail_evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining))
    AtomicStartMembersCommit : (commit_depth: Nat) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current)
    AtomicStartMembersYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> (@erased start_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)) -> {@erased selected_start: LookaroundAdmittedState(n)} -> (@erased selected_member: ListMember(LookaroundAdmittedState(n), selected_start, current)) -> {@erased blocked_depth: Option(Nat)} -> {@erased kind: AtomicStartSkipKind} -> (@erased allowed: AtomicStartAllowed(blocked_depth, kind)) -> (@erased scope: AtomicStartScopeEvidence(n, AtomicStartScopeEvidenceAllowedRole())) -> (@erased trace: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining, routine)) -> (trace_package: AtomicSelectedTracePackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining, routine, trace)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current)

  type AtomicStartTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)))
    AtomicStartTailPackagePacked : {@erased kind: AtomicStartFailureKind} -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> AtomicStartTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)

  type AtomicStartActiveRootTailProofPackageAt(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, parent_capture_context: List(EvidenceInstruction), child_capture_context: List(EvidenceInstruction), child_input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), child_whole: List(LookaroundAdmittedState(n)), child_current: List(LookaroundAdmittedState(n)), child_kind: AtomicPathFailureKind, child_scope_depth: Nat)
