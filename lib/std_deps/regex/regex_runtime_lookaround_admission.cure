(@erased child_evidence: AtomicPathNoEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased close_canonical: Equivalent(Option(Nat), lookaround_admitted_state_closed_depth(n, scope_depth, candidate), Some(commit_depth))) -> (@erased blocked: AtomicDepthAtLeast(scope_depth, commit_depth)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind))
    AtomicPathCommitFromChild : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_commit_kind: AtomicPathCommitCauseKind) -> (@erased child_cause: AtomicPathCommitCause(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, commit_depth, child_commit_kind)) -> (@erased blocked: AtomicDepthAtLeast(scope_depth, commit_depth)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitFromChildKind(child_commit_kind))
    AtomicPathCommitPastEscaped : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_commit_kind: AtomicPathCommitCauseKind) -> (@erased escaped_depth: Nat) -> (@erased child_cause: AtomicPathCommitCause(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, escaped_depth, child_commit_kind)) -> (@erased escaped: AtomicDepthBelow(scope_depth, escaped_depth)) -> (@erased tail_depth: Nat) -> {@erased tail_origin: List(LookaroundAdmittedState(n))} -> (@erased tail_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, tail_origin)) -> (@erased tail_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, tail_origin)) -> (@erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, remaining)) -> (@erased tail_commit_kind: AtomicPathCommitCauseKind) -> (@erased tail_cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, tail_depth, tail_commit_kind)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), tail_depth, AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind))
  
    AtomicPathCommitPastRejected : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_prefix_kind: AtomicPathFailurePrefixKind) -> (@erased child_prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_prefix_kind)) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_kind: AtomicPathFailureKind) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased child_evidence: AtomicPathNoEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased continuation: AtomicPathFailureContinuation(scope_depth, lookaround_admitted_state_closed_depth(n, scope_depth, candidate))) -> (@erased commit_depth: Nat) -> {@erased tail_origin: List(LookaroundAdmittedState(n))} -> (@erased tail_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, tail_origin)) -> (@erased tail_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, tail_origin)) -> (@erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, remaining)) -> (@erased tail_commit_kind: AtomicPathCommitCauseKind) -> (@erased tail_cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, commit_depth, tail_commit_kind)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitPastRejectedKind(child_prefix_kind, child_kind, tail_commit_kind))

  type AtomicPathCommitAfterFailureTerminalClassifiedPackage(n: Nat) indices (prefix_mode: Bool, rest: List(Char), candidate: LookaroundAdmittedState(n), child_prefix_kind: AtomicPathFailurePrefixKind, child_kind: AtomicPathFailureKind)
    AtomicPathCommitAfterFailureInputExhaustedPacked : {@erased state: Bounded(n)} -> {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, Nil(), LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), child_prefix_kind, AtomicPathFailureInputExhausted())
    AtomicPathCommitAfterFailureExactAcceptedPacked : {@erased child_char: Char} -> {@erased child_rest: List(Char)} -> {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, False(), Cons(child_char, child_rest), LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), child_prefix_kind, AtomicPathFailureExactAccepted())
    AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked : {@erased child_char: Char} -> {@erased child_rest: List(Char)} -> {@erased state: Bounded(n)} -> {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, Cons(child_char, child_rest), LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), AtomicPathFailureAtRootKind(), AtomicPathFailureDestinationsExhausted())
    AtomicPathCommitAfterFailureTerminalUnclassifiedPacked : AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, rest, candidate, child_prefix_kind, child_kind)

  fn atomic_path_commit_after_failure_terminal_classified_package(
    {n: Nat}, prefix_mode: Bool, rest: List(Char), candidate: LookaroundAdmittedState(n),
    {child_prefix_kind: AtomicPathFailurePrefixKind},
    root_availability: AtomicPathFailurePrefixRootAvailability(child_prefix_kind),
    child_kind: AtomicPathFailureKind
  ) -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, rest, candidate, child_prefix_kind, child_kind) = match rest
    [] -> match candidate
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) -> match child_kind
        AtomicPathFailureInputExhausted() -> AtomicPathCommitAfterFailureInputExhaustedPacked()
        AtomicPathFailureExactAccepted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationsExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationRejected() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
      LookaroundAdmittedAccepted(_, _, _, _, _) -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
    [child_char | child_rest] -> match candidate
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) -> match child_kind
        AtomicPathFailureInputExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureExactAccepted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationsExhausted() -> match root_availability
          AtomicPathFailurePrefixRootAvailable() -> AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked()
          AtomicPathFailurePrefixRootUnavailable() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationRejected() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
      LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions) -> match child_kind
        AtomicPathFailureInputExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureExactAccepted() -> match prefix_mode
          True() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
          False() -> AtomicPathCommitAfterFailureExactAcceptedPacked()
        AtomicPathFailureDestinationsExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationRejected() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()

  ## Genuinely indexed `AfterFailure` child-cursor correlation. The package is
  ## indexed by the exact cause value, not merely by its outer type, so the
  ## relevant child cursor cannot be paired with an unrelated erased cause.
