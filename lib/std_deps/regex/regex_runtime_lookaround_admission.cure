  ## Reintroduce the parent candidate after a recursive active-headed tail.
  ## Both no-result payloads stay indexed by their respective spines, so proof
  ## consumers can refine the active tail at this construction site without
  ## adding runtime state.
  fn atomic_start_initial_tail_no_with_active_tail(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    remaining: List(LookaroundAdmittedState(n)),
    @erased tail_kind: AtomicStartFailureKind,
    @erased tail_failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind),
    @erased tail_evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind),
    result_value: AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining))
  ) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining)) = match result_value
    AtomicStartMembersNo(kind, failure, evidence) -> AtomicStartMembersTailActiveNo(candidate, remaining, kind, failure, evidence, tail_kind, tail_failure, tail_evidence)
    AtomicStartMembersActiveRootNo(_, _, _, _, _, _, _, _, _, _, _, _, _, _, active_current_equivalence, _) -> match active_current_equivalence
      reflexive() -> result_value
    AtomicStartMembersTailActiveNo(_, _, kind, failure, evidence, old_tail_kind, old_tail_failure, old_tail_evidence) -> AtomicStartMembersTailActiveNo(candidate, remaining, kind, failure, evidence, old_tail_kind, old_tail_failure, old_tail_evidence)
    AtomicStartMembersCommit(commit_depth) -> AtomicStartMembersCommit(commit_depth)
    AtomicStartMembersYes(matched, remaining_input, routine, selection_suffix, selected_member, allowed, scope, trace, trace_package) -> AtomicStartMembersYes(matched, remaining_input, routine, selection_suffix, selected_member, allowed, scope, trace, trace_package)

