  @reducible
  fn lookaround_machine_destinations(depth: Nat, n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(_, next) -> lookaround_filter_boundary_states(depth, next_for_thread(n, next, state, char), lookaround_transition_boundary(char, rest, after_input, policy), append_characters(rest, after_input), history_push_bounded(history, char), capture_context, policy)

  fn lookaround_machine_admitted_destinations(depth: Nat, n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundAdmittedState(n)) = match machine
    MkPatternMachine(_, next) -> lookaround_admit_boundary_states(depth, next_for_thread(n, next, state, char), lookaround_transition_boundary(char, rest, after_input, policy), append_characters(rest, after_input), history_push_bounded(history, char), capture_context, policy)

  ## Atomic path rejection is retained as erased indexed data.  A rejected
  ## destination stores both the child failure and the remaining-sibling
  ## failure, so the start-list wrapper can carry one complete root tree.
  @reducible
  fn lookaround_admitted_state_thread({n: Nat}, state: LookaroundAdmittedState(n)) -> ThreadState(n) = match state
    LookaroundAdmittedActive(destination, _, _, _, _, _) -> ThreadActive(destination)
    LookaroundAdmittedAccepted(_, _, _, _, _) -> ThreadAccepted()

  @reducible
  fn lookaround_admitted_state_capture_context({n: Nat}, base: List(EvidenceInstruction), state: LookaroundAdmittedState(n)) -> List(EvidenceInstruction) = match state
    LookaroundAdmittedActive(_, routine, _, _, assertion_markers, _) -> lookaround_admitted_active_capture_context(base, routine, assertion_markers)
    LookaroundAdmittedAccepted(routine, _, _, assertion_markers, _) -> lookaround_admitted_accepted_capture_context(base, routine, assertion_markers)

  @reducible
  fn lookaround_admitted_state_closed_depth(n: Nat, base: Nat, state: LookaroundAdmittedState(n)) -> Option(Nat) = match state
    LookaroundAdmittedActive(_, routine, _, _, _, _) -> atomic_scope_closed_depth(routine, base)
    LookaroundAdmittedAccepted(routine, _, _, _, _) -> atomic_scope_closed_depth(routine, base)

  type LookaroundAdmittedStateCaptureContext(n: Nat) indices (base: List(EvidenceInstruction), state: LookaroundAdmittedState(n), child: List(EvidenceInstruction))
    LookaroundAdmittedStateCaptureContextActive : {@erased destination: Bounded(n)} -> {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> LookaroundAdmittedStateCaptureContext(n, base, LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), append_routine(append_routine(base, routine), assertion_markers))
    LookaroundAdmittedStateCaptureContextAccepted : {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> LookaroundAdmittedStateCaptureContext(n, base, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), append_routine(append_routine(base, routine), assertion_markers))

  type LookaroundAdmittedStateScope(n: Nat) indices (base: Nat, state: LookaroundAdmittedState(n), depth: Nat)
    LookaroundAdmittedStateScopeActive : (@erased state: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateScope(n, base, LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), atomic_scope_depth_after(routine, base))
    LookaroundAdmittedStateScopeAccepted : (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateScope(n, base, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), atomic_scope_depth_after(routine, base))

  fn atomic_lookaround_state_scope_active({n: Nat}, base: Nat, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateScope(n, base, LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), atomic_scope_depth_after(routine, base)) = LookaroundAdmittedStateScopeActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions)

  fn atomic_lookaround_state_scope_accepted({n: Nat}, base: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateScope(n, base, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), atomic_scope_depth_after(routine, base)) = LookaroundAdmittedStateScopeAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions)

  fn atomic_lookaround_state_capture_context_active({n: Nat}, base: List(EvidenceInstruction), state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateCaptureContext(n, base, LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), append_routine(append_routine(base, routine), assertion_markers)) = LookaroundAdmittedStateCaptureContextActive()

  fn atomic_lookaround_state_capture_context_accepted({n: Nat}, base: List(EvidenceInstruction), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateCaptureContext(n, base, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), append_routine(append_routine(base, routine), assertion_markers)) = LookaroundAdmittedStateCaptureContextAccepted()

