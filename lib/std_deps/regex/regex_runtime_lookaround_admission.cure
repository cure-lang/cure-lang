    AtomicStartMembersActiveRootNo(_, _, tail_failure, tail_evidence, _, _, _, _, _, _, _, _, _, _, active_current_equivalence, _) -> match active_current_equivalence
      reflexive() -> atomic_start_initial_tail_no(
      depth,
