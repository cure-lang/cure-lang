  type SomeAcceptanceWithExecution(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence)) indices ()
    SomeAcceptedWithExecution : (final_captures: List(CaptureFrame)) -> (accepted: AcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures)) -> SomeAcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)

  fn acceptance_with_execution_captures(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), final_captures: List(CaptureFrame), accepted: AcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures)) -> CanonicalAcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures) = match accepted
    AcceptedWithExecution(acceptance, supplied) -> match extended_routine_execution_unique(input_evidence, input_captures, acceptance_path_execution_exact(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), supplied)
      mk_pair(evidence_exact, captures_exact) -> CanonicalAcceptedWithExecution(acceptance, captures_exact)

  fn transport_acceptance_with_execution(
    {n: Nat},
    left: PatternMachine(n),
    right: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    final_evidence: List(Evidence),
    final_captures: List(CaptureFrame),
    equality: Equivalent(PatternMachine(n), left, right),
    accepted: AcceptanceWithExecution(n, right, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures)
  ) -> AcceptanceWithExecution(n, left, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures) = match equality
    reflexive() -> accepted

  fn transport_certified_acceptance_machine(
    {n: Nat},
    left: PatternMachine(n),
    right: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    final_evidence: List(Evidence),
    expected_captures: List(CaptureFrame),
    equality: Equivalent(PatternMachine(n), left, right),
    acceptance: AcceptancePathFrom(n, left, position, input, after_input, input_evidence, input_captures, final_evidence),
    captures_exact: Equivalent(List(CaptureFrame), acceptance_path_final_captures(n, left, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), expected_captures)
  ) -> TransportedCertifiedAcceptance(n, right, position, input, after_input, input_evidence, input_captures, final_evidence, expected_captures) = match equality
    reflexive() -> CertifiedAcceptanceTransported(acceptance, captures_exact)

  fn transport_staged_accepting_from(
    {shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    input: List(Char),
    after_input: List(Char),
    source: ThreadState(thompson_state_count(compilation)),
    current_evidence: List(Evidence),
    captures: List(CaptureFrame),
    final_evidence: List(Evidence),
    path_routine: List(ExtendedInstruction),
    path: AcceptingFrom(thompson_state_count(compilation), staged_machine_from_compilation(compilation), input, after_input, source, current_evidence, captures, final_evidence, path_routine)
  ) -> AcceptingFrom(thompson_state_count(compilation), thompson_machine(compilation), input, after_input, source, current_evidence, captures, final_evidence, path_routine) = match input
    [] -> match path
      AcceptingNow() -> AcceptingNow()
    [char | rest] -> match path
      AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) ->
        AcceptingNextActive(
          destination,
          regular,
          constraints,
          destination_evidence,
          destination_captures,
          suffix_routine,
          transport_list_member(Active(destination, regular, constraints), edge, staged_thread_destinations_equivalent(compilation, source, char, transition_boundary_before(char, rest, after_input))),
          execution,
          transport_staged_accepting_from(compilation, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
        )
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) ->
        let accepted_destination: MachineState(thompson_state_count(compilation)) = Accepted(regular, constraints)
        AcceptingNextAccepted(
          regular,
          constraints,
          destination_evidence,
          destination_captures,
          suffix_routine,
          transport_list_member(accepted_destination, edge, staged_thread_destinations_equivalent(compilation, source, char, transition_boundary_before(char, rest, after_input))),
          execution,
          transport_staged_accepting_from(compilation, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
        )

  fn group_active_child_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), state: Bounded(n), routine: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), edge: ListMember(MachineState(n), Active(state, routine, empty_boundary_constraints()), initial_machine_destinations(n, machine, position, input, after_input)), initial_execution: RoutineExecution(routine, input_evidence, input_captures, initial_evidence, initial_captures), {final_evidence: List(Evidence)}, {final_captures: List(CaptureFrame)}, path: AcceptingFrom(n, machine, input, after_input, ThreadActive(state), initial_evidence, initial_captures, final_evidence, path_routine), execution: ExtendedEvidenceRoutineExecution(append_extended_routines(regular_routine(routine), path_routine), input_evidence, input_captures, final_evidence, final_captures)) -> AcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures) =
    AcceptedWithExecution(%[Active(state, routine, empty_boundary_constraints()), initial_evidence, initial_captures, path_routine, edge, initial_execution, path], execution)

  fn group_empty_child_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), routine: List(EvidenceInstruction), final_evidence: List(Evidence), final_captures: List(CaptureFrame), edge: ListMember(MachineState(n), accepted_without_constraints(n, routine), initial_machine_destinations(n, machine, position, empty_characters(), after_input)), execution: RoutineExecution(routine, input_evidence, input_captures, final_evidence, final_captures)) -> AcceptanceWithExecution(n, machine, position, empty_characters(), after_input, input_evidence, input_captures, final_evidence, final_captures) =
    let acceptance = empty_accepted_acceptance_from(n, machine, position, after_input, input_evidence, input_captures, routine, final_evidence, final_captures, edge, execution)
    let extended = append_extended_routine_execution(regular_routine(routine), empty_extended_routine(), input_evidence, input_captures, final_evidence, final_captures, final_evidence, final_captures, extend_routine_execution(routine, input_evidence, input_captures, final_evidence, final_captures, execution), ExtendedEvidenceDone())
    AcceptedWithExecution(acceptance, extended)

  type GroupAcceptanceFromProjection(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence), combined_final_captures: List(CaptureFrame))
    ProjectedGroupAcceptanceMissingFrame : (child_final_evidence: List(Evidence)) -> (child: AcceptanceWithExecution(n, MkPatternMachine(starts, next), position, input, after_input, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), child_final_evidence, Nil())) -> (combined_final_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), combined_final_captures, Nil())) -> (@erased projected_final_evidence: List(Evidence)) -> (projected_evidence_exact: Equivalent(List(Evidence), projected_final_evidence, child_final_evidence)) -> GroupAcceptanceFromProjection(n, starts, next, position, input, after_input, input_evidence, input_captures, projected_final_evidence, combined_final_captures)
    ProjectedGroupAcceptanceClosedFrame : (child_final_evidence: List(Evidence)) -> (chars: List(Char)) -> (saved: List(Evidence)) -> (outer: List(CaptureFrame)) -> (child: AcceptanceWithExecution(n, MkPatternMachine(starts, next), position, input, after_input, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), child_final_evidence, Cons(CaptureFrame(chars, saved), outer))) -> (combined_final_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), combined_final_captures, outer)) -> (@erased projected_final_evidence: List(Evidence)) -> (projected_evidence_exact: Equivalent(List(Evidence), projected_final_evidence, Cons(StringEvidence(captured_string(chars)), saved))) -> GroupAcceptanceFromProjection(n, starts, next, position, input, after_input, input_evidence, input_captures, projected_final_evidence, combined_final_captures)

  fn certify_thompson_evidence({@erased shape: ShapeCode}, pattern: Pattern(shape)) -> CertifiedThompsonCompilation(shape, certify_thompson(pattern)) = match pattern
    PatternPredicate(test) -> CertifiedThompson(ThompsonPredicate(test), ThompsonEvidencePredicate(test))
    PatternEmpty() -> CertifiedThompson(ThompsonEmpty(), ThompsonEvidenceEmpty())
    PatternBoundary(constraint) -> CertifiedThompson(ThompsonBoundary(constraint), ThompsonEvidenceBoundary(constraint))
    PatternConcat(left, right) -> match certify_thompson_evidence(left)
      CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
        CertifiedThompson(right_compilation, right_proof) -> CertifiedThompson(ThompsonConcat(left_compilation, right_compilation), ThompsonEvidenceConcat(left_compilation, right_compilation, left_proof, right_proof))
    PatternGroup(inner) -> match certify_thompson_evidence(inner)
      CertifiedThompson(inner_compilation, inner_proof) -> CertifiedThompson(ThompsonGroup(inner_compilation), ThompsonEvidenceGroup(inner_compilation, inner_proof))
    PatternAlternate(left, right) -> match certify_thompson_evidence(left)
      CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
        CertifiedThompson(right_compilation, right_proof) -> CertifiedThompson(ThompsonAlternate(left_compilation, right_compilation, false), ThompsonEvidenceAlternate(left_compilation, right_compilation, false, left_proof, right_proof))
    PatternAlternateMode(left, right, prefer_right) -> match certify_thompson_evidence(left)
      CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
        CertifiedThompson(right_compilation, right_proof) -> CertifiedThompson(ThompsonAlternate(left_compilation, right_compilation, prefer_right), ThompsonEvidenceAlternate(left_compilation, right_compilation, prefer_right, left_proof, right_proof))
    PatternRepeat(inner) -> match certify_thompson_evidence(inner)
      CertifiedThompson(inner_compilation, inner_proof) -> CertifiedThompson(ThompsonRepeat(inner_compilation, false), ThompsonEvidenceRepeat(inner_compilation, false, inner_proof))
    PatternRepeatMode(inner, lazy) -> match certify_thompson_evidence(inner)
      CertifiedThompson(inner_compilation, inner_proof) -> CertifiedThompson(ThompsonRepeat(inner_compilation, lazy), ThompsonEvidenceRepeat(inner_compilation, lazy, inner_proof))

  fn grouped_predicate_active_impossible({a: Type}, test: Char -> Bool, char: Char, boundary: Boundary, {state: Bounded(S(Z()))}, {regular: List(EvidenceInstruction)}, {constraints: List(BoundaryConstraint)}, edge: ListMember(MachineState(S(Z())), Active(state, regular, constraints), machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, boundary))) -> a = with grouped_predicate_destinations_view(test, char, boundary)
    GroupedPredicateRejects() -> impossible_list_member(edge)
    GroupedPredicateAccepts() -> match edge
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn grouped_predicate_accepted_encodes(test: Char -> Bool, char: Char, after_input: List(Char), {regular: List(EvidenceInstruction)}, {constraints: List(BoundaryConstraint)}, {destination_evidence: List(Evidence)}, {destination_captures: List(CaptureFrame)}, {suffix_routine: List(ExtendedInstruction)}, {final_evidence: List(Evidence)}, edge: ListMember(MachineState(S(Z())), Accepted(regular, constraints), machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, transition_boundary_before(char, Nil(), after_input))), execution: RoutineExecution(regular, Nil(), record_capture_char(Cons(CaptureFrame(Nil(), Nil()), Nil()), char), destination_evidence, destination_captures), suffix: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Nil(), after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = with grouped_predicate_destinations_view(test, char, transition_boundary_before(char, Nil(), after_input))
    GroupedPredicateRejects() -> impossible_list_member(edge)
    GroupedPredicateAccepts() -> match edge
      ListMemberHere() -> match execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineStep(_, after_end) -> match after_end
            RoutineDone() -> match suffix
              AcceptingNow() -> grouped_predicate_final_encodes(char)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_alternate_starts_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateAlternateStartsView(prefer_right, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, input, after_input)) = match prefer_right
    False() -> PredicateAlternateStartsLeftFirst()
    True() -> PredicateAlternateStartsRightFirst()

  fn predicate_alternate_left_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, ThreadActive(First()), Nil(), Nil(), final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_alternate_left_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateLeftRejects() -> impossible_list_member(edge)
      PredicateAlternateLeftAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_alternate_left_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateLeftRejects() -> impossible_list_member(edge)
      PredicateAlternateLeftAccepts() -> match edge
        ListMemberHere() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineStep(_, after_marker) -> match after_marker
              RoutineDone() -> match suffix
                AcceptingNow() -> EncodesLeft(encodes_character_empty(char))
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_alternate_right_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, ThreadActive(Next(First())), Nil(), Nil(), final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_alternate_right_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateRightRejects() -> impossible_list_member(edge)
      PredicateAlternateRightAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_alternate_right_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateRightRejects() -> impossible_list_member(edge)
      PredicateAlternateRightAccepts() -> match edge
        ListMemberHere() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineStep(_, after_marker) -> match after_marker
              RoutineDone() -> match suffix
                AcceptingNow() -> EncodesRight(encodes_character_empty(char))
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_path_routine_view(test: Char -> Bool, char: Char, after_input: List(Char), {path_evidence: List(Evidence)}, {path_captures: List(CaptureFrame)}, {path_final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), path_evidence, path_captures, path_final_evidence, routine)) -> PredicateRoutineView(char, routine) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberHere() -> match suffix
          AcceptingNow() -> PredicateRoutineExact()
        ListMemberThere(prior) -> impossible_list_member(prior)
end
