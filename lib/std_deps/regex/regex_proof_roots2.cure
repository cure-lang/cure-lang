  fn group_active_projection_evidence_exact(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), final_evidence: List(Evidence), final_captures: List(CaptureFrame), projection: GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, final_captures)) -> Equivalent(List(Evidence), final_evidence, group_active_projection_evidence(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, final_captures, projection)) = match projection
