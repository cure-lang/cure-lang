        let left_acceptance = active_acceptance_from_path(left_count, left_machine, position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, state, routine, initial_evidence, initial_captures, left_path_routine, child_initial_edge, initial_execution, left_path)
