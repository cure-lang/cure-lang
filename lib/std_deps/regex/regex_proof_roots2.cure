            transport_alternate_edge(filtered_alternate_starts_right_order(left_count, left_starts, right_count, right_starts, boundary), appended)

  type AlternateAcceptanceBranch(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) indices (right_branch: Bool)
    ProjectedAlternateLeft : (projection: AlternateLeftAcceptanceProjection(left_count, left_machine, position, input, after_input, final_evidence)) -> AlternateAcceptanceBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence, False())
    ProjectedAlternateRight : (projection: AlternateRightAcceptanceProjection(right_count, right_machine, position, input, after_input, final_evidence)) -> AlternateAcceptanceBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence, True())

  typealias AlternateAcceptanceFromProjection(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence)) = Sigma(right_branch: Bool, AlternateAcceptanceFromBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence, right_branch))

  fn empty_acceptance_path_encodes(input: List(Char), after_input: List(Char), position: InitialPosition, {final_evidence: List(Evidence)}, acceptance: AcceptancePath(Z(), empty_pattern_machine(), position, input, after_input, final_evidence)) -> Encodes(UnitC(), final_evidence, empty_evidence()) = empty_acceptance_path_from_encodes(input, after_input, position, empty_evidence(), empty_captures(), acceptance)

  fn predicate_arbitrary_path_from_encodes(test: Char -> Bool, input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), input, after_input, predicate_machine_thread(), current_evidence, captures, final_evidence, routine)) -> Encodes(CharC(), final_evidence, current_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, rest, after_input))
        PredicateRejects() -> impossible_list_member(edge)
        PredicateAccepts() -> match edge
          ListMemberThere(prior) -> impossible_list_member(prior)
      AcceptingNextAccepted(_, _, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, rest, after_input))
        PredicateRejects() -> impossible_list_member(edge)
        PredicateAccepts() -> match edge
          ListMemberHere() -> match execution
            RoutineStep(_, after_emit) -> match after_emit
              RoutineDone() -> match accepted_path_view(S(Z()), predicate_pattern_machine(test), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
                AcceptedPathNow() -> encodes_character_on(char, current_evidence)
          ListMemberThere(prior) -> impossible_list_member(prior)

  fn recorded_open_capture_view(chars: List(Char), saved: List(Evidence), captures: List(CaptureFrame), input: List(Char), final_captures: List(CaptureFrame), equality: Equivalent(List(CaptureFrame), final_captures, record_capture_input(Cons(CaptureFrame(chars, saved), captures), input))) -> RecordedOpenCapture(chars, saved, captures, input, final_captures) =
    rewrite equality in
      rewrite record_capture_frame_input(chars, saved, captures, input) in
        RecordedOpenCaptureExact()

  fn predicate_active_capture_impossible({result: Type}, test: Char -> Bool, char: Char, boundary: Boundary, {destination: Bounded(S(Z()))}, {regular: List(EvidenceInstruction)}, {constraints: List(BoundaryConstraint)}, edge: ListMember(MachineState(S(Z())), Active(destination, regular, constraints), machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, boundary))) -> result = with predicate_destinations_view(test, char, boundary)
    PredicateRejects() -> impossible_list_member(edge)
    PredicateAccepts() -> match edge
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_accepted_edge_view(test: Char -> Bool, char: Char, boundary: Boundary, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(S(Z())), Accepted(regular, constraints), machine_destinations(S(Z()), predicate_pattern_machine(test), predicate_machine_thread(), char, boundary))) -> PredicateAcceptedEdgeView(test, char, regular, constraints) = with predicate_destinations_view(test, char, boundary)
    PredicateRejects() -> impossible_list_member(edge)
    PredicateAccepts() -> match edge
      ListMemberHere() -> PredicateAcceptedEdgeExact()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn filtered_finish_capture_origin(n: Nat, states: List(MachineState(n)), boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, finish_capture(states), boundary))) -> FilteredFinishCaptureOrigin(n, states, boundary, filtered) = match filtered_state_origin(n, finish_capture(states), boundary, filtered, edge)
    FilteredActiveStateOrigin(state, routine, constraints, finished_edge, holds) -> match finish_capture_origin(states, Active(state, routine, constraints), finished_edge)
      CaptureActiveOrigin(_, _, _, child_edge) -> FilteredCaptureActiveOrigin(state, routine, constraints, child_edge, holds)
    FilteredAcceptedStateOrigin(routine, constraints, finished_edge, holds) -> match finish_capture_origin(states, Accepted(routine, constraints), finished_edge)
      CaptureAcceptedOrigin(child_routine, _, child_edge) -> FilteredCaptureAcceptedOrigin(child_routine, constraints, child_edge, holds)

  fn group_active_projection_captures_exact(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), final_evidence: List(Evidence), final_captures: List(CaptureFrame), projection: GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, final_captures)) -> Equivalent(List(CaptureFrame), final_captures, group_active_projection_captures(n, starts, next, input, after_input, source, current_evidence, current_captures, final_evidence, final_captures, projection)) = match projection
