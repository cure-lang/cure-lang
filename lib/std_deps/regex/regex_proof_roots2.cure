  fn project_alternate_right_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, captures, final_evidence, routine)) -> AlternateRightPathProjection(right_count, right_machine, input, after_input, source, current_evidence, captures, final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredRightActiveOrigin(child_destination, child_regular, child_edge) -> match project_alternate_right_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              mk_pair(child_final_evidence, mk_pair(child_suffix_routine, mk_pair(child_suffix, final_is_marked))) -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), AcceptingNextActive(child_destination, child_regular, Nil(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix), final_is_marked]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredRightAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitRight(), Nil()), current_evidence, record_capture_char(captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), Nil()), AcceptingNextAccepted(child_regular, Nil(), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()), reflexive(Cons(RightEvidence(), child_final_evidence))]

  fn project_alternate_right_shared_execution(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {combined_routine: List(ExtendedInstruction)}, combined_path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) -> AlternateRightSharedExecutionProjection(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, final_evidence, combined_routine, combined_path) = match input
    Nil() -> match combined_path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match combined_path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredRightActiveOrigin(child_destination, child_regular, child_edge) -> match project_alternate_right_shared_execution(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              ProjectedAlternateRightSharedExecution(child_final_evidence, child_suffix_routine, child_suffix, shared_final_captures, child_suffix_execution, combined_suffix_execution, final_is_marked) ->
                let child_path = AcceptingNextActive(child_destination, child_regular, empty_boundary_constraints(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix)
                let child_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
                let child_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), child_suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, child_transition_execution, child_suffix_execution)
                let combined_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
                let combined_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, combined_transition_execution, combined_suffix_execution)
                ProjectedAlternateRightSharedExecution(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), child_path, shared_final_captures, child_execution, combined_execution, final_is_marked)
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_right_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredRightAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitRight(), Nil()), current_evidence, record_capture_char(current_captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution_regular, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() ->
                      let child_path = one_step_accepted_path(right_count, MkPatternMachine(right_starts, right_next), char, after_input, source, current_evidence, current_captures, child_regular, child_final_evidence, child_final_captures, child_edge, child_execution_regular)
                      let child_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), child_final_evidence, child_final_captures, child_execution_regular))
                      let child_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), empty_extended_routine(), current_evidence, current_captures, child_final_evidence, child_final_captures, child_transition_execution, empty_extended_execution(child_final_evidence, child_final_captures))
                      let combined_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(append_branch_marker(child_regular, EmitRight()), current_evidence, record_capture_char(current_captures, char), destination_evidence, child_final_captures, execution))
                      let combined_execution = append_extended_routine_execution_inferred(transition_routine(char, append_branch_marker(child_regular, EmitRight())), empty_extended_routine(), current_evidence, current_captures, destination_evidence, child_final_captures, combined_transition_execution, empty_extended_execution(destination_evidence, child_final_captures))
                      ProjectedAlternateRightSharedExecution(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), empty_extended_routine()), child_path, child_final_captures, child_execution, combined_execution, reflexive(Cons(RightEvidence(), child_final_evidence)))

  fn alternate_left_accepted_acceptance_captures(left_count: Nat, left_machine: PatternMachine(left_count), position: InitialPosition, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), regular: List(EvidenceInstruction), {final_evidence: List(Evidence)}, final_captures: List(CaptureFrame), child_edge: ListMember(MachineState(left_count), Accepted(regular, Nil()), initial_machine_destinations(left_count, left_machine, position, Nil(), after_input)), combined_execution: RoutineExecution(append_branch_marker(regular, EmitLeft()), input_evidence, input_captures, final_evidence, final_captures)) -> AlternateLeftCapturedAcceptance(left_count, left_machine, position, Nil(), after_input, input_evidence, input_captures, final_evidence, final_captures) = match split_appended_routine_execution(regular, Cons(EmitLeft(), Nil()), input_evidence, input_captures, combined_execution)
