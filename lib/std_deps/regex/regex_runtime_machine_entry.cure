  @reducible
  fn lookaround_state_count({@erased shape: ShapeCode}, compilation: LookaroundCompilation(shape)) -> Nat = match compilation
    LookaroundPredicate(_) -> S(Z())
    LookaroundEmpty() -> Z()
    LookaroundBoundary(_) -> Z()
    LookaroundBoundaryGuard(_, inner) -> lookaround_state_count(inner)
    LookaroundConcat(left, right) -> plus(lookaround_state_count(left), lookaround_state_count(right))
    LookaroundGroup(inner) -> lookaround_state_count(inner)
    LookaroundGroupSlot(_, inner) -> lookaround_state_count(inner)
    LookaroundAlternate(left, right, _) -> plus(lookaround_state_count(left), lookaround_state_count(right))
    LookaroundRepeat(inner, _) -> lookaround_state_count(inner)
    LookaroundAtomic(inner) -> lookaround_state_count(inner)
    LookaroundGuard(_, _, inner) -> lookaround_state_count(inner)

  ## Build the finite child machine once. Atomic scopes are represented by
  ## the same BeginAtomic/EndAtomic routine markers used by the ordinary
  ## runtime plan, so nested assertion evaluation can apply one commitment
  ## invariant rather than maintaining a second backtracking mechanism.
  @reducible
  fn lookaround_machine({@erased shape: ShapeCode}, compilation: LookaroundCompilation(shape)) -> PatternMachine(lookaround_state_count(compilation)) = match compilation
    LookaroundPredicate(test) -> predicate_pattern_machine(test)
    LookaroundEmpty() -> empty_pattern_machine()
    LookaroundBoundary(constraint) -> boundary_pattern_machine(constraint)
    LookaroundBoundaryGuard(constraint, inner) -> guard_pattern_machine(constraint, lookaround_machine(inner))
    LookaroundConcat(left, right) -> concat_pattern_machine(lookaround_state_count(left), lookaround_machine(left), lookaround_state_count(right), lookaround_machine(right))
    LookaroundGroup(inner) ->
      let inner_machine = lookaround_machine(inner)
      group_pattern_machine(lookaround_state_count(inner), pattern_machine_starts(inner_machine), pattern_machine_next(inner_machine))
    LookaroundGroupSlot(slot, inner) ->
      let inner_machine = lookaround_machine(inner)
      group_pattern_machine_with_slot(lookaround_state_count(inner), pattern_machine_starts(inner_machine), pattern_machine_next(inner_machine), slot)
    LookaroundAlternate(left, right, prefer_right) -> alternate_pattern_machine(lookaround_state_count(left), lookaround_machine(left), lookaround_state_count(right), lookaround_machine(right), prefer_right)
    LookaroundRepeat(inner, lazy) -> repeat_pattern_machine(lookaround_state_count(inner), lookaround_machine(inner), lazy)
    LookaroundAtomic(inner) -> atomic_pattern_machine(lookaround_machine(inner))
    LookaroundGuard(slot, participated, inner) -> guard_pattern_machine(capture_condition_constraint(slot, participated), lookaround_machine(inner))

  @reducible
  fn lookaround_compiled({@erased shape: ShapeCode}, compilation: LookaroundCompilation(shape)) -> Sigma(n: Nat, PatternMachine(n)) = %[lookaround_state_count(compilation), lookaround_machine(compilation)]


  ## Assertions are staged as ordinary zero-state boundary nodes.  The child
  ## machine is closed over once here; each boundary check only supplies the
  ## current finite subject context, so no source parser or machine rebuild is
  ## performed during matching.
  fn lookahead_constraint({shape: ShapeCode}, compilation: LookaroundCompilation(shape), positive: Bool, policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, false, false, policy, None(), Some(LookaheadCondition(positive, lookaround_compiled(compilation))))

  fn lookbehind_constraint({shape: ShapeCode}, compilation: LookaroundCompilation(shape), positive: Bool, width: Nat, policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, false, false, policy, None(), Some(LookbehindCondition(positive, width, lookaround_compiled(compilation))))

end
