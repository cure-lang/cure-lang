  fn splice_repeat_reentry_step(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, char: Char, remaining_input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_regular: List(EvidenceInstruction), child_constraints: List(BoundaryConstraint), child_final_evidence: List(Evidence), child_final_captures: List(CaptureFrame), child_edge: ListMember(MachineState(n), Accepted(child_regular, child_constraints), machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, transition_boundary_before(char, remaining_input, after_input))), child_execution: RoutineExecution(child_regular, current_evidence, record_capture_char(current_captures, char), child_final_evidence, child_final_captures), next_state: Bounded(n), start_regular: List(EvidenceInstruction), start_constraints: List(BoundaryConstraint), start_edge: ListMember(MachineState(n), Active(next_state, start_regular, start_constraints), filter_machine_states(n, starts, transition_boundary_before(char, remaining_input, after_input))), next_evidence: List(Evidence), next_captures: List(CaptureFrame), start_execution: RoutineExecution(start_regular, child_final_evidence, child_final_captures, next_evidence, next_captures), final_evidence: List(Evidence), suffix_routine: List(ExtendedInstruction), suffix: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), remaining_input, after_input, ThreadActive(next_state), next_evidence, next_captures, final_evidence, suffix_routine)) -> AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), Cons(char, remaining_input), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, append_routine(child_regular, start_regular)), suffix_routine)) =
    let boundary = transition_boundary_before(char, remaining_input, after_input)
    let combined_regular = append_routine(child_regular, start_regular)
    let combined_edge = lift_repeat_filtered_reentry_transition_member(n, next(source, char), starts, lazy, boundary, child_regular, child_constraints, child_edge, next_state, start_regular, start_constraints, start_edge)
    let combined_execution = append_routine_execution(child_regular, start_regular, current_evidence, record_capture_char(current_captures, char), child_final_evidence, child_final_captures, next_evidence, next_captures, child_execution, start_execution)
    AcceptingNextActive(next_state, combined_regular, Nil(), next_evidence, next_captures, suffix_routine, combined_edge, combined_execution, suffix)

  ## Turn a complete, non-empty child acceptance into the first item of a
  ## Repeat continuation.  Keeping the exact acceptance in the indexed start
  ## view is essential: a plain nested Sigma match forgets the relationship
  ## between its destination and `machine_state_thread`.
  fn repeat_closing_continuation_from_acceptance(
    n: Nat,
    starts: List(MachineState(n)),
    next: (Bounded(n)) -> Char -> List(MachineState(n)),
    lazy: Bool,
    position: InitialPosition,
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    child_final_evidence: List(Evidence),
    child_acceptance: AcceptancePathFrom(n, MkPatternMachine(starts, next), position, Cons(char, rest), after_input, input_evidence, input_captures, child_final_evidence)
  ) -> RepeatContinuationFrom(n, starts, next, lazy, position, Cons(char, rest), after_input, input_evidence, input_captures) = match exact_acceptance_start_view(n, MkPatternMachine(starts, next), position, Cons(char, rest), after_input, input_evidence, input_captures, child_final_evidence, child_acceptance)
    ExactAcceptanceStartsActive(_, _, _, state, regular, constraints, start_evidence, start_captures, child_routine, edge, execution, child_path) -> match normalize_initial_active(n, starts, next, position, Cons(char, rest), after_input, input_evidence, input_captures, state, regular, constraints, start_evidence, start_captures, edge, execution)
      InitialActiveNormalized(raw_regular, normalized_edge, normalized_execution) -> match lift_repeat_closing_active_path(n, starts, next, lazy, Cons(char, rest), after_input, state, start_evidence, start_captures, child_final_evidence, child_routine, child_path)
        RepeatClosingPathLifted(repeat_routine, repeat_path) -> RepeatContinuationActive(state, raw_regular, start_evidence, start_captures, Cons(EndListEvidence(), child_final_evidence), repeat_routine, normalized_edge, normalized_execution, repeat_path)

  fn project_alternate_left_executed_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {combined_routine: List(ExtendedInstruction)}, combined_path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) -> AlternateLeftExecutedPathProjection(left_count, left_machine, input, after_input, source, current_evidence, current_captures, final_evidence) = match project_alternate_left_path(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, combined_path)
    mk_pair(child_final_evidence, mk_pair(child_routine, mk_pair(child_path, final_is_marked))) ->
      let child_final_captures = accepting_final_captures(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path)
      %[child_final_evidence, child_final_captures, child_routine, child_path, accepting_path_execution_exact(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path), final_is_marked]

  fn alternate_left_active_path_captures(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, combined_routine: List(ExtendedInstruction), combined_path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) -> AlternateLeftCapturedPathProjection(left_count, left_machine, input, after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine, combined_path)) = match project_alternate_left_shared_execution(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, combined_path)
    ProjectedAlternateLeftSharedExecution(child_final_evidence, child_routine, child_path, shared_final_captures, child_execution, combined_execution, final_is_marked) -> CapturedAlternateLeftPath(child_final_evidence, child_routine, child_path, final_is_marked, shared_execution_final_captures(current_evidence, current_captures, accepting_final_captures(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path), accepting_final_captures(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine, combined_path), shared_final_captures, accepting_path_execution_exact(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path), accepting_path_execution_exact(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine, combined_path), child_execution, combined_execution))

  fn project_alternate_left_acceptance_from(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, origin: FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), initial_machine_destinations(left_count, left_machine, position, input, after_input), destination), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), input_evidence, input_captures, initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateLeftAcceptanceFromProjection(left_count, left_machine, position, input, after_input, input_evidence, input_captures, final_evidence) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> match origin
        FilteredLeftActiveOrigin(source, regular, child_edge) -> match project_alternate_left_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, input, after_input, source, initial_evidence, initial_captures, path)
          mk_pair(child_final_evidence, mk_pair(child_routine, mk_pair(child_path, final_is_marked))) -> %[child_final_evidence, %[Active(source, regular, Nil()), initial_evidence, initial_captures, child_routine, child_edge, execution, child_path], final_is_marked]
        FilteredLeftAcceptedOrigin(regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
          AcceptedPathNow() -> match split_appended_routine_execution(regular, Cons(EmitLeft(), Nil()), input_evidence, input_captures, execution)
            AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
              RoutineStep(_, marker_suffix) -> match marker_suffix
                RoutineDone() -> %[child_final_evidence, %[Accepted(regular, Nil()), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()], reflexive(Cons(LeftEvidence(), child_final_evidence))]

  fn project_alternate_left_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, origin: FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), initial_machine_destinations(left_count, left_machine, position, input, after_input), destination), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateLeftAcceptanceProjection(left_count, left_machine, position, input, after_input, final_evidence) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> match origin
        FilteredLeftActiveOrigin(source, regular, child_edge) -> match project_alternate_left_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, input, after_input, source, initial_evidence, initial_captures, path)
          mk_pair(child_final_evidence, mk_pair(child_routine, mk_pair(child_path, final_is_marked))) -> %[child_final_evidence, %[Active(source, regular, Nil()), initial_evidence, initial_captures, child_routine, child_edge, execution, child_path], final_is_marked]
        FilteredLeftAcceptedOrigin(regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
          AcceptedPathNow() -> match split_appended_routine_execution(regular, Cons(EmitLeft(), Nil()), Nil(), Nil(), execution)
            AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
              RoutineStep(_, marker_suffix) -> match marker_suffix
                RoutineDone() -> %[child_final_evidence, %[Accepted(regular, Nil()), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()], reflexive(Cons(LeftEvidence(), child_final_evidence))]

  fn alternate_initial_origin_for_machines(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, initial_machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), position, input, after_input))) -> AlternateInitialOrigin(left_count, right_count, initial_machine_destinations(left_count, left_machine, position, input, after_input), initial_machine_destinations(right_count, right_machine, position, input, after_input), combined) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> alternate_initial_origin(left_count, left_starts, right_count, right_starts, prefer_right, initial_position_boundary(position, append_characters(input, after_input)), combined, edge)

  fn project_group_acceptance_from(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(n, group_pattern_machine(n, starts, next), position, input, after_input, input_evidence, input_captures, final_evidence)) -> GroupAcceptanceFromProjection(n, starts, next, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance_path_final_captures(n, group_pattern_machine(n, starts, next), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> project_group_acceptance_components(n, starts, next, position, input, after_input, input_evidence, input_captures, destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, path)

  fn predicate_alternate_machine_acceptance_encodes(left: Char -> Bool, right: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(plus(S(Z()), S(Z())), predicate_alternate_machine(left, right), position, Cons(char, Nil()), after_input, final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = predicate_alternate_mode_machine_acceptance_encodes(left, right, false, char, after_input, position, final_evidence, routine, acceptance)
end
