  @reducible
  fn lookaround_exact_filtered_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  @reducible
  fn atomic_admitted_prepend({n: Nat}, prefix: List(LookaroundAdmittedState(n)), tail: List(LookaroundAdmittedState(n))) -> List(LookaroundAdmittedState(n)) = match prefix
    [] -> tail
    [head | rest] -> Cons(head, atomic_admitted_prepend(rest, tail))

  ## Publish an existing relevant suffix through the constructor-correlated
  ## package representation. Recursive strict-cursor proofs use this bridge
  ## once, then advance the package without inspecting erased evidence.
  @reducible
  fn lookaround_admitted_cursor_suffix_package(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner) = match suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) ->
      lookaround_admitted_cursor_suffix_package_here(equality)
    LookaroundAdmittedStateCursorSuffixDrop(head, prior) ->
      lookaround_admitted_cursor_suffix_package_drop(
        head,
        lookaround_admitted_cursor_suffix_package(prior)
      )

  ## Recover the erased indexed suffix represented by a relevant runtime
  ## package. This is the inverse observation used at proof boundaries: the
  ## package shape may be inspected, but every head and equality remains
  ## erased in the reconstructed witness.
  @reducible
  fn lookaround_admitted_cursor_suffix_package_evidence(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    package: LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffix(n, outer, inner) = match package
    LookaroundAdmittedStateCursorSuffixHerePacked(equality) ->
      LookaroundAdmittedStateCursorSuffixHere(equality)
    LookaroundAdmittedStateCursorSuffixDropPacked(head, prior) ->
      LookaroundAdmittedStateCursorSuffixDrop(
        head,
        lookaround_admitted_cursor_suffix_package_evidence(prior)
      )

  type LookaroundAdmittedCursorInnerEquivalentAuthority(n: Nat) indices (left: List(LookaroundAdmittedState(n)), right: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedCursorInnerEquivalentPacked : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), left, right)) -> LookaroundAdmittedCursorInnerEquivalentAuthority(n, left, right)

  fn atomic_path_cursor_shape_package_location(
    left: LookaroundAdmittedStateCursorShape,
    {@erased n: Nat},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    right: LookaroundAdmittedStateCursorSuffixPackage(
      n, right_outer, right_inner
    )
  ) -> AtomicPathCursorShapeLocation = match left
    LookaroundAdmittedStateCursorShapeHere() -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeSame()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, _) ->
        AtomicPathCursorShapeRightAfter()
    LookaroundAdmittedStateCursorShapeDrop(left_prior) -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeLeftAfter()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, right_prior) ->
        atomic_path_cursor_shape_package_location(left_prior, right_prior)

  fn atomic_path_cursor_shape_location(
    {@erased n: Nat},
    {@erased left_outer: List(LookaroundAdmittedState(n))},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased left_inner: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    left: LookaroundAdmittedStateCursorSuffixPackage(
      n, left_outer, left_inner
    ),
    right: LookaroundAdmittedStateCursorSuffixPackage(
      n, right_outer, right_inner
    )
  ) -> AtomicPathCursorShapeLocation = match left
    LookaroundAdmittedStateCursorSuffixHerePacked(_) -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeSame()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, _) ->
        AtomicPathCursorShapeRightAfter()
    LookaroundAdmittedStateCursorSuffixDropPacked(_, left_prior) -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeLeftAfter()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, right_prior) ->
        atomic_path_cursor_shape_location(left_prior, right_prior)

  ## A non-empty cursor current proves that its whole spine is non-empty too.
  ## Keep the decomposition existential and erased: callers need the
  ## construction-site equality to refine a rejected child, but no runtime
  ## representation of the chosen head or tail is allowed to escape.
  type LookaroundAdmittedNonempty(n: Nat) indices (whole: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedNonemptyPacked : (@erased head: LookaroundAdmittedState(n)) -> (@erased tail: List(LookaroundAdmittedState(n))) -> (@erased equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, Cons(head, tail))) -> LookaroundAdmittedNonempty(n, whole)

  ## A selected child suffix is either still at the rejected head or has
  ## dropped into its sibling tail.  Keeping that split indexed lets the
  ## recursive proof choose the child contradiction without inspecting an
  ## erased list at runtime.
  type AtomicPathSelectedChildLocation(n: Nat) indices (head: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathSelectedChildHere : (@erased head: LookaroundAdmittedState(n)) -> (@erased rest: List(LookaroundAdmittedState(n))) -> AtomicPathSelectedChildLocation(n, head, rest, Cons(head, rest))
    AtomicPathSelectedChildThere : (@erased head: LookaroundAdmittedState(n)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, rest, current)) -> AtomicPathSelectedChildLocation(n, head, rest, current)

  type LookaroundAdmittedStateCursorAlignment(n: Nat) indices (left: List(LookaroundAdmittedState(n)), right: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedCursorLeftToRight : (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, left, right)) -> LookaroundAdmittedStateCursorAlignment(n, left, right)
    LookaroundAdmittedCursorRightToLeft : (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, right, left)) -> LookaroundAdmittedStateCursorAlignment(n, left, right)

  ## A proper suffix records at least one dropped candidate.  Ordinary cursor
  ## suffixes also admit equality, which was too weak for the reverse atomic
  ## branch: after recursive alignment it forgot that the selected cursor was
  ## strictly before the failed cursor.  Retaining the dropped head makes that
  ## ordering available to the skipped-prefix eliminator without a Boolean or
  ## an unchecked list comparison.
  type AtomicPathStrictCursorSuffix(n: Nat) indices (outer: List(LookaroundAdmittedState(n)), inner: List(LookaroundAdmittedState(n)))
    AtomicPathStrictCursorSuffixDrop : (head: LookaroundAdmittedState(n)) -> (tail: List(LookaroundAdmittedState(n))) -> (suffix: LookaroundAdmittedStateCursorSuffix(n, tail, inner)) -> AtomicPathStrictCursorSuffix(n, Cons(head, tail), inner)

  ## Constructor-correlated carrier for strict commit/selection recursion.
  ## The commit payload is instantiated with one relevant existential that
  ## ties an exact erased cause to its structure, plus the relevant cursor
  ## package and exact selected-trace package.
  ## A relevant location tag keeps those values together across recursive
  ## callbacks without projecting anything from the erased cause.
  type AtomicPathCommitSelectedLocationPackage(n: Nat, commit_package: Type, commit_cursor_package: Type, selected_trace_package: Type, selected_skipped_package: Type) indices (commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitSelectedSamePacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), commit_current, selected_current)) -> AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)
    AtomicPathCommitSelectedLeftAfterPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (marker: LookaroundAdmittedStateCursorSuffixPackage(n, selected_current, commit_current)) -> AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)
    AtomicPathCommitSelectedRightAfterPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (marker: LookaroundAdmittedStateCursorSuffixPackage(n, commit_current, selected_current)) -> AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)

  ## One-constructor authorities preserve the branch refinement beyond a
  ## fold callback. Recursive forward traversal cannot manufacture LeftAfter,
  ## so terminal and recursive consumers receive only the case they prove.
  type AtomicPathCommitSelectedSameAuthorityPackage(n: Nat, commit_package: Type, commit_cursor_package: Type, selected_trace_package: Type, selected_skipped_package: Type) indices (commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitSelectedSameAuthorityPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), commit_current, selected_current)) -> AtomicPathCommitSelectedSameAuthorityPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)

  type AtomicPathCommitSelectedRightAuthorityPackage(n: Nat, commit_package: Type, commit_cursor_package: Type, selected_trace_package: Type, selected_skipped_package: Type) indices (commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitSelectedRightAuthorityPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (marker: LookaroundAdmittedStateCursorSuffixPackage(n, commit_current, selected_current)) -> AtomicPathCommitSelectedRightAuthorityPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)

  ## The active-child induction needs one more distinction than ordinary cursor
  ## alignment: a selected suffix may still be at the rejected head, may have
  ## dropped into its sibling tail, or may precede the failed suffix.  Keep all
  ## three cases in an erased indexed witness so the construction site can
  ## dispatch without inspecting proof data at runtime.
  type AtomicPathActiveChildAlignment(n: Nat) indices (candidate: LookaroundAdmittedState(n), remaining: List(LookaroundAdmittedState(n)), failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentHere : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, Cons(candidate, remaining))) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, Cons(candidate, remaining))
    AtomicPathActiveChildAlignmentThere : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, current)) -> (@erased tail: LookaroundAdmittedStateCursorSuffix(n, remaining, current)) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, current)
    AtomicPathActiveChildAlignmentReverse : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, current, failure_current)) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, current)

  ## The package-consuming projection deliberately forgets the existential
  ## head and tail values.  They are needed only to refine the erased whole
  ## list; callers dispatch on the resulting location, not on proof payload.
  type AtomicPathActiveChildAlignmentCase(n: Nat) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentCaseHere : AtomicPathActiveChildAlignmentCase(n, failure_current, current)
    AtomicPathActiveChildAlignmentCaseThere : AtomicPathActiveChildAlignmentCase(n, failure_current, current)
    AtomicPathActiveChildAlignmentCaseReverse : AtomicPathActiveChildAlignmentCase(n, failure_current, current)

  ## Evidence-preserving counterpart of the compact alignment case. Branch
  ## consumers that discover their recursive proof data only after canonical
  ## comparison need the exact suffix authority, not a nullary tag whose proof
  ## had to be precomputed outside the construction site.
  type AtomicPathActiveChildAlignmentAuthority(n: Nat) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentHereAuthority : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, Cons(candidate, remaining))) -> AtomicPathActiveChildAlignmentAuthority(n, failure_current, Cons(candidate, remaining))
    AtomicPathActiveChildAlignmentThereAuthority : {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, current)) -> (@erased tail: LookaroundAdmittedStateCursorSuffix(n, remaining, current)) -> AtomicPathActiveChildAlignmentAuthority(n, failure_current, current)
    AtomicPathActiveChildAlignmentReverseAuthority : (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, current, failure_current)) -> AtomicPathActiveChildAlignmentAuthority(n, failure_current, current)

  ## Exact branch packages keep the destination-rejection payload and selected
  ## transition payload correlated with the suffix authority that classified
  ## them.  The payloads remain relevant because the recursive consumer needs
  ## their construction data; cursor proofs remain erased because they only
  ## refine the indexed spines during elaboration.
  type AtomicPathActiveChildAlignmentHerePackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildHerePacked : (failure: failure_package) -> (selected: selected_package) -> {@erased candidate: LookaroundAdmittedState(n)} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, Cons(candidate, remaining))) -> AtomicPathActiveChildAlignmentHerePackage(n, failure_package, selected_package, failure_current, Cons(candidate, remaining))

  type AtomicPathActiveChildAlignmentTherePackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildTherePacked : (failure: failure_package) -> (selected: selected_package) -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, current)) -> (@erased tail: LookaroundAdmittedStateCursorSuffix(n, remaining, current)) -> AtomicPathActiveChildAlignmentTherePackage(n, failure_package, selected_package, failure_current, current)

  type AtomicPathActiveChildAlignmentReversePackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildReversePacked : (failure: failure_package) -> (selected: selected_package) -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, current, failure_current)) -> AtomicPathActiveChildAlignmentReversePackage(n, failure_package, selected_package, failure_current, current)

  ## A child search and its selected trace may publish extensionally equal
  ## origin lists through different existential binders. Transporting the
  ## selected suffix across that equality gives both cursors one common outer
  ## spine, which is the prerequisite for the alignment eliminator below.
  fn transport_lookaround_admitted_cursor_suffix_outer(
    {n: Nat},
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    equality: Equivalent(List(LookaroundAdmittedState(n)), left, right),
    suffix: LookaroundAdmittedStateCursorSuffix(n, right, inner)
  ) -> LookaroundAdmittedStateCursorSuffix(n, left, inner) = match equality
    reflexive() -> suffix

  ## No finite list can contain one of its own proper extensions as a suffix.
  ## The recursive case removes the outer list's head and the extension's head
  ## together. This theorem is called only by the contradiction dispatcher;
  ## the entire result is eliminated before code generation.
  @reducible
  fn atomic_path_cons_cannot_be_suffix_of_its_tail(
    {n: Nat},
    head: LookaroundAdmittedState(n),
    tail: List(LookaroundAdmittedState(n)),
    suffix: LookaroundAdmittedStateCursorSuffix(n, tail, Cons(head, tail))
  ) -> Empty = match tail
    Nil() -> match suffix
      LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
    Cons(next, rest) -> match suffix
      LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      LookaroundAdmittedStateCursorSuffixDrop(_, prior) -> atomic_path_cons_cannot_be_suffix_of_its_tail(
        next,
        rest,
        lookaround_admitted_cursor_suffix_tail(head, Cons(next, rest), prior)
      )

  fn lookaround_admitted_cursor_suffix_reflexive(
    {n: Nat},
    {@erased outer: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    @erased _suffix: LookaroundAdmittedStateCursorSuffix(n, outer, current)
  ) -> LookaroundAdmittedStateCursorSuffix(n, current, current) =
    LookaroundAdmittedStateCursorSuffixHere(reflexive(current))

  fn lookaround_admitted_cursor_to_suffix({n: Nat}, {whole: List(LookaroundAdmittedState(n))}, {current: List(LookaroundAdmittedState(n))}, cursor: LookaroundAdmittedStateCursor(n, whole, current)) -> LookaroundAdmittedStateCursorWitness(n, whole, current) = match cursor
    LookaroundAdmittedStateCursorHere() -> LookaroundAdmittedStateCursorWitnessHere()
    LookaroundAdmittedStateCursorDrop(head, cursor) -> LookaroundAdmittedStateCursorWitnessDrop(head, lookaround_admitted_cursor_to_suffix(cursor))

  ## A successful positive assertion can publish capture participation to the
  ## parent's ordinary finite machine. Lookahead markers come from the routine
  ## retained by the admitting witness; only slot markers cross the boundary.
  fn lookaround_constraints_capture_context(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(List(EvidenceInstruction)) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> None()
    Some(LookaroundConstraintAdmitted(_, markers, _)) -> Some(markers)

  fn lookahead_decision_holds(n: Nat, machine: PatternMachine(n), positive: Bool, decision: LookaheadDecision(n, machine)) -> Bool = match decision
    LookaheadSatisfied(_) -> positive
    LookaheadRefuted(_) -> not positive
    LookaheadResourceExhausted(_, _, _, _, _) -> false

  fn lookbehind_decision_holds(n: Nat, machine: PatternMachine(n), positive: Bool, decision: LookbehindDecision(n, machine)) -> Bool = match decision
    LookbehindSatisfied(_) -> positive
    LookbehindRefuted(_) -> not positive
    LookbehindResourceExhausted(_, _, _, _, _) -> false

  ## Capture-aware boundary evaluation returns the selected child routine for a
  ## positive assertion. A negative assertion succeeds with an empty routine:
  ## its private capture frame is intentionally discarded. Lookahead consumes
  ## the routine retained by the same proof-carrying decision.
  fn lookaround_constraints_routine(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(List(ExtendedInstruction)) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> None()
    Some(LookaroundConstraintAdmitted(routine, _, _)) -> Some(routine)

  type LookaroundAcceptingPath(depth: Nat, n: Nat, machine: PatternMachine(n), capture_context: List(EvidenceInstruction), candidates: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy)
    LookaroundAcceptedNow : LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Nil(), after_input, ThreadAccepted(), history, policy)
