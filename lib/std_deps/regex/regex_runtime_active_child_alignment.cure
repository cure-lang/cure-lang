  ## The active-child induction needs one more distinction than ordinary cursor
  ## alignment: a selected suffix may still be at the rejected head, may have
  ## dropped into its sibling tail, or may precede the failed suffix.  Keep all
  ## three cases in an erased indexed witness so the construction site can
  ## dispatch without inspecting proof data at runtime.
  type AtomicPathActiveChildAlignment(n: Nat) indices (candidate: LookaroundAdmittedState(n), remaining: List(LookaroundAdmittedState(n)), failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentHere : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, Cons(candidate, remaining))) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, Cons(candidate, remaining))
    AtomicPathActiveChildAlignmentThere : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, current)) -> (@erased tail: LookaroundAdmittedStateCursorSuffix(n, remaining, current)) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, current)
    AtomicPathActiveChildAlignmentReverse : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, current, failure_current)) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, current)

  fn atomic_path_active_child_alignment(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_head: LookaroundAdmittedState(n)},
    {failure_tail: List(LookaroundAdmittedState(n))},
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      Cons(failure_head, failure_tail)
    ),
    {selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)
  ) -> AtomicPathActiveChildAlignment(n, failure_head, failure_tail, failure_current, selected_current) =
    let anchored_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      Cons(failure_head, failure_tail),
      selected_whole
    ) = trans(
      sym(failure_nonempty_equivalence),
      selected_whole_equivalence
    )
    match atomic_child_cursor_alignment(
      failure_suffix,
      selected_whole_equivalence,
      selected_suffix
    )
      LookaroundAdmittedCursorLeftToRight(alignment) -> match atomic_path_selected_child_suffix_location(
        transport_lookaround_admitted_cursor_suffix_outer(
          anchored_equivalence,
          selected_suffix
        )
      )
        AtomicPathSelectedChildHere(candidate_value, remaining_value) -> AtomicPathActiveChildAlignmentHere(alignment)
        AtomicPathSelectedChildThere(candidate_value, suffix_value) -> AtomicPathActiveChildAlignmentThere(alignment, suffix_value)
      LookaroundAdmittedCursorRightToLeft(alignment) -> AtomicPathActiveChildAlignmentReverse(alignment)
end
