  use Std.Equivalent

  fn accepting_next_active_final_captures(
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    current_evidence: List(Evidence),
    current_captures: List(CaptureFrame),
    destination: Bounded(n),
    regular: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    destination_evidence: List(Evidence),
    destination_captures: List(CaptureFrame),
    suffix_routine: List(ExtendedInstruction),
    edge: ListMember(MachineState(n), Active(destination, regular, constraints), machine_destinations(n, machine, ThreadActive(source), char, transition_boundary_before(char, rest, after_input))),
    execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures),
    @erased final_evidence: List(Evidence),
    suffix: AcceptingFrom(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine),
    path: AcceptingFrom(n, machine, Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine))
  ) -> Equivalent(List(CaptureFrame), accepting_final_captures(n, machine, Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), path), accepting_final_captures(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)) =
    let supplied = ExtendedEvidenceObserve(char, append_extended_routine_execution_inferred(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, extend_routine_execution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution), accepting_path_execution_exact(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)))
    match extended_routine_execution_unique(current_evidence, current_captures, accepting_path_execution_exact(n, machine, Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), path), supplied)
      mk_pair(_, captures_exact) -> captures_exact

  fn accepting_next_accepted_final_captures(
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    current_evidence: List(Evidence),
    current_captures: List(CaptureFrame),
    regular: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    destination_evidence: List(Evidence),
    destination_captures: List(CaptureFrame),
    suffix_routine: List(ExtendedInstruction),
    edge: ListMember(MachineState(n), Accepted(regular, constraints), machine_destinations(n, machine, ThreadActive(source), char, transition_boundary_before(char, rest, after_input))),
    execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures),
    @erased final_evidence: List(Evidence),
    suffix: AcceptingFrom(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine),
    path: AcceptingFrom(n, machine, Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine))
  ) -> Equivalent(List(CaptureFrame), accepting_final_captures(n, machine, Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), path), accepting_final_captures(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)) =
    let supplied = ExtendedEvidenceObserve(char, append_extended_routine_execution_inferred(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, extend_routine_execution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution), accepting_path_execution_exact(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)))
    match extended_routine_execution_unique(current_evidence, current_captures, accepting_path_execution_exact(n, machine, Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), path), supplied)
      mk_pair(_, captures_exact) -> captures_exact

  fn staged_initial_destinations_equivalent(
    {shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char)
  ) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    initial_machine_destinations(thompson_state_count(compilation), staged_machine_from_compilation(compilation), position, input, after_input),
    initial_machine_destinations(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input)
  ) =
    let canonical = thompson_machine(compilation)
    let boundary = initial_position_boundary(position, append_characters(input, after_input))
    trans(
      initial_machine_destinations_equation(thompson_state_count(compilation), staged_machine_from_compilation(compilation), position, input, after_input),
      trans(
        filter_boundary_equation(
          thompson_state_count(compilation),
          pattern_machine_starts(staged_machine_from_compilation(compilation)),
          pattern_machine_starts(canonical),
          boundary,
          staged_machine_starts_equivalent(compilation)
        ),
        sym(initial_machine_destinations_equation(thompson_state_count(compilation), canonical, position, input, after_input))
      )
    )

  fn staged_machine_destinations_equivalent(
    {shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    state: Bounded(thompson_state_count(compilation)),
    char: Char,
    boundary: Boundary
  ) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    machine_destinations(thompson_state_count(compilation), staged_machine_from_compilation(compilation), ThreadActive(state), char, boundary),
    machine_destinations(thompson_state_count(compilation), thompson_machine(compilation), ThreadActive(state), char, boundary)
  ) =
    let canonical = thompson_machine(compilation)
    let staged = staged_machine_from_compilation(compilation)
    let staged_destinations = machine_destinations_equation(thompson_state_count(compilation), staged, state, char, boundary)
    let canonical_destinations = machine_destinations_equation(thompson_state_count(compilation), canonical, state, char, boundary)
    let staged_next = staged_machine_next_equation(compilation, state, char)
    trans(
      staged_destinations,
      trans(
        filter_boundary_equation(thompson_state_count(compilation), pattern_machine_next_at(staged, state, char), transition_rows_next(direct_staged_rows_values_from_compilation(compilation), state, char), boundary, staged_next),
        trans(
          filter_boundary_equation(thompson_state_count(compilation), transition_rows_next(direct_staged_rows_values_from_compilation(compilation), state, char), pattern_machine_next_at(canonical, state, char), boundary, staged_rows_transition_equivalent(compilation, state, char)),
          sym(canonical_destinations)
        )
      )
    )
end
