  ## Public package-native active-root wrapper. This is the migration target
  ## for callers that already receive `AtomicSelectedTracePackage` from the
  ## start-search success result.
  @reducible
  fn atomic_start_refutation_rejected_active_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, prefix_mode: Bool,
    reversed_prefix: List(Char), state: Bounded(n),
    routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      rest, selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_rejected_active_excludes_package(
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    trace_package,
    tail_case
  )

  ## Public package-native accepted-root wrapper. Unlike the trace-only
  ## predecessor it needs neither the accepted-tail recovery package nor a
  ## second erased trace specialized to the head candidate.
  @reducible
  fn atomic_start_refutation_rejected_accepted_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, child_char: Char, child_rest: List(Char),
    after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest, selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_rejected_accepted_excludes_package(
    machine,
    position,
    child_char,
    child_rest,
    after_input,
    history,
    capture_context,
    policy,
    reversed_prefix,
    accepted_routine,
    accepted_constraints,
    accepted_assertion_routine,
    accepted_assertion_markers,
    accepted_nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    trace_package,
    tail_case
  )

  ## An active start candidate rejected by its child cannot also be the head of
  ## a selected trace.  The rejection constructor publishes the child's exact
  ## suffix and refutation; this consumer passes both to the indexed child
  ## theorem instead of rebuilding either witness from an unindexed list.
  fn atomic_start_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      policy,
      atomic_scope_depth_after(routine, Z()),
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureInputExhausted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartActive(_, _, _, _, _, _, _, _, _, _, _, _, _, suffix) ->
      atomic_path_child_input_exhaustion_excludes_trace(
        machine,
        after_input,
        state,
        history,
        append_routine(append_routine(capture_context, routine), assertion_markers),
        policy,
        atomic_scope_depth_after(routine, Z()),
        prefix_mode,
        reversed_prefix,
        child_failure,
        child_suffix,
        suffix
      )

  ## An accepted start candidate cannot be selected when its child search
  ## rejects an exact match that leaves input behind.  The child failure's
  ## cursor suffix is consumed by the existing exact-child eliminator; this
  ## keeps start-list rejection on the same construction-site proof path as
  ## destination rejection.
  fn atomic_start_accepted_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureExactAccepted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartAccepted(_, _, _, _, _, _, _, _, _, _, _, _, suffix) ->
      atomic_path_child_exact_failure_excludes_trace(
        machine,
        child_char,
        child_rest,
        after_input,
        history,
        append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
        policy,
        atomic_scope_depth_after(accepted_routine, Z()),
        reversed_prefix,
        child_failure,
        child_suffix,
        suffix
      )

  ## Consume the child suffix at the destination-rejection construction site.
  ## The parent failure is active and the child input is exhausted, so the
  ## selected parent trace can only expose the active transition constructor.
  ## Its child trace and selected-child suffix are passed together with the
  ## refutation's published suffix; the aligned-child theorem consumes the
  ## stored child suffix before eliminating the exhausted child.
  fn atomic_path_destination_rejection_excludes_stored_aligned_child({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), destination: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {whole: List(LookaroundAdmittedState(n))}, {remaining: List(LookaroundAdmittedState(n))}, @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), AtomicPathFailureDestinationRejected()), {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, child_suffix, child_scope_alignment, _, _, _, _) -> match path
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_selection_suffix, child_selection_from_origin, _, _, child_trace) -> match child_scope_alignment
        LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match child_failure
          AtomicPathInputExhausted(_, stored_child_suffix) -> match child_suffix
            LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_child_suffix
              LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_destination_rejection_excludes_aligned_child(machine, char, after_input, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, destination, routine, assertion_markers, child_selection_suffix, child_failure, child_suffix, child_trace)

  ## Base case for a selected trace at the accepted sibling after one rejected
  ## head. The parent-to-selected cursor is retained as an erased `Drop`
  ## index; the fixed two-state parent and singleton selected list make the
  ## reflexive branch impossible, so no runtime suffix inspection is needed.
  ## The accepted-child eliminator is then reused at the exact sibling where
  ## the selected trace begins. General non-empty tails remain recursive work.
  fn atomic_path_tail_drop_rejection_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased rejected_head: LookaroundAdmittedState(n)},
    tail_routine: List(EvidenceInstruction),
    tail_constraints: List(BoundaryConstraint),
    tail_assertion_routine: List(ExtendedInstruction),
    tail_assertion_markers: List(EvidenceInstruction),
    tail_nested_decisions: List(LookaroundNestedDecision),
    {@erased tail_remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(rejected_head, Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    @erased selection_from_parent: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(rejected_head, Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)),
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match tail_failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, _, child_scope_alignment, _, _, _, _) -> match path
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> match child_scope_alignment
        LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match child_failure
          AtomicPathExactAcceptedWithInput(_, _, _, _) -> atomic_path_failure_excludes_selected_suffix(
            machine,
            char,
            rest,
            after_input,
            ThreadActive(source),
            history,
            capture_context,
            policy,
            scope_depth,
            reversed_prefix,
            tail_routine,
            tail_constraints,
            tail_assertion_routine,
            tail_assertion_markers,
            tail_nested_decisions,
            child_failure,
            path
          )
end
