  @reducible
  fn machine_destinations(n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, boundary: Boundary) -> List(MachineState(n)) = match state
    ThreadAccepted() -> []
    ThreadActive(active) -> match machine
      MkPatternMachine(_, next) -> filter_boundary_states(next(active, char), boundary)

  ## Named machines may carry capture-participation constraints on their
  ## destination states. Those constraints are checked against the regular
  ## evidence already executed on the path plus the destination's epsilon
  ## routine: a group that participated contributes its EndCaptureSlot
  ## instruction before the guarded branch is entered. Observe instructions
  ## are intentionally erased from this view; they only advance capture text.
  ## Ordinary machines deliberately continue through `machine_destinations`,
  ## whose indexed proof contract does not mention capture conditions.
  fn extended_regular_instructions(routine: List(ExtendedInstruction)) -> List(EvidenceInstruction) = match routine
    [] -> []
    [Regular(instruction) | rest] -> [instruction | extended_regular_instructions(rest)]
    [Observe(_) | rest] -> extended_regular_instructions(rest)
end
