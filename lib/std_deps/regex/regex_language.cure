  use Std.Regex.Proof.GroupAcceptance
  use Std.Regex.Proof.RepeatProjection
  use Std.Regex.Proof.ConcatLeft
  use Std.Regex.Proof.SupportC
  use Std.Regex.Proof.SupportA
  use Std.Regex.Proof.FoundationalViews
  use Std.Regex.Proof.ExecutionViews
  use Std.Regex.Runtime.CompilationMachines
  use Std.Regex.Runtime.CompilationTypes
  use Std.Regex.Runtime.EvidenceExecution
  use Std.Regex.Runtime.ExtendedEvidenceTypes
