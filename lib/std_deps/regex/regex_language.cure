## Constructive language semantics for typed regular expressions. Denotations
## retain the exact input partition, contextual suffix, and recursive evidence
## needed to relate an accepted Thompson-machine path to the authored pattern.
@group(:text)
mod Std.Regex.Language
  public use Std.Regex.Language.Roots4
  public use Std.Regex.Language.Roots3
  public use Std.Regex.Language.Roots2
  public use Std.Regex.Language.Roots
  use Std.Regex.Proof.AcceptanceCaptures
  use Std.Regex.Proof.Roots6
