  fn boundary_acceptance_path_is_sound(
    constraint: BoundaryConstraint,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(Z(), boundary_pattern_machine(constraint), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(UnitC, PatternBoundary(constraint), position, input, after_input) =
    transport_boundary_nil_soundness(constraint, input, after_input, position, input_evidence, input_captures, final_evidence, boundary_acceptance_input_empty(constraint, input, after_input, position, input_evidence, input_captures, acceptance), acceptance)






  fn predicate_concat_acceptance_is_sound(
    left_test: Char -> Bool,
    right_test: Char -> Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(plus(S(Z()), S(Z())), concat_pattern_machine(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test)), position, input, after_input, final_evidence, routine)
  ) -> PatternDenotation(PairC(CharC, CharC), PatternConcat(PatternPredicate(left_test), PatternPredicate(right_test)), position, input, after_input) =
    let no_evidence: List(Evidence) = Nil()
    let no_captures: List(CaptureFrame) = Nil()
    match project_concat_acceptance_from(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test), position, input, after_input, no_evidence, no_captures, machine_acceptance_path(plus(S(Z()), S(Z())), concat_pattern_machine(S(Z()), predicate_pattern_machine(left_test), S(Z()), predicate_pattern_machine(right_test)), position, input, after_input, acceptance))
      ProjectedConcatAcceptance(left_input, right_input, partition, left_final_evidence, left_final_captures, left_acceptance, _, right_final_evidence, right_acceptance, _) ->
        DenotesConcat(
          PatternPredicate(left_test), PatternPredicate(right_test), left_input, right_input, partition,
          predicate_acceptance_path_is_sound(left_test, left_input, append_characters(right_input, after_input), position, no_evidence, no_captures, left_final_evidence, left_acceptance),
          predicate_acceptance_path_is_sound(right_test, right_input, after_input, advance_initial_position(position, left_input), left_final_evidence, left_final_captures, right_final_evidence, right_acceptance)
        )



  fn predicate_repeat_mode_projection_is_sound(
    test: Char -> Bool,
    lazy: Bool,
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    item_input_evidence: List(Evidence),
    item_input_captures: List(CaptureFrame),
    state: Bounded(S(Z())),
    initial_routine: List(EvidenceInstruction),
    initial_evidence: List(Evidence),
    initial_captures: List(CaptureFrame),
    initial_edge: ListMember(MachineState(S(Z())), Active(state, initial_routine, Nil()), initial_machine_destinations(S(Z()), predicate_pattern_machine(test), position, input, after_input)),
    initial_execution: RoutineExecution(initial_routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures),
    @erased final_evidence: List(Evidence),
    {final_captures: List(CaptureFrame)},
    projection: RepeatActivePathProjection(S(Z()), predicate_pattern_machine(test), lazy, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)
  ) -> PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input) = match projection
    ProjectedRepeatFinalItem(child_final_evidence, _, child_routine, child_path, _, _, _, _, _) ->
      let child_acceptance = active_acceptance_from_path(S(Z()), predicate_pattern_machine(test), position, input, after_input, item_input_evidence, item_input_captures, state, initial_routine, initial_evidence, initial_captures, child_routine, initial_edge, initial_execution, child_path)
      let child_denotation = predicate_acceptance_path_is_sound(test, input, after_input, position, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance)
      DenotesRepeatModeMore(PatternPredicate(test), lazy, input, Nil(), active_accepting_path_nonempty(S(Z()), predicate_pattern_machine(test), input, after_input, state, initial_evidence, initial_captures, child_final_evidence, child_routine, child_path), input_partition_all_left(input), child_denotation, DenotesRepeatModeEmpty(PatternPredicate(test), lazy))
    ProjectedRepeatMoreItems(child_input, remaining_input, partition, child_final_evidence, child_final_captures, child_routine, child_path, _, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, combined_final_captures, continuation) ->
      let original_filtered_edge = filtered_starts_from_initial_edge(S(Z()), predicate_pattern_machine(test), position, input, after_input, Active(state, initial_routine, Nil()), initial_edge)
      let child_filtered_edge = transport_filtered_start_subject(S(Z()), predicate_pattern_machine(test), position, append_characters(input, after_input), append_characters(child_input, append_characters(remaining_input, after_input)), Active(state, initial_routine, Nil()), partition_append_after(after_input, partition), original_filtered_edge)
      let child_initial_edge = initial_edge_from_filtered_starts(S(Z()), predicate_pattern_machine(test), position, child_input, append_characters(remaining_input, after_input), Active(state, initial_routine, Nil()), child_filtered_edge)
      let child_acceptance = active_acceptance_from_path(S(Z()), predicate_pattern_machine(test), position, child_input, append_characters(remaining_input, after_input), item_input_evidence, item_input_captures, state, initial_routine, initial_evidence, initial_captures, child_routine, child_initial_edge, initial_execution, child_path)
      let child_denotation = predicate_acceptance_path_is_sound(test, child_input, append_characters(remaining_input, after_input), position, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance)
      let remaining_denotation = predicate_repeat_mode_projection_is_sound(test, lazy, advance_initial_position(position, child_input), remaining_input, after_input, child_final_evidence, child_final_captures, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, continuation)
      DenotesRepeatModeMore(PatternPredicate(test), lazy, child_input, remaining_input, active_accepting_path_nonempty(S(Z()), predicate_pattern_machine(test), child_input, append_characters(remaining_input, after_input), state, initial_evidence, initial_captures, child_final_evidence, child_routine, child_path), partition, child_denotation, remaining_denotation)

  fn predicate_repeat_mode_acceptance_path_is_sound(
    test: Char -> Bool,
    lazy: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, input, after_input, Nil(), Nil(), final_evidence)
  ) -> PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input) =
    let no_evidence: List(Evidence) = Nil()
    let no_captures: List(CaptureFrame) = Nil()
    match project_repeat_acceptance_from_machine(S(Z()), predicate_pattern_machine(test), lazy, position, input, after_input, no_evidence, no_captures, acceptance)
      ProjectedRepeatEmptyAcceptance(input_empty, _, _, _, _) -> match input_empty
        reflexive() -> DenotesRepeatModeEmpty(PatternPredicate(test), lazy)
      ProjectedRepeatItemsAcceptance(state, initial_routine, list_evidence, list_captures, initial_evidence, initial_captures, initial_edge, initial_execution, projection, _, _) -> predicate_repeat_mode_projection_is_sound(test, lazy, position, input, after_input, list_evidence, list_captures, state, initial_routine, initial_evidence, initial_captures, initial_edge, initial_execution, final_evidence, projection)

  fn predicate_repeat_mode_acceptance_is_sound(
    test: Char -> Bool,
    lazy: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, input, after_input, final_evidence, routine)
  ) -> PatternDenotation(ListC(CharC), PatternRepeatMode(PatternPredicate(test), lazy), position, input, after_input) =
    predicate_repeat_mode_acceptance_path_is_sound(test, lazy, input, after_input, position, final_evidence, machine_acceptance_path(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), lazy), position, input, after_input, acceptance))


  fn compilation_repeat_mode_projection_is_sound(
    {inner_shape: ShapeCode},
    inner: Pattern(inner_shape),
    compilation: ThompsonCompilation(inner_shape),
    compilation_proof: PatternCompilationProof(inner_shape, inner, compilation),
    lazy: Bool,
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    item_input_evidence: List(Evidence),
    item_input_captures: List(CaptureFrame),
    state: Bounded(thompson_state_count(compilation)),
    initial_routine: List(EvidenceInstruction),
    initial_evidence: List(Evidence),
    initial_captures: List(CaptureFrame),
    initial_edge: ListMember(MachineState(thompson_state_count(compilation)), Active(state, initial_routine, Nil()), initial_machine_destinations(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input)),
    initial_execution: RoutineExecution(initial_routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures),
    @erased final_evidence: List(Evidence),
    {final_captures: List(CaptureFrame)},
    projection: RepeatActivePathProjection(thompson_state_count(compilation), thompson_machine(compilation), lazy, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)
  ) -> PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, input, after_input) = match projection
    ProjectedRepeatFinalItem(child_final_evidence, _, child_routine, child_path, _, _, _, _, _) ->
      let child_acceptance = active_acceptance_from_path(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, item_input_evidence, item_input_captures, state, initial_routine, initial_evidence, initial_captures, child_routine, initial_edge, initial_execution, child_path)
      let child_denotation = compilation_acceptance_path_is_sound(inner, compilation, compilation_proof, input, after_input, position, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance)
      DenotesRepeatModeMore(inner, lazy, input, Nil(), active_accepting_path_nonempty(thompson_state_count(compilation), thompson_machine(compilation), input, after_input, state, initial_evidence, initial_captures, child_final_evidence, child_routine, child_path), input_partition_all_left(input), child_denotation, DenotesRepeatModeEmpty(inner, lazy))
    ProjectedRepeatMoreItems(child_input, remaining_input, partition, child_final_evidence, child_final_captures, child_routine, child_path, _, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, combined_final_captures, continuation) ->
      let original_filtered_edge = filtered_starts_from_initial_edge(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, Active(state, initial_routine, Nil()), initial_edge)
      let child_filtered_edge = transport_filtered_start_subject(thompson_state_count(compilation), thompson_machine(compilation), position, append_characters(input, after_input), append_characters(child_input, append_characters(remaining_input, after_input)), Active(state, initial_routine, Nil()), partition_append_after(after_input, partition), original_filtered_edge)
      let child_initial_edge = initial_edge_from_filtered_starts(thompson_state_count(compilation), thompson_machine(compilation), position, child_input, append_characters(remaining_input, after_input), Active(state, initial_routine, Nil()), child_filtered_edge)
      let child_acceptance = active_acceptance_from_path(thompson_state_count(compilation), thompson_machine(compilation), position, child_input, append_characters(remaining_input, after_input), item_input_evidence, item_input_captures, state, initial_routine, initial_evidence, initial_captures, child_routine, child_initial_edge, initial_execution, child_path)
      let child_denotation = compilation_acceptance_path_is_sound(inner, compilation, compilation_proof, child_input, append_characters(remaining_input, after_input), position, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance)
      let remaining_denotation = compilation_repeat_mode_projection_is_sound(inner, compilation, compilation_proof, lazy, advance_initial_position(position, child_input), remaining_input, after_input, child_final_evidence, child_final_captures, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, continuation)
      DenotesRepeatModeMore(inner, lazy, child_input, remaining_input, active_accepting_path_nonempty(thompson_state_count(compilation), thompson_machine(compilation), child_input, append_characters(remaining_input, after_input), state, initial_evidence, initial_captures, child_final_evidence, child_routine, child_path), partition, child_denotation, remaining_denotation)

  fn compilation_repeat_mode_acceptance_path_is_sound(
    {inner_shape: ShapeCode},
    inner: Pattern(inner_shape),
    compilation: ThompsonCompilation(inner_shape),
    compilation_proof: PatternCompilationProof(inner_shape, inner, compilation),
    lazy: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(thompson_state_count(compilation), repeat_pattern_machine(thompson_state_count(compilation), thompson_machine(compilation), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, input, after_input) =
    match project_repeat_acceptance_from_machine(thompson_state_count(compilation), thompson_machine(compilation), lazy, position, input, after_input, input_evidence, input_captures, acceptance)
      ProjectedRepeatEmptyAcceptance(input_empty, _, _, _, _) -> match input_empty
        reflexive() -> DenotesRepeatModeEmpty(inner, lazy)
      ProjectedRepeatItemsAcceptance(state, initial_routine, list_evidence, list_captures, initial_evidence, initial_captures, initial_edge, initial_execution, projection, _, _) -> compilation_repeat_mode_projection_is_sound(inner, compilation, compilation_proof, lazy, position, input, after_input, list_evidence, list_captures, state, initial_routine, initial_evidence, initial_captures, initial_edge, initial_execution, final_evidence, projection)

  fn predicate_compilation_is_sound(
    test: Char -> Bool,
    {pattern: Pattern(CharC)},
    proof: PatternCompilationProof(CharC, pattern, ThompsonPredicate(test)),
    input: List(Char), after_input: List(Char), position: InitialPosition,
    input_evidence: List(Evidence), input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(S(Z()), predicate_pattern_machine(test), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(CharC, pattern, position, input, after_input) = match proof
    CompilesPredicate(_) -> predicate_acceptance_path_is_sound(test, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)


  fn boundary_compilation_is_sound(
    constraint: BoundaryConstraint,
    {pattern: Pattern(UnitC)},
    proof: PatternCompilationProof(UnitC, pattern, ThompsonBoundary(constraint)),
    input: List(Char), after_input: List(Char), position: InitialPosition,
    input_evidence: List(Evidence), input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(Z(), boundary_pattern_machine(constraint), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(UnitC, pattern, position, input, after_input) = match proof
    CompilesBoundary(_) -> boundary_acceptance_path_is_sound(constraint, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn concat_compilation_is_sound(
    {left_shape: ShapeCode}, left_compilation: ThompsonCompilation(left_shape),
    {right_shape: ShapeCode}, right_compilation: ThompsonCompilation(right_shape),
    {pattern: Pattern(PairC(left_shape, right_shape))},
    proof: PatternCompilationProof(PairC(left_shape, right_shape), pattern, ThompsonConcat(left_compilation, right_compilation)),
    input: List(Char), after_input: List(Char), position: InitialPosition,
    input_evidence: List(Evidence), input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(plus(thompson_state_count(left_compilation), thompson_state_count(right_compilation)), concat_pattern_machine(thompson_state_count(left_compilation), thompson_machine(left_compilation), thompson_state_count(right_compilation), thompson_machine(right_compilation)), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(PairC(left_shape, right_shape), pattern, position, input, after_input) = match proof
    CompilesConcat(left, _, left_proof, right, _, right_proof) -> match project_concat_acceptance_from(thompson_state_count(left_compilation), thompson_machine(left_compilation), thompson_state_count(right_compilation), thompson_machine(right_compilation), position, input, after_input, input_evidence, input_captures, acceptance)
      ProjectedConcatAcceptance(left_input, right_input, partition, left_final_evidence, left_final_captures, left_acceptance, _, right_final_evidence, right_acceptance, _) ->
        DenotesConcat(left, right, left_input, right_input, partition, compilation_acceptance_path_is_sound(left, left_compilation, left_proof, left_input, append_characters(right_input, after_input), position, input_evidence, input_captures, left_final_evidence, left_acceptance), compilation_acceptance_path_is_sound(right, right_compilation, right_proof, right_input, after_input, advance_initial_position(position, left_input), left_final_evidence, left_final_captures, right_final_evidence, right_acceptance))

  fn group_compilation_is_sound(
    {inner_shape: ShapeCode}, inner_compilation: ThompsonCompilation(inner_shape),
    {pattern: Pattern(StringC)},
    proof: PatternCompilationProof(StringC, pattern, ThompsonGroup(inner_compilation)),
    input: List(Char), after_input: List(Char), position: InitialPosition,
    input_evidence: List(Evidence), input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(thompson_state_count(inner_compilation), thompson_machine(ThompsonGroup(inner_compilation)), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(StringC, pattern, position, input, after_input) = match proof
    CompilesGroup(inner, _, inner_proof) -> match project_group_acceptance_from(thompson_state_count(inner_compilation), pattern_machine_starts(thompson_machine(inner_compilation)), pattern_machine_next(thompson_machine(inner_compilation)), position, input, after_input, input_evidence, input_captures, acceptance)
      ProjectedGroupAcceptanceMissingFrame(child_final_evidence, child_projection, _, _, _, _) -> match transport_acceptance_with_execution(thompson_machine(inner_compilation), MkPatternMachine(pattern_machine_starts(thompson_machine(inner_compilation)), pattern_machine_next(thompson_machine(inner_compilation))), position, input, after_input, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), child_final_evidence, Nil(), pattern_machine_eta(thompson_machine(inner_compilation)), child_projection)
        AcceptedWithExecution(child_acceptance, _) -> DenotesGroup(inner, compilation_acceptance_path_is_sound(inner, inner_compilation, inner_proof, input, after_input, position, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), child_final_evidence, child_acceptance))
      ProjectedGroupAcceptanceClosedFrame(child_final_evidence, chars, saved, outer, child_projection, _, _, _, _) -> match transport_acceptance_with_execution(thompson_machine(inner_compilation), MkPatternMachine(pattern_machine_starts(thompson_machine(inner_compilation)), pattern_machine_next(thompson_machine(inner_compilation))), position, input, after_input, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), child_final_evidence, Cons(CaptureFrame(chars, saved), outer), pattern_machine_eta(thompson_machine(inner_compilation)), child_projection)
        AcceptedWithExecution(child_acceptance, _) -> DenotesGroup(inner, compilation_acceptance_path_is_sound(inner, inner_compilation, inner_proof, input, after_input, position, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), child_final_evidence, child_acceptance))

  fn alternate_compilation_is_sound(
    {left_shape: ShapeCode}, left_compilation: ThompsonCompilation(left_shape),
    {right_shape: ShapeCode}, right_compilation: ThompsonCompilation(right_shape),
    prefer_right: Bool,
    {pattern: Pattern(ChoiceC(left_shape, right_shape))},
    proof: PatternCompilationProof(ChoiceC(left_shape, right_shape), pattern, ThompsonAlternate(left_compilation, right_compilation, prefer_right)),
    input: List(Char), after_input: List(Char), position: InitialPosition,
    input_evidence: List(Evidence), input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(plus(thompson_state_count(left_compilation), thompson_state_count(right_compilation)), alternate_pattern_machine(thompson_state_count(left_compilation), thompson_machine(left_compilation), thompson_state_count(right_compilation), thompson_machine(right_compilation), prefer_right), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(ChoiceC(left_shape, right_shape), pattern, position, input, after_input) = match proof
    CompilesAlternate(left, _, left_proof, right, _, right_proof) -> match project_alternate_acceptance_from(thompson_state_count(left_compilation), thompson_machine(left_compilation), thompson_state_count(right_compilation), thompson_machine(right_compilation), False(), position, input, after_input, input_evidence, input_captures, acceptance)
      mk_pair(False(), ProjectedAlternateFromLeft(mk_pair(child_final_evidence, mk_pair(child_acceptance, _)))) -> DenotesAlternateLeft(left, right, compilation_acceptance_path_is_sound(left, left_compilation, left_proof, input, after_input, position, input_evidence, input_captures, child_final_evidence, child_acceptance))
      mk_pair(True(), ProjectedAlternateFromRight(mk_pair(child_final_evidence, mk_pair(child_acceptance, _)))) -> DenotesAlternateRight(left, right, compilation_acceptance_path_is_sound(right, right_compilation, right_proof, input, after_input, position, input_evidence, input_captures, child_final_evidence, child_acceptance))
    CompilesAlternateMode(left, _, left_proof, right, _, right_proof, _) -> match project_alternate_acceptance_from(thompson_state_count(left_compilation), thompson_machine(left_compilation), thompson_state_count(right_compilation), thompson_machine(right_compilation), prefer_right, position, input, after_input, input_evidence, input_captures, acceptance)
      mk_pair(False(), ProjectedAlternateFromLeft(mk_pair(child_final_evidence, mk_pair(child_acceptance, _)))) -> DenotesAlternateModeLeft(left, right, prefer_right, compilation_acceptance_path_is_sound(left, left_compilation, left_proof, input, after_input, position, input_evidence, input_captures, child_final_evidence, child_acceptance))
      mk_pair(True(), ProjectedAlternateFromRight(mk_pair(child_final_evidence, mk_pair(child_acceptance, _)))) -> DenotesAlternateModeRight(left, right, prefer_right, compilation_acceptance_path_is_sound(right, right_compilation, right_proof, input, after_input, position, input_evidence, input_captures, child_final_evidence, child_acceptance))

  fn repeat_compilation_is_sound(
    {inner_shape: ShapeCode}, inner_compilation: ThompsonCompilation(inner_shape), lazy: Bool,
    {pattern: Pattern(ListC(inner_shape))},
    proof: PatternCompilationProof(ListC(inner_shape), pattern, ThompsonRepeat(inner_compilation, lazy)),
    input: List(Char), after_input: List(Char), position: InitialPosition,
    input_evidence: List(Evidence), input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(thompson_state_count(inner_compilation), repeat_pattern_machine(thompson_state_count(inner_compilation), thompson_machine(inner_compilation), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(ListC(inner_shape), pattern, position, input, after_input) = match proof
    CompilesRepeat(inner, _, inner_proof) -> repeat_false_denotation_is_default(inner, position, input, after_input, compilation_repeat_mode_acceptance_path_is_sound(inner, inner_compilation, inner_proof, False(), input, after_input, position, input_evidence, input_captures, final_evidence, acceptance))
    CompilesRepeatMode(inner, _, inner_proof, _) -> compilation_repeat_mode_acceptance_path_is_sound(inner, inner_compilation, inner_proof, lazy, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn run_predicate_soundness(test: Char -> Bool, {pattern: Pattern(CharC)}, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), request: CompilationSoundnessRequest(CharC, pattern, ThompsonPredicate(test), input, after_input, position, input_evidence, input_captures)) -> PatternDenotation(CharC, pattern, position, input, after_input) = match request
    CompilationSoundnessRequested(proof, final_evidence, acceptance) -> predicate_compilation_is_sound(test, proof, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn run_empty_soundness({pattern: Pattern(UnitC)}, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), request: CompilationSoundnessRequest(UnitC, pattern, ThompsonEmpty(), input, after_input, position, input_evidence, input_captures)) -> PatternDenotation(UnitC, pattern, position, input, after_input) = match request
    CompilationSoundnessRequested(proof, final_evidence, acceptance) -> empty_compilation_is_sound(proof, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn run_boundary_soundness(constraint: BoundaryConstraint, {pattern: Pattern(UnitC)}, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), request: CompilationSoundnessRequest(UnitC, pattern, ThompsonBoundary(constraint), input, after_input, position, input_evidence, input_captures)) -> PatternDenotation(UnitC, pattern, position, input, after_input) = match request
    CompilationSoundnessRequested(proof, final_evidence, acceptance) -> boundary_compilation_is_sound(constraint, proof, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn run_concat_soundness({left_shape: ShapeCode}, left_compilation: ThompsonCompilation(left_shape), {right_shape: ShapeCode}, right_compilation: ThompsonCompilation(right_shape), {pattern: Pattern(PairC(left_shape, right_shape))}, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), request: CompilationSoundnessRequest(PairC(left_shape, right_shape), pattern, ThompsonConcat(left_compilation, right_compilation), input, after_input, position, input_evidence, input_captures)) -> PatternDenotation(PairC(left_shape, right_shape), pattern, position, input, after_input) = match request
    CompilationSoundnessRequested(proof, final_evidence, acceptance) -> concat_compilation_is_sound(left_compilation, right_compilation, proof, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn run_group_soundness({inner_shape: ShapeCode}, inner_compilation: ThompsonCompilation(inner_shape), {pattern: Pattern(StringC)}, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), request: CompilationSoundnessRequest(StringC, pattern, ThompsonGroup(inner_compilation), input, after_input, position, input_evidence, input_captures)) -> PatternDenotation(StringC, pattern, position, input, after_input) = match request
    CompilationSoundnessRequested(proof, final_evidence, acceptance) -> group_compilation_is_sound(inner_compilation, proof, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn run_alternate_soundness({left_shape: ShapeCode}, left_compilation: ThompsonCompilation(left_shape), {right_shape: ShapeCode}, right_compilation: ThompsonCompilation(right_shape), prefer_right: Bool, {pattern: Pattern(ChoiceC(left_shape, right_shape))}, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), request: CompilationSoundnessRequest(ChoiceC(left_shape, right_shape), pattern, ThompsonAlternate(left_compilation, right_compilation, prefer_right), input, after_input, position, input_evidence, input_captures)) -> PatternDenotation(ChoiceC(left_shape, right_shape), pattern, position, input, after_input) = match request
    CompilationSoundnessRequested(proof, final_evidence, acceptance) -> alternate_compilation_is_sound(left_compilation, right_compilation, prefer_right, proof, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn run_repeat_soundness({inner_shape: ShapeCode}, inner_compilation: ThompsonCompilation(inner_shape), lazy: Bool, {pattern: Pattern(ListC(inner_shape))}, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), request: CompilationSoundnessRequest(ListC(inner_shape), pattern, ThompsonRepeat(inner_compilation, lazy), input, after_input, position, input_evidence, input_captures)) -> PatternDenotation(ListC(inner_shape), pattern, position, input, after_input) = match request
    CompilationSoundnessRequested(proof, final_evidence, acceptance) -> repeat_compilation_is_sound(inner_compilation, lazy, proof, input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn compilation_sound_dispatch(
    {shape: ShapeCode},
    pattern: Pattern(shape),
    compilation: ThompsonCompilation(shape),
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame)
  ) -> CompilationSoundness(shape, pattern, compilation, input, after_input, position, input_evidence, input_captures) = match compilation
    ThompsonPredicate(test) -> CompilationSoundnessReady(fn(request) -> run_predicate_soundness(test, input, after_input, position, input_evidence, input_captures, request))
    ThompsonEmpty() -> CompilationSoundnessReady(fn(request) -> run_empty_soundness(input, after_input, position, input_evidence, input_captures, request))
    ThompsonBoundary(constraint) -> CompilationSoundnessReady(fn(request) -> run_boundary_soundness(constraint, input, after_input, position, input_evidence, input_captures, request))
    ThompsonConcat(left_compilation, right_compilation) -> CompilationSoundnessReady(fn(request) -> run_concat_soundness(left_compilation, right_compilation, input, after_input, position, input_evidence, input_captures, request))
    ThompsonGroup(inner_compilation) -> CompilationSoundnessReady(fn(request) -> run_group_soundness(inner_compilation, input, after_input, position, input_evidence, input_captures, request))
    ThompsonAlternate(left_compilation, right_compilation, prefer_right) -> CompilationSoundnessReady(fn(request) -> run_alternate_soundness(left_compilation, right_compilation, prefer_right, input, after_input, position, input_evidence, input_captures, request))
    ThompsonRepeat(inner_compilation, lazy) -> CompilationSoundnessReady(fn(request) -> run_repeat_soundness(inner_compilation, lazy, input, after_input, position, input_evidence, input_captures, request))

  fn compilation_acceptance_path_is_sound(
    {shape: ShapeCode},
    pattern: Pattern(shape),
    compilation: ThompsonCompilation(shape),
    compilation_proof: PatternCompilationProof(shape, pattern, compilation),
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(shape, pattern, position, input, after_input) = match compilation_sound_dispatch(pattern, compilation, input, after_input, position, input_evidence, input_captures)
    CompilationSoundnessReady(prove_soundness) ->
      let request: CompilationSoundnessRequest(shape, pattern, compilation, input, after_input, position, input_evidence, input_captures) = CompilationSoundnessRequested(compilation_proof, final_evidence, acceptance)
      prove_soundness(request)

  fn pattern_acceptance_path_is_sound(
    {shape: ShapeCode},
    pattern: Pattern(shape),
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    @erased final_evidence: List(Evidence),
    acceptance: AcceptancePathFrom(thompson_state_count(certify_thompson(pattern)), thompson_machine(certify_thompson(pattern)), position, input, after_input, input_evidence, input_captures, final_evidence)
  ) -> PatternDenotation(shape, pattern, position, input, after_input) =
    compilation_acceptance_path_is_sound(pattern, certify_thompson(pattern), certify_thompson_proof(pattern), input, after_input, position, input_evidence, input_captures, final_evidence, acceptance)

  fn predicate_repeat_acceptance_is_sound(
    test: Char -> Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    @erased final_evidence: List(Evidence),
    @erased routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(S(Z()), repeat_pattern_machine(S(Z()), predicate_pattern_machine(test), False()), position, input, after_input, final_evidence, routine)
  ) -> PatternDenotation(ListC(CharC), PatternRepeat(PatternPredicate(test)), position, input, after_input) =
    repeat_false_denotation_is_default(PatternPredicate(test), position, input, after_input, predicate_repeat_mode_acceptance_is_sound(test, False(), input, after_input, position, final_evidence, routine, acceptance))





  fn complete_repeat_mode_continuation_from(
    {@erased inner_shape: ShapeCode},
    inner: Pattern(inner_shape),
    lazy: Bool,
    position: InitialPosition,
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    child_completeness: PatternCompleteness(inner_shape, inner),
    denotation: PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, Cons(char, rest), after_input)
  ) -> RepeatContinuationFrom(thompson_state_count(certify_thompson(inner)), pattern_machine_starts(thompson_machine(certify_thompson(inner))), pattern_machine_next(thompson_machine(certify_thompson(inner))), lazy, position, Cons(char, rest), after_input, input_evidence, input_captures) =
    complete_repeat_mode_continuation_view_from(inner, lazy, position, char, rest, after_input, input_evidence, input_captures, child_completeness, exact_repeat_mode_more_view(inner, lazy, position, char, rest, after_input, denotation))

  fn complete_repeat_mode_continuation_view_from(
    {@erased inner_shape: ShapeCode},
    inner: Pattern(inner_shape),
    lazy: Bool,
    position: InitialPosition,
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    child_completeness: PatternCompleteness(inner_shape, inner),
    {denotation: PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, Cons(char, rest), after_input)},
    view: ExactRepeatModeMoreView(inner_shape, inner, lazy, position, Cons(char, rest), after_input, denotation)
  ) -> RepeatContinuationFrom(thompson_state_count(certify_thompson(inner)), pattern_machine_starts(thompson_machine(certify_thompson(inner))), pattern_machine_next(thompson_machine(certify_thompson(inner))), lazy, position, Cons(char, rest), after_input, input_evidence, input_captures) = match view
    ExactRepeatModeMoreItem(item_char, item_rest, remaining_input, partition, item_denotation, remaining_denotation) -> match child_completeness
      PatternCompletenessReady(complete_child) -> match complete_child(position, Cons(item_char, item_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, item_denotation)
        PatternAcceptedFrom(child_final_evidence, _, PatternAcceptanceCertified(child_acceptance, child_captures)) ->
          let compilation = certify_thompson(inner)
          let count = thompson_state_count(compilation)
          let machine = thompson_machine(compilation)
          let starts = pattern_machine_starts(machine)
          let next = pattern_machine_next(machine)
          let child_captures_exact = certified_acceptance_captures_proof(count, machine, position, Cons(item_char, item_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence, child_acceptance, child_captures)
          match transport_certified_acceptance_machine(machine, MkPatternMachine(starts, next), position, Cons(item_char, item_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence, record_capture_input(input_captures, Cons(item_char, item_rest)), pattern_machine_eta(machine), child_acceptance, child_captures_exact)
            CertifiedAcceptanceTransported(canonical_child_acceptance, canonical_child_captures) ->
              let canonical_final_captures = acceptance_path_final_captures(count, MkPatternMachine(starts, next), position, Cons(item_char, item_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence, canonical_child_acceptance)
              let whole_input = input_partition_equivalent(partition)
              match remaining_denotation
                DenotesRepeatModeEmpty(_, _) ->
                  let closed = repeat_closing_continuation_from_acceptance(count, starts, next, lazy, position, item_char, item_rest, after_input, input_evidence, input_captures, child_final_evidence, canonical_child_acceptance)
                  let combined = transport_repeat_continuation_input(count, starts, next, lazy, position, Cons(item_char, item_rest), append_characters(Cons(item_char, item_rest), Nil()), after_input, input_evidence, input_captures, append_characters_empty_right(Cons(item_char, item_rest)), closed)
                  transport_repeat_continuation_input(count, starts, next, lazy, position, append_characters(Cons(item_char, item_rest), Nil()), Cons(char, rest), after_input, input_evidence, input_captures, character_list_equivalent_symmetric(Cons(char, rest), append_characters(Cons(item_char, item_rest), Nil()), whole_input), combined)
                DenotesRepeatModeMore(_, _, next_item_input, next_remaining_input, next_nonempty, next_partition, next_item_denotation, next_remaining_denotation) -> match next_nonempty
                  CharactersPresent(next_char, next_rest) ->
                    let next_whole = input_partition_equivalent(next_partition)
                    match next_whole
                      reflexive() ->
                        let canonical_remaining = Cons(next_char, append_characters(next_rest, next_remaining_input))
                        let suffix_view = exact_repeat_mode_more_view(inner, lazy, advance_initial_position(position, Cons(item_char, item_rest)), next_char, append_characters(next_rest, next_remaining_input), after_input, remaining_denotation)
                        let suffix = complete_repeat_mode_continuation_view_from(inner, lazy, advance_initial_position(position, Cons(item_char, item_rest)), next_char, append_characters(next_rest, next_remaining_input), after_input, child_final_evidence, canonical_final_captures, child_completeness, suffix_view)
                        let combined = repeat_reentry_continuation_from_acceptance(count, starts, next, lazy, position, item_char, item_rest, canonical_remaining, after_input, input_evidence, input_captures, child_final_evidence, canonical_child_acceptance, suffix)
                        transport_repeat_continuation_input(count, starts, next, lazy, position, append_characters(Cons(item_char, item_rest), canonical_remaining), Cons(char, rest), after_input, input_evidence, input_captures, character_list_equivalent_symmetric(Cons(char, rest), append_characters(Cons(item_char, item_rest), canonical_remaining), whole_input), combined)

  fn complete_repeat_mode_more_from(
    {@erased inner_shape: ShapeCode},
    inner: Pattern(inner_shape),
    lazy: Bool,
    position: InitialPosition,
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    child_completeness: PatternCompleteness(inner_shape, inner),
    denotation: PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, Cons(char, rest), after_input)
  ) -> PatternAcceptanceFrom(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, Cons(char, rest), after_input, input_evidence, input_captures) =
    let compilation = certify_thompson(inner)
    let count = thompson_state_count(compilation)
    let machine = thompson_machine(compilation)
    let starts = pattern_machine_starts(machine)
    let next = pattern_machine_next(machine)
    let opened_evidence = Cons(BeginListEvidence(), input_evidence)
    let continuation = complete_repeat_mode_continuation_from(inner, lazy, position, char, rest, after_input, opened_evidence, input_captures, child_completeness, denotation)
    match complete_repeat_continuation(count, starts, next, lazy, position, Cons(char, rest), after_input, input_evidence, input_captures, continuation)
      RepeatContinuationAccepted(final_evidence, canonical_acceptance) ->
        let machine_equality = pattern_machine_equivalent_symmetric(machine, MkPatternMachine(starts, next), pattern_machine_eta(machine))
        let repeat_equality = repeat_pattern_machine_congruent(count, MkPatternMachine(starts, next), machine, lazy, machine_equality)
        let acceptance = transport_acceptance_machine(repeat_pattern_machine(count, MkPatternMachine(starts, next), lazy), repeat_pattern_machine(count, machine, lazy), position, Cons(char, rest), after_input, input_evidence, input_captures, final_evidence, repeat_equality, canonical_acceptance)
        match certify_thompson_evidence(inner)
          CertifiedThompson(_, inner_proof) ->
            let captures_exact = thompson_repeat_acceptance_captures(inner_shape, compilation, inner_proof, lazy, Cons(char, rest), after_input, position, input_evidence, input_captures, acceptance)
            PatternAcceptedFrom(final_evidence, acceptance_extended_routine(count, repeat_pattern_machine(count, machine, lazy), position, Cons(char, rest), after_input, input_evidence, input_captures, final_evidence, acceptance), PatternAcceptanceCertified(acceptance, AcceptanceCapturesExact(captures_exact)))






  fn run_predicate_completeness(test: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), denotation: PatternDenotation(CharC, PatternPredicate(test), position, input, after_input)) -> PatternAcceptanceFrom(CharC, PatternPredicate(test), position, input, after_input, input_evidence, input_captures) = match denotation
    DenotesPredicate(_, char, singleton, _) -> match singleton
      IsSingleCharacter(_, _, exact) -> match exact
        reflexive() -> predicate_denotation_is_complete_from(test, char, after_input, position, input_evidence, input_captures, denotation)


  fn run_boundary_completeness(constraint: BoundaryConstraint, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), denotation: PatternDenotation(UnitC, PatternBoundary(constraint), position, input, after_input)) -> PatternAcceptanceFrom(UnitC, PatternBoundary(constraint), position, input, after_input, input_evidence, input_captures) = match denotation
    DenotesBoundary(_) -> boundary_denotation_is_complete_from(constraint, after_input, position, input_evidence, input_captures, denotation)

  fn run_concat_completeness({left_shape: ShapeCode}, {right_shape: ShapeCode}, left: Pattern(left_shape), right: Pattern(right_shape), left_completeness: PatternCompleteness(left_shape, left), right_completeness: PatternCompleteness(right_shape, right), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), denotation: PatternDenotation(PairC(left_shape, right_shape), PatternConcat(left, right), position, input, after_input)) -> PatternAcceptanceFrom(PairC(left_shape, right_shape), PatternConcat(left, right), position, input, after_input, input_evidence, input_captures) = match denotation
    DenotesConcat(_, _, left_input, right_input, partition, left_denotation, right_denotation) -> match input_partition_equivalent(partition)
      reflexive() -> match left_completeness
        PatternCompletenessReady(complete_left) ->
          let left_completion = complete_left(position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, left_denotation)
          complete_concat_from(left, right, position, left_input, right_input, after_input, input_evidence, input_captures, left_completion, right_completeness, right_denotation)




  fn run_repeat_mode_completeness({inner_shape: ShapeCode}, inner: Pattern(inner_shape), lazy: Bool, inner_completeness: PatternCompleteness(inner_shape, inner), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), denotation: PatternDenotation(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, input, after_input)) -> PatternAcceptanceFrom(ListC(inner_shape), PatternRepeatMode(inner, lazy), position, input, after_input, input_evidence, input_captures) = match denotation
    DenotesRepeatModeEmpty(_, _) -> complete_repeat_mode_empty_from(inner, lazy, after_input, position, input_evidence, input_captures)
    DenotesRepeatModeMore(_, _, item_input, remaining_input, nonempty, partition, _, _) -> match nonempty
      CharactersPresent(char, item_rest) -> match input_partition_equivalent(partition)
        reflexive() -> complete_repeat_mode_more_from(inner, lazy, position, char, append_characters(item_rest, remaining_input), after_input, input_evidence, input_captures, inner_completeness, denotation)


  fn run_repeat_completeness({inner_shape: ShapeCode}, inner: Pattern(inner_shape), inner_completeness: PatternCompleteness(inner_shape, inner), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), denotation: PatternDenotation(ListC(inner_shape), PatternRepeat(inner), position, input, after_input)) -> PatternAcceptanceFrom(ListC(inner_shape), PatternRepeat(inner), position, input, after_input, input_evidence, input_captures) =
    let mode_denotation = repeat_default_denotation_is_false_mode(inner, position, input, after_input, denotation)
    repeat_false_acceptance_is_default(inner, position, input, after_input, input_evidence, input_captures, run_repeat_mode_completeness(inner, False(), inner_completeness, position, input, after_input, input_evidence, input_captures, mode_denotation))

  fn pattern_completeness({shape: ShapeCode}, pattern: Pattern(shape)) -> PatternCompleteness(shape, pattern) = match pattern
    PatternPredicate(test) -> PatternCompletenessReady(run_predicate_completeness(test))
    PatternEmpty() -> PatternCompletenessReady(run_empty_completeness)
    PatternBoundary(constraint) -> PatternCompletenessReady(run_boundary_completeness(constraint))
    PatternConcat(left, right) ->
      let left_completeness = pattern_completeness(left)
      let right_completeness = pattern_completeness(right)
      PatternCompletenessReady(run_concat_completeness(left, right, left_completeness, right_completeness))
    PatternGroup(inner) ->
      let inner_completeness = pattern_completeness(inner)
      PatternCompletenessReady(run_group_completeness(inner, inner_completeness))
    PatternAlternate(left, right) ->
      let left_completeness = pattern_completeness(left)
      let right_completeness = pattern_completeness(right)
      PatternCompletenessReady(run_alternate_completeness(left, right, left_completeness, right_completeness))
    PatternAlternateMode(left, right, prefer_right) ->
      let left_completeness = pattern_completeness(left)
      let right_completeness = pattern_completeness(right)
      PatternCompletenessReady(run_alternate_mode_completeness(left, right, prefer_right, left_completeness, right_completeness))
    PatternRepeat(inner) ->
      let inner_completeness = pattern_completeness(inner)
      PatternCompletenessReady(run_repeat_completeness(inner, inner_completeness))
    PatternRepeatMode(inner, lazy) ->
      let inner_completeness = pattern_completeness(inner)
      PatternCompletenessReady(run_repeat_mode_completeness(inner, lazy, inner_completeness))


  fn predicate_pattern_denotation_is_complete(
    test: Char -> Bool,
    char: Char,
    after_input: List(Char),
    position: InitialPosition,
    denotation: PatternDenotation(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input)
  ) -> PatternAcceptance(CharC, PatternPredicate(test), position, Cons(char, Nil()), after_input) =
    match predicate_denotation_is_complete(test, char, after_input, position, denotation)
      PredicateAccepted(final_evidence, routine, acceptance) -> PatternAccepted(final_evidence, routine, acceptance)

















