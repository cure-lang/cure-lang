    FilteredRepeatReenteredOrigin(child_routine, child_constraints, child_edge, restart_state, start_routine, start_constraints, start_edge, holds) -> project_repeat_reentry_transition(n, starts, next, lazy, position, char, rest, after_input, source, current_evidence, current_captures, child_routine, child_constraints, child_edge, restart_state, start_routine, start_constraints, start_edge, holds, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, path)

  fn project_repeat_accepted_transition(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, position: InitialPosition, char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), edge: ListMember(MachineState(n), Accepted(regular, constraints), machine_destinations(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), ThreadActive(source), char, transition_boundary_before(char, rest, after_input))), execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures), {final_evidence: List(Evidence)}, suffix: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine), path: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine)), origin: FilteredRepeatDestinationsOrigin(n, next(source, char), starts, lazy, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints))) -> RepeatActivePathProjection(n, MkPatternMachine(starts, next), lazy, position, Cons(char, rest), after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), path)) = match origin
    FilteredRepeatAcceptingOrigin(child_routine, child_constraints, child_edge, holds) -> project_repeat_closing_transition(n, starts, next, lazy, position, char, rest, after_input, source, current_evidence, current_captures, child_routine, child_constraints, child_edge, holds, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, path)

  fn project_repeat_active_path(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), input, after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine)) -> RepeatActivePathProjection(n, MkPatternMachine(starts, next), lazy, position, input, after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), input, after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine, path)) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> project_repeat_active_transition(n, starts, next, lazy, position, char, rest, after_input, source, current_evidence, current_captures, destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, path, filtered_repeat_destinations_origin(n, next(source, char), starts, lazy, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge))
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> project_repeat_accepted_transition(n, starts, next, lazy, position, char, rest, after_input, source, current_evidence, current_captures, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, path, filtered_repeat_destinations_origin(n, next(source, char), starts, lazy, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge))

  @reducible
  fn accepting_now(n: Nat, machine: PatternMachine(n), after_input: List(Char), evidence: List(Evidence), captures: List(CaptureFrame)) -> AcceptingFrom(n, machine, empty_characters(), after_input, ThreadAccepted(), evidence, captures, evidence, empty_extended_routine()) = AcceptingNow()

  fn initial_edge_from_filtered_starts(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, proof_machine_starts(machine), initial_position_boundary(position, append_characters(input, after_input))))) -> ListMember(MachineState(n), value, initial_machine_destinations(n, machine, position, input, after_input)) = match machine
    MkPatternMachine(starts, next) -> edge

  fn prepend_active_accepting_from(n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), destination: Bounded(n), routine: List(EvidenceInstruction), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), edge: ListMember(MachineState(n), Active(destination, routine, empty_constraints()), machine_destinations(n, machine, ThreadActive(source), char, transition_boundary_before(char, rest, after_input))), execution: RoutineExecution(routine, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures), {final_evidence: List(Evidence)}, suffix: AcceptingFrom(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> AcceptingFrom(n, machine, Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, routine), suffix_routine)) =
    AcceptingNextActive(destination, routine, empty_constraints(), destination_evidence, destination_captures, suffix_routine, edge, execution, suffix)

  fn advanced_initial_edge_from_filtered_starts(n: Nat, machine: PatternMachine(n), position: InitialPosition, char: Char, rest: List(Char), after_input: List(Char), value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, proof_machine_starts(machine), transition_boundary_before(char, rest, after_input)))) -> ListMember(MachineState(n), value, initial_machine_destinations(n, machine, advance_initial_position(position, Cons(char, Nil())), rest, after_input)) = match advanced_position_boundary(position, char, rest, after_input)
    reflexive() -> initial_edge_from_filtered_starts(n, machine, advance_initial_position(position, Cons(char, Nil())), rest, after_input, value, edge)

  fn single_left_input_partition(char: Char, right: List(Char)) -> InputPartition(Cons(char, right), Cons(char, Nil()), right) = InputPartitionThere(char, InputPartitionHere(right))

  fn one_step_accepted_path(n: Nat, machine: PatternMachine(n), char: Char, after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), routine: List(EvidenceInstruction), final_evidence: List(Evidence), final_captures: List(CaptureFrame), edge: ListMember(MachineState(n), Accepted(routine, empty_boundary_constraints()), machine_destinations(n, machine, ThreadActive(source), char, transition_boundary_before(char, empty_characters(), after_input))), execution: RoutineExecution(routine, current_evidence, record_capture_char(current_captures, char), final_evidence, final_captures)) -> AcceptingFrom(n, machine, Cons(char, Nil()), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, routine), empty_extended_routine())) =
    AcceptingNextAccepted(routine, empty_boundary_constraints(), final_evidence, final_captures, empty_extended_routine(), edge, execution, accepting_now(n, machine, after_input, final_evidence, final_captures))
end
