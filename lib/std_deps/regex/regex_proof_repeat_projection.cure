  fn project_repeat_active_transition(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, position: InitialPosition, char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), destination: Bounded(n), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), edge: ListMember(MachineState(n), Active(destination, regular, constraints), machine_destinations(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), ThreadActive(source), char, transition_boundary_before(char, rest, after_input))), execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures), {final_evidence: List(Evidence)}, suffix: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine), path: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine)), origin: FilteredRepeatDestinationsOrigin(n, next(source, char), starts, lazy, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints))) -> RepeatActivePathProjection(n, MkPatternMachine(starts, next), lazy, position, Cons(char, rest), after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, appe