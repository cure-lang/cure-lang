    FilteredRepeatChildActiveOrigin(_, child_routine, child_constraints, child_edge, holds) ->
      let child_filtered_edge = filter_active_member(n, next(source, char), transition_boundary_before(char, rest, after_input), destination, child_routine, child_constraints, child_edge, holds)
