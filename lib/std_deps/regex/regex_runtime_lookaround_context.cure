  use Std.Sigma

  use Std.Decision

  fn no_characters() -> List(Char) = []

  ## `Boundary` stores whether the current cursor crosses a word boundary;
  ## `InitialPosition` stores whether the previous scalar itself was a word
  ## character.  They are different facts.  Reconstruct the latter from the
  ## previous scalar at this one boundary-to-child conversion site.
  fn lookahead_initial_position(boundary: Boundary) -> InitialPosition = match boundary
    Boundary(subject_start, _, _, line_start, _, _, _, previous_char, _, _) -> InitialPosition(subject_start, line_start, option_ascii_word(previous_char), option_unicode_word(previous_char), previous_char)

  fn lookbehind_window(history: List(Char), width: Nat) -> Option(List(Char)) = match history_has_width(history, width)
    false -> None()
    true -> Some(evidence_reverse_chars(history_take_limit(history, width)))

  fn history_at(history: List(Char), index: Nat) -> Option(Char) = match index
    Z() -> match history
      [] -> None()
      [head | _] -> Some(head)
    S(rest) -> match history
      [] -> None()
      [_ | tail] -> history_at(tail, rest)

  fn option_ascii_word(previous: Option(Char)) -> Bool = match previous
    None() -> false
    Some(char) -> ascii_word(char)

  fn option_unicode_word(previous: Option(Char)) -> Bool = match previous
    None() -> false
    Some(char) -> option_word(char, true)

  fn history_has_width(history: List(Char), width: Nat) -> Bool = match width
    Z() -> true
    S(rest) -> match history
      [] -> false
      [_ | tail] -> history_has_width(tail, rest)
end
