  ## Runtime-only search for named machines. The ordinary search above is
  ## indexed by the evidence theorem and intentionally has no capture-guard
  ## parameter. Named search carries only the replay routine, while preserving
  ## the same ordered destination traversal and boundary calculations.
  type NamedMachineSearch = NamedMachineNoPath | NamedMachinePath(List(ExtendedInstruction))

  fn named_search_machine_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> NamedMachineSearch = match machine
    MkPatternMachine(starts, _) -> named_search_initial_members(n, machine, position, input, after_input, named_filter_initial(starts, position, input, after_input))

  fn named_filter_initial({n: Nat}, starts: List(MachineState(n)), position: InitialPosition, input: List(Char), after_input: List(Char)) -> List(MachineState(n)) =
    filter_boundary_states_with_routine(starts, initial_position_boundary(position, append_characters(input, after_input)), [])

  fn named_search_initial_members(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), starts: List(MachineState(n))) -> NamedMachineSearch = match starts
    [] -> NamedMachineNoPath()
    [Active(state, routine, _) | rest] -> match named_search_accepting_from(n, machine, input, after_input, ThreadActive(state), regular_routine(routine))
      NamedMachineNoPath() -> named_search_initial_members(n, machine, position, input, after_input, rest)
      NamedMachinePath(path) -> NamedMachinePath(path)
    [Accepted(routine, _) | rest] -> match named_search_accepting_from(n, machine, input, after_input, ThreadAccepted(), regular_routine(routine))
      NamedMachineNoPath() -> named_search_initial_members(n, machine, position, input, after_input, rest)
      NamedMachinePath(path) -> NamedMachinePath(path)

  fn named_search_accepting_from(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_routine: List(ExtendedInstruction)) -> NamedMachineSearch = match input
    [] -> match state
      ThreadAccepted() -> NamedMachinePath(current_routine)
      ThreadActive(_) -> NamedMachineNoPath()
    [char | rest] -> named_search_accepting_members(n, machine, char, rest, after_input, current_routine, named_machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input), extended_regular_instructions(current_routine)))

  fn named_search_accepting_members(n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), current_routine: List(ExtendedInstruction), destinations: List(MachineState(n))) -> NamedMachineSearch = match destinations
    [] -> NamedMachineNoPath()
    [Active(state, routine, _) | remaining] -> match named_search_accepting_from(n, machine, rest, after_input, ThreadActive(state), append_extended_routines(current_routine, transition_routine(char, routine)))
      NamedMachineNoPath() -> named_search_accepting_members(n, machine, char, rest, after_input, current_routine, remaining)
      NamedMachinePath(path) -> NamedMachinePath(path)
    [Accepted(routine, _) | remaining] -> match named_search_accepting_from(n, machine, rest, after_input, ThreadAccepted(), append_extended_routines(current_routine, transition_routine(char, routine)))
      NamedMachineNoPath() -> named_search_accepting_members(n, machine, char, rest, after_input, current_routine, remaining)
      NamedMachinePath(path) -> NamedMachinePath(path)

  type NamedPrefixSearch = NamedNoPrefix | NamedPrefixPath(List(Char), List(Char), List(ExtendedInstruction))

  fn named_search_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> NamedPrefixSearch =
    named_search_first_prefix_loop(n, machine, position, [], input)

  fn named_search_first_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char)) -> NamedPrefixSearch =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match named_search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      NamedMachinePath(routine) -> NamedPrefixPath(matched_input, remaining_input, routine)
      NamedMachineNoPath() -> match remaining_input
        [] -> NamedNoPrefix()
        [char | rest] -> named_search_first_prefix_loop(n, machine, position, [char | reversed_prefix], rest)

  fn named_search_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> NamedPrefixSearch =
    named_search_last_prefix_loop(n, machine, position, [], input, NamedNoPrefix())

  fn named_search_last_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: NamedPrefixSearch) -> NamedPrefixSearch =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match named_search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      NamedMachinePath(routine) -> named_continue_last_prefix(n, machine, position, reversed_prefix, remaining_input, NamedPrefixPath(matched_input, remaining_input, routine))
      NamedMachineNoPath() -> named_continue_last_prefix(n, machine, position, reversed_prefix, remaining_input, previous)

  fn named_continue_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: NamedPrefixSearch) -> NamedPrefixSearch = match remaining_input
    [] -> previous
    [char | rest] -> named_search_last_prefix_loop(n, machine, position, [char | reversed_prefix], rest, previous)
end
