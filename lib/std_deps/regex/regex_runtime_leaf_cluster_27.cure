  @reducible
  fn lookaround_search_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n))) -> LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context) = match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, machine_state_members(starts), MachineStateCursorHere())
    LookaroundSearchMembersRejected(failure) -> LookaroundSearchResultRejected(failure)
    LookaroundSearchMembersFound(path) -> LookaroundSearchResultFound(path)

  ## The child failure stores the same destination list as both of its cursor
  ## indices.  Name that hidden list at one construction site so the recursive
  ## suffix proof can construct its canonical `Here` cursor without leaving an
  ## implicit index for the elaborator to guess.
  fn lookaround_path_failure_recurse_child(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_destinations: List(MachineState(n))},
    child_failure: LookaroundPathFailure(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, child_destinations, child_destinations),
    {@erased candidates: List(MachineState(n))},
    child_cursor_suffix: MachineStateCursorSuffix(n, child_destinations, candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty =
    lookaround_path_failure_excludes_accepting_suffix(n, machine, input, source, child_destinations, child_destinations, child_failure, candidates, child_cursor_suffix, path)

  fn lookaround_path_failure_active_rejected_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    @erased after_input: List(Char),
    @erased source: ThreadState(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    child_failure: LookaroundPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy)),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, Cons(child_char, child_rest)), after_input, source, history, policy)
  ) -> Empty = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
          reflexive() -> match child_destinations_equivalent
            reflexive() -> lookaround_path_failure_recurse_child(n, machine, Cons(child_char, child_rest), destination, child_failure, child_cursor_suffix, suffix)
    LookaroundAcceptedNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  ## Consume the complete cursor/suffix relation carried by a recursive path
  ## failure. A `Here` suffix means the candidate path must inspect the current
  ## destination head, so the corresponding child failure is recursed into. A
  ## `Drop` suffix means the path starts later in the list; the parent head is
  ## skipped and the tail failure is the induction step.
  ##
  ## The consuming path constructors carry an `Equivalent` proof for their
  ## candidate list. Matching its only constructor normalizes the candidate
  ## list to the same head/tail spine as the failure before descending. The
  ## opposite edge constructor is impossible when the failure head is indexed
  ## as `Active` or `Accepted`, and is discharged constructively.
  fn lookaround_path_failure_excludes_accepting_suffix(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    @erased destinations: List(MachineState(n)),
    @erased remaining_destinations: List(MachineState(n)),
    failure: LookaroundPathFailure(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, destinations, remaining_destinations),
    @erased candidates: List(MachineState(n)),
    candidate_suffix: MachineStateCursorSuffix(n, remaining_destinations, candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty = match input
    [] -> match failure
      LookaroundPathExhausted(_, source, _, _, _, remaining_equivalent) -> match remaining_equivalent
        reflexive() -> match candidate_suffix
          MachineStateCursorSuffixHere(equality) -> match equality
            reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, empty_characters(), ThreadActive(source), destinations, failure, path)
    [char | rest] -> match rest
      [] -> match failure
        LookaroundPathStepExhausted(_, _, _, _, _, _, _, remaining_equivalent) -> match remaining_equivalent
          reflexive() -> match candidate_suffix
            MachineStateCursorSuffixHere(equality) -> match equality
              reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, Cons(char, empty_characters()), ThreadActive(source), destinations, failure, path)
        LookaroundPathDestinationActiveRejectedEmpty(tail_destinations, _, destination, routine, constraints, _, _, _, _, _, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, empty_characters()), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_active_rejected_empty_here(n, machine, char, after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, destination, routine, constraints, candidates, equality, path)
        LookaroundPathDestinationAcceptedRejected(tail_destinations, _, _, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, empty_characters()), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_accepted_rejected_here(n, machine, char, empty_characters(), after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, routine, constraints, child_failure, candidates, equality, path)
      [child_char | child_rest] -> match failure
        LookaroundPathStepExhausted(_, _, _, _, _, _, _, remaining_equivalent) -> match remaining_equivalent
          reflexive() -> match candidate_suffix
            MachineStateCursorSuffixHere(equality) -> match equality
              reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, Cons(char, Cons(child_char, child_rest)), ThreadActive(source), destinations, failure, path)
        LookaroundPathDestinationActiveRejected(tail_destinations, _, _, _, destination, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_active_rejected_here(n, machine, char, child_char, child_rest, after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, destination, routine, constraints, child_failure, candidates, equality, path)
        LookaroundPathDestinationAcceptedRejected(tail_destinations, _, _, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_accepted_rejected_here(n, machine, char, Cons(child_char, child_rest), after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, routine, constraints, child_failure, candidates, equality, path)

  @reducible
  fn lookaround_prefix_search_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n))) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context) = match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, machine_state_members(starts), MachineStateCursorHere())
    LookaroundPrefixSearchMembersRejected(failure) -> LookaroundPrefixSearchResultRejected(failure)
    LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchResultFound(path)

  fn lookaround_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_first_prefix_loop(n, machine, position, [], input, history, policy)

  fn lookaround_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_last_prefix_loop(n, machine, position, [], input, None(), history, policy)

  ## A later selected start is carried through an active head of a non-empty
  ## rejected tail.  The parent rejection/evidence and the explicit empty-child
  ## certificate stay erased at this construction site; the root package is
  ## checked through its proof-only gate before the indexed active-head
  ## eliminator is invoked.
  @reducible
  fn atomic_start_rejected_member_there_nonempty_tail_active_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    @erased package: AtomicStartActiveRootTailProofPackage(
      depth,
      n,
      machine,
      position,
      capture_context,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      after_input,
      history,
      policy,
      prefix_mode,
      reversed_prefix,
      ThreadActive(state),
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      atomic_scope_depth_after(routine, Z())
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = let head_case: result = match package
      AtomicStartActiveRootTailProofPackagePacked(
        _,
        child_failure
      ) -> atomic_start_rejected_member_there_active_tail_head_excludes_trace(
        machine,
        position,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        state,
        routine,
        constraints,
        assertion_routine,
        assertion_markers,
        nested_decisions,
        membership,
        child_failure,
        empty_lookaround_admitted_cursor_suffix(n),
        failure,
        evidence,
        path,
        selected_path,
        tail_case
      )
    atomic_start_rejected_member_induction_selected_erased(
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      failure,
      evidence,
      membership,
      selected_path,
      head_case,
      tail_case
    )

  @reducible
  fn atomic_start_rejected_member_there_nonempty_tail_accepted_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartAcceptedRejectedTailPackage(
      depth,
      n,
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      whole,
      remaining,
      child_whole,
      child_current
    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = match package
    AtomicStartAcceptedRejectedTailPackagePacked(_, failure, child_failure, child_suffix, evidence) ->
      atomic_start_rejected_member_there_accepted_tail_head_excludes_trace(
        machine,
        position,
        child_char,
        child_rest,
        after_input,
        history,
        capture_context,
        policy,
        reversed_prefix,
        accepted_routine,
        accepted_constraints,
        accepted_assertion_routine,
        accepted_assertion_markers,
        accepted_nested_decisions,
        membership,
        failure,
        child_failure,
        child_suffix,
        evidence,
        path,
        selected_path,
        tail_case
      )

  ## Projected recursive commit authority for propagated Same branches. The
  ## child indices remain existential and independent of the selected child;
  ## the intact aligned carrier retains that right-hand authority separately.
  ## Later Empty-returning consumers may align the two, but this constructor
  ## never uses erased equality to manufacture a shared runtime package.
  type AtomicPathRecursiveCommitSelectedChildSameProjectedPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameProjectedPacked : {@erased rest: List(Char)} -> {@erased after_input: List(Char)} -> {@erased candidate: LookaroundAdmittedState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> (child_commit: AtomicPathCommitChildCursorExistentialPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)) -> (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameProjectedPackage(depth, n, machine)

  ## One relevant projection of the local child terminal classifier. This is
  ## the single authority shared by terminal contradiction folds and the
  ## nonterminal recursive continuation; no erased failure kind is reopened.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInputExhaustedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalExactAcceptedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalRootDestinationsExhaustedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalUnclassifiedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)

  ## A PastRejected tail advances the committed cursor once from an already
  ## aligned Same pair. The one-constructor package records that its only
  ## remaining common-induction branch is reverse and retains the complete
  ## exact-empty authority for the eventual contradiction.
  type AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePacked : (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(depth, n, machine)

  ## Proof-bearing local destination-rejection branches. Each runtime shape
  ## decision retains the exact skipped-empty authority that produced it, so
  ## the common induction receives construction-site evidence rather than a
  ## nullary obligation detached from the failed and selected child pair.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked : (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> (selected_child: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, LookaroundAdmittedStateCursorShapeHere())) -> (availability: AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(depth, n, machine)

  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePacked : {@erased failure_shape: LookaroundAdmittedStateCursorShape} -> {@erased selected_shape: LookaroundAdmittedStateCursorShape} -> (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> (selected_child: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, selected_shape)) -> (direction: AtomicPathActiveChildShapeThereAuthority(failure_shape, selected_shape)) -> (availability: AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(depth, n, machine)

  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePacked : {@erased failure_shape: LookaroundAdmittedStateCursorShape} -> {@erased selected_shape: LookaroundAdmittedStateCursorShape} -> (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> (selected_child: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, selected_shape)) -> (direction: AtomicPathCursorShapesLeftAfterAuthority(failure_shape, selected_shape)) -> (availability: AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(depth, n, machine)

  ## Consume the input-exhausted terminal classification without reopening
  ## erased failure evidence. All other aligned cases remain available to the
  ## recursive caller unchanged. The erased cursor equality is inspected only
  ## while eliminating an impossible branch to `Empty`.
  fn atomic_path_recursive_commit_selected_child_same_input_exhausted_fold(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    other_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, selected_suffix, _, inner_equivalence, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
        {child_prefix_kind = child_prefix_kind}, child_commit
      ) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          cause, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(after_child) -> match after_child
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
              terminal_classification, _, _, _, _
            ) -> match terminal_classification
              AtomicPathCommitAfterFailureInputExhaustedPacked() -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> match atomic_path_commit_after_input_exhausted_excludes_aligned_selected_package(
                    child_prefix_kind,
                    cause,
                    selected_suffix
                  )
              AtomicPathCommitAfterFailureExactAcceptedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureTerminalUnclassifiedPacked() ->
                other_case(package)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        other_case(package)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> other_case(package)
end
