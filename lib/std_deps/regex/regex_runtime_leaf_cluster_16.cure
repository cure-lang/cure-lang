  ## Publish the active root-tail package at the existing root-child
  ## construction boundary.  The wrapped package carries the child
  ## refutation, its empty cursor suffix, the recursive tail, and the scope
  ## alignment; this adapter only gives that authority its non-blocked name.
  fn atomic_start_active_root_tail_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {thread_state: ThreadState(n)},
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_scope_depth: Nat},
    @erased root: AtomicStartActiveRejectedTailPackage(
      depth,
      n,
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      thread_state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      child_scope_depth
    )
  ) -> AtomicStartActiveRootTailPackage(
    depth,
    n,
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    thread_state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    whole,
    remaining,
    child_scope_depth
  ) = AtomicStartActiveRootTailPackagePacked(root)

  ## Consume the active root-tail package at the exact empty-child boundary.
  ## The recursive continuation remains the relevant result; matching the
  ## package first ensures that only a root active-child exhaustion certificate
  ## can cross this bridge.
  @reducible
  fn atomic_start_active_root_failure_empty(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {thread_state: ThreadState(n)},
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_scope_depth: Nat},
    @erased package: AtomicStartActiveRootTailPackage(
      depth,
      n,
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      thread_state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      child_scope_depth
    ),
    tail_case: () -> result
  ) -> result = match package
    AtomicStartActiveRootTailPackagePacked(AtomicStartActiveRejectedTailPackagePacked(_, _, _, _)) -> tail_case()

  @reducible
  fn atomic_start_active_root_failure_empty_with_case(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {thread_state: ThreadState(n)},
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_scope_depth: Nat},
    @erased package: AtomicStartActiveRootTailPackage(
      depth,
      n,
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      thread_state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      child_scope_depth
    ),
    head_case: result
  ) -> result = match package
    AtomicStartActiveRootTailPackagePacked(AtomicStartActiveRejectedTailPackagePacked(_, _, _, _)) -> head_case

  ## One-step dispatcher for a blocked recursive tail. The ordinary tail
  ## package is consumed only through the typed blocked package above; this
  ## boundary feeds both admitted-state constructors through the selected
  ## blocked membership induction. A later selected sibling receives its
  ## inherited membership and trace in an erased package.
  fn atomic_start_rejected_member_there_nonempty_tail_blocked_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    head: LookaroundAdmittedState(n),
    {rest: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let blocked_package: AtomicStartBlockedTailPackage(
    depth,
    n,
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    Cons(head, rest)
  ) = atomic_start_blocked_tail_package(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    package,
    skip,
    allowed,
    failure,
    evidence
  )
    atomic_start_rejected_tail_dispatch_blocked(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      head,
      blocked_package,
      membership,
      path,
      tail_case
    )

  type AtomicPathCommitChildCursorExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char))
    AtomicPathCommitChildCursorExistentialPacked : (shape: LookaroundAdmittedStateCursorShape) -> (payload: AtomicPathCommitChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, shape)) -> AtomicPathCommitChildCursorExistentialPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)

  @reducible
  fn atomic_path_commit_whole_nonempty(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    kind: AtomicPathCommitCauseKind,
    @erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind),
    suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)
  ) -> LookaroundAdmittedNonempty(n, whole) = match atomic_path_commit_cause_nonempty(kind, cause)
    LookaroundAdmittedNonemptyPacked(head, tail, equality) -> match equality
      reflexive() -> lookaround_admitted_cursor_suffix_nonempty(suffix)

  ## Canonical cursor alignment once non-emptiness has been established from
  ## either the explicit cause kind or its relevant structure package.
  @reducible
  fn atomic_path_commit_selected_authority_alignment_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_origin: List(LookaroundAdmittedState(n))},
    {@erased selected_origin: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    commit_nonempty: LookaroundAdmittedNonempty(n, current),
    commit_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, commit_origin),
    commit_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, commit_origin),
    commit_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_tail_fold(
    atomic_path_active_child_alignment_from_canonical(
      atomic_path_commit_cursor_whole_nonempty(
        commit_nonempty,
        commit_suffix
      ),
      atomic_path_failed_selected_child_cursor_alignment(
        commit_origin_equivalence,
        commit_origin_canonical,
        commit_suffix,
        selected_origin_canonical,
        selected_suffix
      ),
      atomic_path_failed_selected_child_suffix(
        commit_origin_equivalence,
        commit_origin_canonical,
        selected_origin_canonical,
        selected_suffix
      )
    ),
    head_case,
    tail_case,
    reverse_case
  )

  ## Preserve the exact cursor equality in the aligned case. The coarser fold
  ## above is sufficient for branch routing, but constructor-local commit
  ## eliminators need the `Same` equality to rewrite the selected current to
  ## the commit current before consuming their indexed causes.
  @reducible
  fn atomic_path_commit_selected_cursor_location(
    {depth: Nat}, {n: Nat}, {machine: PatternMachine(n)},
    {input: List(Char)}, {after_input: List(Char)},
    {state: ThreadState(n)}, {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    whole: List(LookaroundAdmittedState(n)),
    {current: List(LookaroundAdmittedState(n))},
    {commit_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    commit_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, commit_origin),
    commit_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, commit_origin),
    commit_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current)
  ) -> AtomicPathCursorLocation(n, current, selected_current) = atomic_path_cursor_location(
    whole,
    commit_suffix,
    atomic_path_failed_selected_child_suffix(
      commit_origin_equivalence,
      commit_origin_canonical,
      selected_origin_canonical,
      selected_suffix
    )
  )

  ## Path-free correlation boundary for the two independently constructed
  ## recursive child cursors. The comparison is indexed by the same shapes as
  ## the retained payloads, so every dispatch branch carries authority about
  ## those payloads rather than an unrelated existential pair.
  type AtomicPathCommitSelectedChildCursorPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char))
    AtomicPathCommitSelectedChildCursorPacked : (left_shape: LookaroundAdmittedStateCursorShape) -> (right_shape: LookaroundAdmittedStateCursorShape) -> (commit_payload: AtomicPathCommitChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, left_shape)) -> (selected_payload: AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, right_shape)) -> (comparison: AtomicPathCursorShapeComparison(left_shape, right_shape)) -> AtomicPathCommitSelectedChildCursorPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input)

  fn atomic_path_skipped_prefix_cursor_shaped_existential_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> AtomicPathSkippedPrefixCursorExistentialPackage(
    depth, n, machine
  ) = match atomic_path_skipped_prefix_cursor_shaped_package(structure)
    mk_pair(shape, payload) ->
      AtomicPathSkippedPrefixCursorExistentialPacked(
        shape,
        AtomicPathSkippedPrefixCursorShapedExistentialPacked(payload)
      )

  ## Runtime dispatch narrows the recursive child carrier before any erased
  ## cursor authority is opened.  Consumers of this package therefore have a
  ## single fixed control branch and cannot accidentally use proof refinement
  ## to choose among relevant continuations.
  type AtomicPathRecursiveCommitSelectedChildSameExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameExistentialPacked : {@erased rest: List(Char)} -> {@erased after_input: List(Char)} -> {@erased candidate: LookaroundAdmittedState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> {@erased matched: List(Char)} -> {@erased remaining_input: List(Char)} -> (left_shape: LookaroundAdmittedStateCursorShape) -> (right_shape: LookaroundAdmittedStateCursorShape) -> (commit_payload: AtomicPathCommitChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, left_shape)) -> (selected_payload: AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, right_shape)) -> (same_authority: AtomicPathCursorShapesSameAuthority(left_shape, right_shape)) -> AtomicPathRecursiveCommitSelectedChildSameExistentialPackage(depth, n, machine)

  ## Combine an extracted recursive commit tail with the corresponding
  ## selected skipped-prefix tail. Matching the commit package exposes the
  ## cursor already correlated with its exact structure; the selected
  ## structure independently determines Same versus RightAfter.
  @reducible
  fn atomic_path_commit_selected_tail_location_package(
    {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased commit_current: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased commit_kind: AtomicPathCommitCauseKind},
    {@erased skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, commit_depth, commit_kind
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, skipped_kind
    )
  ) -> AtomicPathCommitSelectedLocationPackage(
    n,
    AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, commit_depth, commit_kind
    ),
    LookaroundAdmittedStateCursorSuffixPackage(n, whole, commit_current),
    selected_trace_package,
    AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, skipped_kind
    ),
    commit_current,
    selected_current
  ) = match commit
    AtomicPathCommitStructureCursorExistentialPacked(_, cursor, _) ->
      atomic_path_commit_selected_location_package(
        commit,
        cursor,
        selected_trace,
        selected_skipped,
        atomic_path_skipped_prefix_structure_location(selected_skipped)
      )
end
