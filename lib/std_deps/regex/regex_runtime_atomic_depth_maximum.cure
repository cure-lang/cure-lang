  @reducible
  fn atomic_depth_max(left: Nat, right: Nat) -> Nat = match left
    Z() -> right
    S(left_rest) -> match right
      Z() -> S(left_rest)
      S(right_rest) -> S(atomic_depth_max(left_rest, right_rest))

  @reducible
  fn atomic_scope_max_depth(routine: List(EvidenceInstruction), depth: Nat) -> Nat =
    atomic_scope_max_depth_with(routine, depth, depth)

  @reducible
  fn atomic_scope_max_depth_with(routine: List(EvidenceInstruction), depth: Nat, maximum: Nat) -> Nat = match routine
    [] -> maximum
    [BeginAtomic() | rest] -> atomic_scope_max_depth_with(rest, S(depth), atomic_depth_max(maximum, S(depth)))
    [EndAtomic() | rest] -> match depth
      Z() -> atomic_scope_max_depth_with(rest, depth, maximum)
      S(previous) -> atomic_scope_max_depth_with(rest, previous, maximum)
    [_ | rest] -> atomic_scope_max_depth_with(rest, depth, maximum)
end
