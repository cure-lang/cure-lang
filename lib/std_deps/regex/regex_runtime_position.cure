@group(:text)
mod Std.Regex.Runtime.Position
  use Std.Regex.Runtime.StateOps
  use Std.Regex.Runtime.PatternMachines
  use Std.Regex.Runtime.StagedOps
  use Std.Regex.Runtime.Compilation
  use Std.Regex.Runtime.MachineLaws
  use Std.Regex.Runtime.MachineFilters
  use Std.Regex.Runtime.SubjectContext
  use Std.Regex.Runtime.CharacterPredicates
















  use Std.Regex.Runtime.TransitionRows

  use Std.Regex.Runtime.CaptureConditions

  use Std.Regex.Runtime.Boundaries

  use Std.Regex.Runtime.AtomicDiagnostics

  use Std.Regex.Runtime.ClassKinds

  use Std.Regex.Runtime.Named

  use Std.Regex.Runtime.Split

  use Std.Regex.Core.Capture

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Char

  use Std.Option

  use Std.List

  use Std.String

  use Std.Syntax

  use Std.Bounded

  use Std.Equivalent

  use Std.Sigma

  use Std.Decision

  fn next_ascii_word(input: List(Char)) -> Bool = match input
    [] -> false
    [char | _] -> ascii_word(char)

  fn next_unicode_word(input: List(Char)) -> Bool = match input
    [] -> false
    [char | _] -> option_word(char, true)

  fn position_boundary(subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool, previous_char: Option(Char), input: List(Char)) -> Boundary =
    Boundary(
      subject_start,
      position_subject_end(input),
      position_strict_subject_end(input),
      line_start,
      position_line_end(input),
      previous_ascii_word != next_ascii_word(input),
      previous_unicode_word != next_unicode_word(input),
      previous_char,
      option_head(input),
      option_second(input)
    )

  fn transition_boundary(char: Char, rest: List(Char)) -> Boundary =
    position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), Some(char), rest)

  @reducible
  fn append_characters(left: List(Char), right: List(Char)) -> List(Char) = match left
    [] -> right
    [head | rest] -> [head | append_characters(rest, right)]

  @reducible
  fn transition_boundary_before(char: Char, rest: List(Char), after_input: List(Char)) -> Boundary =
    transition_boundary(char, append_characters(rest, after_input))

  @reducible
  fn advance_initial_position(position: InitialPosition, input: List(Char)) -> InitialPosition = match input
    Nil() -> position
    Cons(char, rest) -> advance_initial_position(position_after_character(char), rest)

  @reducible
  fn position_after_character(char: Char) -> InitialPosition =
    InitialPosition(False(), Std.Char.is_newline(char), ascii_word(char), option_word(char, True()), Some(char))

  @reducible
  fn position_after_character_with_policy(char: Char, policy: NewlinePolicy) -> InitialPosition =
    InitialPosition(False(), newline_char(policy, char), ascii_word(char), option_word(char, True()), Some(char))

  @reducible
  fn advance_initial_position_with_policy(position: InitialPosition, input: List(Char), policy: NewlinePolicy) -> InitialPosition = match input
    Nil() -> position
    Cons(char, rest) -> advance_initial_position_with_policy(position_after_character_with_policy(char, policy), rest, policy)

  fn initial_position_boundary(position: InitialPosition, input: List(Char)) -> Boundary = match position
    InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, previous_char) ->
      position_boundary(subject_start, line_start, previous_ascii_word, previous_unicode_word, previous_char, input)

  fn subject_initial_position() -> InitialPosition = InitialPosition(true, true, false, false, None())
end
