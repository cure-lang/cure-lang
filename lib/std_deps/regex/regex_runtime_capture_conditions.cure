@group(:text)
mod Std.Regex.Runtime.CaptureConditions
  use Std.Regex.Runtime.Boundaries

  use Std.Regex.Runtime.AtomicDiagnostics

  use Std.Regex.Runtime.ClassKinds

  use Std.Regex.Runtime.Named

  use Std.Regex.Runtime.Split

  use Std.Regex.Core.Capture

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Char

  use Std.Option

  use Std.List

  use Std.String

  use Std.Syntax

  use Std.Bounded

  use Std.Equivalent

  use Std.Sigma

  use Std.Decision

  fn capture_condition_holds(condition: Option(CaptureCondition), routine: List(EvidenceInstruction)) -> Bool = match condition
      None() -> true
      Some(CaptureParticipated(slot)) -> match capture_participation_decision(slot, routine)
        CaptureParticipatedByRoutine() -> true
        CaptureAbsentByRoutine() -> false
      Some(CaptureAbsent(slot)) -> match capture_participation_decision(slot, routine)
        CaptureParticipatedByRoutine() -> false
        CaptureAbsentByRoutine() -> true

  ## The conditional guard consumes an indexed decision produced from the
    ## destination epsilon routine. This is the finite participation fact used
    ## by named conditionals; it is deliberately separate from capture text and
    ## cannot be manufactured by replaying an unrelated slot.
    type CaptureParticipationDecision indices (slot: Nat, routine: List(EvidenceInstruction))
      CaptureParticipatedByRoutine : CaptureParticipationDecision(slot, routine)
      CaptureAbsentByRoutine : CaptureParticipationDecision(slot, routine)

  fn capture_participation_decision(slot: Nat, routine: List(EvidenceInstruction)) -> CaptureParticipationDecision(slot, routine) = match routine
      [] -> CaptureAbsentByRoutine()
      [EndCaptureSlot(closed_slot) | rest] -> pickup
        same_capture_slot(slot, closed_slot) -> CaptureParticipatedByRoutine()
        else -> match capture_participation_decision(slot, rest)
          CaptureParticipatedByRoutine() -> CaptureParticipatedByRoutine()
          CaptureAbsentByRoutine() -> CaptureAbsentByRoutine()
      [_ | rest] -> match capture_participation_decision(slot, rest)
        CaptureParticipatedByRoutine() -> CaptureParticipatedByRoutine()
        CaptureAbsentByRoutine() -> CaptureAbsentByRoutine()

  @reducible
    fn same_capture_slot(left: Nat, right: Nat) -> Bool = match left
      Z() -> match right
        Z() -> true
        S(_) -> false
      S(left_rest) -> match right
        Z() -> false
        S(right_rest) -> same_capture_slot(left_rest, right_rest)
end
