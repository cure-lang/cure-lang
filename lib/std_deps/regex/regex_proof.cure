    Nil() -> impossible_empty_active_path(n, MkPatternMachine(starts, next), after_input, source, current_evidence, current_captures, child_final_evidence, child_routine, child_path)
    Cons(input_char, input_rest) -> match exact_repeat_child_active_path_view(n, starts, next, input, after_input, source, current_evidence, current_captures, child_final_evidence, child_routine, child_path)
