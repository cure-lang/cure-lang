  fn lift_alternate_left_initial_active_member(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), state: Bounded(left_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Active(state, routine, Nil()), initial_machine_destinations(left_count, left_machine, position, input, after_input))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), initial_machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), position, input, after_input)) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        let boundary = initial_position_boundary(position, append_characters(input, after_input))
        let marked_edge = lift_filtered_left_active_member(left_count, right_count, left_starts, EmitLeft(), boundary, state, routine, edge)
        match prefer_right
          False() ->
            let appended = lift_filtered_append_left_member(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), alternate_right_states(left_count, right_count, right_starts, EmitRight()), boundary, Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), marked_edge)
            transport_alternate_edge(filtered_alternate_starts_left_order(left_count, left_starts, right_count, right_starts, boundary), appended)
          True() ->
            let appended = lift_filtered_append_right_member(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_starts, EmitRight()), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), boundary, Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), marked_edge)
