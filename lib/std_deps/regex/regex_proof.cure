  fn thompson_repeat_acceptance_from_encodes(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(inner), repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(ListC(inner_shape), final_evidence, input_evidence) = match project_repeat_acceptance_from_machine(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, input_evidence, input_captures, acceptance)
      ProjectedRepeatEmptyAcceptance(input_empty, projected_final_evidence, evidence_exact, combined_final_captures, captures_exact) -> match evidence_exact
        reflexive() ->
          let empty_encoding = encodes_many_empty(inner_shape, input_evidence)
          EncodesList(empty_encoding)
      ProjectedRepeatItemsAcceptance(state, routine, list_evidence, list_captures, initial_evidence, initial_captures, initial_edge, initial_execution, projection, list_evidence_exact, list_captures_exact) -> match list_evidence_exact
        reflexive() -> match list_captures_exact
          reflexive() -> thompson_repeat_projection_encodes_many(inner_shape, inner, inner_proof, lazy, position, input, after_input, Cons(BeginListEvidence(), input_evidence), input_captures, state, routine, initial_evidence, initial_captures, initial_edge, initial_execution, input_evidence, encodes_many_empty(inner_shape, input_evidence), final_evidence, projection)





  fn thompson_evidence_acceptance_from_encodes_explicit(@erased shape: ShapeCode, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(shape, final_evidence, input_evidence) = match proof
    ThompsonEvidenceEmpty() -> empty_acceptance_path_from_encodes(input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceBoundary(constraint) -> boundary_acceptance_path_from_encodes(constraint, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidencePredicate(test) -> predicate_acceptance_path_from_encodes(test, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceConcat({left_shape = left_shape}, {right_shape = right_shape}, left, right, left_proof, right_proof) -> match execute_concat_acceptance_projection(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, project_concat_acceptance_from(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, acceptance))
      ProjectedExecutedConcatAcceptance(left_input, right_input, partition, left_final_evidence, left_final_captures, left_acceptance, _, right_final_evidence, right_final_captures, right_acceptance, right_execution, _, final_is_paired) -> match final_is_paired
        reflexive() -> EncodesPair(
          thompson_evidence_acceptance_from_encodes_explicit(right_shape, right, right_proof, right_input, after_input, advance_initial_position(position, left_input), left_final_evidence, left_final_captures, right_acceptance),
          thompson_evidence_acceptance_from_encodes_explicit(left_shape, left, left_proof, left_input, append_characters(right_input, after_input), position, input_evidence, input_captures, left_acceptance)
        )
    ThompsonEvidenceGroup({inner_shape = inner_shape}, inner, inner_proof) -> match project_group_acceptance_from(thompson_state_count(inner), pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner)), position, input, after_input, input_evidence, input_captures, acceptance)
      ProjectedGroupAcceptanceMissingFrame(child_final_evidence, projected_child, combined_final_captures, captures_exact, _, _) -> impossible_missing_group_capture(
          input_evidence,
          input_captures,
          input,
          group_child_supplied_captures(inner, inner_proof, position, input, after_input, input_evidence, Cons(CaptureFrame(empty_characters(), input_evidence), input_captures), child_final_evidence, empty_captures(), projected_child)
      )
      ProjectedGroupAcceptanceClosedFrame(child_final_evidence, chars, saved, outer, projected_child, combined_final_captures, captures_exact, _, projected_evidence_exact) -> match projected_evidence_exact
        reflexive() -> match recorded_open_capture_view(
            empty_characters(),
            input_evidence,
            input_captures,
            input,
            Cons(CaptureFrame(chars, saved), outer),
            group_child_supplied_captures(inner, inner_proof, position, input, after_input, input_evidence, Cons(CaptureFrame(empty_characters(), input_evidence), input_captures), child_final_evidence, Cons(CaptureFrame(chars, saved), outer), projected_child)
        )
          RecordedOpenCaptureExact() -> EncodesString(captured_string(evidence_reverse_chars_into(input, Nil())))
    ThompsonEvidenceAlternate({left_shape = left_shape}, {right_shape = right_shape}, left, right, prefer_right, left_proof, right_proof) -> match project_alternate_acceptance_from(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right, position, input, after_input, input_evidence, input_captures, acceptance)
      mk_pair(False(), ProjectedAlternateFromLeft(left_projection)) -> match execute_alternate_left_acceptance_projection(thompson_state_count(left), thompson_machine(left), position, input, after_input, input_evidence, input_captures, left_projection)
        ProjectedAlternateLeftExecutedAcceptance(child_final_evidence, child_final_captures, child_acceptance, child_execution, final_is_left) -> match final_is_left
          reflexive() -> EncodesLeft(thompson_evidence_acceptance_from_encodes_explicit(left_shape, left, left_proof, input, after_input, position, input_evidence, input_captures, child_acceptance))
      mk_pair(True(), ProjectedAlternateFromRight(right_projection)) -> match execute_alternate_right_acceptance_projection(thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, right_projection)
        ProjectedAlternateRightExecutedAcceptance(child_final_evidence, child_final_captures, child_acceptance, child_execution, final_is_right) -> match final_is_right
          reflexive() -> EncodesRight(thompson_evidence_acceptance_from_encodes_explicit(right_shape, right, right_proof, input, after_input, position, input_evidence, input_captures, child_acceptance))
    ThompsonEvidenceRepeat({inner_shape = inner_shape}, inner, lazy, inner_proof) -> thompson_repeat_acceptance_from_encodes(inner_shape, inner, inner_proof, lazy, input, after_input, position, input_evidence, input_captures, acceptance)

  fn thompson_evidence_acceptance_from_encodes({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(shape, final_evidence, input_evidence) = thompson_evidence_acceptance_from_encodes_explicit(shape, compilation, proof, input, after_input, position, input_evidence, input_captures, acceptance)

  fn thompson_evidence_acceptance_encodes({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, {final_evidence: List(Evidence)}, acceptance: AcceptancePath(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, final_evidence)) -> Encodes(shape, final_evidence, empty_evidence()) = thompson_evidence_acceptance_from_encodes(compilation, proof, input, after_input, position, empty_evidence(), empty_captures(), acceptance)

  fn thompson_machine_acceptance_encodes_explicit(@erased shape: ShapeCode, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, acceptance: MachineAcceptance(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, final_evidence, routine)) -> Encodes(shape, final_evidence, empty_evidence()) = thompson_evidence_acceptance_encodes(compilation, proof, input, after_input, position, machine_acceptance_path(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, acceptance))

  fn thompson_machine_acceptance_encodes({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, acceptance: MachineAcceptance(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, final_evidence, routine)) -> Encodes(shape, final_evidence, empty_evidence()) = thompson_machine_acceptance_encodes_explicit(shape, compilation, proof, input, after_input, position, acceptance)




  fn certified_alternate_acceptance_captures(
    {left_shape: ShapeCode},
    {right_shape: ShapeCode},
    left: Pattern(left_shape),
    right: Pattern(right_shape),
    prefer_right: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    {final_evidence: List(Evidence)},
    acceptance: AcceptancePathFrom(
      plus(thompson_state_count(certify_thompson(left)), thompson_state_count(certify_thompson(right))),
      alternate_pattern_machine(thompson_state_count(certify_thompson(left)), thompson_machine(certify_thompson(left)), thompson_state_count(certify_thompson(right)), thompson_machine(certify_thompson(right)), prefer_right),
      position,
      input,
      after_input,
      input_evidence,
      input_captures,
      final_evidence
    )
  ) -> Equivalent(
    List(CaptureFrame),
    acceptance_path_final_captures(
      plus(thompson_state_count(certify_thompson(left)), thompson_state_count(certify_thompson(right))),
      alternate_pattern_machine(thompson_state_count(certify_thompson(left)), thompson_machine(certify_thompson(left)), thompson_state_count(certify_thompson(right)), thompson_machine(certify_thompson(right)), prefer_right),
      position,
      input,
      after_input,
      input_evidence,
      input_captures,
      final_evidence,
      acceptance
    ),
    record_capture_input(input_captures, input)
  ) = match certify_thompson_evidence(left)
    CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
      CertifiedThompson(right_compilation, right_proof) -> thompson_alternate_acceptance_captures(left_compilation, right_compilation, prefer_right, left_proof, right_proof, input, after_input, position, input_evidence, input_captures, acceptance)

  fn parse_pattern_full_verified({shape: ShapeCode}, pattern: Pattern(shape), input: String) -> Option(Sem(shape)) = match certify_thompson_evidence(pattern)
    CertifiedThompson(compilation, proof) ->
      let characters = Std.String.characters(input)
      match search_machine_acceptance(thompson_state_count(compilation), thompson_machine(compilation), subject_initial_position(), characters, empty_characters())
        MachineNoAcceptingPath() -> None()
        MachineAcceptingPath(evidence, _, acceptance) -> Some(extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, characters, empty_characters(), subject_initial_position(), acceptance)))

  fn parse_program_full_verified({result: Type}, program: RegexProgram(result), input: String) -> Option(result) = match program
    BuiltRegex(_shape, pattern, conversion, hint) -> match hint
      NoCompilationHint() -> match parse_pattern_full_verified(pattern, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))
      StagedCompilationHint(StagedMachineValue(compilation)) -> match parse_compilation_full_verified(compilation, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))
      StagedCompilationHint(StagedAtomicPatternValue(plan)) -> match parse_atomic_plan_full_verified(plan, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))
      StagedCompilationHint(StagedLookaroundValue(pattern, compilation, policy)) -> match parse_lookaround_compilation_full_verified(pattern, compilation, policy, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))

  fn parse_compilation_full_verified({shape: ShapeCode}, compilation: ThompsonCompilation(shape), input: String) -> Option(Sem(shape)) =
    let proof = proof_for_compilation(compilation)
    let characters = Std.String.characters(input)
    match search_machine_acceptance(thompson_state_count(compilation), thompson_machine(compilation), subject_initial_position(), characters, empty_characters())
      MachineNoAcceptingPath() -> None()
      MachineAcceptingPath(evidence, _, acceptance) -> Some(extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, characters, empty_characters(), subject_initial_position(), acceptance)))

  fn parse_atomic_plan_full_verified({shape: ShapeCode}, plan: AtomicRuntimePattern(shape), input: String) -> Option(Sem(shape)) =
    let machine = atomic_runtime_machine_from_plan(plan)
    let characters = Std.String.characters(input)
    pickup
      atomic_runtime_accepts(thompson_state_count(atomic_plan_compilation(plan)), machine, subject_initial_position(), characters, empty_characters()) -> parse_pattern_full_verified(atomic_plan_pattern(plan), input)
      else -> None()

  fn parse_atomic_plan_prefix_verified_at({shape: ShapeCode}, plan: AtomicRuntimePattern(shape), input: List(Char), greedy: Bool, position: InitialPosition) -> Option(Tuple(Sem(shape), List(Char))) =
    let machine = atomic_runtime_machine_from_plan(plan)
    match atomic_runtime_prefix(thompson_state_count(atomic_plan_compilation(plan)), machine, position, input, greedy)
      None() -> None()
      Some(%[matched, remaining]) -> match parse_pattern_full_verified(atomic_plan_pattern(plan), Std.String.from_characters(matched))
        None() -> None()
        Some(value) -> Some(%[value, remaining])

  ## The assertion gate consumes an erased indexed path, not a free Boolean.
  ## Its constructors name every filtered transition and the exact recursive
  ## suffix, so ordinary extraction is reachable only after a checked path
  ## through the depth-bounded assertion machine exists.
  fn parse_lookaround_compilation_full_verified({shape: ShapeCode}, pattern: Pattern(shape), compilation: LookaroundCompilation(shape), policy: NewlinePolicy, input: String) -> Option(Sem(shape)) =
    let characters = Std.String.characters(input)
    match atomic_lookaround_routine_initial(regex_assertion_depth_limit(), lookaround_state_count(compilation), lookaround_machine(compilation), characters, [], subject_initial_position(), [], [], policy, false, [])
      LookaroundRoutineSearchYes(_, [], _, _, _) -> parse_pattern_full_verified(pattern, input)
      LookaroundRoutineSearchYes(_, _, _, _, _) -> None()
      LookaroundRoutineSearchNo(_) -> None()
      LookaroundRoutineSearchCommit(_) -> None()

  fn parse_lookaround_compilation_prefix_verified_at({shape: ShapeCode}, pattern: Pattern(shape), compilation: LookaroundCompilation(shape), policy: NewlinePolicy, input: List(Char), greedy: Bool, position: InitialPosition, history: List(Char)) -> Option(Tuple(Sem(shape), List(Char))) =
    match atomic_lookaround_routine_prefix(regex_assertion_depth_limit(), lookaround_state_count(compilation), lookaround_machine(compilation), position, input, greedy, history, [], policy)
      None() -> None()
      Some(%[matched, remaining, _routine]) -> match parse_pattern_full_verified(pattern, Std.String.from_characters(matched))
        None() -> None()
        Some(value) -> Some(%[value, remaining])

  fn parse_pattern_prefix_verified_at({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char), greedy: Bool, position: InitialPosition) -> Option(Tuple(Sem(shape), List(Char))) = match certify_thompson_evidence(pattern)
    CertifiedThompson(compilation, proof) ->
      let result = pickup
        greedy -> search_last_machine_prefix(thompson_state_count(compilation), thompson_machine(compilation), position, input)
        else -> search_first_machine_prefix(thompson_state_count(compilation), thompson_machine(compilation), position, input)
      match result
        NoCertifiedPrefix() -> None()
        CertifiedPrefixPath(matched, remaining, evidence, _, acceptance) -> Some(%[extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, matched, remaining, position, acceptance)), remaining])

  fn parse_program_prefix_chars_verified_at({result: Type}, program: RegexProgram(result), input: List(Char), greedy: Bool, subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool) -> Option(Tuple(result, List(Char))) = match program
    BuiltRegex(_shape, pattern, conversion, hint) -> match hint
      NoCompilationHint() -> match parse_pattern_prefix_verified_at(pattern, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()))
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedMachineValue(compilation)) -> match parse_compilation_prefix_verified_at(compilation, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()))
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedAtomicPatternValue(plan)) -> match parse_atomic_plan_prefix_verified_at(plan, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()))
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedLookaroundValue(pattern, compilation, policy)) -> match parse_lookaround_compilation_prefix_verified_at(pattern, compilation, policy, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()), [])
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])

  fn parse_program_prefix_chars_verified_at_position({result: Type}, program: RegexProgram(result), input: List(Char), greedy: Bool, position: InitialPosition, history: List(Char)) -> Option(Tuple(result, List(Char))) = match program
    BuiltRegex(_shape, pattern, conversion, hint) -> match hint
      NoCompilationHint() -> match parse_pattern_prefix_verified_at(pattern, input, greedy, position)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedMachineValue(compilation)) -> match parse_compilation_prefix_verified_at(compilation, input, greedy, position)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedAtomicPatternValue(plan)) -> match parse_atomic_plan_prefix_verified_at(plan, input, greedy, position)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedLookaroundValue(staged_pattern, compilation, policy)) -> match parse_lookaround_compilation_prefix_verified_at(staged_pattern, compilation, policy, input, greedy, position, history)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])

  fn parse_compilation_prefix_verified_at({shape: ShapeCode}, compilation: ThompsonCompilation(shape), input: List(Char), greedy: Bool, position: InitialPosition) -> Option(Tuple(Sem(shape), List(Char))) =
    let proof = proof_for_compilation(compilation)
    let machine = staged_machine_from_compilation(compilation)
    let result = pickup
      greedy -> transport_staged_prefix(compilation, position, search_last_machine_prefix(thompson_state_count(compilation), machine, position, input))
      else -> transport_staged_prefix(compilation, position, search_first_machine_prefix(thompson_state_count(compilation), machine, position, input))
    match result
      NoCertifiedPrefix() -> None()
      CertifiedPrefixPath(matched, remaining, evidence, _, acceptance) -> Some(%[extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, matched, remaining, position, acceptance)), remaining])

  fn parse_program_prefix_verified_at({result: Type}, program: RegexProgram(result), input: String, greedy: Bool, subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool) -> Option(Tuple(result, String)) = match program
    BuiltRegex(_shape, _pattern, _conversion, _hint) -> match parse_program_prefix_chars_verified_at(program, Std.String.characters(input), greedy, subject_start, line_start, previous_ascii_word, previous_unicode_word)
      None() -> None()
      Some(%[value, rest]) -> Some(%[value, Std.String.from_characters(rest)])
