  ## Embed an exact active child start into Repeat's consuming initial branch.
  ## The list opener is prefixed once here; subsequent iterations use the
  ## re-entry embedding and therefore never reopen the list.
  fn lift_repeat_start_active_member(n: Nat, starts: List(MachineState(n)), lazy: Bool, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> ListMember(MachineState(n), Active(state, Cons(BeginList(), routine), constraints), repeat_machine_starts(starts, lazy)) = match lazy
