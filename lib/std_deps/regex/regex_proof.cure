  fn lift_alternate_left_initial_accepted_member(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), routine: List(EvidenceInstruction), edge: ListMember(MachineState(left_count), Accepted(routine, Nil()), initial_machine_destinations(left_count, left_machine, position, input, after_input))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, EmitLeft()), Nil()), initial_machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), position, input, after_input)) = match left_machine
