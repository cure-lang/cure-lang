    True() -> lift_append_right_member(n, Cons(Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()), Nil()), enter_repeat(Cons(BeginList(), Nil()), starts), Active(state, Cons(BeginList(), routine), constraints), lift_enter_repeat_active_member(n, Cons(BeginList(), Nil()), Nil(), starts, state, routine, constraints, edge))

  fn lift_repeat_initial_active_member(n: Nat, starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, routine, constraints), starts), holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> ListMember(MachineState(n), Active(state, Cons(BeginList(), routine), Nil()), filter_machine_states(n, repeat_machine_starts(starts, lazy), boundary)) =
    filter_active_member(n, repeat_machine_starts(starts, lazy), boundary, state, Cons(BeginList(), routine), constraints, lift_repeat_start_active_member(n, starts, lazy, state, routine, constraints, edge), holds)


  fn filtered_repeat_starts_origin(n: Nat, starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, repeat_machine_starts(starts, lazy), boundary))) -> FilteredRepeatStartsOrigin(n, starts, lazy, boundary, filtered) = match filtered_state_origin(n, repeat_machine_starts(starts, lazy), boundary, filtered, edge)
    FilteredActiveStateOrigin(state, combined_routine, constraints, transformed_edge, holds) -> match repeat_starts_origin(n, starts, lazy, Active(state, combined_routine, constraints), transformed_edge)
      RepeatEnteredStartOrigin(_, routine, child_constraints, child_edge) -> FilteredRepeatEnteredStartOrigin(state, routine, child_constraints, child_edge, holds)
    FilteredAcceptedStateOrigin(combined_routine, constraints, transformed_edge, holds) -> match repeat_starts_origin(n, starts, lazy, Accepted(combined_routine, constraints), transformed_edge)
      RepeatEmptyStartOrigin() -> FilteredRepeatEmptyStartOrigin()




  fn prepend_filtered_append_member({n: Nat}, head: MachineState(n), left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), origin: FilteredAppendMemberOrigin(n, left, right, value)) -> FilteredAppendMemberOrigin(n, Cons(head, left), right, value) = match origin
    FilteredAppendMemberLeft(edge) -> filtered_append_member_left(Cons(head, left), right, value, member_there(head, edge))
    FilteredAppendMemberRight(edge) -> filtered_append_member_right(Cons(head, left), right, value, edge)

  fn filtered_append_active_true_origin(n: Nat, state: Bounded(n), routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Active(state, routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_accepted_true_origin(n: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Accepted(routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_member_origin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary))) -> FilteredAppendMemberOrigin(n, filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value) = match left
    Nil() -> filtered_append_member_right(filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value, edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_active_true_origin(n, state, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_accepted_true_origin(n, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)













  fn prepend_filtered_left_origin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, head: MachineState(left_count), tail: List(MachineState(left_count)), combined: MachineState(plus(left_count, right_count)), origin: FilteredLeftMarkedStateOrigin(left_count, right_count, marker, tail, combined)) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(head, tail), combined) = match origin
    FilteredLeftActiveOrigin(state, routine, edge) -> filtered_left_active_origin(left_count, right_count, marker, Cons(head, tail), state, routine, member_there(head, edge))
    FilteredLeftAcceptedOrigin(routine, edge) -> filtered_left_accepted_origin(left_count, right_count, marker, Cons(head, tail), routine, member_there(head, edge))


  fn filtered_left_active_true_origin(left_count: Nat, right_count: Nat, state: Bounded(left_count), routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_active_origin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), state, routine, member_here(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_left_accepted_true_origin(left_count: Nat, right_count: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_accepted_origin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), routine, member_here(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))



  fn filtered_left_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filter_machine_states(left_count, states, boundary), combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_active_true_origin(left_count, right_count, state, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_accepted_true_origin(left_count, right_count, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)







  fn lift_alternate_left_active_edge(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(left_count), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(left_count), Active(state, routine, constraints), filter_machine_states(left_count, states, boundary)), origin: FilteredStateOrigin(left_count, states, boundary, Active(state, routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> lift_filtered_left_active_member(left_count, right_count, states, marker, boundary, state, routine, edge)
    FilteredAcceptedStateOrigin(_, _, _, _) -> impossible

  fn lift_alternate_left_accepted_edge(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(left_count), Accepted(routine, constraints), filter_machine_states(left_count, states, boundary)), origin: FilteredStateOrigin(left_count, states, boundary, Accepted(routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> impossible
    FilteredAcceptedStateOrigin(_, _, _, _) -> lift_filtered_left_accepted_member(left_count, right_count, states, marker, boundary, routine, edge)

  fn lift_alternate_left_active_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), child_routine: List(ExtendedInstruction), path: AcceptingFrom(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> AlternateLeftActivePathEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, child_final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNow() -> impossible
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match lift_alternate_left_active_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, destination, destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix)
            mk_pair(combined_suffix_routine, combined_suffix) ->
              let origin = filtered_state_origin(left_count, left_next(source, char), transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_left_active_edge(left_count, right_count, left_next(source, char), EmitLeft(), transition_boundary_before(char, rest, after_input), destination, regular, constraints, edge, origin)
              let combined_edge = alternate_left_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(inject_alternate_left(left_count, right_count, destination), regular, Nil()), filtered_combined_edge)
              let combined_routine = append_extended_routines(transition_routine(char, regular), combined_suffix_routine)
              %[combined_routine, AcceptingNextActive(inject_alternate_left(left_count, right_count, destination), regular, empty_constraints(), destination_evidence, destination_captures, combined_suffix_routine, combined_edge, execution, combined_suffix)]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match suffix
            AcceptingNow() ->
              let marker_execution: RoutineExecution(Cons(EmitLeft(), Nil()), destination_evidence, destination_captures, Cons(LeftEvidence(), destination_evidence), destination_captures) = RoutineStep(EmitLeft(), RoutineDone())
              let combined_execution = append_routine_execution(regular, Cons(EmitLeft(), Nil()), current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, Cons(LeftEvidence(), destination_evidence), destination_captures, execution, marker_execution)
              let origin = filtered_state_origin(left_count, left_next(source, char), transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_left_accepted_edge(left_count, right_count, left_next(source, char), EmitLeft(), transition_boundary_before(char, rest, after_input), regular, constraints, edge, origin)
              let combined_edge = alternate_left_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(append_branch_marker(regular, EmitLeft()), Nil()), filtered_combined_edge)
              let no_extended: List(ExtendedInstruction) = Nil()
              let combined_routine = append_extended_routines(transition_routine(char, append_branch_marker(regular, EmitLeft())), no_extended)
              %[combined_routine, AcceptingNextAccepted(append_branch_marker(regular, EmitLeft()), empty_constraints(), Cons(LeftEvidence(), destination_evidence), destination_captures, no_extended, combined_edge, combined_execution, AcceptingNow())]
            AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
            AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible




  fn lift_alternate_right_active_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), child_routine: List(ExtendedInstruction), path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> AlternateRightActivePathEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, child_final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNow() -> impossible
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match lift_alternate_right_active_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, destination, destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix)
            mk_pair(combined_suffix_routine, combined_suffix) ->
              let origin = filtered_state_origin(right_count, right_next(source, char), transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_right_active_edge(left_count, right_count, right_next(source, char), EmitRight(), transition_boundary_before(char, rest, after_input), destination, regular, constraints, edge, origin)
              let combined_edge = alternate_right_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(inject_alternate_right(left_count, right_count, destination), regular, Nil()), filtered_combined_edge)
              let combined_routine = append_extended_routines(transition_routine(char, regular), combined_suffix_routine)
              %[combined_routine, AcceptingNextActive(inject_alternate_right(left_count, right_count, destination), regular, empty_constraints(), destination_evidence, destination_captures, combined_suffix_routine, combined_edge, execution, combined_suffix)]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match suffix
            AcceptingNow() ->
              let marker_execution: RoutineExecution(Cons(EmitRight(), Nil()), destination_evidence, destination_captures, Cons(RightEvidence(), destination_evidence), destination_captures) = RoutineStep(EmitRight(), RoutineDone())
              let combined_execution = append_routine_execution(regular, Cons(EmitRight(), Nil()), current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, Cons(RightEvidence(), destination_evidence), destination_captures, execution, marker_execution)
              let origin = filtered_state_origin(right_count, right_next(source, char), transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_right_accepted_edge(left_count, right_count, right_next(source, char), EmitRight(), transition_boundary_before(char, rest, after_input), regular, constraints, edge, origin)
              let combined_edge = alternate_right_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(append_branch_marker(regular, EmitRight()), Nil()), filtered_combined_edge)
              let no_extended: List(ExtendedInstruction) = Nil()
              let combined_routine = append_extended_routines(transition_routine(char, append_branch_marker(regular, EmitRight())), no_extended)
              %[combined_routine, AcceptingNextAccepted(append_branch_marker(regular, EmitRight()), empty_constraints(), Cons(RightEvidence(), destination_evidence), destination_captures, no_extended, combined_edge, combined_execution, AcceptingNow())]
            AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
            AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible






  fn alternate_left_transition_origin(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(left_count), char: Char, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, EmitLeft(), filter_machine_states(left_count, left_next(source, char), boundary), combined) =
    filtered_left_marked_state_origin(left_count, right_count, left_next(source, char), EmitLeft(), boundary, combined, transport_alternate_edge(alternate_left_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, boundary), edge))






















  fn concat_left_active_step_view(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, left_input: List(Char), right_input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), left_final_evidence: List(Evidence), left_path_routine: List(ExtendedInstruction), left_path: AcceptingFrom(left_count, left_machine, left_input, append_characters(right_input, after_input), ThreadActive(source), current_evidence, current_captures, left_final_evidence, left_path_routine), left_final_captures: List(CaptureFrame), left_captures_exact: Equivalent(List(CaptureFrame), left_final_captures, accepting_final_captures(left_count, left_machine, left_input, append_characters(right_input, after_input), ThreadActive(source), current_evidence, current_captures, left_final_evidence, left_path_routine, left_path)), right_final_evidence: List(Evidence), right_acceptance: AcceptancePathFrom(right_count, right_machine, advance_initial_position(position, left_input), right_input, after_input, left_final_evidence, left_final_captures, right_final_evidence)) -> ConcatLeftActiveStepView(left_count, right_count, position, right_input, after_input, source, current_evidence, current_captures, left_final_evidence, right_final_evidence, left_machine, right_machine, left_input) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> match concat_left_active_input_view(left_count, left_starts, left_next, right_count, right_starts, right_next, position, left_input, right_input, after_input, source, current_evidence, current_captures, left_final_evidence, left_path_routine, left_path, left_final_captures, left_captures_exact, right_final_evidence, right_acceptance)
        ConcatLeftActiveNextActive(char, rest, destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, left_final_captures, left_captures_exact, right_acceptance) -> ConcatLeftStepActive(left_starts, left_next, right_starts, right_next, char, rest, destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, left_final_captures, left_captures_exact, box_concat_right_acceptance(right_count, MkPatternMachine(right_starts, right_next), advance_initial_position(position, Cons(char, rest)), right_input, after_input, left_final_evidence, left_final_captures, right_final_evidence, right_acceptance))
        ConcatLeftActiveNextAccepted(char, rest, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, left_final_captures, left_captures_exact, right_acceptance) -> ConcatLeftStepAccepted(left_starts, left_next, right_starts, right_next, char, rest, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, left_final_captures, left_captures_exact, box_concat_right_acceptance(right_count, MkPatternMachine(right_starts, right_next), advance_initial_position(position, Cons(char, rest)), right_input, after_input, left_final_evidence, left_final_captures, right_final_evidence, right_acceptance))







  fn lift_concat_acceptances_with_right(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), position: InitialPosition, left_input: List(Char), right_input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), left_final_evidence: List(Evidence), left_acceptance: AcceptancePathFrom(left_count, left_machine, position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, left_final_evidence), right_final_evidence: List(Evidence), right_acceptance: AcceptancePathFrom(right_count, MkPatternMachine(right_starts, right_next), advance_initial_position(position, left_input), right_input, after_input, left_final_evidence, acceptance_path_final_captures(left_count, left_machine, position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, left_final_evidence, left_acceptance), right_final_evidence)) -> AcceptancePathFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, MkPatternMachine(right_starts, right_next)), position, append_characters(left_input, right_input), after_input, input_evidence, input_captures, Cons(PairEvidence(), right_final_evidence)) = match exact_acceptance_start_view(left_count, left_machine, position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, left_final_evidence, left_acceptance)
    ExactAcceptanceStartsActive(left_starts, left_next, _, left_state, left_regular, left_constraints, left_initial_evidence, left_initial_captures, left_path_routine, left_edge, left_execution, left_path) -> match lift_concat_left_active_path(left_count, left_machine, right_count, MkPatternMachine(right_starts, right_next), position, left_input, right_input, after_input, left_state, left_initial_evidence, left_initial_captures, left_final_evidence, left_path_routine, left_path, right_final_evidence, right_acceptance)
