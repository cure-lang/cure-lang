            let boundary = transition_boundary_before(char, rest, after_input)
            let repeat_edge = lift_repeat_filtered_active_transition_member(n, next(source, char), starts, lazy, boundary, destination, regular, constraints, edge)
            let repeat_routine = append_extended_routines(transition_routine(char, regular), repeat_suffix_routine)
