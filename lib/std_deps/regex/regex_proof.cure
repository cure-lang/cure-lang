    ExactAcceptanceStartsActive(_, _, _, state, regular, constraints, start_evidence, start_captures, child_routine, edge, execution, child_path) -> match normalize_initial_active(n, starts, next, position, Cons(char, rest), after_input, input_evidence, input_captures, state, regular, constraints, start_evidence, start_captures, edge, execution)
      InitialActiveNormalized(raw_regular, normalized_edge, normalized_execution) -> match lift_repeat_closing_active_path(n, starts, next, lazy, Cons(char, rest), after_input, state, start_evidence, start_captures, child_final_evidence, child_routine, child_path)
        RepeatClosingPathLifted(repeat_routine, repeat_path) -> RepeatContinuationActive(state, raw_regular, start_evidence, start_captures, Cons(EndListEvidence(), child_final_evidence), repeat_routine, normalized_edge, normalized_execution, repeat_path)

  ## As above, but splice a previously constructed continuation after this
  ## child instead of closing the evidence list.
