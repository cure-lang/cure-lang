            let appended = lift_filtered_append_left_member(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), alternate_right_states(left_count, right_count, right_starts, EmitRight()), boundary, Accepted(append_branch_marker(routine, EmitLeft()), Nil()), marked_edge)
            transport_alternate_edge(filtered_alternate_starts_left_order(left_count, left_starts, right_count, right_starts, boundary), appended)
          True() ->
            let appended = lift_filtered_append_right_member(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_starts, EmitRight()), alternate_left_states(left_count, right_count, left_starts, EmitLeft()), boundary, Accepted(append_branch_marker(routine, EmitLeft()), Nil()), marked_edge)
