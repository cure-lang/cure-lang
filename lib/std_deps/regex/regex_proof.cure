              capture_equivalent_transitive(
                  accepting_final_captures(S(Z()), MkPatternMachine(Cons(Active(First(), Nil(), Nil()), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), Cons(char, Nil()), after_input, ThreadActive(First()), current_evidence, captures, final_evidence, Cons(Observe(char), Cons(Regular(EmitChar(char)), Nil())), path),
                  accepting_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix),
                  record_capture_input(captures, Cons(char, Nil())),
                  reflexive(accepting_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)),
                  capture_equivalent_transitive(
                accepting_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix),
                record_capture_char(captures, char),
                record_capture_input(captures, Cons(char, Nil())),
                accepted_path_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix),
                record_capture_single(captures, char)
              ))

