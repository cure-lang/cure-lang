  fn complete_concat_left_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), state: Bounded(left_count), routine: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), initial_edge: ListMember(MachineState(left_count), Active(state, routine, empty_boundary_constraints()), initial_machine_destinations(left_count, left_machine, position, input, after_input)), initial_execution: RoutineExecution(routine, input_evidence, input_captures, initial_evidence, initial_captures), {final_evidence: List(Evidence)}, {final_captures: List(CaptureFrame)}, projection: ConcatLeftPathProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)) -> ConcatAcceptanceFromProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures) = match projection
    ProjectedConcatLeftPath(left_input, right_input, partition, left_final_evidence, left_final_captures, left_path_routine, left_path, left_captures_exact, right_final_evidence, right_acceptance, final_is_paired) -> match right_acceptance
      mk_pair(right_destination, mk_pair(right_initial_evidence, mk_pair(right_initial_captures, mk_pair(right_path_routine, mk_pair(right_edge, mk_pair(right_initial_execution, right_path)))))) ->
        let original_filtered_edge = filtered_starts_from_initial_edge(left_count, left_machine, position, input, after_input, Active(state, routine, empty_boundary_constraints()), initial_edge)
        let child_filtered_edge = transport_filtered_start_subject(left_count, left_machine, position, append_characters(input, after_input), append_characters(left_input, append_characters(right_input, after_input)), Active(state, routine, empty_boundary_constraints()), partition_append_after(after_input, partition), original_filtered_edge)
        let child_initial_edge = initial_edge_from_filtered_starts(left_count, left_machine, position, left_input, append_characters(right_input, after_input), Active(state, routine, empty_boundary_constraints()), child_filtered_edge)
        let left_acceptance = active_acceptance_from_path(left_count, left_machine, position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, state, routine, initial_evidence, initial_captures, left_path_routine, child_initial_edge, initial_execution, left_path)
        ProjectedConcatAcceptance(left_input, right_input, partition, left_final_evidence, left_final_captures, left_acceptance, left_captures_exact, right_final_evidence, mk_pair(right_destination, mk_pair(right_initial_evidence, mk_pair(right_initial_captures, mk_pair(right_path_routine, mk_pair(right_edge, mk_pair(right_initial_execution, right_path)))))), final_is_paired)

  fn project_concat_acceptance_from(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), position, input, after_input, input_evidence, input_captures, final_evidence)) -> ConcatAcceptanceFromProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance_path_final_captures(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> match concat_initial_origin(left_count, left_machine, right_count, right_machine, position, input, after_input, destination, edge)
      FilteredContinueLeftActiveOrigin(state, routine, constraints, left_edge, holds) ->
        let boundary = initial_position_boundary(position, append_characters(input, after_input))
        let left_filtered_edge = filter_active_member(left_count, proof_machine_starts(left_machine), boundary, state, routine, constraints, left_edge, holds)
        let left_initial_edge = initial_edge_from_filtered_starts(left_count, left_machine, position, input, after_input, Active(state, routine, empty_boundary_constraints()), left_filtered_edge)
        let projection = project_concat_left_path(left_count, left_machine, right_count, right_machine, position, input, after_input, state, initial_evidence, initial_captures, path)
        complete_concat_left_acceptance(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, state, routine, initial_evidence, initial_captures, left_initial_edge, initial_execution, projection)
      FilteredContinueEnteredRightActiveOrigin(left_routine, left_constraints, left_edge, state, right_routine, right_constraints, right_edge, holds) -> project_concat_entered_right_active_acceptance_from(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, left_routine, left_constraints, left_edge, state, right_routine, right_constraints, right_edge, holds, initial_evidence, initial_captures, initial_execution, path)
      FilteredContinueEnteredRightAcceptedOrigin(left_routine, left_constraints, left_edge, right_routine, right_constraints, right_edge, holds) -> project_concat_entered_right_accepted_acceptance_from(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, left_routine, left_constraints, left_edge, right_routine, right_constraints, right_edge, holds, initial_evidence, initial_captures, initial_execution, path)


  fn project_alternate_left_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, captures, final_evidence, routine)) -> AlternateLeftPathProjection(left_count, left_machine, input, after_input, source, current_evidence, captures, final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_left_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredLeftActiveOrigin(child_destination, child_regular, child_edge) -> match project_alternate_left_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              mk_pair(child_final_evidence, mk_pair(child_suffix_routine, mk_pair(child_suffix, final_is_marked))) -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), AcceptingNextActive(child_destination, child_regular, Nil(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix), final_is_marked]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_left_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredLeftAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitLeft(), Nil()), current_evidence, record_capture_char(captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() -> %[child_final_evidence, append_extended_routines(transition_routine(char, child_regular), Nil()), AcceptingNextAccepted(child_regular, Nil(), child_final_evidence, child_final_captures, Nil(), child_edge, child_execution, AcceptingNow()), reflexive(Cons(LeftEvidence(), child_final_evidence))]


  fn project_alternate_left_shared_execution(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {combined_routine: List(ExtendedInstruction)}, combined_path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) -> AlternateLeftSharedExecutionProjection(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, final_evidence, combined_routine, combined_path) = match input
    Nil() -> match combined_path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match combined_path
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_left_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
            FilteredLeftActiveOrigin(child_destination, child_regular, child_edge) -> match project_alternate_left_shared_execution(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, child_destination, destination_evidence, destination_captures, suffix)
              ProjectedAlternateLeftSharedExecution(child_final_evidence, child_suffix_routine, child_suffix, shared_final_captures, child_suffix_execution, combined_suffix_execution, final_is_marked) ->
                let child_path = AcceptingNextActive(child_destination, child_regular, empty_boundary_constraints(), destination_evidence, destination_captures, child_suffix_routine, child_edge, execution, child_suffix)
                let child_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
                let child_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), child_suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, child_transition_execution, child_suffix_execution)
                let combined_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
                let combined_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, combined_transition_execution, combined_suffix_execution)
                ProjectedAlternateLeftSharedExecution(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), child_path, shared_final_captures, child_execution, combined_execution, final_is_marked)
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match alternate_left_transition_origin(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
            FilteredLeftAcceptedOrigin(child_regular, child_edge) -> match accepted_path_view(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
              AcceptedPathNow() -> match split_appended_routine_execution(child_regular, Cons(EmitLeft(), Nil()), current_evidence, record_capture_char(current_captures, char), execution)
                AppendedRoutineExecuted(child_final_evidence, child_final_captures, child_execution_regular, marker_execution) -> match marker_execution
                  RoutineStep(_, marker_suffix) -> match marker_suffix
                    RoutineDone() ->
                      let child_path = one_step_accepted_path(left_count, MkPatternMachine(left_starts, left_next), char, after_input, source, current_evidence, current_captures, child_regular, child_final_evidence, child_final_captures, child_edge, child_execution_regular)
                      let child_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), child_final_evidence, child_final_captures, child_execution_regular))
                      let child_execution = append_extended_routine_execution_inferred(transition_routine(char, child_regular), empty_extended_routine(), current_evidence, current_captures, child_final_evidence, child_final_captures, child_transition_execution, empty_extended_execution(child_final_evidence, child_final_captures))
                      let combined_transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(append_branch_marker(child_regular, EmitLeft()), current_evidence, record_capture_char(current_captures, char), destination_evidence, child_final_captures, execution))
                      let combined_execution = append_extended_routine_execution_inferred(transition_routine(char, append_branch_marker(child_regular, EmitLeft())), empty_extended_routine(), current_evidence, current_captures, destination_evidence, child_final_captures, combined_transition_execution, empty_extended_execution(destination_evidence, child_final_captures))
                      ProjectedAlternateLeftSharedExecution(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), empty_extended_routine()), child_path, child_final_captures, child_execution, combined_execution, reflexive(Cons(LeftEvidence(), child_final_evidence)))


  fn project_alternate_left_executed_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {combined_routine: List(ExtendedInstruction)}, combined_path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, final_evidence, combined_routine)) -> AlternateLeftExecutedPathProjection(left_count, left_machine, input, after_input, source, current_evidence, current_captures, final_evidence) = match project_alternate_left_path(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, combined_path)
