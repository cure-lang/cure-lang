        input_evidence,
        input_captures,
        input,
        Cons(CaptureFrame(chars, saved), outer),
        group_child_supplied_captures(inner, inner_proof, position, input, after_input, input_evidence, Cons(CaptureFrame(empty_characters(), input_evidence), input_captures), child_final_evidence, Cons(CaptureFrame(chars, saved), outer), projected_child)
    )
