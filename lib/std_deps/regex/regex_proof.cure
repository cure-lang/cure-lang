  fn lift_repeat_reentry_active_path(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, position: InitialPosition, child_input: List(Char), remaining_input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), child_routine: List(ExtendedInstruction), child_path: AcceptingFrom(n, MkPatternMachine(starts, next), child_input, append_characters(remaining_input, after_input), ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine), continuation: RepeatContinuationFrom(n, starts, next, lazy, advance_initial_position(position, child_input), remaining_input, after_input, child_final_evidence, accepting_final_captures(n, MkPatternMachine(starts, next), child_input, append_characters(remaining_input, after_input), ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path))) -> RepeatReentryPathEmbedding(n, starts, next, lazy, source, current_evidence, current_captures, child_input, remaining_input, after_input) = match child_input
    Nil() -> impossible_empty_active_path(n, MkPatternMachine(starts, next), append_characters(remaining_input, after_input), source, current_evidence, current_captures, child_final_evidence, child_routine, child_path)
    Cons(input_char, input_rest) -> match exact_repeat_child_active_path_view(n, starts, next, child_input, append_characters(remaining_input, after_input), source, current_evidence, current_captures, child_final_evidence, child_routine, child_path)
      ExactRepeatChildNextActive(char, rest, destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) ->
        let whole_to_suffix = accepting_next_active_final_captures(n, MkPatternMachine(starts, next), char, rest, append_characters(remaining_input, after_input), source, current_evidence, current_captures, destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, child_final_evidence, suffix, child_path)
        let suffix_continuation = transport_repeat_continuation_captures(n, starts, next, lazy, advance_initial_position(position, child_input), remaining_input, after_input, child_final_evidence, accepting_final_captures(n, MkPatternMachine(starts, next), child_input, append_characters(remaining_input, after_input), ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine, child_path), accepting_final_captures(n, MkPatternMachine(starts, next), rest, append_characters(remaining_input, after_input), ThreadActive(destination), destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix), whole_to_suffix, continuation)
        let positioned_continuation = transport_repeat_continuation_position(n, starts, next, lazy, advance_initial_position(position, child_input), advance_initial_position(advance_initial_position(position, Cons(char, Nil())), rest), remaining_input, after_input, child_final_evidence, accepting_final_captures(n, MkPatternMachine(starts, next), rest, append_characters(remaining_input, after_input), ThreadActive(destination), destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix), initial_position_equivalent_symmetric(advance_initial_position(advance_initial_position(position, Cons(char, Nil())), rest), advance_initial_position(position, child_input), advance_initial_position_cons(position, char, rest)), suffix_continuation)
        match lift_repeat_reentry_active_path(n, starts, next, lazy, advance_initial_position(position, Cons(char, Nil())), input_rest, remaining_input, after_input, destination, destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix, positioned_continuation)
          RepeatReentryPathLifted(final_evidence, repeat_suffix_routine, repeat_suffix) ->
            let boundary = transition_boundary_before(char, append_characters(rest, remaining_input), after_input)
            let transported_edge = transport_transition_edge_after(n, MkPatternMachine(starts, next), source, char, append_characters(rest, append_characters(remaining_input, after_input)), append_characters(append_characters(rest, remaining_input), after_input), Active(destination, regular, constraints), character_list_equivalent_symmetric(append_characters(append_characters(rest, remaining_input), after_input), append_characters(rest, append_characters(remaining_input, after_input)), partition_append_after(after_input, append_input_partition(rest, remaining_input))), edge)
            let repeat_edge = lift_repeat_filtered_active_transition_member(n, next(source, char), starts, lazy, boundary, destination, regular, constraints, transported_edge)
            let repeat_routine = append_extended_routines(transition_routine(char, regular), repeat_suffix_routine)
            let no_constraints: List(BoundaryConstraint) = Nil()
            let repeat_path: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), Cons(char, append_characters(rest, remaining_input)), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, repeat_routine) = AcceptingNextActive(destination, regular, no_constraints, destination_evidence, destination_captures, repeat_suffix_routine, repeat_edge, execution, repeat_suffix)
            RepeatReentryPathLifted(final_evidence, repeat_routine, repeat_path)
      ExactRepeatChildNextAccepted(char, rest, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match exact_accepted_path_view(n, MkPatternMachine(starts, next), rest, append_characters(remaining_input, after_input), destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix)
        ExactAcceptedPathNow() -> match continuation
          RepeatContinuationActive(next_state, start_regular, start_evidence, start_captures, final_evidence, repeat_suffix_routine, start_edge, start_execution, repeat_suffix) ->
            let filtered_start_edge = filtered_starts_from_advanced_initial_edge_parts(n, starts, next, position, char, remaining_input, after_input, Active(next_state, start_regular, Nil()), start_edge)
            let child_edge_at_remaining = transport_transition_edge_after(n, MkPatternMachine(starts, next), source, char, append_characters(Nil(), append_characters(remaining_input, after_input)), append_characters(remaining_input, after_input), Accepted(regular, constraints), reflexive(append_characters(remaining_input, after_input)), edge)
            let path = splice_repeat_reentry_step(n, starts, next, lazy, char, remaining_input, after_input, source, current_evidence, current_captures, regular, constraints, child_final_evidence, destination_captures, child_edge_at_remaining, execution, next_state, start_regular, Nil(), filtered_start_edge, start_evidence, start_captures, start_execution, final_evidence, repeat_suffix_routine, repeat_suffix)
            RepeatReentryPathLifted(final_evidence, append_extended_routines(transition_routine(char, append_routine(regular, start_regular)), repeat_suffix_routine), path)


  ## As above, but splice a previously constructed continuation after this
  ## child instead of closing the evidence list.
  fn repeat_reentry_continuation_from_acceptance(
    n: Nat,
    starts: List(MachineState(n)),
    next: (Bounded(n)) -> Char -> List(MachineState(n)),
    lazy: Bool,
    position: InitialPosition,
    char: Char,
    child_rest: List(Char),
    remaining_input: List(Char),
    after_input: List(Char),
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    child_final_evidence: List(Evidence),
    child_acceptance: AcceptancePathFrom(n, MkPatternMachine(starts, next), position, Cons(char, child_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence),
    continuation: RepeatContinuationFrom(n, starts, next, lazy, advance_initial_position(position, Cons(char, child_rest)), remaining_input, after_input, child_final_evidence, acceptance_path_final_captures(n, MkPatternMachine(starts, next), position, Cons(char, child_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence, child_acceptance))
  ) -> RepeatContinuationFrom(n, starts, next, lazy, position, append_characters(Cons(char, child_rest), remaining_input), after_input, input_evidence, input_captures) = match exact_acceptance_start_view(n, MkPatternMachine(starts, next), position, Cons(char, child_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence, child_acceptance)
    ExactAcceptanceStartsActive(_, _, _, state, regular, constraints, start_evidence, start_captures, child_routine, edge, execution, child_path) ->
      let acceptance_captures = acceptance_path_final_captures(n, MkPatternMachine(starts, next), position, Cons(char, child_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence, child_acceptance)
      let active_captures_exact = active_acceptance_path_captures_exact(n, MkPatternMachine(starts, next), position, Cons(char, child_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, child_final_evidence, state, regular, constraints, start_evidence, start_captures, child_routine, edge, execution, child_path, acceptance_captures, reflexive(acceptance_captures))
      let aligned_continuation = transport_repeat_continuation_captures(n, starts, next, lazy, advance_initial_position(position, Cons(char, child_rest)), remaining_input, after_input, child_final_evidence, acceptance_captures, accepting_final_captures(n, MkPatternMachine(starts, next), Cons(char, child_rest), append_characters(remaining_input, after_input), ThreadActive(state), start_evidence, start_captures, child_final_evidence, child_routine, child_path), capture_equivalent_symmetric(accepting_final_captures(n, MkPatternMachine(starts, next), Cons(char, child_rest), append_characters(remaining_input, after_input), ThreadActive(state), start_evidence, start_captures, child_final_evidence, child_routine, child_path), acceptance_captures, active_captures_exact), continuation)
      match normalize_initial_active(n, starts, next, position, Cons(char, child_rest), append_characters(remaining_input, after_input), input_evidence, input_captures, state, regular, constraints, start_evidence, start_captures, edge, execution)
        InitialActiveNormalized(raw_regular, normalized_edge, normalized_execution) ->
          let child_filtered_edge = filtered_starts_from_initial_edge(n, MkPatternMachine(starts, next), position, Cons(char, child_rest), append_characters(remaining_input, after_input), Active(state, raw_regular, Nil()), normalized_edge)
          let full_filtered_edge = transport_filtered_start_subject(n, MkPatternMachine(starts, next), position, append_characters(Cons(char, child_rest), append_characters(remaining_input, after_input)), append_characters(append_characters(Cons(char, child_rest), remaining_input), after_input), Active(state, raw_regular, Nil()), character_list_equivalent_symmetric(append_characters(append_characters(Cons(char, child_rest), remaining_input), after_input), append_characters(Cons(char, child_rest), append_characters(remaining_input, after_input)), partition_append_after(after_input, append_input_partition(Cons(char, child_rest), remaining_input))), child_filtered_edge)
          let full_start_edge = initial_edge_from_filtered_starts(n, MkPatternMachine(starts, next), position, append_characters(Cons(char, child_rest), remaining_input), after_input, Active(state, raw_regular, Nil()), full_filtered_edge)
          match lift_repeat_reentry_active_path(n, starts, next, lazy, position, Cons(char, child_rest), remaining_input, after_input, state, start_evidence, start_captures, child_final_evidence, child_routine, child_path, aligned_continuation)
            RepeatReentryPathLifted(final_evidence, repeat_routine, repeat_path) -> RepeatContinuationActive(state, raw_regular, start_evidence, start_captures, final_evidence, repeat_routine, full_start_edge, normalized_execution, repeat_path)



























































































































































































































































































  fn project_alternate_acceptance_from_origin(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, origin: AlternateInitialOrigin(left_count, right_count, initial_machine_destinations(left_count, left_machine, position, input, after_input), initial_machine_destinations(right_count, right_machine, position, input, after_input), destination), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateAcceptanceProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence) = match origin
    AlternateInitialFromLeft(left_origin) -> alternate_acceptance_from_left(project_alternate_left_acceptance(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, destination, initial_evidence, initial_captures, path_routine, left_origin, execution, path))
    AlternateInitialFromRight(right_origin) -> alternate_acceptance_from_right(project_alternate_right_acceptance(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, destination, initial_evidence, initial_captures, path_routine, right_origin, execution, path))

  fn project_alternate_acceptance_parts(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, edge: ListMember(MachineState(plus(left_count, right_count)), destination, initial_machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), position, input, after_input)), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateAcceptanceProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> project_alternate_acceptance_from_origin(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, position, input, after_input, destination, initial_evidence, initial_captures, path_routine, alternate_initial_origin(left_count, left_starts, right_count, right_starts, prefer_right, initial_position_boundary(position, append_characters(input, after_input)), destination, edge), execution, path)

  fn project_alternate_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), {final_evidence: List(Evidence)}, acceptance: AcceptancePath(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), position, input, after_input, final_evidence)) -> AlternateAcceptanceProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(execution, path)))))) -> project_alternate_acceptance_parts(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, destination, initial_evidence, initial_captures, path_routine, edge, execution, path)





  fn project_alternate_acceptance_from_origin_general(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, origin: AlternateInitialOrigin(left_count, right_count, initial_machine_destinations(left_count, left_machine, position, input, after_input), initial_machine_destinations(right_count, right_machine, position, input, after_input), destination), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), input_evidence, input_captures, initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateAcceptanceFromProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence) = match origin
    AlternateInitialFromLeft(left_origin) -> alternate_acceptance_from_left_projection(project_alternate_left_acceptance_from(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, input_evidence, input_captures, destination, initial_evidence, initial_captures, path_routine, left_origin, execution, path))
    AlternateInitialFromRight(right_origin) -> alternate_acceptance_from_right_projection(project_alternate_right_acceptance_from(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, input_evidence, input_captures, destination, initial_evidence, initial_captures, path_routine, right_origin, execution, path))

  fn project_alternate_acceptance_from_parts(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), destination: MachineState(plus(left_count, right_count)), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, edge: ListMember(MachineState(plus(left_count, right_count)), destination, initial_machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), position, input, after_input)), execution: RoutineExecution(machine_state_routine(plus(left_count, right_count), destination), input_evidence, input_captures, initial_evidence, initial_captures), path: AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, machine_state_thread(plus(left_count, right_count), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> AlternateAcceptanceFromProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> project_alternate_acceptance_from_origin_general(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, position, input, after_input, input_evidence, input_captures, destination, initial_evidence, initial_captures, path_routine, alternate_initial_origin(left_count, left_starts, right_count, right_starts, prefer_right, initial_position_boundary(position, append_characters(input, after_input)), destination, edge), execution, path)

  fn project_alternate_acceptance_from(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), position, input, after_input, input_evidence, input_captures, final_evidence)) -> AlternateAcceptanceFromProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(execution, path)))))) -> project_alternate_acceptance_from_parts(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, input_evidence, input_captures, destination, initial_evidence, initial_captures, path_routine, edge, execution, path)


























































































































  fn thompson_repeat_final_projection_encodes_many(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), position: InitialPosition, input: List(Char), after_input: List(Char), item_input_evidence: List(Evidence), item_input_captures: List(CaptureFrame), state: Bounded(thompson_state_count(inner)), routine: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), initial_edge: ListMember(MachineState(thompson_state_count(inner)), Active(state, routine, Nil()), initial_machine_destinations(thompson_state_count(inner), thompson_machine(inner), position, input, after_input)), initial_execution: RoutineExecution(routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures), @erased base_evidence: List(Evidence), @erased prior: EncodesMany(inner_shape, item_input_evidence, base_evidence), child_final_evidence: List(Evidence), child_final_captures: List(CaptureFrame), child_routine: List(ExtendedInstruction), child_path: AcceptingFrom(thompson_state_count(inner), thompson_machine(inner), input, after_input, ThreadActive(state), initial_evidence, initial_captures, child_final_evidence, child_routine), @erased projected_final_evidence: List(Evidence), final_is_closed: Equivalent(List(Evidence), projected_final_evidence, Cons(EndListEvidence(), child_final_evidence))) -> Encodes(ListC(inner_shape), projected_final_evidence, base_evidence) = match final_is_closed
    reflexive() ->
      let child_acceptance = active_acceptance_from_path(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, child_routine, initial_edge, initial_execution, child_path)
      EncodesList(EncodesManyItem(thompson_evidence_acceptance_from_encodes_explicit(inner_shape, inner, inner_proof, input, after_input, position, item_input_evidence, item_input_captures, child_acceptance), prior))

