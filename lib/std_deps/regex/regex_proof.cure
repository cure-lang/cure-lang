  fn lift_alternate_left_accepted_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), regular: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), edge: ListMember(MachineState(left_count), Accepted(regular, Nil()), initial_machine_destinations(left_count, left_machine, position, input, after_input)), execution: RoutineExecution(regular, input_evidence, input_captures, initial_evidence, initial_captures), child_final_evidence: List(Evidence), path_routine: List(ExtendedInstruction), path: AcceptingFrom(left_count, left_machine, input, after_input, ThreadAccepted(), initial_evidence, initial_captures, child_final_evidence, path_routine)) -> AlternateLeftAcceptanceEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, input_evidence, input_captures, child_final_evidence) = match path
