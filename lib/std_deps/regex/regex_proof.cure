  fn thompson_repeat_projection_encodes_many(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), item_input_evidence: List(Evidence), item_input_captures: List(CaptureFrame), state: Bounded(thompson_state_count(inner)), routine: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), initial_edge: ListMember(MachineState(thompson_state_count(inner)), Active(state, routine, Nil()), initial_machine_destinations(thompson_state_count(inner), thompson_machine(inner), position, input, after_input)), initial_execution: RoutineExecution(routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures), @erased base_evidence: List(Evidence), @erased prior: EncodesMany(inner_shape, item_input_evidence, base_evidence), @erased final_evidence: List(Evidence), {final_captures: List(CaptureFrame)}, projection: RepeatActivePathProjection(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)) -> Encodes(ListC(inner_shape), final_evidence, base_evidence) = match projection
    ProjectedRepeatFinalItem(child_final_evidence, child_final_captures, child_routine, child_path, _, _, _, projected_final_evidence, final_is_closed) -> thompson_repeat_final_projection_encodes_many(inner_shape, inner, inner_proof, position, input, after_input, item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, initial_edge, initial_execution, base_evidence, prior, child_final_evidence, child_final_captures, child_routine, child_path, projected_final_evidence, final_is_closed)
    ProjectedRepeatMoreItems(child_input, remaining_input, partition, child_final_evidence, child_final_captures, child_routine, child_path, _, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, combined_final_captures, continuation) ->
      thompson_repeat_more_projection_encodes_many(inner_shape, inner, inner_proof, lazy, position, input, after_input, item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, initial_edge, initial_execution, base_evidence, prior, child_input, remaining_input, partition, child_final_evidence, child_final_captures, child_routine, child_path, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, combined_final_captures, continuation)

  fn thompson_repeat_acceptance_from_encodes(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(inner), repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(ListC(inner_shape), final_evidence, input_evidence) = match project_repeat_acceptance_from_machine(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, input_evidence, input_captures, acceptance)
      ProjectedRepeatEmptyAcceptance(input_empty, projected_final_evidence, evidence_exact, combined_final_captures, captures_exact) -> match evidence_exact
        reflexive() ->
          let empty_encoding = encodes_many_empty(inner_shape, input_evidence)
          EncodesList(empty_encoding)
      ProjectedRepeatItemsAcceptance(state, routine, list_evidence, list_captures, initial_evidence, initial_captures, initial_edge, initial_execution, projection, list_evidence_exact, list_captures_exact) -> match list_evidence_exact
        reflexive() -> match list_captures_exact
          reflexive() -> thompson_repeat_projection_encodes_many(inner_shape, inner, inner_proof, lazy, position, input, after_input, Cons(BeginListEvidence(), input_evidence), input_captures, state, routine, initial_evidence, initial_captures, initial_edge, initial_execution, input_evidence, encodes_many_empty(inner_shape, input_evidence), final_evidence, projection)

  fn thompson_repeat_projection_captures(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), item_input_evidence: List(Evidence), item_input_captures: List(CaptureFrame), state: Bounded(thompson_state_count(inner)), routine: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), initial_edge: ListMember(MachineState(thompson_state_count(inner)), Active(state, routine, Nil()), initial_machine_destinations(thompson_state_count(inner), thompson_machine(inner), position, input, after_input)), initial_execution: RoutineExecution(routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures), {final_evidence: List(Evidence)}, {final_captures: List(CaptureFrame)}, projection: RepeatActivePathProjection(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)) -> Equivalent(List(CaptureFrame), final_captures, record_capture_input(item_input_captures, input)) = match projection
    ProjectedRepeatFinalItem(child_final_evidence, child_final_captures, child_routine, child_path, child_captures_exact, combined_final_captures, captures_exact, _, _) ->
      let child_acceptance = active_acceptance_from_path(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, child_routine, initial_edge, initial_execution, child_path)
      let child_recorded = thompson_evidence_acceptance_captures_explicit(inner_shape, inner, inner_proof, input, after_input, position, item_input_evidence, item_input_captures, child_acceptance)
      capture_equivalent_transitive(combined_final_captures, child_final_captures, record_capture_input(item_input_captures, input), captures_exact, capture_equivalent_transitive(child_final_captures, acceptance_path_final_captures(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, item_input_evidence, item_input_captures, child_final_evidence, child_acceptance), record_capture_input(item_input_captures, input), child_captures_exact, child_recorded))
    ProjectedRepeatMoreItems(child_input, remaining_input, partition, child_final_evidence, child_final_captures, child_routine, child_path, child_captures_exact, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, projected_final_evidence, combined_final_captures, continuation) ->
      let original_filtered_edge = filtered_starts_from_initial_edge(thompson_state_count(inner), thompson_machine(inner), position, input, after_input, Active(state, routine, Nil()), initial_edge)
      let child_filtered_edge = transport_filtered_start_subject(thompson_state_count(inner), thompson_machine(inner), position, append_characters(input, after_input), append_characters(child_input, append_characters(remaining_input, after_input)), Active(state, routine, Nil()), partition_append_after(after_input, partition), original_filtered_edge)
      let child_initial_edge = initial_edge_from_filtered_starts(thompson_state_count(inner), thompson_machine(inner), position, child_input, append_characters(remaining_input, after_input), Active(state, routine, Nil()), child_filtered_edge)
      let child_acceptance = active_acceptance_from_path(thompson_state_count(inner), thompson_machine(inner), position, child_input, append_characters(remaining_input, after_input), item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, child_routine, child_initial_edge, initial_execution, child_path)
      let child_recorded = thompson_evidence_acceptance_captures_explicit(inner_shape, inner, inner_proof, child_input, append_characters(remaining_input, after_input), position, item_input_evidence, item_input_captures, child_acceptance)
      let child_final_recorded = capture_equivalent_transitive(child_final_captures, acceptance_path_final_captures(thompson_state_count(inner), thompson_machine(inner), position, child_input, append_characters(remaining_input, after_input), item_input_evidence, item_input_captures, child_final_evidence, child_acceptance), record_capture_input(item_input_captures, child_input), child_captures_exact, child_recorded)
      let continuation_recorded = thompson_repeat_projection_captures(inner_shape, inner, inner_proof, lazy, advance_initial_position(position, child_input), remaining_input, after_input, child_final_evidence, child_final_captures, next_state, next_routine, next_evidence, next_captures, next_edge, next_execution, continuation)
      let nested_recorded = capture_equivalent_transitive(combined_final_captures, record_capture_input(child_final_captures, remaining_input), record_capture_input(record_capture_input(item_input_captures, child_input), remaining_input), continuation_recorded, record_capture_input_congruent(child_final_captures, record_capture_input(item_input_captures, child_input), remaining_input, child_final_recorded))
      capture_equivalent_transitive(combined_final_captures, record_capture_input(record_capture_input(item_input_captures, child_input), remaining_input), record_capture_input(item_input_captures, input), nested_recorded, record_capture_partition(item_input_captures, partition))

  fn thompson_repeat_acceptance_captures(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(inner), repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(thompson_state_count(inner), repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = match project_repeat_acceptance_from_machine(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, input_evidence, input_captures, acceptance)
    ProjectedRepeatEmptyAcceptance(input_empty, _, _, combined_final_captures, captures_exact) -> match input_empty
      reflexive() -> captures_exact
    ProjectedRepeatItemsAcceptance(state, routine, list_evidence, list_captures, initial_evidence, initial_captures, initial_edge, initial_execution, projection, list_evidence_exact, list_captures_exact) -> match list_evidence_exact
      reflexive() -> match list_captures_exact
        reflexive() -> thompson_repeat_projection_captures(inner_shape, inner, inner_proof, lazy, position, input, after_input, Cons(BeginListEvidence(), input_evidence), input_captures, state, routine, initial_evidence, initial_captures, initial_edge, initial_execution, projection)

  fn thompson_evidence_acceptance_captures_explicit(@erased shape: ShapeCode, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = match proof
    ThompsonEvidenceEmpty() -> empty_acceptance_captures(input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceBoundary(constraint) -> boundary_acceptance_captures(constraint, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidencePredicate(test) -> predicate_acceptance_captures(test, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceConcat({left_shape = left_shape}, {right_shape = right_shape}, left, right, left_proof, right_proof) -> thompson_concat_acceptance_captures(left, right, left_proof, right_proof, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceGroup({inner_shape = inner_shape}, inner, inner_proof) -> thompson_group_acceptance_captures(inner, inner_proof, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceAlternate({left_shape = left_shape}, {right_shape = right_shape}, left, right, prefer_right, left_proof, right_proof) -> thompson_alternate_acceptance_captures(left, right, prefer_right, left_proof, right_proof, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceRepeat({inner_shape = inner_shape}, inner, lazy, inner_proof) -> thompson_repeat_acceptance_captures(inner_shape, inner, inner_proof, lazy, input, after_input, position, input_evidence, input_captures, acceptance)

  fn thompson_evidence_acceptance_captures({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Equivalent(List(CaptureFrame), acceptance_path_final_captures(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), record_capture_input(input_captures, input)) = thompson_evidence_acceptance_captures_explicit(shape, compilation, proof, input, after_input, position, input_evidence, input_captures, acceptance)

  fn thompson_evidence_acceptance_from_encodes_explicit(@erased shape: ShapeCode, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(shape, final_evidence, input_evidence) = match proof
    ThompsonEvidenceEmpty() -> empty_acceptance_path_from_encodes(input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceBoundary(constraint) -> boundary_acceptance_path_from_encodes(constraint, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidencePredicate(test) -> predicate_acceptance_path_from_encodes(test, input, after_input, position, input_evidence, input_captures, acceptance)
    ThompsonEvidenceConcat({left_shape = left_shape}, {right_shape = right_shape}, left, right, left_proof, right_proof) -> match execute_concat_acceptance_projection(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, project_concat_acceptance_from(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, acceptance))
      ProjectedExecutedConcatAcceptance(left_input, right_input, partition, left_final_evidence, left_final_captures, left_acceptance, _, right_final_evidence, right_final_captures, right_acceptance, right_execution, _, final_is_paired) -> match final_is_paired
        reflexive() -> EncodesPair(
          thompson_evidence_acceptance_from_encodes_explicit(right_shape, right, right_proof, right_input, after_input, advance_initial_position(position, left_input), left_final_evidence, left_final_captures, right_acceptance),
          thompson_evidence_acceptance_from_encodes_explicit(left_shape, left, left_proof, left_input, append_characters(right_input, after_input), position, input_evidence, input_captures, left_acceptance)
        )
    ThompsonEvidenceGroup({inner_shape = inner_shape}, inner, inner_proof) -> match project_group_acceptance_from(thompson_state_count(inner), pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner)), position, input, after_input, input_evidence, input_captures, acceptance)
      ProjectedGroupAcceptanceMissingFrame(child_final_evidence, projected_child, combined_final_captures, captures_exact, _, _) -> impossible_missing_group_capture(
          input_evidence,
          input_captures,
          input,
          group_child_supplied_captures(inner, inner_proof, position, input, after_input, input_evidence, Cons(CaptureFrame(empty_characters(), input_evidence), input_captures), child_final_evidence, empty_captures(), projected_child)
      )
      ProjectedGroupAcceptanceClosedFrame(child_final_evidence, chars, saved, outer, projected_child, combined_final_captures, captures_exact, _, projected_evidence_exact) -> match projected_evidence_exact
        reflexive() -> match recorded_open_capture_view(
            empty_characters(),
            input_evidence,
            input_captures,
            input,
            Cons(CaptureFrame(chars, saved), outer),
            group_child_supplied_captures(inner, inner_proof, position, input, after_input, input_evidence, Cons(CaptureFrame(empty_characters(), input_evidence), input_captures), child_final_evidence, Cons(CaptureFrame(chars, saved), outer), projected_child)
        )
          RecordedOpenCaptureExact() -> EncodesString(captured_string(evidence_reverse_chars_into(input, Nil())))
    ThompsonEvidenceAlternate({left_shape = left_shape}, {right_shape = right_shape}, left, right, prefer_right, left_proof, right_proof) -> match project_alternate_acceptance_from(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right, position, input, after_input, input_evidence, input_captures, acceptance)
      mk_pair(False(), ProjectedAlternateFromLeft(left_projection)) -> match execute_alternate_left_acceptance_projection(thompson_state_count(left), thompson_machine(left), position, input, after_input, input_evidence, input_captures, left_projection)
        ProjectedAlternateLeftExecutedAcceptance(child_final_evidence, child_final_captures, child_acceptance, child_execution, final_is_left) -> match final_is_left
          reflexive() -> EncodesLeft(thompson_evidence_acceptance_from_encodes_explicit(left_shape, left, left_proof, input, after_input, position, input_evidence, input_captures, child_acceptance))
      mk_pair(True(), ProjectedAlternateFromRight(right_projection)) -> match execute_alternate_right_acceptance_projection(thompson_state_count(right), thompson_machine(right), position, input, after_input, input_evidence, input_captures, right_projection)
        ProjectedAlternateRightExecutedAcceptance(child_final_evidence, child_final_captures, child_acceptance, child_execution, final_is_right) -> match final_is_right
          reflexive() -> EncodesRight(thompson_evidence_acceptance_from_encodes_explicit(right_shape, right, right_proof, input, after_input, position, input_evidence, input_captures, child_acceptance))
    ThompsonEvidenceRepeat({inner_shape = inner_shape}, inner, lazy, inner_proof) -> thompson_repeat_acceptance_from_encodes(inner_shape, inner, inner_proof, lazy, input, after_input, position, input_evidence, input_captures, acceptance)

  fn thompson_evidence_acceptance_from_encodes({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(shape, final_evidence, input_evidence) = thompson_evidence_acceptance_from_encodes_explicit(shape, compilation, proof, input, after_input, position, input_evidence, input_captures, acceptance)

  fn thompson_evidence_acceptance_encodes({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, {final_evidence: List(Evidence)}, acceptance: AcceptancePath(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, final_evidence)) -> Encodes(shape, final_evidence, empty_evidence()) = thompson_evidence_acceptance_from_encodes(compilation, proof, input, after_input, position, empty_evidence(), empty_captures(), acceptance)

  fn thompson_machine_acceptance_encodes_explicit(@erased shape: ShapeCode, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, acceptance: MachineAcceptance(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, final_evidence, routine)) -> Encodes(shape, final_evidence, empty_evidence()) = thompson_evidence_acceptance_encodes(compilation, proof, input, after_input, position, machine_acceptance_path(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, acceptance))

  fn thompson_machine_acceptance_encodes({shape: ShapeCode}, compilation: ThompsonCompilation(shape), proof: ThompsonEvidenceProof(shape, compilation), input: List(Char), after_input: List(Char), position: InitialPosition, {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, acceptance: MachineAcceptance(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, final_evidence, routine)) -> Encodes(shape, final_evidence, empty_evidence()) = thompson_machine_acceptance_encodes_explicit(shape, compilation, proof, input, after_input, position, acceptance)


  fn certify_thompson_evidence({@erased shape: ShapeCode}, pattern: Pattern(shape)) -> CertifiedThompsonCompilation(shape, certify_thompson(pattern)) = match pattern
    PatternPredicate(test) -> CertifiedThompson(ThompsonPredicate(test), ThompsonEvidencePredicate(test))
    PatternEmpty() -> CertifiedThompson(ThompsonEmpty(), ThompsonEvidenceEmpty())
    PatternBoundary(constraint) -> CertifiedThompson(ThompsonBoundary(constraint), ThompsonEvidenceBoundary(constraint))
    PatternConcat(left, right) -> match certify_thompson_evidence(left)
      CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
        CertifiedThompson(right_compilation, right_proof) -> CertifiedThompson(ThompsonConcat(left_compilation, right_compilation), ThompsonEvidenceConcat(left_compilation, right_compilation, left_proof, right_proof))
    PatternGroup(inner) -> match certify_thompson_evidence(inner)
      CertifiedThompson(inner_compilation, inner_proof) -> CertifiedThompson(ThompsonGroup(inner_compilation), ThompsonEvidenceGroup(inner_compilation, inner_proof))
    PatternAlternate(left, right) -> match certify_thompson_evidence(left)
      CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
        CertifiedThompson(right_compilation, right_proof) -> CertifiedThompson(ThompsonAlternate(left_compilation, right_compilation, false), ThompsonEvidenceAlternate(left_compilation, right_compilation, false, left_proof, right_proof))
    PatternAlternateMode(left, right, prefer_right) -> match certify_thompson_evidence(left)
      CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
        CertifiedThompson(right_compilation, right_proof) -> CertifiedThompson(ThompsonAlternate(left_compilation, right_compilation, prefer_right), ThompsonEvidenceAlternate(left_compilation, right_compilation, prefer_right, left_proof, right_proof))
    PatternRepeat(inner) -> match certify_thompson_evidence(inner)
      CertifiedThompson(inner_compilation, inner_proof) -> CertifiedThompson(ThompsonRepeat(inner_compilation, false), ThompsonEvidenceRepeat(inner_compilation, false, inner_proof))
    PatternRepeatMode(inner, lazy) -> match certify_thompson_evidence(inner)
      CertifiedThompson(inner_compilation, inner_proof) -> CertifiedThompson(ThompsonRepeat(inner_compilation, lazy), ThompsonEvidenceRepeat(inner_compilation, lazy, inner_proof))


  fn certified_alternate_acceptance_captures(
    {left_shape: ShapeCode},
    {right_shape: ShapeCode},
    left: Pattern(left_shape),
    right: Pattern(right_shape),
    prefer_right: Bool,
    input: List(Char),
    after_input: List(Char),
    position: InitialPosition,
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    {final_evidence: List(Evidence)},
    acceptance: AcceptancePathFrom(
      plus(thompson_state_count(certify_thompson(left)), thompson_state_count(certify_thompson(right))),
      alternate_pattern_machine(thompson_state_count(certify_thompson(left)), thompson_machine(certify_thompson(left)), thompson_state_count(certify_thompson(right)), thompson_machine(certify_thompson(right)), prefer_right),
      position,
      input,
      after_input,
      input_evidence,
      input_captures,
      final_evidence
    )
  ) -> Equivalent(
    List(CaptureFrame),
    acceptance_path_final_captures(
      plus(thompson_state_count(certify_thompson(left)), thompson_state_count(certify_thompson(right))),
      alternate_pattern_machine(thompson_state_count(certify_thompson(left)), thompson_machine(certify_thompson(left)), thompson_state_count(certify_thompson(right)), thompson_machine(certify_thompson(right)), prefer_right),
      position,
      input,
      after_input,
      input_evidence,
      input_captures,
      final_evidence,
      acceptance
    ),
    record_capture_input(input_captures, input)
  ) = match certify_thompson_evidence(left)
    CertifiedThompson(left_compilation, left_proof) -> match certify_thompson_evidence(right)
      CertifiedThompson(right_compilation, right_proof) -> thompson_alternate_acceptance_captures(left_compilation, right_compilation, prefer_right, left_proof, right_proof, input, after_input, position, input_evidence, input_captures, acceptance)

  fn parse_pattern_full_verified({shape: ShapeCode}, pattern: Pattern(shape), input: String) -> Option(Sem(shape)) = match certify_thompson_evidence(pattern)
    CertifiedThompson(compilation, proof) ->
      let characters = Std.String.characters(input)
      match search_machine_acceptance(thompson_state_count(compilation), thompson_machine(compilation), subject_initial_position(), characters, empty_characters())
        MachineNoAcceptingPath() -> None()
        MachineAcceptingPath(evidence, _, acceptance) -> Some(extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, characters, empty_characters(), subject_initial_position(), acceptance)))

  fn parse_program_full_verified({result: Type}, program: RegexProgram(result), input: String) -> Option(result) = match program
    BuiltRegex(_shape, pattern, conversion, hint) -> match hint
      NoCompilationHint() -> match parse_pattern_full_verified(pattern, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))
      StagedCompilationHint(StagedMachineValue(compilation)) -> match parse_compilation_full_verified(compilation, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))
      StagedCompilationHint(StagedAtomicPatternValue(plan)) -> match parse_atomic_plan_full_verified(plan, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))
      StagedCompilationHint(StagedLookaroundValue(pattern, compilation, policy)) -> match parse_lookaround_compilation_full_verified(pattern, compilation, policy, input)
        None() -> None()
        Some(value) -> Some(execute_conversion(conversion, value))

  fn parse_compilation_full_verified({shape: ShapeCode}, compilation: ThompsonCompilation(shape), input: String) -> Option(Sem(shape)) =
    let proof = proof_for_compilation(compilation)
    let characters = Std.String.characters(input)
    match search_machine_acceptance(thompson_state_count(compilation), thompson_machine(compilation), subject_initial_position(), characters, empty_characters())
      MachineNoAcceptingPath() -> None()
      MachineAcceptingPath(evidence, _, acceptance) -> Some(extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, characters, empty_characters(), subject_initial_position(), acceptance)))

  fn parse_atomic_plan_full_verified({shape: ShapeCode}, plan: AtomicRuntimePattern(shape), input: String) -> Option(Sem(shape)) =
    let machine = atomic_runtime_machine_from_plan(plan)
    let characters = Std.String.characters(input)
    pickup
      atomic_runtime_accepts(thompson_state_count(atomic_plan_compilation(plan)), machine, subject_initial_position(), characters, empty_characters()) -> parse_pattern_full_verified(atomic_plan_pattern(plan), input)
      else -> None()

  fn parse_atomic_plan_prefix_verified_at({shape: ShapeCode}, plan: AtomicRuntimePattern(shape), input: List(Char), greedy: Bool, position: InitialPosition) -> Option(Tuple(Sem(shape), List(Char))) =
    let machine = atomic_runtime_machine_from_plan(plan)
    match atomic_runtime_prefix(thompson_state_count(atomic_plan_compilation(plan)), machine, position, input, greedy)
      None() -> None()
      Some(%[matched, remaining]) -> match parse_pattern_full_verified(atomic_plan_pattern(plan), Std.String.from_characters(matched))
        None() -> None()
        Some(value) -> Some(%[value, remaining])

  ## The assertion gate consumes an erased indexed path, not a free Boolean.
  ## Its constructors name every filtered transition and the exact recursive
  ## suffix, so ordinary extraction is reachable only after a checked path
  ## through the depth-bounded assertion machine exists.
  fn parse_lookaround_compilation_full_verified({shape: ShapeCode}, pattern: Pattern(shape), compilation: LookaroundCompilation(shape), policy: NewlinePolicy, input: String) -> Option(Sem(shape)) =
    let characters = Std.String.characters(input)
    match atomic_lookaround_routine_initial(regex_assertion_depth_limit(), lookaround_state_count(compilation), lookaround_machine(compilation), characters, [], subject_initial_position(), [], [], policy, false, [])
      LookaroundRoutineSearchYes(_, [], _, _, _) -> parse_pattern_full_verified(pattern, input)
      LookaroundRoutineSearchYes(_, _, _, _, _) -> None()
      LookaroundRoutineSearchNo(_) -> None()
      LookaroundRoutineSearchCommit(_) -> None()

  fn parse_lookaround_compilation_prefix_verified_at({shape: ShapeCode}, pattern: Pattern(shape), compilation: LookaroundCompilation(shape), policy: NewlinePolicy, input: List(Char), greedy: Bool, position: InitialPosition, history: List(Char)) -> Option(Tuple(Sem(shape), List(Char))) =
    match atomic_lookaround_routine_prefix(regex_assertion_depth_limit(), lookaround_state_count(compilation), lookaround_machine(compilation), position, input, greedy, history, [], policy)
      None() -> None()
      Some(%[matched, remaining, _routine]) -> match parse_pattern_full_verified(pattern, Std.String.from_characters(matched))
        None() -> None()
        Some(value) -> Some(%[value, remaining])

  fn parse_pattern_prefix_verified_at({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char), greedy: Bool, position: InitialPosition) -> Option(Tuple(Sem(shape), List(Char))) = match certify_thompson_evidence(pattern)
    CertifiedThompson(compilation, proof) ->
      let result = pickup
        greedy -> search_last_machine_prefix(thompson_state_count(compilation), thompson_machine(compilation), position, input)
        else -> search_first_machine_prefix(thompson_state_count(compilation), thompson_machine(compilation), position, input)
      match result
        NoCertifiedPrefix() -> None()
        CertifiedPrefixPath(matched, remaining, evidence, _, acceptance) -> Some(%[extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, matched, remaining, position, acceptance)), remaining])

  fn parse_program_prefix_chars_verified_at({result: Type}, program: RegexProgram(result), input: List(Char), greedy: Bool, subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool) -> Option(Tuple(result, List(Char))) = match program
    BuiltRegex(_shape, pattern, conversion, hint) -> match hint
      NoCompilationHint() -> match parse_pattern_prefix_verified_at(pattern, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()))
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedMachineValue(compilation)) -> match parse_compilation_prefix_verified_at(compilation, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()))
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedAtomicPatternValue(plan)) -> match parse_atomic_plan_prefix_verified_at(plan, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()))
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedLookaroundValue(pattern, compilation, policy)) -> match parse_lookaround_compilation_prefix_verified_at(pattern, compilation, policy, input, greedy, InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None()), [])
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])

  fn parse_program_prefix_chars_verified_at_position({result: Type}, program: RegexProgram(result), input: List(Char), greedy: Bool, position: InitialPosition, history: List(Char)) -> Option(Tuple(result, List(Char))) = match program
    BuiltRegex(_shape, pattern, conversion, hint) -> match hint
      NoCompilationHint() -> match parse_pattern_prefix_verified_at(pattern, input, greedy, position)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedMachineValue(compilation)) -> match parse_compilation_prefix_verified_at(compilation, input, greedy, position)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedAtomicPatternValue(plan)) -> match parse_atomic_plan_prefix_verified_at(plan, input, greedy, position)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])
      StagedCompilationHint(StagedLookaroundValue(staged_pattern, compilation, policy)) -> match parse_lookaround_compilation_prefix_verified_at(staged_pattern, compilation, policy, input, greedy, position, history)
        None() -> None()
        Some(%[value, rest]) -> Some(%[execute_conversion(conversion, value), rest])

  fn parse_compilation_prefix_verified_at({shape: ShapeCode}, compilation: ThompsonCompilation(shape), input: List(Char), greedy: Bool, position: InitialPosition) -> Option(Tuple(Sem(shape), List(Char))) =
    let proof = proof_for_compilation(compilation)
    let machine = staged_machine_from_compilation(compilation)
    let result = pickup
      greedy -> transport_staged_prefix(compilation, position, search_last_machine_prefix(thompson_state_count(compilation), machine, position, input))
      else -> transport_staged_prefix(compilation, position, search_first_machine_prefix(thompson_state_count(compilation), machine, position, input))
    match result
      NoCertifiedPrefix() -> None()
      CertifiedPrefixPath(matched, remaining, evidence, _, acceptance) -> Some(%[extract_encoding(evidence, thompson_machine_acceptance_encodes(compilation, proof, matched, remaining, position, acceptance)), remaining])

  fn parse_program_prefix_verified_at({result: Type}, program: RegexProgram(result), input: String, greedy: Bool, subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool) -> Option(Tuple(result, String)) = match program
    BuiltRegex(_shape, _pattern, _conversion, _hint) -> match parse_program_prefix_chars_verified_at(program, Std.String.characters(input), greedy, subject_start, line_start, previous_ascii_word, previous_unicode_word)
      None() -> None()
      Some(%[value, rest]) -> Some(%[value, Std.String.from_characters(rest)])








  fn certified_pattern_acceptance_encodes(certified: CertifiedPatternMachine, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(certified_pattern_state_count(certified), certified_pattern_machine(certified), position, input, after_input, final_evidence, routine)) -> Encodes(certified_pattern_shape(certified), final_evidence, empty_evidence()) = match certified
    CertifiedEmptyMachine() -> empty_machine_arbitrary_acceptance_encodes(input, after_input, position, final_evidence, routine, acceptance)
    CertifiedBoundaryMachine(constraint) -> boundary_machine_arbitrary_acceptance_encodes(constraint, input, after_input, position, final_evidence, routine, acceptance)
    CertifiedPredicateMachine(test) -> predicate_machine_arbitrary_acceptance_encodes(test, input, after_input, position, final_evidence, routine, acceptance)








  fn grouped_predicate_active_impossible({a: Type}, test: Char -> Bool, char: Char, boundary: Boundary, {state: Bounded(S(Z()))}, {regular: List(EvidenceInstruction)}, {constraints: List(BoundaryConstraint)}, edge: ListMember(MachineState(S(Z())), Active(state, regular, constraints), machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, boundary))) -> a = with grouped_predicate_destinations_view(test, char, boundary)
    GroupedPredicateRejects() -> impossible_list_member(edge)
    GroupedPredicateAccepts() -> match edge
      ListMemberThere(prior) -> impossible_list_member(prior)



  fn grouped_predicate_accepted_encodes(test: Char -> Bool, char: Char, after_input: List(Char), {regular: List(EvidenceInstruction)}, {constraints: List(BoundaryConstraint)}, {destination_evidence: List(Evidence)}, {destination_captures: List(CaptureFrame)}, {suffix_routine: List(ExtendedInstruction)}, {final_evidence: List(Evidence)}, edge: ListMember(MachineState(S(Z())), Accepted(regular, constraints), machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), ThreadActive(First()), char, transition_boundary_before(char, Nil(), after_input))), execution: RoutineExecution(regular, Nil(), record_capture_char(Cons(CaptureFrame(Nil(), Nil()), Nil()), char), destination_evidence, destination_captures), suffix: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Nil(), after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = with grouped_predicate_destinations_view(test, char, transition_boundary_before(char, Nil(), after_input))
    GroupedPredicateRejects() -> impossible_list_member(edge)
    GroupedPredicateAccepts() -> match edge
      ListMemberHere() -> match execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineStep(_, after_end) -> match after_end
            RoutineDone() -> match suffix
              AcceptingNow() -> grouped_predicate_final_encodes(char)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn grouped_predicate_path_encodes(test: Char -> Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Cons(char, Nil()), after_input, ThreadActive(First()), Nil(), Cons(CaptureFrame(Nil(), Nil()), Nil()), final_evidence, routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> grouped_predicate_active_impossible(test, char, transition_boundary_before(char, Nil(), after_input), edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> grouped_predicate_accepted_encodes(test, char, after_input, edge, execution, suffix)

  fn grouped_predicate_initial_path_encodes(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, destination: MachineState(S(Z())), {initial_evidence: List(Evidence)}, {initial_captures: List(CaptureFrame)}, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), edge: ListMember(MachineState(S(Z())), destination, initial_machine_destinations(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, Cons(char, empty_characters()), after_input)), initial_execution: RoutineExecution(machine_state_routine(S(Z()), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Cons(char, Nil()), after_input, machine_state_thread(S(Z()), destination), initial_evidence, initial_captures, final_evidence, routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = match grouped_predicate_starts_view(test, position, Cons(char, empty_characters()), after_input)
    GroupedPredicateStartsExact() -> match edge
      ListMemberHere() -> match grouped_predicate_initial_view(initial_execution)
        GroupedPredicateInitialExact() -> grouped_predicate_path_encodes(test, char, after_input, final_evidence, routine, path)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn grouped_predicate_machine_acceptance_encodes(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), position, Cons(char, empty_characters()), after_input, final_evidence, routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> grouped_predicate_initial_path_encodes(test, char, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)

  fn predicate_concat_right_execution_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), @erased final_evidence: List(Evidence), execution: RoutineExecution(Cons(EmitChar(right_char), Cons(EmitPair(), Nil())), Cons(CharacterEvidence(left_char), empty_evidence()), record_capture_char(Nil(), right_char), destination_evidence, destination_captures), suffix: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), empty_characters(), after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match execution
    RoutineStep(_, after_right) -> match after_right
      RoutineStep(_, after_pair) -> match after_pair
        RoutineDone() -> match suffix
          AcceptingNow() -> encodes_character_pair(left_char, right_char)



  fn impossible_predicate_concat_first_accepted(left: Char -> Bool, right: Char -> Bool, char: Char, boundary: Boundary, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {result: Type}, edge: ListMember(MachineState(plus(S(Z()), S(Z()))), Accepted(regular, constraints), machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), predicate_concat_start_thread(), char, boundary))) -> result = match predicate_concat_first_view(left, right, char, boundary)
    PredicateConcatFirstRejects() -> impossible_concat_accepted_tail(regular, constraints, edge)
    PredicateConcatFirstAccepts() -> match edge
      ListMemberThere(prior) -> impossible_concat_accepted_tail(regular, constraints, prior)



  fn predicate_concat_right_path_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), Cons(right_char, empty_characters()), after_input, predicate_concat_middle_thread(), Cons(CharacterEvidence(left_char), empty_evidence()), Nil(), final_evidence, routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_concat_second_view(left, right, right_char, transition_boundary_before(right_char, empty_characters(), after_input))
      PredicateConcatSecondRejects() -> impossible_list_member(edge)
      PredicateConcatSecondAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(regular, constraints, _, _, _, edge, execution, suffix) -> match predicate_concat_second_view(left, right, right_char, transition_boundary_before(right_char, empty_characters(), after_input))
      PredicateConcatSecondRejects() -> impossible_list_member(edge)
      PredicateConcatSecondAccepts() -> match predicate_concat_accepted_edge_view(right_char, regular, constraints, edge)
        PredicateConcatAcceptedEdgeExact() -> match execution
          RoutineStep(_, after_right) -> match after_right
            RoutineStep(_, after_pair) -> match after_pair
              RoutineDone() -> match suffix
                AcceptingNow() -> encodes_character_pair(left_char, right_char)

  fn predicate_concat_start_path_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), Cons(left_char, Cons(right_char, empty_characters())), after_input, predicate_concat_start_thread(), Nil(), Nil(), final_evidence, routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(first_destination, first_regular, first_constraints, _, _, first_suffix_routine, first_edge, first_execution, first_suffix) -> match predicate_concat_first_view(left, right, left_char, transition_boundary_before(left_char, Cons(right_char, empty_characters()), after_input))
      PredicateConcatFirstRejects() -> impossible_list_member(first_edge)
      PredicateConcatFirstAccepts() -> match predicate_concat_active_edge_view(left_char, first_destination, first_regular, first_constraints, first_edge)
        PredicateConcatActiveEdgeExact() -> match first_execution
          RoutineStep(_, after_left) -> match after_left
            RoutineDone() -> predicate_concat_right_path_encodes(left, right, left_char, right_char, after_input, final_evidence, first_suffix_routine, first_suffix)
    AcceptingNextAccepted(regular, constraints, _, _, _, first_edge, _, _) -> impossible_predicate_concat_first_accepted(left, right, left_char, transition_boundary_before(left_char, Cons(right_char, empty_characters()), after_input), regular, constraints, first_edge)

  ## The first compositional Thompson case. Reverse the two-state concatenation
  ## path transition-by-transition, recovering the left and right predicate
  ## paths and the final EmitPair marker from the only possible memberships.
  fn predicate_concat_machine_acceptance_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), position, Cons(left_char, Cons(right_char, empty_characters())), after_input, final_evidence, routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, _, _, _, initial_edge, initial_execution, _, path) -> match predicate_concat_initial_destination_view(left, right, position, Cons(left_char, Cons(right_char, empty_characters())), after_input, destination, initial_edge)
      PredicateConcatInitialDestinationExact() -> match initial_execution
        RoutineDone() -> predicate_concat_start_path_encodes(left, right, left_char, right_char, after_input, final_evidence, routine, path)









  fn predicate_alternate_starts_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char)) -> PredicateAlternateStartsView(prefer_right, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, input, after_input)) = match prefer_right
    False() -> PredicateAlternateStartsLeftFirst()
    True() -> PredicateAlternateStartsRightFirst()

  fn predicate_alternate_initial_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(S(Z()), S(Z()))), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, input, after_input))) -> PredicateAlternateInitialView(prefer_right, destination) = match predicate_alternate_starts_view(left, right, prefer_right, position, input, after_input)
    PredicateAlternateStartsLeftFirst() -> match edge
      ListMemberHere() -> PredicateAlternateInitialLeft()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateAlternateInitialRight()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
    PredicateAlternateStartsRightFirst() -> match edge
      ListMemberHere() -> PredicateAlternateInitialRight()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateAlternateInitialLeft()
        ListMemberThere(impossible) -> impossible_list_member(impossible)



  fn predicate_alternate_left_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, ThreadActive(First()), Nil(), Nil(), final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_alternate_left_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateLeftRejects() -> impossible_list_member(edge)
      PredicateAlternateLeftAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_alternate_left_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateLeftRejects() -> impossible_list_member(edge)
      PredicateAlternateLeftAccepts() -> match edge
        ListMemberHere() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineStep(_, after_marker) -> match after_marker
              RoutineDone() -> match suffix
                AcceptingNow() -> EncodesLeft(encodes_character_empty(char))
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_alternate_right_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, ThreadActive(Next(First())), Nil(), Nil(), final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_alternate_right_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateRightRejects() -> impossible_list_member(edge)
      PredicateAlternateRightAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> match predicate_alternate_right_destinations_view(left, right, prefer_right, char, transition_boundary_before(char, Nil(), after_input))
      PredicateAlternateRightRejects() -> impossible_list_member(edge)
      PredicateAlternateRightAccepts() -> match edge
        ListMemberHere() -> match execution
          RoutineStep(_, after_char) -> match after_char
            RoutineStep(_, after_marker) -> match after_marker
              RoutineDone() -> match suffix
                AcceptingNow() -> EncodesRight(encodes_character_empty(char))
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_alternate_initial_path_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), position: InitialPosition, destination: MachineState(plus(S(Z()), S(Z()))), {initial_evidence: List(Evidence)}, {initial_captures: List(CaptureFrame)}, @erased final_evidence: List(Evidence), @erased path_routine: List(ExtendedInstruction), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, Cons(char, Nil()), after_input)), initial_execution: RoutineExecution(machine_state_routine(plus(S(Z()), S(Z())), destination), Nil(), Nil(), initial_evidence, initial_captures), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), Cons(char, Nil()), after_input, machine_state_thread(plus(S(Z()), S(Z())), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match predicate_alternate_initial_view(left, right, prefer_right, position, Cons(char, Nil()), after_input, destination, edge)
    PredicateAlternateInitialLeft() -> match initial_execution
      RoutineDone() -> predicate_alternate_left_path_encodes(left, right, prefer_right, char, after_input, final_evidence, path_routine, path)
    PredicateAlternateInitialRight() -> match initial_execution
      RoutineDone() -> predicate_alternate_right_path_encodes(left, right, prefer_right, char, after_input, final_evidence, path_routine, path)

  fn predicate_alternate_mode_machine_acceptance_encodes(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, Cons(char, Nil()), after_input, final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> predicate_alternate_initial_path_encodes(left, right, prefer_right, char, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)

  fn predicate_alternate_machine_acceptance_encodes(left: Char -> Bool, right: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(plus(S(Z()), S(Z())), predicate_alternate_machine(left, right), position, Cons(char, Nil()), after_input, final_evidence, routine)) -> Encodes(ChoiceC(CharC, CharC), final_evidence, empty_evidence()) = predicate_alternate_mode_machine_acceptance_encodes(left, right, false, char, after_input, position, final_evidence, routine, acceptance)

  fn predicate_path_routine_view(test: Char -> Bool, char: Char, after_input: List(Char), {path_evidence: List(Evidence)}, {path_captures: List(CaptureFrame)}, {path_final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), path_evidence, path_captures, path_final_evidence, routine)) -> PredicateRoutineView(char, routine) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, suffix) -> match predicate_destinations_view(test, char, transition_boundary_before(char, [], after_input))
      PredicateRejects() -> impossible_list_member(edge)
      PredicateAccepts() -> match edge
        ListMemberHere() -> match suffix
          AcceptingNow() -> PredicateRoutineExact()
        ListMemberThere(prior) -> impossible_list_member(prior)
