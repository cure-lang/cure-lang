  fn thompson_repeat_projection_encodes_many(@erased inner_shape: ShapeCode, inner: ThompsonCompilation(inner_shape), inner_proof: ThompsonEvidenceProof(inner_shape, inner), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), item_input_evidence: List(Evidence), item_input_captures: List(CaptureFrame), state: Bounded(thompson_state_count(inner)), routine: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), initial_edge: ListMember(MachineState(thompson_state_count(inner)), Active(state, routine, Nil()), initial_machine_destinations(thompson_state_count(inner), thompson_machine(inner), position, input, after_input)), initial_execution: RoutineExecution(routine, item_input_evidence, item_input_captures, initial_evidence, initial_captures), @erased base_evidence: List(Evidence), @erased prior: EncodesMany(inner_shape, item_input_evidence, base_evidence), @erased final_evidence: List(Evidence), {final_captures: List(CaptureFrame)}, projection: RepeatActivePathProjection(thompson_state_count(inner), thompson_machine(inner), lazy, position, input, after_input, state, initial_evidence, initial_captures, final_evidence, final_captures)) -> Encodes(ListC(inner_shape), final_evidence, base_evidence) = match projection
    ProjectedRepeatFinalItem(child_final_evidence, child_final_captures, child_routine, child_path, _, _, _, projected_final_evidence, final_is_closed) -> thompson_repeat_final_projection_encodes_many(inner_shape, inner, inner_proof, position, input, after_input, item_input_evidence, item_input_captures, state, routine, initial_evidence, initial_captures, initial_edge, initial_execution, base_evidence, prior, child_final_evidence, child_final_captures, child_routine, child_path, projected_final_evidence, final_is_closed)
