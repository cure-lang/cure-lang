  type NamedMatch(result: Type) = NamedMatch(Match(result), List(NamedCapture))

  ## The public result type and the checked Thompson shape are independent:
  ## conversions may expose `Option`, `List`, or a simplified tuple while the
  ## machine still carries its constructor-preserving shape.  Keep the machine
  ## shape as an explicit index instead of letting it unify accidentally with
  ## the public result (which would reject optional/one-or-more captures).
  type NamedRegex(result: Type) indices (shape: ShapeCode)
    NamedRegex : Regex(result) -> NamedThompsonCompilation(shape) -> LookaroundCompilation(shape) -> CaptureLayout -> Bool -> NewlinePolicy -> NamedRegex(result, shape)
end
