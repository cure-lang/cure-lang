  fn atomic_path_recursive_commit_after_root_destinations_exhausted_same_excludes_selected_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
