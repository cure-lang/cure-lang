  fn lookaround_prefix_path_now(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundPrefixPathResult(depth, n, machine, input, after_input, ThreadAccepted(), history, policy, capture_context) =
    let path: LookaroundPrefixPath(depth, n, machine, capture_context, empty_machine_states(n), input, after_input, ThreadAccepted(), history, policy) = LookaroundPrefixAccepted()
    LookaroundPrefixPathFoundAccepted(path)

  fn lookaround_prefix_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundPrefixPathResult(depth, n, machine, input, after_input, state, history, policy, capture_context) = match state
    ThreadAccepted() -> lookaround_prefix_path_now(depth, n, machine, input, after_input, history, capture_context, policy)
    ThreadActive(source) -> match input
      [] ->
        let cursor: MachineStateCursor(n, empty_machine_states(n), empty_machine_states(n)) = MachineStateCursorHere()
        LookaroundPrefixPathRejectedEmpty(source, cursor, lookaround_prefix_path_exhausted(depth, n, machine, after_input, source, history, capture_context, policy, empty_machine_states(n), MachineStateMembersNil(), cursor, reflexive(empty_machine_states(n))))
      [char | rest] -> match lookaround_prefix_members_path(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, machine_state_members(lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), MachineStateCursorHere())
        LookaroundPrefixMembersRejected(_, failure, cursor) -> LookaroundPrefixPathRejectedStep(source, char, rest, cursor, failure)
        LookaroundPrefixMembersFound(cursor_suffix, path) -> LookaroundPrefixPathFoundActive(source, char, rest, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), reflexive(lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), cursor_suffix, path)

  fn lookaround_prefix_step_active(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, destination: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(destination, routine, constraints), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), {values: List(MachineState(n))}, members: MachineStateMembers(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Active(destination, routine, constraints), values)), cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Active(destination, routine, constraints), values)), child_char: Char, child_rest: List(Char), @erased child_input_equivalent: Equivalent(List(Char), rest, Cons(child_char, child_rest)), @erased child_destinations: List(MachineState(n)), @erased child_destinations_equivalent: Equivalent(List(MachineState(n)), child_destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy)), {@erased child_candidates: List(MachineState(n))}, child_cursor_suffix: MachineStateCursorSuffix(n, child_destinations, child_candidates), suffix: LookaroundPrefixPath(depth, n, machine, append_routine(capture_context, routine), child_candidates, Cons(child_char, child_rest), after_input, ThreadActive(destination), history_push_bounded(history, char), policy)) -> LookaroundPrefixPath(depth, n, machine, capture_context, Cons(Active(destination, routine, constraints), values), Cons(char, rest), after_input, ThreadActive(source), history, policy) = assert_type LookaroundPrefixNextActive(source, char, rest, destination, routine, constraints, lookaround_nested_decisions(depth, constraints, lookaround_transition_boundary(char, rest, after_input, policy), append_characters(rest, after_input), history, capture_context, policy), members, cursor, reflexive(Cons(Active(destination, routine, constraints), values)), machine_state_members_active_current_edge(destination, routine, constraints, members), child_char, child_rest, child_input_equivalent, child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix) : LookaroundPrefixPath(depth, n, machine, capture_context, Cons(Active(destination, routine, constraints), values), Cons(char, rest), after_input, ThreadActive(source), history, policy)

  fn lookaround_prefix_step_accepted(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Accepted(routine, constraints), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), {values: List(MachineState(n))}, members: MachineStateMembers(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Accepted(routine, constraints), values)), cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Accepted(routine, constraints), values)), child_cursor_suffix: MachineStateCursorSuffix(n, Nil(), Nil()), suffix: LookaroundPrefixPath(depth, n, machine, append_routine(capture_context, routine), Nil(), rest, after_input, ThreadAccepted(), history_push_bounded(history, char), policy)) -> LookaroundPrefixPath(depth, n, machine, capture_context, Cons(Accepted(routine, constraints), values), Cons(char, rest), after_input, ThreadActive(source), history, policy) = assert_type LookaroundPrefixNextAccepted(source, char, rest, routine, constraints, lookaround_nested_decisions(depth, constraints, lookaround_transition_boundary(char, rest, after_input, policy), append_characters(rest, after_input), history, capture_context, policy), members, cursor, reflexive(Cons(Accepted(routine, constraints), values)), machine_state_members_accepted_current_edge(routine, constraints, members), child_cursor_suffix, suffix) : LookaroundPrefixPath(depth, n, machine, capture_context, Cons(Accepted(routine, constraints), values), Cons(char, rest), after_input, ThreadActive(sou