  @reducible
  fn atomic_path_commit_cause_dispatch(
    {context_type: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    kind: AtomicPathCommitCauseKind,
    @erased cause: AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind),
    context: context_type,
    after_failure_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), context_type) -> Empty,
    from_child_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), context_type) -> Empty,
    past_escaped_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), context_type) -> Empty,
    past_rejected_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), context_type) -> Empty
  ) -> Empty = match kind
    AtomicPathCommitAfterFailureKind(_, _) -> after_failure_case(AtomicPathCommitCausePacked(cause), context)
    AtomicPathCommitFromChildKind(_) -> from_child_case(AtomicPathCommitCausePacked(cause), context)
    AtomicPathCommitPastEscapedKind(_, _) -> past_escaped_case(AtomicPathCommitCausePacked(cause), context)
    AtomicPathCommitPastRejectedKind(_, _, _) -> past_rejected_case(AtomicPathCommitCausePacked(cause), context)



