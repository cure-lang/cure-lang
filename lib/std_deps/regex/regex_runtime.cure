  fn atomic_lookaround_routine_initial(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), position: InitialPosition, history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix) =
    let starts = lookaround_admitted_starts(depth, n, machine, position, input, after_input, history, capture_context, policy)
    atomic_lookaround_routine_initial_members(depth, n, machine, input, after_input, position, history, capture_context, policy, None(), starts, starts, LookaroundAdmittedStateCursorHere(), LookaroundAdmittedStateCursorWitnessHere(), reflexive(starts), prefix_mode, reversed_prefix)

  fn atomic_lookaround_routine_initial_tail_after_failure(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), position: InitialPosition, history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), candidate: LookaroundAdmittedState(n), child_capture_context: List(EvidenceInstruction), child_scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), @erased child_whole: List(LookaroundAdmittedState(n)), @erased child_current: List(LookaroundAdmittedState(n)), @erased child_witness: LookaroundAdmittedStateCursorWitness(n, child_whole, child_current), @erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(candidate, remaining)), @erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(candidate, remaining)), @erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_admitted_starts(depth, n, machine, position, input, after_input, history, capture_context, policy)), @erased child_failure: AtomicPathRefutation(depth, n, machine, input, after_input, lookaround_admitted_state_thread(candidate), history, lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, reversed_prefix, child_whole, child_current)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix) = match atomic_lookaround_routine_initial_members(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedStateCursorDrop(candidate, cursor), LookaroundAdmittedStateCursorWitnessDrop(candidate, witness), canonical, prefix_mode, reversed_prefix)
    LookaroundRoutineSearchNo(tail_failure) -> LookaroundRoutineSearchNo(AtomicStartCandidateRejected(candidate, cursor, member_here(candidate, remaining), canonical, child_scope_depth, child_current, child_failure, tail_failure))
    LookaroundRoutineSearchCommit(commit_depth) -> LookaroundRoutineSearchCommit(commit_depth)
    LookaroundRoutineSearchYes(matched, remaining_input, routine, trace) -> LookaroundRoutineSearchYes(matched, remaining_input, routine, trace)

  fn atomic_lookaround_routine_initial_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), position: InitialPosition, history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), whole: List(LookaroundAdmittedState(n)), starts: List(LookaroundAdmittedState(n)), @erased cursor: LookaroundAdmittedStateCursor(n, whole, starts), @erased witness: LookaroundAdmittedStateCursorWitness(n, whole, starts), @erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_admitted_starts(depth, n, machine, position, input, after_input, history, capture_context, policy)), prefix_mode: Bool, reversed_prefix: List(Char)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix) = match starts
    [] -> LookaroundRoutineSearchNo(AtomicStartExhausted())
    [LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) | remaining] -> pickup
      atomic_lookaround_start_blocked(n, Active(state, routine, constraints), blocked_depth) -> atomic_lookaround_routine_initial_members(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedStateCursorDrop(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), cursor), LookaroundAdmittedStateCursorWitnessDrop(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), witness), canonical, prefix_mode, reversed_prefix)
      else ->
        let next_capture_context = append_routine(append_routine(capture_context, routine), assertion_markers)
        match atomic_lookaround_routine_accepting_from(depth, n, machine, input, after_input, ThreadActive(state), history, next_capture_context, policy, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix)
          AtomicPathSearchYes(matched, remaining_input, suffix, selected_whole, selected_current, selection_suffix, selected_origin, selected_origin_equivalence, trace) -> LookaroundRoutineSearchYes(matched, remaining_input, append_extended_routines(regular_routine(routine), append_extended_routines(assertion_routine, suffix)), AtomicSelectedStartActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, cursor, member_here(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), canonical, selection_suffix, selected_origin_equivalence, trace))
          AtomicPathSearchCommit(commit_depth) -> atomic_lookaround_routine_initial_members(depth, n, machine, input, after_input, position, history, capture_context, policy, Some(commit_depth), whole, remaining, LookaroundAdmittedStateCursorDrop(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), cursor), LookaroundAdmittedStateCursorWitnessDrop(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), witness), canonical, prefix_mode, reversed_prefix)
          AtomicPathSearchRootActiveNo(_, AtomicPathRootRefutation(child_failure)) -> atomic_lookaround_routine_initial_tail_after_failure(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), next_capture_context, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n), empty_lookaround_admitted_cursor_witness(n), cursor, witness, canonical, child_failure)
          AtomicPathSearchRootNo(child_whole, AtomicPathRootRefutation(child_failure)) -> atomic_lookaround_routine_initial_tail_after_failure(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), next_capture_context, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, child_whole, child_whole, LookaroundAdmittedStateCursorWitnessHere(), cursor, witness, canonical, child_failure)
          AtomicPathSearchNo(child_whole, child_current, child_witness, child_failure) -> atomic_lookaround_routine_initial_tail_after_failure(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), next_capture_context, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, child_whole, child_current, child_witness, cursor, witness, canonical, child_failure)
    [LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions) | remaining] -> pickup
      atomic_lookaround_start_blocked(n, Accepted(routine, constraints), blocked_depth) -> atomic_lookaround_routine_initial_members(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedStateCursorDrop(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), cursor), LookaroundAdmittedStateCursorWitnessDrop(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), witness), canonical, prefix_mode, reversed_prefix)
      else ->
        let next_capture_context = append_routine(append_routine(capture_context, routine), assertion_markers)
        match atomic_lookaround_routine_accepting_from(depth, n, machine, input, after_input, ThreadAccepted(), history, next_capture_context, policy, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix)
          AtomicPathSearchYes(matched, remaining_input, suffix, selected_whole, selected_current, selection_suffix, selected_origin, selected_origin_equivalence, trace) -> LookaroundRoutineSearchYes(matched, remaining_input, append_extended_routines(regular_routine(routine), append_extended_routines(assertion_routine, suffix)), AtomicSelectedStartAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions, cursor, member_here(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), canonical, selection_suffix, selected_origin_equivalence, trace))
          AtomicPathSearchCommit(commit_depth) -> atomic_lookaround_routine_initial_members(depth, n, machine, input, after_input, position, history, capture_context, policy, Some(commit_depth), whole, remaining, LookaroundAdmittedStateCursorDrop(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), cursor), LookaroundAdmittedStateCursorWitnessDrop(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), witness), canonical, prefix_mode, reversed_prefix)
          AtomicPathSearchRootExactNo(AtomicPathRootRefutation(child_failure)) -> atomic_lookaround_routine_initial_tail_after_failure(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), next_capture_context, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n), empty_lookaround_admitted_cursor_witness(n), cursor, witness, canonical, child_failure)
          AtomicPathSearchRootNo(child_whole, AtomicPathRootRefutation(child_failure)) -> atomic_lookaround_routine_initial_tail_after_failure(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), next_capture_context, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, child_whole, child_whole, LookaroundAdmittedStateCursorWitnessHere(), cursor, witness, canonical, child_failure)
          AtomicPathSearchNo(child_whole, child_current, child_witness, child_failure) -> atomic_lookaround_routine_initial_tail_after_failure(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, remaining, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), next_capture_context, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, child_whole, child_current, child_witness, cursor, witness, canonical, child_failure)

  fn atomic_lookaround_start_blocked(n: Nat, state: MachineState(n), blocked_depth: Option(Nat)) -> Bool = match blocked_depth
    None() -> false
    Some(commit_depth) -> match atomic_commit_disposition(atomic_scope_max_depth(machine_state_routine(n, state), Z()), commit_depth)
      AtomicCommitBlocks(_) -> true
      AtomicCommitEscapes(_) -> false

  fn atomic_scope_depth_after(routine: List(EvidenceInstruction), depth: Nat) -> Nat = match atomic_scope_effect(routine, depth)
    AtomicScopeEffect(next_depth, _) -> next_depth

  ## An active atomic path cannot exist at an exhausted input.  The selected
  ## trace has only terminal constructors at an empty input, and both terminal
  ## constructors require `ThreadAccepted`; eliminating that indexed mismatch
  ## is the first machine-denotation refutation lemma for the atomic tree.
  fn atomic_path_input_exhaustion_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {candidate_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible

  ## Base case for destination rejection: when an active candidate is rejected
  ## at the first character, its child refutation is indexed at exhausted
  ## input, while a selected trace at that same candidate must expose an active
  ## child suffix.  The two indices are disjoint.  This is the first concrete
  ## destination-rejection slice; the general tail/child induction remains
  ## parameterized by the corresponding candidate-suffix alignment.
  fn atomic_path_destination_rejection_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), destination: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {remaining: List(LookaroundAdmittedState(n))}, @erased child_current: List(LookaroundAdmittedState(n)), @erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), Nil(), child_current), {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, source_state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match path
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, suffix) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, destination, history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, [char | reversed_prefix], suffix)
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible

  ## When the rejected child is itself exhausted, the selected child suffix is
  ## forced to start at the same empty cursor. This is the first explicit
  ## child-alignment eliminator; recursive child and sibling-tail alignment
  ## remain separate proof slices.
  fn atomic_path_destination_rejection_excludes_aligned_child({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), destination: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {remaining: List(LookaroundAdmittedState(n))}, {child_current: List(LookaroundAdmittedState(n))}, @erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), Nil(), child_current), @erased child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, empty_lookaround_admitted_states(n), child_current), {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, source_state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match child_failure
    AtomicPathInputExhausted(_) -> match child_selection_suffix
      LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
        reflexive() -> match path
          AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, suffix) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, destination, history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, [char | reversed_prefix], suffix)
          AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible
      LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## An accepted destination cannot be rejected at exhausted child input. The
  ## child refutation is indexed at `ThreadAccepted()` and `Nil()` input, while
  ## `AtomicPathInputExhausted` is active-only; no child refutation exists, so
  ## this branch is discharged before selected-trace inspection.
  fn atomic_path_accepted_destination_rejection_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {remaining: List(LookaroundAdmittedState(n))}, @erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, atomic_scope_depth_after(routine, scope_depth), False(), Cons(char, reversed_prefix), Nil(), Nil()), {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased _path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, source_state, history, capture_context, policy, scope_depth, False(), reversed_prefix, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match child_failure
    AtomicPathInputExhausted(_) -> impossible

  ## An accepted candidate with remaining child input cannot be part of a
  ## selected transition when its child refutation is the exact terminal
  ## rejection.  The outer transition carries the child selected trace, so
  ## this branch consumes that suffix directly instead of treating the child
  ## failure as an unrelated erased flag.
  fn atomic_path_accepted_destination_rejection_excludes_aligned_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {remaining: List(LookaroundAdmittedState(n))}, @erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, atomic_scope_depth_after(routine, scope_depth), False(), Cons(char, reversed_prefix), Nil(), Nil()), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, source_state, history, capture_context, policy, scope_depth, False(), reversed_prefix, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match child_failure
    AtomicPathExactAcceptedWithInput(child_char, child_rest, _) -> match path
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, suffix) -> atomic_path_exact_failure_excludes_trace(machine, child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), Cons(char, reversed_prefix), child_failure, suffix)

  ## The first refutation-tree eliminator is indexed at the same exhausted
  ## input as the selected trace.  The other failure constructors all carry a
  ## non-empty input or an accepted thread, so dependent matching reduces this
  ## wrapper to the empty-input lemma above without a runtime case split.
  fn atomic_path_failure_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, {whole: List(LookaroundAdmittedState(n))}, current: List(LookaroundAdmittedState(n)), @erased failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current), @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), matched, remaining_input, routine)) -> result = match failure
    AtomicPathInputExhausted(_) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path)

  ## Consume the first non-empty destination-exhaustion branch of the atomic
  ## refutation tree.  The failure cursor is indexed at `Nil()`, so the only
  ## admissible selected-path suffix is `Here`; a `Drop` witness would require
  ## a head in an empty list.  After that equality is consumed, the path-level
  ## contradiction is discharged by the active destination-exhaustion lemma.
  fn atomic_path_failure_excludes_aligned_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil()), {candidate_current: List(LookaroundAdmittedState(n))}, matched: List(Char), remaining_input: List(Char), routine: List(ExtendedInstruction), @erased candidate_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), candidate_current), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathDestinationsExhausted(_, _, _, _, _) -> match candidate_suffix
      LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
        reflexive() -> atomic_path_active_destinations_exhausted_excludes_trace(machine, char, rest, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, matched, remaining_input, routine, failure, path)
      LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## A rejected candidate may leave a sibling tail whose search reaches the
  ## destination-exhaustion leaf.  When the selected trace is already aligned
  ## to that tail's empty cursor, the existing exhaustion contradiction can be
  ## consumed directly through the parent rejection node.  This is the first
  ## tail-induction slice; rejected-child alignment remains a separate branch.
  fn atomic_path_tail_destinations_exhausted_excludes_aligned_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), candidate: LookaroundAdmittedState(n), @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, Nil())), {candidate_current: List(LookaroundAdmittedState(n))}, matched: List(Char), remaining_input: List(Char), routine: List(ExtendedInstruction), @erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), candidate_current), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathInputExhausted(_) -> impossible
    AtomicPathExactAcceptedWithInput(_, _, _) -> impossible
    AtomicPathDestinationsExhausted(_, _, _, _, _) -> impossible
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, tail_failure) -> match tail_failure
      AtomicPathDestinationsExhausted(_, _, _, _, _) -> atomic_path_failure_excludes_aligned_trace(machine, char, rest, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_failure, matched, remaining_input, routine, tail_suffix, path)

  ## The active root wrapper has no suffix-local alternative: its empty-input
  ## index eliminates every refutation constructor except
  ## `AtomicPathInputExhausted`. This is the first theorem consumer that uses
  ## the root/partial split directly.
  fn atomic_path_root_active_failure_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {candidate_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil()), @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathRootRefutation(_) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path)

  ## Exact acceptance rejects unconsumed input. All selected transitions are
  ## indexed at an active source thread; the exact root refutation is indexed
  ## at `ThreadAccepted`, so only the terminal empty-input constructors could
  ## match, and their input index is non-empty here.
  fn atomic_path_root_exact_failure_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char), {candidate_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased failure: AtomicPathRootRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil()), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathRootRefutation(_) -> match path
      AtomicSelectedPrefixDone() -> impossible
      AtomicSelectedExactDone() -> impossible
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## An exact child cannot have an accepting selected trace when input remains.
  ## After the refutation constructors are state-indexed, the accepted-source
  ## branch has only `AtomicPathExactAcceptedWithInput`; all selected terminal
  ## and transition constructors are excluded by their input, polarity, or
  ## active-source indices.
  fn atomic_path_exact_failure_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), @erased char: Char, @erased rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char), {candidate_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), Nil()), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathExactAcceptedWithInput(_, _, _) -> match path
      AtomicSelectedPrefixDone() -> impossible
      AtomicSelectedExactDone() -> impossible
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## Destination exhaustion has an independent cursor base case.  Once the
  ## failure cursor is indexed at `Nil()`, a selected transition would require
  ## a suffix beginning at a non-empty admitted candidate list; the suffix
  ## relation eliminates both that fabricated `Here` equality and any `Drop`
  ## spine whose outer list is already empty.
  fn atomic_path_destinations_exhausted_excludes_trace({n: Nat}, {candidate: LookaroundAdmittedState(n)}, {remaining: List(LookaroundAdmittedState(n))}, @erased suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), Cons(candidate, remaining))) -> Empty = match suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> impossible
    LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## An active source cannot produce a selected transition after its admitted
  ## destination cursor is exhausted. The non-empty input index excludes both
  ## terminal constructors, while the empty candidate-current index excludes
  ## both transition constructors. This consumes the destination-exhaustion
  ## leaf at the construction site's active-state boundary.
  fn atomic_path_active_destinations_exhausted_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), routine: List(ExtendedInstruction), @erased _failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil()), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), matched, remaining_input, routine)) -> result = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible


  fn atomic_lookaround_routine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(List(ExtendedInstruction)) = match machine
    MkPatternMachine(_, _) -> match atomic_lookaround_routine_initial(depth, n, machine, input, after_input, position, history, capture_context, policy, false, [])
      LookaroundRoutineSearchYes(_, _, routine, _) -> Some(routine)
      LookaroundRoutineSearchNo(_) -> None()
      LookaroundRoutineSearchCommit(_) -> None()

  ## Prefix selection is an outer endpoint policy.  The atomic machine still
  ## chooses the first path for each exact candidate, but shortest/longest
  ## selection must range over all candidate endpoints just like the ordinary
  ## lookaround prefix API.  Calling the exact atomic authority for each
  ## candidate keeps commitment semantics identical at every endpoint and
  ## returns the routine belonging to the selected candidate.
  fn atomic_lookaround_routine_prefix(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool, history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) = match machine
    MkPatternMachine(_, _) -> pickup
      greedy -> atomic_lookaround_routine_last_prefix(depth, n, machine, position, [], input, None(), history, capture_context, policy)
      else -> atomic_lookaround_routine_first_prefix(depth, n, machine, position, [], input, history, capture_context, policy)

  fn atomic_lookaround_routine_first_prefix(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match atomic_lookaround_routine_exact(depth, n, machine, position, matched_input, remaining_input, history, capture_context, policy)
      Some(result) -> Some(result)
      None() -> match remaining_input
        [] -> None()
        [char | rest] -> atomic_lookaround_routine_first_prefix(depth, n, machine, position, [char | reversed_prefix], rest, history, capture_context, policy)

  fn atomic_lookaround_routine_last_prefix(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    let current = match atomic_lookaround_routine_exact(depth, n, machine, position, matched_input, remaining_input, history, capture_context, policy)
      Some(result) -> Some(result)
      None() -> previous
    match remaining_input
      [] -> current
      [char | rest] -> atomic_lookaround_routine_last_prefix(depth, n, machine, position, [char | reversed_prefix], rest, current, history, capture_context, policy)

  fn atomic_lookaround_routine_exact(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) = match atomic_lookaround_routine_initial(depth, n, machine, input, after_input, position, history, capture_context, policy, false, [])
    LookaroundRoutineSearchYes(matched, [], routine, _) -> Some(%[matched, after_input, routine])
    LookaroundRoutineSearchYes(_, _, _, _) -> None()
    LookaroundRoutineSearchNo(_) -> None()
    LookaroundRoutineSearchCommit(_) -> None()

  fn atomic_lookaround_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = match machine
    MkPatternMachine(starts, _) -> match atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, None(), lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy))
      AtomicSearchYes() -> true
      AtomicSearchNo() -> false
      AtomicSearchCommit(_) -> false

  fn atomic_runtime_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    atomic_runtime_first_prefix_loop(n, machine, position, [], input)

  fn atomic_runtime_first_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    pickup
      atomic_runtime_accepts(n, machine, position, matched_input, remaining_input) -> Some(%[matched_input, remaining_input])
      else -> match remaining_input
        [] -> None()
        [char | rest] -> atomic_runtime_first_prefix_loop(n, machine, position, [char | reversed_prefix], rest)

  fn atomic_runtime_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    atomic_runtime_last_prefix_loop(n, machine, position, [], input, None())

  fn atomic_runtime_last_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: Option(Tuple(List(Char), List(Char)))) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    let current = pickup
      atomic_runtime_accepts(n, machine, position, matched_input, remaining_input) -> Some(%[matched_input, remaining_input])
      else -> previous
    match remaining_input
      [] -> current
      [char | rest] -> atomic_runtime_last_prefix_loop(n, machine, position, [char | reversed_prefix], rest, current)

  fn atomic_runtime_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool) -> Option(Tuple(List(Char), List(Char))) = pickup
    greedy -> atomic_runtime_last_prefix(n, machine, position, input)
    else -> atomic_runtime_first_prefix(n, machine, position, input)

  type AcceptingSearch(n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame))
    NoAcceptingPath : AcceptingSearch(n, machine, input, after_input, state, current_evidence, captures)
    AcceptingPath : (final_evidence: List(Evidence)) -> (extended_routine: List(ExtendedInstruction)) -> (routine_certificate : CertifiedPathRoutine(extended_routine, current_evidence, captures, final_evidence)) -> (@erased path : AcceptingFrom(n, machine, input, after_input, state, current_evidence, captures, final_evidence, extended_routine)) -> AcceptingSearch(n, machine, input, after_input, state, current_evidence, captures)

  fn prepend_transition_certificate(char: Char, routine: List(EvidenceInstruction), suffix_routine: List(ExtendedInstruction), source_evidence: List(Evidence), source_captures: List(CaptureFrame), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, regular_execution: ExtendedEvidenceRoutineExecution(regular_routine(routine), source_evidence, record_capture_char(source_captures, char), destination_evidence, destination_captures), suffix_certificate: CertifiedPathRoutine(suffix_routine, destination_evidence, destination_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(transition_routine(char, routine), suffix_routine), source_evidence, source_captures, final_evidence) =
    PathRoutineTransition(char, routine, suffix_routine, destination_evidence, destination_captures, regular_execution, suffix_certificate)

  fn search_accepting_from(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame)) -> AcceptingSearch(n, machine, input, after_input, state, current_evidence, captures) = match input
    [] -> match state
      ThreadAccepted() -> AcceptingPath(current_evidence, [], PathRoutineDone(), AcceptingNow())
      ThreadActive(_) -> NoAcceptingPath()
    [char | rest] ->
      let destinations = machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input))
      search_accepting_members(n, machine, char, rest, after_input, state, current_evidence, captures, machine_state_members(destinations))

  fn search_accepting_members(n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), source_evidence: List(Evidence), source_captures: List(CaptureFrame), {current: List(MachineState(n))}, members: MachineStateMembers(n, machine_destinations(n, machine, source_state, char, transition_boundary_before(char, rest, after_input)), current)) -> AcceptingSearch(n, machine, Cons(char, rest), after_input, source_state, source_evidence, source_captures) = match members
    MachineStateMembersNil() -> NoAcceptingPath()
    MachineStateMembersActive(state, routine, constraints, edge, remaining) -> match execute_routine_certified(routine, source_evidence, record_capture_char(source_captures, char))
      CertifiedRoutineExecuted(next_evidence, next_captures, execution, regular_execution) -> match search_accepting_from(n, machine, rest, after_input, ThreadActive(state), next_evidence, next_captures)
        NoAcceptingPath() -> search_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, remaining)
        AcceptingPath(final_evidence, suffix_routine, suffix_certificate, suffix) -> AcceptingPath(final_evidence, append_extended_routines(transition_routine(char, routine), suffix_routine), prepend_transition_certificate(char, routine, suffix_routine, source_evidence, source_captures, next_evidence, next_captures, regular_execution, suffix_certificate), AcceptingNextActive(state, routine, constraints, next_evidence, next_captures, suffix_routine, edge, execution, suffix))
    MachineStateMembersAccepted(routine, constraints, edge, remaining) -> match execute_routine_certified(routine, source_evidence, record_capture_char(source_captures, char))
      CertifiedRoutineExecuted(next_evidence, next_captures, execution, regular_execution) -> match search_accepting_from(n, machine, rest, after_input, ThreadAccepted(), next_evidence, next_captures)
        NoAcceptingPath() -> search_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, remaining)
        AcceptingPath(final_evidence, suffix_routine, suffix_certificate, suffix) -> AcceptingPath(final_evidence, append_extended_routines(transition_routine(char, routine), suffix_routine), prepend_transition_certificate(char, routine, suffix_routine, source_evidence, source_captures, next_evidence, next_captures, regular_execution, suffix_certificate), AcceptingNextAccepted(routine, constraints, next_evidence, next_captures, suffix_routine, edge, execution, suffix))

  @reducible
  fn initial_machine_destinations(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> filter_boundary_states(starts, initial_position_boundary(position, append_characters(input, after_input)))

  type InitialEvidenceStep(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), destination_state: ThreadState(n), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame))
    InitialEvidenceActive : (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Active(destination, routine, constraints), initial_machine_destinations(n, machine, position, input, after_input))) -> (execution : RoutineExecution(routine, Nil(), Nil(), result_evidence, result_captures)) -> InitialEvidenceStep(n, machine, position, input, after_input, ThreadActive(destination), result_evidence, result_captures)
    InitialEvidenceAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Accepted(routine, constraints), initial_machine_destinations(n, machine, position, input, after_input))) -> (execution : RoutineExecution(routine, Nil(), Nil(), result_evidence, result_captures)) -> InitialEvidenceStep(n, machine, position, input, after_input, ThreadAccepted(), result_evidence, result_captures)

  type MachineAcceptance(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence), extended_routine: List(ExtendedInstruction))
    MachineAccepted : (destination: MachineState(n)) -> (initial_evidence: List(Evidence)) -> (initial_captures: List(CaptureFrame)) -> (path_routine: List(ExtendedInstruction)) -> (edge : ListMember(MachineState(n), destination, initial_machine_destinations(n, machine, position, input, after_input))) -> (execution : RoutineExecution(machine_state_routine(n, destination), Nil(), Nil(), initial_evidence, initial_captures)) -> (routine_certificate : CertifiedPathRoutine(append_extended_routines(regular_routine(machine_state_routine(n, destination)), path_routine), Nil(), Nil(), final_evidence)) -> (path : AcceptingFrom(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> MachineAcceptance(n, machine, position, input, after_input, final_evidence, append_extended_routines(regular_routine(machine_state_routine(n, destination)), path_routine))

  type MachineAcceptingSearch(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char))
    MachineNoAcceptingPath : MachineAcceptingSearch(n, machine, position, input, after_input)
    MachineAcceptingPath : (final_evidence: List(Evidence)) -> (extended_routine: List(ExtendedInstruction)) -> (@erased acceptance : MachineAcceptance(n, machine, position, input, after_input, final_evidence, extended_routine)) -> MachineAcceptingSearch(n, machine, position, input, after_input)

  fn prepend_initial_certificate(routine: List(EvidenceInstruction), path_routine: List(ExtendedInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, regular_execution: ExtendedEvidenceRoutineExecution(regular_routine(routine), Nil(), Nil(), initial_evidence, initial_captures), path_certificate: CertifiedPathRoutine(path_routine, initial_evidence, initial_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(regular_routine(routine), path_routine), Nil(), Nil(), final_evidence) =
    PathRoutineInitial(routine, path_routine, initial_evidence, initial_captures, regular_execution, path_certificate)

  fn search_machine_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> MachineAcceptingSearch(n, machine, position, input, after_input) =
    let starts = initial_machine_destinations(n, machine, position, input, after_input)
    search_initial_members(n, machine, position, input, after_input, machine_state_members(starts))

  fn search_initial_members(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), {current: List(MachineState(n))}, members: MachineStateMembers(n, initial_machine_destinations(n, machine, position, input, after_input), current)) -> MachineAcceptingSearch(n, machine, position, input, after_input) = match members
    MachineStateMembersNil() -> MachineNoAcceptingPath()
    MachineStateMembersActive(state, routine, constraints, edge, remaining) -> match execute_routine_certified(routine, [], [])
      CertifiedRoutineExecuted(initial_evidence, initial_captures, execution, regular_execution) -> match search_accepting_from(n, machine, input, after_input, ThreadActive(state), initial_evidence, initial_captures)
        NoAcceptingPath() -> search_initial_members(n, machine, position, input, after_input, remaining)
        AcceptingPath(final_evidence, path_routine, path_certificate, path) ->
          let extended_routine = append_extended_routines(regular_routine(routine), path_routine)
          let routine_certificate = prepend_initial_certificate(routine, path_routine, initial_evidence, initial_captures, regular_execution, path_certificate)
          MachineAcceptingPath(final_evidence, extended_routine, MachineAccepted(Active(state, routine, constraints), initial_evidence, initial_captures, path_routine, edge, execution, routine_certificate, path))
    MachineStateMembersAccepted(routine, constraints, edge, remaining) -> match execute_routine_certified(routine, [], [])
      CertifiedRoutineExecuted(initial_evidence, initial_captures, execution, regular_execution) -> match search_accepting_from(n, machine, input, after_input, ThreadAccepted(), initial_evidence, initial_captures)
        NoAcceptingPath() -> search_initial_members(n, machine, position, input, after_input, remaining)
        AcceptingPath(final_evidence, path_routine, path_certificate, path) ->
          let extended_routine = append_extended_routines(regular_routine(routine), path_routine)
          let routine_certificate = prepend_initial_certificate(routine, path_routine, initial_evidence, initial_captures, regular_execution, path_certificate)
          MachineAcceptingPath(final_evidence, extended_routine, MachineAccepted(Accepted(routine, constraints), initial_evidence, initial_captures, path_routine, edge, execution, routine_certificate, path))

  ## Runtime-only search for named machines. The ordinary search above is
  ## indexed by the evidence theorem and intentionally has no capture-guard
  ## parameter. Named search carries only the replay routine, while preserving
  ## the same ordered destination traversal and boundary calculations.
  type NamedMachineSearch = NamedMachineNoPath | NamedMachinePath(List(ExtendedInstruction))

  fn named_search_machine_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> NamedMachineSearch = match machine
    MkPatternMachine(starts, _) -> named_search_initial_members(n, machine, position, input, after_input, named_filter_initial(starts, position, input, after_input))

  fn named_filter_initial({n: Nat}, starts: List(MachineState(n)), position: InitialPosition, input: List(Char), after_input: List(Char)) -> List(MachineState(n)) =
    filter_boundary_states_with_routine(starts, initial_position_boundary(position, append_characters(input, after_input)), [])

  fn named_search_initial_members(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), starts: List(MachineState(n))) -> NamedMachineSearch = match starts
    [] -> NamedMachineNoPath()
    [Active(state, routine, _) | rest] -> match named_search_accepting_from(n, machine, input, after_input, ThreadActive(state), regular_routine(routine))
      NamedMachineNoPath() -> named_search_initial_members(n, machine, position, input, after_input, rest)
      NamedMachinePath(path) -> NamedMachinePath(path)
    [Accepted(routine, _) | rest] -> match named_search_accepting_from(n, machine, input, after_input, ThreadAccepted(), regular_routine(routine))
      NamedMachineNoPath() -> named_search_initial_members(n, machine, position, input, after_input, rest)
      NamedMachinePath(path) -> NamedMachinePath(path)

  fn named_search_accepting_from(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_routine: List(ExtendedInstruction)) -> NamedMachineSearch = match input
    [] -> match state
      ThreadAccepted() -> NamedMachinePath(current_routine)
      ThreadActive(_) -> NamedMachineNoPath()
    [char | rest] -> named_search_accepting_members(n, machine, char, rest, after_input, current_routine, named_machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input), extended_regular_instructions(current_routine)))

  fn named_search_accepting_members(n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), current_routine: List(ExtendedInstruction), destinations: List(MachineState(n))) -> NamedMachineSearch = match destinations
    [] -> NamedMachineNoPath()
    [Active(state, routine, _) | remaining] -> match named_search_accepting_from(n, machine, rest, after_input, ThreadActive(state), append_extended_routines(current_routine, transition_routine(char, routine)))
      NamedMachineNoPath() -> named_search_accepting_members(n, machine, char, rest, after_input, current_routine, remaining)
      NamedMachinePath(path) -> NamedMachinePath(path)
    [Accepted(routine, _) | remaining] -> match named_search_accepting_from(n, machine, rest, after_input, ThreadAccepted(), append_extended_routines(current_routine, transition_routine(char, routine)))
      NamedMachineNoPath() -> named_search_accepting_members(n, machine, char, rest, after_input, current_routine, remaining)
      NamedMachinePath(path) -> NamedMachinePath(path)

  type NamedPrefixSearch = NamedNoPrefix | NamedPrefixPath(List(Char), List(Char), List(ExtendedInstruction))

  fn named_search_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> NamedPrefixSearch =
    named_search_first_prefix_loop(n, machine, position, [], input)

  fn named_search_first_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char)) -> NamedPrefixSearch =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match named_search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      NamedMachinePath(routine) -> NamedPrefixPath(matched_input, remaining_input, routine)
      NamedMachineNoPath() -> match remaining_input
        [] -> NamedNoPrefix()
        [char | rest] -> named_search_first_prefix_loop(n, machine, position, [char | reversed_prefix], rest)

  fn named_search_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> NamedPrefixSearch =
    named_search_last_prefix_loop(n, machine, position, [], input, NamedNoPrefix())

  fn named_search_last_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: NamedPrefixSearch) -> NamedPrefixSearch =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match named_search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      NamedMachinePath(routine) -> named_continue_last_prefix(n, machine, position, reversed_prefix, remaining_input, NamedPrefixPath(matched_input, remaining_input, routine))
      NamedMachineNoPath() -> named_continue_last_prefix(n, machine, position, reversed_prefix, remaining_input, previous)

  fn named_continue_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: NamedPrefixSearch) -> NamedPrefixSearch = match remaining_input
    [] -> previous
    [char | rest] -> named_search_last_prefix_loop(n, machine, position, [char | reversed_prefix], rest, previous)

  type CertifiedPrefixSearch(n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition)
    NoCertifiedPrefix : CertifiedPrefixSearch(n, machine, position)
    CertifiedPrefixPath : (matched_input: List(Char)) -> (remaining_input: List(Char)) -> (final_evidence: List(Evidence)) -> (extended_routine: List(ExtendedInstruction)) -> (@erased acceptance : MachineAcceptance(n, machine, position, matched_input, remaining_input, final_evidence, extended_routine)) -> CertifiedPrefixSearch(n, machine, position)

  fn search_first_machine_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> CertifiedPrefixSearch(n, machine, position) =
    search_first_machine_prefix_loop(n, machine, position, [], input)

  fn search_first_machine_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char)) -> CertifiedPrefixSearch(n, machine, position) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      MachineAcceptingPath(evidence, routine, acceptance) -> CertifiedPrefixPath(matched_input, remaining_input, evidence, routine, acceptance)
      MachineNoAcceptingPath() -> match remaining_input
        [] -> NoCertifiedPrefix()
        [char | rest] -> search_first_machine_prefix_loop(n, machine, position, [char | reversed_prefix], rest)

  fn search_last_machine_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> CertifiedPrefixSearch(n, machine, position) =
    search_last_machine_prefix_loop(n, machine, position, [], input, NoCertifiedPrefix())

  fn search_last_machine_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: CertifiedPrefixSearch(n, machine, position)) -> CertifiedPrefixSearch(n, machine, position) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match search_machine_acceptance(n, machine, position, matched_input, remaining_input)
      MachineNoAcceptingPath() -> continue_last_machine_prefix(n, machine, position, reversed_prefix, remaining_input, previous)
      MachineAcceptingPath(evidence, routine, acceptance) -> continue_last_machine_prefix(n, machine, position, reversed_prefix, remaining_input, CertifiedPrefixPath(matched_input, remaining_input, evidence, routine, acceptance))

  fn continue_last_machine_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: CertifiedPrefixSearch(n, machine, position)) -> CertifiedPrefixSearch(n, machine, position) = match remaining_input
    [] -> previous
    [char | rest] -> search_last_machine_prefix_loop(n, machine, position, [char | reversed_prefix], rest, previous)

  fn bounded_same({n: Nat}, left: Bounded(n), right: Bounded(n)) -> Bool = match left
    First() -> match right
      First() -> true
      Next(_) -> false
    Next(left_rest) -> match right
      First() -> false
      Next(right_rest) -> bounded_same(left_rest, right_rest)

  fn same_thread_state({n: Nat}, left: ThreadState(n), right: ThreadState(n)) -> Bool = match left
    ThreadAccepted() -> match right
      ThreadAccepted() -> true
      ThreadActive(_) -> false
    ThreadActive(left_state) -> match right
      ThreadAccepted() -> false
      ThreadActive(right_state) -> bounded_same(left_state, right_state)

  ## One winner slot per encountered intrinsic active state plus one accepted-state bit.
  ## Traversal is left-to-right, so setting a slot preserves the first (highest
  ## priority) thread and discards every later duplicate without rescanning the
  ## growing winner list. `Bounded(n)` structurally indexes the slot spine: no
  ## unchecked Nat conversion enters the machine and the erased bound need not
  ## be materialized at runtime.
  type ActiveWinnerSlots = NoWinnerSlots | ActiveWinnerSlot(Bool, ActiveWinnerSlots)
  type ThreadWinnerTable = ThreadWinnerTable(Bool, ActiveWinnerSlots)

  type DistinctThreadResult indices (n: Nat)
    DistinctThreadResult : ThreadWinnerTable -> List(EvidenceThread(n)) -> DistinctThreadResult(n)

  fn active_winner_seen({n: Nat}, slots: ActiveWinnerSlots, index: Bounded(n)) -> Bool = match index
    First() -> match slots
      NoWinnerSlots() -> false
      ActiveWinnerSlot(seen, _) -> seen
    Next(rest) -> match slots
      NoWinnerSlots() -> false
      ActiveWinnerSlot(_, tail) -> active_winner_seen(tail, rest)

  fn record_active_winner({n: Nat}, slots: ActiveWinnerSlots, index: Bounded(n)) -> ActiveWinnerSlots = match index
    First() -> match slots
      NoWinnerSlots() -> ActiveWinnerSlot(true, NoWinnerSlots())
      ActiveWinnerSlot(_, tail) -> ActiveWinnerSlot(true, tail)
    Next(rest) -> match slots
      NoWinnerSlots() -> ActiveWinnerSlot(false, record_active_winner(NoWinnerSlots(), rest))
      ActiveWinnerSlot(seen, tail) -> ActiveWinnerSlot(seen, record_active_winner(tail, rest))

  fn empty_thread_winners() -> ThreadWinnerTable = ThreadWinnerTable(false, NoWinnerSlots())

  fn thread_winner_seen({n: Nat}, table: ThreadWinnerTable, state: ThreadState(n)) -> Bool = match table
    ThreadWinnerTable(accepted, active) -> match state
      ThreadAccepted() -> accepted
      ThreadActive(index) -> active_winner_seen(active, index)

  fn record_thread_winner({n: Nat}, table: ThreadWinnerTable, state: ThreadState(n)) -> ThreadWinnerTable = match table
    ThreadWinnerTable(accepted, active) -> match state
      ThreadAccepted() -> ThreadWinnerTable(true, active)
      ThreadActive(index) -> ThreadWinnerTable(accepted, record_active_winner(active, index))

  fn distinct_threads({n: Nat}, threads: List(EvidenceThread(n))) -> List(EvidenceThread(n)) = match distinct_threads_with(threads, empty_thread_winners())
    DistinctThreadResult(_, winners) -> winners

  fn distinct_threads_with({n: Nat}, threads: List(EvidenceThread(n)), table: ThreadWinnerTable) -> DistinctThreadResult(n) = match threads
    [] -> DistinctThreadResult(table, [])
    [EvidenceThread(state, evidence, captures) | rest] -> pickup
      thread_winner_seen(table, state) -> distinct_threads_with(rest, table)
      else -> match distinct_threads_with(rest, record_thread_winner(table, state))
        DistinctThreadResult(final_table, winners) -> DistinctThreadResult(final_table, [EvidenceThread(state, evidence, captures) | winners])

  fn first_accepted_evidence({n: Nat}, threads: List(EvidenceThread(n))) -> Option(List(Evidence)) = match threads
    [] -> None()
    [EvidenceThread(ThreadAccepted(), evidence, _) | _] -> Some(evidence)
    [_ | rest] -> first_accepted_evidence(rest)

  fn run_evidence({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), threads: List(EvidenceThread(n))) -> Option(List(Evidence)) = match input
    [] -> first_accepted_evidence(threads)
    [char | rest] ->
      let boundary = position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), Some(char), rest)
      run_evidence(next, rest, distinct_threads(step_evidence_threads(next, char, boundary, threads)))

  fn run_first_prefix_evidence({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), threads: List(EvidenceThread(n))) -> Option(EvidencePrefix) = match first_accepted_evidence(threads)
    Some(evidence) -> Some(EvidencePrefix(evidence, input))
    None() -> match input
      [] -> None()
      [char | rest] ->
        let boundary = position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), Some(char), rest)
        run_first_prefix_evidence(next, rest, distinct_threads(step_evidence_threads(next, char, boundary, threads)))

  fn remember_prefix({n: Nat}, threads: List(EvidenceThread(n)), rest: List(Char), previous: Option(EvidencePrefix)) -> Option(EvidencePrefix) = match first_accepted_evidence(threads)
    Some(evidence) -> Some(EvidencePrefix(evidence, rest))
    None() -> previous

  fn run_last_prefix_evidence({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), threads: List(EvidenceThread(n)), previous: Option(EvidencePrefix)) -> Option(EvidencePrefix) =
    let remembered = remember_prefix(threads, input, previous)
    match input
      [] -> remembered
      [char | rest] -> match threads
        [] -> remembered
        _ ->
          let boundary = position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), Some(char), rest)
          run_last_prefix_evidence(next, rest, distinct_threads(step_evidence_threads(next, char, boundary, threads)), remembered)

  fn pattern_evidence({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char)) -> Option(List(Evidence)) = match compile_pattern(pattern)
    mk_pair(count, machine) -> match search_machine_acceptance(count, machine, subject_initial_position(), input, [])
      MachineNoAcceptingPath() -> None()
      MachineAcceptingPath(evidence, _, _) -> Some(evidence)

  fn pattern_prefix_evidence_at({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char), greedy: Bool, subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool) -> Option(EvidencePrefix) = match compile_pattern(pattern)
    mk_pair(count, machine) ->
      let position = InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, None())
      let result = pickup
        greedy -> search_last_machine_prefix(count, machine, position, input)
        else -> search_first_machine_prefix(count, machine, position, input)
      match result
        NoCertifiedPrefix() -> None()
        CertifiedPrefixPath(_, remaining, evidence, _, _) -> Some(EvidencePrefix(evidence, remaining))

  fn pattern_prefix_evidence({shape: ShapeCode}, pattern: Pattern(shape), input: List(Char), greedy: Bool) -> Option(EvidencePrefix) =
    pattern_prefix_evidence_at(pattern, input, greedy, true, true, false, false)

  ## Public typed combinator layer. `Mapped` is the semantic bridge from a
  ## structurally extracted Pattern value to the user-facing result type. It is
  ## one-way: regex parsing does not imply an unparser.
  type OneOrMore(value: Type) = OneOrMore(value, List(value))

  type CharacterRange = CharacterRange(Char, Char)
  type ClassKinds = ClassKinds(Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool)
  type ClassKind = DigitKind | NotDigitKind | WordKind | NotWordKind | SpaceKind | NotSpaceKind | HorizontalKind | NotHorizontalKind | VerticalKind | NotVerticalKind

  type UnicodeProperty =
    | PropertyNonNewline
    | PropertyAny
    | PropertyAscii
    | PropertyCased | PropertyLowercase | PropertyUppercase
    | PropertyAlphabetic | PropertyWhiteSpace | PropertyHexDigit | PropertyMath | PropertyCurrencyBinary
    | PropertyScript(Atom)
    | PropertyScriptExtensions(Atom)
    | PropertyBidiClass(Atom)
    | PropertyBidiPairedBracketType(Atom)
    | PropertyCategory(Atom)
    | PropertyBinary(Atom)
    | PropertyLetter | PropertyLowercaseLetter | PropertyUppercaseLetter | PropertyTitlecaseLetter | PropertyModifierLetter | PropertyOtherLetter
    | PropertyMark | PropertySpacingMark | PropertyEnclosingMark | PropertyNonspacingMark
    | PropertyNumber | PropertyDecimalNumber | PropertyLetterNumber | PropertyOtherNumber
    | PropertyPunctuation | PropertyConnectorPunctuation | PropertyDashPunctuation | PropertyClosePunctuation | PropertyFinalPunctuation | PropertyInitialPunctuation | PropertyOtherPunctuation | PropertyOpenPunctuation
    | PropertySymbol | PropertyCurrencySymbol | PropertyModifierSymbol | PropertyMathSymbol | PropertyOtherSymbol
    | PropertySeparator | PropertyLineSeparator | PropertyParagraphSeparator | PropertySpaceSeparator
    | PropertyOther | PropertyControl | PropertyFormat | PropertyUnassigned | PropertyPrivateUse | PropertySurrogate

  type UnicodePropertyMatch = UnicodePropertyMatch(UnicodeProperty, Bool)

  type PosixClass =
    | PosixAlnum | PosixAlpha | PosixAscii | PosixBlank | PosixCntrl
    | PosixDigit | PosixGraph | PosixLower | PosixPrint | PosixPunct
    | PosixSpace | PosixUpper | PosixWord | PosixXdigit

  type PosixClassMatch = PosixClassMatch(PosixClass, Bool)

  fn no_class_kinds() -> ClassKinds =
    ClassKinds(false, false, false, false, false, false, false, false, false, false)

  fn enable_class_kind(kind: ClassKind, kinds: ClassKinds) -> ClassKinds = match kinds
    ClassKinds(d, nd, w, nw, s, ns, h, nh, v, nv) -> match kind
      DigitKind -> ClassKinds(true, nd, w, nw, s, ns, h, nh, v, nv)
      NotDigitKind -> ClassKinds(d, true, w, nw, s, ns, h, nh, v, nv)
      WordKind -> ClassKinds(d, nd, true, nw, s, ns, h, nh, v, nv)
      NotWordKind -> ClassKinds(d, nd, w, true, s, ns, h, nh, v, nv)
      SpaceKind -> ClassKinds(d, nd, w, nw, true, ns, h, nh, v, nv)
      NotSpaceKind -> ClassKinds(d, nd, w, nw, s, true, h, nh, v, nv)
      HorizontalKind -> ClassKinds(d, nd, w, nw, s, ns, true, nh, v, nv)
      NotHorizontalKind -> ClassKinds(d, nd, w, nw, s, ns, h, true, v, nv)
      VerticalKind -> ClassKinds(d, nd, w, nw, s, ns, h, nh, true, nv)
      NotVerticalKind -> ClassKinds(d, nd, w, nw, s, ns, h, nh, v, true)

  ## Elixir-compatible literal modifiers, in `i m s x u f U` order. Repeated
  ## letters are idempotent and modifier order is irrelevant. No accepted flag
  ## is metadata-only: each one must affect parsing or machine execution.
  type RegexOptions = RegexOptions(Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, NewlinePolicy)

  fn default_options() -> RegexOptions =
    RegexOptions(false, false, false, false, false, false, false, false, AnyUnicodeNewline())

  ## A staged literal carries its checked machine and the erased equality that
  ## relates that machine to the canonical Thompson construction.  The wrapper
  ## is indexed by the public shape (rather than by the dependent compilation
  ## itself) because that is the representation the constructor elaborator can
  ## refine without introducing an existential dependent constructor.
  type StagedMachine indices (shape: ShapeCode)
    StagedMachineValue : (compilation: ThompsonCompilation(shape)) -> StagedMachine(shape)
    StagedAtomicPatternValue : (plan: AtomicRuntimePattern(shape)) -> StagedMachine(shape)
    StagedLookaroundValue : (pattern: Pattern(shape)) -> (compilation: LookaroundCompilation(shape)) -> (policy: NewlinePolicy) -> StagedMachine(shape)

  ## Runtime-only atomic plan. Ordinary Pattern values and their Thompson
  ## proofs stay unchanged; this parallel tree carries only the commitment
  ## scopes needed by the ordered runtime search.
  type AtomicRuntimePattern indices (shape: ShapeCode)
    AtomicRuntimeLeaf : (pattern: Pattern(shape)) -> AtomicRuntimePattern(shape)
    AtomicRuntimeConcat : (left: AtomicRuntimePattern(left_shape)) -> (right: AtomicRuntimePattern(right_shape)) -> AtomicRuntimePattern(PairC(left_shape, right_shape))
    AtomicRuntimeGroup : (inner: AtomicRuntimePattern(inner_shape)) -> AtomicRuntimePattern(StringC)
    AtomicRuntimeAlternate : (left: AtomicRuntimePattern(left_shape)) -> (right: AtomicRuntimePattern(right_shape)) -> (prefer_right: Bool) -> AtomicRuntimePattern(ChoiceC(left_shape, right_shape))
    AtomicRuntimeScope : (inner: AtomicRuntimePattern(inner_shape)) -> AtomicRuntimePattern(inner_shape)
    AtomicRuntimeRepeat : (inner: AtomicRuntimePattern(inner_shape)) -> (lazy: Bool) -> AtomicRuntimePattern(ListC(inner_shape))

  type Regex indices (result: Type)
    FromPattern : (shape: ShapeCode) -> Pattern(shape) -> Regex(Sem(shape))
    ## A literal may publish its constructor-preserving Thompson IR directly.
    ## The proof layer certifies this IR structurally, so runtime compilation
    ## does not need to rediscover it from a Pattern value.
    StagedRegex : (shape: ShapeCode) -> Pattern(shape) -> ThompsonCompilation(shape) -> StagedMachine(shape) -> Conversion(Sem(shape), result) -> Regex(result)
    Mapped : (a -> b) -> Regex(a) -> Regex(b)
    Concatenated : Regex(a) -> Regex(b) -> Regex(Tuple(a, b))
    Alternated : Regex(a) -> Regex(b) -> Regex(Choice(a, b))
    Repeated : Regex(a) -> Regex(List(a))
    MatchedText : Regex(a) -> Regex(String)
    KeptRight : Regex(a) -> Regex(b) -> Regex(b)
    KeptLeft : Regex(a) -> Regex(b) -> Regex(a)
    SameAlternative : Regex(a) -> Regex(a) -> Regex(a)
    OptionalRegex : Regex(a) -> Regex(Option(a))
    OneOrMoreRegex : Regex(a) -> Regex(OneOrMore(a))
    SimplifiedRegex : (shape: ShapeCode) -> Regex(Sem(shape)) -> Regex(Sem(Simplify(shape)))
    OptionalPattern : Regex(a) -> Regex(Choice(a, Unit))
    PlusPattern : Regex(a) -> Regex(List(a))
    RepeatedPattern : Regex(a) -> Bool -> Regex(List(a))
    OneOrMorePattern : Regex(a) -> Bool -> Regex(List(a))
    OptionalLiteral : Regex(a) -> Bool -> Regex(Choice(a, Unit))
    ConfiguredRegex : RegexOptions -> Regex(a) -> Regex(a)
    StartAnchor : Bool -> Regex(Unit)
    EndAnchor : Bool -> Regex(Unit)
    StrictEndAnchor : Regex(Unit)

  ## Named capture metadata is additive.  It never enters ShapeCode or the
  ## ordinary Match tuple, so existing typed regex APIs remain unchanged.
  type CaptureSlot = CaptureSlot(Nat, Option(String))
  type CaptureLayout = CaptureLayout(List(CaptureSlot))
  type NamedCapture = NamedCapture(String, Option(String))
  type NamedMatch(result: Type) = NamedMatch(Match(result), List(NamedCapture))
  type NamedParse(result: Type) = NamedParse(result, List(NamedCapture))
  ## The public result type and the checked Thompson shape are independent:
  ## conversions may expose `Option`, `List`, or a simplified tuple while the
  ## machine still carries its constructor-preserving shape.  Keep the machine
  ## shape as an explicit index instead of letting it unify accidentally with
  ## the public result (which would reject optional/one-or-more captures).
  type NamedRegex(result: Type) indices (shape: ShapeCode)
    NamedRegex : Regex(result) -> NamedThompsonCompilation(shape) -> LookaroundCompilation(shape) -> CaptureLayout -> Bool -> NewlinePolicy -> NamedRegex(result, shape)

  type Conversion indices (raw: Type, result: Type)
    IdentityConversion : Conversion(value, value)
    ApplyConversion : (raw -> result) -> Conversion(raw, result)
    ComposedConversion : Conversion(raw, middle) -> Conversion(middle, result) -> Conversion(raw, result)
    PairConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Tuple(left_raw, right_raw), Tuple(left_result, right_result))
    ChoiceConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Choice(left_raw, right_raw), Choice(left_result, right_result))
    ListConversion : Conversion(raw, result) -> Conversion(List(raw), List(result))
    LeftPairConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Tuple(left_raw, right_raw), left_result)
    RightPairConversion : Conversion(left_raw, left_result) -> Conversion(right_raw, right_result) -> Conversion(Tuple(left_raw, right_raw), right_result)
    SameChoiceConversion : Conversion(left_raw, result) -> Conversion(right_raw, result) -> Conversion(Choice(left_raw, right_raw), result)
    OptionalConversion : Conversion(raw, result) -> Conversion(Choice(raw, Unit), Option(result))
    OneOrMoreConversion : Conversion(raw, result) -> Conversion(Tuple(raw, List(raw)), OneOrMore(result))
    PrependConversion : Conversion(raw, result) -> Conversion(Tuple(raw, List(raw)), List(result))
    SimplifyConversion : (shape: ShapeCode) -> Conversion(Sem(shape), Sem(Simplify(shape)))

  type RegexProgram indices (result: Type)
    BuiltRegex : (shape: ShapeCode) -> Pattern(shape) -> Conversion(Sem(shape), result) -> CompilationHint(shape) -> RegexProgram(result)

  type CompilationHint indices (shape: ShapeCode)
    NoCompilationHint : CompilationHint(shape)
    StagedCompilationHint : StagedMachine(shape) -> CompilationHint(shape)

  ## `Option` is a `Type`-level family, so it cannot hold a `RegexProgram(result)`:
  ## a family INDEXED by `Type` lives one universe up (`level: 1`), exactly as an
  ## Agda `data … : Set → Set₁` does. Cure has no universe polymorphism, so the
  ## large case needs its own carrier rather than a `Type`-level `Option`.
  type CompiledRegex indices (result: Type)
    NoProgram : CompiledRegex(result)
    SomeProgram : RegexProgram(result) -> CompiledRegex(result)

  fn execute_left_choice_conversion({left_raw: Type}, {left_result: Type}, {right_raw: Type}, {right_result: Type}, left: Conversion(left_raw, left_result), _right: Conversion(right_raw, right_result), value: left_raw) -> Choice(left_result, right_result) =
    assert_type ChoseLeft(execute_conversion(left, value)) : Choice(left_result, right_result)

  fn execute_right_choice_conversion({left_raw: Type}, {left_result: Type}, {right_raw: Type}, {right_result: Type}, _left: Conversion(left_raw, left_result), right: Conversion(right_raw, right_result), value: right_raw) -> Choice(left_result, right_result) =
    assert_type ChoseRight(execute_conversion(right, value)) : Choice(left_result, right_result)

  fn execute_conversion({raw: Type}, {result: Type}, conversion: Conversion(raw, result), value: raw) -> result = match conversion
    IdentityConversion() -> value
    ApplyConversion(transform) -> transform(value)
    ComposedConversion(first, second) -> execute_conversion(second, execute_conversion(first, value))
    PairConversion(left, right) -> %[execute_conversion(left, value.1), execute_conversion(right, value.2)]
    ChoiceConversion(left, right) -> match value
      ChoseLeft(left_value) -> execute_left_choice_conversion(left, right, left_value)
      ChoseRight(right_value) -> execute_right_choice_conversion(left, right, right_value)
    ListConversion(inner) -> execute_list_conversion(inner, value)
    LeftPairConversion(left, _right) -> execute_conversion(left, value.1)
    RightPairConversion(_left, right) -> execute_conversion(right, value.2)
    SameChoiceConversion(left, right) -> match value
      ChoseLeft(left_value) -> execute_conversion(left, left_value)
      ChoseRight(right_value) -> execute_conversion(right, right_value)
    OptionalConversion(inner) -> match value
      ChoseLeft(inner_value) -> Some(execute_conversion(inner, inner_value))
      ChoseRight(_) -> None()
    OneOrMoreConversion(inner) -> OneOrMore(execute_conversion(inner, value.1), execute_list_conversion(inner, value.2))
    PrependConversion(inner) -> [execute_conversion(inner, value.1) | execute_list_conversion(inner, value.2)]
    SimplifyConversion(shape) -> simplify_value(shape, value)

  fn execute_list_conversion({raw: Type}, {result: Type}, conversion: Conversion(raw, result), values: List(raw)) -> List(result) = match values
    [] -> []
    [head | rest] -> [execute_conversion(conversion, head) | execute_list_conversion(conversion, rest)]

  ## Conversion values used by the literal emitter's staged IR. Keeping these
  ## small adapters here lets generated literals publish a first-order
  ## Thompson tree without rebuilding a Regex/Pattern wrapper at runtime.
  fn discard_char_conversion() -> Conversion(Char, Unit) = ApplyConversion(discard_char)

  fn empty_list_conversion({a: Type}) -> Conversion(Unit, List(a)) = ApplyConversion(fn(_) -> [])

  ## Shape-indexed adapters keep generated bounded-literal conversions fully
  ## inferable.  The emitter knows the inner shape, while the polymorphic
  ## convenience form above has no expected type at the generated call site.
  fn empty_list_conversion_for(shape: ShapeCode) -> Conversion(Unit, List(Sem(shape))) =
    ApplyConversion(fn(_) -> [])

  fn prepend_repetition_conversion({a: Type}) -> Conversion(Tuple(a, List(a)), List(a)) =
    ApplyConversion(prepend_repetition_result)

  fn prepend_repetition_conversion_for(shape: ShapeCode) -> Conversion(Tuple(Sem(shape), List(Sem(shape))), List(Sem(shape))) =
    ApplyConversion(prepend_repetition_result)

  fn prepend_optional_repetition_conversion({a: Type}) -> Conversion(Tuple(Choice(a, Unit), List(a)), List(a)) =
    ApplyConversion(prepend_optional_repetition_result)

  fn prepend_optional_repetition_conversion_for(shape: ShapeCode) -> Conversion(Tuple(Choice(Sem(shape), Unit), List(Sem(shape))), List(Sem(shape))) =
    ApplyConversion(prepend_optional_repetition_result)

  fn simplify_program(shape: ShapeCode, program: RegexProgram(Sem(shape))) -> RegexProgram(Sem(Simplify(shape))) = match program
    BuiltRegex(raw_shape, pattern, conversion, hint) ->
      BuiltRegex(raw_shape, pattern, ComposedConversion(conversion, SimplifyConversion(shape)), hint)

  fn simplify_compiled(shape: ShapeCode, program: CompiledRegex(Sem(shape))) -> CompiledRegex(Sem(Simplify(shape))) = match program
    NoProgram() -> NoProgram()
    SomeProgram(compiled) -> SomeProgram(simplify_program(shape, compiled))

  fn sem_identity_conversion(shape: ShapeCode) -> Conversion(Sem(shape), Sem(shape)) = IdentityConversion()
  fn string_identity_conversion() -> Conversion(String, String) = IdentityConversion()
  fn unit_identity_conversion() -> Conversion(Unit, Unit) = IdentityConversion()

  fn line_break() -> Regex(String) =
    line_break_with_policy(AnyUnicodeNewline())

  fn line_break_with_policy(policy: NewlinePolicy) -> Regex(String) = match policy
    LFNewline() -> captured(exactly('\n'))
    CRNewline() -> captured(exactly('\r'))
    CRLFNewline() -> captured(concatenate(exactly('\r'), exactly('\n')))
    AnyCRLFNewline() -> or_same(
      captured(concatenate(exactly('\r'), exactly('\n'))),
      or_same(captured(exactly('\n')), captured(exactly('\r')))
    )
    AnyUnicodeNewline() -> or_same(
      captured(concatenate(exactly('\r'), exactly('\n'))),
      or_same(
        captured(exactly('\n')),
        or_same(
          captured(exactly('\r')),
          or_same(
            captured(exactly('\v')),
            or_same(
              captured(exactly('\f')),
              or_same(captured(exactly(0x85)), or_same(captured(exactly(0x2028)), captured(exactly(0x2029))))
            )
          )
        )
      )
    )

  fn line_break_pair_start_policy(policy: NewlinePolicy) -> Bool = match policy
      LFNewline() -> false
      CRNewline() -> false
      CRLFNewline() -> true
      AnyCRLFNewline() -> true
      AnyUnicodeNewline() -> true

  fn line_break_pair_start_test(policy: NewlinePolicy, char: Char) -> Bool = char == '\r' and line_break_pair_start_policy(policy)

  fn line_break_pair_test(policy: NewlinePolicy, expected: Char) -> Char -> Bool =
    fn(char) -> char == expected and (line_break_pair_start_test(policy, char) or line_break_pair_end_test(policy, char))

  fn line_break_pair_end_policy(policy: NewlinePolicy) -> Bool = match policy
      LFNewline() -> false
      CRNewline() -> false
      CRLFNewline() -> true
      AnyCRLFNewline() -> true
      AnyUnicodeNewline() -> true

  fn line_break_pair_end_test(policy: NewlinePolicy, char: Char) -> Bool = char == '\n' and line_break_pair_end_policy(policy)

  fn line_break_scalar_test(policy: NewlinePolicy, expected: Char) -> Char -> Bool =
    fn(char) -> char == expected and line_break_scalar_policy(policy, char)

  fn line_break_scalar_policy(policy: NewlinePolicy, char: Char) -> Bool = match policy
      LFNewline() -> char == '\n'
      CRNewline() -> char == '\r'
      CRLFNewline() -> false
      AnyCRLFNewline() -> char == '\r' or char == '\n'
      AnyUnicodeNewline() -> Std.Char.is_newline(char)

  fn compile_regex({result: Type}, regex: Regex(result)) -> CompiledRegex(result) = match regex
    FromPattern(shape, pattern) -> SomeProgram(BuiltRegex(shape, pattern, sem_identity_conversion(shape), NoCompilationHint()))
    StagedRegex(shape, pattern, _compilation, machine, conversion) -> SomeProgram(BuiltRegex(shape, pattern, conversion, StagedCompilationHint(machine)))
    Mapped(transform, inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) -> SomeProgram(BuiltRegex(shape, pattern, ComposedConversion(convert, ApplyConversion(transform)), NoCompilationHint()))
    Concatenated(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(PairC(left_shape, right_shape), PatternConcat(left_pattern, right_pattern), PairConversion(left_convert, right_convert), NoCompilationHint()))
    Alternated(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(ChoiceC(left_shape, right_shape), PatternAlternate(left_pattern, right_pattern), ChoiceConversion(left_convert, right_convert), NoCompilationHint()))
    Repeated(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) -> SomeProgram(BuiltRegex(ListC(shape), PatternRepeat(pattern), ListConversion(convert), NoCompilationHint()))
    MatchedText(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(_shape, pattern, _convert, _hint)) -> SomeProgram(BuiltRegex(StringC, PatternGroup(pattern), string_identity_conversion(), NoCompilationHint()))
    KeptRight(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(PairC(left_shape, right_shape), PatternConcat(left_pattern, right_pattern), RightPairConversion(left_convert, right_convert), NoCompilationHint()))
    KeptLeft(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(PairC(left_shape, right_shape), PatternConcat(left_pattern, right_pattern), LeftPairConversion(left_convert, right_convert), NoCompilationHint()))
    SameAlternative(left, right) -> match compile_regex(left)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(left_shape, left_pattern, left_convert, _left_hint)) -> match compile_regex(right)
        NoProgram() -> NoProgram()
        SomeProgram(BuiltRegex(right_shape, right_pattern, right_convert, _right_hint)) ->
          SomeProgram(BuiltRegex(ChoiceC(left_shape, right_shape), PatternAlternate(left_pattern, right_pattern), SameChoiceConversion(left_convert, right_convert), NoCompilationHint()))
    OptionalRegex(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ChoiceC(shape, UnitC), PatternAlternate(pattern, PatternEmpty()), OptionalConversion(convert), NoCompilationHint()))
    OneOrMoreRegex(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(PairC(shape, ListC(shape)), PatternConcat(pattern, PatternRepeat(pattern)), OneOrMoreConversion(convert), NoCompilationHint()))
    SimplifiedRegex(shape, inner) -> simplify_compiled(shape, compile_regex(inner))
    OptionalPattern(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ChoiceC(shape, UnitC), PatternAlternate(pattern, PatternEmpty()), ChoiceConversion(convert, unit_identity_conversion()), NoCompilationHint()))
    PlusPattern(inner) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(PairC(shape, ListC(shape)), PatternConcat(pattern, PatternRepeat(pattern)), PrependConversion(convert), NoCompilationHint()))
    RepeatedPattern(inner, lazy) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ListC(shape), PatternRepeatMode(pattern, lazy), ListConversion(convert), NoCompilationHint()))
    OneOrMorePattern(inner, lazy) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(PairC(shape, ListC(shape)), PatternConcat(pattern, PatternRepeatMode(pattern, lazy)), PrependConversion(convert), NoCompilationHint()))
    OptionalLiteral(inner, lazy) -> match compile_regex(inner)
      NoProgram() -> NoProgram()
      SomeProgram(BuiltRegex(shape, pattern, convert, _hint)) ->
        SomeProgram(BuiltRegex(ChoiceC(shape, UnitC), PatternAlternateMode(pattern, PatternEmpty(), lazy), ChoiceConversion(convert, unit_identity_conversion()), NoCompilationHint()))
    ConfiguredRegex(_options, inner) -> compile_regex(inner)
    StartAnchor(multiline) -> pickup
      multiline -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(line_start_constraint()), unit_identity_conversion(), NoCompilationHint()))
      else -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(subject_start_constraint()), unit_identity_conversion(), NoCompilationHint()))
    EndAnchor(multiline) -> pickup
      multiline -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(line_end_constraint()), unit_identity_conversion(), NoCompilationHint()))
      else -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(subject_end_constraint()), unit_identity_conversion(), NoCompilationHint()))
    StrictEndAnchor() -> SomeProgram(BuiltRegex(UnitC, PatternBoundary(strict_end_constraint()), unit_identity_conversion(), NoCompilationHint()))

  fn named_staged({result: Type}, {shape: ShapeCode}, ordinary: Regex(result), compilation: NamedThompsonCompilation(shape), lookaround: LookaroundCompilation(shape), layout: CaptureLayout, firstline_only: Bool, policy: NewlinePolicy) -> NamedRegex(result, shape) =
    named_staged_checked(ordinary, compilation, lookaround, layout, firstline_only, policy, certify_named_compilation(compilation))

  fn named_staged_checked({result: Type}, {shape: ShapeCode}, ordinary: Regex(result), compilation: NamedThompsonCompilation(shape), lookaround: LookaroundCompilation(shape), layout: CaptureLayout, firstline_only: Bool, policy: NewlinePolicy, @erased _proof: NamedCompilationErasure(shape, compilation, erase_named_thompson(compilation))) -> NamedRegex(result, shape) =
    NamedRegex(ordinary, compilation, lookaround, layout, firstline_only, policy)

  type NamedPrefixCapture = NamedPrefixCapture(List(Char), List(Char), List(NamedCapture))

  fn named_full_capture({shape: ShapeCode}, compilation: NamedThompsonCompilation(shape), input: String, layout: CaptureLayout) -> Option(List(NamedCapture)) =
    let characters = Std.String.characters(input)
    match named_search_machine_acceptance(named_thompson_state_count(compilation), named_thompson_machine(compilation), subject_initial_position(), characters, [])
      NamedMachineNoPath() -> None()
      NamedMachinePath(routine) -> replay_named_capture_routine(routine, layout)

  fn named_prefix_capture_at({shape: ShapeCode}, compilation: NamedThompsonCompilation(shape), input: List(Char), greedy: Bool, position: InitialPosition, layout: CaptureLayout) -> Option(NamedPrefixCapture) =
    let result = pickup
      greedy -> named_search_last_prefix(named_thompson_state_count(compilation), named_thompson_machine(compilation), position, input)
      else -> named_search_first_prefix(named_thompson_state_count(compilation), named_thompson_machine(compilation), position, input)
    match result
      NamedNoPrefix() -> None()
      NamedPrefixPath(matched, remaining, routine) -> match replay_named_capture_routine(routine, layout)
        None() -> None()
        Some(captures) -> Some(NamedPrefixCapture(matched, remaining, captures))

  ## Named replay for a lookaround-aware compilation uses the same checked
  ## finite machine as assertion acceptance.  Unlike the typed path, the
  ## returned routine is retained long enough to replay capture slots,
  ## including slots opened and closed inside a positive assertion.
  fn named_lookaround_full_capture({shape: ShapeCode}, compilation: LookaroundCompilation(shape), input: String, layout: CaptureLayout, policy: NewlinePolicy) -> Option(List(NamedCapture)) =
    match lookaround_compiled(compilation)
      mk_pair(count, machine) -> match atomic_lookaround_routine_accepts(regex_assertion_depth_limit(), count, machine, subject_initial_position(), Std.String.characters(input), [], [], [], policy)
        None() -> None()
        Some(routine) -> replay_named_capture_routine(routine, layout)

  fn named_lookaround_prefix_capture_at({shape: ShapeCode}, compilation: LookaroundCompilation(shape), input: List(Char), greedy: Bool, position: InitialPosition, history: List(Char), layout: CaptureLayout, policy: NewlinePolicy) -> Option(NamedPrefixCapture) =
    match lookaround_compiled(compilation)
      mk_pair(count, machine) -> match atomic_lookaround_routine_prefix(regex_assertion_depth_limit(), count, machine, position, input, greedy, history, [], policy)
        None() -> None()
        Some(%[matched, remaining, routine]) -> match replay_named_capture_routine(routine, layout)
          None() -> None()
          Some(captures) -> Some(NamedPrefixCapture(matched, remaining, captures))

  fn empty() -> Regex(Unit) = FromPattern(UnitC, PatternEmpty())

  fn predicate(test: Char -> Bool) -> Regex(Char) =
    FromPattern(CharC, PatternPredicate(test))

  fn concatenate({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(Tuple(a, b)) =
    Concatenated(left, right)

  fn alternate({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(Choice(a, b)) =
    Alternated(left, right)

  fn repeat({a: Type}, regex: Regex(a)) -> Regex(List(a)) = Repeated(regex)

  fn map({a: Type}, {b: Type}, regex: Regex(a), transform: a -> b) -> Regex(b) =
    Mapped(transform, regex)

  fn discard_left({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(b) =
    KeptRight(left, right)

  fn discard_right({a: Type}, {b: Type}, left: Regex(a), right: Regex(b)) -> Regex(a) =
    KeptLeft(left, right)

  fn or_same({a: Type}, left: Regex(a), right: Regex(a)) -> Regex(a) =
    SameAlternative(left, right)

  fn optional({a: Type}, regex: Regex(a)) -> Regex(Option(a)) =
    OptionalRegex(regex)

  fn one_or_more({a: Type}, regex: Regex(a)) -> Regex(OneOrMore(a)) =
    OneOrMoreRegex(regex)

  fn captured({a: Type}, regex: Regex(a)) -> Regex(String) = MatchedText(regex)

  fn as_string({a: Type}, regex: Regex(a)) -> Regex(String) = MatchedText(regex)

  fn simplified(shape: ShapeCode, regex: Regex(Sem(shape))) -> Regex(Sem(Simplify(shape))) =
    SimplifiedRegex(shape, regex)

  fn optional_pattern({a: Type}, regex: Regex(a)) -> Regex(Choice(a, Unit)) = OptionalPattern(regex)

  fn plus_pattern({a: Type}, regex: Regex(a)) -> Regex(List(a)) = PlusPattern(regex)

  fn repeated_pattern({a: Type}, regex: Regex(a), lazy: Bool) -> Regex(List(a)) =
    RepeatedPattern(regex, lazy)

  fn one_or_more_pattern({a: Type}, regex: Regex(a), lazy: Bool) -> Regex(List(a)) =
    OneOrMorePattern(regex, lazy)

  fn optional_literal({a: Type}, regex: Regex(a), lazy: Bool) -> Regex(Choice(a, Unit)) =
    OptionalLiteral(regex, lazy)

  fn empty_repetition_transform({a: Type}, _: Regex(a)) -> (Unit -> List(a)) =
    fn(_) -> []

  fn prepend_repetition_result({a: Type}, value: Tuple(a, List(a))) -> List(a) = match value
    %[head, rest] -> [head | rest]

  fn prepend_optional_repetition_result({a: Type}, value: Tuple(Choice(a, Unit), List(a))) -> List(a) = match value
    %[choice, rest] -> match choice
      ChoseLeft(head) -> [head | rest]
      ChoseRight(_) -> rest

  fn bounded_exact_pattern({a: Type}, regex: Regex(a), count: Nat) -> Regex(List(a)) = match count
    Z() -> Mapped(empty_repetition_transform(regex), FromPattern(UnitC, PatternEmpty()))
    S(rest) -> Mapped(prepend_repetition_result, Concatenated(regex, bounded_exact_pattern(regex, rest)))

  fn bounded_at_least_pattern({a: Type}, regex: Regex(a), minimum: Nat, lazy: Bool) -> Regex(List(a)) = match minimum
    Z() -> repeated_pattern(regex, lazy)
    S(rest) -> Mapped(prepend_repetition_result, Concatenated(regex, bounded_at_least_pattern(regex, rest, lazy)))

  fn bounded_up_to_pattern({a: Type}, regex: Regex(a), maximum: Nat, lazy: Bool) -> Regex(List(a)) = match maximum
    Z() -> Mapped(empty_repetition_transform(regex), FromPattern(UnitC, PatternEmpty()))
    S(rest) -> Mapped(prepend_optional_repetition_result, Concatenated(optional_literal(regex, lazy), bounded_up_to_pattern(regex, rest, lazy)))

  fn bounded_between_pattern({a: Type}, regex: Regex(a), minimum: Nat, maximum: Nat, lazy: Bool) -> Regex(List(a)) = match minimum
    Z() -> bounded_up_to_pattern(regex, maximum, lazy)
    S(minimum_rest) -> match maximum
      Z() -> bounded_exact_pattern(regex, S(minimum_rest))
      S(maximum_rest) -> Mapped(prepend_repetition_result, Concatenated(regex, bounded_between_pattern(regex, minimum_rest, maximum_rest, lazy)))

  fn configured({a: Type}, options: RegexOptions, regex: Regex(a)) -> Regex(a) =
    ConfiguredRegex(options, regex)

  fn start_anchor() -> Regex(Unit) = StartAnchor(false)

  fn start_anchor_with_options(multiline: Bool) -> Regex(Unit) = StartAnchor(multiline)

  fn end_anchor() -> Regex(Unit) = EndAnchor(false)

  fn end_anchor_with_options(multiline: Bool) -> Regex(Unit) = EndAnchor(multiline)

  fn strict_end_anchor() -> Regex(Unit) = StrictEndAnchor()

  fn word_boundary(unicode: Bool, negated: Bool) -> Regex(Unit) = pickup
    unicode -> pickup
      negated -> FromPattern(UnitC, PatternBoundary(unicode_word_constraint(false)))
      else -> FromPattern(UnitC, PatternBoundary(unicode_word_constraint(true)))
    else -> pickup
      negated -> FromPattern(UnitC, PatternBoundary(ascii_word_constraint(false)))
      else -> FromPattern(UnitC, PatternBoundary(ascii_word_constraint(true)))

  fn always(_char: Char) -> Bool = true

  fn any_char() -> Regex(Char) = predicate(always)

  fn exact_predicate(expected: Char, actual: Char) -> Bool = Std.Char.same(expected, actual)

  fn exact_test(expected: Char) -> Char -> Bool = fn(actual) -> exact_predicate(expected, actual)

  fn discard_char(_char: Char) -> Unit = ()

  fn exactly(expected: Char) -> Regex(Unit) = map(predicate(exact_test(expected)), discard_char)

  fn same_chars(left: List(Char), right: List(Char)) -> Bool = match left
    [] -> match right
      [] -> true
      _ -> false
    [left_char | left_rest] -> match right
      [] -> false
      [right_char | right_rest] -> pickup
        Std.Char.same(left_char, right_char) -> same_chars(left_rest, right_rest)
        else -> false

  fn lowercased_characters(value: Char) -> List(Char) =
    Std.String.characters(Std.Char.lowercased(value))

  fn caseless_same(expected: Char, actual: Char, unicode: Bool) -> Bool = pickup
    unicode -> same_chars(lowercased_characters(expected), lowercased_characters(actual))
    else -> Std.Char.same(Std.Char.ascii_lowercased(expected), Std.Char.ascii_lowercased(actual))

  fn option_exact_predicate(expected: Char, caseless: Bool, unicode: Bool, actual: Char) -> Bool = pickup
    caseless -> caseless_same(expected, actual, unicode)
    else -> Std.Char.same(expected, actual)

  fn option_exact_test(expected: Char, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> option_exact_predicate(expected, caseless, unicode, actual)

  fn exactly_with_options(expected: Char, caseless: Bool, unicode: Bool) -> Regex(Unit) =
    map(predicate(option_exact_test(expected, caseless, unicode)), discard_char)

  fn dot_predicate(dotall: Bool, char: Char) -> Bool = pickup
    dotall -> true
    Std.Char.is_newline(char) -> false
    else -> true

  fn dot_test(dotall: Bool) -> Char -> Bool = fn(char) -> dot_predicate(dotall, char)
  fn dot_with_options(dotall: Bool) -> Regex(Char) = predicate(dot_test(dotall))

  fn dot_test_with_policy(dotall: Bool, policy: NewlinePolicy) -> Char -> Bool =
    fn(char) -> pickup
      dotall -> true
      newline_char(policy, char) -> false
      else -> true

  fn dot_with_policy(dotall: Bool, policy: NewlinePolicy) -> Regex(Char) = predicate(dot_test_with_policy(dotall, policy))

  fn contains_char(chars: List(Char), actual: Char) -> Bool = match chars
    [] -> false
    [head | rest] -> pickup
      Std.Char.same(head, actual) -> true
      else -> contains_char(rest, actual)

  fn contains_char_with_options(chars: List(Char), actual: Char, caseless: Bool, unicode: Bool) -> Bool = match chars
    [] -> false
    [head | rest] -> pickup
      caseless and caseless_same(head, actual, unicode) -> true
      Std.Char.same(head, actual) -> true
      else -> contains_char_with_options(rest, actual, caseless, unicode)

  fn set_test(chars: List(Char)) -> Char -> Bool = fn(actual) -> contains_char(chars, actual)

  fn one_of(chars: List(Char)) -> Regex(Char) = predicate(set_test(chars))

  fn range_predicate(first: Char, last: Char, actual: Char) -> Bool =
    Std.Char.between(actual, first, last)

  fn range_test(first: Char, last: Char) -> Char -> Bool =
    fn(actual) -> range_predicate(first, last, actual)

  fn range(first: Char, last: Char) -> Regex(Char) = predicate(range_test(first, last))

  fn in_ranges(ranges: List(CharacterRange), actual: Char) -> Bool = match ranges
    [] -> false
    [CharacterRange(first, last) | rest] -> pickup
      Std.Char.between(actual, first, last) -> true
      else -> in_ranges(rest, actual)

  fn folded_range_match(first: Char, last: Char, actual: Char, unicode: Bool) -> Bool = pickup
    Std.Char.between(actual, first, last) -> true
    unicode -> match Std.String.characters(Std.Char.lowercased(actual))
      [folded] -> Std.Char.between(folded, first, last)
      _ -> false
    else -> Std.Char.between(Std.Char.ascii_lowercased(actual), Std.Char.ascii_lowercased(first), Std.Char.ascii_lowercased(last))

  fn in_ranges_with_options(ranges: List(CharacterRange), actual: Char, caseless: Bool, unicode: Bool) -> Bool = match ranges
    [] -> false
    [CharacterRange(first, last) | rest] -> pickup
      caseless and folded_range_match(first, last, actual, unicode) -> true
      Std.Char.between(actual, first, last) -> true
      else -> in_ranges_with_options(rest, actual, caseless, unicode)

  fn class_predicate(chars: List(Char), ranges: List(CharacterRange), negated: Bool, actual: Char) -> Bool =
    let found = contains_char(chars, actual) or in_ranges(ranges, actual)
    pickup
      found == negated -> false
      else -> true

  fn class_test(chars: List(Char), ranges: List(CharacterRange), negated: Bool) -> Char -> Bool =
    fn(actual) -> class_predicate(chars, ranges, negated, actual)

  fn character_class(chars: List(Char), ranges: List(CharacterRange), negated: Bool) -> Regex(Char) =
    predicate(class_test(chars, ranges, negated))

  fn option_class_predicate(chars: List(Char), ranges: List(CharacterRange), negated: Bool, caseless: Bool, unicode: Bool, actual: Char) -> Bool =
    let found = contains_char_with_options(chars, actual, caseless, unicode) or in_ranges_with_options(ranges, actual, caseless, unicode)
    pickup
      found == negated -> false
      else -> true

  fn option_class_test(chars: List(Char), ranges: List(CharacterRange), negated: Bool, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> option_class_predicate(chars, ranges, negated, caseless, unicode, actual)

  fn character_class_with_options(chars: List(Char), ranges: List(CharacterRange), negated: Bool, caseless: Bool, unicode: Bool) -> Regex(Char) =
    predicate(option_class_test(chars, ranges, negated, caseless, unicode))

  fn class_kinds_match(kinds: ClassKinds, actual: Char, unicode: Bool) -> Bool = match kinds
    ClassKinds(digit, not_digit, word, not_word, space, not_space, horizontal, not_horizontal, vertical, not_vertical) ->
      (digit and option_digit(actual, unicode)) or
        (not_digit and not option_digit(actual, unicode)) or
        (word and option_word(actual, unicode)) or
        (not_word and not option_word(actual, unicode)) or
        (space and option_space(actual, unicode)) or
        (not_space and not option_space(actual, unicode)) or
        (horizontal and Std.Char.is_horizontal_space(actual)) or
        (not_horizontal and not Std.Char.is_horizontal_space(actual)) or
        (vertical and Std.Char.is_vertical_space(actual)) or
        (not_vertical and not Std.Char.is_vertical_space(actual))

  fn unicode_category_in(category: Atom, values: List(Atom)) -> Bool = match values
    [] -> false
    [head | rest] -> pickup
      category == head -> true
      else -> unicode_category_in(category, rest)

  fn unicode_property_matches(property: UnicodeProperty, actual: Char) -> Bool =
    let category = Std.Char.unicode_category(actual)
    match property
      PropertyNonNewline -> not Std.Char.is_newline(actual)
      PropertyAny -> true
      PropertyAscii -> Std.Char.is_ascii(actual)
      PropertyCased -> Std.Char.is_cased(actual)
      PropertyLowercase -> Std.Char.is_lowercase(actual)
      PropertyUppercase -> Std.Char.is_uppercase(actual)
      PropertyAlphabetic -> Std.Char.is_letter(actual)
      PropertyWhiteSpace -> Std.Char.is_unicode_space(actual)
      PropertyHexDigit -> Std.Char.is_hex_digit(actual)
      PropertyMath -> Std.Char.is_math_symbol(actual)
      PropertyCurrencyBinary -> Std.Char.is_currency_symbol(actual)
      PropertyScript(script) -> Std.Char.unicode_script(actual) == script
      PropertyScriptExtensions(script) -> Std.Char.unicode_script_extensions?(actual, script)
      PropertyBidiClass(bidi_class) -> Std.Char.unicode_bidi_class(actual) == bidi_class
      PropertyBidiPairedBracketType(bpt) -> Std.Char.unicode_bidi_paired_bracket_type?(actual, bpt)
      PropertyCategory(category) -> Std.Char.unicode_general_category?(actual, category)
      PropertyBinary(property) -> Std.Char.unicode_binary_property?(actual, property)
      PropertyLetter -> unicode_category_in(category, [:Lu, :Ll, :Lt, :Lm, :Lo])
      PropertyLowercaseLetter -> category == :Ll
      PropertyUppercaseLetter -> category == :Lu
      PropertyTitlecaseLetter -> category == :Lt
      PropertyModifierLetter -> category == :Lm
      PropertyOtherLetter -> category == :Lo
      PropertyMark -> unicode_category_in(category, [:Mc, :Me, :Mn])
      PropertySpacingMark -> category == :Mc
      PropertyEnclosingMark -> category == :Me
      PropertyNonspacingMark -> category == :Mn
      PropertyNumber -> unicode_category_in(category, [:Nd, :Nl, :No])
      PropertyDecimalNumber -> category == :Nd
      PropertyLetterNumber -> category == :Nl
      PropertyOtherNumber -> category == :No
      PropertyPunctuation -> unicode_category_in(category, [:Pc, :Pd, :Pe, :Pf, :Pi, :Po, :Ps])
      PropertyConnectorPunctuation -> category == :Pc
      PropertyDashPunctuation -> category == :Pd
      PropertyClosePunctuation -> category == :Pe
      PropertyFinalPunctuation -> category == :Pf
      PropertyInitialPunctuation -> category == :Pi
      PropertyOtherPunctuation -> category == :Po
      PropertyOpenPunctuation -> category == :Ps
      PropertySymbol -> unicode_category_in(category, [:Sc, :Sk, :Sm, :So])
      PropertyCurrencySymbol -> category == :Sc
      PropertyModifierSymbol -> category == :Sk
      PropertyMathSymbol -> category == :Sm
      PropertyOtherSymbol -> category == :So
      PropertySeparator -> unicode_category_in(category, [:Zl, :Zp, :Zs])
      PropertyLineSeparator -> category == :Zl
      PropertyParagraphSeparator -> category == :Zp
      PropertySpaceSeparator -> category == :Zs
      PropertyOther -> unicode_category_in(category, [:Cc, :Cf, :Cn, :Co, :Cs])
      PropertyControl -> category == :Cc
      PropertyFormat -> category == :Cf
      PropertyUnassigned -> category == :Cn
      PropertyPrivateUse -> category == :Co
      PropertySurrogate -> category == :Cs

  fn unicode_property_match_matches(value: UnicodePropertyMatch, actual: Char) -> Bool = match value
    UnicodePropertyMatch(property, negated) -> unicode_property_matches(property, actual) != negated

  fn unicode_property_matches_any(values: List(UnicodePropertyMatch), actual: Char) -> Bool = match values
    [] -> false
    [head | rest] -> pickup
      unicode_property_match_matches(head, actual) -> true
      else -> unicode_property_matches_any(rest, actual)

  fn ascii_alpha(actual: Char) -> Bool =
    Std.Char.between(actual, 'a', 'z') or Std.Char.between(actual, 'A', 'Z')

  fn ascii_alnum(actual: Char) -> Bool =
    ascii_alpha(actual) or ascii_digit(actual)

  fn ascii_blank(actual: Char) -> Bool =
    Std.Char.same(actual, ' ') or Std.Char.same(actual, '\t')

  fn ascii_control(actual: Char) -> Bool =
    Std.Char.is_ascii(actual) and Std.Char.unicode_category(actual) == :Cc

  fn ascii_graph(actual: Char) -> Bool =
    Std.Char.between(actual, '!', '~')

  fn ascii_print(actual: Char) -> Bool =
    Std.Char.between(actual, ' ', '~')

  fn ascii_punct(actual: Char) -> Bool =
    ascii_graph(actual) and not ascii_alnum(actual)

  fn unicode_alpha(actual: Char) -> Bool =
    unicode_property_matches(PropertyLetter, actual) or unicode_property_matches(PropertyMark, actual)

  fn unicode_alnum(actual: Char) -> Bool =
    unicode_alpha(actual) or unicode_property_matches(PropertyNumber, actual)

  fn unicode_graph(actual: Char) -> Bool =
    unicode_alnum(actual) or unicode_property_matches(PropertyPunctuation, actual) or unicode_property_matches(PropertySymbol, actual)

  fn unicode_print(actual: Char) -> Bool =
    unicode_graph(actual) or unicode_property_matches(PropertySpaceSeparator, actual)

  fn posix_class_matches(posix_class: PosixClass, actual: Char, unicode: Bool) -> Bool = match posix_class
    PosixAlnum -> pickup
      unicode -> unicode_alnum(actual)
      else -> ascii_alnum(actual)
    PosixAlpha -> pickup
      unicode -> unicode_alpha(actual)
      else -> ascii_alpha(actual)
    PosixAscii -> Std.Char.is_ascii(actual)
    PosixBlank -> pickup
      unicode -> Std.Char.is_horizontal_space(actual)
      else -> ascii_blank(actual)
    PosixCntrl -> pickup
      unicode -> Std.Char.unicode_category(actual) == :Cc
      else -> ascii_control(actual)
    PosixDigit -> option_digit(actual, unicode)
    PosixGraph -> pickup
      unicode -> unicode_graph(actual)
      else -> ascii_graph(actual)
    PosixLower -> pickup
      unicode -> Std.Char.is_lowercase(actual)
      else -> Std.Char.between(actual, 'a', 'z')
    PosixPrint -> pickup
      unicode -> unicode_print(actual)
      else -> ascii_print(actual)
    PosixPunct -> pickup
      unicode -> unicode_property_matches(PropertyPunctuation, actual)
      else -> ascii_punct(actual)
    PosixSpace -> option_space(actual, unicode)
    PosixUpper -> pickup
      unicode -> Std.Char.is_uppercase(actual)
      else -> Std.Char.between(actual, 'A', 'Z')
    PosixWord -> option_word(actual, unicode)
    PosixXdigit -> pickup
      unicode -> Std.Char.is_hex_digit(actual)
      else -> ascii_digit(actual) or Std.Char.between(actual, 'a', 'f') or Std.Char.between(actual, 'A', 'F')

  fn posix_class_match_matches(value: PosixClassMatch, actual: Char, unicode: Bool) -> Bool = match value
    PosixClassMatch(posix_class, negated) -> posix_class_matches(posix_class, actual, unicode) != negated

  fn posix_class_matches_any(values: List(PosixClassMatch), actual: Char, unicode: Bool) -> Bool = match values
    [] -> false
    [head | rest] -> pickup
      posix_class_match_matches(head, actual, unicode) -> true
      else -> posix_class_matches_any(rest, actual, unicode)

  fn unicode_property_test(property: UnicodeProperty, negated: Bool) -> Char -> Bool =
    fn(actual) -> unicode_property_matches(property, actual) != negated

  fn unicode_property_class(property: UnicodeProperty, negated: Bool) -> Regex(Char) =
    predicate(unicode_property_test(property, negated))

  fn extended_class_predicate(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, negated: Bool, caseless: Bool, unicode: Bool, actual: Char) -> Bool =
    let found =
      contains_char_with_options(chars, actual, caseless, unicode) or
        in_ranges_with_options(ranges, actual, caseless, unicode) or
        class_kinds_match(kinds, actual, unicode)
    found != negated

  fn extended_class_test(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, negated: Bool, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> extended_class_predicate(chars, ranges, kinds, negated, caseless, unicode, actual)

  fn extended_character_class(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, negated: Bool, caseless: Bool, unicode: Bool) -> Regex(Char) =
    predicate(extended_class_test(chars, ranges, kinds, negated, caseless, unicode))

  fn extended_property_class_predicate(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, properties: List(UnicodePropertyMatch), posix: List(PosixClassMatch), negated: Bool, caseless: Bool, unicode: Bool, actual: Char) -> Bool =
    let found =
      contains_char_with_options(chars, actual, caseless, unicode) or
        in_ranges_with_options(ranges, actual, caseless, unicode) or
        class_kinds_match(kinds, actual, unicode) or
        unicode_property_matches_any(properties, actual) or
        posix_class_matches_any(posix, actual, unicode)
    found != negated

  fn extended_property_class_test(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, properties: List(UnicodePropertyMatch), posix: List(PosixClassMatch), negated: Bool, caseless: Bool, unicode: Bool) -> Char -> Bool =
    fn(actual) -> extended_property_class_predicate(chars, ranges, kinds, properties, posix, negated, caseless, unicode, actual)

  fn extended_unicode_property_class(chars: List(Char), ranges: List(CharacterRange), kinds: ClassKinds, properties: List(UnicodePropertyMatch), posix: List(PosixClassMatch), negated: Bool, caseless: Bool, unicode: Bool) -> Regex(Char) =
    predicate(extended_property_class_test(chars, ranges, kinds, properties, posix, negated, caseless, unicode))

  fn ascii_digit(char: Char) -> Bool = Std.Char.between(char, '0', '9')

  fn ascii_word(char: Char) -> Bool =
    Std.Char.between(char, 'a', 'z') or
      Std.Char.between(char, 'A', 'Z') or
      Std.Char.between(char, '0', '9') or
      Std.Char.same(char, '_')

  fn ascii_space(char: Char) -> Bool =
    Std.Char.same(char, ' ') or Std.Char.same(char, '\t') or
      Std.Char.same(char, '\n') or Std.Char.same(char, '\r') or
      Std.Char.same(char, '\f') or Std.Char.same(char, '\v')

  fn negate_test(test: Char -> Bool) -> Char -> Bool = fn(char) -> not test(char)

  fn digit_class(negated: Bool) -> Regex(Char) = pickup
    negated -> predicate(negate_test(ascii_digit))
    else -> predicate(ascii_digit)

  fn option_digit(char: Char, unicode: Bool) -> Bool = pickup
    unicode -> Std.Char.is_unicode_digit(char)
    else -> ascii_digit(char)

  fn option_word(char: Char, unicode: Bool) -> Bool = pickup
    unicode -> Std.Char.is_unicode_word(char)
    else -> ascii_word(char)

  fn option_space(char: Char, unicode: Bool) -> Bool = pickup
    unicode -> Std.Char.is_unicode_space(char)
    else -> ascii_space(char)

  fn option_class_negated(test: Char -> Bool, negated: Bool, char: Char) -> Bool = pickup
    negated -> not test(char)
    else -> test(char)

  fn digit_option_predicate(negated: Bool, unicode: Bool, char: Char) -> Bool = pickup
    negated -> not option_digit(char, unicode)
    else -> option_digit(char, unicode)

  fn word_option_predicate(negated: Bool, unicode: Bool, char: Char) -> Bool = pickup
    negated -> not option_word(char, unicode)
    else -> option_word(char, unicode)

  fn space_option_predicate(negated: Bool, unicode: Bool, char: Char) -> Bool = pickup
    negated -> not option_space(char, unicode)
    else -> option_space(char, unicode)

  fn digit_options_test(negated: Bool, unicode: Bool) -> Char -> Bool = fn(char) -> digit_option_predicate(negated, unicode, char)
  fn word_options_test(negated: Bool, unicode: Bool) -> Char -> Bool = fn(char) -> word_option_predicate(negated, unicode, char)
  fn space_options_test(negated: Bool, unicode: Bool) -> Char -> Bool = fn(char) -> space_option_predicate(negated, unicode, char)

  fn digit_class_with_options(negated: Bool, unicode: Bool) -> Regex(Char) = predicate(digit_options_test(negated, unicode))
  fn word_class_with_options(negated: Bool, unicode: Bool) -> Regex(Char) = predicate(word_options_test(negated, unicode))
  fn space_class_with_options(negated: Bool, unicode: Bool) -> Regex(Char) = predicate(space_options_test(negated, unicode))

  fn horizontal_predicate(negated: Bool, char: Char) -> Bool = pickup
    negated -> not Std.Char.is_horizontal_space(char)
    else -> Std.Char.is_horizontal_space(char)

  fn vertical_predicate(negated: Bool, char: Char) -> Bool = pickup
    negated -> not Std.Char.is_vertical_space(char)
    else -> Std.Char.is_vertical_space(char)

  fn horizontal_test(negated: Bool) -> Char -> Bool = fn(char) -> horizontal_predicate(negated, char)
  fn vertical_test(negated: Bool) -> Char -> Bool = fn(char) -> vertical_predicate(negated, char)
  fn horizontal_class(negated: Bool) -> Regex(Char) = predicate(horizontal_test(negated))
  fn vertical_class(negated: Bool) -> Regex(Char) = predicate(vertical_test(negated))

  fn word_class(negated: Bool) -> Regex(Char) = pickup
    negated -> predicate(negate_test(ascii_word))
    else -> predicate(ascii_word)

  fn space_class(negated: Bool) -> Regex(Char) = pickup
    negated -> predicate(negate_test(ascii_space))
    else -> predicate(ascii_space)
