    AtomicPathMembersNo(_, tail_failure) -> AtomicPathMembersNo(witness, atomic_path_destination_rejected_evidence(machine, char, rest, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate, child_capture_context, child_scope_depth, whole, remaining, cursor, witness, member_here(candidate, remaining), canonical, child_whole, child_current, child_failure, child_scope_alignment, tail_failure))
    AtomicPathMembersEscapedNo(skipped, tail_current, witness, failure) -> AtomicPathMembersEscapedNo([candidate | skipped], tail_current, witness, failure)
    AtomicPathMembersCommit(commit_depth) -> AtomicPathMembersCommit(commit_depth)
    AtomicPathMembersYes(matched, remaining_input, routine, selected_whole, selected_current, selection_suffix, selected_whole_equivalence, trace) -> AtomicPathMembersYes(matched, remaining_input, routine, Cons(candidate, selected_whole), selected_current, LookaroundAdmittedStateCursorSuffixDrop(candidate, selection_suffix), lookaround_admitted_state_cons_equivalent(candidate, selected_whole_equivalence), trace)

  fn atomic_lookaround_routine_after_failure(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), candidate: LookaroundAdmittedState(n), child_capture_context: List(EvidenceInstruction), child_scope_depth: Nat, @erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth), closed_depth: Option(Nat), @erased child_whole: List(LookaroundAdmittedState(n)), @erased child_current: List(LookaroundAdmittedState(n)), @erased child_witness: LookaroundAdmittedStateCursorWitness(n, child_whole, child_current), @erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(candidate, remaining)), @erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(candidate, remaining)), @erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), @erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current)) -> AtomicPathMembersResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining)) = match closed_depth
