  type LookaroundRoutineSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char))
    LookaroundRoutineSearchNo : {@erased whole: List(LookaroundAdmittedState(n))} -> (@erased failure: AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)
    LookaroundRoutineSearchCommit : (commit_depth: Nat) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)
    LookaroundRoutineSearchYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> {@erased blocked_depth: Option(Nat)} -> {@erased kind: AtomicStartSkipKind} -> (trace_package: AtomicSelectedTraceExistentialPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining, routine)) -> (@erased witness: AtomicSelectedStartWitness(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, selected_start, blocked_depth, kind, matched, remaining, routine)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)








  @reducible
  fn atomic_scope_effect(routine: List(EvidenceInstruction), depth: Nat) -> AtomicScopeEffect = match routine
    [] -> AtomicScopeEffect(depth, None())
    [BeginAtomic() | rest] -> match atomic_scope_effect(rest, S(depth))
      AtomicScopeEffect(next_depth, closed) -> AtomicScopeEffect(next_depth, closed)
    [EndAtomic() | rest] -> match depth
      Z() -> atomic_scope_effect(rest, depth)
      S(previous) -> match atomic_scope_effect(rest, previous)
        AtomicScopeEffect(next_depth, closed) -> match closed
          None() -> AtomicScopeEffect(next_depth, Some(S(previous)))
          Some(existing) -> AtomicScopeEffect(next_depth, Some(existing))
    [_ | rest] -> atomic_scope_effect(rest, depth)




  fn atomic_runtime_accepting_from(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), evidence: List(Evidence), captures: List(CaptureFrame), depth: Nat) -> AtomicSearchResult = match input
    [] -> match state
      ThreadAccepted() -> AtomicSearchYes()
      ThreadActive(_) -> AtomicSearchNo()
    [char | rest] -> match machine
      MkPatternMachine(_, next) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, state, evidence, captures, depth, filter_boundary_states(next_for_thread(n, next, state, char), transition_boundary_before(char, rest, after_input)))

  @reducible
  fn next_for_thread(n: Nat, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: ThreadState(n), char: Char) -> List(MachineState(n)) = match state
    ThreadAccepted() -> []
    ThreadActive(active) -> next(active, char)

  fn atomic_runtime_accepting_members(n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), source_evidence: List(Evidence), source_captures: List(CaptureFrame), depth: Nat, destinations: List(MachineState(n))) -> AtomicSearchResult = match destinations
    [] -> AtomicSearchNo()
    [Active(state, routine, _) | remaining] -> match execute_routine(routine, source_evidence, record_capture_char(source_captures, char))
      EvidenceExecution(next_evidence, next_captures) -> match atomic_scope_effect(routine, depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_runtime_accepting_from(n, machine, rest, after_input, ThreadActive(state), next_evidence, next_captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
    [Accepted(routine, _) | remaining] -> match execute_routine(routine, source_evidence, record_capture_char(source_captures, char))
      EvidenceExecution(next_evidence, next_captures) -> match atomic_scope_effect(routine, depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_runtime_accepting_from(n, machine, rest, after_input, ThreadAccepted(), next_evidence, next_captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)

  fn atomic_runtime_initial_members(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), starts: List(MachineState(n))) -> AtomicSearchResult =
    atomic_runtime_initial_members_with_commit(n, machine, input, after_input, None(), starts)

  fn atomic_runtime_initial_members_with_commit(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), blocked_depth: Option(Nat), starts: List(MachineState(n))) -> AtomicSearchResult = match starts
    [] -> AtomicSearchNo()
    [head | remaining] -> match blocked_depth
      Some(commit_depth) -> match atomic_commit_disposition(atomic_scope_max_depth(machine_state_routine(n, head), Z()), commit_depth)
        AtomicCommitBlocks(_) -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, blocked_depth, remaining)
        AtomicCommitEscapes(_) -> atomic_runtime_initial_member(n, machine, input, after_input, blocked_depth, head, remaining)
      None() -> atomic_runtime_initial_member(n, machine, input, after_input, blocked_depth, head, remaining)

  fn atomic_runtime_initial_member(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), blocked_depth: Option(Nat), head: MachineState(n), remaining: List(MachineState(n))) -> AtomicSearchResult = match head
    Active(state, routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_runtime_accepting_from(n, machine, input, after_input, ThreadActive(state), evidence, captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, blocked_depth, remaining)
    Accepted(routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_runtime_accepting_from(n, machine, input, after_input, ThreadAccepted(), evidence, captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, blocked_depth, remaining)

  fn atomic_runtime_accepts(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> Bool = match machine
    MkPatternMachine(starts, _) -> match atomic_runtime_initial_members(n, machine, input, after_input, filter_boundary_states(starts, initial_position_boundary(position, append_characters(input, after_input))))
      AtomicSearchYes() -> true
      AtomicSearchNo() -> false
      AtomicSearchCommit(_) -> false

  ## Atomic assertion search is the same finite ordered search as the ordinary
  ## assertion path, but every destination is first passed through the
  ## depth-aware lookaround constraint filter. This is what makes an assertion
  ## inside an atomic scope observable without introducing a host backtracking
  ## stack or rebuilding a child machine per attempt.
  fn atomic_lookaround_accepting_from(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat) -> AtomicSearchResult = match input
    [] -> match state
      ThreadAccepted() -> AtomicSearchYes()
      ThreadActive(_) -> AtomicSearchNo()
    [char | rest] -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, state, history, capture_context, policy, scope_depth, lookaround_machine_destinations(depth, n, machine, state, char, rest, after_input, history, capture_context, policy))

  fn atomic_lookaround_accepting_members(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, destinations: List(MachineState(n))) -> AtomicSearchResult = match destinations
    [] -> AtomicSearchNo()
    [Active(state, routine, _) | remaining] -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, scope_depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_lookaround_accepting_from(depth, n, machine, rest, after_input, ThreadActive(state), history_push_bounded(history, char), append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
    [Accepted(routine, _) | remaining] -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, scope_depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_lookaround_accepting_from(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)

  fn atomic_lookaround_initial_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), starts: List(MachineState(n))) -> AtomicSearchResult = match starts
    [] -> AtomicSearchNo()
    [head | remaining] -> match blocked_depth
      Some(commit_depth) -> match atomic_commit_disposition(atomic_scope_max_depth(machine_state_routine(n, head), Z()), commit_depth)
        AtomicCommitBlocks(_) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)
        AtomicCommitEscapes(_) -> atomic_lookaround_initial_member(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, head, remaining)
      None() -> atomic_lookaround_initial_member(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, head, remaining)

  fn atomic_lookaround_initial_member(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), head: MachineState(n), remaining: List(MachineState(n))) -> AtomicSearchResult = match head
    Active(state, routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_lookaround_accepting_from(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)
    Accepted(routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_lookaround_accepting_from(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)

  ## The capture replay evaluator mirrors the atomic lookaround search above.
  ## It is deliberately separate from the Boolean evaluator: preserving the
  ## selected routine must not alter the acceptance authority used by typed
  ## extraction. Every successful branch prepends the observed character and
  ## epsilon routine in the same order as the certified extended path.
  ## `prefix` changes only the acceptance point: a prefix search may close as
  ## soon as the ordered machine reaches `ThreadAccepted`, even when input
  ## remains.  The machine's start/destination order still chooses the path,
  ## so lazy repeats and ordered alternation are preserved by the same DFS.
  ## `reversed_prefix` records exactly the characters consumed on that path;
  ## the result also carries the unconsumed suffix so callers never reconstruct
  ## it by retrying every possible endpoint.
  fn atomic_path_input_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicPathFailureInputExhausted()) = AtomicPathInputExhausted(LookaroundAdmittedStateCursorWitnessHere(), empty_lookaround_admitted_cursor_suffix(n))

  fn atomic_path_exact_accepted_with_input_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), Nil(), AtomicPathFailureExactAccepted()) = AtomicPathExactAcceptedWithInput(char, rest, LookaroundAdmittedStateCursorWitnessHere(), empty_lookaround_admitted_cursor_suffix(n))

  fn atomic_path_no_exact_accepted_with_input({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathNoEvidence(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), Nil(), AtomicPathFailureExactAccepted()) = AtomicPathNoExactAcceptedWithInput()

  fn atomic_path_no_input_exhausted({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathNoEvidence(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicPathFailureInputExhausted()) = AtomicPathNoInputExhausted()

  fn atomic_path_root_exact_accepted_with_input_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathRootRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), AtomicPathFailureExactAccepted()) = AtomicPathRootRefutation(reflexive(empty_lookaround_admitted_states(n)), AtomicPathSearchOriginAccepted(), atomic_path_exact_accepted_with_input_evidence(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix), atomic_path_no_exact_accepted_with_input(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix))

  fn atomic_path_root_input_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted()) = AtomicPathRootRefutation(reflexive(empty_lookaround_admitted_states(n)), AtomicPathSearchOriginActiveEmpty(), atomic_path_input_exhausted_evidence(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix), atomic_path_no_input_exhausted(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix))

  fn atomic_path_root_exact_accepted_with_input_search({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix) = AtomicPathSearchRootExactNo(AtomicPathFailureExactAccepted(), atomic_path_root_exact_accepted_with_input_evidence(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix))

  fn atomic_path_search_root_active_no({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), @erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted())) -> AtomicPathSearchResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = AtomicPathSearchRootActiveInputExhaustedNo(source, failure)

  fn atomic_path_root_input_exhausted_search({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = atomic_path_search_root_active_no(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, atomic_path_root_input_exhausted_evidence(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix))

  fn atomic_path_destinations_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, cursor: LookaroundAdmittedStateCursor(n, whole, Nil()), witness: LookaroundAdmittedStateCursorWitness(n, whole, Nil()), suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Nil()), canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil(), AtomicPathFailureDestinationsExhausted()) = AtomicPathDestinationsExhausted(char, rest, cursor, witness, suffix, canonical)

  fn atomic_path_destination_rejected_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), candidate: LookaroundAdmittedState(n), child_capture_context: List(EvidenceInstruction), @erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context), child_scope_depth: Nat, whole: List(LookaroundAdmittedState(n)), @erased remaining: List(LookaroundAdmittedState(n)), @erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(candidate, remaining)), @erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(candidate, remaining)), @erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Cons(candidate, remaining)), @erased edge: ListMember(LookaroundAdmittedState(n), candidate, Cons(candidate, remaining)), @erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), @erased child_whole: List(LookaroundAdmittedState(n)), @erased child_current: List(LookaroundAdmittedState(n)), @erased child_prefix_kind: AtomicPathFailurePrefixKind, @erased child_prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_prefix_kind), @erased child_origin: List(LookaroundAdmittedState(n)), @erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin), @erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_origin), @erased child_kind: AtomicPathFailureKind, @erased child_evidence: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind), @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current), @erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth), @erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, remaining), @erased tail_origin: List(LookaroundAdmittedState(n)), @erased tail_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, tail_origin), @erased tail_kind: AtomicPathFailureKind, @erased tail_failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), AtomicPathFailureDestinationRejected()) = AtomicPathDestinationRejected(char, rest, candidate, child_scope_depth, remaining, cursor, witness, suffix, edge, canonical, child_context_alignment, child_prefix_kind, child_prefix, child_origin_equivalence, child_origin_canonical, child_kind, child_evidence, child_suffix, child_scope_alignment, tail_suffix, tail_origin_equivalence, tail_kind, tail_failure)

  ## Extract the typed sibling-tail package from a rejected destination.  The
  ## parent failure kind and current spine are already fixed by this function's
  ## index, so the single constructor match is proof-only and emits no runtime
  ## failure classification.
  fn atomic_path_destination_rejected_tail_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    @erased evidence: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    )
  ) -> AtomicPathRejectedTailAt(
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(source),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = match evidence
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) -> AtomicPathTailPackagePacked(tail_failure)

  ## Refine a non-empty existential tail at its proof-only construction
  ## boundary.  A tail package whose current spine starts with `candidate`
  ## can only contain a destination-rejection refutation.  The contradiction
  ## is consumed here rather than returned as an erased runtime value.
  @reducible
  fn atomic_path_rejected_tail_refinement(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil())
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match package
    AtomicPathTailPackagePacked(failure) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        atomic_path_destinations_exhausted_tail_refinement(
          machine,
          char,
          rest,
          after_input,
          source,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          atomic_path_destination_rejected_tail_package(
            machine,
            char,
            rest,
            after_input,
            source,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            failure
          ),
          matched,
          remaining_input,
          routine,
          LookaroundAdmittedStateCursorSuffixHere(
            reflexive(empty_lookaround_admitted_states(n))
          ),
          path
        )

  ## Consume the selected-tail package produced by a two-sibling rejected
  ## destination.  The parent construction site has already fixed the
  ## selected cursor to the empty tail, so the dispatch can only carry the
  ## recursive package for `candidate`; refining that package reuses the
  ## existing singleton tail contradiction without rebuilding its failure.
  @reducible
  fn atomic_path_rejected_tail_dispatch_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    dispatch: AtomicPathSelectedTailDispatch(
      Empty,
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil()),
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match dispatch
    AtomicPathSelectedTailHead(value) -> lookaround_absurd(value)
    AtomicPathSelectedTailTail(package) -> match package
      AtomicPathSelectedTailPackagePacked(tail_package, _tail_suffix, path) ->
        atomic_path_rejected_tail_refinement(
          machine,
          char,
          rest,
          after_input,
          source,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          candidate,
          tail_package,
          matched,
          remaining_input,
          routine,
          path
        )

  ## Consume the selected-tail package after the outer candidate and one
  ## nested candidate have both been rejected.  The package's remaining
  ## cursor is exactly `Cons(nested_candidate, Cons(tail_candidate, Nil()))`;
  ## refining its destination-rejection branch constructs the final singleton
  ## package from the same failure tree and hands it to the existing
  ## contradiction.  All package fields remain erased.
  @reducible
  fn atomic_path_rejected_tail_dispatch_excludes_nested_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    nested_candidate: LookaroundAdmittedState(n),
    tail_candidate: LookaroundAdmittedState(n),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    dispatch: AtomicPathSelectedTailDispatch(
      Empty,
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(nested_candidate, Cons(tail_candidate, Nil())),
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match dispatch
    AtomicPathSelectedTailHead(value) -> lookaround_absurd(value)
    AtomicPathSelectedTailTail(package) -> match package
      AtomicPathSelectedTailPackagePacked(_tail_package, _tail_suffix, path) ->
        match _tail_package
          AtomicPathTailPackagePacked(tail_failure) -> match tail_failure
            AtomicPathInputExhausted(_, _) -> impossible
            AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
            AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
            AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
              atomic_path_rejected_tail_refinement(
                machine,
                char,
                rest,
                after_input,
                source,
                history,
                capture_context,
                policy,
                scope_depth,
                prefix_mode,
                reversed_prefix,
                whole,
                tail_candidate,
                atomic_path_destination_rejected_tail_package(
                  machine,
                  char,
                  rest,
                  after_input,
                  source,
                  history,
                  capture_context,
                  policy,
                  scope_depth,
                  prefix_mode,
                  reversed_prefix,
                  tail_failure
                ),
                matched,
                remaining_input,
                routine,
                path
              )

  ## Consume an arbitrary-length rejected destination tail from the typed
  ## package boundary.  Keeping the package as an erased argument preserves
  ## the construction-site elimination discipline used by the shorter tail
  ## consumers below.
  @reducible
  fn atomic_path_rejected_tail_package_step(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {@erased remaining: List(LookaroundAdmittedState(n))},
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining)
    )
  ) -> AtomicPathTailPackage(
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(state),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = match package
    AtomicPathTailPackagePacked(failure) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) -> AtomicPathTailPackagePacked(tail_failure)

  @reducible
  fn atomic_path_rejected_tail_fold_from_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased remaining: List(LookaroundAdmittedState(n))},
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      Nil()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> match package
        AtomicPathTailPackagePacked(failure) -> match failure
          AtomicPathInputExhausted(_, _) -> impossible
          AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
          AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> atomic_path_failure_excludes_aligned_trace(
            machine,
            char,
            rest,
            after_input,
            state,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            whole,
            failure,
            matched,
            remaining_input,
            routine,
            LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n))),
            path
          )
          AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    LookaroundAdmittedStateCursorSuffixDrop(next, tail_suffix) ->
      let tail_package = atomic_path_rejected_tail_package_step(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        next,
        package
      )
      atomic_path_rejected_tail_fold_from_package(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        tail_package,
        matched,
        remaining_input,
        routine,
        tail_suffix,
        path
      )

  ## Recursively consume rejected destination siblings until the selected
  ## sibling is accepted.  The selected path's head index excludes active
  ## transitions at this boundary; an exact accepted-child failure is then
  ## discharged by the canonical exact-child eliminator.
  @reducible
  fn atomic_path_rejected_tail_fold_to_accepted(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {selected_remaining: List(LookaroundAdmittedState(n))},
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> match failure
        AtomicPathInputExhausted(_, _) -> impossible
        AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
        AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, _, child_scope_alignment, _, _, _, _) -> match path
          AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
          AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> match child_scope_alignment
            LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match child_failure
              AtomicPathExactAcceptedWithInput(_, _, _, _) -> atomic_path_failure_excludes_selected_suffix(
                machine,
                char,
                rest,
                after_input,
                ThreadActive(state),
                history,
                capture_context,
                policy,
                scope_depth,
                reversed_prefix,
                accepted_routine,
                accepted_constraints,
                accepted_assertion_routine,
                accepted_assertion_markers,
                accepted_nested_decisions,
                child_failure,
                path
              )
    LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) ->
      match failure
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) ->
          atomic_path_rejected_tail_fold_to_accepted_from_failure(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
          reversed_prefix,
          whole,
          tail_failure,
        accepted_routine,
        accepted_constraints,
        accepted_assertion_routine,
        accepted_assertion_markers,
        accepted_nested_decisions,
        tail_suffix,
        path
          )

  ## Recurse through a rejected sibling tail until the selected accepted
  ## sibling is at its head. The refutation is consumed directly at each
  ## constructor boundary, so the existential tail failure never needs a
  ## runtime package or a special-case wrapper.
  @reducible
  fn atomic_path_rejected_tail_fold_to_accepted_from_failure(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathFailureKind},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      kind
    ),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {selected_remaining: List(LookaroundAdmittedState(n))},
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> match failure
        AtomicPathInputExhausted(_, _) -> impossible
        AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
        AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, _, child_scope_alignment, _, _, _, tail_failure) -> match path
          AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> match child_scope_alignment
            LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match child_failure
              AtomicPathExactAcceptedWithInput(_, _, _, _) -> atomic_path_failure_excludes_selected_suffix(
                machine,
                char,
                rest,
                after_input,
                ThreadActive(state),
                history,
                capture_context,
                policy,
                scope_depth,
                reversed_prefix,
                accepted_routine,
                accepted_constraints,
                accepted_assertion_routine,
                accepted_assertion_markers,
                accepted_nested_decisions,
                child_failure,
                path
              )
    LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) ->
        atomic_path_rejected_tail_fold_to_accepted_from_failure(
          machine,
          char,
          rest,
          after_input,
          state,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          tail_failure,
          accepted_routine,
          accepted_constraints,
          accepted_assertion_routine,
          accepted_assertion_markers,
          accepted_nested_decisions,
          tail_suffix,
          path
        )

  ## Consume an arbitrary-length rejected destination tail.  Unlike the
  ## historical two- and three-sibling helpers above, this fold recurses on
  ## the indexed tail spine itself.  The selected trace is fixed at `Nil()`;
  ## each `Drop` suffix therefore transports exactly the next tail cursor, and
  ## the recursive call refines the existential tail failure at that same
  ## construction site.  The final empty tail is discharged by the aligned
  ## destination-exhaustion eliminator.  All arguments carrying failure,
  ## cursor, and path evidence remain erased.
  @reducible
  fn atomic_path_rejected_tail_fold_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    remaining: List(LookaroundAdmittedState(n)),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      Nil()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> impossible
    LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) ->
      let tail_package: AtomicPathTailPackage(
        depth,
        n,
        machine,
        Cons(char, rest),
        after_input,
        ThreadActive(state),
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        remaining
      ) = atomic_path_destination_rejected_tail_package(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        failure
      )
      atomic_path_rejected_tail_fold_from_package(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        tail_package,
        matched,
        remaining_input,
        routine,
        tail_suffix,
        path
      )

  ## The empty-tail counterpart fixes the existential package's kind at the
  ## destination-exhaustion constructor.  It is used only after a rejected
  ## sibling has been refined, so the nested proof consumes the actual tail
  ## package rather than manufacturing an exhaustion witness.
  @reducible
  fn atomic_path_destinations_exhausted_tail_refinement(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased tail_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Nil(),
      Nil()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = atomic_path_tail_package_destinations_exhausted_excludes_trace(
    machine,
    char,
    rest,
    after_input,
    source,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    package,
    matched,
    remaining_input,
    routine,
    tail_suffix,
    path
  )


