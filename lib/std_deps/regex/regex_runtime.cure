  ## A later selected start is carried through an active head of a non-empty
  ## rejected tail.  The parent rejection/evidence and the explicit empty-child
  ## certificate stay erased at this construction site; the root package is
  ## checked through its proof-only gate before the indexed active-head
  ## eliminator is invoked.
  @reducible
  fn atomic_start_rejected_member_there_nonempty_tail_active_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    @erased package: AtomicStartActiveRootTailProofPackage(
      depth,
      n,
      machine,
      position,
      capture_context,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      after_input,
      history,
      policy,
      prefix_mode,
      reversed_prefix,
      ThreadActive(state),
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      atomic_scope_depth_after(routine, Z())
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = let head_case: result = match package
      AtomicStartActiveRootTailProofPackagePacked(
        _,
        child_failure
      ) -> atomic_start_rejected_member_there_active_tail_head_excludes_trace(
        machine,
        position,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        state,
        routine,
        constraints,
        assertion_routine,
        assertion_markers,
        nested_decisions,
        membership,
        child_failure,
        empty_lookaround_admitted_cursor_suffix(n),
        failure,
        evidence,
        path,
        selected_path,
        tail_case
      )
    atomic_start_rejected_member_induction_selected_erased(
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      failure,
      evidence,
      membership,
      selected_path,
      head_case,
      tail_case
    )

  ## The accepted-head counterpart carries the exact child character/rest and
  ## forwards the indexed exact-accepted child refutation.  The accepted
  ## candidate is only valid in exact mode, so the parent and selected-trace
  ## indices fix `prefix_mode` to `False()` instead of recovering it at runtime.
  fn atomic_start_rejected_member_there_accepted_tail_head_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureExactAccepted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = let head_case: result = match evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        atomic_start_tail_accepted_candidate_rejection_excludes_trace(
          machine,
          position,
          child_char,
          child_rest,
          after_input,
          history,
          capture_context,
          policy,
          reversed_prefix,
          accepted_routine,
          accepted_constraints,
          accepted_assertion_routine,
          accepted_assertion_markers,
          accepted_nested_decisions,
          child_failure,
          child_suffix,
          evidence,
          path
        )
    atomic_start_rejected_member_induction_selected_erased(
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      failure,
      evidence,
      membership,
      selected_path,
      head_case,
      tail_case
    )

  ## Root accepted candidates with non-empty input use the same exact-child
  ## contradiction as accepted heads in a rejected tail.  Keeping this bridge
  ## separate names the root construction site while preserving the indexed
  ## child failure, cursor suffix, and proof-only sibling continuation.
  @reducible
  fn atomic_start_refutation_rejected_accepted_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
