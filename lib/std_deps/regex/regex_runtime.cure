  ## Public atomic-start failures are complete root certificates. Internal
  ## recursion retains the exact whole/current start-list suffix; only the
  ## root wrapper is exposed at the lookaround decision boundary.
  type AtomicStartRefutation(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)))
    AtomicStartRefutationRoot : {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased kind: AtomicStartFailureKind} -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, whole, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, whole, kind)) -> AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole)

  ## A decision is the only value consumed by an assertion constraint. A
  ## satisfied branch now carries an existential package containing the finite
  ## child path. Refuted branches still record the finite-search outcome (or
  ## an explicit resource/history boundary). The search refutation retains the
  ## complete child and sibling traversal tree; the remaining work is to prove
  ## its soundness and completeness against the machine semantics.
  type LookaheadRefutation(n: Nat, machine: PatternMachine(n)) indices ()
    LookaheadSearchExhausted : {@erased starts: List(MachineState(n))} -> (@erased depth: Nat) -> (input: List(Char)) -> (after_input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaheadRefutation(n, machine)
    LookaheadAtomicSearchRejected : (@erased depth: Nat) -> (position: InitialPosition) -> (input: List(Char)) -> (history: List(Char)) -> (@erased capture_context: List(EvidenceInstruction)) -> (policy: NewlinePolicy) -> {@erased whole: List(LookaroundAdmittedState(n))} -> (@erased failure: Option(AtomicStartRefutation(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil(), whole))) -> (reason: LookaroundRoutineRejectionReason) -> LookaheadRefutation(n, machine)

  ## A successful atomic start is only useful as a proof when its selected
  ## trace is tied to the membership witness that chose the start.  The
  ## current list is existential proof data: it is retained in the package
  ## but never becomes a runtime result field.  The allowed selection proof is
  ## retained beside the membership and trace so a later rejected-tail proof
  ## can distinguish a genuinely selected candidate from a blocked one.
  type AtomicSelectedStartWitness(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), selected_start: LookaroundAdmittedState(n), blocked_depth: Option(Nat), kind: AtomicStartSkipKind, matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicSelectedStartWitnessPacked : (@erased whole: List(LookaroundAdmittedState(n))) -> (@erased current: List(LookaroundAdmittedState(n))) -> {@erased blocked_depth: Option(Nat)} -> {@erased kind: AtomicStartSkipKind} -> (@erased allowed: AtomicStartAllowed(blocked_depth, kind)) -> (@erased scope: AtomicStartScopeEvidence(n, AtomicStartScopeEvidenceAllowedRole())) -> (@erased selected_member: ListMember(LookaroundAdmittedState(n), selected_start, current)) -> (@erased selected_trace: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)) -> AtomicSelectedStartWitness(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, selected_start, blocked_depth, kind, matched, remaining_input, selected_routine)

  ## Transport a selected trace across one rejected sibling boundary.  The
  ## tail membership is relevant at this construction site; the resulting
  ## package is erased and records that its current spine is exactly the
  ## recursive tail rather than the parent `Cons(head, tail)` list.
  @reducible
  fn atomic_selected_start_witness_tail(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {tail_rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    tail_membership: ListMember(LookaroundAdmittedState(n), selected_start, tail_rest),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased scope: AtomicStartScopeEvidence(n, AtomicStartScopeEvidenceAllowedRole()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    )
  ) -> AtomicSelectedStartWitness(
    depth,
    n,
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    tail_rest,
    selected_start,
    blocked_depth,
    kind,
    matched,
    remaining_input,
    routine
  ) = AtomicSelectedStartWitnessPacked(whole, tail_rest, allowed, scope, tail_membership, path)

  type LookaheadWitness(n: Nat, machine: PatternMachine(n)) indices ()
    LookaheadWitnessPacked : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> {@erased position: InitialPosition} -> {@erased depth: Nat} -> {@erased input: List(Char)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased blocked_depth: Option(Nat)} -> {@erased kind: AtomicStartSkipKind} -> (@erased selected_witness: AtomicSelectedStartWitness(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil(), whole, current, selected_start, blocked_depth, kind, matched, remaining, routine)) -> LookaheadWitness(n, machine)

  type LookaheadDecision(n: Nat, machine: PatternMachine(n)) indices ()
    LookaheadSatisfied : (witness: LookaheadWitness(n, machine)) -> LookaheadDecision(n, machine)
    LookaheadRefuted : (certificate: LookaheadRefutation(n, machine)) -> LookaheadDecision(n, machine)
    LookaheadResourceExhausted : (depth: Nat) -> (input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased exhaustion: LookaroundExhaustion(n)) -> LookaheadDecision(n, machine)

  type LookbehindRefutation(n: Nat, machine: PatternMachine(n)) indices ()
    LookbehindSearchExhausted : {@erased starts: List(MachineState(n))} -> (@erased depth: Nat) -> (input: List(Char)) -> (after_input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookbehindRefutation(n, machine)
    LookbehindHistoryUnavailable : (width: Nat) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased exhaustion: LookaroundExhaustion(n)) -> LookbehindRefutation(n, machine)
    LookbehindAtomicSearchRejected : (@erased depth: Nat) -> (position: InitialPosition) -> (input: List(Char)) -> (after_input: List(Char)) -> (history: List(Char)) -> (@erased capture_context: List(EvidenceInstruction)) -> (policy: NewlinePolicy) -> {@erased whole: List(LookaroundAdmittedState(n))} -> (@erased failure: Option(AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil(), whole))) -> (reason: LookaroundRoutineRejectionReason) -> LookbehindRefutation(n, machine)

  type LookbehindWitness(n: Nat, machine: PatternMachine(n)) indices ()
    LookbehindWitnessPacked : (routine: List(ExtendedInstruction)) -> {@erased matched: List(Char)} -> {@erased remaining_input: List(Char)} -> {@erased position: InitialPosition} -> {@erased depth: Nat} -> {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased blocked_depth: Option(Nat)} -> {@erased kind: AtomicStartSkipKind} -> (@erased selected_witness: AtomicSelectedStartWitness(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil(), whole, current, selected_start, blocked_depth, kind, matched, remaining_input, routine)) -> LookbehindWitness(n, machine)

  type LookbehindDecision(n: Nat, machine: PatternMachine(n)) indices ()
    LookbehindSatisfied : (witness: LookbehindWitness(n, machine)) -> LookbehindDecision(n, machine)
    LookbehindRefuted : (certificate: LookbehindRefutation(n, machine)) -> LookbehindDecision(n, machine)
    LookbehindResourceExhausted : (depth: Nat) -> (input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased exhaustion: LookaroundExhaustion(n)) -> LookbehindDecision(n, machine)

  ## Nested assertion decisions are existentially packaged because each child
  ## machine has its own state-count index.  They are proof metadata attached
  ## to a parent path; the path constructors erase the list after checking.
  typealias LookaheadDecisionEvidence = Sigma(n: Nat, Sigma(machine: PatternMachine(n), LookaheadDecision(n, machine)))
  typealias LookbehindDecisionEvidence = Sigma(n: Nat, Sigma(machine: PatternMachine(n), LookbehindDecision(n, machine)))
  type LookaroundNestedDecision =
    | LookaheadNestedDecision(Bool, LookaheadDecisionEvidence)
    | LookbehindNestedDecision(Bool, LookbehindDecisionEvidence)

  fn lookaround_nested_decisions(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundNestedDecision) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> []
    Some(LookaroundConstraintAdmitted(_, _, decisions)) -> decisions

  fn lookaround_prefix_search_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n))) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context) = match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, machine_state_members(starts), MachineStateCursorHere())
    LookaroundPrefixSearchMembersRejected(failure) -> LookaroundPrefixSearchResultRejected(failure)
    LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchResultFound(path)

  fn lookaround_prefix_search_path_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), {current: List(MachineState(n))}, members: MachineStateMembers(n, starts, current), @erased cursor: MachineStateCursor(n, starts, current)) -> LookaroundPrefixSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context) = match members
    MachineStateMembersNil() -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_exhausted(depth, n, machine, input, after_input, history, capture_context, policy, starts, MachineStateMembersNil(), cursor))
    MachineStateMembersActive(state, routine, constraints, member, remaining) -> match lookaround_prefix_path(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy)
      LookaroundPrefixPathRejectedEmpty(_, _, child_failure) -> match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundPrefixSearchMembersRejected(tail_failure) -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_active_rejected_empty(depth, n, machine, after_input, history, capture_context, policy, starts, state, routine, constraints, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchMembersFound(path)
      LookaroundPrefixPathRejectedStep(_, char, rest, _, child_failure) -> match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundPrefixSearchMembersRejected(tail_failure) -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_active_rejected_step(depth, n, machine, char, rest, after_input, history, capture_context, policy, starts, state, routine, constraints, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchMembersFound(path)
      LookaroundPrefixPathFoundActive(_, char, rest, _, destinations_equivalent, cursor_suffix, path) -> match destinations_equivalent
        reflexive() -> LookaroundPrefixSearchMembersFound(LookaroundPrefixSearchFoundActive(char, rest, reflexive(Cons(char, rest)), state, routine, constraints, member, cursor_suffix, path))
    MachineStateMembersAccepted(routine, constraints, member, remaining) -> match lookaround_prefix_path(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy)
      LookaroundPrefixPathFoundAccepted(path) -> LookaroundPrefixSearchMembersFound(LookaroundPrefixSearchFoundAccepted(routine, constraints, member, path))

  fn lookahead_witness(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, matched: List(Char), remaining: List(Char), routine: List(ExtendedInstruction), {selected_start: LookaroundAdmittedState(n)}, {@erased whole: List(LookaroundAdmittedState(n))}, {@erased current: List(LookaroundAdmittedState(n))}, {@erased blocked_depth: Option(Nat)}, {@erased kind: AtomicStartSkipKind}, @erased selected_witness: AtomicSelectedStartWitness(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil(), whole, current, selected_start, blocked_depth, kind, matched, remaining, routine)) -> LookaheadWitness(n, machine) = LookaheadWitnessPacked(matched, remaining, routine, selected_witness)

  fn lookahead_witness_routine(n: Nat, machine: PatternMachine(n), witness: LookaheadWitness(n, machine)) -> List(ExtendedInstruction) = match witness
    LookaheadWitnessPacked(matched, remaining, routine, selected_witness) -> selected_trace_routine(routine, selected_witness)

  fn lookbehind_witness(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, routine: List(ExtendedInstruction), {@erased matched: List(Char)}, {@erased remaining_input: List(Char)}, {selected_start: LookaroundAdmittedState(n)}, {@erased whole: List(LookaroundAdmittedState(n))}, {@erased current: List(LookaroundAdmittedState(n))}, {@erased blocked_depth: Option(Nat)}, {@erased kind: AtomicStartSkipKind}, @erased selected_witness: AtomicSelectedStartWitness(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil(), whole, current, selected_start, blocked_depth, kind, matched, remaining_input, routine)) -> LookbehindWitness(n, machine) = LookbehindWitnessPacked(routine, selected_witness)

  fn lookbehind_witness_routine(n: Nat, machine: PatternMachine(n), witness: LookbehindWitness(n, machine)) -> List(ExtendedInstruction) = match witness
    LookbehindWitnessPacked(routine, selected_witness) -> selected_trace_routine(routine, selected_witness)

  ## The selected-trace index names the exact routine that the atomic
  ## evaluator admitted.  Replay consumers project through this helper rather
  ## than independently choosing a routine, so the capture sidecar and the
  ## checked assertion witness share one construction authority.
  fn selected_trace_routine({depth: Nat}, {n: Nat}, {machine: PatternMachine(n)}, {position: InitialPosition}, {input: List(Char)}, {after_input: List(Char)}, {history: List(Char)}, {capture_context: List(EvidenceInstruction)}, {policy: NewlinePolicy}, {prefix_mode: Bool}, {reversed_prefix: List(Char)}, {whole: List(LookaroundAdmittedState(n))}, {current: List(LookaroundAdmittedState(n))}, {selected_start: LookaroundAdmittedState(n)}, {blocked_depth: Option(Nat)}, {kind: AtomicStartSkipKind}, {matched: List(Char)}, {remaining: List(Char)}, routine: List(ExtendedInstruction), @erased _witness: AtomicSelectedStartWitness(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, selected_start, blocked_depth, kind, matched, remaining, routine)) -> List(ExtendedInstruction) = routine

  fn lookaround_prefix_filtered_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  fn lookahead_atomic_path_decision(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    result: LookaroundRoutineSearchResult(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil())
  ) -> LookaheadDecision(n, machine) = match result
    LookaroundRoutineSearchYes(matched, remaining, routine, _trace_package, selected_trace) -> LookaheadSatisfied(lookahead_witness(depth, n, machine, position, input, history, capture_context, policy, matched, remaining, routine, selected_trace))
    LookaroundRoutineSearchNo(failure) -> LookaheadRefuted(LookaheadAtomicSearchRejected(depth, position, input, history, capture_context, policy, Some(failure), LookaroundRoutineRejected()))
    LookaroundRoutineSearchCommit(commit_depth) -> LookaheadRefuted(LookaheadAtomicSearchRejected(depth, position, input, history, capture_context, policy, assert_type None() : Option(AtomicStartRefutation(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil(), empty_lookaround_admitted_states(n))), LookaroundRoutineCommitted(commit_depth)))

  fn lookaround_prefix_search_decision(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaheadDecision(n, machine) = match machine
    MkPatternMachine(_, _) ->
      let atomic_result = atomic_lookaround_routine_initial(depth, n, machine, input, [], position, history, capture_context, policy, true, [])
      lookahead_atomic_path_decision(depth, n, machine, position, input, after_input, history, capture_context, policy, atomic_result)

  fn lookbehind_atomic_path_decision(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    result: LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil())
  ) -> LookbehindDecision(n, machine) = match result
    LookaroundRoutineSearchYes(_, _, routine, _trace_package, selected_trace) -> LookbehindSatisfied(lookbehind_witness(depth, n, machine, position, input, after_input, history, capture_context, policy, routine, selected_trace))
    LookaroundRoutineSearchNo(failure) -> LookbehindRefuted(LookbehindAtomicSearchRejected(depth, position, input, after_input, history, capture_context, policy, Some(failure), LookaroundRoutineRejected()))
    LookaroundRoutineSearchCommit(commit_depth) -> LookbehindRefuted(LookbehindAtomicSearchRejected(depth, position, input, after_input, history, capture_context, policy, assert_type None() : Option(AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil(), empty_lookaround_admitted_states(n))), LookaroundRoutineCommitted(commit_depth)))

  fn lookaround_search_decision(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookbehindDecision(n, machine) = match machine
    MkPatternMachine(_, _) ->
      let atomic_result = atomic_lookaround_routine_initial(depth, n, machine, input, after_input, position, history, capture_context, policy, false, [])
      lookbehind_atomic_path_decision(depth, n, machine, position, input, after_input, history, capture_context, policy, atomic_result)


  fn lookaround_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_first_prefix_loop(n, machine, position, [], input, history, policy)

  fn lookaround_first_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    pickup
      lookaround_machine_accepts(regex_assertion_depth_limit(), n, machine, position, matched_input, remaining_input, history, [], policy) -> Some(%[matched_input, remaining_input])
      else -> match remaining_input
        [] -> None()
        [char | rest] -> lookaround_first_prefix_loop(n, machine, position, [char | reversed_prefix], rest, history, policy)

  fn lookaround_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_last_prefix_loop(n, machine, position, [], input, None(), history, policy)

  fn lookaround_last_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: Option(Tuple(List(Char), List(Char))), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    let current = pickup
      lookaround_machine_accepts(regex_assertion_depth_limit(), n, machine, position, matched_input, remaining_input, history, [], policy) -> Some(%[matched_input, remaining_input])
      else -> previous
    match remaining_input
      [] -> current
      [char | rest] -> lookaround_last_prefix_loop(n, machine, position, [char | reversed_prefix], rest, current, history, policy)

  fn lookaround_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool, history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) = pickup
    greedy -> lookaround_last_prefix(n, machine, position, input, history, policy)
    else -> lookaround_first_prefix(n, machine, position, input, history, policy)








  ## Generic construction-site eliminator for a rejected start suffix. The
  ## failure and no-result witness are indexed by the same `Cons(head, rest)`
  ## spine; only the membership witness decides whether the supplied proof is
  ## the head case or the recursively prepared tail case.  The `There` branch
  ## receives the typed tail package extracted from the rejected constructor;
  ## it does not recover or classify the existential tail failure kind.
  @reducible
  fn atomic_start_rejected_member_induction(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    head: LookaroundAdmittedState(n),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    head_case: result,
    tail_case: (AtomicStartRejectedTailAt(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, rest)) -> result
  ) -> result = match atomic_start_member_location(selected_start, head, rest, membership)
    AtomicStartMemberHere(_) -> head_case
    AtomicStartMemberThere(_, _) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) ->
        tail_case(AtomicStartTailPackagePacked(tail_failure, tail_evidence))

  ## Proof-only counterpart of the package-carrying induction boundary.  The
  ## recursive branch deliberately invokes a zero-argument continuation: the
  ## caller closes over the typed tail package and membership instead of
  ## passing erased witnesses as runtime callback arguments (which E104
  ## rejects).  This is the continuation shape used by the non-empty `There`
  ## proof; it adds no runtime branch or proof payload.
  @reducible
  fn atomic_start_rejected_member_induction_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    head_case: result,
    tail_case: () -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(_) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> tail_case()

  ## Selected-trace counterpart of the erased rejected-member induction.  A
  ## `There` witness contains the exact prior membership for the recursive
  ## tail; package that witness together with the tail refutation/evidence and
  ## the unchanged selected trace before invoking the continuation.  This is
  ## the canonical transport boundary for arbitrary sibling recursion.
  @reducible
  fn atomic_start_rejected_member_induction_selected_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    head_case: result,
    tail_case: (AtomicStartSelectedTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, rest, selected_start, matched, remaining_input, selected_routine)) -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(prior) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) ->
        tail_case(AtomicStartSelectedTailPackagePacked(tail_failure, tail_evidence, prior, path))

  ## Package-preserving dual of the selected rejected-member induction. The
  ## exact selected-start package is relevant context and is transported
  ## unchanged when membership advances into the sibling tail.
  @reducible
  fn atomic_start_rejected_member_induction_selected_package(
    {result: Type}, {depth: Nat}, {n: Nat},
    machine: PatternMachine(n), position: InitialPosition,
    input: List(Char), after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    prefix_mode: Bool, reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(head, rest), AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(head, rest), AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    head_case: result,
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole, rest,
      selected_start, matched, remaining_input, selected_routine
    )) -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(prior) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) -> tail_case(
        AtomicStartSelectedTailTracePacked(
          tail_failure,
          tail_evidence,
          prior,
          trace_package
        )
      )

  ## Construction-site wrapper for a successful atomic witness.  The
  ## membership argument remains relevant here so the Here/There split can
  ## drive proof-only continuations; the linked witness is erased and fixes
  ## the same whole/current spine and selected trace at the type level.
  @reducible
  fn atomic_selected_start_witness_induction_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased _allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      routine
    ),
    head_case: result,
    tail_case: () -> result
  ) -> result = atomic_start_rejected_member_induction_erased(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    head_case,
    tail_case
  )

  ## Blocked counterpart of the proof-only induction boundary.  A blocked
  ## candidate carries a skip/allow commitment rather than a rejected-child
  ## tail package, so its evidence index has its own constructor.  The
  ## continuation remains zero-argument for the same erased-witness reason.
  @reducible
  fn atomic_start_blocked_member_induction_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    head_case: result,
    tail_case: () -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(_) -> match _evidence
      AtomicStartNoBlockedEvidence(_, _, _, _, _, _) -> tail_case()

  ## Construction-site head consumer for the first active rejected start. The
  ## child input is empty, so the indexed active-child refutation can be sent
  ## directly to the existing path contradiction. A later duplicate/member is
  ## delegated to the typed tail continuation; this helper therefore proves
  ## the `Here` branch without pretending that membership is unique in the
  ## presence of duplicate start states.
  fn atomic_start_rejected_member_here_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(depth, n, machine, position, Nil(), after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, rest, selected_start, matched, remaining_input, selected_routine)) -> Empty
  ) -> Empty =
    match atomic_start_member_location(
      selected_start,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      rest,
      membership
    )
      AtomicStartMemberHere(_) -> match failure
        AtomicStartCandidateRejected(_, _, _, _, _, _, _, _, _, _, _, _, _) ->
          atomic_start_candidate_rejection_excludes_trace(
            machine,
            position,
            after_input,
            history,
            capture_context,
            policy,
            prefix_mode,
            reversed_prefix,
            state,
            routine,
            constraints,
            assertion_routine,
            assertion_markers,
            nested_decisions,
            AtomicPathInputExhausted(LookaroundAdmittedStateCursorWitnessHere(), empty_lookaround_admitted_cursor_suffix(n)),
            empty_lookaround_admitted_cursor_suffix(n),
            path
          )
      AtomicStartMemberThere(_, prior) -> match failure
        AtomicStartCandidateRejected(_, _, _, _, _, _, _, _, _, _, child_failure, _, _) -> match child_failure
          AtomicPathInputExhausted(child_witness, child_suffix) -> match evidence
            AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) ->
              tail_case(AtomicStartSelectedTailPackagePacked(
                tail_failure,
                tail_evidence,
                prior,
                path
              ))

  ## Turn intrinsic list membership into the ordered cursor suffix consumed by
  ## the atomic refutation induction.  Membership alone does not expose the
  ## suffix list; this Sigma packages that suffix together with the proof that
  ## it is reached only by dropping the preceding ordered heads.
  fn lookaround_admitted_cursor_suffix_here({n: Nat}, value: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n))) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, Cons(value, rest), values)) =
    %[Cons(value, rest), LookaroundAdmittedStateCursorSuffixHere(reflexive(Cons(value, rest)))]

  fn lookaround_admitted_cursor_suffix_there({n: Nat}, head: LookaroundAdmittedState(n), value: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n)), prior: ListMember(LookaroundAdmittedState(n), value, rest)) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), values)) = match lookaround_admitted_cursor_suffix_from_member(value, rest, prior)
    mk_pair(values, suffix) -> %[values, LookaroundAdmittedStateCursorSuffixDrop(head, suffix)]

  fn lookaround_admitted_cursor_suffix_from_member({n: Nat}, value: LookaroundAdmittedState(n), whole: List(LookaroundAdmittedState(n)), member: ListMember(LookaroundAdmittedState(n), value, whole)) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, whole, values)) = match whole
    [] -> impossible
    [head | rest] -> match member
      ListMemberHere() -> lookaround_admitted_cursor_suffix_here(value, rest)
      ListMemberThere(prior) -> lookaround_admitted_cursor_suffix_there(head, value, rest, prior)










  ## Turn a structurally enumerated candidate list into the compact erased
  ## exhaustion witness used by assertion refutations.  The recursive call is
  ## the only way to obtain the Nil remainder, so callers cannot manufacture a
  ## certificate for a list whose traversal has not terminated.
  fn lookaround_exhaustion_from_members({n: Nat}, {whole: List(MachineState(n))}, {values: List(MachineState(n))}, members: MachineStateMembers(n, whole, values)) -> LookaroundExhaustion(n) = match members
    MachineStateMembersNil() -> LookaroundExhausted(whole, MachineStateMembersNil(), ())
    MachineStateMembersActive(_, _, _, _, remaining) -> lookaround_exhaustion_from_members(remaining)
    MachineStateMembersAccepted(_, _, _, remaining) -> lookaround_exhaustion_from_members(remaining)

  fn lookaround_exhaustion_from_list({n: Nat}, values: List(MachineState(n))) -> LookaroundExhaustion(n) = lookaround_exhaustion_from_members(machine_state_members(values))




  ## The atomic evaluator records the exact start and destination sequence it
  ## selected. The trace is indexed by the machine's state count and retained
  ## only as erased proof data; constructing it does not add a runtime path
  ## object to emitted matchers.
  type AtomicSelectedPathTrace(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), candidate_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicSelectedPrefixDone : AtomicSelectedPathTrace(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, True(), reversed_prefix, Nil(), evidence_reverse_chars(reversed_prefix), input, Nil())
    AtomicSelectedExactDone : AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), evidence_reverse_chars(reversed_prefix), Nil(), Nil())
    AtomicSelectedTransitionActive : (@erased source: Bounded(n)) -> (@erased char: Char) -> (@erased destination: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_selected_whole)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, child_whole)) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, child_selected_whole, child_current)) -> (@erased child_selection_from_origin: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased child_skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_whole, child_whole, child_current, child_skipped_kind)) -> (@erased suffix: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_current, matched, remaining_input, suffix_routine)) -> AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))
    AtomicSelectedTransitionAccepted : (@erased source: Bounded(n)) -> (@erased char: Char) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_selected_whole)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), lookaround_admitted_accepted_capture_context(capture_context, routine, assertion_markers), policy, child_whole)) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, child_selected_whole, child_current)) -> (@erased child_selection_from_origin: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased child_skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), lookaround_admitted_accepted_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_whole, child_whole, child_current, child_skipped_kind)) -> (@erased suffix: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), lookaround_admitted_accepted_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_current, matched, remaining_input, suffix_routine)) -> AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))


  ## The runtime-visible package is constructor-correlated with the exact
  ## erased trace in its index. Recursive constructors retain the canonical
  ## child-origin cursor package and suffix package directly, so consumers can
  ## recurse without reopening erased evidence or rebuilding runtime data.
  type AtomicSelectedPathTracePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), candidate_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction), trace: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, selected_routine))
    AtomicSelectedPathTracePrefixDonePacked : AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, True(), reversed_prefix, Nil(), evidence_reverse_chars(reversed_prefix), input, Nil(), AtomicSelectedPrefixDone())
