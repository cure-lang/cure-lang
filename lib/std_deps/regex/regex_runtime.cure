    machine,
    child_char,
    child_rest,
    after_input,
    destination,
    history,
    capture_context,
    policy,
    child_scope_depth,
    prefix_mode,
    reversed_prefix,
    failure_whole,
    failure_current,
    failure_suffix,
    failure_nonempty,
    selected_whole,
    selected_whole_equivalence,
    selected_suffix,
    child_failure,
    child_path,
    left_case,
    left_tail_case,
    right_case
