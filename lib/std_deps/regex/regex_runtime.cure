  ## Align the singleton rejected-child cursor with the selected child cursor
  ## at their common canonical origin. The equality branch fixes both traces to
  ## the same candidate. Active candidates use the singleton contradiction;
  ## accepted candidates cannot carry the indexed empty-input child failure.
  ## Directional cases remain the recursive sibling-tail obligations.
  @reducible
  fn atomic_path_active_child_rejection_singleton_aligned_excludes_trace(
    {@erased depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    {@erased child_char: Char},
    {@erased after_input: List(Char)},
    {@erased destination: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_scope_depth: Nat},
    {@erased prefix_mode: Bool},
    {@erased reversed_prefix: List(Char)},
    failure_whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    {@erased failure_remaining: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(candidate, failure_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      failure_whole,
      Cons(candidate, failure_remaining)
    ),
    {@erased selected_whole: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      selected_whole,
      selected_current
    ),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    left_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = match candidate
    LookaroundAdmittedActive(_, _, _, _, _, _) -> match atomic_path_cursor_location(
        failure_whole,
        failure_suffix,
        transport_lookaround_admitted_cursor_suffix_outer(
          selected_whole_equivalence,
          selected_suffix
        )
      )
        AtomicPathCursorLocationSame(equality) -> match equality
          reflexive() -> atomic_path_active_child_rejection_singleton_active_excludes_trace_erased(
            child_failure,
            child_path
          )
        AtomicPathCursorLocationLeftAfter(_) -> left_case()
        AtomicPathCursorLocationRightAfter(_) -> right_case()
    LookaroundAdmittedAccepted(_, _, _, _, _) -> match atomic_path_cursor_location(
        failure_whole,
        failure_suffix,
        transport_lookaround_admitted_cursor_suffix_outer(
          selected_whole_equivalence,
          selected_suffix
        )
      )
        AtomicPathCursorLocationSame(equality) -> match equality
          reflexive() -> atomic_path_accepted_child_rejection_singleton_excludes_trace_erased(child_failure)
        AtomicPathCursorLocationLeftAfter(_) -> left_case()
        AtomicPathCursorLocationRightAfter(_) -> right_case()

  @reducible
  fn atomic_path_active_child_rejection_excludes_aligned_trace(
    {@erased depth: Nat},
