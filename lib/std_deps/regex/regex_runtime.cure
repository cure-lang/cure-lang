ntext, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), AtomicStartFailureRejected())
