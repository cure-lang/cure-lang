    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    @erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind))
  ) -> LookaroundAdmittedNonempty(n, current) = match cause
    AtomicPathCommitPastEscaped(_, _, _, candidate, remaining, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> LookaroundAdmittedNonemptyPacked(candidate, remaining, reflexive(Cons(candidate, remaining)))

  @reducible
  fn atomic_path_commit_past_rejected_nonempty(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    @erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, AtomicPathCommitPastRejectedKind(child_prefix_kind, child_kind, tail_commit_kind))
  ) -> LookaroundAdmittedNonempty(n, current) = match cause
    AtomicPathCommitPastRejected(_, _, _, candidate, remaining, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> LookaroundAdmittedNonemptyPacked(candidate, remaining, reflexive(Cons(candidate, remaining)))

  ## A relevant cause kind selects the one constructor-specific erased
  ## projection. This is the single authority for recovering the non-empty
  ## commit cursor without inspecting a generic erased cause at runtime.
  @reducible
  fn atomic_path_commit_cause_nonempty(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    kind: AtomicPathCommitCauseKind,
    @erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)
  ) -> LookaroundAdmittedNonempty(n, current) = match kind
    AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind) -> atomic_path_commit_after_failure_nonempty(cause)
    AtomicPathCommitFromChildKind(child_commit_kind) -> atomic_path_commit_from_child_nonempty(cause)
    AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind) -> atomic_path_commit_past_escaped_nonempty(cause)
    AtomicPathCommitPastRejectedKind(child_prefix_kind, child_kind, tail_commit_kind) -> atomic_path_commit_past_rejected_nonempty(cause)

  ## The relevant structure already fixes the outer commit constructor.  This
  ## proof therefore does not need to promote the erased commit-kind index to
  ## runtime data merely to establish that its cursor is non-empty.
  @reducible
  fn atomic_path_commit_structure_nonempty(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat}, {@erased kind: AtomicPathCommitCauseKind},
    {@erased cause: AtomicPathCommitCause(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, current,
      commit_depth, kind
    )},
    structure: AtomicPathCommitStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, current,
      commit_depth, kind, cause
    )
  ) -> LookaroundAdmittedNonempty(n, current) = match structure
    AtomicPathCommitStructureAfterFailurePacked(_) ->
      atomic_path_commit_after_failure_nonempty(cause)
    AtomicPathCommitStructureFromChildPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_path_commit_from_child_nonempty(cause)
    AtomicPathCommitStructurePastEscapedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_path_commit_past_escaped_nonempty(cause)
    AtomicPathCommitStructurePastRejectedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_path_commit_past_rejected_nonempty(cause)

  @reducible
  fn atomic_path_commit_whole_nonempty(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    kind: AtomicPathCommitCauseKind,
    @erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind),
    suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)
  ) -> LookaroundAdmittedNonempty(n, whole) = match atomic_path_commit_cause_nonempty(kind, cause)
    LookaroundAdmittedNonemptyPacked(head, tail, equality) -> match equality
      reflexive() -> lookaround_admitted_cursor_suffix_nonempty(suffix)

  @reducible
  fn atomic_path_commit_cursor_whole_nonempty(
    {n: Nat}, {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    current_nonempty: LookaroundAdmittedNonempty(n, current),
    suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)
  ) -> LookaroundAdmittedNonempty(n, whole) = match current_nonempty
    LookaroundAdmittedNonemptyPacked(head, tail, equality) -> match equality
      reflexive() -> lookaround_admitted_cursor_suffix_nonempty(suffix)

  ## Commit and successful search results publish independent existential
  ## origins. Canonical-origin alignment transports both cursors to the
  ## commit's whole list, after which the ordinary active-child classifier
  ## distinguishes the same candidate, a later selected sibling, and a
  ## selected cursor strictly before the commit cursor.
  @reducible
  fn atomic_path_commit_selected_alignment_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_origin: List(LookaroundAdmittedState(n))},
    {@erased selected_origin: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    kind: AtomicPathCommitCauseKind,
    @erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind),
    commit_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, commit_origin),
    commit_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, commit_origin),
    commit_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = atomic_path_commit_selected_authority_alignment_fold(
    atomic_path_commit_cause_nonempty(kind, cause),
    commit_origin_equivalence,
    commit_origin_canonical,
    commit_suffix,
    selected_origin_canonical,
    selected_suffix,
    head_case,
    tail_case,
    reverse_case
  )

  ## Canonical cursor alignment once non-emptiness has been established from
  ## either the explicit cause kind or its relevant structure package.
  @reducible
  fn atomic_path_commit_selected_authority_alignment_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_origin: List(LookaroundAdmittedState(n))},
    {@erased selected_origin: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    commit_nonempty: LookaroundAdmittedNonempty(n, current),
    commit_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, commit_origin),
    commit_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, commit_origin),
    commit_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_tail_fold(
    atomic_path_active_child_alignment_from_canonical(
      atomic_path_commit_cursor_whole_nonempty(
        commit_nonempty,
        commit_suffix
      ),
      atomic_path_failed_selected_child_cursor_alignment(
        commit_origin_equivalence,
        commit_origin_canonical,
        commit_suffix,
        selected_origin_canonical,
        selected_suffix
      ),
      atomic_path_failed_selected_child_suffix(
        commit_origin_equivalence,
        commit_origin_canonical,
        selected_origin_canonical,
        selected_suffix
      )
    ),
    head_case,
    tail_case,
    reverse_case
  )

  ## Preserve the exact cursor equality in the aligned case. The coarser fold
  ## above is sufficient for branch routing, but constructor-local commit
  ## eliminators need the `Same` equality to rewrite the selected current to
  ## the commit current before consuming their indexed causes.
  @reducible
  fn atomic_path_commit_selected_cursor_location(
    {depth: Nat}, {n: Nat}, {machine: PatternMachine(n)},
    {input: List(Char)}, {after_input: List(Char)},
    {state: ThreadState(n)}, {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    whole: List(LookaroundAdmittedState(n)),
    {current: List(LookaroundAdmittedState(n))},
    {commit_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    commit_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, commit_origin),
    commit_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, commit_origin),
    commit_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current)
  ) -> AtomicPathCursorLocation(n, current, selected_current) = atomic_path_cursor_location(
    whole,
    commit_suffix,
    atomic_path_failed_selected_child_suffix(
      commit_origin_equivalence,
      commit_origin_canonical,
      selected_origin_canonical,
      selected_suffix
    )
  )

  ## Compose canonical cursor comparison with constructor-directed commit
  ## elimination while the candidate spines are still relevant.  Each branch
  ## receives the same computed location and a one-constructor package whose
  ## cause payload remains erased.
  @reducible
  fn atomic_path_commit_selected_location_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    whole: List(LookaroundAdmittedState(n)),
    {current: List(LookaroundAdmittedState(n))},
    {commit_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    {commit_depth: Nat},
    kind: AtomicPathCommitCauseKind,
    @erased cause: AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind),
    commit_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, commit_origin),
    commit_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, commit_origin),
    commit_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    after_failure_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), AtomicPathCursorLocation(n, current, selected_current)) -> Empty,
    from_child_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), AtomicPathCursorLocation(n, current, selected_current)) -> Empty,
    past_escaped_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), AtomicPathCursorLocation(n, current, selected_current)) -> Empty,
    past_rejected_case: (AtomicPathCommitCausePackage(AtomicPathCommitCauseAt(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)), AtomicPathCursorLocation(n, current, selected_current)) -> Empty
  ) -> Empty =
    let location: AtomicPathCursorLocation(n, current, selected_current) = atomic_path_commit_selected_cursor_location(
      whole,
      commit_origin_equivalence,
      commit_origin_canonical,
      commit_suffix,
      selected_origin_canonical,
      selected_suffix
    )
    atomic_path_commit_cause_dispatch(
      kind,
      cause,
      location,
      after_failure_case,
      from_child_case,
      past_escaped_case,
      past_rejected_case
    )



  @reducible
  fn atomic_path_commit_past_escaped_tail(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    @erased cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind))
  ) -> AtomicPathCommitTailPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining) = match cause
    AtomicPathCommitPastEscaped(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause) -> AtomicPathCommitTailPacked(tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause)

  @reducible
  fn atomic_path_commit_past_rejected_tail(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    @erased cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitPastRejectedKind(child_prefix_kind, child_kind, tail_commit_kind))
  ) -> AtomicPathCommitTailPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining) = match cause
    AtomicPathCommitPastRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause) -> AtomicPathCommitTailPacked(tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause)






  type AtomicPathRejectedSelectedTracePairAvailability(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRejectedSelectedTracePairUnavailable : AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)
    AtomicPathRejectedSelectedTracePairAvailable : (pair: AtomicPathRejectedSelectedTracePairExistentialPackage(depth, n, machine)) -> AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)


  fn atomic_path_skipped_prefix_rejected_selected_pair_availability(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
      AtomicPathRejectedSelectedTracePairUnavailable()
    AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
      AtomicPathRejectedSelectedTracePairUnavailable()
    AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
      atomic_path_skipped_prefix_rejected_selected_pair_availability(
        tail_structure
      )
    AtomicPathSkippedPrefixStructureRejectedConsPacked(_, _, pair) ->
      AtomicPathRejectedSelectedTracePairAvailable(
        AtomicPathRejectedSelectedTracePairExistentialPacked(pair)
      )


  type AtomicPathSelectedChildCursorExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char))
    AtomicPathSelectedChildCursorExistentialPacked : (shape: LookaroundAdmittedStateCursorShape) -> (payload: AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, shape)) -> AtomicPathSelectedChildCursorExistentialPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input)

  ## Path-free correlation boundary for the two independently constructed
  ## recursive child cursors. The comparison is indexed by the same shapes as
  ## the retained payloads, so every dispatch branch carries authority about
  ## those payloads rather than an unrelated existential pair.
  type AtomicPathCommitSelectedChildCursorPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char))
    AtomicPathCommitSelectedChildCursorPacked : (left_shape: LookaroundAdmittedStateCursorShape) -> (right_shape: LookaroundAdmittedStateCursorShape) -> (commit_payload: AtomicPathCommitChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, left_shape)) -> (selected_payload: AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, right_shape)) -> (comparison: AtomicPathCursorShapeComparison(left_shape, right_shape)) -> AtomicPathCommitSelectedChildCursorPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input)

  fn atomic_path_commit_selected_child_cursor_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased rest: List(Char)}, {@erased after_input: List(Char)},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased matched: List(Char)}, {@erased remaining_input: List(Char)},
    commit: AtomicPathCommitChildCursorExistentialPackage(
      depth, n, machine, rest, after_input, candidate, history,
      capture_context, policy, scope_depth, prefix_mode, reversed_prefix
    ),
    selected: AtomicPathSelectedChildCursorExistentialPackage(
      depth, n, machine, rest, after_input, candidate, history,
      capture_context, policy, scope_depth, prefix_mode, reversed_prefix,
      matched, remaining_input
    )
  ) -> AtomicPathCommitSelectedChildCursorPackage(
    depth, n, machine, rest, after_input, candidate, history,
    capture_context, policy, scope_depth, prefix_mode, reversed_prefix,
    matched, remaining_input
  ) = match commit
    AtomicPathCommitChildCursorExistentialPacked(left_shape, commit_payload) -> match selected
      AtomicPathSelectedChildCursorExistentialPacked(right_shape, selected_payload) ->
        AtomicPathCommitSelectedChildCursorPacked(
          left_shape,
          right_shape,
          commit_payload,
          selected_payload,
          atomic_path_cursor_shape_comparison(left_shape, right_shape)
        )

  fn atomic_selected_path_trace_child_cursor_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(candidate, remaining), matched, remaining_input, selected_routine)},
    trace_package: AtomicSelectedPathTracePackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(candidate, remaining), matched, remaining_input, selected_routine, path)
  ) -> AtomicPathSelectedChildCursorExistentialPackage(depth, n, machine, rest, after_input, candidate, history_push_bounded(history, char), capture_context, policy, scope_depth, prefix_mode, Cons(char, reversed_prefix), matched, remaining_input) = match trace_package
    AtomicSelectedPathTracePrefixDonePacked() -> impossible
    AtomicSelectedPathTraceExactDonePacked() -> impossible
    AtomicSelectedPathTraceActivePacked(_, _, destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions, _, _, _, _, _, _, child_origin_canonical, _, _, _, shape, child_cursor_package, _, _, child_skipped_structure, _, suffix_package, child_cursor_authority) ->
      AtomicPathSelectedChildCursorExistentialPacked(shape, AtomicPathSelectedChildCursorActivePacked(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions, child_origin_canonical, child_cursor_package, child_skipped_structure, suffix_package, child_cursor_authority))
    AtomicSelectedPathTraceAcceptedPacked(_, _, routine, constraints, assertion_routine, assertion_markers, nested_decisions, _, _, _, _, _, _, child_origin_canonical, _, _, _, shape, child_cursor_package, _, _, child_skipped_structure, _, suffix_package, child_cursor_authority) ->
      AtomicPathSelectedChildCursorExistentialPacked(shape, AtomicPathSelectedChildCursorAcceptedPacked(routine, constraints, assertion_routine, assertion_markers, nested_decisions, child_origin_canonical, child_cursor_package, child_skipped_structure, suffix_package, child_cursor_authority))



  type AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (shape: LookaroundAdmittedStateCursorShape)
    AtomicPathSkippedPrefixCursorShapedExistentialPacked : {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased state: ThreadState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased front: List(LookaroundAdmittedState(n))} -> {@erased current: List(LookaroundAdmittedState(n))} -> {@erased kind: AtomicPathSkippedPrefixKind} -> (payload: AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind, shape)) -> AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, shape)

  type AtomicPathSkippedPrefixCursorExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathSkippedPrefixCursorExistentialPacked : (shape: LookaroundAdmittedStateCursorShape) -> (payload: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, shape)) -> AtomicPathSkippedPrefixCursorExistentialPackage(depth, n, machine)

  fn atomic_path_skipped_prefix_cursor_shaped_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> Sigma(shape: LookaroundAdmittedStateCursorShape, AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind, shape)) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
      %[LookaroundAdmittedStateCursorShapeHere(), AtomicPathSkippedPrefixCursorShapedEmptyPacked(structure)]
    AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
      %[LookaroundAdmittedStateCursorShapeDrop(LookaroundAdmittedStateCursorShapeHere()), AtomicPathSkippedPrefixCursorShapedEscapedOnePacked(structure)]
    AtomicPathSkippedPrefixStructureEscapedConsPacked(evidence, tail_structure) -> match atomic_path_skipped_prefix_cursor_shaped_package(tail_structure)
      mk_pair(tail_shape, tail_payload) ->
          %[LookaroundAdmittedStateCursorShapeDrop(tail_shape), AtomicPathSkippedPrefixCursorShapedEscapedConsPacked(
              AtomicPathSkippedPrefixStructureEscapedConsPacked(
                evidence,
                tail_structure
              ),
              tail_payload
            )]
    AtomicPathSkippedPrefixStructureRejectedConsPacked(evidence, tail_structure, pair) -> match atomic_path_skipped_prefix_cursor_shaped_package(tail_structure)
      mk_pair(tail_shape, tail_payload) ->
          %[LookaroundAdmittedStateCursorShapeDrop(tail_shape), AtomicPathSkippedPrefixCursorShapedRejectedConsPacked(
              AtomicPathSkippedPrefixStructureRejectedConsPacked(
                evidence,
                tail_structure,
                pair
              ),
              tail_payload
            )]

  fn atomic_path_skipped_prefix_cursor_shaped_existential_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> AtomicPathSkippedPrefixCursorExistentialPackage(
    depth, n, machine
  ) = match atomic_path_skipped_prefix_cursor_shaped_package(structure)
    mk_pair(shape, payload) ->
      AtomicPathSkippedPrefixCursorExistentialPacked(
        shape,
        AtomicPathSkippedPrefixCursorShapedExistentialPacked(payload)
      )

  ## A successful skipped prefix determines its cursor direction without a
  ## second list comparison: the empty constructor is equality, and every
  ## non-empty constructor places the selection strictly to the right.
  @reducible
  fn atomic_path_skipped_prefix_structure_location(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> AtomicPathCursorLocation(n, front, current) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
      AtomicPathCursorLocationSame(reflexive(current))
    AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
      AtomicPathCursorLocationRightAfter(
        atomic_path_skipped_prefix_structure_cursor_package(structure)
      )
    AtomicPathSkippedPrefixStructureEscapedConsPacked(_, _) ->
      AtomicPathCursorLocationRightAfter(
        atomic_path_skipped_prefix_structure_cursor_package(structure)
      )
    AtomicPathSkippedPrefixStructureRejectedConsPacked(_, _, _) ->
      AtomicPathCursorLocationRightAfter(
        atomic_path_skipped_prefix_structure_cursor_package(structure)
      )

