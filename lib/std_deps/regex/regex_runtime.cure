  ## One relevant projection of the local child terminal classifier. This is
  ## the single authority shared by terminal contradiction folds and the
  ## nonterminal recursive continuation; no erased failure kind is reopened.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInputExhaustedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalExactAcceptedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalRootDestinationsExhaustedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalUnclassifiedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(depth, n, machine)

  ## Correlated structural tail for an aligned Same branch. The commit and
  ## selected suffix stay fixed while the relevant skipped-prefix spine is
  ## peeled. The only cross-cursor authority remains erased and cannot choose
  ## the relevant recursive branch.
  type AtomicPathRecursiveCommitSelectedChildSameSkippedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked : {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased state: ThreadState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> {@erased left_whole: List(LookaroundAdmittedState(n))} -> {@erased left_current: List(LookaroundAdmittedState(n))} -> (commit: AtomicPathCommitStructureCursorClassifiedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, left_whole, left_current)) -> {@erased right_whole: List(LookaroundAdmittedState(n))} -> {@erased front: List(LookaroundAdmittedState(n))} -> {@erased right_current: List(LookaroundAdmittedState(n))} -> {@erased skipped_kind: AtomicPathSkippedPrefixKind} -> (selected_skipped: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, right_whole, front, right_current, skipped_kind)) -> (selected_empty: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, right_whole, right_current, right_current, AtomicPathSkippedPrefixEmptyKind())) -> {@erased matched: List(Char)} -> {@erased remaining_input: List(Char)} -> {@erased suffix_routine: List(ExtendedInstruction)} -> {@erased suffix: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, right_current, matched, remaining_input, suffix_routine)} -> (selected_suffix: AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, right_current, matched, remaining_input, suffix_routine, suffix)) -> (selected_envelope: AtomicSelectedPathTraceExistentialRuntimeEnvelope(depth, n, machine)) -> (inner_equivalence: LookaroundAdmittedCursorInnerEquivalentAuthority(n, left_current, right_current)) -> (source: AtomicPathRecursiveCommitSelectedChildSameExistentialPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameSkippedTailPackage(depth, n, machine)

  ## Exact terminal produced by the structural skipped-tail descent. Unlike
  ## the traversal carrier, this package exposes Empty in the selected-prefix
  ## index, so consumers cannot accidentally reopen a non-terminal spine.
  type AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked : {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased state: ThreadState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> {@erased left_whole: List(LookaroundAdmittedState(n))} -> {@erased left_current: List(LookaroundAdmittedState(n))} -> (commit: AtomicPathCommitStructureCursorClassifiedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, left_whole, left_current)) -> {@erased right_whole: List(LookaroundAdmittedState(n))} -> {@erased right_current: List(LookaroundAdmittedState(n))} -> (selected_empty: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, right_whole, right_current, right_current, AtomicPathSkippedPrefixEmptyKind())) -> {@erased matched: List(Char)} -> {@erased remaining_input: List(Char)} -> {@erased suffix_routine: List(ExtendedInstruction)} -> {@erased suffix: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, right_current, matched, remaining_input, suffix_routine)} -> (selected_suffix: AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, right_current, matched, remaining_input, suffix_routine, suffix)) -> (selected_envelope: AtomicSelectedPathTraceExistentialRuntimeEnvelope(depth, n, machine)) -> (inner_equivalence: LookaroundAdmittedCursorInnerEquivalentAuthority(n, left_current, right_current)) -> (source: AtomicPathRecursiveCommitSelectedChildSameExistentialPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)

  ## A PastRejected tail advances the committed cursor once from an already
  ## aligned Same pair. The one-constructor package records that its only
  ## remaining common-induction branch is reverse and retains the complete
  ## exact-empty authority for the eventual contradiction.
  type AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePacked : (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(depth, n, machine)

  ## Proof-bearing local destination-rejection branches. Each runtime shape
  ## decision retains the exact skipped-empty authority that produced it, so
  ## the common induction receives construction-site evidence rather than a
  ## nullary obligation detached from the failed and selected child pair.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked : (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> (selected_child: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, LookaroundAdmittedStateCursorShapeHere())) -> (availability: AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(depth, n, machine)

  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePacked : {@erased failure_shape: LookaroundAdmittedStateCursorShape} -> {@erased selected_shape: LookaroundAdmittedStateCursorShape} -> (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> (selected_child: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, selected_shape)) -> (direction: AtomicPathActiveChildShapeThereAuthority(failure_shape, selected_shape)) -> (availability: AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(depth, n, machine)

  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePacked : {@erased failure_shape: LookaroundAdmittedStateCursorShape} -> {@erased selected_shape: LookaroundAdmittedStateCursorShape} -> (empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(depth, n, machine)) -> (selected_child: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, selected_shape)) -> (direction: AtomicPathCursorShapesLeftAfterAuthority(failure_shape, selected_shape)) -> (availability: AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(depth, n, machine)

  ## A Here direction fixes the selected skipped-prefix cursor to `Here`.
  ## The canonical shape stored with that cursor rules out every non-empty
  ## skipped constructor, leaving one exact empty package for the local child
  ## contradiction.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked : (source: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(depth, n, machine)

  fn atomic_path_recursive_commit_selected_child_same_after_failure_here_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(
      depth, n, machine
    )) -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(
      _, selected_child, _
    ) -> match selected_child
      AtomicPathSkippedPrefixCursorShapedExistentialPacked(selected_payload) -> match selected_payload
        AtomicPathSkippedPrefixCursorShapedEmptyPacked(structure) -> match structure
          AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
            empty_case(
              AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked(package)
            )

  fn atomic_path_recursive_commit_selected_child_same_aligned_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameExistentialPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
    depth, n, machine
  ) = match package
    AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
      {rest = rest}, {after_input = after_input}, {history = history},
      {capture_context = capture_context}, {policy = policy},
      {scope_depth = scope_depth}, {prefix_mode = prefix_mode},
      {reversed_prefix = reversed_prefix}, {matched = matched},
      {remaining_input = remaining_input},
      _, right_shape, commit_payload, selected_payload, same_authority
    ) -> match commit_payload
      AtomicPathCommitChildCursorPayloadPacked(
        {child_whole = left_whole}, {child_current = left_current},
        context_alignment, scope_alignment, child_origin_equivalence,
        child_origin_canonical, _, left_cursor, commit
      ) -> match selected_payload
        AtomicPathSelectedChildCursorActivePacked(
          {child_whole = right_whole}, {child_current = right_current},
          {child_skipped_kind = skipped_kind},
          {suffix_routine = suffix_routine}, {suffix = suffix},
          destination, routine, constraints, assertion_routine,
          assertion_markers, nested_decisions, right_origin_canonical, _,
          selected_skipped, selected_suffix, right_cursor
        ) -> match context_alignment
          LookaroundAdmittedStateCaptureContextActive() -> match scope_alignment
            LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match atomic_path_search_origin_alignment(child_origin_canonical, right_origin_canonical)
              AtomicPathSearchOriginsAligned(origin_equivalence) ->
                AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
                  commit,
                  selected_skipped,
                  selected_suffix,
                  atomic_selected_path_trace_existential_runtime_envelope(
                    right_shape,
                    selected_suffix
                  ),
                  lookaround_admitted_cursor_same_shape_inner_equivalent(
                    left_cursor,
                    right_cursor,
                    same_authority,
                    trans(child_origin_equivalence, origin_equivalence)
                  ),
                  package
                )
        AtomicPathSelectedChildCursorAcceptedPacked(
          {child_whole = right_whole}, {child_current = right_current},
          {child_skipped_kind = skipped_kind},
          {suffix_routine = suffix_routine}, {suffix = suffix},
          routine, constraints, assertion_routine, assertion_markers,
          nested_decisions, right_origin_canonical, _, selected_skipped,
          selected_suffix, right_cursor
        ) -> match context_alignment
          LookaroundAdmittedStateCaptureContextAccepted() -> match scope_alignment
            LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match atomic_path_search_origin_alignment(child_origin_canonical, right_origin_canonical)
              AtomicPathSearchOriginsAligned(origin_equivalence) ->
                AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
                  commit,
                  selected_skipped,
                  selected_suffix,
                  atomic_selected_path_trace_existential_runtime_envelope(
                    right_shape,
                    selected_suffix
                  ),
                  lookaround_admitted_cursor_same_shape_inner_equivalent(
                    left_cursor,
                    right_cursor,
                    same_authority,
                    trans(child_origin_equivalence, origin_equivalence)
                  ),
                  package
                )

  fn atomic_path_recursive_commit_selected_child_same_continuation_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
    depth, n, machine
  ) = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked(aligned)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructureFromChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSameFromChildPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_from_child_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructurePastEscapedPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_past_escaped_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) ->
      AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked(
        aligned
      )

  fn atomic_path_recursive_commit_selected_child_same_after_failure_terminal_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(
    depth, n, machine
  ) = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
        child_commit
      ) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          _, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(child_package) -> match child_package
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
              terminal_classification, _, _, _, _
            ) -> match terminal_classification
              AtomicPathCommitAfterFailureInputExhaustedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInputExhaustedPacked(aligned)
              AtomicPathCommitAfterFailureExactAcceptedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalExactAcceptedPacked(aligned)
              AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalRootDestinationsExhaustedPacked(aligned)
              AtomicPathCommitAfterFailureTerminalUnclassifiedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalUnclassifiedPacked(aligned)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)

  fn atomic_path_recursive_commit_selected_child_same_after_failure_terminal_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(
      depth, n, machine
    ),
    input_exhausted_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    exact_accepted_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    root_destinations_exhausted_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    unclassified_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    invalid_case: () -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInputExhaustedPacked(aligned) ->
      input_exhausted_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalExactAcceptedPacked(aligned) ->
      exact_accepted_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalRootDestinationsExhaustedPacked(aligned) ->
      root_destinations_exhausted_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalUnclassifiedPacked(aligned) ->
      unclassified_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(_) ->
      invalid_case()

  ## Consume the input-exhausted terminal classification without reopening
  ## erased failure evidence. All other aligned cases remain available to the
  ## recursive caller unchanged. The erased cursor equality is inspected only
  ## while eliminating an impossible branch to `Empty`.
  fn atomic_path_recursive_commit_selected_child_same_input_exhausted_fold(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    other_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, selected_suffix, _, inner_equivalence, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
        {child_prefix_kind = child_prefix_kind}, child_commit
      ) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          cause, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(after_child) -> match after_child
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
              terminal_classification, _, _, _, _
            ) -> match terminal_classification
              AtomicPathCommitAfterFailureInputExhaustedPacked() -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> match atomic_path_commit_after_input_exhausted_excludes_aligned_selected_package(
                    child_prefix_kind,
                    cause,
                    selected_suffix
                  )
              AtomicPathCommitAfterFailureExactAcceptedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureTerminalUnclassifiedPacked() ->
                other_case(package)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        other_case(package)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> other_case(package)

  ## Accepted-child dual of the preceding terminal fold. The classification
  ## fixes non-empty child input and exact mode before the recursive
  ## existential is opened; all other aligned cases remain untouched.
  fn atomic_path_recursive_commit_selected_child_same_exact_accepted_fold(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    other_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, selected_suffix, _, inner_equivalence, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
        {child_prefix_kind = child_prefix_kind}, child_commit
      ) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          cause, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(after_child) -> match after_child
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
              terminal_classification, _, _, _, _
            ) -> match terminal_classification
              AtomicPathCommitAfterFailureInputExhaustedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureExactAcceptedPacked() -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> match atomic_path_commit_after_exact_accepted_excludes_aligned_selected_package(
                    child_prefix_kind,
                    cause,
                    selected_suffix
                  )
              AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureTerminalUnclassifiedPacked() ->
                other_case(package)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        other_case(package)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> other_case(package)

  ## Root destinations-exhausted terminal. Root availability is published by
  ## the search-result branch, so this fold never opens the erased prefix or
  ## refutation merely to select relevant control flow.
  fn atomic_path_recursive_commit_selected_child_same_root_destinations_exhausted_fold(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    other_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, selected_suffix, _, inner_equivalence, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(child_commit) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          _, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(after_child) -> match after_child
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
              terminal_classification, _, _, _, _
            ) -> match terminal_classification
              AtomicPathCommitAfterFailureInputExhaustedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureExactAcceptedPacked() ->
                other_case(package)
              AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked() -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> match atomic_path_commit_after_root_destinations_exhausted_excludes_aligned_selected_package(
                    structure,
                    selected_suffix
                  )
              AtomicPathCommitAfterFailureTerminalUnclassifiedPacked() ->
                other_case(package)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        other_case(package)
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        other_case(package)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> other_case(package)

  @reducible
  fn atomic_path_recursive_commit_selected_existential_pack(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased commit_current: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased commit_kind: AtomicPathCommitCauseKind},
    {@erased matched: List(Char)}, {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, selected_current,
      matched, remaining_input, selected_routine
    )},
    {@erased skipped_kind: AtomicPathSkippedPrefixKind},
    package: AtomicPathRecursiveCommitSelectedPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, commit_depth, commit_kind,
      AtomicSelectedPathTracePackage(
        depth, n, machine, input, after_input, state, history, capture_context,
        policy, scope_depth, prefix_mode, reversed_prefix, selected_current,
        matched, remaining_input, selected_routine, path
      ),
      skipped_kind
    )
  ) -> AtomicPathRecursiveCommitSelectedExistentialPackage(depth, n, machine) =
    AtomicPathRecursiveCommitSelectedExistentialPacked(package)

  ## Discard the outer trace path after extracting its path-free selected-child
  ## authority, then correlate that authority with the independently produced
  ## commit child. No later carrier needs the trace envelope or its path index.
  fn atomic_path_commit_child_selected_location_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, Cons(candidate, remaining), matched, remaining_input,
      selected_routine
    )},
    child_commit: AtomicPathCommitChildCursorExistentialPackage(
      depth, n, machine, rest, after_input, candidate,
      history_push_bounded(history, char), capture_context, policy, scope_depth,
      prefix_mode, Cons(char, reversed_prefix)
    ),
    selected_trace_envelope: AtomicSelectedPathTraceRuntimeEnvelope(
      AtomicSelectedPathTracePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, Cons(candidate, remaining), matched, remaining_input,
      selected_routine, path
      )
    )
  ) -> AtomicPathRecursiveCommitSelectedExistentialPackage(depth, n, machine) = match selected_trace_envelope
    AtomicSelectedPathTraceRuntimeEnvelopePacked(_, trace_package) ->
      AtomicPathRecursiveCommitSelectedChildExistentialPacked(
        atomic_path_commit_selected_child_cursor_package(
          child_commit,
          atomic_selected_path_trace_child_cursor_package(trace_package)
        )
      )

  ## Common runtime dispatcher for recursive commit/selection authorities.
  ## The finite tag chooses a branch. Same is aligned and classifies its local
  ## child terminal once before reaching the recursive callback; strict
  ## directions retain the original existential unchanged. No erased child
  ## index is reconstructed and no tag is treated as proof evidence.
  fn atomic_path_recursive_commit_selected_existential_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    ),
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> result,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    invalid_case: () -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedExistentialPacked(_) ->
      correlated_case(package)
    AtomicPathRecursiveCommitSelectedChildExistentialPacked(pair) -> match pair
      AtomicPathCommitSelectedChildCursorPacked(left_shape, right_shape, commit_payload, selected_payload, comparison) -> match comparison
        AtomicPathCursorShapeComparisonSame(same_authority) ->
          atomic_path_recursive_commit_selected_child_same_after_failure_terminal_dispatch(
            atomic_path_recursive_commit_selected_child_same_after_failure_terminal_package(
              atomic_path_recursive_commit_selected_child_same_aligned_package(
                AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
                  left_shape,
                  right_shape,
                  commit_payload,
                  selected_payload,
                  same_authority
                )
              )
            ),
            fn(input_exhausted) ->
              atomic_path_recursive_commit_selected_child_same_input_exhausted_fold(
                input_exhausted,
                fn(_) -> invalid_case()
              ),
            fn(exact_accepted) ->
              atomic_path_recursive_commit_selected_child_same_exact_accepted_fold(
                exact_accepted,
                fn(_) -> invalid_case()
              ),
            fn(root_exhausted) ->
              atomic_path_recursive_commit_selected_child_same_root_destinations_exhausted_fold(
                root_exhausted,
                fn(_) -> invalid_case()
              ),
            fn(unclassified) ->
              same_case(
                atomic_path_recursive_commit_selected_child_same_continuation_package(
                  unclassified
                )
              ),
            invalid_case
          )
        AtomicPathCursorShapeComparisonLeftAfter(_) -> left_case(package)
        AtomicPathCursorShapeComparisonRightAfter(_) -> right_case(package)

  ## Enter the next recursive child only from a fixed propagated-Same branch.
  ## The projected commit and selected suffix already exist as relevant
  ## values. Their erased inner equality is consumed solely on a path whose
  ## result is Empty; no transported package escapes this eliminator.
  fn atomic_path_recursive_commit_selected_child_same_projected_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameProjectedPackage(
      depth, n, machine
    ),
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> Empty,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(_, aligned) -> match aligned
      AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
        commit, _, selected_suffix, _, inner_equivalence, source
      ) -> match source
        AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
          _, right_shape, _, _, _
        ) -> match commit
          AtomicPathCommitStructureCursorClassifiedFromChildPacked(child_commit) -> match child_commit
            AtomicPathCommitStructureCursorExistentialPacked(
              _, _, child_structure
            ) -> match child_structure
              AtomicPathCommitStructureFromChildPacked(
                _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
              ) -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> atomic_path_recursive_commit_selected_existential_dispatch(
                    atomic_path_commit_child_selected_location_package(
                      atomic_path_commit_structure_cursor_from_child_child_package(
                        child_commit
                      ),
                      atomic_selected_path_trace_runtime_envelope(
                        right_shape,
                        selected_suffix
                      )
                    ),
                    correlated_case,
                    same_case,
                    left_case,
                    right_case,
                    invalid_case
                  )
          AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(child_commit) -> match child_commit
            AtomicPathCommitStructureCursorExistentialPacked(
              _, _, child_structure
            ) -> match child_structure
              AtomicPathCommitStructurePastEscapedPacked(
                _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
              ) -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> atomic_path_recursive_commit_selected_existential_dispatch(
                    atomic_path_commit_child_selected_location_package(
                      atomic_path_commit_structure_cursor_past_escaped_child_package(
                        child_commit
                      ),
                      atomic_selected_path_trace_runtime_envelope(
                        right_shape,
                        selected_suffix
                      )
                    ),
                    correlated_case,
                    same_case,
                    left_case,
                    right_case,
                    invalid_case
                  )
          AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
            invalid_case()
          AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
            invalid_case()
      AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
        _, _, _, _, _, _
      ) -> invalid_case()

  ## Structural Same continuation routing. Propagated child commits must enter
  ## the fixed Empty transport; local branches remain exact proof obligations
  ## for the eventual common induction theorem.
  fn atomic_path_recursive_commit_selected_child_same_continuation_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    ),
    after_failure_here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    after_failure_there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    after_failure_reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    past_rejected_empty_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> Empty,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked(aligned) ->
      atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_fold(
        aligned,
        after_failure_here_case,
        after_failure_there_case,
        after_failure_reverse_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSameFromChildPacked(projected) ->
      atomic_path_recursive_commit_selected_child_same_projected_dispatch(
        projected,
        correlated_case,
        same_case,
        left_case,
        right_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked(projected) ->
      atomic_path_recursive_commit_selected_child_same_projected_dispatch(
        projected,
        correlated_case,
        same_case,
        left_case,
        right_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked(aligned) ->
      atomic_path_recursive_commit_selected_child_same_past_rejected_empty_fold(
        aligned,
        past_rejected_empty_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked(_) ->
      invalid_case()

  ## Narrow a local AfterFailure continuation by the relevant selected-prefix
  ## structure before any erased cause, failure, or cursor equality is opened.
  fn atomic_path_recursive_commit_selected_child_same_after_failure_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    escaped_one_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    escaped_cons_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    rejected_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, selected_skipped, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) -> match selected_skipped
        AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
          empty_case(aligned)
        AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
          escaped_one_case(aligned)
        AtomicPathSkippedPrefixStructureEscapedConsPacked(_, _) ->
          escaped_cons_case(aligned)
        AtomicPathSkippedPrefixStructureRejectedConsPacked(_, _, _) ->
          rejected_case(aligned)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        invalid_case()
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> invalid_case()

  ## PastRejected has the same relevant selected-prefix split, but retains its
  ## recursive tail commit for the eventual sibling induction.
  fn atomic_path_recursive_commit_selected_child_same_past_rejected_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    escaped_one_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    escaped_cons_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    rejected_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, selected_skipped, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) -> match selected_skipped
        AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
          empty_case(aligned)
        AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
          escaped_one_case(aligned)
        AtomicPathSkippedPrefixStructureEscapedConsPacked(_, _) ->
          escaped_cons_case(aligned)
        AtomicPathSkippedPrefixStructureRejectedConsPacked(_, _, _) ->
          rejected_case(aligned)
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        invalid_case()
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> invalid_case()

  fn atomic_path_recursive_commit_selected_child_same_skipped_tail_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameSkippedTailPackage(
    depth, n, machine
  ) = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, selected_skipped, selected_suffix, selected_envelope,
      inner_equivalence, source
    ) -> AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
      commit, selected_skipped,
      AtomicPathSkippedPrefixStructureEmptyPacked(
        AtomicPathSkippedPrefixEmpty()
      ),
      selected_suffix, selected_envelope, inner_equivalence, source
    )
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      commit, selected_skipped, selected_suffix, selected_envelope,
      inner_equivalence, source
    ) -> AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
      commit, selected_skipped,
      AtomicPathSkippedPrefixStructureEmptyPacked(
        AtomicPathSkippedPrefixEmpty()
      ),
      selected_suffix, selected_envelope, inner_equivalence, source
    )

  ## Peel exactly one relevant selected-prefix layer. EscapedOne becomes the
  ## canonical Empty tail; cons cases retain their already-correlated tail
  ## structure. Recursive callers therefore never rebuild or compare cursors.
  fn atomic_path_recursive_commit_selected_child_same_skipped_tail_fold(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameSkippedTailPackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedTailPackage(
      depth, n, machine
    )) -> result,
    tail_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedTailPackage(
      depth, n, machine
    )) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
      commit, selected_skipped, selected_empty, selected_suffix,
      selected_envelope, inner_equivalence, source
    ) -> match selected_skipped
      AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
        empty_case(package)
      AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
        tail_case(
          AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
            commit, selected_empty, selected_empty,
            selected_suffix, selected_envelope,
            inner_equivalence, source
          )
        )
      AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
        tail_case(
          AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
            commit, tail_structure, selected_empty, selected_suffix,
            selected_envelope,
            inner_equivalence, source
          )
        )
      AtomicPathSkippedPrefixStructureRejectedConsPacked(_, tail_structure, _) ->
        tail_case(
          AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
            commit, tail_structure, selected_empty, selected_suffix,
            selected_envelope,
            inner_equivalence, source
          )
        )

  ## Descend the relevant skipped-prefix spine to its canonical empty tail.
  ## The recursion is structural in the stored tail_structure argument. The
  ## existential wrapper changes only the exposed front and kind indices.
  fn atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameSkippedTailPackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    )) -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
      commit, selected_skipped, selected_empty, selected_suffix,
      selected_envelope, inner_equivalence, source
    ) -> match selected_skipped
      AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
        empty_case(
          AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
            commit, selected_skipped, selected_suffix, selected_envelope,
            inner_equivalence, source
          )
        )
      AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
        empty_case(
          AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
            commit, selected_empty, selected_suffix, selected_envelope,
            inner_equivalence, source
          )
        )
      AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
        atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
          AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
            commit, tail_structure, selected_empty, selected_suffix,
            selected_envelope,
            inner_equivalence, source
          ),
          empty_case
        )
      AtomicPathSkippedPrefixStructureRejectedConsPacked(_, tail_structure, _) ->
        atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
          AtomicPathRecursiveCommitSelectedChildSameSkippedTailPacked(
            commit, tail_structure, selected_empty, selected_suffix,
            selected_envelope,
            inner_equivalence, source
          ),
          empty_case
        )

  ## The exact empty terminal still retains its relevant outer commit tag.
  ## Narrow it before opening any erased child failure, cause, or cursor
  ## equality so the two recursive consumers receive fixed control branches.
  fn atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    ),
    after_failure_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    )) -> result,
    past_rejected_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    )) -> result,
    invalid_case: () -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
      commit, _, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        after_failure_case(package)
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        past_rejected_case(package)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        invalid_case()

  ## A local Same/Empty branch is already fixed before this child failure kind
  ## is selected. The relevant singleton stored with the exact AfterFailure
  ## child chooses one of four pre-existing Empty callbacks; the erased
  ## refutation and no-evidence payloads remain unopened.
  fn atomic_path_recursive_commit_selected_child_same_after_failure_empty_kind_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    ),
    input_exhausted_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    )) -> Empty,
    exact_accepted_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    )) -> Empty,
    destinations_exhausted_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    )) -> Empty,
    destination_rejected_case: (AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
      _, _, _, _, _, source
    ) -> match source
      AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
        _, _, commit_payload, _, _
      ) -> match commit_payload
        AtomicPathCommitChildCursorPayloadPacked(
          _, _, _, _, _, _, commit
        ) -> match commit
          AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
            child_commit
          ) -> match child_commit
            AtomicPathCommitStructureCursorExistentialPacked(
              _, _, structure
            ) -> match structure
              AtomicPathCommitStructureAfterFailurePacked(child_package) -> match child_package
                AtomicPathCommitAfterFailureChildPacked(
                  _, _, _, _, _, _, _, _, _, _, _, _, _, _,
                  child_kind_authority, _, _, _, _, _
                ) -> match child_kind_authority
                  AtomicPathFailureInputExhaustedAuthority() ->
                    input_exhausted_case(package)
                  AtomicPathFailureExactAcceptedAuthority() ->
                    exact_accepted_case(package)
                  AtomicPathFailureDestinationsExhaustedAuthority() ->
                    destinations_exhausted_case(package)
                  AtomicPathFailureDestinationRejectedAuthority() ->
                    destination_rejected_case(package)
          AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
            invalid_case()
          AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
            invalid_case()
          AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
            invalid_case()

  ## Open the exact local destination rejection and the exact selected active
  ## transition under the already-established Same cursor authority.  Their
  ## child packages are placed in the canonical alignment carrier before any
  ## branch is selected, so a Here/later/reverse callback cannot observe a
  ## failure from one transition beside the suffix of another transition.
  fn atomic_path_recursive_commit_selected_child_same_destination_rejected_alignment_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    ),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
      commit, _, selected_suffix, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
        child_commit
      ) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          _, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(child_package) -> match child_package
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, child_cursor_package,
              child_kind_authority, _, _, _, _, _
            ) -> match child_kind_authority
              AtomicPathFailureDestinationRejectedAuthority() -> match selected_suffix
                AtomicSelectedPathTracePrefixDonePacked() -> invalid_case()
                AtomicSelectedPathTraceExactDonePacked() -> invalid_case()
                AtomicSelectedPathTraceAcceptedPacked(
                  _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
                  _, _, _, _, _, _, _
                ) -> invalid_case()
                AtomicSelectedPathTraceActivePacked(
                  _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
                  _, _, _, child_skipped_structure,
                  _, _, _
                ) ->
                  let rejected_selected_availability = atomic_path_skipped_prefix_rejected_selected_pair_availability(
                    child_skipped_structure
                  )
                  let selected_child_cursor = atomic_path_skipped_prefix_cursor_shaped_existential_package(
                    child_skipped_structure
                  )
                  match selected_child_cursor
                    AtomicPathSkippedPrefixCursorExistentialPacked(
                      selected_child_shape, selected_child_payload
                    ) -> match atomic_path_active_child_shape_alignment_package(
                        package,
                        selected_child_payload,
                        lookaround_admitted_cursor_suffix_package_shape(
                          child_cursor_package
                        ),
                        selected_child_shape
                      )
                      AtomicPathActiveChildShapeAlignmentHerePacked(branch) -> match branch
                        AtomicPathActiveChildShapeHerePacked(failure, selected) ->
                          here_case(
                          AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(
                            failure,
                            selected,
                            rejected_selected_availability
                          )
                        )
                      AtomicPathActiveChildShapeAlignmentTherePacked(branch) -> match branch
                        AtomicPathActiveChildShapeTherePacked(failure, selected, authority) ->
                          there_case(
                          AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePacked(
                            failure,
                            selected,
                            authority,
                            rejected_selected_availability
                          )
                        )
                      AtomicPathActiveChildShapeAlignmentReversePacked(branch) -> match branch
                        AtomicPathActiveChildShapeReversePacked(failure, selected, authority) ->
                          reverse_case(
                          AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePacked(
                            failure,
                            selected,
                            authority,
                            rejected_selected_availability
                          )
                        )
              AtomicPathFailureInputExhaustedAuthority() -> invalid_case()
              AtomicPathFailureExactAcceptedAuthority() -> invalid_case()
              AtomicPathFailureDestinationsExhaustedAuthority() -> invalid_case()
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        invalid_case()

  ## Terminal classification has already removed the three local child
  ## terminal kinds before this fold is entered. Descend the relevant selected
  ## skipped-prefix spine to its exact empty tail, retain that correlated
  ## package across child-kind dispatch, and expose only destination rejection
  ## to the recursive consumer. Any inconsistent terminal or commit
  ## classification remains an explicit impossible obligation.
  fn atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(after_failure_empty) ->
            atomic_path_recursive_commit_selected_child_same_after_failure_empty_kind_dispatch(
              after_failure_empty,
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(destination_rejected) ->
                atomic_path_recursive_commit_selected_child_same_destination_rejected_alignment_fold(
                  destination_rejected,
                  here_case,
                  there_case,
                  reverse_case,
                  invalid_case
                ),
              invalid_case
            ),
          fn(_) -> invalid_case(),
          invalid_case
        )
    )

  ## PastRejected carries a recursive sibling commit, but its selected prefix
  ## may still expose any of the four relevant constructors. Consume that
  ## prefix structurally before projecting the sibling: the callback receives
  ## one exact empty authority, while AfterFailure and malformed propagated
  ## classifications remain explicit invalid obligations.
  fn atomic_path_recursive_commit_selected_child_same_past_rejected_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    past_rejected_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(_) -> invalid_case(),
          fn(past_rejected) ->
            atomic_path_recursive_commit_selected_child_same_past_rejected_reverse_fold(
              past_rejected,
              past_rejected_case,
              invalid_case
            ),
          invalid_case
        )
    )

  ## Select the structurally forced reverse branch before exposing it to the
  ## common induction. The relevant PastRejected tag and the original Same
  ## shape authority are both opened locally; erased cursor equalities never
  ## choose a continuation.
  fn atomic_path_recursive_commit_selected_child_same_past_rejected_reverse_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    ),
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match empty
    AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
      commit, _, _, _, _, source
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) -> match source
        AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
          _, _, _, _, same_authority
        ) -> match atomic_path_cursor_shapes_advance_left_after(same_authority)
          AtomicPathCursorShapesLeftAfterHere() ->
            reverse_case(
              AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePacked(empty)
            )
          AtomicPathCursorShapesLeftAfterDrop(_) ->
            reverse_case(
              AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePacked(empty)
            )
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        invalid_case()

  ## Combine an extracted recursive commit tail with the corresponding
  ## selected skipped-prefix tail. Matching the commit package exposes the
  ## cursor already correlated with its exact structure; the selected
  ## structure independently determines Same versus RightAfter.
  @reducible
  fn atomic_path_commit_selected_tail_location_package(
    {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased commit_current: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased commit_kind: AtomicPathCommitCauseKind},
    {@erased skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, commit_depth, commit_kind
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, skipped_kind
    )
  ) -> AtomicPathCommitSelectedLocationPackage(
    n,
    AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, commit_depth, commit_kind
    ),
    LookaroundAdmittedStateCursorSuffixPackage(n, whole, commit_current),
    selected_trace_package,
    AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, skipped_kind
    ),
    commit_current,
    selected_current
  ) = match commit
    AtomicPathCommitStructureCursorExistentialPacked(_, cursor, _) ->
      atomic_path_commit_selected_location_package(
        commit,
        cursor,
        selected_trace,
        selected_skipped,
        atomic_path_skipped_prefix_structure_location(selected_skipped)
      )

  ## Provenance-preserving eliminator for recursive tails. Unlike the broad
  ## location carrier fold, this construction has no LeftAfter branch: an
  ## empty selected prefix is Same and every nonempty prefix is RightAfter.
  @reducible
  fn atomic_path_commit_selected_tail_location_fold(
    {result: Type}, {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased commit_current: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased commit_kind: AtomicPathCommitCauseKind},
    {@erased skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, commit_depth, commit_kind
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, skipped_kind
    ),
    same_case: (AtomicPathRecursiveCommitSelectedSamePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, commit_depth, commit_kind,
      selected_trace_package, skipped_kind
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedRightPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole,
      commit_current, selected_current, commit_depth, commit_kind,
      selected_trace_package, skipped_kind
    )) -> result
  ) -> result = match commit
    AtomicPathCommitStructureCursorExistentialPacked(_, cursor, _) -> match selected_skipped
      AtomicPathSkippedPrefixStructureEmptyPacked(evidence) -> match evidence
        AtomicPathSkippedPrefixEmpty() -> same_case(
          AtomicPathCommitSelectedSameAuthorityPacked(
            commit,
            cursor,
            selected_trace,
            selected_skipped,
            reflexive(selected_current)
          )
        )
      AtomicPathSkippedPrefixStructureEscapedOnePacked(_) -> right_case(
        AtomicPathCommitSelectedRightAuthorityPacked(
          commit,
          cursor,
          selected_trace,
          selected_skipped,
          atomic_path_skipped_prefix_structure_cursor_package(selected_skipped)
        )
      )
      AtomicPathSkippedPrefixStructureEscapedConsPacked(_, _) -> right_case(
        AtomicPathCommitSelectedRightAuthorityPacked(
          commit,
          cursor,
          selected_trace,
          selected_skipped,
          atomic_path_skipped_prefix_structure_cursor_package(selected_skipped)
        )
      )
      AtomicPathSkippedPrefixStructureRejectedConsPacked(_, _, _) -> right_case(
        AtomicPathCommitSelectedRightAuthorityPacked(
          commit,
          cursor,
          selected_trace,
          selected_skipped,
          atomic_path_skipped_prefix_structure_cursor_package(selected_skipped)
        )
      )

  ## Pair the two recursive tails selected by PastEscaped/EscapedCons before
  ## constructing the next correlated location carrier.
  @reducible
  fn atomic_path_commit_past_escaped_selected_tail_location_package(
    {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), commit_depth,
      AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind)
    ),
    commit_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, whole, Cons(candidate, remaining)
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      AtomicPathSkippedPrefixEscapedConsKind(
        child_commit_kind, tail_skipped_kind
      )
    )
  ) -> AtomicPathCommitSelectedLocationPackage(
    n,
    AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, commit_depth, tail_commit_kind
    ),
    LookaroundAdmittedStateCursorSuffixPackage(n, whole, remaining),
    selected_trace_package,
    AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, tail_skipped_kind
    ),
    remaining,
    selected_current
  ) = match selected_skipped
    AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
      atomic_path_commit_selected_tail_location_package(
        atomic_path_commit_structure_past_escaped_tail_package(
          commit,
          commit_cursor
        ),
        selected_trace,
        tail_structure
      )

  ## Recursive escaped-head consumer. The relevant outer EscapedCons exposes
  ## its selected tail, and the paired commit projection exposes the matching
  ## commit tail before the two-way tail fold selects Same or RightAfter.
  @reducible
  fn atomic_path_commit_past_escaped_selected_tail_location_fold(
    {result: Type}, {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), commit_depth,
      AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind)
    ),
    commit_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, whole, Cons(candidate, remaining)
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      AtomicPathSkippedPrefixEscapedConsKind(
        child_commit_kind, tail_skipped_kind
      )
    ),
    same_case: (AtomicPathRecursiveCommitSelectedSamePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedRightPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result
  ) -> result = match selected_skipped
    AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
      atomic_path_commit_selected_tail_location_fold(
        atomic_path_commit_structure_past_escaped_tail_package(
          commit,
          commit_cursor
        ),
        selected_trace,
        tail_structure,
        same_case,
        right_case
      )

  ## Pair the two recursive tails selected by PastRejected/RejectedCons. The
  ## shared failure-prefix and failure-kind indices ensure both structures
  ## describe the same skipped candidate.
  @reducible
  fn atomic_path_commit_past_rejected_selected_tail_location_package(
    {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), commit_depth,
      AtomicPathCommitPastRejectedKind(
        child_prefix_kind, child_kind, tail_commit_kind
      )
    ),
    commit_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, whole, Cons(candidate, remaining)
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      AtomicPathSkippedPrefixRejectedConsKind(
        child_prefix_kind, child_kind, tail_skipped_kind
      )
    )
  ) -> AtomicPathCommitSelectedLocationPackage(
    n,
    AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, commit_depth, tail_commit_kind
    ),
    LookaroundAdmittedStateCursorSuffixPackage(n, whole, remaining),
    selected_trace_package,
    AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, tail_skipped_kind
    ),
    remaining,
    selected_current
  ) = match selected_skipped
    AtomicPathSkippedPrefixStructureRejectedConsPacked(_, tail_structure, _) ->
      atomic_path_commit_selected_tail_location_package(
        atomic_path_commit_structure_past_rejected_tail_package(
          commit,
          commit_cursor
        ),
        selected_trace,
        tail_structure
      )

  ## Recursive rejected-head consumer. The shared child prefix/failure
  ## indices identify the same skipped candidate before its commit and
  ## selected tails enter the two-way recursive location fold.
  @reducible
  fn atomic_path_commit_past_rejected_selected_tail_location_fold(
    {result: Type}, {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), commit_depth,
      AtomicPathCommitPastRejectedKind(
        child_prefix_kind, child_kind, tail_commit_kind
      )
    ),
    commit_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, whole, Cons(candidate, remaining)
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      AtomicPathSkippedPrefixRejectedConsKind(
        child_prefix_kind, child_kind, tail_skipped_kind
      )
    ),
    same_case: (AtomicPathRecursiveCommitSelectedSamePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedRightPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result
  ) -> result = match selected_skipped
    AtomicPathSkippedPrefixStructureRejectedConsPacked(_, tail_structure, _) ->
      atomic_path_commit_selected_tail_location_fold(
        atomic_path_commit_structure_past_rejected_tail_package(
          commit,
          commit_cursor
        ),
        selected_trace,
        tail_structure,
        same_case,
        right_case
      )

  ## Same-cursor recursive terminal for an active child with exhausted input.
