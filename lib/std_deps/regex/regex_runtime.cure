    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    current
  ) = match package
    AtomicStartTailPackagePacked(_, _) -> match evidence
      AtomicStartNoBlockedEvidence(_, _, _, scope, _, _) -> AtomicStartBlockedTailPackagePacked(failure, skip, allowed, scope, evidence)

  ## One-step dispatcher for a blocked recursive tail. The ordinary tail
  ## package is consumed only through the typed blocked package above; this
  ## boundary feeds both admitted-state constructors through the selected
  ## blocked membership induction. A later selected sibling receives its
  ## inherited membership and trace in an erased package.
  fn atomic_start_rejected_member_there_nonempty_tail_blocked_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    head: LookaroundAdmittedState(n),
    {rest: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let blocked_package: AtomicStartBlockedTailPackage(
    depth,
    n,
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    Cons(head, rest)
  ) = atomic_start_blocked_tail_package(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    package,
    skip,
    allowed,
    failure,
    evidence
  )
    atomic_start_rejected_tail_dispatch_blocked(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      head,
      blocked_package,
      membership,
      path,
      tail_case
    )

  @reducible
  fn atomic_start_rejected_tail_dispatch_blocked(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    head: LookaroundAdmittedState(n),
    {rest: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartBlockedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest)
    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = match package
    AtomicStartBlockedTailPackagePacked(failure, skip, allowed, scope, evidence) ->
      let head_case: Empty = atomic_start_scope_record_excludes_allowed(scope, skip, allowed)
      atomic_start_blocked_member_induction_selected_erased(
        machine,
        position,
        input,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        skip,
        allowed,
        failure,
        evidence,
        membership,
        path,
        head_case,
        tail_case
      )

  ## The successful path's origin is not an arbitrary erased list.  Terminal
  ## accepted searches originate at the empty admitted list; consuming active
  ## searches originate at the exact filtered transition list published by
  ## the member traversal.  This small indexed witness keeps that distinction
  ## available without putting the full machine computation in a constructor
  ## result index.
  type AtomicPathSearchOrigin(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, origin: List(LookaroundAdmittedState(n)))
    AtomicPathSearchOriginAccepted : AtomicPathSearchOrigin(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, empty_lookaround_admitted_states(n))
    AtomicPathSearchOriginActiveEmpty : {@erased source: Bounded(n)} -> AtomicPathSearchOrigin(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, empty_lookaround_admitted_states(n))
    AtomicPathSearchOriginActive : (char: Char) -> (rest: List(Char)) -> (source: Bounded(n)) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), origin, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, origin)

  ## Two origin certificates for one indexed search normalize to the same
  ## canonical admitted-state list. Keep the equality in a single-constructor
  ## proof relation so alignment adds no runtime branch or payload.
  type AtomicPathSearchOriginAlignment(n: Nat) indices (left: List(LookaroundAdmittedState(n)), right: List(LookaroundAdmittedState(n)))
    AtomicPathSearchOriginsAligned : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), left, right)) -> AtomicPathSearchOriginAlignment(n, left, right)

  @reducible
  fn atomic_path_search_origin_alignment(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    left_origin: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, left),
    right_origin: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, right)
  ) -> AtomicPathSearchOriginAlignment(n, left, right) = match left_origin
    AtomicPathSearchOriginAccepted() -> match right_origin
      AtomicPathSearchOriginAccepted() -> AtomicPathSearchOriginsAligned(reflexive(empty_lookaround_admitted_states(n)))
    AtomicPathSearchOriginActiveEmpty() -> match right_origin
      AtomicPathSearchOriginActiveEmpty() -> AtomicPathSearchOriginsAligned(reflexive(empty_lookaround_admitted_states(n)))
    AtomicPathSearchOriginActive(_, _, _, left_canonical) -> match right_origin
      AtomicPathSearchOriginActive(_, _, _, right_canonical) -> AtomicPathSearchOriginsAligned(trans(left_canonical, sym(right_canonical)))


  ## Proof-only reason that a rejected candidate may continue to its ordered
  ## sibling.  The index is the exact close returned by that candidate's
  ## routine, so a no-close or escaping-close witness cannot coexist with a
  ## blocking witness for the same construction site.
  type AtomicPathFailureContinuation(scope_depth: Nat) indices (closed_depth: Option(Nat))
    AtomicPathSiblingNoClose : (@erased close_canonical: Equivalent(Option(Nat), closed_depth, None())) -> AtomicPathFailureContinuation(scope_depth, closed_depth)
    AtomicPathSiblingEscapedClose : (@erased commit_depth: Nat) -> (@erased close_canonical: Equivalent(Option(Nat), closed_depth, Some(commit_depth))) -> (@erased escaped: AtomicDepthBelow(scope_depth, commit_depth)) -> AtomicPathFailureContinuation(scope_depth, closed_depth)

  ## Proof-only cause retained whenever the atomic path fold returns Commit.
  ## A local close records the rejected child that preceded the close; a
  ## propagated close retains the child's own cause. Both constructors retain
  ## the exact blocking depth comparison selected by the runtime branch.
  type AtomicPathCommitCause(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), commit_depth: Nat, kind: AtomicPathCommitCauseKind)
    AtomicPathCommitAfterFailure : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_prefix_kind: AtomicPathFailurePrefixKind) -> (@erased child_prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_prefix_kind)) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_kind: AtomicPathFailureKind) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased child_evidence: AtomicPathNoEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased close_canonical: Equivalent(Option(Nat), lookaround_admitted_state_closed_depth(n, scope_depth, candidate), Some(commit_depth))) -> (@erased blocked: AtomicDepthAtLeast(scope_depth, commit_depth)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind))
    AtomicPathCommitFromChild : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_commit_kind: AtomicPathCommitCauseKind) -> (@erased child_cause: AtomicPathCommitCause(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, commit_depth, child_commit_kind)) -> (@erased blocked: AtomicDepthAtLeast(scope_depth, commit_depth)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitFromChildKind(child_commit_kind))
    AtomicPathCommitPastEscaped : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_commit_kind: AtomicPathCommitCauseKind) -> (@erased escaped_depth: Nat) -> (@erased child_cause: AtomicPathCommitCause(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, escaped_depth, child_commit_kind)) -> (@erased escaped: AtomicDepthBelow(scope_depth, escaped_depth)) -> (@erased tail_depth: Nat) -> {@erased tail_origin: List(LookaroundAdmittedState(n))} -> (@erased tail_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, tail_origin)) -> (@erased tail_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, tail_origin)) -> (@erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, remaining)) -> (@erased tail_commit_kind: AtomicPathCommitCauseKind) -> (@erased tail_cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, tail_depth, tail_commit_kind)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), tail_depth, AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind))

    AtomicPathCommitPastRejected : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_prefix_kind: AtomicPathFailurePrefixKind) -> (@erased child_prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_prefix_kind)) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_kind: AtomicPathFailureKind) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased child_evidence: AtomicPathNoEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased continuation: AtomicPathFailureContinuation(scope_depth, lookaround_admitted_state_closed_depth(n, scope_depth, candidate))) -> (@erased commit_depth: Nat) -> {@erased tail_origin: List(LookaroundAdmittedState(n))} -> (@erased tail_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, tail_origin)) -> (@erased tail_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, tail_origin)) -> (@erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, remaining)) -> (@erased tail_commit_kind: AtomicPathCommitCauseKind) -> (@erased tail_cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, commit_depth, tail_commit_kind)) -> AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitPastRejectedKind(child_prefix_kind, child_kind, tail_commit_kind))

  typealias AtomicPathCommitCauseAt(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), commit_depth: Nat, kind: AtomicPathCommitCauseKind) = AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, kind)

  ## Relevant construction-time classification for the one terminal child
  ## case whose input equation would otherwise be hidden by the recursive
  ## commit existential.  It is built only from relevant evaluator state;
  ## erased refutation evidence is never inspected to recover the equation.
  type AtomicPathFailurePrefixRootAvailability indices (child_prefix_kind: AtomicPathFailurePrefixKind)
    AtomicPathFailurePrefixRootAvailable : AtomicPathFailurePrefixRootAvailability(AtomicPathFailureAtRootKind())
    AtomicPathFailurePrefixRootUnavailable : AtomicPathFailurePrefixRootAvailability(child_prefix_kind)

  type AtomicPathCommitAfterFailureTerminalClassifiedPackage(n: Nat) indices (prefix_mode: Bool, rest: List(Char), candidate: LookaroundAdmittedState(n), child_prefix_kind: AtomicPathFailurePrefixKind, child_kind: AtomicPathFailureKind)
    AtomicPathCommitAfterFailureInputExhaustedPacked : {@erased state: Bounded(n)} -> {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, Nil(), LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), child_prefix_kind, AtomicPathFailureInputExhausted())
    AtomicPathCommitAfterFailureExactAcceptedPacked : {@erased child_char: Char} -> {@erased child_rest: List(Char)} -> {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, False(), Cons(child_char, child_rest), LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), child_prefix_kind, AtomicPathFailureExactAccepted())
    AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked : {@erased child_char: Char} -> {@erased child_rest: List(Char)} -> {@erased state: Bounded(n)} -> {@erased routine: List(EvidenceInstruction)} -> {@erased constraints: List(BoundaryConstraint)} -> {@erased assertion_routine: List(ExtendedInstruction)} -> {@erased assertion_markers: List(EvidenceInstruction)} -> {@erased nested_decisions: List(LookaroundNestedDecision)} -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, Cons(child_char, child_rest), LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), AtomicPathFailureAtRootKind(), AtomicPathFailureDestinationsExhausted())
    AtomicPathCommitAfterFailureTerminalUnclassifiedPacked : AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, rest, candidate, child_prefix_kind, child_kind)

  fn atomic_path_commit_after_failure_terminal_classified_package(
    {n: Nat}, prefix_mode: Bool, rest: List(Char), candidate: LookaroundAdmittedState(n),
    {child_prefix_kind: AtomicPathFailurePrefixKind},
    root_availability: AtomicPathFailurePrefixRootAvailability(child_prefix_kind),
    child_kind: AtomicPathFailureKind
  ) -> AtomicPathCommitAfterFailureTerminalClassifiedPackage(n, prefix_mode, rest, candidate, child_prefix_kind, child_kind) = match rest
    [] -> match candidate
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) -> match child_kind
        AtomicPathFailureInputExhausted() -> AtomicPathCommitAfterFailureInputExhaustedPacked()
        AtomicPathFailureExactAccepted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationsExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationRejected() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
      LookaroundAdmittedAccepted(_, _, _, _, _) -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
    [child_char | child_rest] -> match candidate
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) -> match child_kind
        AtomicPathFailureInputExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureExactAccepted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationsExhausted() -> match root_availability
          AtomicPathFailurePrefixRootAvailable() -> AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked()
          AtomicPathFailurePrefixRootUnavailable() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationRejected() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
      LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions) -> match child_kind
        AtomicPathFailureInputExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureExactAccepted() -> match prefix_mode
          True() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
          False() -> AtomicPathCommitAfterFailureExactAcceptedPacked()
        AtomicPathFailureDestinationsExhausted() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()
        AtomicPathFailureDestinationRejected() -> AtomicPathCommitAfterFailureTerminalUnclassifiedPacked()

  ## One-constructor carrier used by the constructor-directed commit fold.
  ## Its payload is erased; the relevant recursive kind selects the branch,
  ## while a consumer can open the resulting fixed package collapsibly.
