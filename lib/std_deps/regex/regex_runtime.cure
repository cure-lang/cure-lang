    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
