      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Cons(nested_candidate, Cons(third_candidate, Cons(tail_candidate, Nil())))),
      AtomicPathFailureDestinationRejected()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = atomic_path_rejected_tail_fold_excludes_trace(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    Cons(nested_candidate, Cons(third_candidate, Cons(tail_candidate, Nil()))),
    failure,
    matched,
    remaining_input,
