    LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## Consume the selected-tail package produced for a rejected active child.
  ## The package keeps the sibling-tail refutation, its cursor suffix, and the
  ## selected child path under one proof-only index.  At this first concrete
  ## recursive-tail base, the package tail is destination exhaustion, so the
  ## existing active exhaustion eliminator can consume it without rebuilding
  ## a cursor or inspecting an erased failure tag.
  @reducible
  fn atomic_path_active_child_rejection_excludes_tail_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil()),
      AtomicPathFailureDestinationRejected()
    ),
    {selected_current: List(LookaroundAdmittedState(n))},
    matched: List(Char),
    remaining_input: List(Char),
    selected_routine: List(ExtendedInstruction),
    dispatch: AtomicPathSelectedTailDispatch(
      Empty,
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil(),
      selected_current,
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match dispatch
    AtomicPathSelectedTailHead(value) -> lookaround_absurd(value)
    AtomicPathSelectedTailTail(package) -> match package
      AtomicPathSelectedTailPackagePacked(tail_package, tail_suffix, path) -> match tail_package
        AtomicPathTailPackagePacked(tail_failure) -> match tail_failure
          AtomicPathInputExhausted(_, _) -> impossible
          AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
          AtomicPathDestinationsExhausted(_, _, _, _, _, _) ->
            atomic_path_active_child_rejection_excludes_tail_exhaustion(
              machine,
              child_char,
              child_rest,
              after_input,
              source,
              history,
              capture_context,
              policy,
              scope_depth,
              prefix_mode,
              reversed_prefix,
              whole,
              candidate,
              failure,
              tail_failure,
              tail_suffix,
              matched,
              remaining_input,
              selected_routine,
              path
            )
          AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## When a sibling tail rejects an accepted candidate, its exact child
  ## refutation can be consumed by the same accepted-child eliminator. The
  ## parent rejection is retained as an index witness; the tail constructor
  ## exposes the child proof at this construction site. The accepted child
  ## contradiction is routed through the generic dispatcher: the parent
  ## selected suffix is a `Drop(head, ...)`, so the indexed cursor selects the
  ## tail result rather than treating this accepted sibling as head-selected.
  fn atomic_path_tail_rejection_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased head: LookaroundAdmittedState(n)},
    tail_routine: List(EvidenceInstruction),
    tail_constraints: List(BoundaryConstraint),
    tail_assertion_routine: List(ExtendedInstruction),
    tail_assertion_markers: List(EvidenceInstruction),
    tail_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    @erased _failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty =
    let accepted_candidate: LookaroundAdmittedState(n) = LookaroundAdmittedAccepted(
      tail_routine,
      tail_constraints,
      tail_assertion_routine,
      tail_assertion_markers,
      tail_nested_decisions
    )
    atomic_path_rejected_tail_fold_to_accepted(
      machine,
      char,
      rest,
      after_input,
      source,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      accepted_candidate,
      tail_failure,
      tail_routine,
      tail_constraints,
      tail_assertion_routine,
      tail_assertion_markers,
      tail_nested_decisions,
      _tail_selected_suffix,
      path
    )

  ## Base case for a selected trace at the accepted sibling after one rejected
  ## head. The parent-to-selected cursor is retained as an erased `Drop`
  ## index; the fixed two-state parent and singleton selected list make the
  ## reflexive branch impossible, so no runtime suffix inspection is needed.
  ## The accepted-child eliminator is then reused at the exact sibling where
  ## the selected trace begins. General non-empty tails remain recursive work.
  fn atomic_path_tail_drop_rejection_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased rejected_head: LookaroundAdmittedState(n)},
    tail_routine: List(EvidenceInstruction),
    tail_constraints: List(BoundaryConstraint),
    tail_assertion_routine: List(ExtendedInstruction),
    tail_assertion_markers: List(EvidenceInstruction),
    tail_nested_decisions: List(LookaroundNestedDecision),
    {@erased tail_remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(rejected_head, Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    @erased selection_from_parent: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(rejected_head, Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)),
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(tail_routine, tail_constraints, tail_assertion_routine, tail_assertion_markers, tail_nested_decisions), tail_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match tail_failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, _, child_scope_alignment, _, _, _, _) -> match path
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> match child_scope_alignment
        LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match child_failure
          AtomicPathExactAcceptedWithInput(_, _, _, _) -> atomic_path_failure_excludes_selected_suffix(
            machine,
            char,
            rest,
            after_input,
            ThreadActive(source),
            history,
            capture_context,
            policy,
            scope_depth,
            reversed_prefix,
            tail_routine,
            tail_constraints,
            tail_assertion_routine,
            tail_assertion_markers,
            tail_nested_decisions,
            child_failure,
            path
          )

  ## A sibling tail may reject an active candidate after that candidate's child
  ## runs out of input.  At this construction site the selected parent trace
  ## exposes an active transition, so the existing aligned-child eliminator
  ## consumes the exhausted child trace without inspecting any erased cursor
  ## payload at runtime.  This is the active-child counterpart of the accepted
  ## tail theorem above.
  fn atomic_path_tail_active_child_exhaustion_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased head: LookaroundAdmittedState(n)},
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    {@erased tail_remaining: List(LookaroundAdmittedState(n))},
    @erased _failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining)),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {@erased selected_remaining: List(LookaroundAdmittedState(n))},
    @erased _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match tail_failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, child_suffix, child_scope_alignment, _, _, _, _) -> match path
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_selection_suffix, _, _, _, child_trace) -> match child_scope_alignment
        LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match child_failure
          AtomicPathInputExhausted(_, stored_child_suffix) -> match child_suffix
            LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_child_suffix
              LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_active_child_rejection_head_active_excludes_trace(
                machine,
                char,
                after_input,
                source,
                history,
                capture_context,
                policy,
                scope_depth,
                prefix_mode,
                reversed_prefix,
                active_state,
                active_routine,
                active_constraints,
                active_assertion_routine,
                active_assertion_markers,
                active_nested_decisions,
                tail_failure,
                path
              )

  ## Consume a destination-exhaustion sibling tail through its typed package.
  ## The package's `Nil()` current index fixes the only tail shape that can
  ## reach the destination-exhaustion constructor; no erased tail kind or
  ## current list is inspected by runtime code.
  fn atomic_path_tail_package_destinations_exhausted_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased package: AtomicPathRejectedTailAt(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), candidate_current),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    )
  ) -> result = match package
    AtomicPathTailPackagePacked(tail_failure) -> match tail_failure
      AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> atomic_path_failure_excludes_aligned_trace(
        machine,
        char,
        rest,
        after_input,
        source,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        tail_failure,
        matched,
        remaining_input,
        routine,
        tail_suffix,
        path
      )

  ## A non-empty rejected tail may reach a recursively rejected active child.
  ## Both failure kinds are fixed by the constructor indices before this
  ## boundary is entered; matching them therefore introduces no runtime tag.
  ## The selected transition carries the child cursor and trace needed by the
  ## next child-alignment theorem, which is supplied as a proof-only closure.
  fn atomic_path_tail_active_child_rejection_excludes_selected_suffix_base(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased head: LookaroundAdmittedState(n),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    @erased tail_remaining: List(LookaroundAdmittedState(n)),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_current: List(LookaroundAdmittedState(n)),
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      AtomicPathFailureDestinationRejected()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_head: LookaroundAdmittedState(n),
    child_failure_tail: List(LookaroundAdmittedState(n)),
    child_failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      Cons(child_failure_head, child_failure_tail)
    ),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    {child_selected_current: List(LookaroundAdmittedState(n))},
    child_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    child_left_case: () -> Empty,
    child_left_tail_case: () -> Empty,
    child_right_case: () -> Empty
  ) -> Empty = match child_rest
    Nil() -> match child_current
      Nil() -> match child_failure
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      Cons(child_candidate, child_failure_remaining) -> match tail_failure
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_scope_alignment, _, _, _, _) -> match path
          AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match child_scope_alignment
            LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) ->
              atomic_path_active_child_rejection_singleton_aligned_excludes_trace(
                child_whole,
                child_candidate,
                child_failure,
                child_failure_suffix,
                reflexive(child_whole),
                atomic_path_failed_selected_child_suffix(
                  child_failure_origin_equivalence,
                  child_failure_origin_canonical,
                  child_selected_origin_canonical,
                  child_selected_suffix
                ),
                child_path,
                child_left_case,
                child_right_case
              )
    Cons(_, _) -> match tail_failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_scope_alignment, _, _, _, _) -> match path
        AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match child_scope_alignment
          LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) ->
            atomic_path_active_child_selection_package_consume(
              machine,
              char,
              child_char,
              child_rest,
              after_input,
              source,
              history,
              capture_context,
              policy,
              scope_depth,
              prefix_mode,
              reversed_prefix,
              atomic_path_active_child_selection_package(
                machine,
                char,
                Cons(child_char, child_rest),
                after_input,
                source,
                history,
                capture_context,
                policy,
                scope_depth,
                prefix_mode,
                reversed_prefix,
                active_state,
                active_routine,
                active_constraints,
                active_assertion_routine,
                active_assertion_markers,
                active_nested_decisions,
                path
              ),
              atomic_path_active_child_rejection_canonical_dispatch(
                child_failure_origin_equivalence,
                child_failure_origin_canonical,
                child_failure_suffix,
                child_selected_origin_canonical,
                child_selected_suffix,
                LookaroundAdmittedNonemptyPacked(
                  child_failure_head,
                  child_failure_tail,
                  child_failure_nonempty_equivalence
                ),
                child_left_case,
                child_left_tail_case,
                child_right_case
              )
            )

  ## Recurse over an arbitrary sibling tail before consuming the selected
  ## active child.  The selected-tail cursor is the induction index; the
  ## generic fold keeps each existential tail failure at its construction
  ## site and hands the adjacent selected candidate to the base consumer.
  @reducible
  fn atomic_path_tail_active_child_rejection_excludes_selected_suffix(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased head: LookaroundAdmittedState(n)},
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_current: List(LookaroundAdmittedState(n)),
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      AtomicPathFailureDestinationRejected()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_head: LookaroundAdmittedState(n),
    child_failure_tail: List(LookaroundAdmittedState(n)),
    child_failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      Cons(child_failure_head, child_failure_tail)
    ),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    {child_selected_current: List(LookaroundAdmittedState(n))},
    child_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    child_left_case: () -> Empty,
    child_left_tail_case: () -> Empty,
    child_right_case: () -> Empty
  ) -> Empty = atomic_path_rejected_tail_fold_to_active(
    machine,
    char,
    child_char,
    child_rest,
    after_input,
    source,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    tail_failure,
    active_state,
    active_routine,
    active_constraints,
    active_assertion_routine,
    active_assertion_markers,
    active_nested_decisions,
    child_whole,
    child_current,
    child_failure,
    child_suffix,
    child_failure_suffix,
    child_failure_head,
    child_failure_tail,
    child_failure_nonempty_equivalence,
    child_failure_origin,
    child_failure_origin_equivalence,
    child_failure_origin_canonical,
    child_selected_origin,
    child_selected_origin_canonical,
    child_selected_suffix,
    child_path,
    selected_remaining,
    _tail_selected_suffix,
    path,
    child_left_case,
    child_left_tail_case,
    child_right_case
  )

  ## Recurse through the selected active candidate's rejected sibling tail.
  ## The cursor suffix is the induction index; the failure tree remains
  ## existential and proof-only while each adjacent candidate is handed to the
  ## construction-site base consumer below.
  @reducible
  fn atomic_path_rejected_tail_fold_to_active(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathFailureKind},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      kind
    ),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    child_whole: List(LookaroundAdmittedState(n)),
    child_current: List(LookaroundAdmittedState(n)),
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      AtomicPathFailureDestinationRejected()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_head: LookaroundAdmittedState(n),
    child_failure_tail: List(LookaroundAdmittedState(n)),
    child_failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      Cons(child_failure_head, child_failure_tail)
    ),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    {child_selected_current: List(LookaroundAdmittedState(n))},
    child_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    child_left_case: () -> Empty,
    child_left_tail_case: () -> Empty,
    child_right_case: () -> Empty
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> match failure
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
          atomic_path_tail_active_child_rejection_excludes_selected_suffix_base(
            machine,
            char,
            child_char,
            child_rest,
            after_input,
            source,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            whole,
            candidate,
            active_state,
            active_routine,
            active_constraints,
            active_assertion_routine,
            active_assertion_markers,
            active_nested_decisions,
            remaining,
            failure,
            child_whole,
            child_current,
            child_failure,
            child_suffix,
            child_failure_suffix,
            child_failure_head,
            child_failure_tail,
            child_failure_nonempty_equivalence,
            child_failure_origin,
            child_failure_origin_equivalence,
            child_failure_origin_canonical,
            child_selected_origin,
            child_selected_origin_canonical,
            child_selected_suffix,
            child_path,
            selected_remaining,
            selection_from_current,
            path,
            child_left_case,
            child_left_tail_case,
            child_right_case
          )
    LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) ->
        match tail_suffix
          LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
            reflexive() -> match tail_failure
              AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
                atomic_path_tail_active_child_rejection_excludes_selected_suffix_base(
                machine,
                char,
                child_char,
                child_rest,
                after_input,
                source,
                history,
                capture_context,
                policy,
                scope_depth,
                prefix_mode,
                reversed_prefix,
                whole,
                candidate,
                active_state,
                active_routine,
                active_constraints,
                active_assertion_routine,
                active_assertion_markers,
                active_nested_decisions,
                selected_remaining,
                tail_failure,
                child_whole,
                child_current,
                child_failure,
                child_suffix,
                child_failure_suffix,
                child_failure_head,
                child_failure_tail,
                child_failure_nonempty_equivalence,
                child_failure_origin,
                child_failure_origin_equivalence,
                child_failure_origin_canonical,
                child_selected_origin,
                child_selected_origin_canonical,
                child_selected_suffix,
                child_path,
                selected_remaining,
                tail_suffix,
                path,
                child_left_case,
                child_left_tail_case,
                child_right_case
              )
          LookaroundAdmittedStateCursorSuffixDrop(_, _) ->
            atomic_path_rejected_tail_fold_to_active(
              machine,
              char,
              child_char,
              child_rest,
              after_input,
              source,
              history,
              capture_context,
              policy,
              scope_depth,
              prefix_mode,
              reversed_prefix,
              whole,
              tail_failure,
              active_state,
              active_routine,
              active_constraints,
              active_assertion_routine,
              active_assertion_markers,
              active_nested_decisions,
              child_whole,
              child_current,
              child_failure,
              child_suffix,
              child_failure_suffix,
              child_failure_head,
              child_failure_tail,
              child_failure_nonempty_equivalence,
              child_failure_origin,
              child_failure_origin_equivalence,
              child_failure_origin_canonical,
              child_selected_origin,
              child_selected_origin_canonical,
              child_selected_suffix,
              child_path,
              selected_remaining,
              tail_suffix,
              path,
              child_left_case,
              child_left_tail_case,
              child_right_case
            )

  ## A non-empty rejected tail may carry an active child whose destination
  ## cursor is already exhausted.  The parent rejection and selected trace are
  ## refined together at this construction site; the child refutation,
  ## selected-child suffix, and child trace then feed the canonical exhausted
  ## child eliminator without promoting any proof tag into runtime control.
  fn atomic_path_tail_active_child_destinations_exhausted_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased child_prefix: AtomicPathFailurePrefixEvidence(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      Nil(),
      child_prefix_kind
    ),
    child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      Nil(),
      AtomicPathFailureDestinationsExhausted()
    ),
    child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, Nil()),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    child_selected_current: List(LookaroundAdmittedState(n)),
    child_selection_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    matched: List(Char),
    remaining_input: List(Char),
    selected_routine: List(ExtendedInstruction),
    child_selected_routine: List(ExtendedInstruction),
    child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    right_case: () -> Empty
  ) -> Empty = atomic_path_tail_active_child_failure_dispatch(
    machine,
    char,
    child_char,
    child_rest,
    after_input,
    source,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    active_state,
    active_routine,
    active_constraints,
    active_assertion_routine,
    active_assertion_markers,
    active_nested_decisions,
    tail_remaining,
    tail_failure,
    child_whole,
    Nil(),
    child_prefix_kind,
    child_prefix,
    AtomicPathFailureDestinationsExhausted(),
    child_failure,
    child_suffix,
    child_failure_origin,
    child_failure_origin_equivalence,
    child_failure_origin_canonical,
    child_selected_origin,
    child_selected_origin_canonical,
    child_selected_current,
    child_selection_suffix,
    selected_remaining,
    matched,
    remaining_input,
    selected_routine,
    child_selected_routine,
    child_path,
    path,
    right_case,
    right_case,
    right_case
  )

  ## Dispatch the child refutation at the same construction boundary as the
  ## selected active transition.  A non-empty active child can only end in
  ## destination exhaustion or destination rejection; input exhaustion and
  ## exact accepted terminals are ruled out by its input and thread indices.
  ## The destination-exhaustion branch is consumed by the dedicated aligned
  ## theorem above.  The rejection branch derives its non-empty cursor package
  ## here and delegates to the existing recursive alignment authority.
  @reducible
  fn atomic_path_tail_active_child_failure_dispatch(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_current: List(LookaroundAdmittedState(n)),
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased child_prefix: AtomicPathFailurePrefixEvidence(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      child_prefix_kind
    ),
    child_kind: AtomicPathFailureKind,
    child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      child_kind
    ),
    child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    child_selected_current: List(LookaroundAdmittedState(n)),
    child_selection_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    matched: List(Char),
    remaining_input: List(Char),
    selected_routine: List(ExtendedInstruction),
    child_selected_routine: List(ExtendedInstruction),
    child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = match child_current
    Nil() -> match child_failure
      AtomicPathInputExhausted(_, _) -> impossible
      AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
      AtomicPathDestinationsExhausted(_, _, _, _, _, _) ->
        atomic_path_active_child_destinations_exhausted_excludes_aligned_trace(
          machine,
          child_char,
          child_rest,
          after_input,
          active_state,
          history_push_bounded(history, char),
          append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
          policy,
          atomic_scope_depth_after(active_routine, scope_depth),
          prefix_mode,
          Cons(char, reversed_prefix),
          child_whole,
          child_failure,
          child_suffix,
          child_whole,
          child_selected_current,
          reflexive(child_whole),
          atomic_path_failed_selected_child_suffix(
            child_failure_origin_equivalence,
            child_failure_origin_canonical,
            child_selected_origin_canonical,
            child_selection_suffix
          ),
          matched,
          remaining_input,
          child_selected_routine,
          child_path,
          right_case
        )
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match child_path
        AtomicSelectedPrefixDone() -> impossible
        AtomicSelectedExactDone() -> impossible
        AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match atomic_path_cursor_location(
          child_whole,
          child_suffix,
          atomic_path_failed_selected_child_suffix(
            child_failure_origin_equivalence,
            child_failure_origin_canonical,
            child_selected_origin_canonical,
            child_selection_suffix
          )
        )
          AtomicPathCursorLocationSame(equality) -> match equality
            reflexive() -> atomic_path_active_child_rejection_singleton_active_excludes_trace_erased(
              child_failure,
              child_path
            )
          AtomicPathCursorLocationLeftAfter(_) -> left_case()
          AtomicPathCursorLocationRightAfter(_) -> right_case()
        AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match atomic_path_cursor_location(
          child_whole,
          child_suffix,
          atomic_path_failed_selected_child_suffix(
            child_failure_origin_equivalence,
            child_failure_origin_canonical,
            child_selected_origin_canonical,
            child_selection_suffix
          )
        )
          AtomicPathCursorLocationSame(equality) -> match equality
            reflexive() -> atomic_path_accepted_child_rejection_singleton_excludes_trace_erased(child_failure)
          AtomicPathCursorLocationLeftAfter(_) -> left_case()
          AtomicPathCursorLocationRightAfter(_) -> right_case()
    Cons(_, _) -> match child_failure
      AtomicPathInputExhausted(_, _) -> impossible
      AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
      AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        atomic_path_active_child_rejection_canonical_current_dispatch(
          child_whole,
          child_failure_origin_equivalence,
          child_failure_origin_canonical,
          child_suffix,
          child_selected_origin_canonical,
          child_selection_suffix,
          left_case,
          left_tail_case,
          fn(strict) -> atomic_path_failure_prefix_reverse_dispatch(
              child_whole,
              child_current,
              child_selected_current,
              child_prefix_kind,
              child_prefix,
              atomic_path_failed_selected_child_suffix(
                child_failure_origin_equivalence,
                child_failure_origin_canonical,
                child_selected_origin_canonical,
                child_selection_suffix
              ),
              strict,
              right_case
            )
        )

  ## Dispatch the indexed active-child alignment at the construction site. The
  ## alignment case is already proof-relevant, so the three continuations can
  ## remain proof-only while the eventual sibling-tail induction is supplied
  ## by the caller that owns the child refutation.
  @reducible
  fn atomic_path_active_child_rejection_tail_fold(
    {n: Nat},
    {failure_current: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    location: AtomicPathActiveChildAlignmentCase(n, failure_current, selected_current),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = match location
    AtomicPathActiveChildAlignmentCaseHere() -> head_case()
    AtomicPathActiveChildAlignmentCaseThere() -> tail_case()
    AtomicPathActiveChildAlignmentCaseReverse() -> reverse_case()

  ## Align a recursively rejected active child with the selected child trace.
  ## The child failure kind is fixed before this helper is called, while the
  ## two cursor suffixes remain relevant construction-site witnesses for the
  ## alignment eliminator.  Both directions are explicit continuations: the
  ## left-to-right branch can descend through the rejected sibling tail, and
  ## the right-to-left branch remains the separate reverse induction case.
  ## Keep the singleton child head at a named construction-site boundary. It
  ## receives only the cursor evidence consumed by the destination-rejection
  ## alignment authority; canonical origin equality is handled before this
  ## smaller cursor-only boundary. The
  ## separate head theorem remains the next place to specialize the
  ## one-character leaf without duplicating the alignment authority.
  @reducible
  fn atomic_path_active_child_rejection_head_excludes_trace(
    {n: Nat},
    @erased failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure_current: List(LookaroundAdmittedState(n)),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    selected_whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_excludes_destination_rejected(
    failure_whole,
    failure_current,
    failure_suffix,
    failure_nonempty,
    selected_whole,
    selected_whole_equivalence,
    selected_suffix,
    left_case,
    left_tail_case,
    right_case
  )

  ## Terminal child failures are discharged by the existing indexed leaves.
  ## These two construction-site lemmas deliberately take the terminal child
  ## refutation as an index, rather than inspecting an erased failure tag in a
  ## runtime branch.  A caller that has refined the rejected head to one of
  ## these constructors can therefore eliminate its selected child trace
  ## without reifying proof data.
  @reducible
  fn atomic_path_active_child_rejection_head_input_exhausted_excludes_trace(
    {@erased depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {candidate_current: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased _failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      Nil(),
      AtomicPathFailureInputExhausted()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = atomic_path_input_exhaustion_excludes_trace(
    machine,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    path
  )

  ## A rejected active head whose child has no input left cannot also publish
  ## a selected active-child trace.  This is the first non-terminal parent
  ## construction boundary: the parent failure is a destination rejection,
  ## but its child refutation is refined to `AtomicPathInputExhausted` by the
  ## one-character input index.  Matching the parent transition and then
  ## feeding its selected child trace to the erased terminal eliminator keeps
  ## the contradiction at the nested construction site.
  @reducible
  fn atomic_path_active_child_rejection_head_active_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    {failure_whole: List(LookaroundAdmittedState(n))},
    {@erased failure_remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), failure_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {@erased selected_remaining: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, _, _, _, _, _, _) -> match path
      AtomicSelectedPrefixDone() -> impossible
      AtomicSelectedExactDone() -> impossible
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_trace) -> match child_failure
        AtomicPathInputExhausted(_, _) -> atomic_path_input_exhaustion_excludes_trace_erased(child_trace)
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  @reducible
  fn atomic_path_active_child_rejection_head_exact_accepted_excludes_trace(
    {@erased depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    {@erased char: Char},
    {@erased rest: List(Char)},
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    reversed_prefix: List(Char),
    {candidate_current: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased _failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadAccepted(),
      history,
      capture_context,
      policy,
      scope_depth,
      False(),
      reversed_prefix,
      Nil(),
      Nil(),
      AtomicPathFailureExactAccepted()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadAccepted(),
      history,
      capture_context,
      policy,
      scope_depth,
      False(),
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = atomic_path_exact_failure_excludes_trace(
    machine,
    char,
    rest,
    after_input,
    history,
    capture_context,
    policy,
    scope_depth,
    reversed_prefix,
    _failure,
    path
  )

  @reducible
  fn atomic_path_active_child_rejection_excludes_destination_rejected(
    {n: Nat},
    @erased failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure_current: List(LookaroundAdmittedState(n)),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    selected_whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_tail_fold(
    atomic_path_active_child_alignment_from_nonempty(
      failure_nonempty,
      failure_suffix,
      selected_whole_equivalence,
      selected_suffix
    ),
    left_case,
    left_tail_case,
    right_case
  )

  ## A singleton recursively rejected child can expose one more indexed leaf.
  ## When its selected suffix is the same head as the stored failure cursor,
  ## and that head is active, the nested destination rejection has an empty
  ## child input after its one transition.  Reuse the existing terminal
  ## active-child contradiction at this construction site; all other cursor,
  ## state, and input shapes remain on the generic alignment continuations.
  @reducible
  fn atomic_path_active_child_rejection_singleton_active_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    after_input: List(Char),
    destination: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    child_scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    {failure_whole: List(LookaroundAdmittedState(n))},
    {@erased failure_remaining: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), failure_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), failure_remaining),
      matched,
      remaining_input,
      child_selected_routine
    )
  ) -> Empty = atomic_path_active_child_rejection_head_active_excludes_trace(
    machine,
    child_char,
    after_input,
    destination,
    history,
    capture_context,
    policy,
    child_scope_depth,
    prefix_mode,
    reversed_prefix,
    active_state,
    active_routine,
    active_constraints,
    active_assertion_routine,
    active_assertion_markers,
    active_nested_decisions,
    child_failure,
    child_path
  )

  @reducible
  fn atomic_path_active_child_rejection_singleton_active_excludes_trace_erased(
    {@erased depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    {@erased child_char: Char},
    {@erased after_input: List(Char)},
    {@erased destination: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_scope_depth: Nat},
    {@erased prefix_mode: Bool},
    {@erased reversed_prefix: List(Char)},
    {@erased active_state: Bounded(n)},
    {@erased active_routine: List(EvidenceInstruction)},
    {@erased active_constraints: List(BoundaryConstraint)},
    {@erased active_assertion_routine: List(ExtendedInstruction)},
    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased failure_whole: List(LookaroundAdmittedState(n))},
    {@erased failure_remaining: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), failure_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {@erased child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), failure_remaining),
      matched,
      remaining_input,
      child_selected_routine
    )
  ) -> Empty = match child_failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, nested_failure, _, _, _, _, _, _) -> match child_path
      AtomicSelectedPrefixDone() -> impossible
      AtomicSelectedExactDone() -> impossible
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_trace) -> match nested_failure
        AtomicPathInputExhausted(_, _) -> atomic_path_input_exhaustion_excludes_trace_erased(child_trace)
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  @reducible
  fn atomic_path_accepted_child_rejection_singleton_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    after_input: List(Char),
    destination: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    child_scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {failure_whole: List(LookaroundAdmittedState(n))},
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {failure_remaining: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), failure_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    @erased _child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), failure_remaining),
      matched,
      remaining_input,
      child_selected_routine
    )
  ) -> Empty = match child_failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_nested_failure, _, _, _, _, _, _) -> match child_nested_failure
      AtomicPathInputExhausted(_, _) -> impossible

  @reducible
  fn atomic_path_accepted_child_rejection_singleton_excludes_trace_erased(
    {@erased depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    {@erased child_char: Char},
    {@erased after_input: List(Char)},
    {@erased destination: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_scope_depth: Nat},
    {@erased prefix_mode: Bool},
    {@erased reversed_prefix: List(Char)},
    {@erased failure_whole: List(LookaroundAdmittedState(n))},
    {@erased accepted_routine: List(EvidenceInstruction)},
    {@erased accepted_constraints: List(BoundaryConstraint)},
    {@erased accepted_assertion_routine: List(ExtendedInstruction)},
    {@erased accepted_assertion_markers: List(EvidenceInstruction)},
    {@erased accepted_nested_decisions: List(LookaroundNestedDecision)},
    {@erased failure_remaining: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), failure_remaining),
      AtomicPathFailureDestinationRejected()
    )
  ) -> Empty = match child_failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_nested_failure, _, _, _, _, _, _) -> match child_nested_failure
      AtomicPathInputExhausted(_, _) -> impossible

  ## Align the singleton rejected-child cursor with the selected child cursor
  ## at their common canonical origin. The equality branch fixes both traces to
  ## the same candidate. Active candidates use the singleton contradiction;
  ## accepted candidates cannot carry the indexed empty-input child failure.
  ## Directional cases remain the recursive sibling-tail obligations.
  @reducible
  fn atomic_path_active_child_rejection_singleton_aligned_excludes_trace(
    {@erased depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    {@erased child_char: Char},
    {@erased after_input: List(Char)},
    {@erased destination: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_scope_depth: Nat},
    {@erased prefix_mode: Bool},
    {@erased reversed_prefix: List(Char)},
    failure_whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    {@erased failure_remaining: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(candidate, failure_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      failure_whole,
      Cons(candidate, failure_remaining)
    ),
    {@erased selected_whole: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      selected_whole,
      selected_current
    ),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    left_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = match candidate
    LookaroundAdmittedActive(_, _, _, _, _, _) -> match atomic_path_cursor_location(
        failure_whole,
        failure_suffix,
        transport_lookaround_admitted_cursor_suffix_outer(
          selected_whole_equivalence,
          selected_suffix
        )
      )
        AtomicPathCursorLocationSame(equality) -> match equality
          reflexive() -> atomic_path_active_child_rejection_singleton_active_excludes_trace_erased(
            child_failure,
            child_path
          )
        AtomicPathCursorLocationLeftAfter(_) -> left_case()
        AtomicPathCursorLocationRightAfter(_) -> right_case()
    LookaroundAdmittedAccepted(_, _, _, _, _) -> match atomic_path_cursor_location(
        failure_whole,
        failure_suffix,
        transport_lookaround_admitted_cursor_suffix_outer(
          selected_whole_equivalence,
          selected_suffix
        )
      )
        AtomicPathCursorLocationSame(equality) -> match equality
          reflexive() -> atomic_path_accepted_child_rejection_singleton_excludes_trace_erased(child_failure)
        AtomicPathCursorLocationLeftAfter(_) -> left_case()
        AtomicPathCursorLocationRightAfter(_) -> right_case()

  @reducible
  fn atomic_path_active_child_rejection_excludes_aligned_trace(
    {@erased depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
