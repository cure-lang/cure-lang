  ## If the rejected skipped head is an active candidate whose child ran out
  ## of input, selecting that same head exposes the contradictory child trace
  ## directly. The package match keeps the failure, scope refinement, and
  ## selected transition at one proof-only construction boundary.
  @reducible
  fn atomic_path_rejected_skipped_head_input_exhausted_excludes_selected_trace(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased active_state: Bounded(n)},
    {@erased active_routine: List(EvidenceInstruction)},
    {@erased active_constraints: List(BoundaryConstraint)},
    {@erased active_assertion_routine: List(ExtendedInstruction)},
    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased tail_kind: AtomicPathSkippedPrefixKind},
    @erased package: AtomicPathRejectedSkippedHeadPackage(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, AtomicPathFailureInputExhausted(), tail_kind)),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), front), matched, remaining_input, selected_routine)
