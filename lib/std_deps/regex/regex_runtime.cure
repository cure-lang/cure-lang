      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = let empty_input: List(Char) = []
    let head_case: result = atomic_start_tail_active_candidate_rejection_excludes_trace(
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      child_failure,
      child_suffix,
      evidence,
      path
    )
    atomic_start_rejected_member_induction_selected_erased(
      machine,
      position,
      empty_input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      failure,
      evidence,
      membership,
      selected_path,
      head_case,
      tail_case
    )

  ## Consume the active root-tail package at the exact empty-child boundary.
  ## The recursive continuation remains the relevant result; matching the
  ## package first ensures that only a root active-child exhaustion certificate
  ## can cross this bridge.
  @reducible
  fn atomic_start_active_root_failure_empty(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
