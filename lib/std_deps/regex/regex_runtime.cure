@group(:text)
mod Std.Regex.Runtime
  ## Executable Regex machine, evidence VM, typed compiler, and combinators.
  use Std.Regex.Core
  use Std.Char
  use Std.Option
  use Std.List
  use Std.String
  use Std.Syntax
  use Std.Bounded
  use Std.Equivalent
  use Std.Sigma
  use Std.Decision

  @reducible
  fn build_transition_rows(remaining: Nat, {total: Nat}, inject: (Bounded(remaining)) -> Bounded(total), next: (Bounded(total)) -> Char -> List(MachineState(total))) -> TransitionRowsFrom(remaining, total) = match remaining
    Z() -> NoTransitionRows()
    S(rest) ->
      MoreTransitionRows(
        fn(char) -> next(inject(First()), char),
        build_transition_rows(rest, fn(state) -> inject(Next(state)), next)
      )

  @reducible
  fn compile_transition_rows(n: Nat, machine: PatternMachine(n)) -> TransitionRows(n) = match machine
    MkPatternMachine(_, next) -> TransitionRows(build_transition_rows(n, fn(state) -> state, next))

  @reducible
  fn rows_from_next(n: Nat, next: (Bounded(n)) -> Char -> List(MachineState(n))) -> TransitionRows(n) =
    TransitionRows(build_transition_rows(n, fn(state) -> state, next))

  fn transition_rows_constructor_equivalent(
    {n: Nat},
    values: TransitionRowsFrom(n, n),
    state: Bounded(n),
    char: Char
  ) -> Equivalent(
    List(MachineState(n)),
    transition_rows_next(TransitionRows(values), state, char),
    transition_rows_from_next(values, state, char)
  ) = reflexive(transition_rows_from_next(values, state, char))

  fn rows_from_next_value_equivalent(
    n: Nat,
    next: (Bounded(n)) -> Char -> List(MachineState(n))
  ) -> Equivalent(
    TransitionRows(n),
    rows_from_next(n, next),
    TransitionRows(build_transition_rows(n, fn(state) -> state, next))
  ) = reflexive(rows_from_next(n, next))

  fn rows_from_next_equivalent(
    n: Nat,
    next: (Bounded(n)) -> Char -> List(MachineState(n)),
    state: Bounded(n),
    char: Char
  ) -> Equivalent(
    List(MachineState(n)),
    transition_rows_next(rows_from_next(n, next), state, char),
    next(state, char)
  ) = trans(
    trans(
      cong(
        fn(rows) -> transition_rows_next(rows, state, char),
        rows_from_next_value_equivalent(n, next)
      ),
      transition_rows_constructor_equivalent(
        build_transition_rows(n, fn(state) -> state, next),
        state,
        char
      )
    ),
    build_transition_rows_equivalent(n, fn(state) -> state, next, state, char)
  )

  @reducible
  fn transition_rows_from_next({remaining: Nat}, {total: Nat}, rows: TransitionRowsFrom(remaining, total), state: Bounded(remaining), char: Char) -> List(MachineState(total)) = match rows
    NoTransitionRows() -> match state
    MoreTransitionRows(row, rest) -> match state
      First() -> row(char)
      Next(index) -> transition_rows_from_next(rest, index, char)

  @reducible
  fn transition_rows_next({n: Nat}, rows: TransitionRows(n), state: Bounded(n), char: Char) -> List(MachineState(n)) = match rows
    TransitionRows(values) -> transition_rows_from_next(values, state, char)

  ## A table-backed machine exposes the same indexed machine interface as the
  ## reference closure machine.  The only runtime closure is this single row
  ## lookup adapter; transition construction itself is performed once when
  ## the table is built, not by recursively rebuilding Thompson combinators
  ## for each input character.
  @reducible
  fn transition_rows_machine({n: Nat}, starts: List(MachineState(n)), rows: TransitionRows(n)) -> PatternMachine(n) =
    MkPatternMachine(starts, fn(state) -> fn(char) -> transition_rows_next(rows, state, char))

  fn transition_rows_machine_next_equation({n: Nat}, starts: List(MachineState(n)), rows: TransitionRows(n), state: Bounded(n), char: Char) -> Equivalent(
    List(MachineState(n)),
    pattern_machine_next_at(transition_rows_machine(starts, rows), state, char),
    transition_rows_next(rows, state, char)
  ) = reflexive(transition_rows_next(rows, state, char))

  ## Pointwise correctness of the row compiler.  This is intentionally a
  ## smaller theorem than function extensionality: every concrete bounded
  ## source state reduces to the row installed for that state, so callers can
  ## transport an edge without changing the existing PatternMachine proof
  ## indices.
  fn build_transition_rows_equivalent(
    remaining: Nat,
    {total: Nat},
    inject: (Bounded(remaining)) -> Bounded(total),
    next: (Bounded(total)) -> Char -> List(MachineState(total)),
    state: Bounded(remaining),
    char: Char
  ) -> Equivalent(
    List(MachineState(total)),
    transition_rows_from_next(build_transition_rows(remaining, inject, next), state, char),
    (next(inject(state), char))
  ) = match remaining
    Z() -> match state
    S(rest) -> match state
      First() -> reflexive(next(inject(First()), char))
      Next(index) -> build_transition_rows_equivalent(rest, fn(state) -> inject(Next(state)), next, index, char)

  fn transition_rows_next_equivalent(
    n: Nat,
    starts: List(MachineState(n)),
    next: (Bounded(n)) -> Char -> List(MachineState(n)),
    state: Bounded(n),
    char: Char
  ) -> Equivalent(
    List(MachineState(n)),
    transition_rows_next(compile_transition_rows(n, MkPatternMachine(starts, next)), state, char),
    next(state, char)
  ) = build_transition_rows_equivalent(n, fn(state) -> state, next, state, char)

  fn transition_rows_next_from_machine(n: Nat, machine: PatternMachine(n), state: Bounded(n), char: Char) -> Equivalent(
    List(MachineState(n)),
    transition_rows_next(compile_transition_rows(n, machine), state, char),
    pattern_machine_next_at(machine, state, char)
  ) = match machine
    MkPatternMachine(starts, next) -> transition_rows_next_equivalent(n, starts, next, state, char)

  @reducible
  fn machine_state_routine(n: Nat, state: MachineState(n)) -> List(EvidenceInstruction) = match state
    Active(_, routine, _) -> routine
    Accepted(routine, _) -> routine

  fn append_routine(left: List(EvidenceInstruction), right: List(EvidenceInstruction)) -> List(EvidenceInstruction) = match left
    [] -> right
    [head | rest] -> [head | append_routine(rest, right)]

  @reducible
  fn append_states({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n))) -> List(MachineState(n)) = match left
    [] -> right
    [head | rest] -> [head | append_states(rest, right)]

  @reducible
  fn append_machine_states(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) -> List(MachineState(n)) =
    append_states(left, right)

  fn append_constraints(left: List(BoundaryConstraint), right: List(BoundaryConstraint)) -> List(BoundaryConstraint) = match left
    [] -> right
    [head | rest] -> [head | append_constraints(rest, right)]

  @reducible
  fn inject_left_states({left_count: Nat}, {right_count: Nat}, states: List(MachineState(left_count))) -> List(MachineState(plus(left_count, right_count))) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(routine, constraints) | inject_left_states(rest)]
    [Active(state, routine, constraints) | rest] -> [Active(inject_left_at(left_count, right_count, state), routine, constraints) | inject_left_states(rest)]

  @reducible
  fn inject_alternate_left(left_count: Nat, right_count: Nat, state: Bounded(left_count)) -> Bounded(plus(left_count, right_count)) =
    inject_left(state)

  @reducible
  fn inject_alternate_right(left_count: Nat, right_count: Nat, state: Bounded(right_count)) -> Bounded(plus(left_count, right_count)) =
    inject_right(left_count, state)

  fn alternate_left_injection_is_widening({left_count: Nat}, @erased right_count: Nat, state: Bounded(left_count)) -> Equivalent(Bounded(plus(left_count, right_count)), inject_alternate_left(left_count, right_count, state), inject_left_at(left_count, right_count, state)) =
    reflexive(inject_left_at(left_count, right_count, state))

  fn alternate_left_widening_is_injection({left_count: Nat}, @erased right_count: Nat, state: Bounded(left_count)) -> Equivalent(Bounded(plus(left_count, right_count)), inject_left_at(left_count, right_count, state), inject_alternate_left(left_count, right_count, state)) =
    reflexive(inject_left_at(left_count, right_count, state))

  fn alternate_right_injection_is_inject_right(left_count: Nat, {right_count: Nat}, state: Bounded(right_count)) -> Equivalent(Bounded(plus(left_count, right_count)), inject_alternate_right(left_count, right_count, state), inject_right_at(left_count, right_count, state)) =
    reflexive(inject_right_at(left_count, right_count, state))

  @reducible
  fn inject_right_states(left_count: Nat, {right_count: Nat}, states: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(routine, constraints) | inject_right_states(left_count, rest)]
    [Active(state, routine, constraints) | rest] -> [Active(inject_right(left_count, state), routine, constraints) | inject_right_states(left_count, rest)]

  @reducible
  fn enter_right_with_constraints(left_count: Nat, {right_count: Nat}, left_routine: List(EvidenceInstruction), left_constraints: List(BoundaryConstraint), right_starts: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) = match right_starts
    [] -> []
    [Accepted(right_routine, right_constraints) | rest] ->
      [Accepted(append_routine(append_routine(left_routine, right_routine), [EmitPair()]), append_constraints(left_constraints, right_constraints)) | enter_right_with_constraints(left_count, left_routine, left_constraints, rest)]
    [Active(state, right_routine, right_constraints) | rest] ->
      [Active(inject_right(left_count, state), append_routine(left_routine, right_routine), append_constraints(left_constraints, right_constraints)) | enter_right_with_constraints(left_count, left_routine, left_constraints, rest)]

  fn enter_right(left_count: Nat, {right_count: Nat}, left_routine: List(EvidenceInstruction), right_starts: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) =
    enter_right_with_constraints(left_count, left_routine, [], right_starts)

  @reducible
  fn continue_with_right(left_count: Nat, {right_count: Nat}, left_states: List(MachineState(left_count)), right_starts: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) = match left_states
    [] -> []
    [Accepted(left_routine, constraints) | rest] -> append_states(enter_right_with_constraints(left_count, left_routine, constraints, right_starts), continue_with_right(left_count, rest, right_starts))
    [Active(state, routine, constraints) | rest] -> [Active(inject_left_at(left_count, right_count, state), routine, constraints) | continue_with_right(left_count, rest, right_starts)]

  @reducible
  fn finish_pair({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [EmitPair()]), constraints) | finish_pair(rest)]
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | finish_pair(rest)]

  @reducible
  fn mark_branch({n: Nat}, states: List(MachineState(n)), marker: EvidenceInstruction) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [marker]), constraints) | mark_branch(rest, marker)]
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | mark_branch(rest, marker)]

  @reducible
  fn append_branch_marker(routine: List(EvidenceInstruction), marker: EvidenceInstruction) -> List(EvidenceInstruction) =
    append_routine(routine, Cons(marker, Nil()))

  @reducible
  fn alternate_left_states(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction) -> List(MachineState(plus(left_count, right_count))) =
    inject_left_states(mark_branch(states, marker))

  @reducible
  fn alternate_right_states(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction) -> List(MachineState(plus(left_count, right_count))) =
    inject_right_states(left_count, mark_branch(states, marker))

  fn prefix_routine({n: Nat}, instruction: EvidenceInstruction, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted([instruction | routine], constraints) | prefix_routine(instruction, rest)]
    [Active(state, routine, constraints) | rest] -> [Active(state, [instruction | routine], constraints) | prefix_routine(instruction, rest)]

  fn finish_capture_with({n: Nat}, end_instruction: EvidenceInstruction, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [end_instruction]), constraints) | finish_capture_with(end_instruction, rest)]
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | finish_capture_with(end_instruction, rest)]

  fn finish_capture({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) =
    finish_capture_with(EndCapture(), states)

  @reducible
  fn repeat_accepting({n: Nat}, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint)) -> List(MachineState(n)) =
    [Accepted(append_routine(routine, [EndList()]), constraints)]

  @reducible
  fn repeat_destination_order({n: Nat}, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) = pickup
    lazy -> append_states(repeat_accepting(routine, constraints), enter_repeat_with_constraints(routine, constraints, starts))
    else -> append_states(enter_repeat_with_constraints(routine, constraints, starts), repeat_accepting(routine, constraints))

  @reducible
  fn repeat_destinations({n: Nat}, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) = match destinations
    [] -> []
    [Accepted(routine, constraints) | rest] ->
      append_states(repeat_destination_order(routine, constraints, starts, lazy), repeat_destinations(rest, starts, lazy))
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | repeat_destinations(rest, starts, lazy)]

  @reducible
  fn enter_repeat_with_constraints({n: Nat}, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n))) -> List(MachineState(n)) = match starts
    [] -> []
    [Accepted(_, _) | rest] -> enter_repeat_with_constraints(routine, constraints, rest)
    [Active(state, next_routine, next_constraints) | rest] ->
      [Active(state, append_routine(routine, next_routine), append_constraints(constraints, next_constraints)) | enter_repeat_with_constraints(routine, constraints, rest)]

  @reducible
  fn enter_repeat({n: Nat}, routine: List(EvidenceInstruction), starts: List(MachineState(n))) -> List(MachineState(n)) =
    enter_repeat_with_constraints(routine, [], starts)

  @reducible
  fn predicate_machine_destinations(holds: Bool, char: Char) -> List(MachineState(S(Z()))) = match holds
    False() -> []
    True() -> [Accepted([EmitChar(char)], [])]

  @reducible
  fn predicate_machine_next(test: Char -> Bool, _state: Bounded(S(Z())), char: Char) -> List(MachineState(S(Z()))) =
    predicate_machine_destinations(test(char), char)

  fn empty_machine_next({n: Nat}, _state: Bounded(n), _char: Char) -> List(MachineState(n)) = []

  @reducible
  fn group_machine_next_with({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), end_instruction: EvidenceInstruction, state: Bounded(n), char: Char) -> List(MachineState(n)) =
    match next(state, char)
      [] -> []
      [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [end_instruction]), constraints) | finish_capture_with(end_instruction, rest)]
      [Active(active, routine, constraints) | rest] -> [Active(active, routine, constraints) | finish_capture_with(end_instruction, rest)]

  @reducible
  fn group_machine_next({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    group_machine_next_with(next, EndCapture(), state, char)

  ## Atomic scopes preserve every ordinary machine state, but mark entry and
  ## every accepting exit in the routine stream.  The ordered search consumes
  ## these markers to discard lower-priority siblings after the first exit;
  ## transition construction itself remains the same finite Thompson machine.
  @reducible
  fn atomic_start_states({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> [Active(state, [BeginAtomic() | routine], constraints) | atomic_start_states(rest)]
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine([BeginAtomic()], append_routine(routine, [EndAtomic()])), constraints) | atomic_start_states(rest)]

  @reducible
  fn atomic_destination_states({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | atomic_destination_states(rest)]
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [EndAtomic()]), constraints) | atomic_destination_states(rest)]

  @reducible
  fn atomic_pattern_machine({n: Nat}, machine: PatternMachine(n)) -> PatternMachine(n) = match machine
    MkPatternMachine(starts, next) -> MkPatternMachine(
      atomic_start_states(starts),
      fn(state) -> fn(char) -> atomic_destination_states(next(state, char))
    )

  @reducible
  fn concat_machine_next_from_side(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), side: BoundedSum(left_count, right_count), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    match side
      BoundedLeft(left_state) -> continue_with_right(left_count, left_next(left_state, char), right_starts)
      BoundedRight(right_state) -> inject_right_states(left_count, finish_pair(right_next(right_state, char)))

  @reducible
  fn concat_machine_next(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    concat_machine_next_from_side(left_count, left_next, right_starts, right_next, split_sum(left_count, state), char)

  @reducible
  fn alternate_machine_next_from_side(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), side: BoundedSum(left_count, right_count), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    match side
      BoundedLeft(left_state) -> inject_left_states(mark_branch(left_next(left_state, char), EmitLeft()))
      BoundedRight(right_state) -> inject_right_states(left_count, mark_branch(right_next(right_state, char), EmitRight()))

  @reducible
  fn alternate_machine_next(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    alternate_machine_next_from_side(left_count, left_next, right_next, split_sum(left_count, state), char)

  @reducible
  fn alternate_starts_order({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), prefer_right: Bool) -> List(MachineState(n)) = match prefer_right
    True() -> append_states(right, left)
    False() -> append_states(left, right)

  @reducible
  fn alternate_machine_starts(left_count: Nat, {right_count: Nat}, left_starts: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), prefer_right: Bool) -> List(MachineState(plus(left_count, right_count))) =
    let marked_left: List(MachineState(plus(left_count, right_count))) = inject_left_states(mark_branch(left_starts, EmitLeft()))
    let marked_right: List(MachineState(plus(left_count, right_count))) = inject_right_states(left_count, mark_branch(right_starts, EmitRight()))
    alternate_starts_order(marked_left, marked_right, prefer_right)

  @reducible
  fn alternate_pattern_machine(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool) -> PatternMachine(plus(left_count, right_count)) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        MkPatternMachine(
          alternate_machine_starts(left_count, left_starts, right_starts, prefer_right),
          alternate_machine_next(left_count, left_next, right_next)
        )

  @reducible
  fn repeat_machine_starts({n: Nat}, starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) =
    let empty: List(MachineState(n)) = [Accepted([BeginList(), EndList()], [])]
    let consuming: List(MachineState(n)) = enter_repeat([BeginList()], starts)
    pickup
      lazy -> append_states(empty, consuming)
      else -> append_states(consuming, empty)

  @reducible
  fn repeat_machine_next({n: Nat}, starts: List(MachineState(n)), lazy: Bool, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    repeat_destinations(next(state, char), starts, lazy)

  fn empty_pattern_machine() -> PatternMachine(Z()) =
    let starts: List(MachineState(Z())) = [Accepted([EmitUnit()], [])]
    MkPatternMachine(starts, empty_machine_next)

  @reducible
  fn boundary_pattern_machine(constraint: BoundaryConstraint) -> PatternMachine(Z()) =
    let routine: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
    let constraints: List(BoundaryConstraint) = Cons(constraint, Nil())
    let starts: List(MachineState(Z())) = Cons(Accepted(routine, constraints), Nil())
    MkPatternMachine(starts, empty_machine_next)

  fn capture_condition_constraint(slot: Nat, participated: Bool) -> BoundaryConstraint = pickup
    participated -> capture_participated_constraint(slot)
    else -> capture_absent_constraint(slot)

  fn guard_states({n: Nat}, constraint: BoundaryConstraint, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, append_constraints([constraint], constraints)) | guard_states(constraint, rest)]
    [Accepted(routine, constraints) | rest] -> [Accepted(routine, append_constraints([constraint], constraints)) | guard_states(constraint, rest)]

  @reducible
  fn guard_pattern_machine({n: Nat}, constraint: BoundaryConstraint, machine: PatternMachine(n)) -> PatternMachine(n) = match machine
    MkPatternMachine(starts, next) -> MkPatternMachine(guard_states(constraint, starts), next)

  @reducible
  fn predicate_machine_start() -> MachineState(S(Z())) =
    let routine: List(EvidenceInstruction) = []
    let constraints: List(BoundaryConstraint) = []
    Active(First(), routine, constraints)

  @reducible
  fn predicate_machine_thread() -> ThreadState(S(Z())) = ThreadActive(First())

  @reducible
  fn predicate_accepting_destination(char: Char) -> MachineState(S(Z())) =
    let routine: List(EvidenceInstruction) = [EmitChar(char)]
    let constraints: List(BoundaryConstraint) = []
    Accepted(routine, constraints)

  @reducible
  fn predicate_pattern_machine(test: Char -> Bool) -> PatternMachine(S(Z())) =
    let starts: List(MachineState(S(Z()))) = [predicate_machine_start()]
    MkPatternMachine(starts, predicate_machine_next(test))

  @reducible
  fn group_pattern_machine(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n))) -> PatternMachine(n) =
    MkPatternMachine(
      finish_capture(prefix_routine(BeginCapture(), starts)),
      group_machine_next(next)
    )

  @reducible
  fn group_pattern_machine_with_slot(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), slot: Nat) -> PatternMachine(n) =
    MkPatternMachine(
      finish_capture_with(EndCaptureSlot(slot), prefix_routine(BeginCaptureSlot(slot), starts)),
      group_machine_next_with(next, EndCaptureSlot(slot))
    )

  @reducible
  fn concat_pattern_machine(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count)) -> PatternMachine(plus(left_count, right_count)) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        MkPatternMachine(
          continue_with_right(left_count, left_starts, right_starts),
          concat_machine_next(left_count, left_next, right_starts, right_next)
        )

  @reducible
  fn repeat_pattern_machine(n: Nat, machine: PatternMachine(n), lazy: Bool) -> PatternMachine(n) = match machine
    MkPatternMachine(starts, next) ->
      MkPatternMachine(
        repeat_machine_starts(starts, lazy),
        repeat_machine_next(starts, lazy, next)
      )

  @reducible
  fn rows_as_next({n: Nat}, rows: TransitionRows(n)) -> (Bounded(n)) -> Char -> List(MachineState(n)) =
    fn(state) -> fn(char) -> transition_rows_next(rows, state, char)

  @reducible
  fn staged_group_next({n: Nat}, rows: TransitionRows(n), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    group_machine_next(rows_as_next(rows), state, char)

  @reducible
  fn staged_group_next_function({n: Nat}, rows: TransitionRows(n)) -> (Bounded(n)) -> Char -> List(MachineState(n)) =
    fn(state) -> fn(char) -> staged_group_next(rows, state, char)

  @reducible
  fn staged_concat_next_from_side(left_count: Nat, {right_count: Nat}, left_rows: TransitionRows(left_count), right_starts: List(MachineState(right_count)), right_rows: TransitionRows(right_count), side: BoundedSum(left_count, right_count), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    match side
      BoundedLeft(left_state) -> continue_with_right(left_count, transition_rows_next(left_rows, left_state, char), right_starts)
      BoundedRight(right_state) -> inject_right_states(left_count, finish_pair(transition_rows_next(right_rows, right_state, char)))

  @reducible
  fn staged_concat_next(left_count: Nat, {right_count: Nat}, left_rows: TransitionRows(left_count), right_starts: List(MachineState(right_count)), right_rows: TransitionRows(right_count), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    staged_concat_next_from_side(left_count, left_rows, right_starts, right_rows, split_sum(left_count, state), char)

  @reducible
  fn staged_concat_next_function(left_count: Nat, {right_count: Nat}, left_rows: TransitionRows(left_count), right_starts: List(MachineState(right_count)), right_rows: TransitionRows(right_count)) -> (Bounded(plus(left_count, right_count))) -> Char -> List(MachineState(plus(left_count, right_count))) =
    fn(state) -> fn(char) -> staged_concat_next(left_count, left_rows, right_starts, right_rows, state, char)

  @reducible
  fn staged_alternate_next_from_side(left_count: Nat, {right_count: Nat}, left_rows: TransitionRows(left_count), right_rows: TransitionRows(right_count), side: BoundedSum(left_count, right_count), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    match side
      BoundedLeft(left_state) -> inject_left_states(mark_branch(transition_rows_next(left_rows, left_state, char), EmitLeft()))
      BoundedRight(right_state) -> inject_right_states(left_count, mark_branch(transition_rows_next(right_rows, right_state, char), EmitRight()))

  @reducible
  fn staged_alternate_next(left_count: Nat, {right_count: Nat}, left_rows: TransitionRows(left_count), right_rows: TransitionRows(right_count), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    staged_alternate_next_from_side(left_count, left_rows, right_rows, split_sum(left_count, state), char)

  @reducible
  fn staged_alternate_next_function(left_count: Nat, {right_count: Nat}, left_rows: TransitionRows(left_count), right_rows: TransitionRows(right_count)) -> (Bounded(plus(left_count, right_count))) -> Char -> List(MachineState(plus(left_count, right_count))) =
    fn(state) -> fn(char) -> staged_alternate_next(left_count, left_rows, right_rows, state, char)

  @reducible
  fn staged_repeat_next({n: Nat}, starts: List(MachineState(n)), rows: TransitionRows(n), lazy: Bool, state: Bounded(n), char: Char) -> List(MachineState(n)) =
    repeat_machine_next(starts, lazy, rows_as_next(rows), state, char)

  @reducible
  fn staged_repeat_next_function({n: Nat}, starts: List(MachineState(n)), rows: TransitionRows(n), lazy: Bool) -> (Bounded(n)) -> Char -> List(MachineState(n)) =
    fn(state) -> fn(char) -> staged_repeat_next(starts, rows, lazy, state, char)

  @reducible
  fn staged_group_starts({n: Nat}, starts: List(MachineState(n))) -> List(MachineState(n)) =
    finish_capture(prefix_routine(BeginCapture(), starts))

  @reducible
  fn staged_concat_starts(left_count: Nat, {right_count: Nat}, left_starts: List(MachineState(left_count)), right_starts: List(MachineState(right_count))) -> List(MachineState(plus(left_count, right_count))) =
    continue_with_right(left_count, left_starts, right_starts)

  @reducible
  fn staged_alternate_starts(left_count: Nat, {right_count: Nat}, left_starts: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), prefer_right: Bool) -> List(MachineState(plus(left_count, right_count))) =
    alternate_machine_starts(left_count, left_starts, right_starts, prefer_right)

  @reducible
  fn staged_repeat_starts({n: Nat}, starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) =
    repeat_machine_starts(starts, lazy)

  ## Constructor-preserving Thompson IR. Both runtime compilation and the
  ## evidence theorem consume this same tree, so proof code never reconstructs
  ## machine provenance from a function-valued transition table.
  type ThompsonCompilation indices (shape: ShapeCode)
    ThompsonPredicate : (test: (Char -> Bool)) -> ThompsonCompilation(CharC)
    ThompsonEmpty : ThompsonCompilation(UnitC)
    ThompsonBoundary : (constraint: BoundaryConstraint) -> ThompsonCompilation(UnitC)
    ThompsonConcat : (left: ThompsonCompilation(left_shape)) -> (right: ThompsonCompilation(right_shape)) -> ThompsonCompilation(PairC(left_shape, right_shape))
    ThompsonGroup : (inner: ThompsonCompilation(inner_shape)) -> ThompsonCompilation(StringC)
    ThompsonAlternate : (left: ThompsonCompilation(left_shape)) -> (right: ThompsonCompilation(right_shape)) -> (prefer_right: Bool) -> ThompsonCompilation(ChoiceC(left_shape, right_shape))
    ThompsonRepeat : (inner: ThompsonCompilation(inner_shape)) -> (lazy: Bool) -> ThompsonCompilation(ListC(inner_shape))

  ## Lookaround compilation is a runtime-only parallel IR. It preserves the
  ## same finite Thompson constructors as the ordinary proof IR, but adds an
  ## explicit atomic scope so assertion operands cannot silently erase
  ## ordered commitment when they cross an assertion boundary. The ordinary
  ## typed proof remains over ThompsonCompilation; this tree is consumed only
  ## by the checked finite assertion evaluator.
  type LookaroundCompilation indices (shape: ShapeCode)
    LookaroundPredicate : (test: (Char -> Bool)) -> LookaroundCompilation(CharC)
    LookaroundEmpty : LookaroundCompilation(UnitC)
    LookaroundBoundary : (constraint: BoundaryConstraint) -> LookaroundCompilation(UnitC)
    LookaroundBoundaryGuard : (constraint: BoundaryConstraint) -> (inner: LookaroundCompilation(inner_shape)) -> LookaroundCompilation(inner_shape)
    LookaroundConcat : (left: LookaroundCompilation(left_shape)) -> (right: LookaroundCompilation(right_shape)) -> LookaroundCompilation(PairC(left_shape, right_shape))
    LookaroundGroup : (inner: LookaroundCompilation(inner_shape)) -> LookaroundCompilation(StringC)
    LookaroundGroupSlot : (slot: Nat) -> (inner: LookaroundCompilation(inner_shape)) -> LookaroundCompilation(StringC)
    LookaroundAlternate : (left: LookaroundCompilation(left_shape)) -> (right: LookaroundCompilation(right_shape)) -> (prefer_right: Bool) -> LookaroundCompilation(ChoiceC(left_shape, right_shape))
    LookaroundRepeat : (inner: LookaroundCompilation(inner_shape)) -> (lazy: Bool) -> LookaroundCompilation(ListC(inner_shape))
    LookaroundAtomic : (inner: LookaroundCompilation(inner_shape)) -> LookaroundCompilation(inner_shape)
    LookaroundGuard : (slot: Nat) -> (participated: Bool) -> (inner: LookaroundCompilation(inner_shape)) -> LookaroundCompilation(inner_shape)

  ## Named compilation is constructor-for-constructor parallel to the checked
  ## Thompson tree.  Only group nodes differ: they carry the explicit slot ID
  ## used by the capture ledger.  Erasing the IDs recovers the ordinary
  ## compilation, so language proofs can remain independent of names.
  type NamedThompsonCompilation indices (shape: ShapeCode)
    NamedThompsonPredicate : (test: (Char -> Bool)) -> NamedThompsonCompilation(CharC)
    NamedThompsonEmpty : NamedThompsonCompilation(UnitC)
    NamedThompsonBoundary : (constraint: BoundaryConstraint) -> NamedThompsonCompilation(UnitC)
    NamedThompsonConcat : (left: NamedThompsonCompilation(left_shape)) -> (right: NamedThompsonCompilation(right_shape)) -> NamedThompsonCompilation(PairC(left_shape, right_shape))
    NamedThompsonCapture : (inner: NamedThompsonCompilation(inner_shape)) -> NamedThompsonCompilation(StringC)
    NamedThompsonGroup : (slot: Nat) -> (inner: NamedThompsonCompilation(inner_shape)) -> NamedThompsonCompilation(StringC)
    NamedThompsonGuard : (slot: Nat) -> (participated: Bool) -> (inner: NamedThompsonCompilation(inner_shape)) -> NamedThompsonCompilation(inner_shape)
    NamedThompsonAlternate : (left: NamedThompsonCompilation(left_shape)) -> (right: NamedThompsonCompilation(right_shape)) -> (prefer_right: Bool) -> NamedThompsonCompilation(ChoiceC(left_shape, right_shape))
    NamedThompsonRepeat : (inner: NamedThompsonCompilation(inner_shape)) -> (lazy: Bool) -> NamedThompsonCompilation(ListC(inner_shape))

  ## Erasure certificate: every named compilation has exactly the ordinary
  ## Thompson compilation obtained by dropping slot IDs.  This is the bridge
  ## used by the typed proof path; capture metadata cannot alter language.
  type NamedCompilationErasure indices (shape: ShapeCode, named: NamedThompsonCompilation(shape), ordinary: ThompsonCompilation(shape))
    NamedPredicateErasure : NamedCompilationErasure(CharC, NamedThompsonPredicate(test), ThompsonPredicate(test))
    NamedEmptyErasure : NamedCompilationErasure(UnitC, NamedThompsonEmpty(), ThompsonEmpty())
    NamedBoundaryErasure : NamedCompilationErasure(UnitC, NamedThompsonBoundary(constraint), ThompsonBoundary(constraint))
    NamedConcatErasure : {@erased left_shape: ShapeCode} -> {@erased right_shape: ShapeCode} -> {@erased left_named: NamedThompsonCompilation(left_shape)} -> {@erased right_named: NamedThompsonCompilation(right_shape)} -> {@erased left_ordinary: ThompsonCompilation(left_shape)} -> {@erased right_ordinary: ThompsonCompilation(right_shape)} -> (@erased left: NamedCompilationErasure(left_shape, left_named, left_ordinary)) -> (@erased right: NamedCompilationErasure(right_shape, right_named, right_ordinary)) -> NamedCompilationErasure(PairC(left_shape, right_shape), NamedThompsonConcat(left_named, right_named), ThompsonConcat(left_ordinary, right_ordinary))
    NamedCaptureErasure : {@erased inner_shape: ShapeCode} -> {@erased inner_named: NamedThompsonCompilation(inner_shape)} -> {@erased inner_ordinary: ThompsonCompilation(inner_shape)} -> (@erased inner: NamedCompilationErasure(inner_shape, inner_named, inner_ordinary)) -> NamedCompilationErasure(StringC, NamedThompsonCapture(inner_named), ThompsonGroup(inner_ordinary))
    NamedGroupErasure : {@erased inner_shape: ShapeCode} -> {@erased inner_named: NamedThompsonCompilation(inner_shape)} -> {@erased inner_ordinary: ThompsonCompilation(inner_shape)} -> (slot: Nat) -> (@erased inner: NamedCompilationErasure(inner_shape, inner_named, inner_ordinary)) -> NamedCompilationErasure(StringC, NamedThompsonGroup(slot, inner_named), ThompsonGroup(inner_ordinary))
    NamedGuardErasure : {@erased inner_shape: ShapeCode} -> {@erased inner_named: NamedThompsonCompilation(inner_shape)} -> {@erased inner_ordinary: ThompsonCompilation(inner_shape)} -> (slot: Nat) -> (participated: Bool) -> (@erased inner: NamedCompilationErasure(inner_shape, inner_named, inner_ordinary)) -> NamedCompilationErasure(inner_shape, NamedThompsonGuard(slot, participated, inner_named), inner_ordinary)
    NamedAlternateErasure : {@erased left_shape: ShapeCode} -> {@erased right_shape: ShapeCode} -> {@erased left_named: NamedThompsonCompilation(left_shape)} -> {@erased right_named: NamedThompsonCompilation(right_shape)} -> {@erased left_ordinary: ThompsonCompilation(left_shape)} -> {@erased right_ordinary: ThompsonCompilation(right_shape)} -> (@erased left: NamedCompilationErasure(left_shape, left_named, left_ordinary)) -> (@erased right: NamedCompilationErasure(right_shape, right_named, right_ordinary)) -> (prefer_right: Bool) -> NamedCompilationErasure(ChoiceC(left_shape, right_shape), NamedThompsonAlternate(left_named, right_named, prefer_right), ThompsonAlternate(left_ordinary, right_ordinary, prefer_right))
    NamedRepeatErasure : {@erased inner_shape: ShapeCode} -> {@erased inner_named: NamedThompsonCompilation(inner_shape)} -> {@erased inner_ordinary: ThompsonCompilation(inner_shape)} -> (@erased inner: NamedCompilationErasure(inner_shape, inner_named, inner_ordinary)) -> (lazy: Bool) -> NamedCompilationErasure(ListC(inner_shape), NamedThompsonRepeat(inner_named, lazy), ThompsonRepeat(inner_ordinary, lazy))

  fn certify_named_compilation({shape: ShapeCode}, compilation: NamedThompsonCompilation(shape)) -> NamedCompilationErasure(shape, compilation, erase_named_thompson(compilation)) = match compilation
    NamedThompsonPredicate(_) -> NamedPredicateErasure()
    NamedThompsonEmpty() -> NamedEmptyErasure()
    NamedThompsonBoundary(_) -> NamedBoundaryErasure()
    NamedThompsonConcat(left, right) -> NamedConcatErasure(certify_named_compilation(left), certify_named_compilation(right))
    NamedThompsonCapture(inner) -> NamedCaptureErasure(certify_named_compilation(inner))
    NamedThompsonGroup(slot, inner) -> NamedGroupErasure(slot, certify_named_compilation(inner))
    NamedThompsonGuard(slot, participated, inner) -> NamedGuardErasure(slot, participated, certify_named_compilation(inner))
    NamedThompsonAlternate(left, right, prefer_right) -> NamedAlternateErasure(certify_named_compilation(left), certify_named_compilation(right), prefer_right)
    NamedThompsonRepeat(inner, lazy) -> NamedRepeatErasure(certify_named_compilation(inner), lazy)

  @reducible
  fn named_thompson_state_count({@erased shape: ShapeCode}, compilation: NamedThompsonCompilation(shape)) -> Nat = match compilation
    NamedThompsonPredicate(_) -> S(Z())
    NamedThompsonEmpty() -> Z()
    NamedThompsonBoundary(_) -> Z()
    NamedThompsonConcat(left, right) -> plus(named_thompson_state_count(left), named_thompson_state_count(right))
    NamedThompsonCapture(inner) -> named_thompson_state_count(inner)
    NamedThompsonGroup(_, inner) -> named_thompson_state_count(inner)
    NamedThompsonGuard(_, _, inner) -> named_thompson_state_count(inner)
    NamedThompsonAlternate(left, right, _) -> plus(named_thompson_state_count(left), named_thompson_state_count(right))
    NamedThompsonRepeat(inner, _) -> named_thompson_state_count(inner)

  @reducible
  fn erase_named_thompson({@erased shape: ShapeCode}, compilation: NamedThompsonCompilation(shape)) -> ThompsonCompilation(shape) = match compilation
    NamedThompsonPredicate(test) -> ThompsonPredicate(test)
    NamedThompsonEmpty() -> ThompsonEmpty()
    NamedThompsonBoundary(constraint) -> ThompsonBoundary(constraint)
    NamedThompsonConcat(left, right) -> ThompsonConcat(erase_named_thompson(left), erase_named_thompson(right))
    NamedThompsonCapture(inner) -> ThompsonGroup(erase_named_thompson(inner))
    NamedThompsonGroup(_, inner) -> ThompsonGroup(erase_named_thompson(inner))
    NamedThompsonGuard(_, _, inner) -> erase_named_thompson(inner)
    NamedThompsonAlternate(left, right, prefer_right) -> ThompsonAlternate(erase_named_thompson(left), erase_named_thompson(right), prefer_right)
    NamedThompsonRepeat(inner, lazy) -> ThompsonRepeat(erase_named_thompson(inner), lazy)

  @reducible
  fn named_thompson_machine({@erased shape: ShapeCode}, compilation: NamedThompsonCompilation(shape)) -> PatternMachine(named_thompson_state_count(compilation)) = match compilation
    NamedThompsonPredicate(test) -> predicate_pattern_machine(test)
    NamedThompsonEmpty() -> empty_pattern_machine()
    NamedThompsonBoundary(constraint) -> boundary_pattern_machine(constraint)
    NamedThompsonConcat(left, right) -> concat_pattern_machine(named_thompson_state_count(left), named_thompson_machine(left), named_thompson_state_count(right), named_thompson_machine(right))
    NamedThompsonCapture(inner) ->
      let inner_machine = named_thompson_machine(inner)
      group_pattern_machine(named_thompson_state_count(inner), pattern_machine_starts(inner_machine), pattern_machine_next(inner_machine))
    NamedThompsonGroup(slot, inner) ->
      let inner_machine = named_thompson_machine(inner)
      group_pattern_machine_with_slot(named_thompson_state_count(inner), pattern_machine_starts(inner_machine), pattern_machine_next(inner_machine), slot)
    NamedThompsonGuard(slot, participated, inner) -> guard_pattern_machine(capture_condition_constraint(slot, participated), named_thompson_machine(inner))
    NamedThompsonAlternate(left, right, prefer_right) -> alternate_pattern_machine(named_thompson_state_count(left), named_thompson_machine(left), named_thompson_state_count(right), named_thompson_machine(right), prefer_right)
    NamedThompsonRepeat(inner, lazy) -> repeat_pattern_machine(named_thompson_state_count(inner), named_thompson_machine(inner), lazy)

  @reducible
  fn thompson_state_count({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> Nat = match compilation
    ThompsonPredicate(_) -> S(Z())
    ThompsonEmpty() -> Z()
    ThompsonBoundary(_) -> Z()
    ThompsonConcat(left, right) -> plus(thompson_state_count(left), thompson_state_count(right))
    ThompsonGroup(inner) -> thompson_state_count(inner)
    ThompsonAlternate(left, right, _) -> plus(thompson_state_count(left), thompson_state_count(right))
    ThompsonRepeat(inner, _) -> thompson_state_count(inner)

  ## Construct the closure machine once per Thompson subtree.  Let-binding the
  ## child results is important: starts and next are two projections of the
  ## same child value, not two independent recursive reconstructions.
  fn staged_machine_seed_from_compilation({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> PatternMachine(thompson_state_count(compilation)) = match compilation
    ThompsonPredicate(test) -> predicate_pattern_machine(test)
    ThompsonEmpty() -> empty_pattern_machine()
    ThompsonBoundary(constraint) -> boundary_pattern_machine(constraint)
    ThompsonGroup(inner) ->
      let inner_machine = staged_machine_seed_from_compilation(inner)
      group_pattern_machine(thompson_state_count(inner), pattern_machine_starts(inner_machine), pattern_machine_next(inner_machine))
    ThompsonConcat(left, right) ->
      let left_machine = staged_machine_seed_from_compilation(left)
      let right_machine = staged_machine_seed_from_compilation(right)
      concat_pattern_machine(thompson_state_count(left), left_machine, thompson_state_count(right), right_machine)
    ThompsonAlternate(left, right, prefer_right) ->
      let left_machine = staged_machine_seed_from_compilation(left)
      let right_machine = staged_machine_seed_from_compilation(right)
      alternate_pattern_machine(thompson_state_count(left), left_machine, thompson_state_count(right), right_machine, prefer_right)
    ThompsonRepeat(inner, lazy) ->
      let inner_machine = staged_machine_seed_from_compilation(inner)
      repeat_pattern_machine(thompson_state_count(inner), inner_machine, lazy)

  @reducible
  fn direct_staged_rows_values_from_compilation({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> TransitionRows(thompson_state_count(compilation)) =
    compile_transition_rows(thompson_state_count(compilation), staged_machine_seed_from_compilation(compilation))

  @reducible
  fn direct_staged_starts_from_compilation({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> List(MachineState(thompson_state_count(compilation))) =
    pattern_machine_starts(staged_machine_seed_from_compilation(compilation))

  ## Compatibility reference retained for differential checking.  It preserves
  ## the original row formulas while the active machine below uses the direct
  ## staged rows; this keeps the comparison path independent of the optimized
  ## construction.
  @reducible
  fn staged_rows_values_from_compilation({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> TransitionRows(thompson_state_count(compilation)) = match compilation
    ThompsonPredicate(test) -> rows_from_next(S(Z()), staged_predicate_next_function(test))
    ThompsonEmpty() -> staged_empty_rows()
    ThompsonBoundary(constraint) -> staged_boundary_rows(constraint)
    ThompsonGroup(inner) -> rows_from_next(thompson_state_count(inner), staged_group_next_function(staged_rows_values_from_compilation(inner)))
    ThompsonConcat(left, right) -> rows_from_next(plus(thompson_state_count(left), thompson_state_count(right)), staged_concat_next_function(thompson_state_count(left), staged_rows_values_from_compilation(left), pattern_machine_starts(thompson_machine(right)), staged_rows_values_from_compilation(right)))
    ThompsonAlternate(left, right, _) -> rows_from_next(plus(thompson_state_count(left), thompson_state_count(right)), staged_alternate_next_function(thompson_state_count(left), staged_rows_values_from_compilation(left), staged_rows_values_from_compilation(right)))
    ThompsonRepeat(inner, lazy) -> rows_from_next(thompson_state_count(inner), staged_repeat_next_function(pattern_machine_starts(thompson_machine(inner)), staged_rows_values_from_compilation(inner), lazy))

  @reducible
  fn staged_starts_from_compilation({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> List(MachineState(thompson_state_count(compilation))) =
    pattern_machine_starts(thompson_machine(compilation))

  @reducible
  fn staged_rows_from_compilation({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> StagedRows(thompson_state_count(compilation)) =
    StagedRowsValue(staged_starts_from_compilation(compilation), staged_rows_values_from_compilation(compilation))

  @reducible
  fn pattern_machine_starts({n: Nat}, machine: PatternMachine(n)) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, next) -> starts

  @reducible
  fn pattern_machine_next({n: Nat}, machine: PatternMachine(n)) -> (Bounded(n)) -> Char -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, next) -> next

  @reducible
  fn pattern_machine_next_value({n: Nat}, machine: PatternMachine(n), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    pattern_machine_next(machine)(state, char)

  fn pattern_machine_next_at_from_next(
    {n: Nat},
    machine: PatternMachine(n),
    state: Bounded(n),
    char: Char
  ) -> Equivalent(
    List(MachineState(n)),
    pattern_machine_next_at(machine, state, char),
    pattern_machine_next_value(machine, state, char)
  ) = match machine
    MkPatternMachine(_, next) -> reflexive(next(state, char))

  @reducible
  fn pattern_machine_next_at({n: Nat}, machine: PatternMachine(n), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    match machine
      MkPatternMachine(_, next) -> next(state, char)

  fn pattern_machine_eta({n: Nat}, machine: PatternMachine(n)) -> Equivalent(PatternMachine(n), machine, MkPatternMachine(pattern_machine_starts(machine), pattern_machine_next(machine))) = match machine
    MkPatternMachine(starts, next) -> reflexive(MkPatternMachine(starts, next))

  @reducible
  ## Reference constructor retained for differential tests.
  fn reference_thompson_machine({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> PatternMachine(thompson_state_count(compilation)) = match compilation
    ThompsonPredicate(test) -> predicate_pattern_machine(test)
    ThompsonEmpty() -> empty_pattern_machine()
    ThompsonBoundary(constraint) -> boundary_pattern_machine(constraint)
    ThompsonConcat(left, right) -> concat_pattern_machine(thompson_state_count(left), reference_thompson_machine(left), thompson_state_count(right), reference_thompson_machine(right))
    ThompsonGroup(inner) -> group_pattern_machine(thompson_state_count(inner), pattern_machine_starts(reference_thompson_machine(inner)), pattern_machine_next(reference_thompson_machine(inner)))
    ThompsonAlternate(left, right, prefer_right) -> alternate_pattern_machine(thompson_state_count(left), reference_thompson_machine(left), thompson_state_count(right), reference_thompson_machine(right), prefer_right)
    ThompsonRepeat(inner, lazy) -> repeat_pattern_machine(thompson_state_count(inner), reference_thompson_machine(inner), lazy)

  ## Canonical constructor.  The reference copy above is deliberately kept
  ## separate so transition-row implementations can be compared without
  ## changing the proof theorem's original definitional equations.
  fn thompson_machine({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> PatternMachine(thompson_state_count(compilation)) = match compilation
    ThompsonPredicate(test) -> predicate_pattern_machine(test)
    ThompsonEmpty() -> empty_pattern_machine()
    ThompsonBoundary(constraint) -> boundary_pattern_machine(constraint)
    ThompsonConcat(left, right) -> concat_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right))
    ThompsonGroup(inner) -> group_pattern_machine(thompson_state_count(inner), pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner)))
    ThompsonAlternate(left, right, prefer_right) -> alternate_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right)
    ThompsonRepeat(inner, lazy) -> repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy)

  @reducible
  fn lookaround_state_count({@erased shape: ShapeCode}, compilation: LookaroundCompilation(shape)) -> Nat = match compilation
    LookaroundPredicate(_) -> S(Z())
    LookaroundEmpty() -> Z()
    LookaroundBoundary(_) -> Z()
    LookaroundBoundaryGuard(_, inner) -> lookaround_state_count(inner)
    LookaroundConcat(left, right) -> plus(lookaround_state_count(left), lookaround_state_count(right))
    LookaroundGroup(inner) -> lookaround_state_count(inner)
    LookaroundGroupSlot(_, inner) -> lookaround_state_count(inner)
    LookaroundAlternate(left, right, _) -> plus(lookaround_state_count(left), lookaround_state_count(right))
    LookaroundRepeat(inner, _) -> lookaround_state_count(inner)
    LookaroundAtomic(inner) -> lookaround_state_count(inner)
    LookaroundGuard(_, _, inner) -> lookaround_state_count(inner)

  ## Build the finite child machine once. Atomic scopes are represented by
  ## the same BeginAtomic/EndAtomic routine markers used by the ordinary
  ## runtime plan, so nested assertion evaluation can apply one commitment
  ## invariant rather than maintaining a second backtracking mechanism.
  @reducible
  fn lookaround_machine({@erased shape: ShapeCode}, compilation: LookaroundCompilation(shape)) -> PatternMachine(lookaround_state_count(compilation)) = match compilation
    LookaroundPredicate(test) -> predicate_pattern_machine(test)
    LookaroundEmpty() -> empty_pattern_machine()
    LookaroundBoundary(constraint) -> boundary_pattern_machine(constraint)
    LookaroundBoundaryGuard(constraint, inner) -> guard_pattern_machine(constraint, lookaround_machine(inner))
    LookaroundConcat(left, right) -> concat_pattern_machine(lookaround_state_count(left), lookaround_machine(left), lookaround_state_count(right), lookaround_machine(right))
    LookaroundGroup(inner) ->
      let inner_machine = lookaround_machine(inner)
      group_pattern_machine(lookaround_state_count(inner), pattern_machine_starts(inner_machine), pattern_machine_next(inner_machine))
    LookaroundGroupSlot(slot, inner) ->
      let inner_machine = lookaround_machine(inner)
      group_pattern_machine_with_slot(lookaround_state_count(inner), pattern_machine_starts(inner_machine), pattern_machine_next(inner_machine), slot)
    LookaroundAlternate(left, right, prefer_right) -> alternate_pattern_machine(lookaround_state_count(left), lookaround_machine(left), lookaround_state_count(right), lookaround_machine(right), prefer_right)
    LookaroundRepeat(inner, lazy) -> repeat_pattern_machine(lookaround_state_count(inner), lookaround_machine(inner), lazy)
    LookaroundAtomic(inner) -> atomic_pattern_machine(lookaround_machine(inner))
    LookaroundGuard(slot, participated, inner) -> guard_pattern_machine(capture_condition_constraint(slot, participated), lookaround_machine(inner))

  @reducible
  fn lookaround_compiled({@erased shape: ShapeCode}, compilation: LookaroundCompilation(shape)) -> Sigma(n: Nat, PatternMachine(n)) = %[lookaround_state_count(compilation), lookaround_machine(compilation)]

  @reducible
  fn staged_predicate_next(test: Char -> Bool, state: Bounded(S(Z())), char: Char) -> List(MachineState(S(Z()))) =
    predicate_machine_next(test, state, char)

  @reducible
  fn staged_predicate_next_function(test: Char -> Bool) -> (Bounded(S(Z()))) -> Char -> List(MachineState(S(Z()))) =
    fn(state) -> fn(char) -> predicate_machine_next(test, state, char)

  @reducible
  fn staged_empty_rows() -> TransitionRows(Z()) =
    rows_from_next(Z(), empty_machine_next)

  @reducible
  fn staged_boundary_rows(constraint: BoundaryConstraint) -> TransitionRows(Z()) =
    rows_from_next(Z(), empty_machine_next)

  type StagedRows(n: Nat) indices ()
    StagedRowsValue : (starts: List(MachineState(n))) -> (rows: TransitionRows(n)) -> StagedRows(n)

  @reducible
  fn group_next_output({n: Nat}, destinations: List(MachineState(n))) -> List(MachineState(n)) = match destinations
    [] -> []
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [EndCapture()]), constraints) | finish_capture(rest)]
    [Active(active, routine, constraints) | rest] -> [Active(active, routine, constraints) | finish_capture(rest)]

  @reducible
  fn group_empty_output({n: Nat}) -> List(MachineState(n)) = []

  fn group_machine_next_equation(
    {n: Nat},
    next: (Bounded(n)) -> Char -> List(MachineState(n)),
    state: Bounded(n),
    char: Char
  ) -> Equivalent(List(MachineState(n)), group_machine_next(next, state, char), group_next_output(next(state, char))) = match next(state, char)
    [] -> reflexive(assert_type group_empty_output() : List(MachineState(n)))
    [Accepted(routine, constraints) | rest] -> reflexive(group_next_output([Accepted(routine, constraints) | rest]))
    [Active(active, routine, constraints) | rest] -> reflexive(group_next_output([Active(active, routine, constraints) | rest]))

  fn group_next_output_equivalent(
    {n: Nat},
    left_next: (Bounded(n)) -> Char -> List(MachineState(n)),
    right_next: (Bounded(n)) -> Char -> List(MachineState(n)),
    state: Bounded(n),
    char: Char,
    equality: Equivalent(List(MachineState(n)), left_next(state, char), right_next(state, char))
  ) -> Equivalent(List(MachineState(n)), group_machine_next(left_next, state, char), group_machine_next(right_next, state, char)) = trans(
    group_machine_next_equation(left_next, state, char),
    trans(
      cong(fn(values) -> group_next_output(values), equality),
      sym(group_machine_next_equation(right_next, state, char))
    )
  )

  fn group_pattern_machine_next_equation(
    n: Nat,
    starts: List(MachineState(n)),
    next: (Bounded(n)) -> Char -> List(MachineState(n)),
    state: Bounded(n),
    char: Char
  ) -> Equivalent(
    List(MachineState(n)),
    pattern_machine_next_at(group_pattern_machine(n, starts, next), state, char),
    group_machine_next(next, state, char)
  ) = reflexive(group_machine_next(next, state, char))

  fn concat_pattern_machine_next_equation(
    left_count: Nat,
    left_machine: PatternMachine(left_count),
    right_count: Nat,
    right_machine: PatternMachine(right_count),
    state: Bounded(plus(left_count, right_count)),
    char: Char
  ) -> Equivalent(
    List(MachineState(plus(left_count, right_count))),
    pattern_machine_next_at(concat_pattern_machine(left_count, left_machine, right_count, right_machine), state, char),
    concat_machine_next(left_count, pattern_machine_next(left_machine), pattern_machine_starts(right_machine), pattern_machine_next(right_machine), state, char)
  ) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) -> reflexive(concat_machine_next(left_count, left_next, right_starts, right_next, state, char))

  fn staged_concat_rows_transition_equation(
    left_count: Nat,
    right_count: Nat,
    left_rows: TransitionRows(left_count),
    right_starts: List(MachineState(right_count)),
    right_rows: TransitionRows(right_count),
    state: Bounded(plus(left_count, right_count)),
    char: Char
  ) -> Equivalent(
    List(MachineState(plus(left_count, right_count))),
    transition_rows_next(rows_from_next(plus(left_count, right_count), staged_concat_next_function(left_count, left_rows, right_starts, right_rows)), state, char),
    staged_concat_next(left_count, left_rows, right_starts, right_rows, state, char)
  ) = rows_from_next_equivalent(
    plus(left_count, right_count),
    staged_concat_next_function(left_count, left_rows, right_starts, right_rows),
    state,
    char
  )

  ## Staged literals use a row-backed machine. The transition rows are built
  ## from the direct staged machine seed below, rather than reconstructing a
  ## canonical Thompson machine for every child closure.
  @reducible
  fn staged_machine_from_compilation({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> PatternMachine(thompson_state_count(compilation)) =
    transition_rows_machine(
      direct_staged_starts_from_compilation(compilation),
      direct_staged_rows_values_from_compilation(compilation)
    )

  fn staged_machine_rows_transition_equivalent(
    {@erased shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    state: Bounded(thompson_state_count(compilation)),
    char: Char
  ) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    pattern_machine_next_at(staged_machine_from_compilation(compilation), state, char),
    transition_rows_next(direct_staged_rows_values_from_compilation(compilation), state, char)
  ) = transition_rows_machine_next_equation(
    direct_staged_starts_from_compilation(compilation),
    direct_staged_rows_values_from_compilation(compilation),
    state,
    char
  )

  fn direct_pattern_machine_next_congruence(
    {n: Nat},
    left: PatternMachine(n),
    right: PatternMachine(n),
    state: Bounded(n),
    char: Char,
    equality: Equivalent(PatternMachine(n), left, right)
  ) -> Equivalent(
    List(MachineState(n)),
    pattern_machine_next_at(left, state, char),
    pattern_machine_next_at(right, state, char)
  ) = match equality
    reflexive() -> reflexive(pattern_machine_next_at(left, state, char))

  fn direct_pattern_machine_starts_congruence(
    {n: Nat},
    left: PatternMachine(n),
    right: PatternMachine(n),
    equality: Equivalent(PatternMachine(n), left, right)
  ) -> Equivalent(
    List(MachineState(n)),
    pattern_machine_starts(left),
    pattern_machine_starts(right)
  ) = match equality
    reflexive() -> reflexive(pattern_machine_starts(left))

  fn direct_staged_group_machine_function(n: Nat) -> (PatternMachine(n)) -> PatternMachine(n) =
    fn(machine) -> group_pattern_machine(n, pattern_machine_starts(machine), pattern_machine_next(machine))

  fn direct_staged_concat_left_machine_function(left_count: Nat, right_count: Nat, right_machine: PatternMachine(right_count)) -> (PatternMachine(left_count)) -> PatternMachine(plus(left_count, right_count)) =
    fn(machine) -> concat_pattern_machine(left_count, machine, right_count, right_machine)

  fn direct_staged_concat_right_machine_function(left_count: Nat, right_count: Nat, left_machine: PatternMachine(left_count)) -> (PatternMachine(right_count)) -> PatternMachine(plus(left_count, right_count)) =
    fn(machine) -> concat_pattern_machine(left_count, left_machine, right_count, machine)

  fn direct_staged_alternate_left_machine_function(left_count: Nat, right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool) -> (PatternMachine(left_count)) -> PatternMachine(plus(left_count, right_count)) =
    fn(machine) -> alternate_pattern_machine(left_count, machine, right_count, right_machine, prefer_right)

  fn direct_staged_alternate_right_machine_function(left_count: Nat, right_count: Nat, left_machine: PatternMachine(left_count), prefer_right: Bool) -> (PatternMachine(right_count)) -> PatternMachine(plus(left_count, right_count)) =
    fn(machine) -> alternate_pattern_machine(left_count, left_machine, right_count, machine, prefer_right)

  fn direct_staged_repeat_machine_function(n: Nat, lazy: Bool) -> (PatternMachine(n)) -> PatternMachine(n) =
    fn(machine) -> repeat_pattern_machine(n, machine, lazy)

  fn direct_staged_machine_seed_equivalent({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> Equivalent(
    PatternMachine(thompson_state_count(compilation)),
    staged_machine_seed_from_compilation(compilation),
    thompson_machine(compilation)
  ) = match compilation
    ThompsonPredicate(test) -> reflexive(predicate_pattern_machine(test))
    ThompsonEmpty() -> reflexive(empty_pattern_machine())
    ThompsonBoundary(constraint) -> reflexive(boundary_pattern_machine(constraint))
    ThompsonGroup(inner) -> trans(
      cong(direct_staged_group_machine_function(thompson_state_count(inner)), direct_staged_machine_seed_equivalent(inner)),
      reflexive(group_pattern_machine(thompson_state_count(inner), pattern_machine_starts(thompson_machine(inner)), pattern_machine_next(thompson_machine(inner))))
    )
    ThompsonConcat(left, right) -> trans(
      cong(direct_staged_concat_left_machine_function(thompson_state_count(left), thompson_state_count(right), staged_machine_seed_from_compilation(right)), direct_staged_machine_seed_equivalent(left)),
      trans(
        cong(direct_staged_concat_right_machine_function(thompson_state_count(left), thompson_state_count(right), thompson_machine(left)), direct_staged_machine_seed_equivalent(right)),
        reflexive(concat_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right)))
      )
    )
    ThompsonAlternate(left, right, prefer_right) -> trans(
      cong(direct_staged_alternate_left_machine_function(thompson_state_count(left), thompson_state_count(right), staged_machine_seed_from_compilation(right), prefer_right), direct_staged_machine_seed_equivalent(left)),
      trans(
        cong(direct_staged_alternate_right_machine_function(thompson_state_count(left), thompson_state_count(right), thompson_machine(left), prefer_right), direct_staged_machine_seed_equivalent(right)),
        reflexive(alternate_pattern_machine(thompson_state_count(left), thompson_machine(left), thompson_state_count(right), thompson_machine(right), prefer_right))
      )
    )
    ThompsonRepeat(inner, lazy) -> trans(
      cong(direct_staged_repeat_machine_function(thompson_state_count(inner), lazy), direct_staged_machine_seed_equivalent(inner)),
      reflexive(repeat_pattern_machine(thompson_state_count(inner), thompson_machine(inner), lazy))
    )

  fn direct_staged_rows_transition_equivalent(
    {@erased shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    state: Bounded(thompson_state_count(compilation)),
    char: Char
  ) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    transition_rows_next(direct_staged_rows_values_from_compilation(compilation), state, char),
    pattern_machine_next_at(thompson_machine(compilation), state, char)
  ) = trans(
    transition_rows_next_from_machine(
      thompson_state_count(compilation),
      staged_machine_seed_from_compilation(compilation),
      state,
      char
    ),
    direct_pattern_machine_next_congruence(
      staged_machine_seed_from_compilation(compilation),
      thompson_machine(compilation),
      state,
      char,
      direct_staged_machine_seed_equivalent(compilation)
    )
  )

  fn staged_machine_starts_equivalent({@erased shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    pattern_machine_starts(staged_machine_from_compilation(compilation)),
    pattern_machine_starts(thompson_machine(compilation))
  ) = trans(
    reflexive(pattern_machine_starts(staged_machine_seed_from_compilation(compilation))),
    direct_pattern_machine_starts_congruence(
      staged_machine_seed_from_compilation(compilation),
      thompson_machine(compilation),
      direct_staged_machine_seed_equivalent(compilation)
    )
  )

  fn staged_rows_transition_equivalent(
    {@erased shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    state: Bounded(thompson_state_count(compilation)),
    char: Char
  ) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    transition_rows_next(direct_staged_rows_values_from_compilation(compilation), state, char),
    pattern_machine_next_at(thompson_machine(compilation), state, char)
  ) = direct_staged_rows_transition_equivalent(compilation, state, char)

  fn certify_thompson({@erased shape: ShapeCode}, pattern: Pattern(shape)) -> ThompsonCompilation(shape) = match pattern
    PatternPredicate(test) -> ThompsonPredicate(test)
    PatternEmpty() -> ThompsonEmpty()
    PatternBoundary(constraint) -> ThompsonBoundary(constraint)
    PatternConcat(left, right) -> ThompsonConcat(certify_thompson(left), certify_thompson(right))
    PatternGroup(inner) -> ThompsonGroup(certify_thompson(inner))
    PatternAlternate(left, right) -> ThompsonAlternate(certify_thompson(left), certify_thompson(right), false)
    PatternAlternateMode(left, right, prefer_right) -> ThompsonAlternate(certify_thompson(left), certify_thompson(right), prefer_right)
    PatternRepeat(inner) -> ThompsonRepeat(certify_thompson(inner), false)
    PatternRepeatMode(inner, lazy) -> ThompsonRepeat(certify_thompson(inner), lazy)

  fn atomic_plan_compilation({@erased shape: ShapeCode}, plan: AtomicRuntimePattern(shape)) -> ThompsonCompilation(shape) = match plan
    AtomicRuntimeLeaf(pattern) -> certify_thompson(pattern)
    AtomicRuntimeConcat(left, right) -> ThompsonConcat(atomic_plan_compilation(left), atomic_plan_compilation(right))
    AtomicRuntimeGroup(inner) -> ThompsonGroup(atomic_plan_compilation(inner))
    AtomicRuntimeAlternate(left, right, prefer_right) -> ThompsonAlternate(atomic_plan_compilation(left), atomic_plan_compilation(right), prefer_right)
    AtomicRuntimeScope(inner) -> atomic_plan_compilation(inner)
    AtomicRuntimeRepeat(inner, lazy) -> ThompsonRepeat(atomic_plan_compilation(inner), lazy)

  fn atomic_plan_pattern({@erased shape: ShapeCode}, plan: AtomicRuntimePattern(shape)) -> Pattern(shape) = match plan
    AtomicRuntimeLeaf(pattern) -> pattern
    AtomicRuntimeConcat(left, right) -> PatternConcat(atomic_plan_pattern(left), atomic_plan_pattern(right))
    AtomicRuntimeGroup(inner) -> PatternGroup(atomic_plan_pattern(inner))
    AtomicRuntimeAlternate(left, right, prefer_right) -> PatternAlternateMode(atomic_plan_pattern(left), atomic_plan_pattern(right), prefer_right)
    AtomicRuntimeScope(inner) -> atomic_plan_pattern(inner)
    AtomicRuntimeRepeat(inner, lazy) -> PatternRepeatMode(atomic_plan_pattern(inner), lazy)

  fn atomic_runtime_machine_from_plan({@erased shape: ShapeCode}, plan: AtomicRuntimePattern(shape)) -> PatternMachine(thompson_state_count(atomic_plan_compilation(plan))) = match plan
    AtomicRuntimeLeaf(pattern) -> thompson_machine(certify_thompson(pattern))
    AtomicRuntimeConcat(left, right) -> concat_pattern_machine(thompson_state_count(atomic_plan_compilation(left)), atomic_runtime_machine_from_plan(left), thompson_state_count(atomic_plan_compilation(right)), atomic_runtime_machine_from_plan(right))
    AtomicRuntimeGroup(inner) -> group_pattern_machine(thompson_state_count(atomic_plan_compilation(inner)), pattern_machine_starts(atomic_runtime_machine_from_plan(inner)), pattern_machine_next(atomic_runtime_machine_from_plan(inner)))
    AtomicRuntimeAlternate(left, right, prefer_right) -> alternate_pattern_machine(thompson_state_count(atomic_plan_compilation(left)), atomic_runtime_machine_from_plan(left), thompson_state_count(atomic_plan_compilation(right)), atomic_runtime_machine_from_plan(right), prefer_right)
    AtomicRuntimeScope(inner) -> atomic_pattern_machine(atomic_runtime_machine_from_plan(inner))
    AtomicRuntimeRepeat(inner, lazy) -> repeat_pattern_machine(thompson_state_count(atomic_plan_compilation(inner)), atomic_runtime_machine_from_plan(inner), lazy)

  @reducible
  fn thompson_compiled({shape: ShapeCode}, compilation: ThompsonCompilation(shape)) -> Sigma(n: Nat, PatternMachine(n)) =
    %[thompson_state_count(compilation), thompson_machine(compilation)]

  fn compile_pattern({shape: ShapeCode}, pattern: Pattern(shape)) -> Sigma(n: Nat, PatternMachine(n)) =
    thompson_compiled(certify_thompson(pattern))

  fn machine_has_accept({n: Nat}, states: List(MachineState(n))) -> Bool = match states
    [] -> false
    [Accepted(_, _) | _] -> true
    [Active(_, _, _) | rest] -> machine_has_accept(rest)

  fn machine_step_one({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, current: MachineState(n)) -> List(MachineState(n)) = match current
    Accepted(_, _) -> []
    Active(state, _, _) -> next(state, char)

  fn machine_step({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, current: List(MachineState(n))) -> List(MachineState(n)) = match current
    [] -> []
    [head | rest] -> append_states(machine_step_one(next, char, head), machine_step(next, char, rest))

  fn constraint_holds(constraint: BoundaryConstraint, boundary: Boundary) -> Bool = constraint_holds_with_routine(constraint, boundary, [])

  fn constraint_holds_with_routine(constraint: BoundaryConstraint, boundary: Boundary, routine: List(EvidenceInstruction)) -> Bool = match boundary
    Boundary(subject_start, _subject_end, strict_subject_end, _line_start, _line_end, ascii_boundary, unicode_boundary, previous_char, next_char, after_next_char) -> match constraint
      BoundaryConstraint(require_subject_start, require_subject_end, require_strict_end, require_line_start, require_line_end, check_ascii, expected_ascii, check_unicode, expected_unicode, policy, capture_condition, _) ->
        (not require_subject_start or subject_start) and
          (not require_subject_end or subject_end_for(policy, next_char, after_next_char)) and
          (not require_strict_end or strict_subject_end) and
          (not require_line_start or line_start_for(policy, previous_char, next_char)) and
          (not require_line_end or line_end_for(policy, next_char, after_next_char)) and
          (not check_ascii or ascii_boundary == expected_ascii) and
          (not check_unicode or unicode_boundary == expected_unicode) and
          capture_condition_holds(capture_condition, routine)

  fn lookaround_polarity_holds(positive: Bool, result: Bool) -> Bool = pickup
    positive -> result
    else -> not result

  fn capture_condition_holds(condition: Option(CaptureCondition), routine: List(EvidenceInstruction)) -> Bool = match condition
    None() -> true
    Some(CaptureParticipated(slot)) -> match capture_participation_decision(slot, routine)
      CaptureParticipatedByRoutine() -> true
      CaptureAbsentByRoutine() -> false
    Some(CaptureAbsent(slot)) -> match capture_participation_decision(slot, routine)
      CaptureParticipatedByRoutine() -> false
      CaptureAbsentByRoutine() -> true

  ## The conditional guard consumes an indexed decision produced from the
  ## destination epsilon routine. This is the finite participation fact used
  ## by named conditionals; it is deliberately separate from capture text and
  ## cannot be manufactured by replaying an unrelated slot.
  type CaptureParticipationDecision indices (slot: Nat, routine: List(EvidenceInstruction))
    CaptureParticipatedByRoutine : CaptureParticipationDecision(slot, routine)
    CaptureAbsentByRoutine : CaptureParticipationDecision(slot, routine)

  fn capture_participation_decision(slot: Nat, routine: List(EvidenceInstruction)) -> CaptureParticipationDecision(slot, routine) = match routine
    [] -> CaptureAbsentByRoutine()
    [EndCaptureSlot(closed_slot) | rest] -> pickup
      same_capture_slot(slot, closed_slot) -> CaptureParticipatedByRoutine()
      else -> match capture_participation_decision(slot, rest)
        CaptureParticipatedByRoutine() -> CaptureParticipatedByRoutine()
        CaptureAbsentByRoutine() -> CaptureAbsentByRoutine()
    [_ | rest] -> match capture_participation_decision(slot, rest)
      CaptureParticipatedByRoutine() -> CaptureParticipatedByRoutine()
      CaptureAbsentByRoutine() -> CaptureAbsentByRoutine()

  fn newline_char(policy: NewlinePolicy, char: Char) -> Bool = match policy
    LFNewline() -> char == '\n'
    CRNewline() -> char == '\r'
    CRLFNewline() -> char == '\r'
    AnyCRLFNewline() -> char == '\r' or char == '\n'
    AnyUnicodeNewline() -> Std.Char.is_newline(char)

  fn option_is_char(value: Option(Char), expected: Char) -> Bool = match value
    Some(char) -> char == expected
    None() -> false

  fn line_start_for(policy: NewlinePolicy, previous_char: Option(Char), next_char: Option(Char)) -> Bool = match previous_char
    None() -> true
    Some(previous) -> match policy
      LFNewline() -> previous == '\n'
      CRNewline() -> previous == '\r'
      CRLFNewline() -> previous == '\n'
      AnyCRLFNewline() -> previous == '\n' or (previous == '\r' and not option_is_char(next_char, '\n'))
      AnyUnicodeNewline() -> newline_char(policy, previous) and (previous != '\r' or not option_is_char(next_char, '\n'))

  fn line_end_for(policy: NewlinePolicy, next_char: Option(Char), after_next_char: Option(Char)) -> Bool = match next_char
    None() -> true
    Some(next) -> match policy
      LFNewline() -> next == '\n'
      CRNewline() -> next == '\r'
      CRLFNewline() -> next == '\r' and option_is_char(after_next_char, '\n')
      AnyCRLFNewline() -> next == '\n' or (next == '\r' and not option_is_char(after_next_char, '\n'))
      AnyUnicodeNewline() -> (newline_char(policy, next) and (next != '\r' or not option_is_char(after_next_char, '\n')))

  fn subject_end_for(policy: NewlinePolicy, next_char: Option(Char), after_next_char: Option(Char)) -> Bool = match next_char
    None() -> true
    Some(next) -> match after_next_char
      None() -> terminal_newline(policy, next)
      Some(after_next) -> next == '\r' and after_next == '\n' and crlf_policy(policy)

  fn terminal_newline(policy: NewlinePolicy, char: Char) -> Bool = match policy
    CRLFNewline() -> false
    _ -> newline_char(policy, char)

  fn crlf_policy(policy: NewlinePolicy) -> Bool = match policy
    CRLFNewline() -> true
    CRNewline() -> false
    AnyCRLFNewline() -> true
    AnyUnicodeNewline() -> true
    LFNewline() -> false

  fn subject_start_constraint() -> BoundaryConstraint =
    subject_start_constraint_with_policy(AnyUnicodeNewline())

  fn subject_start_constraint_with_policy(policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(true, false, false, false, false, false, false, false, false, policy, None(), None())

  fn subject_end_constraint() -> BoundaryConstraint =
    subject_end_constraint_with_policy(AnyUnicodeNewline())

  fn subject_end_constraint_with_policy(policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, true, false, false, false, false, false, false, false, policy, None(), None())

  fn strict_end_constraint() -> BoundaryConstraint =
    strict_end_constraint_with_policy(AnyUnicodeNewline())

  fn strict_end_constraint_with_policy(policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, false, true, false, false, false, false, false, false, policy, None(), None())

  fn line_start_constraint() -> BoundaryConstraint =
    line_start_constraint_with_policy(AnyUnicodeNewline())

  fn line_start_constraint_with_policy(policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, true, false, false, false, false, false, policy, None(), None())

  fn line_end_constraint() -> BoundaryConstraint =
    line_end_constraint_with_policy(AnyUnicodeNewline())

  fn line_end_constraint_with_policy(policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, true, false, false, false, false, policy, None(), None())

  fn ascii_word_constraint(expected: Bool) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, true, expected, false, false, AnyUnicodeNewline(), None(), None())

  fn unicode_word_constraint(expected: Bool) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, true, expected, AnyUnicodeNewline(), None(), None())

  fn capture_participated_constraint(slot: Nat) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, false, false, AnyUnicodeNewline(), Some(CaptureParticipated(slot)), None())

  fn capture_absent_constraint(slot: Nat) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, false, false, AnyUnicodeNewline(), Some(CaptureAbsent(slot)), None())

  ## Assertions are staged as ordinary zero-state boundary nodes.  The child
  ## machine is closed over once here; each boundary check only supplies the
  ## current finite subject context, so no source parser or machine rebuild is
  ## performed during matching.
  fn lookahead_constraint({shape: ShapeCode}, compilation: LookaroundCompilation(shape), positive: Bool, policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, false, false, policy, None(), Some(LookaheadCondition(positive, lookaround_compiled(compilation))))

  fn lookbehind_constraint({shape: ShapeCode}, compilation: LookaroundCompilation(shape), positive: Bool, width: Nat, policy: NewlinePolicy) -> BoundaryConstraint =
    BoundaryConstraint(false, false, false, false, false, false, false, false, false, policy, None(), Some(LookbehindCondition(positive, width, lookaround_compiled(compilation))))

  @reducible
  fn constraints_hold(constraints: List(BoundaryConstraint), boundary: Boundary) -> Bool = match constraints
    [] -> true
    [head | rest] -> constraint_holds(head, boundary) and constraints_hold(rest, boundary)

  fn constraints_hold_with_routine(constraints: List(BoundaryConstraint), boundary: Boundary, routine: List(EvidenceInstruction)) -> Bool = match constraints
    [] -> true
    [head | rest] -> constraint_holds_with_routine(head, boundary, routine) and constraints_hold_with_routine(rest, boundary, routine)

  @reducible
  fn filter_active_decision({n: Nat}, keep: Bool, state: Bounded(n), routine: List(EvidenceInstruction), rest: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) = match keep
    True() -> Cons(Active(state, routine, Nil()), filter_boundary_states(rest, boundary))
    False() -> filter_boundary_states(rest, boundary)

  @reducible
  fn filter_accepted_decision({n: Nat}, keep: Bool, routine: List(EvidenceInstruction), rest: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) = match keep
    True() -> Cons(Accepted(routine, Nil()), filter_boundary_states(rest, boundary))
    False() -> filter_boundary_states(rest, boundary)

  @reducible
  fn filter_boundary_states({n: Nat}, states: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> filter_accepted_decision(constraints_hold(constraints, boundary), routine, rest, boundary)
    [Active(state, routine, constraints) | rest] -> filter_active_decision(constraints_hold(constraints, boundary), state, routine, rest, boundary)

  @reducible
  fn filter_machine_states(n: Nat, states: List(MachineState(n)), boundary: Boundary) -> List(MachineState(n)) =
    filter_boundary_states(states, boundary)

  fn position_line_end(input: List(Char)) -> Bool = match input
    [] -> true
    [char | _] -> Std.Char.is_newline(char)

  fn position_subject_end(input: List(Char)) -> Bool = match input
    [] -> true
    [char] -> Std.Char.is_newline(char)
    _ -> false

  fn next_ascii_word(input: List(Char)) -> Bool = match input
    [] -> false
    [char | _] -> ascii_word(char)

  fn next_unicode_word(input: List(Char)) -> Bool = match input
    [] -> false
    [char | _] -> option_word(char, true)

  fn position_boundary(subject_start: Bool, line_start: Bool, previous_ascii_word: Bool, previous_unicode_word: Bool, previous_char: Option(Char), input: List(Char)) -> Boundary =
    Boundary(
      subject_start,
      position_subject_end(input),
      position_strict_subject_end(input),
      line_start,
      position_line_end(input),
      previous_ascii_word != next_ascii_word(input),
      previous_unicode_word != next_unicode_word(input),
      previous_char,
      option_head(input),
      option_second(input)
    )

  ## Histories are newest-first and bounded to one scalar beyond the eight-
  ## scalar assertion limit.  The extra scalar supplies the boundary context
  ## immediately before a fixed-width lookbehind window.
  fn history_push_bounded(history: List(Char), char: Char) -> List(Char) = history_take_limit([char | history], literal_history_limit())

  fn history_take_limit(values: List(Char), limit: Nat) -> List(Char) = match limit
    Z() -> []
    S(rest_limit) -> match values
      [] -> []
      [head | rest] -> [head | history_take_limit(rest, rest_limit)]

  fn literal_history_limit() -> Nat = S(S(S(S(S(S(S(S(S(Z())))))))))

  fn option_head(input: List(Char)) -> Option(Char) = match input
    [] -> None()
    [char | _] -> Some(char)

  fn option_second(input: List(Char)) -> Option(Char) = match input
    [_ | rest] -> option_head(rest)
    [] -> None()

  fn position_strict_subject_end(input: List(Char)) -> Bool = match input
    [] -> true
    _ -> false

  fn machine_accepts_chars({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), current: List(MachineState(n))) -> Bool = match input
    [] -> machine_has_accept(current)
    [char | rest] ->
      machine_accepts_chars(next, rest, filter_boundary_states(machine_step(next, char, current), position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), Some(char), rest)))

  fn pattern_accepts({shape: ShapeCode}, pattern: Pattern(shape), input: String) -> Bool =
    match compile_pattern(pattern)
      mk_pair(count, machine) ->
        let chars = Std.String.characters(input)
        match search_machine_acceptance(count, machine, subject_initial_position(), chars, [])
          MachineNoAcceptingPath() -> false
          MachineAcceptingPath(_, _, _) -> true

  ## Match positions are zero-based Unicode-scalar offsets, not UTF-8 byte
  ## offsets. `start` and `length` are native Int values so large subjects do
  ## not allocate unary Nat structures at runtime.
  type Match(result: Type) = Match(result, String, String, String, Int, Int)

  type SplitInclusion = ExcludeSeparators | IncludeSeparators
  type SplitTrimming = KeepEmptyParts | TrimEmptyParts
  type SplitLimit = UnlimitedSplit | AtMostSplitParts(Int)
  type SplitOptions = SplitOptions(SplitInclusion, SplitTrimming, SplitLimit)

  @reducible
  fn execute_instruction(instruction: EvidenceInstruction, evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match instruction
    EmitChar(char) -> EvidenceExecution([CharacterEvidence(char) | evidence], captures)
    EmitUnit() -> EvidenceExecution([UnitEvidence() | evidence], captures)
    EmitPair() -> EvidenceExecution([PairEvidence() | evidence], captures)
    EmitLeft() -> EvidenceExecution([LeftEvidence() | evidence], captures)
    EmitRight() -> EvidenceExecution([RightEvidence() | evidence], captures)
    BeginList() -> EvidenceExecution([BeginListEvidence() | evidence], captures)
    EndList() -> EvidenceExecution([EndListEvidence() | evidence], captures)
    BeginCapture() -> EvidenceExecution(evidence, [CaptureFrame([], evidence) | captures])
    BeginCaptureSlot(_) -> EvidenceExecution(evidence, [CaptureFrame([], evidence) | captures])
    EndCapture() -> match captures
      [] -> EvidenceExecution(evidence, [])
      [CaptureFrame(chars, saved) | rest] -> EvidenceExecution([StringEvidence(Std.String.from_characters(evidence_reverse_chars(chars))) | saved], rest)
    EndCaptureSlot(_) -> match captures
      [] -> EvidenceExecution(evidence, [])
      [CaptureFrame(chars, saved) | rest] -> EvidenceExecution([StringEvidence(Std.String.from_characters(evidence_reverse_chars(chars))) | saved], rest)
    BeginAtomic() -> EvidenceExecution(evidence, captures)
    EndAtomic() -> EvidenceExecution(evidence, captures)

  @reducible
  fn execute_routine(routine: List(EvidenceInstruction), evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match routine
    [] -> EvidenceExecution(evidence, captures)
    [instruction | rest] ->
      execute_routine(
        rest,
        executed_evidence(execute_instruction(instruction, evidence, captures)),
        executed_captures(execute_instruction(instruction, evidence, captures))
      )

  @reducible
  fn executed_evidence(execution: EvidenceExecution) -> List(Evidence) = match execution
    EvidenceExecution(evidence, _) -> evidence

  @reducible
  fn executed_captures(execution: EvidenceExecution) -> List(CaptureFrame) = match execution
    EvidenceExecution(_, captures) -> captures

  ## The generalized Thompson proof uses an NFA-independent stream. `Observe`
  ## advances capture input; `Regular` embeds the evidence VM language.
  type ExtendedInstruction = Regular(EvidenceInstruction) | Observe(Char)

  @reducible
  fn regular_routine(routine: List(EvidenceInstruction)) -> List(ExtendedInstruction) = match routine
    [] -> []
    [instruction | rest] -> [Regular(instruction) | regular_routine(rest)]

  type ExtendedEvidenceRoutineExecution indices (routine: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    ExtendedEvidenceDone : {input_evidence: List(Evidence)} -> {input_captures: List(CaptureFrame)} -> ExtendedEvidenceRoutineExecution(Nil(), input_evidence, input_captures, input_evidence, input_captures)
    ExtendedEvidenceObserve : (char: Char) -> {input_captures: List(CaptureFrame)} -> (suffix : ExtendedEvidenceRoutineExecution(rest, input_evidence, record_capture_char(input_captures, char), output_evidence, output_captures)) -> ExtendedEvidenceRoutineExecution(Cons(Observe(char), rest), input_evidence, input_captures, output_evidence, output_captures)
    ExtendedEvidenceRegular : (instruction: EvidenceInstruction) -> {input_evidence: List(Evidence)} -> {input_captures: List(CaptureFrame)} -> (suffix : ExtendedEvidenceRoutineExecution(rest, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), output_evidence, output_captures)) -> ExtendedEvidenceRoutineExecution(Cons(Regular(instruction), rest), input_evidence, input_captures, output_evidence, output_captures)

  type RoutineExecution indices (routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    RoutineDone : {evidence: List(Evidence)} -> {captures: List(CaptureFrame)} -> RoutineExecution(Nil(), evidence, captures, evidence, captures)
    RoutineStep : (instruction: EvidenceInstruction) -> {input_evidence: List(Evidence)} -> {input_captures: List(CaptureFrame)} -> (suffix : RoutineExecution(rest, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), output_evidence, output_captures)) -> RoutineExecution(Cons(instruction, rest), input_evidence, input_captures, output_evidence, output_captures)

  type CertifiedRoutineExecution indices (routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame))
    CertifiedRoutineExecuted : (output_evidence: List(Evidence)) -> (output_captures: List(CaptureFrame)) -> (certificate : RoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> (extended_certificate : ExtendedEvidenceRoutineExecution(regular_routine(routine), input_evidence, input_captures, output_evidence, output_captures)) -> CertifiedRoutineExecution(routine, input_evidence, input_captures)

  fn execute_routine_certified(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) -> CertifiedRoutineExecution(routine, input_evidence, input_captures) =
    match routine
      [] -> CertifiedRoutineExecuted(input_evidence, input_captures, RoutineDone(), ExtendedEvidenceDone())
      [instruction | rest] ->
        let instruction_execution = execute_instruction(instruction, input_evidence, input_captures)
        let next_evidence = executed_evidence(instruction_execution)
        let next_captures = executed_captures(instruction_execution)
        match execute_routine_certified(rest, next_evidence, next_captures)
          CertifiedRoutineExecuted(output_evidence, output_captures, suffix, extended_suffix) ->
            CertifiedRoutineExecuted(output_evidence, output_captures, RoutineStep(instruction, suffix), ExtendedEvidenceRegular(instruction, extended_suffix))

  ## Thompson's evidence proof reasons over one NFA-independent instruction
  ## stream. `Observe` records the consumed character (and advances open capture
  ## frames); `Regular` embeds the existing VM instruction language.
  type ExtendedExecution = ExtendedExecution(Option(Char), List(Evidence), List(CaptureFrame))

  @reducible
  fn transition_routine(char: Char, routine: List(EvidenceInstruction)) -> List(ExtendedInstruction) =
    [Observe(char) | regular_routine(routine)]

  @reducible
  fn append_extended_routines(left: List(ExtendedInstruction), right: List(ExtendedInstruction)) -> List(ExtendedInstruction) = match left
    [] -> right
    [instruction | rest] -> [instruction | append_extended_routines(rest, right)]

  fn execute_extended_instruction(instruction: ExtendedInstruction, current: Option(Char), evidence: List(Evidence), captures: List(CaptureFrame)) -> ExtendedExecution = match instruction
    Observe(char) -> ExtendedExecution(Some(char), evidence, record_capture_char(captures, char))
    Regular(regular) -> match execute_instruction(regular, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> ExtendedExecution(current, next_evidence, next_captures)

  fn execute_extended_routine(routine: List(ExtendedInstruction), current: Option(Char), evidence: List(Evidence), captures: List(CaptureFrame)) -> ExtendedExecution = match routine
    [] -> ExtendedExecution(current, evidence, captures)
    [instruction | rest] -> match execute_extended_instruction(instruction, current, evidence, captures)
      ExtendedExecution(next_current, next_evidence, next_captures) -> execute_extended_routine(rest, next_current, next_evidence, next_captures)

  fn extended_evidence(execution: ExtendedExecution) -> List(Evidence) = match execution
    ExtendedExecution(_, evidence, _) -> evidence

  fn extended_captures(execution: ExtendedExecution) -> List(CaptureFrame) = match execution
    ExtendedExecution(_, _, captures) -> captures

  fn extended_current(execution: ExtendedExecution) -> Option(Char) = match execution
    ExtendedExecution(current, _, _) -> current

  type ExtendedRoutineExecution indices (routine: List(ExtendedInstruction), input_current: Option(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_current: Option(Char), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    ExtendedRoutineExecuted : ExtendedRoutineExecution(routine, input_current, input_evidence, input_captures, extended_current(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_evidence(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_captures(execute_extended_routine(routine, input_current, input_evidence, input_captures)))

  fn certify_extended_routine(routine: List(ExtendedInstruction), input_current: Option(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) -> ExtendedRoutineExecution(routine, input_current, input_evidence, input_captures, extended_current(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_evidence(execute_extended_routine(routine, input_current, input_evidence, input_captures)), extended_captures(execute_extended_routine(routine, input_current, input_evidence, input_captures))) = ExtendedRoutineExecuted()

  ## Evidence execution deliberately forgets `ExtendedExecution.current`.
  ## `Observe` still advances every open capture frame, while the current
  ## character is observational bookkeeping and cannot affect evidence.
  fn execute_extended_evidence_instruction(instruction: ExtendedInstruction, evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match instruction
    Observe(char) -> EvidenceExecution(evidence, record_capture_char(captures, char))
    Regular(regular) -> execute_instruction(regular, evidence, captures)

  fn execute_extended_evidence_routine(routine: List(ExtendedInstruction), evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceExecution = match routine
    [] -> EvidenceExecution(evidence, captures)
    [instruction | rest] -> match execute_extended_evidence_instruction(instruction, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> execute_extended_evidence_routine(rest, next_evidence, next_captures)

  ## A named replay is deliberately separate from the evidence VM.  The
  ## ordinary certificate still proves the typed evidence; this effect-free
  ## interpreter replays the same certified routine and records only slot
  ## participation/text.  No host regex engine or second language semantics
  ## is involved.
  type NamedCaptureFrame = NamedCaptureFrame(Option(Nat), List(Char))
  type NamedCaptureLedgerEntry = NamedCaptureLedgerEntry(Nat, Option(String))
  type NamedCaptureExecution = NamedCaptureExecution(List(NamedCaptureFrame), List(NamedCaptureLedgerEntry))

  @reducible
  fn record_named_capture_char(frames: List(NamedCaptureFrame), char: Char) -> List(NamedCaptureFrame) = match frames
    [] -> []
    [NamedCaptureFrame(slot, chars) | rest] -> [NamedCaptureFrame(slot, [char | chars]) | record_named_capture_char(rest, char)]

  @reducible
  fn same_capture_slot(left: Nat, right: Nat) -> Bool = match left
    Z() -> match right
      Z() -> true
      S(_) -> false
    S(left_rest) -> match right
      Z() -> false
      S(right_rest) -> same_capture_slot(left_rest, right_rest)

  @reducible
  fn update_named_capture_ledger(slot: Nat, value: String, entries: List(NamedCaptureLedgerEntry)) -> List(NamedCaptureLedgerEntry) = match entries
    [] -> []
    [NamedCaptureLedgerEntry(entry_slot, current_value) | rest] -> pickup
      same_capture_slot(slot, entry_slot) -> [NamedCaptureLedgerEntry(entry_slot, Some(value)) | rest]
      else -> [NamedCaptureLedgerEntry(entry_slot, current_value) | update_named_capture_ledger(slot, value, rest)]

  @reducible
  fn named_capture_value(slot: Nat, entries: List(NamedCaptureLedgerEntry)) -> Option(String) = match entries
    [] -> None()
    [NamedCaptureLedgerEntry(entry_slot, value) | rest] -> pickup
      same_capture_slot(slot, entry_slot) -> value
      else -> named_capture_value(slot, rest)

  @reducible
  fn close_named_capture_frame(frames: List(NamedCaptureFrame), entries: List(NamedCaptureLedgerEntry)) -> NamedCaptureExecution = match frames
    [] -> NamedCaptureExecution([], entries)
    [NamedCaptureFrame(slot, chars) | rest] -> match slot
      None() -> NamedCaptureExecution(rest, entries)
      Some(slot_id) -> NamedCaptureExecution(rest, update_named_capture_ledger(slot_id, Std.String.from_characters(evidence_reverse_chars(chars)), entries))

  @reducible
  fn execute_named_instruction(instruction: EvidenceInstruction, frames: List(NamedCaptureFrame), entries: List(NamedCaptureLedgerEntry)) -> NamedCaptureExecution = match instruction
    BeginCapture() -> NamedCaptureExecution([NamedCaptureFrame(None(), []) | frames], entries)
    BeginCaptureSlot(slot) -> NamedCaptureExecution([NamedCaptureFrame(Some(slot), []) | frames], entries)
    EndCapture() -> close_named_capture_frame(frames, entries)
    EndCaptureSlot(_) -> close_named_capture_frame(frames, entries)
    _ -> NamedCaptureExecution(frames, entries)

  @reducible
  fn execute_named_extended_instruction(instruction: ExtendedInstruction, frames: List(NamedCaptureFrame), entries: List(NamedCaptureLedgerEntry)) -> NamedCaptureExecution = match instruction
    Observe(char) -> NamedCaptureExecution(record_named_capture_char(frames, char), entries)
    Regular(regular) -> execute_named_instruction(regular, frames, entries)

  @reducible
  fn execute_named_extended_routine(routine: List(ExtendedInstruction), frames: List(NamedCaptureFrame), entries: List(NamedCaptureLedgerEntry)) -> NamedCaptureExecution = match routine
    [] -> NamedCaptureExecution(frames, entries)
    [instruction | rest] -> match execute_named_extended_instruction(instruction, frames, entries)
      NamedCaptureExecution(next_frames, next_entries) -> execute_named_extended_routine(rest, next_frames, next_entries)

  @reducible
  fn capture_ledger_from_layout(layout: CaptureLayout) -> List(NamedCaptureLedgerEntry) = match layout
    CaptureLayout(slots) -> capture_ledger_from_slots(slots)

  @reducible
  fn capture_ledger_from_slots(slots: List(CaptureSlot)) -> List(NamedCaptureLedgerEntry) = match slots
    [] -> []
    [CaptureSlot(slot, _) | rest] -> [NamedCaptureLedgerEntry(slot, None()) | capture_ledger_from_slots(rest)]

  @reducible
  fn named_captures_from_layout(layout: CaptureLayout, entries: List(NamedCaptureLedgerEntry)) -> List(NamedCapture) = match layout
    CaptureLayout(slots) -> named_captures_from_slots(slots, entries)

  @reducible
  fn named_captures_from_slots(slots: List(CaptureSlot), entries: List(NamedCaptureLedgerEntry)) -> List(NamedCapture) = match slots
    [] -> []
    [CaptureSlot(slot, Some(name)) | rest] -> [NamedCapture(name, named_capture_value(slot, entries)) | named_captures_from_slots(rest, entries)]
    [CaptureSlot(_, None()) | rest] -> named_captures_from_slots(rest, entries)

  fn replay_named_capture_routine(routine: List(ExtendedInstruction), layout: CaptureLayout) -> Option(List(NamedCapture)) = match execute_named_extended_routine(routine, [], capture_ledger_from_layout(layout))
    NamedCaptureExecution([], entries) -> Some(named_captures_from_layout(layout, entries))
    NamedCaptureExecution(_, _) -> None()

  type CertifiedPathRoutine indices (routine: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence))
    PathRoutineDone : CertifiedPathRoutine(Nil(), evidence, captures, evidence)
    PathRoutineTransition : (char: Char) -> (regular: List(EvidenceInstruction)) -> (suffix_routine: List(ExtendedInstruction)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (regular_execution : ExtendedEvidenceRoutineExecution(regular_routine(regular), source_evidence, record_capture_char(source_captures, char), destination_evidence, destination_captures)) -> (suffix : CertifiedPathRoutine(suffix_routine, destination_evidence, destination_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(transition_routine(char, regular), suffix_routine), source_evidence, source_captures, final_evidence)
    PathRoutineInitial : (regular: List(EvidenceInstruction)) -> (suffix_routine: List(ExtendedInstruction)) -> (initial_evidence: List(Evidence)) -> (initial_captures: List(CaptureFrame)) -> (regular_execution : ExtendedEvidenceRoutineExecution(regular_routine(regular), Nil(), Nil(), initial_evidence, initial_captures)) -> (suffix : CertifiedPathRoutine(suffix_routine, initial_evidence, initial_captures, final_evidence)) -> CertifiedPathRoutine(append_extended_routines(regular_routine(regular), suffix_routine), Nil(), Nil(), final_evidence)

  fn initial_thread({n: Nat}, destination: MachineState(n)) -> EvidenceThread(n) = match destination
    Active(state, routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> EvidenceThread(ThreadActive(state), evidence, captures)
    Accepted(routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> EvidenceThread(ThreadAccepted(), evidence, captures)

  fn initial_threads({n: Nat}, starts: List(MachineState(n))) -> List(EvidenceThread(n)) = match starts
    [] -> []
    [head | rest] -> [initial_thread(head) | initial_threads(rest)]

  fn destination_thread({n: Nat}, destination: MachineState(n), evidence: List(Evidence), captures: List(CaptureFrame)) -> EvidenceThread(n) = match destination
    Active(state, routine, _) -> match execute_routine(routine, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> EvidenceThread(ThreadActive(state), next_evidence, next_captures)
    Accepted(routine, _) -> match execute_routine(routine, evidence, captures)
      EvidenceExecution(next_evidence, next_captures) -> EvidenceThread(ThreadAccepted(), next_evidence, next_captures)

  fn destination_threads({n: Nat}, destinations: List(MachineState(n)), evidence: List(Evidence), captures: List(CaptureFrame)) -> List(EvidenceThread(n)) = match destinations
    [] -> []
    [head | rest] -> [destination_thread(head, evidence, captures) | destination_threads(rest, evidence, captures)]

  fn step_evidence_thread({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, boundary: Boundary, thread: EvidenceThread(n)) -> List(EvidenceThread(n)) = match thread
    EvidenceThread(ThreadAccepted(), _, _) -> []
    EvidenceThread(ThreadActive(state), evidence, captures) ->
      destination_threads(filter_boundary_states(next(state, char), boundary), evidence, record_capture_char(captures, char))

  fn append_threads({n: Nat}, left: List(EvidenceThread(n)), right: List(EvidenceThread(n))) -> List(EvidenceThread(n)) = match left
    [] -> right
    [head | rest] -> [head | append_threads(rest, right)]

  fn step_evidence_threads({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, boundary: Boundary, threads: List(EvidenceThread(n))) -> List(EvidenceThread(n)) = match threads
    [] -> []
    [head | rest] -> append_threads(step_evidence_thread(next, char, boundary, head), step_evidence_threads(next, char, boundary, rest))

  fn transition_boundary(char: Char, rest: List(Char)) -> Boundary =
    position_boundary(false, Std.Char.is_newline(char), ascii_word(char), option_word(char, true), Some(char), rest)

  @reducible
  fn append_characters(left: List(Char), right: List(Char)) -> List(Char) = match left
    [] -> right
    [head | rest] -> [head | append_characters(rest, right)]

  fn transition_boundary_before(char: Char, rest: List(Char), after_input: List(Char)) -> Boundary =
    transition_boundary(char, append_characters(rest, after_input))

  @reducible
  fn advance_initial_position(position: InitialPosition, input: List(Char)) -> InitialPosition = match input
    Nil() -> position
    Cons(char, rest) -> advance_initial_position(position_after_character(char), rest)

  @reducible
  fn position_after_character(char: Char) -> InitialPosition =
    InitialPosition(False(), Std.Char.is_newline(char), ascii_word(char), option_word(char, True()), Some(char))

  @reducible
  fn position_after_character_with_policy(char: Char, policy: NewlinePolicy) -> InitialPosition =
    InitialPosition(False(), newline_char(policy, char), ascii_word(char), option_word(char, True()), Some(char))

  @reducible
  fn advance_initial_position_with_policy(position: InitialPosition, input: List(Char), policy: NewlinePolicy) -> InitialPosition = match input
    Nil() -> position
    Cons(char, rest) -> advance_initial_position_with_policy(position_after_character_with_policy(char, policy), rest, policy)

  fn initial_position_boundary(position: InitialPosition, input: List(Char)) -> Boundary = match position
    InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, previous_char) ->
      position_boundary(subject_start, line_start, previous_ascii_word, previous_unicode_word, previous_char, input)

  fn subject_initial_position() -> InitialPosition = InitialPosition(true, true, false, false, None())

  ## Lookaround child evaluation reuses the checked Thompson machine and has a
  ## context-aware, finite search loop. A satisfied lookahead retains both the
  ## erased finite path and the selected atomic routine, so assertion-local
  ## captures consume the same decision instead of traversing the child twice.
  fn lookaround_child_lookahead(depth: Nat, n: Nat, machine: PatternMachine(n), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaheadDecision(n, machine) = match depth
    Z() -> LookaheadResourceExhausted(depth, remaining, history, policy, LookaroundExhausted([], MachineStateMembersNil(), ()))
    S(rest_depth) -> match boundary
      Boundary(_, _, _, _, _, _, _, _, _, _) ->
        match lookaround_prefix_search_decision(
          rest_depth,
          n,
          machine,
          lookahead_initial_position(boundary),
          remaining,
          [],
          history,
          capture_context,
          policy
        )
          LookaheadSatisfied(path) -> LookaheadSatisfied(path)
          LookaheadRefuted(certificate) -> LookaheadRefuted(certificate)
          LookaheadResourceExhausted(child_depth, input, child_history, child_policy, exhaustion) -> LookaheadResourceExhausted(child_depth, input, child_history, child_policy, exhaustion)

  fn lookaround_child_lookbehind(depth: Nat, n: Nat, machine: PatternMachine(n), width: Nat, boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookbehindDecision(n, machine) = match depth
    Z() -> LookbehindResourceExhausted(depth, [], history, policy, LookaroundExhausted([], MachineStateMembersNil(), ()))
    S(rest_depth) -> match boundary
      Boundary(_, _, _, _, _, _, _, _, _, _) -> match lookbehind_window(history, width)
        None() -> LookbehindRefuted(LookbehindHistoryUnavailable(width, history, policy, LookaroundExhausted([], MachineStateMembersNil(), ())))
        Some(window) -> match lookaround_search_decision(
          rest_depth,
          n,
          machine,
          lookbehind_initial_position(boundary, history, width, policy),
          window,
          remaining,
          [],
          capture_context,
          policy
        )
          LookbehindSatisfied(path) -> LookbehindSatisfied(path)
          LookbehindRefuted(certificate) -> LookbehindRefuted(certificate)
          LookbehindResourceExhausted(child_depth, input, child_history, child_policy, exhaustion) -> LookbehindResourceExhausted(child_depth, input, child_history, child_policy, exhaustion)

  fn no_characters() -> List(Char) = []

  ## `Boundary` stores whether the current cursor crosses a word boundary;
  ## `InitialPosition` stores whether the previous scalar itself was a word
  ## character.  They are different facts.  Reconstruct the latter from the
  ## previous scalar at this one boundary-to-child conversion site.
  fn lookahead_initial_position(boundary: Boundary) -> InitialPosition = match boundary
    Boundary(subject_start, _, _, line_start, _, _, _, previous_char, _, _) -> InitialPosition(subject_start, line_start, option_ascii_word(previous_char), option_unicode_word(previous_char), previous_char)

  fn lookbehind_window(history: List(Char), width: Nat) -> Option(List(Char)) = match history_has_width(history, width)
    false -> None()
    true -> Some(evidence_reverse_chars(history_take_limit(history, width)))

  fn lookbehind_initial_position(boundary: Boundary, history: List(Char), width: Nat, policy: NewlinePolicy) -> InitialPosition = match width
    Z() -> match boundary
      Boundary(subject_start, _, _, line_start, _, _, _, previous_char, _, _) -> InitialPosition(subject_start, line_start, option_ascii_word(previous_char), option_unicode_word(previous_char), previous_char)
    S(_) -> match history_at(history, width)
      None() -> InitialPosition(true, true, false, false, None())
      Some(previous) -> InitialPosition(false, newline_char(policy, previous), ascii_word(previous), option_word(previous, true), Some(previous))

  fn history_at(history: List(Char), index: Nat) -> Option(Char) = match index
    Z() -> match history
      [] -> None()
      [head | _] -> Some(head)
    S(rest) -> match history
      [] -> None()
      [_ | tail] -> history_at(tail, rest)

  fn option_ascii_word(previous: Option(Char)) -> Bool = match previous
    None() -> false
    Some(char) -> ascii_word(char)

  fn option_unicode_word(previous: Option(Char)) -> Bool = match previous
    None() -> false
    Some(char) -> option_word(char, true)

  fn history_has_width(history: List(Char), width: Nat) -> Bool = match width
    Z() -> true
    S(rest) -> match history
      [] -> false
      [_ | tail] -> history_has_width(tail, rest)

  fn lookaround_exact_filtered_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  fn lookaround_machine_acceptance_path(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundSearchResult(depth, n, machine, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy), input, after_input, history, policy, capture_context) =
    lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy))

  fn lookaround_machine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = atomic_lookaround_accepts(depth, n, machine, position, input, after_input, history, capture_context, policy)

  fn lookaround_prefix_machine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = match machine
    MkPatternMachine(starts, _) -> match lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy))
      LookaroundPrefixSearchResultRejected(_) -> false
      LookaroundPrefixSearchResultFound(_) -> true

  ## Assertion operands are validated as depth-bounded before emission. Their
  ## child machine can therefore recurse only through the explicit finite fuel;
  ## using this separate filter keeps Boolean child evaluation outside the
  ## parent constraint evaluator's ordinary totality SCC.
  type LookaroundConstraintAdmission =
    | LookaroundConstraintAdmitted(List(ExtendedInstruction), List(EvidenceInstruction), List(LookaroundNestedDecision))

  type LookaroundAdmittedState(n: Nat) indices ()
    LookaroundAdmittedActive : Bounded(n) -> List(EvidenceInstruction) -> List(BoundaryConstraint) -> List(ExtendedInstruction) -> List(EvidenceInstruction) -> List(LookaroundNestedDecision) -> LookaroundAdmittedState(n)
    LookaroundAdmittedAccepted : List(EvidenceInstruction) -> List(BoundaryConstraint) -> List(ExtendedInstruction) -> List(EvidenceInstruction) -> List(LookaroundNestedDecision) -> LookaroundAdmittedState(n)

  @reducible
  fn empty_lookaround_admitted_states(n: Nat) -> List(LookaroundAdmittedState(n)) = []

  @reducible
  fn atomic_admitted_prepend({n: Nat}, prefix: List(LookaroundAdmittedState(n)), tail: List(LookaroundAdmittedState(n))) -> List(LookaroundAdmittedState(n)) = match prefix
    [] -> tail
    [head | rest] -> Cons(head, atomic_admitted_prepend(rest, tail))

  @reducible
  fn empty_extended_instructions() -> List(ExtendedInstruction) = []

  @reducible
  fn empty_lookaround_admitted_cursor_suffix(n: Nat) -> LookaroundAdmittedStateCursorSuffix(n, empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n)) =
    LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n)))

  @reducible
  fn empty_lookaround_admitted_cursor_witness(n: Nat) -> LookaroundAdmittedStateCursorWitness(n, empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n)) =
    LookaroundAdmittedStateCursorWitnessHere()

  type LookaroundAdmittedStateCursor(n: Nat) indices (whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedStateCursorHere : LookaroundAdmittedStateCursor(n, values, values)
    LookaroundAdmittedStateCursorDrop : (@erased head: LookaroundAdmittedState(n)) -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(head, values))) -> LookaroundAdmittedStateCursor(n, whole, values)

  ## A selected candidate list is either the current admitted suffix or a
  ## suffix reached by dropping ordered heads.  This is the lookaround-side
  ## counterpart of `MachineStateCursorSuffix`; it is the relation consumed by
  ## the atomic refutation induction when a path skips a rejected candidate.
  type LookaroundAdmittedStateCursorSuffix(n: Nat) indices (outer: List(LookaroundAdmittedState(n)), inner: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedStateCursorSuffixHere : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), outer, inner)) -> LookaroundAdmittedStateCursorSuffix(n, outer, inner)
    LookaroundAdmittedStateCursorSuffixDrop : (@erased head: LookaroundAdmittedState(n)) -> (suffix: LookaroundAdmittedStateCursorSuffix(n, outer, inner)) -> LookaroundAdmittedStateCursorSuffix(n, Cons(head, outer), inner)

  ## Ordered candidate suffixes compose when a refutation has already skipped
  ## one prefix and the selected trace skips another.  Keeping this operation
  ## explicit prevents the atomic child theorem from treating two unrelated
  ## suffix proofs as if they shared a spine.
  fn lookaround_admitted_cursor_suffix_compose(
    {n: Nat},
    {outer: List(LookaroundAdmittedState(n))},
    {middle: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    prefix: LookaroundAdmittedStateCursorSuffix(n, outer, middle),
    suffix: LookaroundAdmittedStateCursorSuffix(n, middle, inner)
  ) -> LookaroundAdmittedStateCursorSuffix(n, outer, inner) = match prefix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> suffix
    LookaroundAdmittedStateCursorSuffixDrop(head, prior) -> LookaroundAdmittedStateCursorSuffixDrop(head, lookaround_admitted_cursor_suffix_compose(prior, suffix))

  fn lookaround_admitted_cursor_suffix_reflexive(
    {n: Nat},
    {@erased outer: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    @erased _suffix: LookaroundAdmittedStateCursorSuffix(n, outer, current)
  ) -> LookaroundAdmittedStateCursorSuffix(n, current, current) =
    LookaroundAdmittedStateCursorSuffixHere(reflexive(current))

  ## Transport an erased equality through the ordered candidate-list spine.
  ## Successful member traversals use this at the construction site so the
  ## selected whole list cannot drift away from the suffix represented by the
  ## result index while skipped candidates are reintroduced.
  fn lookaround_admitted_state_cons_equivalent(
    {n: Nat},
    head: LookaroundAdmittedState(n),
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    equality: Equivalent(List(LookaroundAdmittedState(n)), left, right)
  ) -> Equivalent(List(LookaroundAdmittedState(n)), Cons(head, left), Cons(head, right)) = match equality
    reflexive() -> reflexive(Cons(head, left))

  ## This witness mirrors the cursor's own arbitrary-whole traversal.  It is
  ## distinct from `LookaroundAdmittedStateCursorSuffix`: the latter relates
  ## two list spines whose outer list starts at the dropped head, while this
  ## witness records a cursor that may already have skipped a prefix of its
  ## original whole list.
  type LookaroundAdmittedStateCursorWitness(n: Nat) indices (whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedStateCursorWitnessHere : LookaroundAdmittedStateCursorWitness(n, values, values)
    LookaroundAdmittedStateCursorWitnessDrop : (@erased head: LookaroundAdmittedState(n)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(head, values))) -> LookaroundAdmittedStateCursorWitness(n, whole, values)

  fn lookaround_admitted_cursor_to_suffix({n: Nat}, {whole: List(LookaroundAdmittedState(n))}, {current: List(LookaroundAdmittedState(n))}, cursor: LookaroundAdmittedStateCursor(n, whole, current)) -> LookaroundAdmittedStateCursorWitness(n, whole, current) = match cursor
    LookaroundAdmittedStateCursorHere() -> LookaroundAdmittedStateCursorWitnessHere()
    LookaroundAdmittedStateCursorDrop(head, cursor) -> LookaroundAdmittedStateCursorWitnessDrop(head, lookaround_admitted_cursor_to_suffix(cursor))

  fn lookaround_admitted_machine_state({n: Nat}, admitted: LookaroundAdmittedState(n)) -> MachineState(n) = match admitted
    LookaroundAdmittedActive(state, routine, constraints, _, assertion_markers, _) -> Active(state, append_routine(routine, assertion_markers), constraints)
    LookaroundAdmittedAccepted(routine, constraints, _, assertion_markers, _) -> Accepted(append_routine(routine, assertion_markers), constraints)

  fn lookaround_admitted_machine_states({n: Nat}, admitted: List(LookaroundAdmittedState(n))) -> List(MachineState(n)) = match admitted
    [] -> []
    [head | rest] -> [lookaround_admitted_machine_state(head) | lookaround_admitted_machine_states(rest)]

  fn lookaround_admit_boundary_states(depth: Nat, {n: Nat}, states: List(MachineState(n)), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundAdmittedState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, append_routine(capture_context, routine), policy)
      Some(LookaroundConstraintAdmitted(assertion_routine, assertion_markers, nested_decisions)) -> [LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) | lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)]
      None() -> lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)
    [Accepted(routine, constraints) | rest] -> match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, append_routine(capture_context, routine), policy)
      Some(LookaroundConstraintAdmitted(assertion_routine, assertion_markers, nested_decisions)) -> [LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions) | lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)]
      None() -> lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)

  fn lookaround_admitted_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundAdmittedState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_admit_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  fn lookaround_filter_boundary_states(depth: Nat, {n: Nat}, states: List(MachineState(n)), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) =
    lookaround_admitted_machine_states(lookaround_admit_boundary_states(depth, states, boundary, remaining, history, capture_context, policy))

  ## Extract only capture-slot markers from a selected assertion routine. The
  ## child emits its own characters and evidence, but those must not be merged
  ## into the surrounding typed result; only participation markers cross the
  ## assertion boundary for later conditionals.
  fn capture_slot_markers_from_extended(routine: List(ExtendedInstruction)) -> List(EvidenceInstruction) = match routine
    [] -> []
    [Regular(BeginCaptureSlot(slot)) | rest] -> [BeginCaptureSlot(slot) | capture_slot_markers_from_extended(rest)]
    [Regular(EndCaptureSlot(slot)) | rest] -> [EndCaptureSlot(slot) | capture_slot_markers_from_extended(rest)]
    [_ | rest] -> capture_slot_markers_from_extended(rest)

  fn lookaround_condition_admission(depth: Nat, condition: Option(LookaroundCondition), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(LookaroundConstraintAdmission) = match condition
    None() -> Some(LookaroundConstraintAdmitted([], [], []))
    Some(LookaheadCondition(positive, mk_pair(count, machine))) ->
      let decision = lookaround_child_lookahead(depth, count, machine, boundary, remaining, history, capture_context, policy)
      let nested = [LookaheadNestedDecision(positive, %[count, machine, decision])]
      match decision
        LookaheadSatisfied(witness) -> match positive
          True() ->
            let routine = lookahead_witness_routine(count, machine, witness)
            Some(LookaroundConstraintAdmitted(routine, capture_slot_markers_from_extended(routine), nested))
          False() -> None()
        LookaheadRefuted(_) -> match positive
          True() -> None()
          False() -> Some(LookaroundConstraintAdmitted([], [], nested))
        LookaheadResourceExhausted(_, _, _, _, _) -> None()
    Some(LookbehindCondition(positive, width, mk_pair(count, machine))) ->
      let decision = lookaround_child_lookbehind(depth, count, machine, width, boundary, remaining, history, capture_context, policy)
      let nested = [LookbehindNestedDecision(positive, %[count, machine, decision])]
      match decision
        LookbehindSatisfied(witness) -> match positive
          True() ->
            let routine = lookbehind_witness_routine(count, machine, witness)
            Some(LookaroundConstraintAdmitted(routine, capture_slot_markers_from_extended(routine), nested))
          False() -> None()
        LookbehindRefuted(_) -> match positive
          True() -> None()
          False() -> Some(LookaroundConstraintAdmitted([], [], nested))
        LookbehindResourceExhausted(_, _, _, _, _) -> None()

  fn lookaround_constraint_admission(depth: Nat, constraint: BoundaryConstraint, boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(LookaroundConstraintAdmission) = match boundary
    Boundary(subject_start, _subject_end, strict_subject_end, _line_start, _line_end, ascii_boundary, unicode_boundary, previous_char, next_char, after_next_char) -> match constraint
      BoundaryConstraint(require_subject_start, require_subject_end, require_strict_end, require_line_start, require_line_end, check_ascii, expected_ascii, check_unicode, expected_unicode, constraint_policy, capture_condition, lookaround_condition) -> pickup
        (not require_subject_start or subject_start) and
          (not require_subject_end or subject_end_for(constraint_policy, next_char, after_next_char)) and
          (not require_strict_end or strict_subject_end) and
          (not require_line_start or line_start_for(constraint_policy, previous_char, next_char)) and
          (not require_line_end or line_end_for(constraint_policy, next_char, after_next_char)) and
          (not check_ascii or ascii_boundary == expected_ascii) and
          (not check_unicode or unicode_boundary == expected_unicode) and
          capture_condition_holds(capture_condition, capture_context) -> lookaround_condition_admission(depth, lookaround_condition, boundary, remaining, history, capture_context, policy)
        else -> None()

  fn lookaround_constraints_admission(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(LookaroundConstraintAdmission) = match constraints
    [] -> Some(LookaroundConstraintAdmitted([], [], []))
    [constraint | rest] -> match lookaround_constraint_admission(depth, constraint, boundary, remaining, history, capture_context, policy)
      None() -> None()
      Some(LookaroundConstraintAdmitted(head_routine, head_markers, head_decisions)) -> match lookaround_constraints_admission(depth, rest, boundary, remaining, history, append_routine(capture_context, head_markers), policy)
        None() -> None()
        Some(LookaroundConstraintAdmitted(tail_routine, tail_markers, tail_decisions)) -> Some(LookaroundConstraintAdmitted(append_extended_routines(head_routine, tail_routine), append_routine(head_markers, tail_markers), append(head_decisions, tail_decisions)))

  ## A successful positive assertion can publish capture participation to the
  ## parent's ordinary finite machine. Lookahead markers come from the routine
  ## retained by the admitting witness; only slot markers cross the boundary.
  fn lookaround_constraints_capture_context(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(List(EvidenceInstruction)) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> None()
    Some(LookaroundConstraintAdmitted(_, markers, _)) -> Some(markers)

  fn lookahead_decision_holds(n: Nat, machine: PatternMachine(n), positive: Bool, decision: LookaheadDecision(n, machine)) -> Bool = match decision
    LookaheadSatisfied(_) -> positive
    LookaheadRefuted(_) -> not positive
    LookaheadResourceExhausted(_, _, _, _, _) -> false

  fn lookbehind_decision_holds(n: Nat, machine: PatternMachine(n), positive: Bool, decision: LookbehindDecision(n, machine)) -> Bool = match decision
    LookbehindSatisfied(_) -> positive
    LookbehindRefuted(_) -> not positive
    LookbehindResourceExhausted(_, _, _, _, _) -> false

  ## Capture-aware boundary evaluation returns the selected child routine for a
  ## positive assertion. A negative assertion succeeds with an empty routine:
  ## its private capture frame is intentionally discarded. Lookahead consumes
  ## the routine retained by the same proof-carrying decision.
  fn lookaround_constraints_routine(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(List(ExtendedInstruction)) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> None()
    Some(LookaroundConstraintAdmitted(routine, _, _)) -> Some(routine)

  fn position_boundary_for_history(position: InitialPosition, input: List(Char), history: List(Char)) -> Boundary = match position
    InitialPosition(subject_start, line_start, previous_ascii_word, previous_unicode_word, previous_char) ->
      position_boundary(subject_start, line_start, previous_ascii_word, previous_unicode_word, previous_char, input)

  ## Capture-free assertion paths carry state reachability plus an erased list
  ## of the nested decisions used by each accepted transition. The depth index
  ## is the same guard used by the evaluator: each nested assertion consumes
  ## one level and zero fuel cannot manufacture a child path.
  ## A failed path records the complete finite traversal below one thread.
  ## Destination failures retain the child rejection and the tail rejection;
  ## the only terminal constructor is reached with a structurally exhausted
  ## `MachineStateMembers` witness. The capture context is indexed because
  ## nested capture-condition checks must be refuted in the same environment
  ## that produced the destination list.
  type LookaroundPathFailure(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, destinations: List(MachineState(n)), remaining_destinations: List(MachineState(n)))
    LookaroundPathExhausted : (@erased remaining_destinations: List(MachineState(n))) -> (source: Bounded(n)) -> (@erased members: MachineStateMembers(n, destinations, Nil())) -> (@erased cursor: MachineStateCursor(n, destinations, Nil())) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, empty_machine_states(n))) -> (@erased remaining_equivalent: Equivalent(List(MachineState(n)), remaining_destinations, Nil())) -> LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, destinations, remaining_destinations)
    LookaroundPathStepExhausted : (@erased remaining_destinations: List(MachineState(n))) -> (char: Char) -> (rest: List(Char)) -> (source: Bounded(n)) -> (@erased members: MachineStateMembers(n, destinations, Nil())) -> (@erased cursor: MachineStateCursor(n, destinations, Nil())) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (@erased remaining_equivalent: Equivalent(List(MachineState(n)), remaining_destinations, Nil())) -> LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, destinations, remaining_destinations)
    LookaroundPathAcceptedWithInput : (@erased remaining_destinations: List(MachineState(n))) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (@erased remaining_equivalent: Equivalent(List(MachineState(n)), remaining_destinations, Nil())) -> LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, Nil(), remaining_destinations)
    LookaroundPathDestinationActiveRejectedEmpty : (@erased remaining_destinations: List(MachineState(n))) -> (char: Char) -> (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(destination, routine, constraints), destinations)) -> (@erased current_edge: ListMember(MachineState(n), Active(destination, routine, constraints), Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased members: MachineStateMembers(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased cursor: MachineStateCursor(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (child: LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, Nil(), Nil())) -> (tail: LookaroundPathFailure(depth, n, machine, Cons(char, Nil()), after_input, state, history, capture_context, policy, destinations, remaining_destinations)) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, state, char, Nil(), after_input, history, capture_context, policy))) -> LookaroundPathFailure(depth, n, machine, Cons(char, Nil()), after_input, state, history, capture_context, policy, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))
    LookaroundPathDestinationActiveRejected : (@erased remaining_destinations: List(MachineState(n))) -> (char: Char) -> (child_char: Char) -> (child_rest: List(Char)) -> (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(destination, routine, constraints), destinations)) -> (@erased current_edge: ListMember(MachineState(n), Active(destination, routine, constraints), Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased members: MachineStateMembers(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased cursor: MachineStateCursor(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (child: LookaroundPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy))) -> (tail: LookaroundPathFailure(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, state, history, capture_context, policy, destinations, remaining_destinations)) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, state, char, Cons(child_char, child_rest), after_input, history, capture_context, policy))) -> LookaroundPathFailure(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, state, history, capture_context, policy, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))
    LookaroundPathDestinationAcceptedRejected : (@erased remaining_destinations: List(MachineState(n))) -> (char: Char) -> (rest: List(Char)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> (@erased current_edge: ListMember(MachineState(n), Accepted(routine, constraints), Cons(Accepted(routine, constraints), remaining_destinations))) -> (@erased members: MachineStateMembers(n, destinations, Cons(Accepted(routine, constraints), remaining_destinations))) -> (@erased cursor: MachineStateCursor(n, destinations, Cons(Accepted(routine, constraints), remaining_destinations))) -> (child: LookaroundPathFailure(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, empty_machine_states(n), empty_machine_states(n))) -> (tail: LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, state, history, capture_context, policy, destinations, remaining_destinations)) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, state, char, rest, after_input, history, capture_context, policy))) -> LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, state, history, capture_context, policy, destinations, Cons(Accepted(routine, constraints), remaining_destinations))

  ## A complete failed start-list traversal. A start cannot be dropped from a
  ## refutation: the corresponding child path failure and the tail failure are
  ## both required before the terminal member proof can be returned.
  type LookaroundSearchFailure(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), current: List(MachineState(n)))
    LookaroundSearchExhausted : (@erased members: MachineStateMembers(n, starts, Nil())) -> (@erased cursor: MachineStateCursor(n, starts, Nil())) -> LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, Nil())
    LookaroundSearchActiveRejectedEmpty : {@erased remaining_starts: List(MachineState(n))} -> (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased member: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> (@erased members: MachineStateMembers(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (@erased cursor: MachineStateCursor(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (child: LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy, Nil(), Nil())) -> (tail: LookaroundSearchFailure(depth, n, machine, Nil(), after_input, history, capture_context, policy, starts, remaining_starts)) -> LookaroundSearchFailure(depth, n, machine, Nil(), after_input, history, capture_context, policy, starts, Cons(Active(state, routine, constraints), remaining_starts))
    LookaroundSearchActiveRejectedStep : {@erased remaining_starts: List(MachineState(n))} -> (char: Char) -> (rest: List(Char)) -> (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased member: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> (@erased members: MachineStateMembers(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (@erased cursor: MachineStateCursor(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (child: LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(state), char, rest, after_input, history, append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(state), char, rest, after_input, history, append_routine(capture_context, routine), policy))) -> (tail: LookaroundSearchFailure(depth, n, machine, Cons(char, rest), after_input, history, capture_context, policy, starts, remaining_starts)) -> LookaroundSearchFailure(depth, n, machine, Cons(char, rest), after_input, history, capture_context, policy, starts, Cons(Active(state, routine, constraints), remaining_starts))
    LookaroundSearchAcceptedRejected : {@erased remaining_starts: List(MachineState(n))} -> (char: Char) -> (rest: List(Char)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased member: ListMember(MachineState(n), Accepted(routine, constraints), starts)) -> (@erased members: MachineStateMembers(n, starts, Cons(Accepted(routine, constraints), remaining_starts))) -> (@erased cursor: MachineStateCursor(n, starts, Cons(Accepted(routine, constraints), remaining_starts))) -> (child: LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy, Nil(), Nil())) -> (tail: LookaroundSearchFailure(depth, n, machine, Cons(char, rest), after_input, history, capture_context, policy, starts, remaining_starts)) -> LookaroundSearchFailure(depth, n, machine, Cons(char, rest), after_input, history, capture_context, policy, starts, Cons(Accepted(routine, constraints), remaining_starts))

  ## Prefix acceptance terminates as soon as a thread reaches `Accepted`, even
  ## when input remains. Its rejection family therefore cannot reuse the exact
  ## path's `AcceptedWithInput` or accepted-destination rejection constructors.
  ## Only active threads can contribute a prefix failure.
  type LookaroundPrefixPathFailure(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, destinations: List(MachineState(n)), remaining_destinations: List(MachineState(n)))
    LookaroundPrefixPathExhausted : (source: Bounded(n)) -> (@erased members: MachineStateMembers(n, destinations, Nil())) -> (@erased cursor: MachineStateCursor(n, destinations, Nil())) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, Nil())) -> LookaroundPrefixPathFailure(depth, n, machine, Nil(), after_input, source, history, capture_context, policy, destinations, Nil())
    LookaroundPrefixPathStepExhausted : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased members: MachineStateMembers(n, destinations, Nil())) -> (@erased cursor: MachineStateCursor(n, destinations, Nil())) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> LookaroundPrefixPathFailure(depth, n, machine, Cons(char, rest), after_input, source, history, capture_context, policy, destinations, Nil())
    LookaroundPrefixDestinationActiveRejectedEmpty : (@erased remaining_destinations: List(MachineState(n))) -> (source: Bounded(n)) -> (char: Char) -> (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased members: MachineStateMembers(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased cursor: MachineStateCursor(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (child: LookaroundPrefixPathFailure(depth, n, machine, Nil(), after_input, destination, history_push_bounded(history, char), append_routine(capture_context, routine), policy, Nil(), Nil())) -> (tail: LookaroundPrefixPathFailure(depth, n, machine, Cons(char, Nil()), after_input, source, history, capture_context, policy, destinations, remaining_destinations)) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, Nil(), after_input, history, capture_context, policy))) -> LookaroundPrefixPathFailure(depth, n, machine, Cons(char, Nil()), after_input, source, history, capture_context, policy, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))
    LookaroundPrefixDestinationActiveRejected : (@erased remaining_destinations: List(MachineState(n))) -> (source: Bounded(n)) -> (char: Char) -> (child_char: Char) -> (child_rest: List(Char)) -> (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased members: MachineStateMembers(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased cursor: MachineStateCursor(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (child: LookaroundPrefixPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, destination, history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy))) -> (tail: LookaroundPrefixPathFailure(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, source, history, capture_context, policy, destinations, remaining_destinations)) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, Cons(child_char, child_rest), after_input, history, capture_context, policy))) -> LookaroundPrefixPathFailure(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, source, history, capture_context, policy, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))

  type LookaroundPrefixSearchFailure(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), current: List(MachineState(n)))
    LookaroundPrefixSearchExhausted : (@erased members: MachineStateMembers(n, starts, Nil())) -> (@erased cursor: MachineStateCursor(n, starts, Nil())) -> LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, Nil())
    LookaroundPrefixSearchActiveRejectedEmpty : (@erased remaining_starts: List(MachineState(n))) -> (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased members: MachineStateMembers(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (@erased cursor: MachineStateCursor(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (child: LookaroundPrefixPathFailure(depth, n, machine, Nil(), after_input, state, history, append_routine(capture_context, routine), policy, Nil(), Nil())) -> (tail: LookaroundPrefixSearchFailure(depth, n, machine, Nil(), after_input, history, capture_context, policy, starts, remaining_starts)) -> LookaroundPrefixSearchFailure(depth, n, machine, Nil(), after_input, history, capture_context, policy, starts, Cons(Active(state, routine, constraints), remaining_starts))
    LookaroundPrefixSearchActiveRejectedStep : (@erased remaining_starts: List(MachineState(n))) -> (char: Char) -> (rest: List(Char)) -> (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased members: MachineStateMembers(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (@erased cursor: MachineStateCursor(n, starts, Cons(Active(state, routine, constraints), remaining_starts))) -> (child: LookaroundPrefixPathFailure(depth, n, machine, Cons(char, rest), after_input, state, history, append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(state), char, rest, after_input, history, append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(state), char, rest, after_input, history, append_routine(capture_context, routine), policy))) -> (tail: LookaroundPrefixSearchFailure(depth, n, machine, Cons(char, rest), after_input, history, capture_context, policy, starts, remaining_starts)) -> LookaroundPrefixSearchFailure(depth, n, machine, Cons(char, rest), after_input, history, capture_context, policy, starts, Cons(Active(state, routine, constraints), remaining_starts))

  ## Resource and history guards fail before a machine traversal exists. They
  ## retain the compact terminal witness used by the public decision types;
  ## ordinary search failures use the complete trees above.
  type LookaroundExhaustion(n: Nat) indices ()
    LookaroundExhausted : (@erased whole: List(MachineState(n))) -> (@erased members: MachineStateMembers(n, whole, Nil())) -> (token: Unit) -> LookaroundExhaustion(n)

  ## A cursor is a suffix witness for a canonical destination list. Unlike the
  ## membership spine, it records that the current list is reached by dropping
  ## whole heads from the original list; it cannot represent an arbitrary
  ## subsequence or a fabricated cursor.
  type MachineStateCursor(n: Nat) indices (whole: List(MachineState(n)), current: List(MachineState(n)))
    MachineStateCursorHere : MachineStateCursor(n, values, values)
    MachineStateCursorDrop : (@erased head: MachineState(n)) -> (@erased cursor: MachineStateCursor(n, whole, Cons(head, values))) -> MachineStateCursor(n, whole, values)

  ## A path candidate list is either the current failure list or a suffix of
  ## it.  This relation is built by the member traversal itself: skipping a
  ## head selects the corresponding tail failure, while equality selects the
  ## child failure.  It deliberately has no constructor for adding elements to
  ## the candidate side, so an accepting path cannot be related to a prefix.
  type MachineStateCursorSuffix(n: Nat) indices (outer: List(MachineState(n)), inner: List(MachineState(n)))
    MachineStateCursorSuffixHere : (@erased equality: Equivalent(List(MachineState(n)), outer, inner)) -> MachineStateCursorSuffix(n, outer, inner)
    MachineStateCursorSuffixDrop : (head: MachineState(n)) -> (suffix: MachineStateCursorSuffix(n, outer, inner)) -> MachineStateCursorSuffix(n, Cons(head, outer), inner)

  type LookaroundAcceptingPath(depth: Nat, n: Nat, machine: PatternMachine(n), capture_context: List(EvidenceInstruction), candidates: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy)
    LookaroundAcceptedNow : LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Nil(), after_input, ThreadAccepted(), history, policy)
    LookaroundAcceptedNextActive : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased values: List(MachineState(n))} -> (@erased members: MachineStateMembers(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Active(destination, routine, constraints), values))) -> (@erased cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Active(destination, routine, constraints), values))) -> (@erased candidate_equivalent: Equivalent(List(MachineState(n)), candidates, Cons(Active(destination, routine, constraints), values))) -> (edge: ListMember(MachineState(n), Active(destination, routine, constraints), Cons(Active(destination, routine, constraints), values))) -> (child_char: Char) -> (child_rest: List(Char)) -> (@erased child_input_equivalent: Equivalent(List(Char), rest, Cons(child_char, child_rest))) -> (@erased child_destinations: List(MachineState(n))) -> (@erased child_destinations_equivalent: Equivalent(List(MachineState(n)), child_destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy))) -> {@erased child_candidates: List(MachineState(n))} -> (child_cursor_suffix: MachineStateCursorSuffix(n, child_destinations, child_candidates)) -> (suffix: LookaroundAcceptingPath(depth, n, machine, append_routine(capture_context, routine), child_candidates, Cons(child_char, child_rest), after_input, ThreadActive(destination), history_push_bounded(history, char), policy)) -> LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, ThreadActive(source), history, policy)
    LookaroundAcceptedNextAccepted : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased values: List(MachineState(n))} -> (@erased members: MachineStateMembers(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Accepted(routine, constraints), values))) -> (@erased cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), Cons(Accepted(routine, constraints), values))) -> (@erased candidate_equivalent: Equivalent(List(MachineState(n)), candidates, Cons(Accepted(routine, constraints), values))) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), Cons(Accepted(routine, constraints), values))) -> (child_cursor_suffix: MachineStateCursorSuffix(n, empty_machine_states(n), empty_machine_states(n))) -> (suffix: LookaroundAcceptingPath(depth, n, machine, append_routine(capture_context, routine), empty_machine_states(n), rest, after_input, ThreadAccepted(), history_push_bounded(history, char), policy)) -> LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, ThreadActive(source), history, policy)

  ## An active thread cannot have an accepting path over an empty input.
  ## Keeping this contradiction at the typed path boundary prevents a later
  ## refutation proof from accidentally treating an unconsumed active state as
  ## terminally accepted.
  fn impossible_lookaround_empty_active_path({@erased depth: Nat}, n: Nat, machine: PatternMachine(n), {@erased after_input: List(Char)}, source: Bounded(n), {@erased history: List(Char)}, {@erased capture_context: List(EvidenceInstruction)}, {@erased policy: NewlinePolicy}, {@erased candidates: List(MachineState(n))}, {result: Type}, path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Nil(), after_input, ThreadActive(source), history, policy)) -> result = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  fn lookaround_machine_destinations(depth: Nat, n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(_, next) -> lookaround_filter_boundary_states(depth, next_for_thread(n, next, state, char), lookaround_transition_boundary(char, rest, after_input, policy), append_characters(rest, after_input), history_push_bounded(history, char), capture_context, policy)

  fn lookaround_machine_admitted_destinations(depth: Nat, n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundAdmittedState(n)) = match machine
    MkPatternMachine(_, next) -> lookaround_admit_boundary_states(depth, next_for_thread(n, next, state, char), lookaround_transition_boundary(char, rest, after_input, policy), append_characters(rest, after_input), history_push_bounded(history, char), capture_context, policy)

  ## Every accepting-path rejection is rooted at the one destination list that
  ## the path would have traversed for its current thread and input.  Keeping
  ## that list as a definitionally computed index (rather than an existential
  ## list carried by the result constructor) lets recursive destination
  ## failures retain the same canonical child identity all the way down.
  @reducible
  fn lookaround_machine_raw_destinations(n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char) -> List(MachineState(n)) = match machine
    MkPatternMachine(_, next) -> next_for_thread(n, next, state, char)

  @reducible
  fn empty_machine_states(n: Nat) -> List(MachineState(n)) = []

  @reducible
  fn empty_characters() -> List(Char) = []

  fn lookaround_path_exhausted(depth: Nat, n: Nat, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, destinations: List(MachineState(n)), members: MachineStateMembers(n, destinations, Nil()), @erased cursor: MachineStateCursor(n, destinations, Nil()), destinations_equivalent: Equivalent(List(MachineState(n)), destinations, empty_machine_states(n))) -> LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, destinations, Nil()) = LookaroundPathExhausted(empty_machine_states(n), source, members, cursor, destinations_equivalent, reflexive(empty_machine_states(n)))

  fn lookaround_path_step_exhausted(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, destinations: List(MachineState(n)), members: MachineStateMembers(n, destinations, Nil()), @erased cursor: MachineStateCursor(n, destinations, Nil()), destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, destinations, Nil()) = LookaroundPathStepExhausted(empty_machine_states(n), char, rest, source, members, cursor, destinations_equivalent, reflexive(empty_machine_states(n)))

