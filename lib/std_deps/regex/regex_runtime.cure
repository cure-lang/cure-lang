  ## The first refutation-tree eliminator is indexed at the same exhausted
  ## input as the selected trace.  The other failure constructors all carry a
  ## non-empty input or an accepted thread, so dependent matching reduces this
  ## wrapper to the empty-input lemma above without a runtime case split.
  fn atomic_path_failure_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, {whole: List(LookaroundAdmittedState(n))}, current: List(LookaroundAdmittedState(n)), @erased failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureInputExhausted()), @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), matched, remaining_input, routine)) -> result = match failure
    AtomicPathInputExhausted(_, _) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path)

  ## Consume the first non-empty destination-exhaustion branch of the atomic
  ## refutation tree.  The failure cursor is indexed at `Nil()`, so the only
  ## admissible selected-path suffix is `Here`; a `Drop` witness would require
  ## a head in an empty list.  After that equality is consumed, the path-level
  ## contradiction is discharged by the active destination-exhaustion lemma.
  fn atomic_path_failure_excludes_aligned_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil(), AtomicPathFailureDestinationsExhausted()), {candidate_current: List(LookaroundAdmittedState(n))}, matched: List(Char), remaining_input: List(Char), routine: List(ExtendedInstruction), @erased candidate_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), candidate_current), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> match candidate_suffix
      LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
        reflexive() -> atomic_path_active_destinations_exhausted_excludes_trace(machine, char, rest, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, matched, remaining_input, routine, failure, path)
      LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## First-order induction over a rejected destination's sibling tail.  The
  ## selected trace is either aligned with the rejected head (the supplied
  ## construction-site contradiction) or starts in the tail.  In the latter
  ## case the refutation's own tail is structurally smaller, so the canonical
  ## fold consumes it without packing an existential callback or opening an
  ## erased failure kind.  This construction-site boundary supplies the
  ## aligned and tail contradictions to that fold; destination exhaustion is
  ## its recursive base, while input exhaustion and exact acceptance are
  ## excluded by the active/non-empty indices before any runtime branch can be
  ## generated.
  @reducible
  fn atomic_path_destination_rejection_excludes_recursive_tail_induction(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    @erased matched: List(Char),
    @erased remaining_input: List(Char),
    @erased routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      candidate_current
    ),
    @erased tail_alignment: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      candidate_current
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    ),
    head_case: Empty,
    tail_case: Empty
  ) -> Empty = atomic_path_destination_rejection_excludes_recursive_tail_rejected(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    failure,
    matched,
    remaining_input,
    routine,
    selection_from_current,
    tail_alignment,
    path,
    head_case,
    tail_case
  )

  ## A rejected sibling tail is the recursive induction branch. Its failure
  ## kind is fixed at the construction site, so the proof never inspects an
  ## erased failure tag at runtime. The caller supplies both already-built
  ## branch results; no erased proof becomes a runtime callback argument.
  fn atomic_path_destination_rejection_excludes_recursive_tail_rejected(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    @erased matched: List(Char),
    @erased remaining_input: List(Char),
    @erased routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      candidate_current
    ),
    @erased tail_alignment: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      candidate_current
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    ),
    head_case: result,
    tail_case: result
  ) -> result = match failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      match atomic_path_destination_rejection_excludes_recursive_tail(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        candidate,
        failure,
        matched,
        remaining_input,
        routine,
        selection_from_current,
        path,
        head_case
      )
        AtomicPathSelectedTailHead(value) -> value
        AtomicPathSelectedTailTail(_) -> tail_case

  ## Generic selected-trace dispatcher for a rejected destination. The parent
  ## refutation is indexed at `Cons(candidate, remaining)` while the selected
  ## trace may begin at either that candidate or a later sibling. The cursor
  ## relation selects a proof-only head or tail branch; the tail branch keeps
  ## the recursive failure, suffix, and selected path together for the next
  ## induction step. No runtime state tag or erased failure payload is
  ## inspected.
  @reducible
  fn atomic_path_destination_rejection_excludes_recursive_tail(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    @erased matched: List(Char),
    @erased remaining_input: List(Char),
    @erased routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      candidate_current
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    ),
    head_case: result
  ) -> AtomicPathSelectedTailDispatch(
    result,
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(state),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining,
    candidate_current,
    matched,
    remaining_input,
    routine
  ) = atomic_path_destination_rejection_selected_suffix_dispatch(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    failure,
    matched,
    remaining_input,
    routine,
    selection_from_current,
    path,
    head_case
  )


  ## Consume the selected-tail dispatch at the destination-exhaustion base
  ## case.  Here the recursive tail is indexed at `Nil()`, so the only
  ## admissible refutation constructor is `AtomicPathDestinationsExhausted`;
  ## the package's cursor suffix can therefore be handed directly to the
  ## aligned-trace contradiction.  Rejected-child tails remain a separate
  ## induction branch below.
  @reducible
  fn atomic_path_selected_tail_dispatch_destinations_exhausted(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    dispatch: AtomicPathSelectedTailDispatch(
      result,
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil(),
      selected_current,
      matched,
      remaining_input,
      routine
    )
  ) -> result = match dispatch
    AtomicPathSelectedTailHead(value) -> value
    AtomicPathSelectedTailTail(package) -> match package
      AtomicPathSelectedTailPackagePacked(tail_package, tail_suffix, path) -> match tail_package
        AtomicPathTailPackagePacked(failure) -> match failure
          AtomicPathDestinationsExhausted(_, _, _, _, _, _) ->
            atomic_path_failure_excludes_aligned_trace(
              machine,
              char,
              rest,
              after_input,
              source,
              history,
              capture_context,
              policy,
              scope_depth,
              prefix_mode,
              reversed_prefix,
              whole,
              failure,
              matched,
              remaining_input,
              routine,
              tail_suffix,
              path
            )

  ## Split a rejected destination's selected suffix at the construction site.
  ## A `Here` suffix is the rejected candidate itself and must be discharged by
  ## the child theorem supplied by the caller.  A `Drop` suffix is a later
  ## sibling; its tail cursor is packaged with the recursive refutation and
  ## selected path so the parent cannot accidentally treat a sibling trace as
  ## a head trace.
  @reducible
  fn atomic_path_destination_rejection_selected_suffix_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    @erased matched: List(Char),
    @erased remaining_input: List(Char),
    @erased routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      candidate_current
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    ),
    head_case: result
  ) -> AtomicPathSelectedTailDispatch(
    result,
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(state),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining,
    candidate_current,
    matched,
    remaining_input,
    routine
  ) = match atomic_path_selected_child_suffix_location(selection_from_current)
    AtomicPathSelectedChildHere(_, _) -> AtomicPathSelectedTailHead(head_case)
    AtomicPathSelectedChildThere(_, _) -> match selection_from_current
      LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) ->
        AtomicPathSelectedTailTail(AtomicPathSelectedTailPackagePacked(
          atomic_path_destination_rejected_tail_package(
            machine,
            char,
            rest,
            after_input,
            state,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            failure
          ),
          tail_suffix,
          path
        ))
      LookaroundAdmittedStateCursorSuffixHere(_) -> AtomicPathSelectedTailHead(head_case)

  ## A rejected candidate may leave a sibling tail whose search reaches the
  ## destination-exhaustion leaf. When the selected trace is already aligned
  ## to that tail's empty cursor, build the exhaustion contradiction once and
  ## pass it through the generic parent dispatcher. The transported `Drop`
  ## suffix selects the tail result; the duplicate head value is harmless and
  ## keeps this proof boundary total for every indexed cursor shape. This is
  ## the first tail-induction slice; rejected-child alignment remains separate.
  fn atomic_path_tail_destinations_exhausted_excludes_aligned_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), candidate: LookaroundAdmittedState(n), @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, Nil()), AtomicPathFailureDestinationRejected()), {candidate_current: List(LookaroundAdmittedState(n))}, matched: List(Char), remaining_input: List(Char), routine: List(ExtendedInstruction), tail_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), candidate_current), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result =
    let tail_result: result = atomic_path_tail_package_destinations_exhausted_excludes_trace(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      atomic_path_destination_rejected_tail_package(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        failure
      ),
      matched,
      remaining_input,
      routine,
      tail_suffix,
      path
    )
    atomic_path_selected_tail_dispatch_destinations_exhausted(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      matched,
      remaining_input,
      routine,
      atomic_path_destination_rejection_excludes_recursive_tail(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        candidate,
        failure,
        matched,
        remaining_input,
        routine,
        LookaroundAdmittedStateCursorSuffixDrop(candidate, tail_suffix),
        path,
        tail_result
      )
    )

  ## A two-sibling rejected tail reaches the same singleton recursion after
  ## the outer candidate is skipped.  The nested rejected candidate is fixed
  ## at the head of the parent's sibling tail and its own tail is fixed at
  ## `Nil()`, so the nested destination-exhaustion branch can reuse the
  ## canonical active-child exhaustion consumer.  The parent tail package is
  ## refined twice at this construction site; the resulting `Drop` suffixes
  ## are erased cursor evidence and add no runtime state.
  fn atomic_path_destination_rejection_excludes_nested_tail_rejection(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    nested_candidate: LookaroundAdmittedState(n),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Cons(nested_candidate, Nil())),
      AtomicPathFailureDestinationRejected()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty =
    let nested_package: AtomicPathRejectedTailAt(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(nested_candidate, Nil())
    ) = atomic_path_destination_rejected_tail_package(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      failure
    )
    let nested_result: Empty = atomic_path_rejected_tail_refinement(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      nested_candidate,
      nested_package,
      matched,
      remaining_input,
      routine,
      path
    )
    atomic_path_rejected_tail_dispatch_excludes_trace(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      nested_candidate,
      matched,
      remaining_input,
      routine,
      atomic_path_destination_rejection_excludes_recursive_tail(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        candidate,
        failure,
        matched,
        remaining_input,
        routine,
        LookaroundAdmittedStateCursorSuffixDrop(
          candidate,
          LookaroundAdmittedStateCursorSuffixDrop(
            nested_candidate,
            LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n)))
          )
        ),
        path,
        nested_result
      )
    )

  ## A three-sibling rejected tail peels the typed package twice before
  ## reaching the singleton refinement.  Each peel happens at a
  ## constructor-specific destination-rejection boundary, so the existential
  ## failure kinds stay proof-only and no runtime tag is consulted.  This is
  ## the first genuinely non-singleton sibling fold beyond the concrete
  ## two-state boundary above; longer folds reuse the same package shape.
  fn atomic_path_destination_rejection_excludes_three_tail_rejection(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    nested_candidate: LookaroundAdmittedState(n),
    tail_candidate: LookaroundAdmittedState(n),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Cons(nested_candidate, Cons(tail_candidate, Nil()))),
      AtomicPathFailureDestinationRejected()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = atomic_path_rejected_tail_fold_excludes_trace(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    Cons(nested_candidate, Cons(tail_candidate, Nil())),
    failure,
    matched,
    remaining_input,
    routine,
    LookaroundAdmittedStateCursorSuffixDrop(
      candidate,
      LookaroundAdmittedStateCursorSuffixDrop(
        nested_candidate,
        LookaroundAdmittedStateCursorSuffixDrop(
          tail_candidate,
          LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n)))
        )
      )
    ),
    path
  )

  ## A four-sibling rejected tail uses the same recursive fold without adding
  ## another fixed-arity package peel.  This concrete instantiation keeps the
  ## proof-facing candidate spine explicit so the compiler checks that the
  ## generalized helper really transports one more `Drop` step.
  fn atomic_path_destination_rejection_excludes_four_tail_rejection(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    nested_candidate: LookaroundAdmittedState(n),
    third_candidate: LookaroundAdmittedState(n),
    tail_candidate: LookaroundAdmittedState(n),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Cons(nested_candidate, Cons(third_candidate, Cons(tail_candidate, Nil())))),
      AtomicPathFailureDestinationRejected()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = atomic_path_rejected_tail_fold_excludes_trace(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    Cons(nested_candidate, Cons(third_candidate, Cons(tail_candidate, Nil()))),
    failure,
    matched,
    remaining_input,
    routine,
    LookaroundAdmittedStateCursorSuffixDrop(
      candidate,
      LookaroundAdmittedStateCursorSuffixDrop(
        nested_candidate,
        LookaroundAdmittedStateCursorSuffixDrop(
          third_candidate,
          LookaroundAdmittedStateCursorSuffixDrop(
            tail_candidate,
            LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n)))
          )
        )
      )
    ),
    path
  )

  ## A rejected first candidate can be discharged when the selected trace is
  ## aligned to the sibling tail.  The parent rejection publishes the exact
  ## whole-to-tail suffix, while the selected trace supplies a source-relative
  ## suffix.  Eliminating that source suffix first proves that this theorem is
  ## only entered for a later sibling; the head-selected branch is reserved
  ## for the child induction below.
  fn atomic_path_destination_rejection_excludes_recursive_trace({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), candidate: LookaroundAdmittedState(n), @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, Nil()), AtomicPathFailureDestinationRejected()), {candidate_current: List(LookaroundAdmittedState(n))}, matched: List(Char), remaining_input: List(Char), routine: List(ExtendedInstruction), selection_from_current: LookaroundAdmittedStateCursorSuffix(n, Cons(candidate, Nil()), candidate_current), @erased tail_alignment: LookaroundAdmittedStateCursorSuffix(n, Nil(), candidate_current), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> Empty = match failure
    AtomicPathInputExhausted(_, _) -> impossible
    AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
    AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) -> match tail_failure
      AtomicPathDestinationsExhausted(_, _, _, _, _, _) ->
        let tail_result: Empty = atomic_path_active_child_rejection_excludes_tail_exhaustion(
          machine,
          char,
          rest,
          after_input,
          state,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          candidate,
          failure,
          tail_failure,
          tail_alignment,
          matched,
          remaining_input,
          routine,
          path
        )
        atomic_path_active_child_rejection_excludes_tail_package(
          machine,
          char,
          rest,
          after_input,
          state,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          candidate,
          failure,
          matched,
          remaining_input,
          routine,
          atomic_path_destination_rejection_excludes_recursive_tail(
            machine,
            char,
            rest,
            after_input,
            state,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            whole,
            candidate,
            failure,
            matched,
            remaining_input,
            routine,
            selection_from_current,
            path,
            tail_result
          )
        )

  ## The active root wrapper has no suffix-local alternative: its empty-input
  ## index eliminates every refutation constructor except
  ## `AtomicPathInputExhausted`. This is the first theorem consumer that uses
  ## the root/partial split directly.
  fn atomic_path_root_active_failure_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {candidate_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted()), @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathRootRefutation(_, _, _, _) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path)



  ## Exact child failures receive the same suffix-indexed treatment as active
  ## input exhaustion. The stored constructor suffix is checked before the
  ## generic exact-input contradiction is reused.
  fn atomic_path_child_exact_failure_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), @erased char: Char, @erased rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, {current: List(LookaroundAdmittedState(n))}, @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, whole, current, AtomicPathFailureExactAccepted()), @erased failure_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current), {path_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, path_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathExactAcceptedWithInput(_, _, _, stored_suffix) -> match failure_suffix
      LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_suffix
        LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_exact_failure_excludes_trace(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix, failure, path)
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible
      LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible



  ## Consume a destination-exhaustion child after aligning its failed cursor
  ## with the selected child cursor.  The two cursors may originate from
  ## distinct existential lists, so the common-origin equation is transported
  ## before the alignment is inspected.  A left-to-right alignment supplies
  ## the suffix required by the generic failure theorem; a right-to-left
  ## alignment can only be reflexive at the empty cursor and then reduces to
  ## the active destination-exhaustion leaf.
  @reducible
  fn atomic_path_active_child_destinations_exhausted_excludes_aligned_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Nil(),
      AtomicPathFailureDestinationsExhausted()
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, Nil()),
    selected_whole: List(LookaroundAdmittedState(n)),
    selected_current: List(LookaroundAdmittedState(n)),
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      selected_current,
      matched,
      remaining_input,
      routine
    ),
    reverse_case: () -> Empty
  ) -> Empty = match atomic_child_cursor_alignment(
    failure_suffix,
    selected_whole_equivalence,
    selected_suffix
  )
    LookaroundAdmittedCursorLeftToRight(candidate_suffix) ->
      atomic_path_failure_excludes_aligned_trace(
        machine,
        char,
        rest,
        after_input,
        source,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        failure_whole,
        failure,
        matched,
        remaining_input,
        routine,
        candidate_suffix,
        path
      )
    LookaroundAdmittedCursorRightToLeft(_) -> reverse_case()

  ## The active-child destination-exhaustion leaf is the next base case for
  ## recursive rejected-child induction.  Its selected child trace is already
  ## aligned at the empty admitted-state cursor, so the generic active leaf
  ## contradiction can consume it directly.  Parent destination-rejection
  ## transport supplies this child proof; no runtime witness is introduced.
  fn atomic_path_active_child_destinations_exhausted_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), routine: List(ExtendedInstruction), @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil(), AtomicPathFailureDestinationsExhausted()), @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), matched, remaining_input, routine)) -> result = atomic_path_active_destinations_exhausted_excludes_trace(machine, char, rest, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, matched, remaining_input, routine, failure, path)



  ## Prefix selection is an outer endpoint policy.  The atomic machine still
  ## chooses the first path for each exact candidate, but shortest/longest
  ## selection must range over all candidate endpoints just like the ordinary
  ## lookaround prefix API.  Calling the exact atomic authority for each
  ## candidate keeps commitment semantics identical at every endpoint and
  ## returns the routine belonging to the selected candidate.
  fn atomic_lookaround_routine_prefix(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool, history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) = match machine
    MkPatternMachine(_, _) -> pickup
      greedy -> atomic_lookaround_routine_last_prefix(depth, n, machine, position, [], input, None(), history, capture_context, policy)
      else -> atomic_lookaround_routine_first_prefix(depth, n, machine, position, [], input, history, capture_context, policy)

  fn atomic_lookaround_routine_first_prefix(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    match atomic_lookaround_routine_exact(depth, n, machine, position, matched_input, remaining_input, history, capture_context, policy)
      Some(result) -> Some(result)
      None() -> match remaining_input
        [] -> None()
        [char | rest] -> atomic_lookaround_routine_first_prefix(depth, n, machine, position, [char | reversed_prefix], rest, history, capture_context, policy)

  fn atomic_lookaround_routine_last_prefix(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    let current = match atomic_lookaround_routine_exact(depth, n, machine, position, matched_input, remaining_input, history, capture_context, policy)
      Some(result) -> Some(result)
      None() -> previous
    match remaining_input
      [] -> current
      [char | rest] -> atomic_lookaround_routine_last_prefix(depth, n, machine, position, [char | reversed_prefix], rest, current, history, capture_context, policy)


  fn atomic_lookaround_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = match machine
    MkPatternMachine(starts, _) -> match atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, None(), lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy))
      AtomicSearchYes() -> true
      AtomicSearchNo() -> false
      AtomicSearchCommit(_) -> false

  fn atomic_runtime_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    atomic_runtime_first_prefix_loop(n, machine, position, [], input)

  fn atomic_runtime_first_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    pickup
      atomic_runtime_accepts(n, machine, position, matched_input, remaining_input) -> Some(%[matched_input, remaining_input])
      else -> match remaining_input
        [] -> None()
        [char | rest] -> atomic_runtime_first_prefix_loop(n, machine, position, [char | reversed_prefix], rest)

  fn atomic_runtime_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    atomic_runtime_last_prefix_loop(n, machine, position, [], input, None())

  fn atomic_runtime_last_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: Option(Tuple(List(Char), List(Char)))) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    let current = pickup
      atomic_runtime_accepts(n, machine, position, matched_input, remaining_input) -> Some(%[matched_input, remaining_input])
      else -> previous
    match remaining_input
      [] -> current
      [char | rest] -> atomic_runtime_last_prefix_loop(n, machine, position, [char | reversed_prefix], rest, current)

  fn atomic_runtime_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool) -> Option(Tuple(List(Char), List(Char))) = pickup
    greedy -> atomic_runtime_last_prefix(n, machine, position, input)
    else -> atomic_runtime_first_prefix(n, machine, position, input)
































































































  ## Named replay for a lookaround-aware compilation uses the same checked
  ## finite machine as assertion acceptance.  Unlike the typed path, the
  ## returned routine is retained long enough to replay capture slots,
  ## including slots opened and closed inside a positive assertion.
  fn named_lookaround_full_capture({shape: ShapeCode}, compilation: LookaroundCompilation(shape), input: String, layout: CaptureLayout, policy: NewlinePolicy) -> Option(List(NamedCapture)) =
    match lookaround_compiled(compilation)
      mk_pair(count, machine) -> match atomic_lookaround_routine_accepts(regex_assertion_depth_limit(), count, machine, subject_initial_position(), Std.String.characters(input), [], [], [], policy)
        None() -> None()
        Some(routine) -> replay_named_capture_routine(routine, layout)

  fn named_lookaround_prefix_capture_at({shape: ShapeCode}, compilation: LookaroundCompilation(shape), input: List(Char), greedy: Bool, position: InitialPosition, history: List(Char), layout: CaptureLayout, policy: NewlinePolicy) -> Option(NamedPrefixCapture) =
    match lookaround_compiled(compilation)
      mk_pair(count, machine) -> match atomic_lookaround_routine_prefix(regex_assertion_depth_limit(), count, machine, position, input, greedy, history, [], policy)
        None() -> None()
        Some(%[matched, remaining, routine]) -> match replay_named_capture_routine(routine, layout)
          None() -> None()
          Some(captures) -> Some(NamedPrefixCapture(matched, remaining, captures))














































































































