  type AtomicStartTailEvidence(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)))
    AtomicStartTailEvidencePacked : {@erased kind: AtomicStartFailureKind} -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> AtomicStartTailEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)

  type AtomicStartTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)))
    AtomicStartTailPackagePacked : {@erased kind: AtomicStartFailureKind} -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> AtomicStartTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)

  ## A selected-tail package retains the inherited membership and trace while
  ## the rejected start fold moves past one sibling.  The recursive failure
  ## kind stays existential, exactly as in `AtomicStartTailPackage`; the
  ## selected membership is the additional evidence that lets the next
  ## construction site continue the same selected-start contradiction rather
  ## than falling back to a zero-argument assumption.
  type AtomicStartSelectedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_start: LookaroundAdmittedState(n), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicStartSelectedTailPackagePacked : {@erased kind: AtomicStartFailureKind} -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased membership: ListMember(LookaroundAdmittedState(n), selected_start, remaining)) -> (@erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)) -> AtomicStartSelectedTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, selected_start, matched, remaining_input, selected_routine)

  type AtomicStartSelectedTailTracePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_start: LookaroundAdmittedState(n), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicStartSelectedTailTracePacked : {@erased kind: AtomicStartFailureKind} -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased membership: ListMember(LookaroundAdmittedState(n), selected_start, remaining)) -> {@erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)} -> (trace_package: AtomicSelectedTracePackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine, path)) -> AtomicStartSelectedTailTracePackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, selected_start, matched, remaining_input, selected_routine)

  typealias AtomicStartRejectedTailAt(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n))) = AtomicStartTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)

  ## An active-headed rejected result retains its indexed recursive sibling
  ## tail. The child refutation remains supplied at the branch-specific
  ## eliminator, while this package keeps the tail witness available without
  ## reconstructing its existential failure kind.
  type AtomicStartActiveRejectedEvidence(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)))
    AtomicStartActiveRejectedEvidencePacked : (@erased tail: AtomicStartTailEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)) -> AtomicStartActiveRejectedEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining)

  ## The active child certificate is factored out so interface registration
  ## sees its dependent scope index as a complete constructor boundary.
  type AtomicStartActiveChildFailure(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), child_scope_depth: Nat)
    AtomicStartActiveChildFailurePacked : (@erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, thread_state, history, capture_context, policy, child_scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted())) -> AtomicStartActiveChildFailure(depth, n, machine, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, thread_state, child_scope_depth)

  ## A small indexed refinement keeps the active bounded state tied to the
  ## thread-state index without reopening the larger refutation GADT at the
  ## no-result constructor.
  type AtomicStartActiveThreadRefinement(n: Nat) indices (thread_state: ThreadState(n), state: Bounded(n))
    AtomicStartActiveThreadRefinementHere : (@erased state: Bounded(n)) -> AtomicStartActiveThreadRefinement(n, ThreadActive(state), state)

  ## A construction-site package for the active empty-input branch. The
  ## ordinary tail package intentionally existentially hides its failure kind
  ## and child scope. This stronger package is used only when the selected
  ## head is known to be active: it retains the child refutation, its cursor
  ## suffix, the recursive tail package, and the erased equality that aligns
  ## the child scope with the active start's selected-path scope. Without this
  ## equality a generic tail dispatcher could silently feed a proof at one
  ## scope to a path at another.
  type AtomicStartActiveRejectedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), child_scope_depth: Nat)
  ## The child certificate is an `AtomicPathRefutation` aligned at
  ## `child_scope_depth`; the alias above keeps that dependent index local.
    AtomicStartActiveRejectedTailPackagePacked : (@erased tail: AtomicStartTailPackage(depth, n, machine, position, Nil(), after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)) -> (@erased child_failure: AtomicStartActiveChildFailure(depth, n, machine, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, thread_state, child_scope_depth)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), Nil())) -> (@erased child_scope_alignment: Equivalent(Nat, child_scope_depth, atomic_scope_depth_after(routine, Z()))) -> AtomicStartActiveRejectedTailPackage(depth, n, machine, position, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, thread_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_scope_depth)

  ## The non-blocked active recursive branch is first normalized to the
  ## existing root-child package.  Keeping this new name as a wrapper avoids
  ## reopening the broad `AtomicPathRefutation` family at a GADT constructor;
  ## the wrapped package already fixes the child cursor to the empty root.
  type AtomicStartActiveRootTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), child_scope_depth: Nat)
    AtomicStartActiveRootTailPackagePacked : (@erased root: AtomicStartActiveRejectedTailPackage(depth, n, machine, position, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, thread_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_scope_depth)) -> AtomicStartActiveRootTailPackage(depth, n, machine, position, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, thread_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_scope_depth)

  ## The construction-site proof package keeps the parent and child capture
  ## contexts separate.  The parent context is used by the rejected start
  ## evidence and tail package; the child context is the exact context after
  ## the active candidate's regular routine and assertion markers.  Keeping
  ## both in the indices prevents a later proof consumer from silently
  ## substituting one VM context for the other.
  type AtomicStartActiveRootTailProofPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, parent_capture_context: List(EvidenceInstruction), child_capture_context: List(EvidenceInstruction), after_input: List(Char), history: List(Char), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), child_scope_depth: Nat)
    AtomicStartActiveRootTailProofPackagePacked : (@erased tail: AtomicStartTailPackage(depth, n, machine, position, Nil(), after_input, history, parent_capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, thread_state, history, child_capture_context, policy, child_scope_depth, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicPathFailureInputExhausted())) -> AtomicStartActiveRootTailProofPackage(depth, n, machine, position, parent_capture_context, child_capture_context, after_input, history, policy, prefix_mode, reversed_prefix, thread_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_scope_depth)

  type AtomicStartActiveRootTailProofPackageAt(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, parent_capture_context: List(EvidenceInstruction), child_capture_context: List(EvidenceInstruction), child_input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), child_whole: List(LookaroundAdmittedState(n)), child_current: List(LookaroundAdmittedState(n)), child_kind: AtomicPathFailureKind, child_scope_depth: Nat)
    AtomicStartActiveRootTailProofPackageAtPacked : (@erased tail: AtomicStartTailPackage(depth, n, machine, position, child_input, after_input, history, parent_capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, child_input, after_input, thread_state, history, child_capture_context, policy, child_scope_depth, prefix_mode, reversed_prefix, child_whole, child_current, child_kind)) -> AtomicStartActiveRootTailProofPackageAt(depth, n, machine, position, parent_capture_context, child_capture_context, child_input, after_input, history, policy, prefix_mode, reversed_prefix, thread_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_whole, child_current, child_kind, child_scope_depth)
  ## Publish the active root package from the real initial-tail result.  The
  ## child refutation is accepted only at its empty-input/root indices, while
  ## the sibling tail remains existentially typed behind `AtomicStartTailPackage`.
  ## This helper has no runtime payload: every proof argument is erased.
  @reducible
  fn atomic_start_active_root_tail_from_no(
    @erased depth: Nat,
    @erased n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    child_input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased whole: List(LookaroundAdmittedState(n)),
    @erased remaining: List(LookaroundAdmittedState(n)),
    @erased tail_kind: AtomicStartFailureKind,
    @erased tail_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    ),
    @erased tail_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    )
  ) -> AtomicStartTailPackage(
    depth,
    n,
    machine,
    position,
    child_input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = AtomicStartTailPackagePacked(tail_failure, tail_evidence)

  @reducible
  fn atomic_start_rejected_active_root_package(
    @erased depth: Nat,
    @erased n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    child_input: List(Char),
    after_input: List(Char),
    history: List(Char),
    parent_capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    child_scope_depth: Nat,
    @erased whole: List(LookaroundAdmittedState(n)),
    @erased remaining: List(LookaroundAdmittedState(n)),
    @erased child_whole: List(LookaroundAdmittedState(n)),
    @erased child_current: List(LookaroundAdmittedState(n)),
    @erased child_kind: AtomicPathFailureKind,
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      child_input,
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(parent_capture_context, routine), assertion_markers),
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      child_kind
    ),
    {@erased tail_kind: AtomicStartFailureKind},
    @erased tail_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      parent_capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    ),
    @erased tail_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      parent_capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    )
  ) -> AtomicStartActiveRootTailProofPackageAt(
    depth,
    n,
    machine,
    position,
    parent_capture_context,
    append_routine(append_routine(parent_capture_context, routine), assertion_markers),
    child_input,
    after_input,
    history,
    policy,
    prefix_mode,
    reversed_prefix,
    ThreadActive(state),
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    whole,
    remaining,
    child_whole,
    child_current,
    child_kind,
    child_scope_depth
  ) = AtomicStartActiveRootTailProofPackageAtPacked(
    atomic_start_active_root_tail_from_no(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      parent_capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind,
      tail_failure,
      tail_evidence
    ),
    child_failure
  )


  fn atomic_start_rejected_tail_evidence(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    )
  ) -> AtomicStartTailEvidence(
    depth,
    n,
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = match evidence
    AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_evidence) -> AtomicStartTailEvidencePacked(tail_evidence)

  fn atomic_start_active_rejected_evidence(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {state: Bounded(n)},
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    )
  ) -> AtomicStartActiveRejectedEvidence(
    depth,
    n,
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    whole,
    remaining
  ) = match evidence
    AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_evidence) ->
      AtomicStartActiveRejectedEvidencePacked(AtomicStartTailEvidencePacked(tail_evidence))

  ## Publish the active root-tail package at the existing root-child
  ## construction boundary.  The wrapped package carries the child
  ## refutation, its empty cursor suffix, the recursive tail, and the scope
  ## alignment; this adapter only gives that authority its non-blocked name.
  fn atomic_start_active_root_tail_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {thread_state: ThreadState(n)},
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_scope_depth: Nat},
    @erased root: AtomicStartActiveRejectedTailPackage(
      depth,
      n,
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      thread_state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      child_scope_depth
    )
  ) -> AtomicStartActiveRootTailPackage(
    depth,
    n,
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    thread_state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    whole,
    remaining,
    child_scope_depth
  ) = AtomicStartActiveRootTailPackagePacked(root)

  fn atomic_start_rejected_tail_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    )
  ) -> AtomicStartTailPackage(
    depth,
    n,
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = match evidence
    AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) ->
      AtomicStartTailPackagePacked(tail_failure, tail_evidence)

  ## Consume an exhausted recursive tail through the package boundary. The
  ## package index fixes the tail current list to `Nil()`, so the ordinary
  ## empty-start contradiction can be reused without recovering a bare list
  ## or inspecting an erased failure tag at runtime.
  fn atomic_start_rejected_tail_package_exhausted_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil()
    ),
    {item: LookaroundAdmittedState(n)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      item,
      matched,
      remaining_input,
      routine
    )
  ) -> result = match package
    AtomicStartTailPackagePacked(failure, _) -> match failure
      AtomicStartExhausted(_, _) -> lookaround_absurd(atomic_start_failure_excludes_trace(
        machine,
        position,
        input,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        membership,
        failure,
        path
      ))

  ## One-step `There` transport for an exhausted recursive start tail. The
  ## parent membership is split at the construction site; the `Here` branch is
  ## supplied by the caller, while the `There` branch forwards its inherited
  ## tail membership to the typed exhausted-tail package consumer. No erased
  ## tail failure tag is inspected.
  fn atomic_start_rejected_member_there_exhausted_tail_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    head: LookaroundAdmittedState(n),
    selected_start: LookaroundAdmittedState(n),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, Nil())),
    @erased package: AtomicStartRejectedTailAt(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    ),
    head_case: result
  ) -> result = match atomic_start_member_location(selected_start, head, Nil(), membership)
    AtomicStartMemberHere(_) -> head_case
    AtomicStartMemberThere(_, prior) -> atomic_start_rejected_tail_package_exhausted_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      package,
      prior,
      path
    )

  ## A later selected start is represented by a membership proof in the
  ## non-empty sibling tail.  Rebuild the parent `There` witness at this
  ## boundary, then hand the exact tail membership to the recursive consumer;
  ## the failure kind is already refined by the caller, so no erased tag drives
  ## runtime control flow.
  @reducible
  fn atomic_start_rejected_member_there_nonempty_tail_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    tail_head: LookaroundAdmittedState(n),
    {tail_rest: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(tail_head, tail_rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(tail_head, tail_rest),
      AtomicStartFailureRejected()
    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    tail_membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      tail_rest
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    ),
    head_case: result,
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      tail_rest,
      selected_start,
      matched,
      remaining_input,
      routine
    )) -> result
  ) -> result = let parent_membership: ListMember(
    LookaroundAdmittedState(n),
    selected_start,
    Cons(tail_head, tail_rest)
  ) = member_there(tail_head, tail_membership)
  atomic_start_rejected_member_induction_selected_erased(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    parent_membership,
    path,
    head_case,
    tail_case
  )

  ## Construction-site consumer for an active candidate at the head of a
  ## non-empty rejected tail.  The tail's input is empty, so its child failure
  ## is the indexed input-exhaustion certificate already consumed by the
  ## active-start eliminator.  The selected membership is retained here to
  ## tie this branch to the later-sibling `There` boundary.
  fn atomic_start_rejected_member_there_active_tail_head_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining)
    ),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      policy,
      atomic_scope_depth_after(routine, Z()),
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureInputExhausted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = let empty_input: List(Char) = []
    let head_case: result = atomic_start_tail_active_candidate_rejection_excludes_trace(
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      child_failure,
      child_suffix,
      evidence,
      path
    )
    atomic_start_rejected_member_induction_selected_erased(
      machine,
      position,
      empty_input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      failure,
      evidence,
      membership,
      selected_path,
      head_case,
      tail_case
    )

  ## Consume the active root-tail package at the exact empty-child boundary.
  ## The recursive continuation remains the relevant result; matching the
  ## package first ensures that only a root active-child exhaustion certificate
  ## can cross this bridge.
  @reducible
  fn atomic_start_active_root_failure_empty(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {thread_state: ThreadState(n)},
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_scope_depth: Nat},
    @erased package: AtomicStartActiveRootTailPackage(
      depth,
      n,
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      thread_state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      child_scope_depth
    ),
    tail_case: () -> result
  ) -> result = match package
    AtomicStartActiveRootTailPackagePacked(AtomicStartActiveRejectedTailPackagePacked(_, _, _, _)) -> tail_case()

  @reducible
  fn atomic_start_active_root_failure_empty_with_case(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {thread_state: ThreadState(n)},
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_scope_depth: Nat},
    @erased package: AtomicStartActiveRootTailPackage(
      depth,
      n,
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      thread_state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      child_scope_depth
    ),
    head_case: result
  ) -> result = match package
    AtomicStartActiveRootTailPackagePacked(AtomicStartActiveRejectedTailPackagePacked(_, _, _, _)) -> head_case

  ## A later selected start is carried through an active head of a non-empty
  ## rejected tail.  The parent rejection/evidence and the explicit empty-child
  ## certificate stay erased at this construction site; the root package is
  ## checked through its proof-only gate before the indexed active-head
  ## eliminator is invoked.
  @reducible
  fn atomic_start_rejected_member_there_nonempty_tail_active_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    @erased package: AtomicStartActiveRootTailProofPackage(
      depth,
      n,
      machine,
      position,
      capture_context,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      after_input,
      history,
      policy,
      prefix_mode,
      reversed_prefix,
      ThreadActive(state),
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      whole,
      remaining,
      atomic_scope_depth_after(routine, Z())
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = let head_case: result = match package
      AtomicStartActiveRootTailProofPackagePacked(
        _,
        child_failure
      ) -> atomic_start_rejected_member_there_active_tail_head_excludes_trace(
        machine,
        position,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        state,
        routine,
        constraints,
        assertion_routine,
        assertion_markers,
        nested_decisions,
        membership,
        child_failure,
        empty_lookaround_admitted_cursor_suffix(n),
        failure,
        evidence,
        path,
        selected_path,
        tail_case
      )
    atomic_start_rejected_member_induction_selected_erased(
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      failure,
      evidence,
      membership,
      selected_path,
      head_case,
      tail_case
    )

  ## The accepted-head counterpart carries the exact child character/rest and
  ## forwards the indexed exact-accepted child refutation.  The accepted
  ## candidate is only valid in exact mode, so the parent and selected-trace
  ## indices fix `prefix_mode` to `False()` instead of recovering it at runtime.
  fn atomic_start_rejected_member_there_accepted_tail_head_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureExactAccepted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = let head_case: result = match evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        atomic_start_tail_accepted_candidate_rejection_excludes_trace(
          machine,
          position,
          child_char,
          child_rest,
          after_input,
          history,
          capture_context,
          policy,
          reversed_prefix,
