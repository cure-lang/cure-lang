      selected_routine
    )) -> Empty
  ) -> Empty = match package
    AtomicStartBlockedTailPackagePacked(failure, skip, allowed, scope, evidence) ->
      let head_case: Empty = atomic_start_scope_record_excludes_allowed(scope, skip, allowed)
      atomic_start_blocked_member_induction_selected_erased(
        machine,
        position,
        input,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        skip,
        allowed,
        failure,
        evidence,
        membership,
        path,
        head_case,
        tail_case
      )



  @reducible
  fn atomic_path_search_origin_alignment(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    left_origin: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, left),
    right_origin: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, right)
  ) -> AtomicPathSearchOriginAlignment(n, left, right) = match left_origin
    AtomicPathSearchOriginAccepted() -> match right_origin
      AtomicPathSearchOriginAccepted() -> AtomicPathSearchOriginsAligned(reflexive(empty_lookaround_admitted_states(n)))
    AtomicPathSearchOriginActiveEmpty() -> match right_origin
      AtomicPathSearchOriginActiveEmpty() -> AtomicPathSearchOriginsAligned(reflexive(empty_lookaround_admitted_states(n)))
    AtomicPathSearchOriginActive(_, _, _, left_canonical) -> match right_origin
      AtomicPathSearchOriginActive(_, _, _, right_canonical) -> AtomicPathSearchOriginsAligned(trans(left_canonical, sym(right_canonical)))













  ## Construction-time outer classification for a recursive commit structure.
  ## Every constructor retains the original cursor/structure existential at
  ## its exact kind while hiding the kind-specific indices from later callers.
  type AtomicPathCommitStructureCursorClassifiedPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitStructureCursorClassifiedAfterFailurePacked : {@erased commit_depth: Nat} -> {@erased child_prefix_kind: AtomicPathFailurePrefixKind} -> {@erased child_kind: AtomicPathFailureKind} -> (package: AtomicPathCommitStructureCursorExistentialPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind))) -> AtomicPathCommitStructureCursorClassifiedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathCommitStructureCursorClassifiedFromChildPacked : {@erased commit_depth: Nat} -> {@erased child_kind: AtomicPathCommitCauseKind} -> (package: AtomicPathCommitStructureCursorExistentialPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, AtomicPathCommitFromChildKind(child_kind))) -> AtomicPathCommitStructureCursorClassifiedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathCommitStructureCursorClassifiedPastEscapedPacked : {@erased commit_depth: Nat} -> {@erased child_kind: AtomicPathCommitCauseKind} -> {@erased tail_kind: AtomicPathCommitCauseKind} -> (package: AtomicPathCommitStructureCursorExistentialPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, AtomicPathCommitPastEscapedKind(child_kind, tail_kind))) -> AtomicPathCommitStructureCursorClassifiedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathCommitStructureCursorClassifiedPastRejectedPacked : {@erased commit_depth: Nat} -> {@erased child_prefix_kind: AtomicPathFailurePrefixKind} -> {@erased child_kind: AtomicPathFailureKind} -> {@erased tail_kind: AtomicPathCommitCauseKind} -> (package: AtomicPathCommitStructureCursorExistentialPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, AtomicPathCommitPastRejectedKind(child_prefix_kind, child_kind, tail_kind))) -> AtomicPathCommitStructureCursorClassifiedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)

  fn atomic_path_commit_structure_cursor_classified_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased kind: AtomicPathCommitCauseKind},
    package: AtomicPathCommitStructureCursorExistentialPackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, current,
      commit_depth, kind
    )
  ) -> AtomicPathCommitStructureCursorClassifiedPackage(
    depth, n, machine, input, after_input, state, history, capture_context,
    policy, scope_depth, prefix_mode, reversed_prefix, whole, current
  ) = match package
    AtomicPathCommitStructureCursorExistentialPacked(_, _, structure) -> match structure
      AtomicPathCommitStructureAfterFailurePacked(_) ->
        AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(package)
      AtomicPathCommitStructureFromChildPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        AtomicPathCommitStructureCursorClassifiedFromChildPacked(package)
      AtomicPathCommitStructurePastEscapedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(package)
      AtomicPathCommitStructurePastRejectedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(package)

  ## A propagated commit's child cursor lives in a child-specific capture
  ## context, scope, canonical destination spine, depth, and commit kind. Those
  ## indices are existential at the parent boundary and must travel with the
  ## relevant cursor/structure package rather than being guessed by a caller.
  type AtomicPathCommitChildCursorPayloadPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), shape: LookaroundAdmittedStateCursorShape)
    AtomicPathCommitChildCursorPayloadPacked : {@erased child_capture_context: List(EvidenceInstruction)} -> (@erased context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> {@erased child_scope_depth: Nat} -> (@erased scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> {@erased child_whole: List(LookaroundAdmittedState(n))} -> {@erased child_current: List(LookaroundAdmittedState(n))} -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread_at(n, candidate), history, child_capture_context, policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (child_cursor_authority: LookaroundAdmittedStateCursorShapedPackage(n, child_whole, child_current, shape)) -> (child: AtomicPathCommitStructureCursorClassifiedPackage(depth, n, machine, rest, after_input, lookaround_admitted_state_thread_at(n, candidate), history, child_capture_context, policy, child_scope_depth, prefix_mode, reversed_prefix, child_whole, child_current)) -> AtomicPathCommitChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, shape)

  type AtomicPathCommitChildCursorExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char))
    AtomicPathCommitChildCursorExistentialPacked : (shape: LookaroundAdmittedStateCursorShape) -> (payload: AtomicPathCommitChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, shape)) -> AtomicPathCommitChildCursorExistentialPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)

  ## PastEscaped is selected by the relevant structure before its erased
  ## indices are refined. The recursive cursor is advanced from the relevant
  ## outer cursor; it is never projected from the erased commit cause.
  @reducible
  fn atomic_path_commit_structure_past_escaped_tail_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
