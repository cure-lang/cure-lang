    AtomicStartMembersActiveRootNo(_, _, failure, evidence, _, _, _, _, _, _, _, _, _, _, active_current_equivalence, _) -> match active_current_equivalence
      reflexive() -> LookaroundRoutineSearchNo(AtomicStartRefutationRoot(failure, evidence))
