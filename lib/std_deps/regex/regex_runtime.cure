nce(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, front), current, AtomicPathSkippedPrefixEscapedConsKind(commit_kind, tail_kind))

    AtomicPathSkippedRejectedCons : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased source: Bounded(n)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased child_capture_context: List(EvidenceInstruction)) -> (@erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context)) -> (@erased child_scope_depth: Nat) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_prefix_kind: AtomicPathFailurePrefixKind) -> (@erased child_prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_prefix_kind)) -> {@erased child_origin: List(LookaroundAdmittedState(n))} -> (@erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_origin)) -> (@erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_kind: AtomicPathFailureKind) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased child_evidence: AtomicPathNoEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind)) -> (@erased continuation: AtomicPathFailureContinuation(scope_depth, lookaround_admitted_state_closed_depth(n, scope_depth, candidate))) -> {@erased front: List(LookaroundAdmittedState(n))} -> {@erased current: List(LookaroundAdmittedState(n))} -> (@erased tail_kind: AtomicPathSkippedPrefixKind) -> (@erased tail: AtomicPathSkippedPrefixEvidence(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, tail_kind)) -> AtomicPathSkippedPrefixEvidence(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, tail_kind))

  ## Construction-site correlation between one rejected child cursor and the
  ## exact selected trace returned by the subsequent sibling traversal.  The
  ## child lists remain existential, but the parent search context and selected
  ## current list stay indexed.  This package is constructed only while both
  ## authorities are live in `atomic_lookaround_routine_tail_after_failure`;
  ## later proof folds consume it instead of rebuilding either side from erased
  ## failure evidence.
  type AtomicPathRejectedSelectedTracePairPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), selected_current: List(LookaroundAdmittedState(n)))
    AtomicPathRejectedSelectedTracePairPacked : {@erased rejected_child_whole: List(LookaroundAdmittedState(n))} -> {@erased rejected_child_current: List(LookaroundAdmittedState(n))} -> (rejected_child_cursor: LookaroundAdmittedStateCursorSuffixPackage(n, rejected_child_whole, rejected_child_current)) -> {@erased matched: List(Char)} -> {@erased remaining_input: List(Char)} -> {@erased selected_routine: List(ExtendedInstruction)} -> {@erased selected_trace: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, selected_routine)} -> (selected_trace_package: AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, selected_routine, selected_trace)) -> AtomicPathRejectedSelectedTracePairPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current)

  fn atomic_path_rejected_selected_trace_pair_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased rejected_child_whole: List(LookaroundAdmittedState(n))},
    {@erased rejected_child_current: List(LookaroundAdmittedState(n))},
    rejected_child_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, rejected_child_whole, rejected_child_current
    ),
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)}, {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased selected_trace: AtomicSelectedPathTrace(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, selected_current,
      matched, remaining_input, selected_routine
    )},
    selected_trace_package: AtomicSelectedPathTracePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, selected_current,
      matched, remaining_input, selected_routine, selected_trace
    )
  ) -> AtomicPathRejectedSelectedTracePairPackage(
    depth, n, machine, input, after_input, state, history, capture_context,
    policy, scope_depth, prefix_mode, reversed_prefix, selected_current
  ) = AtomicPathRejectedSelectedTracePairPacked(
    rejected_child_cursor,
    selected_trace_package
  )

  ## Hide the exact parent and trace indices after the pair has been checked at
  ## its construction site. Directional proof carriers need to retain whether
  ## a selected child's skipped spine contains such a rejection, but must not
  ## reconstruct its dependent indices from cursor shapes.
  type AtomicPathRejectedSelectedTracePairExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRejectedSelectedTracePairExistentialPacked : {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased state: ThreadState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> {@erased selected_current: List(LookaroundAdmittedState(n))} -> (pair: AtomicPathRejectedSelectedTracePairPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current)) -> AtomicPathRejectedSelectedTracePairExistentialPackage(depth, n, machine)

  type AtomicPathRejectedSelectedTracePairAvailability(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRejectedSelectedTracePairUnavailable : AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)
    AtomicPathRejectedSelectedTracePairAvailable : (pair: AtomicPathRejectedSelectedTracePairExistentialPackage(depth, n, machine)) -> AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine)

  ## Relevant constructor correlation for a successful search's skipped
  ## prefix. The evidence remains erased, while the relevant constructor and
  ## recursive tail package make its exact skip shape available to strict
  ## commit/selection proofs without inspecting an erased sum.
  type AtomicPathSkippedPrefixStructurePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), front: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), kind: AtomicPathSkippedPrefixKind)
    AtomicPathSkippedPrefixStructureEmptyPacked : (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, current, AtomicPathSkippedPrefixEmptyKind())) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, current, AtomicPathSkippedPrefixEmptyKind())
    AtomicPathSkippedPrefixStructureEscapedOnePacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased commit_kind: AtomicPathCommitCauseKind} -> (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, current), current, AtomicPathSkippedPrefixEscapedOneKind(commit_kind))) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, current), current, AtomicPathSkippedPrefixEscapedOneKind(commit_kind))
    AtomicPathSkippedPrefixStructureEscapedConsPacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased tail_front: List(LookaroundAdmittedState(n))} -> {@erased commit_kind: AtomicPathCommitCauseKind} -> {@erased tail_kind: AtomicPathSkippedPrefixKind} -> (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixEscapedConsKind(commit_kind, tail_kind))) -> (tail_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_front, current, tail_kind)) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixEscapedConsKind(commit_kind, tail_kind))
    AtomicPathSkippedPrefixStructureRejectedConsPacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased tail_front: List(LookaroundAdmittedState(n))} -> {@erased child_prefix_kind: AtomicPathFailurePrefixKind} -> {@erased child_kind: AtomicPathFailureKind} -> {@erased tail_kind: AtomicPathSkippedPrefixKind} -> (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, tail_kind))) -> (tail_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_front, current, tail_kind)) -> (rejected_selected_pair: AtomicPathRejectedSelectedTracePairPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, current)) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, tail_kind))

  fn atomic_path_skipped_prefix_rejected_selected_pair_availability(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> AtomicPathRejectedSelectedTracePairAvailability(depth, n, machine) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
      AtomicPathRejectedSelectedTracePairUnavailable()
    AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
      AtomicPathRejectedSelectedTracePairUnavailable()
    AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
      atomic_path_skipped_prefix_rejected_selected_pair_availability(
        tail_structure
      )
    AtomicPathSkippedPrefixStructureRejectedConsPacked(_, _, pair) ->
      AtomicPathRejectedSelectedTracePairAvailable(
        AtomicPathRejectedSelectedTracePairExistentialPacked(pair)
      )

  ## Opaque recursive selection authority. Its result indices mention the
  ## parent candidate and contexts, while each constructor retains the exact
  ## child origin, cursor, skipped prefix, and recursive trace behind one
  ## validated runtime shape.
  type AtomicPathSelectedChildCursorPayloadPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char), shape: LookaroundAdmittedStateCursorShape)
    AtomicPathSelectedChildCursorActivePacked : (@erased destination: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased child_whole: List(LookaroundAdmittedState(n))} -> {@erased child_current: List(LookaroundAdmittedState(n))} -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, ThreadActive(destination), history, lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, child_whole)) -> (child_cursor_package: LookaroundAdmittedStateCursorSuffixPackage(n, child_whole, child_current)) -> {@erased child_skipped_kind: AtomicPathSkippedPrefixKind} -> (child_skipped_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, rest, after_input, ThreadActive(destination), history, lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, reversed_prefix, child_whole, child_whole, child_current, child_skipped_kind)) -> {@erased suffix_routine: List(ExtendedInstruction)} -> {@erased suffix: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadActive(destination), history, lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, reversed_prefix, child_current, matched, remaining_input, suffix_routine)} -> (suffix_package: AtomicSelectedPathTracePackage(depth, n, machine, rest, after_input, ThreadActive(destination), history, lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, reversed_prefix, child_current, matched, remaining_input, suffix_routine, suffix)) -> (child_cursor_authority: LookaroundAdmittedStateCursorShapedPackage(n, child_whole, child_current, shape)) -> AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, shape)
    AtomicPathSelectedChildCursorAcceptedPacked : (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased child_whole: List(LookaroundAdmittedState(n))} -> {@erased child_current: List(LookaroundAdmittedState(n))} -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, ThreadAccepted(), history, lookaround_admitted_accepted_capture_context(capture_context, routine, assertion_markers), policy, child_whole)) -> (child_cursor_package: LookaroundAdmittedStateCursorSuffixPackage(n, child_whole, child_current)) -> {@erased child_skipped_kind: AtomicPathSkippedPrefixKind} -> (child_skipped_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, rest, after_input, ThreadAccepted(), history, lookaround_admitted_accepted_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, reversed_prefix, child_whole, child_whole, child_current, child_skipped_kind)) -> {@erased suffix_routine: List(ExtendedInstruction)} -> {@erased suffix: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadAccepted(), history, lookaround_admitted_accepted_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, reversed_prefix, child_current, matched, remaining_input, suffix_routine)} -> (suffix_package: AtomicSelectedPathTracePackage(depth, n, machine, rest, after_input, ThreadAccepted(), history, lookaround_admitted_accepted_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, reversed_prefix, child_current, matched, remaining_input, suffix_routine, suffix)) -> (child_cursor_authority: LookaroundAdmittedStateCursorShapedPackage(n, child_whole, child_current, shape)) -> AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, shape)

  type AtomicPathSelectedChildCursorExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char))
    AtomicPathSelectedChildCursorExistentialPacked : (shape: LookaroundAdmittedStateCursorShape) -> (payload: AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, shape)) -> AtomicPathSelectedChildCursorExistentialPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input)

  ## Path-free correlation boundary for the two independently constructed
  ## recursive child cursors. The comparison is indexed by the same shapes as
  ## the retained payloads, so every dispatch branch carries authority about
  ## those payloads rather than an unrelated existential pair.
  type AtomicPathCommitSelectedChildCursorPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (rest: List(Char), after_input: List(Char), candidate: LookaroundAdmittedState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char))
    AtomicPathCommitSelectedChildCursorPacked : (left_shape: LookaroundAdmittedStateCursorShape) -> (right_shape: LookaroundAdmittedStateCursorShape) -> (commit_payload: AtomicPathCommitChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, left_shape)) -> (selected_payload: AtomicPathSelectedChildCursorPayloadPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, right_shape)) -> (comparison: AtomicPathCursorShapeComparison(left_shape, right_shape)) -> AtomicPathCommitSelectedChildCursorPackage(depth, n, machine, rest, after_input, candidate, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input)

  fn atomic_path_commit_selected_child_cursor_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased rest: List(Char)}, {@erased after_input: List(Char)},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased matched: List(Char)}, {@erased remaining_input: List(Char)},
    commit: AtomicPathCommitChildCursorExistentialPackage(
      depth, n, machine, rest, after_input, candidate, history,
      capture_context, policy, scope_depth, prefix_mode, reversed_prefix
    ),
    selected: AtomicPathSelectedChildCursorExistentialPackage(
      depth, n, machine, rest, after_input, candidate, history,
      capture_context, policy, scope_depth, prefix_mode, reversed_prefix,
      matched, remaining_input
    )
  ) -> AtomicPathCommitSelectedChildCursorPackage(
    depth, n, machine, rest, after_input, candidate, history,
    capture_context, policy, scope_depth, prefix_mode, reversed_prefix,
    matched, remaining_input
  ) = match commit
    AtomicPathCommitChildCursorExistentialPacked(left_shape, commit_payload) -> match selected
      AtomicPathSelectedChildCursorExistentialPacked(right_shape, selected_payload) ->
        AtomicPathCommitSelectedChildCursorPacked(
          left_shape,
          right_shape,
          commit_payload,
          selected_payload,
          atomic_path_cursor_shape_comparison(left_shape, right_shape)
        )

  fn atomic_selected_path_trace_child_cursor_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(candidate, remaining), matched, remaining_input, selected_routine)},
    trace_package: AtomicSelectedPathTracePackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(candidate, remaining), matched, remaining_input, selected_routine, path)
  ) -> AtomicPathSelectedChildCursorExistentialPackage(depth, n, machine, rest, after_input, candidate, history_push_bounded(history, char), capture_context, policy, scope_depth, prefix_mode, Cons(char, reversed_prefix), matched, remaining_input) = match trace_package
    AtomicSelectedPathTracePrefixDonePacked() -> impossible
    AtomicSelectedPathTraceExactDonePacked() -> impossible
    AtomicSelectedPathTraceActivePacked(_, _, destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions, _, _, _, _, _, _, child_origin_canonical, _, _, _, shape, child_cursor_package, _, _, child_skipped_structure, _, suffix_package, child_cursor_authority) ->
      AtomicPathSelectedChildCursorExistentialPacked(shape, AtomicPathSelectedChildCursorActivePacked(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions, child_origin_canonical, child_cursor_package, child_skipped_structure, suffix_package, child_cursor_authority))
    AtomicSelectedPathTraceAcceptedPacked(_, _, routine, constraints, assertion_routine, assertion_markers, nested_decisions, _, _, _, _, _, _, child_origin_canonical, _, _, _, shape, child_cursor_package, _, _, child_skipped_structure, _, suffix_package, child_cursor_authority) ->
      AtomicPathSelectedChildCursorExistentialPacked(shape, AtomicPathSelectedChildCursorAcceptedPacked(routine, constraints, assertion_routine, assertion_markers, nested_decisions, child_origin_canonical, child_cursor_package, child_skipped_structure, suffix_package, child_cursor_authority))

  ## Recover the ordered front-to-current cursor solely from the relevant
  ## skipped-prefix structure. Each erased evidence match has one constructor
  ## fixed by the already-selected relevant branch; erased fields affect only
  ## indices and never runtime control.
  @reducible
  fn atomic_path_skipped_prefix_structure_cursor_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, front, current) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(evidence) -> match evidence
      AtomicPathSkippedPrefixEmpty() ->
        lookaround_admitted_cursor_suffix_package_here(reflexive(current))
    AtomicPathSkippedPrefixStructureEscapedOnePacked(evidence) -> match evidence
      AtomicPathEscapedCommitOne(_, _, _, candidate, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        lookaround_admitted_cursor_suffix_package_drop(
          candidate,
          lookaround_admitted_cursor_suffix_package_here(reflexive(current))
        )
    AtomicPathSkippedPrefixStructureEscapedConsPacked(evidence, tail_structure) -> match evidence
      AtomicPathEscapedCommitCons(_, _, _, candidate, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        lookaround_admitted_cursor_suffix_package_drop(
          candidate,
          atomic_path_skipped_prefix_structure_cursor_package(tail_structure)
        )
    AtomicPathSkippedPrefixStructureRejectedConsPacked(evidence, tail_structure, _) -> match evidence
      AtomicPathSkippedRejectedCons(_, _, _, candidate, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        lookaround_admitted_cursor_suffix_package_drop(
          candidate,
          atomic_path_skipped_prefix_structure_cursor_package(tail_structure)
        )

  ## Keep the relevant skipped-prefix structure beside an exact shaped cursor
  ## over the same front/current indices.  Hiding the dependent search context
  ## leaves the finite shape available for direction dispatch without severing
  ## it from the structure that produced the cursor.
  type AtomicPathSkippedPrefixCursorShapedPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), front: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), kind: AtomicPathSkippedPrefixKind, shape: LookaroundAdmittedStateCursorShape)
    AtomicPathSkippedPrefixCursorShapedEmptyPacked : (structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, current, AtomicPathSkippedPrefixEmptyKind())) -> AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, current, AtomicPathSkippedPrefixEmptyKind(), LookaroundAdmittedStateCursorShapeHere())
    AtomicPathSkippedPrefixCursorShapedEscapedOnePacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased commit_kind: AtomicPathCommitCauseKind} -> (structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, current), current, AtomicPathSkippedPrefixEscapedOneKind(commit_kind))) -> AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, current), current, AtomicPathSkippedPrefixEscapedOneKind(commit_kind), LookaroundAdmittedStateCursorShapeDrop(LookaroundAdmittedStateCursorShapeHere()))
    AtomicPathSkippedPrefixCursorShapedEscapedConsPacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased tail_front: List(LookaroundAdmittedState(n))} -> {@erased commit_kind: AtomicPathCommitCauseKind} -> {@erased tail_kind: AtomicPathSkippedPrefixKind} -> {@erased tail_shape: LookaroundAdmittedStateCursorShape} -> (structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixEscapedConsKind(commit_kind, tail_kind))) -> (tail: AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_front, current, tail_kind, tail_shape)) -> AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixEscapedConsKind(commit_kind, tail_kind), LookaroundAdmittedStateCursorShapeDrop(tail_shape))
    AtomicPathSkippedPrefixCursorShapedRejectedConsPacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased tail_front: List(LookaroundAdmittedState(n))} -> {@erased child_prefix_kind: AtomicPathFailurePrefixKind} -> {@erased child_kind: AtomicPathFailureKind} -> {@erased tail_kind: AtomicPathSkippedPrefixKind} -> {@erased tail_shape: LookaroundAdmittedStateCursorShape} -> (structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, tail_kind))) -> (tail: AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_front, current, tail_kind, tail_shape)) -> AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, tail_kind), LookaroundAdmittedStateCursorShapeDrop(tail_shape))

  type AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (shape: LookaroundAdmittedStateCursorShape)
    AtomicPathSkippedPrefixCursorShapedExistentialPacked : {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased state: ThreadState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased front: List(LookaroundAdmittedState(n))} -> {@erased current: List(LookaroundAdmittedState(n))} -> {@erased kind: AtomicPathSkippedPrefixKind} -> (payload: AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind, shape)) -> AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, shape)

  type AtomicPathSkippedPrefixCursorExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathSkippedPrefixCursorExistentialPacked : (shape: LookaroundAdmittedStateCursorShape) -> (payload: AtomicPathSkippedPrefixCursorShapedExistentialPackage(depth, n, machine, shape)) -> AtomicPathSkippedPrefixCursorExistentialPackage(depth, n, machine)

  fn atomic_path_skipped_prefix_cursor_shaped_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> Sigma(shape: LookaroundAdmittedStateCursorShape, AtomicPathSkippedPrefixCursorShapedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, front, current, kind, shape)) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
      %[LookaroundAdmittedStateCursorShapeHere(), AtomicPathSkippedPrefixCursorShapedEmptyPacked(structure)]
    AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
      %[LookaroundAdmittedStateCursorShapeDrop(LookaroundAdmittedStateCursorShapeHere()), AtomicPathSkippedPrefixCursorShapedEscapedOnePacked(structure)]
    AtomicPathSkippedPrefixStructureEscapedConsPacked(evidence, tail_structure) -> match atomic_path_skipped_prefix_cursor_shaped_package(tail_structure)
      mk_pair(tail_shape, tail_payload) ->
          %[LookaroundAdmittedStateCursorShapeDrop(tail_shape), AtomicPathSkippedPrefixCursorShapedEscapedConsPacked(
              AtomicPathSkippedPrefixStructureEscapedConsPacked(
                evidence,
                tail_structure
              ),
              tail_payload
            )]
    AtomicPathSkippedPrefixStructureRejectedConsPacked(evidence, tail_structure, pair) -> match atomic_path_skipped_prefix_cursor_shaped_package(tail_structure)
      mk_pair(tail_shape, tail_payload) ->
          %[LookaroundAdmittedStateCursorShapeDrop(tail_shape), AtomicPathSkippedPrefixCursorShapedRejectedConsPacked(
              AtomicPathSkippedPrefixStructureRejectedConsPacked(
                evidence,
                tail_structure,
                pair
              ),
              tail_payload
            )]

  fn atomic_path_skipped_prefix_cursor_shaped_existential_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> AtomicPathSkippedPrefixCursorExistentialPackage(
    depth, n, machine
  ) = match atomic_path_skipped_prefix_cursor_shaped_package(structure)
    mk_pair(shape, payload) ->
      AtomicPathSkippedPrefixCursorExistentialPacked(
        shape,
        AtomicPathSkippedPrefixCursorShapedExistentialPacked(payload)
      )

  ## A successful skipped prefix determines its cursor direction without a
  ## second list comparison: the empty constructor is equality, and every
  ## non-empty constructor places the selection strictly to the right.
  @reducible
  fn atomic_path_skipped_prefix_structure_location(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> AtomicPathCursorLocation(n, front, current) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
      AtomicPathCursorLocationSame(reflexive(current))
    AtomicPathSkippedPrefixStructureEscapedOnePacked(_) ->
      AtomicPathCursorLocationRightAfter(
        atomic_path_skipped_prefix_structure_cursor_package(structure)
      )
    AtomicPathSkippedPrefixStructureEscapedConsPacked(_, _) ->
      AtomicPathCursorLocationRightAfter(
        atomic_path_skipped_prefix_structure_cursor_package(structure)
      )
    AtomicPathSkippedPrefixStructureRejectedConsPacked(_, _, _) ->
      AtomicPathCursorLocationRightAfter(
        atomic_path_skipped_prefix_structure_cursor_package(structure)
      )

  typealias AtomicPathRecursiveCommitSelectedPackage(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)), commit_depth: Nat, commit_kind: AtomicPathCommitCauseKind, selected_trace_package: Type, skipped_kind: AtomicPathSkippedPrefixKind) = AtomicPathCommitSelectedLocationPackage(n, AtomicPathCommitStructureCursorExistentialPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, commit_current, commit_depth, commit_kind), LookaroundAdmittedStateCursorSuffixPackage(n, whole, commit_current), selected_trace_package, AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, commit_current, selected_current, skipped_kind), commit_current, selected_current)

  typealias AtomicPathRecursiveCommitSelectedSamePackage(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)), commit_depth: Nat, commit_kind: AtomicPathCommitCauseKind, selected_trace_package: Type, skipped_kind: AtomicPathSkippedPrefixKind) = AtomicPathCommitSelectedSameAuthorityPackage(n, AtomicPathCommitStructureCursorExistentialPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, commit_current, commit_depth, commit_kind), LookaroundAdmittedStateCursorSuffixPackage(n, whole, commit_current), selected_trace_package, AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, commit_current, selected_current, skipped_kind), commit_current, selected_current)

  typealias AtomicPathRecursiveCommitSelectedRightPackage(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)), commit_depth: Nat, commit_kind: AtomicPathCommitCauseKind, selected_trace_package: Type, skipped_kind: AtomicPathSkippedPrefixKind) = AtomicPathCommitSelectedRightAuthorityPackage(n, AtomicPathCommitStructureCursorExistentialPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, commit_current, commit_depth, commit_kind), LookaroundAdmittedStateCursorSuffixPackage(n, whole, commit_current), selected_trace_package, AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, commit_current, selected_current, skipped_kind), commit_current, selected_current)

  ## Non-dependent runtime envelope for a selected trace. The finite cursor
  ## shape may choose control flow, while the untouched dependent package is
  ## retained as the only proof authority for the selected path.
  type AtomicSelectedPathTraceRuntimeEnvelope(trace_package: Type) indices ()
    AtomicSelectedPathTraceRuntimeEnvelopePacked : (shape: LookaroundAdmittedStateCursorShape) -> (package: trace_package) -> AtomicSelectedPathTraceRuntimeEnvelope(trace_package)

  fn atomic_selected_path_trace_runtime_envelope(
    {trace_package: Type},
    shape: LookaroundAdmittedStateCursorShape,
    package: trace_package
  ) -> AtomicSelectedPathTraceRuntimeEnvelope(trace_package) =
    AtomicSelectedPathTraceRuntimeEnvelopePacked(shape, package)

  ## Hide every dependent selected-suffix index while retaining the exact
  ## runtime envelope built alongside its validated cursor shape. This is the
  ## right-hand authority used by heterogeneous recursive commit proofs.
  type AtomicSelectedPathTraceExistentialRuntimeEnvelope(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicSelectedPathTraceExistentialRuntimeEnvelopePacked : {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased state: ThreadState(n)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> {@erased scope_depth: Nat} -> {@erased prefix_mode: Bool} -> {@erased reversed_prefix: List(Char)} -> {@erased current: List(LookaroundAdmittedState(n))} -> {@erased matched: List(Char)} -> {@erased remaining_input: List(Char)} -> {@erased routine: List(ExtendedInstruction)} -> {@erased path: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, current, matched, remaining_input, routine)} -> (envelope: AtomicSelectedPathTraceRuntimeEnvelope(AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, current, matched, remaining_input, routine, path))) -> AtomicSelectedPathTraceExistentialRuntimeEnvelope(depth, n, machine)

  fn atomic_selected_path_trace_existential_runtime_envelope(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {input: List(Char)}, {after_input: List(Char)},
    {state: ThreadState(n)}, {history: List(Char)},
    {capture_context: List(EvidenceInstruction)}, {policy: NewlinePolicy},
    {scope_depth: Nat}, {prefix_mode: Bool},
    {reversed_prefix: List(Char)},
    {current: List(LookaroundAdmittedState(n))}, {matched: List(Char)},
    {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)},
    {path: AtomicSelectedPathTrace(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, current, matched,
      remaining_input, routine
    )},
    shape: LookaroundAdmittedStateCursorShape,
    package: AtomicSelectedPathTracePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, current, matched,
      remaining_input, routine, path
    )
  ) -> AtomicSelectedPathTraceExistentialRuntimeEnvelope(depth, n, machine) =
    AtomicSelectedPathTraceExistentialRuntimeEnvelopePacked(
      atomic_selected_path_trace_runtime_envelope(shape, package)
    )

  ## One recursive induction state with every child-specific index hidden but
  ## still correlated. Consumers open this package and dispatch on the retained
  ## relevant commit, selected trace, and skipped-prefix structures.
