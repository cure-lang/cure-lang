  fn lookaround_machine_acceptance_path(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundSearchResult(depth, n, machine, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy), input, after_input, history, policy, capture_context) =
    lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy))


  fn lookaround_prefix_machine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = match machine
    MkPatternMachine(starts, _) -> match lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy))
      LookaroundPrefixSearchResultRejected(_) -> false
      LookaroundPrefixSearchResultFound(_) -> true







































  ## A structural Same comparison is useful as proof authority only after
  ## both shapes have been checked against their exact cursor packages.  With
  ## the outer origins aligned, equal Here/Drop spines force the two hidden
  ## inner cursors to be equal as well.
  @reducible
  local fn lookaround_admitted_cursor_same_shape_inner_equivalent(
    {n: Nat},
    {@erased left_outer: List(LookaroundAdmittedState(n))},
    {@erased left_inner: List(LookaroundAdmittedState(n))},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    {left_shape: LookaroundAdmittedStateCursorShape},
    {right_shape: LookaroundAdmittedStateCursorShape},
    left_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, left_outer, left_inner, left_shape
    ),
    right_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, right_outer, right_inner, right_shape
    ),
    same_authority: AtomicPathCursorShapesSameAuthority(
      left_shape, right_shape
    ),
    @erased outer_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)), left_outer, right_outer
    )
  ) -> LookaroundAdmittedCursorInnerEquivalentAuthority(
    n, left_inner, right_inner
  ) = match same_authority
    AtomicPathCursorShapesSameHere() -> match left_cursor
      LookaroundAdmittedStateCursorHereShapedPacked(left_equality) -> match right_cursor
        LookaroundAdmittedStateCursorHereShapedPacked(right_equality) ->
          LookaroundAdmittedCursorInnerEquivalentPacked(
            trans(sym(left_equality), trans(outer_equivalence, right_equality))
          )
    AtomicPathCursorShapesSameDrop(prior) -> match left_cursor
      LookaroundAdmittedStateCursorDropShapedPacked(_, left_prior) -> match right_cursor
        LookaroundAdmittedStateCursorDropShapedPacked(_, right_prior) -> match outer_equivalence
          reflexive() -> lookaround_admitted_cursor_same_shape_inner_equivalent(
              left_prior,
              right_prior,
              prior,
              reflexive()
            )








































































































































  ## A complete search rejection excludes every accepting start path in the
  ## current suffix.  Both sides descend through the same list spine: `Here`
  ## consumes the rejected child certificate, while `There` consumes the tail
  ## search certificate.  The failure index prevents either branch from
  ## silently reusing a certificate for a different start-list suffix.
  fn lookaround_search_failure_excludes_path(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    {starts: List(MachineState(n))},
    {current: List(MachineState(n))},
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current),
    path: LookaroundSearchPath(depth, n, machine, capture_context, current, input, after_input, history, policy)
  ) -> Empty = match failure
    LookaroundSearchExhausted(_, _) -> lookaround_search_path_excludes_empty_starts(depth, n, machine, input, after_input, history, capture_context, policy, path)
    LookaroundSearchActiveRejectedEmpty(_, _, _, _, _, _, _, tail_failure) -> match path
      LookaroundSearchFoundActive(_, _, input_equivalent, _, _, _, _, _, _) -> match input_equivalent
      LookaroundSearchFoundAccepted(input_equivalent, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> impossible
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundAccepted(reflexive(empty_characters()), path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
    LookaroundSearchActiveRejectedStep(_, _, state, routine, constraints, _, _, _, child_failure, tail_failure) -> match path
      LookaroundSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> lookaround_path_failure_recurse_child(
            n,
            machine,
            input,
            state,
            child_failure,
            cursor_suffix,
            child_path
          )
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
      LookaroundSearchFoundAccepted(input_equivalent, _, _, _, _, _) -> match input_equivalent
    LookaroundSearchAcceptedRejected(_, _, routine, constraints, _, _, _, _, tail_failure) -> match path
      LookaroundSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> impossible
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
      LookaroundSearchFoundAccepted(input_equivalent, _, _, _, _, _) -> match input_equivalent

















  ## Converse direction for exact assertion search.  Any independently
  ## constructed accepting path rules out the evaluator's rejected branch, so
  ## the computed result is constructively known to contain a path.
  fn lookaround_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(failure) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundSearchResultFound(found_path) -> LookaroundSearchPathComplete(found_path)

  ## The dual theorem says that an independently constructed complete failure
  ## tree forces the evaluator into its rejected branch.
  fn lookaround_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(found_failure) -> LookaroundSearchRefutationComplete(found_failure)
    LookaroundSearchResultFound(path) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))

  ## Prefix/lookahead search has the same completeness pair over its smaller,
  ## active-only failure family.
  fn lookaround_prefix_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundPrefixSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundPrefixSearchResultRejected(failure) -> lookaround_absurd(lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundPrefixSearchResultFound(found_path) -> LookaroundPrefixSearchPathComplete(found_path)

  fn lookaround_prefix_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundPrefixSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundPrefixSearchResultRejected(found_failure) -> LookaroundPrefixSearchRefutationComplete(found_failure)
    LookaroundPrefixSearchResultFound(path) -> lookaround_absurd(lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))































































  fn lookaround_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool, history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) = pickup
    greedy -> lookaround_last_prefix(n, machine, position, input, history, policy)
    else -> lookaround_first_prefix(n, machine, position, input, history, policy)



































































































































































  ## Relevant structural authority for the non-terminal aligned-Same boundary.
  ## Propagated commit branches retain their already-projected recursive child
  ## beside the complete heterogeneous aligned carrier. No erased cursor
  ## equality is used to construct or reindex live recursive data.
  type AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameFromChildPacked : (projected: AtomicPathRecursiveCommitSelectedChildSameProjectedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked : (projected: AtomicPathRecursiveCommitSelectedChildSameProjectedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(depth, n, machine)
    AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked : (aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(depth, n, machine)








  ## A Here direction fixes the selected skipped-prefix cursor to `Here`.
  ## The canonical shape stored with that cursor rules out every non-empty
  ## skipped constructor, leaving one exact empty package for the local child
  ## contradiction.
  type AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices ()
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked : (source: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(depth, n, machine)) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(depth, n, machine)

  fn atomic_path_recursive_commit_selected_child_same_after_failure_here_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(
      depth, n, machine
    )) -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(
      _, selected_child, _
    ) -> match selected_child
      AtomicPathSkippedPrefixCursorShapedExistentialPacked(selected_payload) -> match selected_payload
        AtomicPathSkippedPrefixCursorShapedEmptyPacked(structure) -> match structure
          AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
            empty_case(
              AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked(package)
            )

  fn atomic_path_recursive_commit_selected_child_same_aligned_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameExistentialPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
    depth, n, machine
  ) = match package
    AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
      {rest = rest}, {after_input = after_input}, {history = history},
      {capture_context = capture_context}, {policy = policy},
      {scope_depth = scope_depth}, {prefix_mode = prefix_mode},
      {reversed_prefix = reversed_prefix}, {matched = matched},
      {remaining_input = remaining_input},
      _, right_shape, commit_payload, selected_payload, same_authority
    ) -> match commit_payload
      AtomicPathCommitChildCursorPayloadPacked(
        {child_whole = left_whole}, {child_current = left_current},
        context_alignment, scope_alignment, child_origin_equivalence,
        child_origin_canonical, _, left_cursor, commit
      ) -> match selected_payload
        AtomicPathSelectedChildCursorActivePacked(
          {child_whole = right_whole}, {child_current = right_current},
          {child_skipped_kind = skipped_kind},
          {suffix_routine = suffix_routine}, {suffix = suffix},
          destination, routine, constraints, assertion_routine,
          assertion_markers, nested_decisions, right_origin_canonical, _,
          selected_skipped, selected_suffix, right_cursor
        ) -> match context_alignment
          LookaroundAdmittedStateCaptureContextActive() -> match scope_alignment
            LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match atomic_path_search_origin_alignment(child_origin_canonical, right_origin_canonical)
              AtomicPathSearchOriginsAligned(origin_equivalence) ->
                AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
                  commit,
                  selected_skipped,
                  selected_suffix,
                  atomic_selected_path_trace_existential_runtime_envelope(
                    right_shape,
                    selected_suffix
                  ),
                  lookaround_admitted_cursor_same_shape_inner_equivalent(
                    left_cursor,
                    right_cursor,
                    same_authority,
                    trans(child_origin_equivalence, origin_equivalence)
                  ),
                  package
                )
        AtomicPathSelectedChildCursorAcceptedPacked(
          {child_whole = right_whole}, {child_current = right_current},
          {child_skipped_kind = skipped_kind},
          {suffix_routine = suffix_routine}, {suffix = suffix},
          routine, constraints, assertion_routine, assertion_markers,
          nested_decisions, right_origin_canonical, _, selected_skipped,
          selected_suffix, right_cursor
        ) -> match context_alignment
          LookaroundAdmittedStateCaptureContextAccepted() -> match scope_alignment
            LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match atomic_path_search_origin_alignment(child_origin_canonical, right_origin_canonical)
              AtomicPathSearchOriginsAligned(origin_equivalence) ->
                AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
                  commit,
                  selected_skipped,
                  selected_suffix,
                  atomic_selected_path_trace_existential_runtime_envelope(
                    right_shape,
                    selected_suffix
                  ),
                  lookaround_admitted_cursor_same_shape_inner_equivalent(
                    left_cursor,
                    right_cursor,
                    same_authority,
                    trans(child_origin_equivalence, origin_equivalence)
                  ),
                  package
                )

  fn atomic_path_recursive_commit_selected_child_same_continuation_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
    depth, n, machine
  ) = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked(aligned)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructureFromChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSameFromChildPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_from_child_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructurePastEscapedPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_past_escaped_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) ->
      AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked(
        aligned
      )

  fn atomic_path_recursive_commit_selected_child_same_after_failure_terminal_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(
    depth, n, machine
  ) = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
        child_commit
      ) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          _, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(child_package) -> match child_package
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
              terminal_classification, _, _, _, _
            ) -> match terminal_classification
              AtomicPathCommitAfterFailureInputExhaustedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInputExhaustedPacked(aligned)
              AtomicPathCommitAfterFailureExactAcceptedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalExactAcceptedPacked(aligned)
              AtomicPathCommitAfterFailureRootDestinationsExhaustedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalRootDestinationsExhaustedPacked(aligned)
              AtomicPathCommitAfterFailureTerminalUnclassifiedPacked() ->
                AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalUnclassifiedPacked(aligned)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) -> AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(aligned)

  fn atomic_path_recursive_commit_selected_child_same_after_failure_terminal_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalPackage(
      depth, n, machine
    ),
    input_exhausted_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    exact_accepted_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    root_destinations_exhausted_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    unclassified_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )) -> result,
    invalid_case: () -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInputExhaustedPacked(aligned) ->
      input_exhausted_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalExactAcceptedPacked(aligned) ->
      exact_accepted_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalRootDestinationsExhaustedPacked(aligned) ->
      root_destinations_exhausted_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalUnclassifiedPacked(aligned) ->
      unclassified_case(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureTerminalInvalidPacked(_) ->
      invalid_case()






  ## Common runtime dispatcher for recursive commit/selection authorities.
  ## The finite tag chooses a branch. Same is aligned and classifies its local
  ## child terminal once before reaching the recursive callback; strict
  ## directions retain the original existential unchanged. No erased child
  ## index is reconstructed and no tag is treated as proof evidence.
  fn atomic_path_recursive_commit_selected_existential_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    ),
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> result,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    invalid_case: () -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedExistentialPacked(_) ->
      correlated_case(package)
    AtomicPathRecursiveCommitSelectedChildExistentialPacked(pair) -> match pair
      AtomicPathCommitSelectedChildCursorPacked(left_shape, right_shape, commit_payload, selected_payload, comparison) -> match comparison
        AtomicPathCursorShapeComparisonSame(same_authority) ->
          atomic_path_recursive_commit_selected_child_same_after_failure_terminal_dispatch(
            atomic_path_recursive_commit_selected_child_same_after_failure_terminal_package(
              atomic_path_recursive_commit_selected_child_same_aligned_package(
                AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
                  left_shape,
                  right_shape,
                  commit_payload,
                  selected_payload,
                  same_authority
                )
              )
            ),
            fn(input_exhausted) ->
              atomic_path_recursive_commit_selected_child_same_input_exhausted_fold(
                input_exhausted,
                fn(_) -> invalid_case()
              ),
            fn(exact_accepted) ->
              atomic_path_recursive_commit_selected_child_same_exact_accepted_fold(
                exact_accepted,
                fn(_) -> invalid_case()
              ),
            fn(root_exhausted) ->
              atomic_path_recursive_commit_selected_child_same_root_destinations_exhausted_fold(
                root_exhausted,
                fn(_) -> invalid_case()
              ),
            fn(unclassified) ->
              same_case(
                atomic_path_recursive_commit_selected_child_same_continuation_package(
                  unclassified
                )
              ),
            invalid_case
          )
        AtomicPathCursorShapeComparisonLeftAfter(_) -> left_case(package)
        AtomicPathCursorShapeComparisonRightAfter(_) -> right_case(package)

  ## Enter the next recursive child only from a fixed propagated-Same branch.
  ## The projected commit and selected suffix already exist as relevant
  ## values. Their erased inner equality is consumed solely on a path whose
  ## result is Empty; no transported package escapes this eliminator.
  fn atomic_path_recursive_commit_selected_child_same_projected_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameProjectedPackage(
      depth, n, machine
    ),
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> Empty,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(_, aligned) -> match aligned
      AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
        commit, _, selected_suffix, _, inner_equivalence, source
      ) -> match source
        AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
          _, right_shape, _, _, _
        ) -> match commit
          AtomicPathCommitStructureCursorClassifiedFromChildPacked(child_commit) -> match child_commit
            AtomicPathCommitStructureCursorExistentialPacked(
              _, _, child_structure
            ) -> match child_structure
              AtomicPathCommitStructureFromChildPacked(
                _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
              ) -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> atomic_path_recursive_commit_selected_existential_dispatch(
                    atomic_path_commit_child_selected_location_package(
                      atomic_path_commit_structure_cursor_from_child_child_package(
                        child_commit
                      ),
                      atomic_selected_path_trace_runtime_envelope(
                        right_shape,
                        selected_suffix
                      )
                    ),
                    correlated_case,
                    same_case,
                    left_case,
                    right_case,
                    invalid_case
                  )
          AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(child_commit) -> match child_commit
            AtomicPathCommitStructureCursorExistentialPacked(
              _, _, child_structure
            ) -> match child_structure
              AtomicPathCommitStructurePastEscapedPacked(
                _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
              ) -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> atomic_path_recursive_commit_selected_existential_dispatch(
                    atomic_path_commit_child_selected_location_package(
                      atomic_path_commit_structure_cursor_past_escaped_child_package(
                        child_commit
                      ),
                      atomic_selected_path_trace_runtime_envelope(
                        right_shape,
                        selected_suffix
                      )
                    ),
                    correlated_case,
                    same_case,
                    left_case,
                    right_case,
                    invalid_case
                  )
          AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
            invalid_case()
          AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
            invalid_case()
      AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
        _, _, _, _, _, _
      ) -> invalid_case()

  ## Structural Same continuation routing. Propagated child commits must enter
  ## the fixed Empty transport; local branches remain exact proof obligations
  ## for the eventual common induction theorem.
  fn atomic_path_recursive_commit_selected_child_same_continuation_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    ),
    after_failure_here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    after_failure_there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    after_failure_reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    past_rejected_empty_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> Empty,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked(aligned) ->
      atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_fold(
        aligned,
        after_failure_here_case,
        after_failure_there_case,
        after_failure_reverse_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSameFromChildPacked(projected) ->
      atomic_path_recursive_commit_selected_child_same_projected_dispatch(
        projected,
        correlated_case,
        same_case,
        left_case,
        right_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked(projected) ->
      atomic_path_recursive_commit_selected_child_same_projected_dispatch(
        projected,
        correlated_case,
        same_case,
        left_case,
        right_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked(aligned) ->
      atomic_path_recursive_commit_selected_child_same_past_rejected_empty_fold(
        aligned,
        past_rejected_empty_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked(_) ->
      invalid_case()








  ## Open the exact local destination rejection and the exact selected active
  ## transition under the already-established Same cursor authority.  Their
  ## child packages are placed in the canonical alignment carrier before any
  ## branch is selected, so a Here/later/reverse callback cannot observe a
  ## failure from one transition beside the suffix of another transition.
  fn atomic_path_recursive_commit_selected_child_same_destination_rejected_alignment_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    ),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
      commit, _, selected_suffix, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(
        child_commit
      ) -> match child_commit
        AtomicPathCommitStructureCursorExistentialPacked(
          _, _, structure
        ) -> match structure
          AtomicPathCommitStructureAfterFailurePacked(child_package) -> match child_package
            AtomicPathCommitAfterFailureChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, child_cursor_package,
              child_kind_authority, _, _, _, _, _
            ) -> match child_kind_authority
              AtomicPathFailureDestinationRejectedAuthority() -> match selected_suffix
                AtomicSelectedPathTracePrefixDonePacked() -> invalid_case()
                AtomicSelectedPathTraceExactDonePacked() -> invalid_case()
                AtomicSelectedPathTraceAcceptedPacked(
                  _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
                  _, _, _, _, _, _, _
                ) -> invalid_case()
                AtomicSelectedPathTraceActivePacked(
                  _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
                  _, _, _, child_skipped_structure,
                  _, _, _
                ) ->
                  let rejected_selected_availability = atomic_path_skipped_prefix_rejected_selected_pair_availability(
                    child_skipped_structure
                  )
                  let selected_child_cursor = atomic_path_skipped_prefix_cursor_shaped_existential_package(
                    child_skipped_structure
                  )
                  match selected_child_cursor
                    AtomicPathSkippedPrefixCursorExistentialPacked(
                      selected_child_shape, selected_child_payload
                    ) -> match atomic_path_active_child_shape_alignment_package(
                        package,
                        selected_child_payload,
                        lookaround_admitted_cursor_suffix_package_shape(
                          child_cursor_package
                        ),
                        selected_child_shape
                      )
                      AtomicPathActiveChildShapeAlignmentHerePacked(branch) -> match branch
                        AtomicPathActiveChildShapeHerePacked(failure, selected) ->
                          here_case(
                          AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(
                            failure,
                            selected,
                            rejected_selected_availability
                          )
                        )
                      AtomicPathActiveChildShapeAlignmentTherePacked(branch) -> match branch
                        AtomicPathActiveChildShapeTherePacked(failure, selected, authority) ->
                          there_case(
                          AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePacked(
                            failure,
                            selected,
                            authority,
                            rejected_selected_availability
                          )
                        )
                      AtomicPathActiveChildShapeAlignmentReversePacked(branch) -> match branch
                        AtomicPathActiveChildShapeReversePacked(failure, selected, authority) ->
                          reverse_case(
                          AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePacked(
                            failure,
                            selected,
                            authority,
                            rejected_selected_availability
                          )
                        )
              AtomicPathFailureInputExhaustedAuthority() -> invalid_case()
              AtomicPathFailureExactAcceptedAuthority() -> invalid_case()
              AtomicPathFailureDestinationsExhaustedAuthority() -> invalid_case()
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        invalid_case()

  ## Terminal classification has already removed the three local child
  ## terminal kinds before this fold is entered. Descend the relevant selected
  ## skipped-prefix spine to its exact empty tail, retain that correlated
  ## package across child-kind dispatch, and expose only destination rejection
  ## to the recursive consumer. Any inconsistent terminal or commit
  ## classification remains an explicit impossible obligation.
  fn atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(after_failure_empty) ->
            atomic_path_recursive_commit_selected_child_same_after_failure_empty_kind_dispatch(
              after_failure_empty,
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(destination_rejected) ->
                atomic_path_recursive_commit_selected_child_same_destination_rejected_alignment_fold(
                  destination_rejected,
                  here_case,
                  there_case,
                  reverse_case,
                  invalid_case
                ),
              invalid_case
            ),
          fn(_) -> invalid_case(),
          invalid_case
        )
    )

  ## PastRejected carries a recursive sibling commit, but its selected prefix
  ## may still expose any of the four relevant constructors. Consume that
  ## prefix structurally before projecting the sibling: the callback receives
  ## one exact empty authority, while AfterFailure and malformed propagated
  ## classifications remain explicit invalid obligations.
  fn atomic_path_recursive_commit_selected_child_same_past_rejected_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    past_rejected_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(_) -> invalid_case(),
          fn(past_rejected) ->
            atomic_path_recursive_commit_selected_child_same_past_rejected_reverse_fold(
              past_rejected,
              past_rejected_case,
              invalid_case
            ),
          invalid_case
        )
    )

  ## Select the structurally forced reverse branch before exposing it to the
  ## common induction. The relevant PastRejected tag and the original Same
  ## shape authority are both opened locally; erased cursor equalities never
  ## choose a continuation.
  fn atomic_path_recursive_commit_selected_child_same_past_rejected_reverse_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    empty: AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPackage(
      depth, n, machine
    ),
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match empty
    AtomicPathRecursiveCommitSelectedChildSameSkippedEmptyPacked(
      commit, _, _, _, _, source
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) -> match source
        AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
          _, _, _, _, same_authority
        ) -> match atomic_path_cursor_shapes_advance_left_after(same_authority)
          AtomicPathCursorShapesLeftAfterHere() ->
            reverse_case(
              AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePacked(empty)
            )
          AtomicPathCursorShapesLeftAfterDrop(_) ->
            reverse_case(
              AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePacked(empty)
            )
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(_) ->
        invalid_case()
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(_) ->
        invalid_case()















































































































































  ## Wire a blocked public root certificate into the selected-trace root
  ## consumer. Commitment and allowance evidence remain erased indices; the
  ## canonical blocked-root bridge owns the `Here`/`There` fold and receives a
  ## proof-only continuation for the later sibling.
  @reducible
  fn atomic_start_refutation_blocked_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    candidate: LookaroundAdmittedState(n),
    remaining: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(candidate, remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_blocked_excludes_trace(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    candidate,
    failure,
    evidence,
    skip,
    allowed,
    membership,
    path,
    sibling_tail_case
  )



  ## Wire the concrete accepted-root contradiction into the public
  ## selected-trace consumer. Accepted roots consume a non-empty exact child
  ## input, so the package carries the child refutation and cursor suffix that
  ## the exact-child eliminator needs. The root wrapper, package, failure,
  ## evidence, witness, membership, and selected trace all share one indexed
  ## accepted-head spine.
  @reducible
  fn atomic_start_refutation_rejected_accepted_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartAcceptedRejectedTailPackage(
      depth,
      n,
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      child_whole,
      child_current
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let head_case: Empty = atomic_start_rejected_member_there_nonempty_tail_accepted_excludes_trace(
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      package,
      membership,
      path,
      selected_path,
      sibling_tail_case
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      _refutation,
      failure,
      evidence,
      witness,
      membership,
      selected_path,
      head_case,
      sibling_tail_case
    )































  ## Recurse over an arbitrary sibling tail before consuming the selected
  ## active child.  The selected-tail cursor is the induction index; the
  ## generic fold keeps each existential tail failure at its construction
  ## site and hands the adjacent selected candidate to the base consumer.
  @reducible
  fn atomic_path_tail_active_child_rejection_excludes_selected_suffix(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased head: LookaroundAdmittedState(n)},
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_current: List(LookaroundAdmittedState(n)),
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      AtomicPathFailureDestinationRejected()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_head: LookaroundAdmittedState(n),
    child_failure_tail: List(LookaroundAdmittedState(n)),
    child_failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      Cons(child_failure_head, child_failure_tail)
    ),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    {child_selected_current: List(LookaroundAdmittedState(n))},
    child_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    child_left_case: () -> Empty,
    child_left_tail_case: () -> Empty,
    child_right_case: () -> Empty
  ) -> Empty = atomic_path_rejected_tail_fold_to_active(
    machine,
    char,
    child_char,
    child_rest,
    after_input,
    source,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    tail_failure,
    active_state,
    active_routine,
    active_constraints,
    active_assertion_routine,
    active_assertion_markers,
    active_nested_decisions,
    child_whole,
    child_current,
    child_failure,
    child_suffix,
    child_failure_suffix,
    child_failure_head,
    child_failure_tail,
    child_failure_nonempty_equivalence,
    child_failure_origin,
    child_failure_origin_equivalence,
    child_failure_origin_canonical,
    child_selected_origin,
    child_selected_origin_canonical,
    child_selected_suffix,
    child_path,
    selected_remaining,
    _tail_selected_suffix,
    path,
    child_left_case,
    child_left_tail_case,
    child_right_case
