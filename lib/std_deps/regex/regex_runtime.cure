  ## Lookaround child evaluation reuses the checked Thompson machine and has a
  ## context-aware, finite search loop. A satisfied lookahead retains both the
  ## erased finite path and the selected atomic routine, so assertion-local
  ## captures consume the same decision instead of traversing the child twice.
  fn lookaround_child_lookahead(depth: Nat, n: Nat, machine: PatternMachine(n), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaheadDecision(n, machine) = match depth
    Z() -> LookaheadResourceExhausted(depth, remaining, history, policy, LookaroundExhausted([], MachineStateMembersNil(), ()))
    S(rest_depth) -> match boundary
      Boundary(_, _, _, _, _, _, _, _, _, _) ->
        match lookaround_prefix_search_decision(
          rest_depth,
          n,
          machine,
          lookahead_initial_position(boundary),
          remaining,
          [],
          history,
          capture_context,
          policy
        )
          LookaheadSatisfied(path) -> LookaheadSatisfied(path)
          LookaheadRefuted(certificate) -> LookaheadRefuted(certificate)
          LookaheadResourceExhausted(child_depth, input, child_history, child_policy, exhaustion) -> LookaheadResourceExhausted(child_depth, input, child_history, child_policy, exhaustion)

  fn lookaround_child_lookbehind(depth: Nat, n: Nat, machine: PatternMachine(n), width: Nat, boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookbehindDecision(n, machine) = match depth
    Z() -> LookbehindResourceExhausted(depth, [], history, policy, LookaroundExhausted([], MachineStateMembersNil(), ()))
    S(rest_depth) -> match boundary
      Boundary(_, _, _, _, _, _, _, _, _, _) -> match lookbehind_window(history, width)
        None() -> LookbehindRefuted(LookbehindHistoryUnavailable(width, history, policy, LookaroundExhausted([], MachineStateMembersNil(), ())))
        Some(window) -> match lookaround_search_decision(
          rest_depth,
          n,
          machine,
          lookbehind_initial_position(boundary, history, width, policy),
          window,
          remaining,
          [],
          capture_context,
          policy
        )
          LookbehindSatisfied(path) -> LookbehindSatisfied(path)
          LookbehindRefuted(certificate) -> LookbehindRefuted(certificate)
          LookbehindResourceExhausted(child_depth, input, child_history, child_policy, exhaustion) -> LookbehindResourceExhausted(child_depth, input, child_history, child_policy, exhaustion)









  fn lookaround_exact_filtered_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  fn lookaround_machine_acceptance_path(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundSearchResult(depth, n, machine, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy), input, after_input, history, policy, capture_context) =
    lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy))

  fn lookaround_machine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = atomic_lookaround_accepts(depth, n, machine, position, input, after_input, history, capture_context, policy)

  fn lookaround_prefix_machine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = match machine
    MkPatternMachine(starts, _) -> match lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy))
      LookaroundPrefixSearchResultRejected(_) -> false
      LookaroundPrefixSearchResultFound(_) -> true

  ## Assertion operands are validated as depth-bounded before emission. Their
  ## child machine can therefore recurse only through the explicit finite fuel;
  ## using this separate filter keeps Boolean child evaluation outside the
  ## parent constraint evaluator's ordinary totality SCC.
  type LookaroundConstraintAdmission =
    | LookaroundConstraintAdmitted(List(ExtendedInstruction), List(EvidenceInstruction), List(LookaroundNestedDecision))

  type LookaroundAdmittedState(n: Nat) indices ()
    LookaroundAdmittedActive : Bounded(n) -> List(EvidenceInstruction) -> List(BoundaryConstraint) -> List(ExtendedInstruction) -> List(EvidenceInstruction) -> List(LookaroundNestedDecision) -> LookaroundAdmittedState(n)
    LookaroundAdmittedAccepted : List(EvidenceInstruction) -> List(BoundaryConstraint) -> List(ExtendedInstruction) -> List(EvidenceInstruction) -> List(LookaroundNestedDecision) -> LookaroundAdmittedState(n)

  @reducible
  fn empty_lookaround_admitted_states(n: Nat) -> List(LookaroundAdmittedState(n)) = []

  @reducible
  fn atomic_admitted_prepend({n: Nat}, prefix: List(LookaroundAdmittedState(n)), tail: List(LookaroundAdmittedState(n))) -> List(LookaroundAdmittedState(n)) = match prefix
    [] -> tail
    [head | rest] -> Cons(head, atomic_admitted_prepend(rest, tail))


  @reducible
  fn empty_lookaround_admitted_cursor_suffix(n: Nat) -> LookaroundAdmittedStateCursorSuffix(n, empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n)) =
    LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n)))

  @reducible
  fn empty_lookaround_admitted_cursor_witness(n: Nat) -> LookaroundAdmittedStateCursorWitness(n, empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n)) =
    LookaroundAdmittedStateCursorWitnessHere()

  type LookaroundAdmittedStateCursor(n: Nat) indices (whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedStateCursorHere : LookaroundAdmittedStateCursor(n, values, values)
    LookaroundAdmittedStateCursorDrop : (@erased head: LookaroundAdmittedState(n)) -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(head, values))) -> LookaroundAdmittedStateCursor(n, whole, values)

  ## A selected candidate list is either the current admitted suffix or a
  ## suffix reached by dropping ordered heads.  This is the lookaround-side
  ## counterpart of `MachineStateCursorSuffix`; it is the relation consumed by
  ## the atomic refutation induction when a path skips a rejected candidate.
  type LookaroundAdmittedStateCursorSuffix(n: Nat) indices (outer: List(LookaroundAdmittedState(n)), inner: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedStateCursorSuffixHere : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), outer, inner)) -> LookaroundAdmittedStateCursorSuffix(n, outer, inner)
    LookaroundAdmittedStateCursorSuffixDrop : (@erased head: LookaroundAdmittedState(n)) -> (suffix: LookaroundAdmittedStateCursorSuffix(n, outer, inner)) -> LookaroundAdmittedStateCursorSuffix(n, Cons(head, outer), inner)

  ## Runtime search results retain only the recursive `Here`/`Drop` shape. The
  ## admitted-state heads and equality witnesses stay erased, while the prior
  ## package remains relevant. Keeping the recursive package—not just a kind
  ## beside wholly erased evidence—lets two cursors from one origin be compared
  ## and return their exact remaining suffix without reconstructing relevant
  ## data from erased proof fields.
  type LookaroundAdmittedStateCursorSuffixPackage(n: Nat) indices (outer: List(LookaroundAdmittedState(n)), inner: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedStateCursorSuffixHerePacked : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), outer, inner)) -> LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner)
    LookaroundAdmittedStateCursorSuffixDropPacked : (@erased head: LookaroundAdmittedState(n)) -> (prior: LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner)) -> LookaroundAdmittedStateCursorSuffixPackage(n, Cons(head, outer), inner)

  @reducible
  fn lookaround_admitted_cursor_suffix_package_here(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    @erased equality: Equivalent(List(LookaroundAdmittedState(n)), outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner) =
    LookaroundAdmittedStateCursorSuffixHerePacked(equality)

  @reducible
  fn lookaround_admitted_cursor_suffix_package_drop(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    @erased head: LookaroundAdmittedState(n),
    package: LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, Cons(head, outer), inner) =
    LookaroundAdmittedStateCursorSuffixDropPacked(head, package)

  ## Publish an existing relevant suffix through the constructor-correlated
  ## package representation. Recursive strict-cursor proofs use this bridge
  ## once, then advance the package without inspecting erased evidence.
  @reducible
  fn lookaround_admitted_cursor_suffix_package(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner) = match suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) ->
      lookaround_admitted_cursor_suffix_package_here(equality)
    LookaroundAdmittedStateCursorSuffixDrop(head, prior) ->
      lookaround_admitted_cursor_suffix_package_drop(
        head,
        lookaround_admitted_cursor_suffix_package(prior)
      )

  ## Recover the erased indexed suffix represented by a relevant runtime
  ## package. This is the inverse observation used at proof boundaries: the
  ## package shape may be inspected, but every head and equality remains
  ## erased in the reconstructed witness.
  @reducible
  fn lookaround_admitted_cursor_suffix_package_evidence(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    package: LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffix(n, outer, inner) = match package
    LookaroundAdmittedStateCursorSuffixHerePacked(equality) ->
      LookaroundAdmittedStateCursorSuffixHere(equality)
    LookaroundAdmittedStateCursorSuffixDropPacked(head, prior) ->
      LookaroundAdmittedStateCursorSuffixDrop(
        head,
        lookaround_admitted_cursor_suffix_package_evidence(prior)
      )

  ## Advance the inner cursor by one candidate while preserving its original
  ## outer spine. `Here` creates the first drop; an existing drop recurses into
  ## its retained prior package and rebuilds the same finite shape.
  @reducible
  fn lookaround_admitted_cursor_suffix_package_advance(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    @erased head: LookaroundAdmittedState(n),
    @erased tail: List(LookaroundAdmittedState(n)),
    package: LookaroundAdmittedStateCursorSuffixPackage(n, outer, Cons(head, tail))
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, outer, tail) = match package
    LookaroundAdmittedStateCursorSuffixHerePacked(equality) -> match equality
      reflexive() -> LookaroundAdmittedStateCursorSuffixDropPacked(
        head,
        LookaroundAdmittedStateCursorSuffixHerePacked(reflexive(tail))
      )
    LookaroundAdmittedStateCursorSuffixDropPacked(dropped, prior) ->
      LookaroundAdmittedStateCursorSuffixDropPacked(
        dropped,
        lookaround_admitted_cursor_suffix_package_advance(head, tail, prior)
      )



  ## The runtime shape is an index of this constructor-correlated cursor
  ## package. Unlike a parallel `(shape, package)` pair, its type makes a
  ## mismatched depth unrepresentable.
  type LookaroundAdmittedStateCursorShapedPackage(n: Nat) indices (outer: List(LookaroundAdmittedState(n)), inner: List(LookaroundAdmittedState(n)), shape: LookaroundAdmittedStateCursorShape)
    LookaroundAdmittedStateCursorHereShapedPacked : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), outer, inner)) -> LookaroundAdmittedStateCursorShapedPackage(n, outer, inner, LookaroundAdmittedStateCursorShapeHere())
    LookaroundAdmittedStateCursorDropShapedPacked : (@erased head: LookaroundAdmittedState(n)) -> (prior: LookaroundAdmittedStateCursorShapedPackage(n, outer, inner, shape)) -> LookaroundAdmittedStateCursorShapedPackage(n, Cons(head, outer), inner, LookaroundAdmittedStateCursorShapeDrop(shape))

  type AtomicPathCursorShapesSameAuthority indices (left: LookaroundAdmittedStateCursorShape, right: LookaroundAdmittedStateCursorShape)
    AtomicPathCursorShapesSameHere : AtomicPathCursorShapesSameAuthority(LookaroundAdmittedStateCursorShapeHere(), LookaroundAdmittedStateCursorShapeHere())
    AtomicPathCursorShapesSameDrop : (prior: AtomicPathCursorShapesSameAuthority(left, right)) -> AtomicPathCursorShapesSameAuthority(LookaroundAdmittedStateCursorShapeDrop(left), LookaroundAdmittedStateCursorShapeDrop(right))

  type AtomicPathCursorShapesLeftAfterAuthority indices (left: LookaroundAdmittedStateCursorShape, right: LookaroundAdmittedStateCursorShape)
    AtomicPathCursorShapesLeftAfterHere : AtomicPathCursorShapesLeftAfterAuthority(LookaroundAdmittedStateCursorShapeDrop(left), LookaroundAdmittedStateCursorShapeHere())
    AtomicPathCursorShapesLeftAfterDrop : (prior: AtomicPathCursorShapesLeftAfterAuthority(left, right)) -> AtomicPathCursorShapesLeftAfterAuthority(LookaroundAdmittedStateCursorShapeDrop(left), LookaroundAdmittedStateCursorShapeDrop(right))

  type AtomicPathCursorShapesRightAfterAuthority indices (left: LookaroundAdmittedStateCursorShape, right: LookaroundAdmittedStateCursorShape)
    AtomicPathCursorShapesRightAfterHere : AtomicPathCursorShapesRightAfterAuthority(LookaroundAdmittedStateCursorShapeHere(), LookaroundAdmittedStateCursorShapeDrop(right))
    AtomicPathCursorShapesRightAfterDrop : (prior: AtomicPathCursorShapesRightAfterAuthority(left, right)) -> AtomicPathCursorShapesRightAfterAuthority(LookaroundAdmittedStateCursorShapeDrop(left), LookaroundAdmittedStateCursorShapeDrop(right))

  type AtomicPathCursorShapeComparison indices (left: LookaroundAdmittedStateCursorShape, right: LookaroundAdmittedStateCursorShape)
    AtomicPathCursorShapeComparisonSame : (authority: AtomicPathCursorShapesSameAuthority(left, right)) -> AtomicPathCursorShapeComparison(left, right)
    AtomicPathCursorShapeComparisonLeftAfter : (authority: AtomicPathCursorShapesLeftAfterAuthority(left, right)) -> AtomicPathCursorShapeComparison(left, right)
    AtomicPathCursorShapeComparisonRightAfter : (authority: AtomicPathCursorShapesRightAfterAuthority(left, right)) -> AtomicPathCursorShapeComparison(left, right)

  ## Advancing the left cursor by one sibling is strictly after any cursor
  ## whose shape was previously equal to it. This proof is structural in the
  ## shared unary depth and is the canonical direction theorem used when a
  ## PastRejected commit projects its retained tail.
  @reducible
  fn atomic_path_cursor_shapes_advance_left_after(
    {left: LookaroundAdmittedStateCursorShape},
    {right: LookaroundAdmittedStateCursorShape},
    same: AtomicPathCursorShapesSameAuthority(left, right)
  ) -> AtomicPathCursorShapesLeftAfterAuthority(
    LookaroundAdmittedStateCursorShapeDrop(left), right
  ) = match same
    AtomicPathCursorShapesSameHere() ->
      AtomicPathCursorShapesLeftAfterHere()
    AtomicPathCursorShapesSameDrop(prior) ->
      AtomicPathCursorShapesLeftAfterDrop(
        atomic_path_cursor_shapes_advance_left_after(prior)
      )

  fn atomic_path_cursor_shape_comparison(
    left: LookaroundAdmittedStateCursorShape,
    right: LookaroundAdmittedStateCursorShape
  ) -> AtomicPathCursorShapeComparison(left, right) = match left
    LookaroundAdmittedStateCursorShapeHere() -> match right
      LookaroundAdmittedStateCursorShapeHere() ->
        AtomicPathCursorShapeComparisonSame(AtomicPathCursorShapesSameHere())
      LookaroundAdmittedStateCursorShapeDrop(_) ->
        AtomicPathCursorShapeComparisonRightAfter(AtomicPathCursorShapesRightAfterHere())
    LookaroundAdmittedStateCursorShapeDrop(left_prior) -> match right
      LookaroundAdmittedStateCursorShapeHere() ->
        AtomicPathCursorShapeComparisonLeftAfter(AtomicPathCursorShapesLeftAfterHere())
      LookaroundAdmittedStateCursorShapeDrop(right_prior) -> match atomic_path_cursor_shape_comparison(left_prior, right_prior)
        AtomicPathCursorShapeComparisonSame(authority) ->
          AtomicPathCursorShapeComparisonSame(AtomicPathCursorShapesSameDrop(authority))
        AtomicPathCursorShapeComparisonLeftAfter(authority) ->
          AtomicPathCursorShapeComparisonLeftAfter(AtomicPathCursorShapesLeftAfterDrop(authority))
        AtomicPathCursorShapeComparisonRightAfter(authority) ->
          AtomicPathCursorShapeComparisonRightAfter(AtomicPathCursorShapesRightAfterDrop(authority))

  ## Active-child alignment at the runtime boundary is a property of cursor
  ## depth, not of erased canonical-origin certificates. Equal `Here` shapes
  ## select the rejected head; equal non-Here shapes and a deeper selected
  ## shape select a later sibling; a deeper failure shape selects reverse.
  type AtomicPathActiveChildShapeThereAuthority indices (failure_shape: LookaroundAdmittedStateCursorShape, selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildShapeThereSameDrop : (prior: AtomicPathCursorShapesSameAuthority(failure_prior, selected_prior)) -> AtomicPathActiveChildShapeThereAuthority(LookaroundAdmittedStateCursorShapeDrop(failure_prior), LookaroundAdmittedStateCursorShapeDrop(selected_prior))
    AtomicPathActiveChildShapeThereRightAfter : (authority: AtomicPathCursorShapesRightAfterAuthority(failure_shape, selected_shape)) -> AtomicPathActiveChildShapeThereAuthority(failure_shape, selected_shape)

  type AtomicPathActiveChildShapeAlignmentAuthority indices (failure_shape: LookaroundAdmittedStateCursorShape, selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildShapeHereAuthority : AtomicPathActiveChildShapeAlignmentAuthority(LookaroundAdmittedStateCursorShapeHere(), LookaroundAdmittedStateCursorShapeHere())
    AtomicPathActiveChildShapeThereAuthorityPacked : (authority: AtomicPathActiveChildShapeThereAuthority(failure_shape, selected_shape)) -> AtomicPathActiveChildShapeAlignmentAuthority(failure_shape, selected_shape)
    AtomicPathActiveChildShapeReverseAuthority : (authority: AtomicPathCursorShapesLeftAfterAuthority(failure_shape, selected_shape)) -> AtomicPathActiveChildShapeAlignmentAuthority(failure_shape, selected_shape)

  @reducible
  fn atomic_path_active_child_shape_alignment_authority(
    failure_shape: LookaroundAdmittedStateCursorShape,
    selected_shape: LookaroundAdmittedStateCursorShape
  ) -> AtomicPathActiveChildShapeAlignmentAuthority(
    failure_shape, selected_shape
  ) = match atomic_path_cursor_shape_comparison(failure_shape, selected_shape)
    AtomicPathCursorShapeComparisonSame(authority) -> match failure_shape
      LookaroundAdmittedStateCursorShapeHere() -> match authority
        AtomicPathCursorShapesSameHere() ->
          AtomicPathActiveChildShapeHereAuthority()
      LookaroundAdmittedStateCursorShapeDrop(_) -> match authority
        AtomicPathCursorShapesSameDrop(prior) ->
          AtomicPathActiveChildShapeThereAuthorityPacked(
            AtomicPathActiveChildShapeThereSameDrop(prior)
          )
    AtomicPathCursorShapeComparisonLeftAfter(authority) ->
      AtomicPathActiveChildShapeReverseAuthority(authority)
    AtomicPathCursorShapeComparisonRightAfter(authority) ->
      AtomicPathActiveChildShapeThereAuthorityPacked(
        AtomicPathActiveChildShapeThereRightAfter(authority)
      )

  type AtomicPathActiveChildShapeHerePackage(failure_package: Type, selected_package: Type) indices (failure_shape: LookaroundAdmittedStateCursorShape, selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildShapeHerePacked : (failure: failure_package) -> (selected: selected_package) -> AtomicPathActiveChildShapeHerePackage(failure_package, selected_package, LookaroundAdmittedStateCursorShapeHere(), LookaroundAdmittedStateCursorShapeHere())

  type AtomicPathActiveChildShapeTherePackage(failure_package: Type, selected_package: Type) indices (failure_shape: LookaroundAdmittedStateCursorShape, selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildShapeTherePacked : (failure: failure_package) -> (selected: selected_package) -> (authority: AtomicPathActiveChildShapeThereAuthority(failure_shape, selected_shape)) -> AtomicPathActiveChildShapeTherePackage(failure_package, selected_package, failure_shape, selected_shape)

  type AtomicPathActiveChildShapeReversePackage(failure_package: Type, selected_package: Type) indices (failure_shape: LookaroundAdmittedStateCursorShape, selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildShapeReversePacked : (failure: failure_package) -> (selected: selected_package) -> (authority: AtomicPathCursorShapesLeftAfterAuthority(failure_shape, selected_shape)) -> AtomicPathActiveChildShapeReversePackage(failure_package, selected_package, failure_shape, selected_shape)

  type AtomicPathActiveChildShapeAlignmentPackage(failure_package: Type, selected_package: Type) indices (failure_shape: LookaroundAdmittedStateCursorShape, selected_shape: LookaroundAdmittedStateCursorShape)
    AtomicPathActiveChildShapeAlignmentHerePacked : (branch: AtomicPathActiveChildShapeHerePackage(failure_package, selected_package, failure_shape, selected_shape)) -> AtomicPathActiveChildShapeAlignmentPackage(failure_package, selected_package, failure_shape, selected_shape)
    AtomicPathActiveChildShapeAlignmentTherePacked : (branch: AtomicPathActiveChildShapeTherePackage(failure_package, selected_package, failure_shape, selected_shape)) -> AtomicPathActiveChildShapeAlignmentPackage(failure_package, selected_package, failure_shape, selected_shape)
    AtomicPathActiveChildShapeAlignmentReversePacked : (branch: AtomicPathActiveChildShapeReversePackage(failure_package, selected_package, failure_shape, selected_shape)) -> AtomicPathActiveChildShapeAlignmentPackage(failure_package, selected_package, failure_shape, selected_shape)

  @reducible
  fn atomic_path_active_child_shape_alignment_package(
    {failure_package: Type}, {selected_package: Type},
    failure: failure_package,
    selected: selected_package,
    failure_shape: LookaroundAdmittedStateCursorShape,
    selected_shape: LookaroundAdmittedStateCursorShape
  ) -> AtomicPathActiveChildShapeAlignmentPackage(
    failure_package, selected_package, failure_shape, selected_shape
  ) = match atomic_path_active_child_shape_alignment_authority(
    failure_shape, selected_shape
  )
    AtomicPathActiveChildShapeHereAuthority() ->
      AtomicPathActiveChildShapeAlignmentHerePacked(
        AtomicPathActiveChildShapeHerePacked(failure, selected)
      )
    AtomicPathActiveChildShapeThereAuthorityPacked(authority) ->
      AtomicPathActiveChildShapeAlignmentTherePacked(
        AtomicPathActiveChildShapeTherePacked(
          failure,
          selected,
          authority
        )
      )
    AtomicPathActiveChildShapeReverseAuthority(authority) ->
      AtomicPathActiveChildShapeAlignmentReversePacked(
        AtomicPathActiveChildShapeReversePacked(
          failure,
          selected,
          authority
        )
      )

  @reducible
  fn atomic_path_active_child_shape_alignment_package_dispatch(
    {result: Type}, {failure_package: Type}, {selected_package: Type},
    {failure_shape: LookaroundAdmittedStateCursorShape},
    {selected_shape: LookaroundAdmittedStateCursorShape},
    package: AtomicPathActiveChildShapeAlignmentPackage(
      failure_package, selected_package, failure_shape, selected_shape
    ),
    here_case: (AtomicPathActiveChildShapeHerePackage(
      failure_package, selected_package, failure_shape, selected_shape
    )) -> result,
    there_case: (AtomicPathActiveChildShapeTherePackage(
      failure_package, selected_package, failure_shape, selected_shape
    )) -> result,
    reverse_case: (AtomicPathActiveChildShapeReversePackage(
      failure_package, selected_package, failure_shape, selected_shape
    )) -> result
  ) -> result = match package
    AtomicPathActiveChildShapeAlignmentHerePacked(branch) -> here_case(branch)
    AtomicPathActiveChildShapeAlignmentTherePacked(branch) -> there_case(branch)
    AtomicPathActiveChildShapeAlignmentReversePacked(branch) -> reverse_case(branch)

  @reducible
  fn atomic_path_active_child_shape_here_package_fold(
    {result: Type}, {failure_package: Type}, {selected_package: Type},
    {failure_shape: LookaroundAdmittedStateCursorShape},
    {selected_shape: LookaroundAdmittedStateCursorShape},
    package: AtomicPathActiveChildShapeHerePackage(
      failure_package, selected_package, failure_shape, selected_shape
    ),
    case: (failure_package, selected_package) -> result
  ) -> result = match package
    AtomicPathActiveChildShapeHerePacked(failure, selected) ->
      case(failure, selected)

  @reducible
  fn atomic_path_active_child_shape_there_package_fold(
    {result: Type}, {failure_package: Type}, {selected_package: Type},
    {failure_shape: LookaroundAdmittedStateCursorShape},
    {selected_shape: LookaroundAdmittedStateCursorShape},
    package: AtomicPathActiveChildShapeTherePackage(
      failure_package, selected_package, failure_shape, selected_shape
    ),
    case: (
      failure_package,
      selected_package,
      AtomicPathActiveChildShapeThereAuthority(failure_shape, selected_shape)
    ) -> result
  ) -> result = match package
    AtomicPathActiveChildShapeTherePacked(failure, selected, authority) ->
      case(failure, selected, authority)

  @reducible
  fn atomic_path_active_child_shape_reverse_package_fold(
    {result: Type}, {failure_package: Type}, {selected_package: Type},
    {failure_shape: LookaroundAdmittedStateCursorShape},
    {selected_shape: LookaroundAdmittedStateCursorShape},
    package: AtomicPathActiveChildShapeReversePackage(
      failure_package, selected_package, failure_shape, selected_shape
    ),
    case: (
      failure_package,
      selected_package,
      AtomicPathCursorShapesLeftAfterAuthority(failure_shape, selected_shape)
    ) -> result
  ) -> result = match package
    AtomicPathActiveChildShapeReversePacked(failure, selected, authority) ->
      case(failure, selected, authority)

  fn atomic_path_cursor_shape_comparison_location(
    {left: LookaroundAdmittedStateCursorShape},
    {right: LookaroundAdmittedStateCursorShape},
    comparison: AtomicPathCursorShapeComparison(left, right)
  ) -> AtomicPathCursorShapeLocation = match comparison
    AtomicPathCursorShapeComparisonSame(_) -> AtomicPathCursorShapeSame()
    AtomicPathCursorShapeComparisonLeftAfter(_) -> AtomicPathCursorShapeLeftAfter()
    AtomicPathCursorShapeComparisonRightAfter(_) -> AtomicPathCursorShapeRightAfter()

  type LookaroundAdmittedCursorInnerEquivalentAuthority(n: Nat) indices (left: List(LookaroundAdmittedState(n)), right: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedCursorInnerEquivalentPacked : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), left, right)) -> LookaroundAdmittedCursorInnerEquivalentAuthority(n, left, right)

  ## A structural Same comparison is useful as proof authority only after
  ## both shapes have been checked against their exact cursor packages.  With
  ## the outer origins aligned, equal Here/Drop spines force the two hidden
  ## inner cursors to be equal as well.
  @reducible
  local fn lookaround_admitted_cursor_same_shape_inner_equivalent(
    {n: Nat},
    {@erased left_outer: List(LookaroundAdmittedState(n))},
    {@erased left_inner: List(LookaroundAdmittedState(n))},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    {left_shape: LookaroundAdmittedStateCursorShape},
    {right_shape: LookaroundAdmittedStateCursorShape},
    left_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, left_outer, left_inner, left_shape
    ),
    right_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, right_outer, right_inner, right_shape
    ),
    same_authority: AtomicPathCursorShapesSameAuthority(
      left_shape, right_shape
    ),
    @erased outer_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)), left_outer, right_outer
    )
  ) -> LookaroundAdmittedCursorInnerEquivalentAuthority(
    n, left_inner, right_inner
  ) = match same_authority
    AtomicPathCursorShapesSameHere() -> match left_cursor
      LookaroundAdmittedStateCursorHereShapedPacked(left_equality) -> match right_cursor
        LookaroundAdmittedStateCursorHereShapedPacked(right_equality) ->
          LookaroundAdmittedCursorInnerEquivalentPacked(
            trans(sym(left_equality), trans(outer_equivalence, right_equality))
          )
    AtomicPathCursorShapesSameDrop(prior) -> match left_cursor
      LookaroundAdmittedStateCursorDropShapedPacked(_, left_prior) -> match right_cursor
        LookaroundAdmittedStateCursorDropShapedPacked(_, right_prior) -> match outer_equivalence
          reflexive() -> lookaround_admitted_cursor_same_shape_inner_equivalent(
              left_prior,
              right_prior,
              prior,
              reflexive()
            )

  fn lookaround_admitted_cursor_suffix_package_shape(
    {@erased n: Nat},
    {@erased outer: List(LookaroundAdmittedState(n))},
    {@erased inner: List(LookaroundAdmittedState(n))},
    package: LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorShape = match package
    LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
      LookaroundAdmittedStateCursorShapeHere()
    LookaroundAdmittedStateCursorSuffixDropPacked(_, prior) ->
      LookaroundAdmittedStateCursorShapeDrop(
        lookaround_admitted_cursor_suffix_package_shape(prior)
      )

  @reducible
  fn lookaround_admitted_cursor_shaped_package(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    package: LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorShapedPackage(
    n,
    outer,
    inner,
    lookaround_admitted_cursor_suffix_package_shape(package)
  ) = match package
    LookaroundAdmittedStateCursorSuffixHerePacked(equality) ->
      LookaroundAdmittedStateCursorHereShapedPacked(equality)
    LookaroundAdmittedStateCursorSuffixDropPacked(head, prior) ->
      LookaroundAdmittedStateCursorDropShapedPacked(
        head,
        lookaround_admitted_cursor_shaped_package(prior)
      )

  fn atomic_path_cursor_shape_package_location(
    left: LookaroundAdmittedStateCursorShape,
    {@erased n: Nat},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    right: LookaroundAdmittedStateCursorSuffixPackage(
      n, right_outer, right_inner
    )
  ) -> AtomicPathCursorShapeLocation = match left
    LookaroundAdmittedStateCursorShapeHere() -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeSame()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, _) ->
        AtomicPathCursorShapeRightAfter()
    LookaroundAdmittedStateCursorShapeDrop(left_prior) -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeLeftAfter()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, right_prior) ->
        atomic_path_cursor_shape_package_location(left_prior, right_prior)

  fn atomic_path_cursor_shapes_location(
    left: LookaroundAdmittedStateCursorShape,
    right: LookaroundAdmittedStateCursorShape
  ) -> AtomicPathCursorShapeLocation =
    atomic_path_cursor_shape_comparison_location(
      atomic_path_cursor_shape_comparison(left, right)
    )

  fn atomic_path_cursor_shape_location(
    {@erased n: Nat},
    {@erased left_outer: List(LookaroundAdmittedState(n))},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased left_inner: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    left: LookaroundAdmittedStateCursorSuffixPackage(
      n, left_outer, left_inner
    ),
    right: LookaroundAdmittedStateCursorSuffixPackage(
      n, right_outer, right_inner
    )
  ) -> AtomicPathCursorShapeLocation = match left
    LookaroundAdmittedStateCursorSuffixHerePacked(_) -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeSame()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, _) ->
        AtomicPathCursorShapeRightAfter()
    LookaroundAdmittedStateCursorSuffixDropPacked(_, left_prior) -> match right
      LookaroundAdmittedStateCursorSuffixHerePacked(_) ->
        AtomicPathCursorShapeLeftAfter()
      LookaroundAdmittedStateCursorSuffixDropPacked(_, right_prior) ->
        atomic_path_cursor_shape_location(left_prior, right_prior)

  ## A non-empty cursor current proves that its whole spine is non-empty too.
  ## Keep the decomposition existential and erased: callers need the
  ## construction-site equality to refine a rejected child, but no runtime
  ## representation of the chosen head or tail is allowed to escape.
  type LookaroundAdmittedNonempty(n: Nat) indices (whole: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedNonemptyPacked : (@erased head: LookaroundAdmittedState(n)) -> (@erased tail: List(LookaroundAdmittedState(n))) -> (@erased equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, Cons(head, tail))) -> LookaroundAdmittedNonempty(n, whole)

  ## Transport a non-empty decomposition backwards through an ordered cursor
  ## suffix.  The `Here` case consumes the suffix equality; each `Drop` case
  ## prepends the dropped head with the canonical cons congruence.  This is the
  ## sole authority for deriving `whole = head :: tail` from a non-empty
  ## cursor, so active-child proofs never manufacture that equality locally.
  @reducible
  fn lookaround_admitted_cursor_suffix_nonempty(
    {n: Nat},
    {whole: List(LookaroundAdmittedState(n))},
    {head: LookaroundAdmittedState(n)},
    {tail: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Cons(head, tail))
  ) -> LookaroundAdmittedNonempty(n, whole) = match suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> LookaroundAdmittedNonemptyPacked(head, tail, reflexive(Cons(head, tail)))
    LookaroundAdmittedStateCursorSuffixDrop(dropped, prior) -> match lookaround_admitted_cursor_suffix_nonempty(prior)
      LookaroundAdmittedNonemptyPacked(prior_head, prior_tail, prior_equivalence) -> LookaroundAdmittedNonemptyPacked(
        dropped,
        Cons(prior_head, prior_tail),
        lookaround_admitted_state_cons_equivalent(dropped, prior_equivalence)
      )

  ## A selected child suffix is either still at the rejected head or has
  ## dropped into its sibling tail.  Keeping that split indexed lets the
  ## recursive proof choose the child contradiction without inspecting an
  ## erased list at runtime.
  type AtomicPathSelectedChildLocation(n: Nat) indices (head: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathSelectedChildHere : (@erased head: LookaroundAdmittedState(n)) -> (@erased rest: List(LookaroundAdmittedState(n))) -> AtomicPathSelectedChildLocation(n, head, rest, Cons(head, rest))
    AtomicPathSelectedChildThere : (@erased head: LookaroundAdmittedState(n)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, rest, current)) -> AtomicPathSelectedChildLocation(n, head, rest, current)

  @reducible
  fn atomic_path_selected_child_suffix_location(
    {n: Nat},
    {head: LookaroundAdmittedState(n)},
    {rest: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), current)
  ) -> AtomicPathSelectedChildLocation(n, head, rest, current) = match suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> AtomicPathSelectedChildHere(head, rest)
    LookaroundAdmittedStateCursorSuffixDrop(_, prior) -> AtomicPathSelectedChildThere(head, prior)

  ## Consume the selected-child location without making the erased location
  ## witness a runtime callback argument.  The suffix itself is relevant at
  ## this construction site, so only its indexed `Here`/`There` shape drives
  ## the proof-only continuations.
  @reducible
  fn atomic_path_selected_child_suffix_location_elim(
    {result: Type},
    {n: Nat},
    {head: LookaroundAdmittedState(n)},
    {rest: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), current),
    here_case: () -> result,
    there_case: () -> result
  ) -> result = match atomic_path_selected_child_suffix_location(suffix)
    AtomicPathSelectedChildHere(_, _) -> here_case()
    AtomicPathSelectedChildThere(_, _) -> there_case()

  ## Value form of the same split for callers whose contradiction is already
  ## constructed. Cure does not admit zero-argument lambdas in every dependent
  ## callback context, so this boundary selects between proof values directly
  ## while retaining the cursor as the sole branch authority.
  @reducible
  fn atomic_path_selected_child_suffix_location_select(
    {result: Type},
    {n: Nat},
    {head: LookaroundAdmittedState(n)},
    {rest: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), current),
    here_case: result,
    there_case: result
  ) -> result = match atomic_path_selected_child_suffix_location(suffix)
    AtomicPathSelectedChildHere(_, _) -> here_case
    AtomicPathSelectedChildThere(_, _) -> there_case

  type LookaroundAdmittedStateCursorAlignment(n: Nat) indices (left: List(LookaroundAdmittedState(n)), right: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedCursorLeftToRight : (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, left, right)) -> LookaroundAdmittedStateCursorAlignment(n, left, right)
    LookaroundAdmittedCursorRightToLeft : (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, right, left)) -> LookaroundAdmittedStateCursorAlignment(n, left, right)

  ## A proper suffix records at least one dropped candidate.  Ordinary cursor
  ## suffixes also admit equality, which was too weak for the reverse atomic
  ## branch: after recursive alignment it forgot that the selected cursor was
  ## strictly before the failed cursor.  Retaining the dropped head makes that
  ## ordering available to the skipped-prefix eliminator without a Boolean or
  ## an unchecked list comparison.
  type AtomicPathStrictCursorSuffix(n: Nat) indices (outer: List(LookaroundAdmittedState(n)), inner: List(LookaroundAdmittedState(n)))
    AtomicPathStrictCursorSuffixDrop : (head: LookaroundAdmittedState(n)) -> (tail: List(LookaroundAdmittedState(n))) -> (suffix: LookaroundAdmittedStateCursorSuffix(n, tail, inner)) -> AtomicPathStrictCursorSuffix(n, Cons(head, tail), inner)

  ## Compare two cursors from the same canonical origin. Equality remains an
  ## erased index; directional cases retain only the suffix needed by the
  ## recursive sibling-tail proof.
  type AtomicPathCursorLocation(n: Nat) indices (left: List(LookaroundAdmittedState(n)), right: List(LookaroundAdmittedState(n)))
    AtomicPathCursorLocationSame : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), left, right)) -> AtomicPathCursorLocation(n, left, right)
    AtomicPathCursorLocationLeftAfter : (marker: AtomicPathStrictCursorSuffix(n, right, left)) -> AtomicPathCursorLocation(n, left, right)
    AtomicPathCursorLocationRightAfter : (marker: LookaroundAdmittedStateCursorSuffixPackage(n, left, right)) -> AtomicPathCursorLocation(n, left, right)

  ## Constructor-correlated carrier for strict commit/selection recursion.
  ## The commit payload is instantiated with one relevant existential that
  ## ties an exact erased cause to its structure, plus the relevant cursor
  ## package and exact selected-trace package.
  ## A relevant location tag keeps those values together across recursive
  ## callbacks without projecting anything from the erased cause.
  type AtomicPathCommitSelectedLocationPackage(n: Nat, commit_package: Type, commit_cursor_package: Type, selected_trace_package: Type, selected_skipped_package: Type) indices (commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitSelectedSamePacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), commit_current, selected_current)) -> AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)
    AtomicPathCommitSelectedLeftAfterPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (marker: LookaroundAdmittedStateCursorSuffixPackage(n, selected_current, commit_current)) -> AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)
    AtomicPathCommitSelectedRightAfterPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (marker: LookaroundAdmittedStateCursorSuffixPackage(n, commit_current, selected_current)) -> AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)

  ## One-constructor authorities preserve the branch refinement beyond a
  ## fold callback. Recursive forward traversal cannot manufacture LeftAfter,
  ## so terminal and recursive consumers receive only the case they prove.
  type AtomicPathCommitSelectedSameAuthorityPackage(n: Nat, commit_package: Type, commit_cursor_package: Type, selected_trace_package: Type, selected_skipped_package: Type) indices (commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitSelectedSameAuthorityPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), commit_current, selected_current)) -> AtomicPathCommitSelectedSameAuthorityPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)

  type AtomicPathCommitSelectedRightAuthorityPackage(n: Nat, commit_package: Type, commit_cursor_package: Type, selected_trace_package: Type, selected_skipped_package: Type) indices (commit_current: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)))
    AtomicPathCommitSelectedRightAuthorityPacked : (commit: commit_package) -> (commit_cursor: commit_cursor_package) -> (selected_trace: selected_trace_package) -> (selected_skipped: selected_skipped_package) -> (marker: LookaroundAdmittedStateCursorSuffixPackage(n, commit_current, selected_current)) -> AtomicPathCommitSelectedRightAuthorityPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)

  @reducible
  fn atomic_path_strict_cursor_suffix_package(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    marker: AtomicPathStrictCursorSuffix(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner) = match marker
    AtomicPathStrictCursorSuffixDrop(head, _, suffix) ->
      lookaround_admitted_cursor_suffix_package_drop(
        head,
        lookaround_admitted_cursor_suffix_package(suffix)
      )

  @reducible
  fn atomic_path_commit_selected_location_package(
    {n: Nat}, {commit_package: Type}, {commit_cursor_package: Type},
    {selected_trace_package: Type}, {selected_skipped_package: Type},
    {commit_current: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    commit: commit_package,
    commit_cursor: commit_cursor_package,
    selected_trace: selected_trace_package,
    selected_skipped: selected_skipped_package,
    location: AtomicPathCursorLocation(n, commit_current, selected_current)
  ) -> AtomicPathCommitSelectedLocationPackage(
    n,
    commit_package,
    commit_cursor_package,
    selected_trace_package,
    selected_skipped_package,
    commit_current,
    selected_current
  ) = match location
    AtomicPathCursorLocationSame(equality) -> AtomicPathCommitSelectedSamePacked(
      commit,
      commit_cursor,
      selected_trace,
      selected_skipped,
      equality
    )
    AtomicPathCursorLocationLeftAfter(marker) -> AtomicPathCommitSelectedLeftAfterPacked(
      commit,
      commit_cursor,
      selected_trace,
      selected_skipped,
      atomic_path_strict_cursor_suffix_package(marker)
    )
    AtomicPathCursorLocationRightAfter(marker) -> AtomicPathCommitSelectedRightAfterPacked(
      commit,
      commit_cursor,
      selected_trace,
      selected_skipped,
      marker
    )

  ## Single eliminator for the correlated location carrier. Each continuation
  ## receives the intact package, so recursive consumers choose a branch only
  ## from its relevant constructor and cannot split its correlated payloads.
  @reducible
  fn atomic_path_commit_selected_location_package_fold(
    {result: Type}, {n: Nat}, {commit_package: Type},
    {commit_cursor_package: Type},
    {selected_trace_package: Type},
    {selected_skipped_package: Type},
    {commit_current: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    package: AtomicPathCommitSelectedLocationPackage(
      n,
      commit_package,
      commit_cursor_package,
      selected_trace_package,
      selected_skipped_package,
      commit_current,
      selected_current
    ),
    same_case: (AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)) -> result,
    left_case: (AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)) -> result,
    right_case: (AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)) -> result
  ) -> result = match package
    AtomicPathCommitSelectedSamePacked(_, _, _, _, _) -> same_case(package)
    AtomicPathCommitSelectedLeftAfterPacked(_, _, _, _, _) -> left_case(package)
    AtomicPathCommitSelectedRightAfterPacked(_, _, _, _, _) -> right_case(package)

  @reducible
  fn atomic_path_cursor_location(
    {n: Nat},
    outer: List(LookaroundAdmittedState(n)),
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    left_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, left),
    right_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, right)
  ) -> AtomicPathCursorLocation(n, left, right) = match outer
    Nil() -> match left_suffix
      LookaroundAdmittedStateCursorSuffixHere(left_equality) -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> AtomicPathCursorLocationSame(trans(sym(left_equality), right_equality))
    Cons(outer_head, outer_tail) -> match left_suffix
      LookaroundAdmittedStateCursorSuffixHere(left_equality) -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> AtomicPathCursorLocationSame(trans(sym(left_equality), right_equality))
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> match left_equality
          reflexive() -> AtomicPathCursorLocationRightAfter(
            lookaround_admitted_cursor_suffix_package(right_suffix)
          )
      LookaroundAdmittedStateCursorSuffixDrop(_, left_prior) -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> match right_equality
          reflexive() -> AtomicPathCursorLocationLeftAfter(AtomicPathStrictCursorSuffixDrop(outer_head, outer_tail, left_prior))
        LookaroundAdmittedStateCursorSuffixDrop(_, right_prior) -> atomic_path_cursor_location(outer_tail, left_prior, right_prior)

  ## The active-child induction needs one more distinction than ordinary cursor
  ## alignment: a selected suffix may still be at the rejected head, may have
  ## dropped into its sibling tail, or may precede the failed suffix.  Keep all
  ## three cases in an erased indexed witness so the construction site can
  ## dispatch without inspecting proof data at runtime.
  type AtomicPathActiveChildAlignment(n: Nat) indices (candidate: LookaroundAdmittedState(n), remaining: List(LookaroundAdmittedState(n)), failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentHere : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, Cons(candidate, remaining))) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, Cons(candidate, remaining))
    AtomicPathActiveChildAlignmentThere : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, current)) -> (@erased tail: LookaroundAdmittedStateCursorSuffix(n, remaining, current)) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, current)
    AtomicPathActiveChildAlignmentReverse : {@erased failure_current: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, current, failure_current)) -> AtomicPathActiveChildAlignment(n, candidate, remaining, failure_current, current)

  ## The package-consuming projection deliberately forgets the existential
  ## head and tail values.  They are needed only to refine the erased whole
  ## list; callers dispatch on the resulting location, not on proof payload.
  type AtomicPathActiveChildAlignmentCase(n: Nat) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentCaseHere : AtomicPathActiveChildAlignmentCase(n, failure_current, current)
    AtomicPathActiveChildAlignmentCaseThere : AtomicPathActiveChildAlignmentCase(n, failure_current, current)
    AtomicPathActiveChildAlignmentCaseReverse : AtomicPathActiveChildAlignmentCase(n, failure_current, current)

  ## Evidence-preserving counterpart of the compact alignment case. Branch
  ## consumers that discover their recursive proof data only after canonical
  ## comparison need the exact suffix authority, not a nullary tag whose proof
  ## had to be precomputed outside the construction site.
  type AtomicPathActiveChildAlignmentAuthority(n: Nat) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentHereAuthority : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, Cons(candidate, remaining))) -> AtomicPathActiveChildAlignmentAuthority(n, failure_current, Cons(candidate, remaining))
    AtomicPathActiveChildAlignmentThereAuthority : {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, current)) -> (@erased tail: LookaroundAdmittedStateCursorSuffix(n, remaining, current)) -> AtomicPathActiveChildAlignmentAuthority(n, failure_current, current)
    AtomicPathActiveChildAlignmentReverseAuthority : (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, current, failure_current)) -> AtomicPathActiveChildAlignmentAuthority(n, failure_current, current)

  ## Exact branch packages keep the destination-rejection payload and selected
  ## transition payload correlated with the suffix authority that classified
  ## them.  The payloads remain relevant because the recursive consumer needs
  ## their construction data; cursor proofs remain erased because they only
  ## refine the indexed spines during elaboration.
  type AtomicPathActiveChildAlignmentHerePackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildHerePacked : (failure: failure_package) -> (selected: selected_package) -> {@erased candidate: LookaroundAdmittedState(n)} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, Cons(candidate, remaining))) -> AtomicPathActiveChildAlignmentHerePackage(n, failure_package, selected_package, failure_current, Cons(candidate, remaining))

  type AtomicPathActiveChildAlignmentTherePackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildTherePacked : (failure: failure_package) -> (selected: selected_package) -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, failure_current, current)) -> (@erased tail: LookaroundAdmittedStateCursorSuffix(n, remaining, current)) -> AtomicPathActiveChildAlignmentTherePackage(n, failure_package, selected_package, failure_current, current)

  type AtomicPathActiveChildAlignmentReversePackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildReversePacked : (failure: failure_package) -> (selected: selected_package) -> (@erased alignment: LookaroundAdmittedStateCursorSuffix(n, current, failure_current)) -> AtomicPathActiveChildAlignmentReversePackage(n, failure_package, selected_package, failure_current, current)

  type AtomicPathActiveChildAlignmentPackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentHerePacked : (branch: AtomicPathActiveChildAlignmentHerePackage(n, failure_package, selected_package, failure_current, current)) -> AtomicPathActiveChildAlignmentPackage(n, failure_package, selected_package, failure_current, current)
    AtomicPathActiveChildAlignmentTherePacked : (branch: AtomicPathActiveChildAlignmentTherePackage(n, failure_package, selected_package, failure_current, current)) -> AtomicPathActiveChildAlignmentPackage(n, failure_package, selected_package, failure_current, current)
    AtomicPathActiveChildAlignmentReversePacked : (branch: AtomicPathActiveChildAlignmentReversePackage(n, failure_package, selected_package, failure_current, current)) -> AtomicPathActiveChildAlignmentPackage(n, failure_package, selected_package, failure_current, current)

  @reducible
  fn atomic_path_active_child_alignment_package(
    {n: Nat}, {failure_package: Type}, {selected_package: Type},
    {failure_current: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    failure: failure_package,
    selected: selected_package,
    authority: AtomicPathActiveChildAlignmentAuthority(n, failure_current, current)
  ) -> AtomicPathActiveChildAlignmentPackage(
    n, failure_package, selected_package, failure_current, current
  ) = match authority
    AtomicPathActiveChildAlignmentHereAuthority(alignment) ->
      AtomicPathActiveChildAlignmentHerePacked(
        AtomicPathActiveChildHerePacked(failure, selected, alignment)
      )
    AtomicPathActiveChildAlignmentThereAuthority(alignment, tail) ->
      AtomicPathActiveChildAlignmentTherePacked(
        AtomicPathActiveChildTherePacked(failure, selected, alignment, tail)
      )
    AtomicPathActiveChildAlignmentReverseAuthority(alignment) ->
      AtomicPathActiveChildAlignmentReversePacked(
        AtomicPathActiveChildReversePacked(failure, selected, alignment)
      )

  @reducible
  fn atomic_path_active_child_alignment_package_dispatch(
    {result: Type},
    {n: Nat}, {failure_package: Type}, {selected_package: Type},
    {failure_current: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    package: AtomicPathActiveChildAlignmentPackage(
      n, failure_package, selected_package, failure_current, current
    ),
    here_case: (AtomicPathActiveChildAlignmentHerePackage(
      n, failure_package, selected_package, failure_current, current
    )) -> result,
    there_case: (AtomicPathActiveChildAlignmentTherePackage(
      n, failure_package, selected_package, failure_current, current
    )) -> result,
    reverse_case: (AtomicPathActiveChildAlignmentReversePackage(
      n, failure_package, selected_package, failure_current, current
    )) -> result
  ) -> result = match package
    AtomicPathActiveChildAlignmentHerePacked(branch) -> here_case(branch)
    AtomicPathActiveChildAlignmentTherePacked(branch) -> there_case(branch)
    AtomicPathActiveChildAlignmentReversePacked(branch) -> reverse_case(branch)

  @reducible
  fn atomic_path_active_child_alignment_authority(
    {n: Nat}, {candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    alignment: AtomicPathActiveChildAlignment(
      n, candidate, remaining, failure_current, current
    )
  ) -> AtomicPathActiveChildAlignmentAuthority(
    n, failure_current, current
  ) = match alignment
    AtomicPathActiveChildAlignmentHere(authority) ->
      AtomicPathActiveChildAlignmentHereAuthority(authority)
    AtomicPathActiveChildAlignmentThere(authority, tail) ->
      AtomicPathActiveChildAlignmentThereAuthority(authority, tail)
    AtomicPathActiveChildAlignmentReverse(authority) ->
      AtomicPathActiveChildAlignmentReverseAuthority(authority)

  ## A child search and its selected trace may publish extensionally equal
  ## origin lists through different existential binders. Transporting the
  ## selected suffix across that equality gives both cursors one common outer
  ## spine, which is the prerequisite for the alignment eliminator below.
  fn transport_lookaround_admitted_cursor_suffix_outer(
    {n: Nat},
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    equality: Equivalent(List(LookaroundAdmittedState(n)), left, right),
    suffix: LookaroundAdmittedStateCursorSuffix(n, right, inner)
  ) -> LookaroundAdmittedStateCursorSuffix(n, left, inner) = match equality
    reflexive() -> suffix

  ## Transport the selected child suffix from a path constructor's local
  ## origin to the parent selected origin.  The current spine is deliberately
  ## shared by the two views; a later recursive package will carry a separate
  ## current-spine equality when the child search advances through a sibling.
  ## Keeping this outer transport at one authority prevents callers from
  ## rebuilding or guessing the selected cursor list.
  @reducible
  fn atomic_path_active_child_selection_suffix_transport(
    {n: Nat},
    {selected_whole: List(LookaroundAdmittedState(n))},
    {path_selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      selected_whole,
      path_selected_whole
    ),
    path_selection_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      path_selected_whole,
      selected_current
    )
  ) -> LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current) =
    transport_lookaround_admitted_cursor_suffix_outer(selected_whole_equivalence, path_selection_suffix)

  ## Extract the active transition package at the construction boundary.  The
  ## active-source and non-empty-input indices eliminate the terminal and
  ## accepted transition constructors before the package is built; all child
  ## cursor spines remain explicit erased fields of the package constructor.
  @reducible
  fn atomic_path_active_child_selection_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    {selected_remaining: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> AtomicPathActiveChildSelectionPackage(
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(source),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    matched,
    remaining_input,
    selected_routine
  ) = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, child_whole, child_selected_whole, child_selected_whole_equivalence, child_origin_canonical, child_current, child_selection_suffix, child_selection_from_origin, child_skipped_kind, child_skipped_evidence, child_trace) ->
      AtomicPathActiveChildSelectionPackageActive(
        source,
        char,
        rest,
        active_state,
        active_routine,
        active_constraints,
        active_assertion_routine,
        active_assertion_markers,
        active_nested_decisions,
        child_whole,
        child_selected_whole,
        child_selected_whole_equivalence,
        child_origin_canonical,
        child_current,
        child_selection_suffix,
        child_selection_from_origin,
        child_skipped_kind,
        child_skipped_evidence,
        child_trace,
        path
      )
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible

  ## Align a failed child cursor with the selected child cursor after
  ## transporting the latter across the common-origin equality published by
  ## the selected path.  This is the reusable recursive bridge: it equates
  ## only the list spines, never runtime states or proof payloads.
  fn atomic_child_cursor_alignment(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, selected_whole),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)
  ) -> LookaroundAdmittedStateCursorAlignment(n, failure_current, selected_current) =
    lookaround_admitted_cursor_suffix_alignment(
      failure_suffix,
      transport_lookaround_admitted_cursor_suffix_outer(selected_whole_equivalence, selected_suffix)
    )

  ## The failed search and selected trace publish their origins independently,
  ## but both certificates normalize to the same indexed machine search. First
  ## align those origins, then transport the selected cursor to the failed
  ## whole list. This is the bounded package boundary used by recursive child
  ## rejection; it never reopens either evaluator result.
  fn atomic_path_failed_selected_child_cursor_alignment(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      failure_origin
    ),
    failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      failure_origin
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      failure_whole,
      failure_current
    ),
    selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      selected_origin
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      selected_origin,
      selected_current
    )
  ) -> LookaroundAdmittedStateCursorAlignment(n, failure_current, selected_current) =
    match atomic_path_search_origin_alignment(
      failure_origin_canonical,
      selected_origin_canonical
    )
      AtomicPathSearchOriginsAligned(origin_equivalence) -> match failure_origin_equivalence
        reflexive() -> match origin_equivalence
          reflexive() -> lookaround_admitted_cursor_suffix_alignment(
            failure_suffix,
            selected_suffix
          )

  ## Transport the selected cursor to the failed search's whole-list index
  ## using the same canonical-origin certificates as the alignment authority.
  ## The erased equalities are eliminated locally; none is projected through a
  ## relevant argument.
  fn atomic_path_failed_selected_child_suffix(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, failure_origin),
    failure_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, failure_origin),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current)
  ) -> LookaroundAdmittedStateCursorSuffix(n, failure_whole, selected_current) =
    match atomic_path_search_origin_alignment(failure_origin_canonical, selected_origin_canonical)
      AtomicPathSearchOriginsAligned(origin_equivalence) -> match failure_origin_equivalence
        reflexive() -> match origin_equivalence
          reflexive() -> selected_suffix

  ## Consume the erased non-empty decomposition without projecting erased
  ## equality data into a relevant argument. Matching the equality rewrites
  ## the whole-list index to its canonical `Cons` form; the selected whole
  ## equality then supplies the only relevant transport needed to classify the
  ## selected child as head, later sibling, or reverse-aligned.
  @reducible
  fn atomic_path_active_child_alignment_from_nonempty(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)
  ) -> AtomicPathActiveChildAlignmentCase(n, failure_current, selected_current) =
    match failure_nonempty
      LookaroundAdmittedNonemptyPacked(_, _, equality) -> match equality
        reflexive() -> match atomic_child_cursor_alignment(
            failure_suffix,
            selected_whole_equivalence,
            selected_suffix
          )
            LookaroundAdmittedCursorLeftToRight(_) -> match atomic_path_selected_child_suffix_location(
              transport_lookaround_admitted_cursor_suffix_outer(
                selected_whole_equivalence,
                selected_suffix
              )
            )
              AtomicPathSelectedChildHere(_, _) -> AtomicPathActiveChildAlignmentCaseHere()
              AtomicPathSelectedChildThere(_, _) -> AtomicPathActiveChildAlignmentCaseThere()
            LookaroundAdmittedCursorRightToLeft(_) -> AtomicPathActiveChildAlignmentCaseReverse()

  ## Classify an alignment whose two cursors have already been transported to
  ## independently certified canonical origins.  All witnesses are relevant at
  ## this construction site; only the completed contradiction is later packed
  ## behind an erased result boundary.
  @reducible
  fn atomic_path_active_child_alignment_from_canonical(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    alignment: LookaroundAdmittedStateCursorAlignment(n, failure_current, selected_current),
    selected_from_failure_whole: LookaroundAdmittedStateCursorSuffix(
      n,
      failure_whole,
      selected_current
    )
  ) -> AtomicPathActiveChildAlignmentCase(n, failure_current, selected_current) =
    match failure_nonempty
      LookaroundAdmittedNonemptyPacked(_, _, equality) -> match equality
        reflexive() -> match alignment
          LookaroundAdmittedCursorLeftToRight(_) ->
            match atomic_path_selected_child_suffix_location(
              selected_from_failure_whole
            )
              AtomicPathSelectedChildHere(_, _) -> AtomicPathActiveChildAlignmentCaseHere()
              AtomicPathSelectedChildThere(_, _) -> AtomicPathActiveChildAlignmentCaseThere()
          LookaroundAdmittedCursorRightToLeft(_) -> AtomicPathActiveChildAlignmentCaseReverse()

  ## Canonical active-child dispatcher. Failed and selected searches retain
  ## distinct origin binders; their origin certificates establish the only
  ## equality used to compare the ordered child cursors.
  @reducible
  fn atomic_path_active_child_rejection_canonical_dispatch(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      failure_origin
    ),
    failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      failure_origin
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      selected_origin
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_tail_fold(
    atomic_path_active_child_alignment_from_canonical(
      failure_nonempty,
      atomic_path_failed_selected_child_cursor_alignment(
        failure_origin_equivalence,
        failure_origin_canonical,
        failure_suffix,
        selected_origin_canonical,
        selected_suffix
      ),
      atomic_path_failed_selected_child_suffix(
        failure_origin_equivalence,
        failure_origin_canonical,
        selected_origin_canonical,
        selected_suffix
      )
    ),
    head_case,
    tail_case,
    reverse_case
  )

  ## Canonical comparison that returns the exact branch authority instead of
  ## demanding precomputed nullary contradictions. The two origin
  ## certificates provide the only whole-spine equality; the failure's
  ## non-empty decomposition fixes the rejected head and sibling tail.
  @reducible
  fn atomic_path_active_child_alignment_authority_from_canonical(
    {depth: Nat}, {n: Nat}, {machine: PatternMachine(n)},
    {input: List(Char)}, {after_input: List(Char)},
    {state: ThreadState(n)}, {history: List(Char)},
    {capture_context: List(EvidenceInstruction)}, {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)), failure_whole, failure_origin
    ),
    failure_origin_canonical: AtomicPathSearchOrigin(
      depth, n, machine, input, after_input, state, history,
      capture_context, policy, failure_origin
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(
      n, failure_whole, failure_current
    ),
    selected_origin_canonical: AtomicPathSearchOrigin(
      depth, n, machine, input, after_input, state, history,
      capture_context, policy, selected_origin
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n, selected_origin, selected_current
    ),
    failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole)
  ) -> AtomicPathActiveChildAlignmentAuthority(
    n, failure_current, selected_current
  ) = match atomic_path_search_origin_alignment(
    failure_origin_canonical,
    selected_origin_canonical
  )
    AtomicPathSearchOriginsAligned(origin_equivalence) -> match origin_equivalence
      reflexive() -> match failure_nonempty
        LookaroundAdmittedNonemptyPacked(
          _, _, failure_nonempty_equivalence
        ) -> match failure_nonempty_equivalence
          reflexive() ->
            atomic_path_active_child_alignment_authority(
              atomic_path_active_child_alignment(
                failure_suffix,
                reflexive(failure_whole),
                failure_origin_equivalence,
                selected_suffix
              )
            )

  ## Refine the recursive failure/trace pair before entering the canonical
  ## cursor dispatcher. The non-empty active-child indices admit only a
  ## destination rejection, so this erased match performs type refinement and
  ## does not introduce a runtime failure-kind branch.
  @reducible
  fn atomic_path_active_child_rejection_canonical_trace_dispatch(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {char: Char},
    {rest: List(Char)},
    {after_input: List(Char)},
    {state: Bounded(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {scope_depth: Nat},
    {prefix_mode: Bool},
    {reversed_prefix: List(Char)},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, failure_origin),
    failure_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, failure_origin),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, failure_whole, failure_current, AtomicPathFailureDestinationRejected()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased _path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, routine),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = match failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_path_active_child_rejection_canonical_dispatch(
        failure_origin_equivalence,
        failure_origin_canonical,
        failure_suffix,
        selected_origin_canonical,
        selected_suffix,
        failure_nonempty,
        head_case,
        tail_case,
        reverse_case
      )

  ## Recursive-current counterpart of the root-relative canonical dispatcher.
  ## The two cursors are first transported to one canonical origin, then their
  ## exact relative location selects the same-child, later-sibling, or reverse
  ## induction branch. No non-empty existential is projected across relevance.
  @reducible
  fn atomic_path_active_child_rejection_canonical_current_dispatch(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    failure_whole: List(LookaroundAdmittedState(n)),
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, failure_origin),
    failure_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, failure_origin),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    same_case: () -> Empty,
    later_case: () -> Empty,
    reverse_case: (AtomicPathStrictCursorSuffix(n, selected_current, failure_current)) -> Empty
  ) -> Empty = match atomic_path_cursor_location(
    failure_whole,
    failure_suffix,
    atomic_path_failed_selected_child_suffix(
      failure_origin_equivalence,
      failure_origin_canonical,
      selected_origin_canonical,
      selected_suffix
    )
  )
    AtomicPathCursorLocationSame(_) -> same_case()
    AtomicPathCursorLocationLeftAfter(strict) -> reverse_case(strict)
    AtomicPathCursorLocationRightAfter(_) -> later_case()

  fn atomic_path_active_child_alignment(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_head: LookaroundAdmittedState(n)},
    {failure_tail: List(LookaroundAdmittedState(n))},
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      Cons(failure_head, failure_tail)
    ),
    {selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)
  ) -> AtomicPathActiveChildAlignment(n, failure_head, failure_tail, failure_current, selected_current) =
    let anchored_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      Cons(failure_head, failure_tail),
      selected_whole
    ) = trans(
      sym(failure_nonempty_equivalence),
      selected_whole_equivalence
    )
    match atomic_child_cursor_alignment(
      failure_suffix,
      selected_whole_equivalence,
      selected_suffix
    )
      LookaroundAdmittedCursorLeftToRight(alignment) -> match atomic_path_selected_child_suffix_location(
        transport_lookaround_admitted_cursor_suffix_outer(
          anchored_equivalence,
          selected_suffix
        )
      )
        AtomicPathSelectedChildHere(candidate_value, remaining_value) -> AtomicPathActiveChildAlignmentHere(alignment)
        AtomicPathSelectedChildThere(candidate_value, suffix_value) -> AtomicPathActiveChildAlignmentThere(alignment, suffix_value)
      LookaroundAdmittedCursorRightToLeft(alignment) -> AtomicPathActiveChildAlignmentReverse(alignment)

  fn lookaround_admitted_cursor_suffix_alignment(
    {n: Nat},
    {outer: List(LookaroundAdmittedState(n))},
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    left_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, left),
    right_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, right)
  ) -> LookaroundAdmittedStateCursorAlignment(n, left, right) = match left_suffix
    LookaroundAdmittedStateCursorSuffixHere(left_equality) -> match left_equality
      reflexive() -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> match right_equality
          reflexive() -> LookaroundAdmittedCursorLeftToRight(LookaroundAdmittedStateCursorSuffixHere(reflexive(left)))
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> LookaroundAdmittedCursorLeftToRight(right_suffix)
    LookaroundAdmittedStateCursorSuffixDrop(_, left_prior) -> match right_suffix
      LookaroundAdmittedStateCursorSuffixHere(right_equality) -> match right_equality
        reflexive() -> LookaroundAdmittedCursorRightToLeft(left_suffix)
      LookaroundAdmittedStateCursorSuffixDrop(_, right_prior) -> lookaround_admitted_cursor_suffix_alignment(left_prior, right_prior)

  ## Ordered candidate suffixes compose when a refutation has already skipped
  ## one prefix and the selected trace skips another.  Keeping this operation
  ## explicit prevents the atomic child theorem from treating two unrelated
  ## suffix proofs as if they shared a spine.
  fn lookaround_admitted_cursor_suffix_compose(
    {n: Nat},
    {outer: List(LookaroundAdmittedState(n))},
    {middle: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    prefix: LookaroundAdmittedStateCursorSuffix(n, outer, middle),
    suffix: LookaroundAdmittedStateCursorSuffix(n, middle, inner)
  ) -> LookaroundAdmittedStateCursorSuffix(n, outer, inner) = match prefix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> suffix
    LookaroundAdmittedStateCursorSuffixDrop(head, prior) -> LookaroundAdmittedStateCursorSuffixDrop(head, lookaround_admitted_cursor_suffix_compose(prior, suffix))

  fn lookaround_admitted_cursor_suffix_tail(
    {n: Nat},
    {outer: List(LookaroundAdmittedState(n))},
    head: LookaroundAdmittedState(n),
    tail: List(LookaroundAdmittedState(n)),
    suffix: LookaroundAdmittedStateCursorSuffix(n, outer, Cons(head, tail))
  ) -> LookaroundAdmittedStateCursorSuffix(n, outer, tail) =
    lookaround_admitted_cursor_suffix_compose(
      suffix,
      LookaroundAdmittedStateCursorSuffixDrop(head, LookaroundAdmittedStateCursorSuffixHere(reflexive(tail)))
    )

  ## No finite list can contain one of its own proper extensions as a suffix.
  ## The recursive case removes the outer list's head and the extension's head
  ## together. This theorem is called only by the contradiction dispatcher;
  ## the entire result is eliminated before code generation.
  @reducible
  fn atomic_path_cons_cannot_be_suffix_of_its_tail(
    {n: Nat},
    head: LookaroundAdmittedState(n),
    tail: List(LookaroundAdmittedState(n)),
    suffix: LookaroundAdmittedStateCursorSuffix(n, tail, Cons(head, tail))
  ) -> Empty = match tail
    Nil() -> match suffix
      LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
    Cons(next, rest) -> match suffix
      LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      LookaroundAdmittedStateCursorSuffixDrop(_, prior) -> atomic_path_cons_cannot_be_suffix_of_its_tail(
        next,
        rest,
        lookaround_admitted_cursor_suffix_tail(head, Cons(next, rest), prior)
      )

  ## Proper suffix is asymmetric.  Composing the ordinary forward suffix
  ## stored by the strict witness with a hypothetical reverse suffix would
  ## make `head :: tail` a suffix of `tail`, which the finite-list lemma above
  ## eliminates.
  @reducible
  fn atomic_path_strict_cursor_suffix_excludes_reverse(
    {n: Nat},
    {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    strict: AtomicPathStrictCursorSuffix(n, outer, inner),
    reverse: LookaroundAdmittedStateCursorSuffix(n, inner, outer)
  ) -> Empty = match strict
    AtomicPathStrictCursorSuffixDrop(head, tail, forward) -> atomic_path_cons_cannot_be_suffix_of_its_tail(
      head,
      tail,
      lookaround_admitted_cursor_suffix_compose(forward, reverse)
    )

  ## A single skipped candidate leaves no ambiguous tail case. After dropping
  ## that head, a selected cursor in `current` cannot also be strictly before
  ## `current`. Mixed skipped-prefix consumption uses this as its one-element
  ## base before handling the escaped-commit or rejected-head constructor.
  @reducible
  fn atomic_path_skipped_one_tail_excludes_strict_selection(
    {n: Nat},
    {current: List(LookaroundAdmittedState(n))},
    {selected: List(LookaroundAdmittedState(n))},
    reverse: LookaroundAdmittedStateCursorSuffix(n, current, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current)
  ) -> Empty = atomic_path_strict_cursor_suffix_excludes_reverse(strict, reverse)

  ## A root failure exposes the canonical whole list unchanged. A selected
  ## cursor strictly before that root would therefore make the whole list both
  ## a suffix and a proper prefix of the selected cursor, contradicting strict
  ## cursor asymmetry before any candidate-level refutation is inspected.
  @reducible
  fn atomic_path_root_failure_excludes_strictly_prior_cursor(
    {n: Nat},
    whole: List(LookaroundAdmittedState(n)),
    current: List(LookaroundAdmittedState(n)),
    selected: List(LookaroundAdmittedState(n)),
    @erased equality: Equivalent(List(LookaroundAdmittedState(n)), whole, current),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current)
  ) -> Empty = match equality
    reflexive() -> atomic_path_strict_cursor_suffix_excludes_reverse(strict, selected_suffix)

  fn lookaround_admitted_cursor_suffix_reflexive(
    {n: Nat},
    {@erased outer: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    @erased _suffix: LookaroundAdmittedStateCursorSuffix(n, outer, current)
  ) -> LookaroundAdmittedStateCursorSuffix(n, current, current) =
    LookaroundAdmittedStateCursorSuffixHere(reflexive(current))

  ## Transport an erased equality through the ordered candidate-list spine.
  ## Successful member traversals use this at the construction site so the
  ## selected whole list cannot drift away from the suffix represented by the
  ## result index while skipped candidates are reintroduced.
  fn lookaround_admitted_state_cons_equivalent(
    {n: Nat},
    head: LookaroundAdmittedState(n),
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    equality: Equivalent(List(LookaroundAdmittedState(n)), left, right)
  ) -> Equivalent(List(LookaroundAdmittedState(n)), Cons(head, left), Cons(head, right)) = match equality
    reflexive() -> reflexive(Cons(head, left))

  ## This witness mirrors the cursor's own arbitrary-whole traversal.  It is
  ## distinct from `LookaroundAdmittedStateCursorSuffix`: the latter relates
  ## two list spines whose outer list starts at the dropped head, while this
  ## witness records a cursor that may already have skipped a prefix of its
  ## original whole list.
  type LookaroundAdmittedStateCursorWitness(n: Nat) indices (whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    LookaroundAdmittedStateCursorWitnessHere : LookaroundAdmittedStateCursorWitness(n, values, values)
    LookaroundAdmittedStateCursorWitnessDrop : (@erased head: LookaroundAdmittedState(n)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(head, values))) -> LookaroundAdmittedStateCursorWitness(n, whole, values)

  fn lookaround_admitted_cursor_to_suffix({n: Nat}, {whole: List(LookaroundAdmittedState(n))}, {current: List(LookaroundAdmittedState(n))}, cursor: LookaroundAdmittedStateCursor(n, whole, current)) -> LookaroundAdmittedStateCursorWitness(n, whole, current) = match cursor
    LookaroundAdmittedStateCursorHere() -> LookaroundAdmittedStateCursorWitnessHere()
    LookaroundAdmittedStateCursorDrop(head, cursor) -> LookaroundAdmittedStateCursorWitnessDrop(head, lookaround_admitted_cursor_to_suffix(cursor))

  fn lookaround_admitted_machine_state({n: Nat}, admitted: LookaroundAdmittedState(n)) -> MachineState(n) = match admitted
    LookaroundAdmittedActive(state, routine, constraints, _, assertion_markers, _) -> Active(state, append_routine(routine, assertion_markers), constraints)
    LookaroundAdmittedAccepted(routine, constraints, _, assertion_markers, _) -> Accepted(append_routine(routine, assertion_markers), constraints)

  fn lookaround_admitted_machine_states({n: Nat}, admitted: List(LookaroundAdmittedState(n))) -> List(MachineState(n)) = match admitted
    [] -> []
    [head | rest] -> [lookaround_admitted_machine_state(head) | lookaround_admitted_machine_states(rest)]

  fn lookaround_admit_boundary_states(depth: Nat, {n: Nat}, states: List(MachineState(n)), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundAdmittedState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, append_routine(capture_context, routine), policy)
      Some(LookaroundConstraintAdmitted(assertion_routine, assertion_markers, nested_decisions)) -> [LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) | lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)]
      None() -> lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)
    [Accepted(routine, constraints) | rest] -> match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, append_routine(capture_context, routine), policy)
      Some(LookaroundConstraintAdmitted(assertion_routine, assertion_markers, nested_decisions)) -> [LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions) | lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)]
      None() -> lookaround_admit_boundary_states(depth, rest, boundary, remaining, history, capture_context, policy)

  fn lookaround_admitted_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundAdmittedState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_admit_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  fn lookaround_filter_boundary_states(depth: Nat, {n: Nat}, states: List(MachineState(n)), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) =
    lookaround_admitted_machine_states(lookaround_admit_boundary_states(depth, states, boundary, remaining, history, capture_context, policy))


  fn lookaround_condition_admission(depth: Nat, condition: Option(LookaroundCondition), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(LookaroundConstraintAdmission) = match condition
    None() -> Some(LookaroundConstraintAdmitted([], [], []))
    Some(LookaheadCondition(positive, mk_pair(count, machine))) ->
      let decision = lookaround_child_lookahead(depth, count, machine, boundary, remaining, history, capture_context, policy)
      let nested = [LookaheadNestedDecision(positive, %[count, machine, decision])]
      match decision
        LookaheadSatisfied(witness) -> match positive
          True() ->
            let routine = lookahead_witness_routine(count, machine, witness)
            Some(LookaroundConstraintAdmitted(routine, capture_slot_markers_from_extended(routine), nested))
          False() -> None()
        LookaheadRefuted(_) -> match positive
          True() -> None()
          False() -> Some(LookaroundConstraintAdmitted([], [], nested))
        LookaheadResourceExhausted(_, _, _, _, _) -> None()
    Some(LookbehindCondition(positive, width, mk_pair(count, machine))) ->
      let decision = lookaround_child_lookbehind(depth, count, machine, width, boundary, remaining, history, capture_context, policy)
      let nested = [LookbehindNestedDecision(positive, %[count, machine, decision])]
      match decision
        LookbehindSatisfied(witness) -> match positive
          True() ->
            let routine = lookbehind_witness_routine(count, machine, witness)
            Some(LookaroundConstraintAdmitted(routine, capture_slot_markers_from_extended(routine), nested))
          False() -> None()
        LookbehindRefuted(_) -> match positive
          True() -> None()
          False() -> Some(LookaroundConstraintAdmitted([], [], nested))
        LookbehindResourceExhausted(_, _, _, _, _) -> None()

  fn lookaround_constraint_admission(depth: Nat, constraint: BoundaryConstraint, boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(LookaroundConstraintAdmission) = match boundary
    Boundary(subject_start, _subject_end, strict_subject_end, _line_start, _line_end, ascii_boundary, unicode_boundary, previous_char, next_char, after_next_char) -> match constraint
      BoundaryConstraint(require_subject_start, require_subject_end, require_strict_end, require_line_start, require_line_end, check_ascii, expected_ascii, check_unicode, expected_unicode, constraint_policy, capture_condition, lookaround_condition) -> pickup
        (not require_subject_start or subject_start) and
          (not require_subject_end or subject_end_for(constraint_policy, next_char, after_next_char)) and
          (not require_strict_end or strict_subject_end) and
          (not require_line_start or line_start_for(constraint_policy, previous_char, next_char)) and
          (not require_line_end or line_end_for(constraint_policy, next_char, after_next_char)) and
          (not check_ascii or ascii_boundary == expected_ascii) and
          (not check_unicode or unicode_boundary == expected_unicode) and
          capture_condition_holds(capture_condition, capture_context) -> lookaround_condition_admission(depth, lookaround_condition, boundary, remaining, history, capture_context, policy)
        else -> None()

  fn lookaround_constraints_admission(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(LookaroundConstraintAdmission) = match constraints
    [] -> Some(LookaroundConstraintAdmitted([], [], []))
    [constraint | rest] -> match lookaround_constraint_admission(depth, constraint, boundary, remaining, history, capture_context, policy)
      None() -> None()
      Some(LookaroundConstraintAdmitted(head_routine, head_markers, head_decisions)) -> match lookaround_constraints_admission(depth, rest, boundary, remaining, history, append_routine(capture_context, head_markers), policy)
        None() -> None()
        Some(LookaroundConstraintAdmitted(tail_routine, tail_markers, tail_decisions)) -> Some(LookaroundConstraintAdmitted(append_extended_routines(head_routine, tail_routine), append_routine(head_markers, tail_markers), append(head_decisions, tail_decisions)))

  ## A successful positive assertion can publish capture participation to the
  ## parent's ordinary finite machine. Lookahead markers come from the routine
  ## retained by the admitting witness; only slot markers cross the boundary.
  fn lookaround_constraints_capture_context(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(List(EvidenceInstruction)) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> None()
    Some(LookaroundConstraintAdmitted(_, markers, _)) -> Some(markers)

  fn lookahead_decision_holds(n: Nat, machine: PatternMachine(n), positive: Bool, decision: LookaheadDecision(n, machine)) -> Bool = match decision
    LookaheadSatisfied(_) -> positive
    LookaheadRefuted(_) -> not positive
    LookaheadResourceExhausted(_, _, _, _, _) -> false

  fn lookbehind_decision_holds(n: Nat, machine: PatternMachine(n), positive: Bool, decision: LookbehindDecision(n, machine)) -> Bool = match decision
    LookbehindSatisfied(_) -> positive
    LookbehindRefuted(_) -> not positive
    LookbehindResourceExhausted(_, _, _, _, _) -> false

  ## Capture-aware boundary evaluation returns the selected child routine for a
  ## positive assertion. A negative assertion succeeds with an empty routine:
  ## its private capture frame is intentionally discarded. Lookahead consumes
  ## the routine retained by the same proof-carrying decision.
  fn lookaround_constraints_routine(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(List(ExtendedInstruction)) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> None()
    Some(LookaroundConstraintAdmitted(routine, _, _)) -> Some(routine)


  ## Capture-free assertion paths carry state reachability plus an erased list
  ## of the nested decisions used by each accepted transition. The depth index
  ## is the same guard used by the evaluator: each nested assertion consumes
  ## one level and zero fuel cannot manufacture a child path.
  ## A failed path records the complete finite traversal below one thread.
  ## Destination failures retain the child rejection and the tail rejection;
  ## the only terminal constructor is reached with a structurally exhausted
  ## `MachineStateMembers` witness. The capture context is indexed because
  ## nested capture-condition checks must be refuted in the same environment
  ## that produced the destination list.
  type LookaroundPathFailure(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, destinations: List(MachineState(n)), remaining_destinations: List(MachineState(n)))
    LookaroundPathExhausted : (@erased remaining_destinations: List(MachineState(n))) -> (source: Bounded(n)) -> (@erased members: MachineStateMembers(n, destinations, Nil())) -> (@erased cursor: MachineStateCursor(n, destinations, Nil())) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, empty_machine_states(n))) -> (@erased remaining_equivalent: Equivalent(List(MachineState(n)), remaining_destinations, Nil())) -> LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, destinations, remaining_destinations)
    LookaroundPathStepExhausted : (@erased remaining_destinations: List(MachineState(n))) -> (char: Char) -> (rest: List(Char)) -> (source: Bounded(n)) -> (@erased members: MachineStateMembers(n, destinations, Nil())) -> (@erased cursor: MachineStateCursor(n, destinations, Nil())) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (@erased remaining_equivalent: Equivalent(List(MachineState(n)), remaining_destinations, Nil())) -> LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, destinations, remaining_destinations)
    LookaroundPathAcceptedWithInput : (@erased remaining_destinations: List(MachineState(n))) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (@erased remaining_equivalent: Equivalent(List(MachineState(n)), remaining_destinations, Nil())) -> LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, Nil(), remaining_destinations)
    LookaroundPathDestinationActiveRejectedEmpty : (@erased remaining_destinations: List(MachineState(n))) -> (char: Char) -> (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(destination, routine, constraints), destinations)) -> (@erased current_edge: ListMember(MachineState(n), Active(destination, routine, constraints), Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased members: MachineStateMembers(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased cursor: MachineStateCursor(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (child: LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, Nil(), Nil())) -> (tail: LookaroundPathFailure(depth, n, machine, Cons(char, Nil()), after_input, state, history, capture_context, policy, destinations, remaining_destinations)) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, state, char, Nil(), after_input, history, capture_context, policy))) -> LookaroundPathFailure(depth, n, machine, Cons(char, Nil()), after_input, state, history, capture_context, policy, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))
    LookaroundPathDestinationActiveRejected : (@erased remaining_destinations: List(MachineState(n))) -> (char: Char) -> (child_char: Char) -> (child_rest: List(Char)) -> (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(destination, routine, constraints), destinations)) -> (@erased current_edge: ListMember(MachineState(n), Active(destination, routine, constraints), Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased members: MachineStateMembers(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (@erased cursor: MachineStateCursor(n, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))) -> (child: LookaroundPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy))) -> (tail: LookaroundPathFailure(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, state, history, capture_context, policy, destinations, remaining_destinations)) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, state, char, Cons(child_char, child_rest), after_input, history, capture_context, policy))) -> LookaroundPathFailure(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, state, history, capture_context, policy, destinations, Cons(Active(destination, routine, constraints), remaining_destinations))
