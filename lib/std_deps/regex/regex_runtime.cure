  fn lookaround_machine_acceptance_path(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundSearchResult(depth, n, machine, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy), input, after_input, history, policy, capture_context) =
    lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_exact_filtered_starts(depth, n, machine, position, input, after_input, history, capture_context, policy))

  fn lookaround_machine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = atomic_lookaround_accepts(depth, n, machine, position, input, after_input, history, capture_context, policy)

  fn lookaround_prefix_machine_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = match machine
    MkPatternMachine(starts, _) -> match lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy))
      LookaroundPrefixSearchResultRejected(_) -> false
      LookaroundPrefixSearchResultFound(_) -> true







































  ## A structural Same comparison is useful as proof authority only after
  ## both shapes have been checked against their exact cursor packages.  With
  ## the outer origins aligned, equal Here/Drop spines force the two hidden
  ## inner cursors to be equal as well.
  @reducible
  local fn lookaround_admitted_cursor_same_shape_inner_equivalent(
    {n: Nat},
    {@erased left_outer: List(LookaroundAdmittedState(n))},
    {@erased left_inner: List(LookaroundAdmittedState(n))},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    {left_shape: LookaroundAdmittedStateCursorShape},
    {right_shape: LookaroundAdmittedStateCursorShape},
    left_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, left_outer, left_inner, left_shape
    ),
    right_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, right_outer, right_inner, right_shape
    ),
    same_authority: AtomicPathCursorShapesSameAuthority(
      left_shape, right_shape
    ),
    @erased outer_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)), left_outer, right_outer
    )
  ) -> LookaroundAdmittedCursorInnerEquivalentAuthority(
    n, left_inner, right_inner
  ) = match same_authority
    AtomicPathCursorShapesSameHere() -> match left_cursor
      LookaroundAdmittedStateCursorHereShapedPacked(left_equality) -> match right_cursor
        LookaroundAdmittedStateCursorHereShapedPacked(right_equality) ->
          LookaroundAdmittedCursorInnerEquivalentPacked(
            trans(sym(left_equality), trans(outer_equivalence, right_equality))
          )
    AtomicPathCursorShapesSameDrop(prior) -> match left_cursor
      LookaroundAdmittedStateCursorDropShapedPacked(_, left_prior) -> match right_cursor
        LookaroundAdmittedStateCursorDropShapedPacked(_, right_prior) -> match outer_equivalence
          reflexive() -> lookaround_admitted_cursor_same_shape_inner_equivalent(
              left_prior,
              right_prior,
              prior,
              reflexive()
            )







  ## Transport a non-empty decomposition backwards through an ordered cursor
  ## suffix.  The `Here` case consumes the suffix equality; each `Drop` case
  ## prepends the dropped head with the canonical cons congruence.  This is the
  ## sole authority for deriving `whole = head :: tail` from a non-empty
  ## cursor, so active-child proofs never manufacture that equality locally.
  @reducible
  fn lookaround_admitted_cursor_suffix_nonempty(
    {n: Nat},
    {whole: List(LookaroundAdmittedState(n))},
    {head: LookaroundAdmittedState(n)},
    {tail: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Cons(head, tail))
  ) -> LookaroundAdmittedNonempty(n, whole) = match suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> LookaroundAdmittedNonemptyPacked(head, tail, reflexive(Cons(head, tail)))
    LookaroundAdmittedStateCursorSuffixDrop(dropped, prior) -> match lookaround_admitted_cursor_suffix_nonempty(prior)
      LookaroundAdmittedNonemptyPacked(prior_head, prior_tail, prior_equivalence) -> LookaroundAdmittedNonemptyPacked(
        dropped,
        Cons(prior_head, prior_tail),
        lookaround_admitted_state_cons_equivalent(dropped, prior_equivalence)
      )


  @reducible
  fn atomic_path_selected_child_suffix_location(
    {n: Nat},
    {head: LookaroundAdmittedState(n)},
    {rest: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), current)
  ) -> AtomicPathSelectedChildLocation(n, head, rest, current) = match suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> AtomicPathSelectedChildHere(head, rest)
    LookaroundAdmittedStateCursorSuffixDrop(_, prior) -> AtomicPathSelectedChildThere(head, prior)

  ## Consume the selected-child location without making the erased location
  ## witness a runtime callback argument.  The suffix itself is relevant at
  ## this construction site, so only its indexed `Here`/`There` shape drives
  ## the proof-only continuations.
  @reducible
  fn atomic_path_selected_child_suffix_location_elim(
    {result: Type},
    {n: Nat},
    {head: LookaroundAdmittedState(n)},
    {rest: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), current),
    here_case: () -> result,
    there_case: () -> result
  ) -> result = match atomic_path_selected_child_suffix_location(suffix)
    AtomicPathSelectedChildHere(_, _) -> here_case()
    AtomicPathSelectedChildThere(_, _) -> there_case()

  ## Value form of the same split for callers whose contradiction is already
  ## constructed. Cure does not admit zero-argument lambdas in every dependent
  ## callback context, so this boundary selects between proof values directly
  ## while retaining the cursor as the sole branch authority.
  @reducible
  fn atomic_path_selected_child_suffix_location_select(
    {result: Type},
    {n: Nat},
    {head: LookaroundAdmittedState(n)},
    {rest: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    suffix: LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), current),
    here_case: result,
    there_case: result
  ) -> result = match atomic_path_selected_child_suffix_location(suffix)
    AtomicPathSelectedChildHere(_, _) -> here_case
    AtomicPathSelectedChildThere(_, _) -> there_case



  ## Compare two cursors from the same canonical origin. Equality remains an
  ## erased index; directional cases retain only the suffix needed by the
  ## recursive sibling-tail proof.
  type AtomicPathCursorLocation(n: Nat) indices (left: List(LookaroundAdmittedState(n)), right: List(LookaroundAdmittedState(n)))
    AtomicPathCursorLocationSame : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), left, right)) -> AtomicPathCursorLocation(n, left, right)
    AtomicPathCursorLocationLeftAfter : (marker: AtomicPathStrictCursorSuffix(n, right, left)) -> AtomicPathCursorLocation(n, left, right)
    AtomicPathCursorLocationRightAfter : (marker: LookaroundAdmittedStateCursorSuffixPackage(n, left, right)) -> AtomicPathCursorLocation(n, left, right)




  @reducible
  fn atomic_path_strict_cursor_suffix_package(
    {n: Nat}, {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    marker: AtomicPathStrictCursorSuffix(n, outer, inner)
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, outer, inner) = match marker
    AtomicPathStrictCursorSuffixDrop(head, _, suffix) ->
      lookaround_admitted_cursor_suffix_package_drop(
        head,
        lookaround_admitted_cursor_suffix_package(suffix)
      )

  @reducible
  fn atomic_path_commit_selected_location_package(
    {n: Nat}, {commit_package: Type}, {commit_cursor_package: Type},
    {selected_trace_package: Type}, {selected_skipped_package: Type},
    {commit_current: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    commit: commit_package,
    commit_cursor: commit_cursor_package,
    selected_trace: selected_trace_package,
    selected_skipped: selected_skipped_package,
    location: AtomicPathCursorLocation(n, commit_current, selected_current)
  ) -> AtomicPathCommitSelectedLocationPackage(
    n,
    commit_package,
    commit_cursor_package,
    selected_trace_package,
    selected_skipped_package,
    commit_current,
    selected_current
  ) = match location
    AtomicPathCursorLocationSame(equality) -> AtomicPathCommitSelectedSamePacked(
      commit,
      commit_cursor,
      selected_trace,
      selected_skipped,
      equality
    )
    AtomicPathCursorLocationLeftAfter(marker) -> AtomicPathCommitSelectedLeftAfterPacked(
      commit,
      commit_cursor,
      selected_trace,
      selected_skipped,
      atomic_path_strict_cursor_suffix_package(marker)
    )
    AtomicPathCursorLocationRightAfter(marker) -> AtomicPathCommitSelectedRightAfterPacked(
      commit,
      commit_cursor,
      selected_trace,
      selected_skipped,
      marker
    )

  ## Single eliminator for the correlated location carrier. Each continuation
  ## receives the intact package, so recursive consumers choose a branch only
  ## from its relevant constructor and cannot split its correlated payloads.
  @reducible
  fn atomic_path_commit_selected_location_package_fold(
    {result: Type}, {n: Nat}, {commit_package: Type},
    {commit_cursor_package: Type},
    {selected_trace_package: Type},
    {selected_skipped_package: Type},
    {commit_current: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    package: AtomicPathCommitSelectedLocationPackage(
      n,
      commit_package,
      commit_cursor_package,
      selected_trace_package,
      selected_skipped_package,
      commit_current,
      selected_current
    ),
    same_case: (AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)) -> result,
    left_case: (AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)) -> result,
    right_case: (AtomicPathCommitSelectedLocationPackage(n, commit_package, commit_cursor_package, selected_trace_package, selected_skipped_package, commit_current, selected_current)) -> result
  ) -> result = match package
    AtomicPathCommitSelectedSamePacked(_, _, _, _, _) -> same_case(package)
    AtomicPathCommitSelectedLeftAfterPacked(_, _, _, _, _) -> left_case(package)
    AtomicPathCommitSelectedRightAfterPacked(_, _, _, _, _) -> right_case(package)

  @reducible
  fn atomic_path_cursor_location(
    {n: Nat},
    outer: List(LookaroundAdmittedState(n)),
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    left_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, left),
    right_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, right)
  ) -> AtomicPathCursorLocation(n, left, right) = match outer
    Nil() -> match left_suffix
      LookaroundAdmittedStateCursorSuffixHere(left_equality) -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> AtomicPathCursorLocationSame(trans(sym(left_equality), right_equality))
    Cons(outer_head, outer_tail) -> match left_suffix
      LookaroundAdmittedStateCursorSuffixHere(left_equality) -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> AtomicPathCursorLocationSame(trans(sym(left_equality), right_equality))
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> match left_equality
          reflexive() -> AtomicPathCursorLocationRightAfter(
            lookaround_admitted_cursor_suffix_package(right_suffix)
          )
      LookaroundAdmittedStateCursorSuffixDrop(_, left_prior) -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> match right_equality
          reflexive() -> AtomicPathCursorLocationLeftAfter(AtomicPathStrictCursorSuffixDrop(outer_head, outer_tail, left_prior))
        LookaroundAdmittedStateCursorSuffixDrop(_, right_prior) -> atomic_path_cursor_location(outer_tail, left_prior, right_prior)







  type AtomicPathActiveChildAlignmentPackage(n: Nat, failure_package: Type, selected_package: Type) indices (failure_current: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathActiveChildAlignmentHerePacked : (branch: AtomicPathActiveChildAlignmentHerePackage(n, failure_package, selected_package, failure_current, current)) -> AtomicPathActiveChildAlignmentPackage(n, failure_package, selected_package, failure_current, current)
    AtomicPathActiveChildAlignmentTherePacked : (branch: AtomicPathActiveChildAlignmentTherePackage(n, failure_package, selected_package, failure_current, current)) -> AtomicPathActiveChildAlignmentPackage(n, failure_package, selected_package, failure_current, current)
    AtomicPathActiveChildAlignmentReversePacked : (branch: AtomicPathActiveChildAlignmentReversePackage(n, failure_package, selected_package, failure_current, current)) -> AtomicPathActiveChildAlignmentPackage(n, failure_package, selected_package, failure_current, current)

  @reducible
  fn atomic_path_active_child_alignment_package(
    {n: Nat}, {failure_package: Type}, {selected_package: Type},
    {failure_current: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    failure: failure_package,
    selected: selected_package,
    authority: AtomicPathActiveChildAlignmentAuthority(n, failure_current, current)
  ) -> AtomicPathActiveChildAlignmentPackage(
    n, failure_package, selected_package, failure_current, current
  ) = match authority
    AtomicPathActiveChildAlignmentHereAuthority(alignment) ->
      AtomicPathActiveChildAlignmentHerePacked(
        AtomicPathActiveChildHerePacked(failure, selected, alignment)
      )
    AtomicPathActiveChildAlignmentThereAuthority(alignment, tail) ->
      AtomicPathActiveChildAlignmentTherePacked(
        AtomicPathActiveChildTherePacked(failure, selected, alignment, tail)
      )
    AtomicPathActiveChildAlignmentReverseAuthority(alignment) ->
      AtomicPathActiveChildAlignmentReversePacked(
        AtomicPathActiveChildReversePacked(failure, selected, alignment)
      )

  @reducible
  fn atomic_path_active_child_alignment_package_dispatch(
    {result: Type},
    {n: Nat}, {failure_package: Type}, {selected_package: Type},
    {failure_current: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    package: AtomicPathActiveChildAlignmentPackage(
      n, failure_package, selected_package, failure_current, current
    ),
    here_case: (AtomicPathActiveChildAlignmentHerePackage(
      n, failure_package, selected_package, failure_current, current
    )) -> result,
    there_case: (AtomicPathActiveChildAlignmentTherePackage(
      n, failure_package, selected_package, failure_current, current
    )) -> result,
    reverse_case: (AtomicPathActiveChildAlignmentReversePackage(
      n, failure_package, selected_package, failure_current, current
    )) -> result
  ) -> result = match package
    AtomicPathActiveChildAlignmentHerePacked(branch) -> here_case(branch)
    AtomicPathActiveChildAlignmentTherePacked(branch) -> there_case(branch)
    AtomicPathActiveChildAlignmentReversePacked(branch) -> reverse_case(branch)

  @reducible
  fn atomic_path_active_child_alignment_authority(
    {n: Nat}, {candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {current: List(LookaroundAdmittedState(n))},
    alignment: AtomicPathActiveChildAlignment(
      n, candidate, remaining, failure_current, current
    )
  ) -> AtomicPathActiveChildAlignmentAuthority(
    n, failure_current, current
  ) = match alignment
    AtomicPathActiveChildAlignmentHere(authority) ->
      AtomicPathActiveChildAlignmentHereAuthority(authority)
    AtomicPathActiveChildAlignmentThere(authority, tail) ->
      AtomicPathActiveChildAlignmentThereAuthority(authority, tail)
    AtomicPathActiveChildAlignmentReverse(authority) ->
      AtomicPathActiveChildAlignmentReverseAuthority(authority)


  ## Transport the selected child suffix from a path constructor's local
  ## origin to the parent selected origin.  The current spine is deliberately
  ## shared by the two views; a later recursive package will carry a separate
  ## current-spine equality when the child search advances through a sibling.
  ## Keeping this outer transport at one authority prevents callers from
  ## rebuilding or guessing the selected cursor list.
  @reducible
  fn atomic_path_active_child_selection_suffix_transport(
    {n: Nat},
    {selected_whole: List(LookaroundAdmittedState(n))},
    {path_selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      selected_whole,
      path_selected_whole
    ),
    path_selection_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      path_selected_whole,
      selected_current
    )
  ) -> LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current) =
    transport_lookaround_admitted_cursor_suffix_outer(selected_whole_equivalence, path_selection_suffix)

  ## Extract the active transition package at the construction boundary.  The
  ## active-source and non-empty-input indices eliminate the terminal and
  ## accepted transition constructors before the package is built; all child
  ## cursor spines remain explicit erased fields of the package constructor.
  @reducible
  fn atomic_path_active_child_selection_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    {selected_remaining: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> AtomicPathActiveChildSelectionPackage(
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(source),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    matched,
    remaining_input,
    selected_routine
  ) = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, child_whole, child_selected_whole, child_selected_whole_equivalence, child_origin_canonical, child_current, child_selection_suffix, child_selection_from_origin, child_skipped_kind, child_skipped_evidence, child_trace) ->
      AtomicPathActiveChildSelectionPackageActive(
        source,
        char,
        rest,
        active_state,
        active_routine,
        active_constraints,
        active_assertion_routine,
        active_assertion_markers,
        active_nested_decisions,
        child_whole,
        child_selected_whole,
        child_selected_whole_equivalence,
        child_origin_canonical,
        child_current,
        child_selection_suffix,
        child_selection_from_origin,
        child_skipped_kind,
        child_skipped_evidence,
        child_trace,
        path
      )
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible

  ## Align a failed child cursor with the selected child cursor after
  ## transporting the latter across the common-origin equality published by
  ## the selected path.  This is the reusable recursive bridge: it equates
  ## only the list spines, never runtime states or proof payloads.
  fn atomic_child_cursor_alignment(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, selected_whole),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)
  ) -> LookaroundAdmittedStateCursorAlignment(n, failure_current, selected_current) =
    lookaround_admitted_cursor_suffix_alignment(
      failure_suffix,
      transport_lookaround_admitted_cursor_suffix_outer(selected_whole_equivalence, selected_suffix)
    )

  ## The failed search and selected trace publish their origins independently,
  ## but both certificates normalize to the same indexed machine search. First
  ## align those origins, then transport the selected cursor to the failed
  ## whole list. This is the bounded package boundary used by recursive child
  ## rejection; it never reopens either evaluator result.
  fn atomic_path_failed_selected_child_cursor_alignment(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      failure_origin
    ),
    failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      failure_origin
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      failure_whole,
      failure_current
    ),
    selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      selected_origin
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      selected_origin,
      selected_current
    )
  ) -> LookaroundAdmittedStateCursorAlignment(n, failure_current, selected_current) =
    match atomic_path_search_origin_alignment(
      failure_origin_canonical,
      selected_origin_canonical
    )
      AtomicPathSearchOriginsAligned(origin_equivalence) -> match failure_origin_equivalence
        reflexive() -> match origin_equivalence
          reflexive() -> lookaround_admitted_cursor_suffix_alignment(
            failure_suffix,
            selected_suffix
          )

  ## Transport the selected cursor to the failed search's whole-list index
  ## using the same canonical-origin certificates as the alignment authority.
  ## The erased equalities are eliminated locally; none is projected through a
  ## relevant argument.
  fn atomic_path_failed_selected_child_suffix(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, failure_origin),
    failure_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, failure_origin),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current)
  ) -> LookaroundAdmittedStateCursorSuffix(n, failure_whole, selected_current) =
    match atomic_path_search_origin_alignment(failure_origin_canonical, selected_origin_canonical)
      AtomicPathSearchOriginsAligned(origin_equivalence) -> match failure_origin_equivalence
        reflexive() -> match origin_equivalence
          reflexive() -> selected_suffix

  ## Consume the erased non-empty decomposition without projecting erased
  ## equality data into a relevant argument. Matching the equality rewrites
  ## the whole-list index to its canonical `Cons` form; the selected whole
  ## equality then supplies the only relevant transport needed to classify the
  ## selected child as head, later sibling, or reverse-aligned.
  @reducible
  fn atomic_path_active_child_alignment_from_nonempty(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)
  ) -> AtomicPathActiveChildAlignmentCase(n, failure_current, selected_current) =
    match failure_nonempty
      LookaroundAdmittedNonemptyPacked(_, _, equality) -> match equality
        reflexive() -> match atomic_child_cursor_alignment(
            failure_suffix,
            selected_whole_equivalence,
            selected_suffix
          )
            LookaroundAdmittedCursorLeftToRight(_) -> match atomic_path_selected_child_suffix_location(
              transport_lookaround_admitted_cursor_suffix_outer(
                selected_whole_equivalence,
                selected_suffix
              )
            )
              AtomicPathSelectedChildHere(_, _) -> AtomicPathActiveChildAlignmentCaseHere()
              AtomicPathSelectedChildThere(_, _) -> AtomicPathActiveChildAlignmentCaseThere()
            LookaroundAdmittedCursorRightToLeft(_) -> AtomicPathActiveChildAlignmentCaseReverse()

  ## Classify an alignment whose two cursors have already been transported to
  ## independently certified canonical origins.  All witnesses are relevant at
  ## this construction site; only the completed contradiction is later packed
  ## behind an erased result boundary.
  @reducible
  fn atomic_path_active_child_alignment_from_canonical(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    alignment: LookaroundAdmittedStateCursorAlignment(n, failure_current, selected_current),
    selected_from_failure_whole: LookaroundAdmittedStateCursorSuffix(
      n,
      failure_whole,
      selected_current
    )
  ) -> AtomicPathActiveChildAlignmentCase(n, failure_current, selected_current) =
    match failure_nonempty
      LookaroundAdmittedNonemptyPacked(_, _, equality) -> match equality
        reflexive() -> match alignment
          LookaroundAdmittedCursorLeftToRight(_) ->
            match atomic_path_selected_child_suffix_location(
              selected_from_failure_whole
            )
              AtomicPathSelectedChildHere(_, _) -> AtomicPathActiveChildAlignmentCaseHere()
              AtomicPathSelectedChildThere(_, _) -> AtomicPathActiveChildAlignmentCaseThere()
          LookaroundAdmittedCursorRightToLeft(_) -> AtomicPathActiveChildAlignmentCaseReverse()

  ## Canonical active-child dispatcher. Failed and selected searches retain
  ## distinct origin binders; their origin certificates establish the only
  ## equality used to compare the ordered child cursors.
  @reducible
  fn atomic_path_active_child_rejection_canonical_dispatch(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      failure_origin
    ),
    failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      failure_origin
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      input,
      after_input,
      state,
      history,
      capture_context,
      policy,
      selected_origin
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_tail_fold(
    atomic_path_active_child_alignment_from_canonical(
      failure_nonempty,
      atomic_path_failed_selected_child_cursor_alignment(
        failure_origin_equivalence,
        failure_origin_canonical,
        failure_suffix,
        selected_origin_canonical,
        selected_suffix
      ),
      atomic_path_failed_selected_child_suffix(
        failure_origin_equivalence,
        failure_origin_canonical,
        selected_origin_canonical,
        selected_suffix
      )
    ),
    head_case,
    tail_case,
    reverse_case
  )

  ## Canonical comparison that returns the exact branch authority instead of
  ## demanding precomputed nullary contradictions. The two origin
  ## certificates provide the only whole-spine equality; the failure's
  ## non-empty decomposition fixes the rejected head and sibling tail.
  @reducible
  fn atomic_path_active_child_alignment_authority_from_canonical(
    {depth: Nat}, {n: Nat}, {machine: PatternMachine(n)},
    {input: List(Char)}, {after_input: List(Char)},
    {state: ThreadState(n)}, {history: List(Char)},
    {capture_context: List(EvidenceInstruction)}, {policy: NewlinePolicy},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)), failure_whole, failure_origin
    ),
    failure_origin_canonical: AtomicPathSearchOrigin(
      depth, n, machine, input, after_input, state, history,
      capture_context, policy, failure_origin
    ),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(
      n, failure_whole, failure_current
    ),
    selected_origin_canonical: AtomicPathSearchOrigin(
      depth, n, machine, input, after_input, state, history,
      capture_context, policy, selected_origin
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n, selected_origin, selected_current
    ),
    failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole)
  ) -> AtomicPathActiveChildAlignmentAuthority(
    n, failure_current, selected_current
  ) = match atomic_path_search_origin_alignment(
    failure_origin_canonical,
    selected_origin_canonical
  )
    AtomicPathSearchOriginsAligned(origin_equivalence) -> match origin_equivalence
      reflexive() -> match failure_nonempty
        LookaroundAdmittedNonemptyPacked(
          _, _, failure_nonempty_equivalence
        ) -> match failure_nonempty_equivalence
          reflexive() ->
            atomic_path_active_child_alignment_authority(
              atomic_path_active_child_alignment(
                failure_suffix,
                reflexive(failure_whole),
                failure_origin_equivalence,
                selected_suffix
              )
            )

  ## Refine the recursive failure/trace pair before entering the canonical
  ## cursor dispatcher. The non-empty active-child indices admit only a
  ## destination rejection, so this erased match performs type refinement and
  ## does not introduce a runtime failure-kind branch.
  @reducible
  fn atomic_path_active_child_rejection_canonical_trace_dispatch(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {char: Char},
    {rest: List(Char)},
    {after_input: List(Char)},
    {state: Bounded(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    {scope_depth: Nat},
    {prefix_mode: Bool},
    {reversed_prefix: List(Char)},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, failure_origin),
    failure_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, failure_origin),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, failure_whole, failure_current, AtomicPathFailureDestinationRejected()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased _path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, routine),
    head_case: () -> Empty,
    tail_case: () -> Empty,
    reverse_case: () -> Empty
  ) -> Empty = match failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_path_active_child_rejection_canonical_dispatch(
        failure_origin_equivalence,
        failure_origin_canonical,
        failure_suffix,
        selected_origin_canonical,
        selected_suffix,
        failure_nonempty,
        head_case,
        tail_case,
        reverse_case
      )

  ## Recursive-current counterpart of the root-relative canonical dispatcher.
  ## The two cursors are first transported to one canonical origin, then their
  ## exact relative location selects the same-child, later-sibling, or reverse
  ## induction branch. No non-empty existential is projected across relevance.
  @reducible
  fn atomic_path_active_child_rejection_canonical_current_dispatch(
    {depth: Nat},
    {n: Nat},
    {machine: PatternMachine(n)},
    {input: List(Char)},
    {after_input: List(Char)},
    {state: ThreadState(n)},
    {history: List(Char)},
    {capture_context: List(EvidenceInstruction)},
    {policy: NewlinePolicy},
    failure_whole: List(LookaroundAdmittedState(n)),
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_origin: List(LookaroundAdmittedState(n))},
    {selected_origin: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    failure_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), failure_whole, failure_origin),
    failure_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, failure_origin),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current),
    same_case: () -> Empty,
    later_case: () -> Empty,
    reverse_case: (AtomicPathStrictCursorSuffix(n, selected_current, failure_current)) -> Empty
  ) -> Empty = match atomic_path_cursor_location(
    failure_whole,
    failure_suffix,
    atomic_path_failed_selected_child_suffix(
      failure_origin_equivalence,
      failure_origin_canonical,
      selected_origin_canonical,
      selected_suffix
    )
  )
    AtomicPathCursorLocationSame(_) -> same_case()
    AtomicPathCursorLocationLeftAfter(strict) -> reverse_case(strict)
    AtomicPathCursorLocationRightAfter(_) -> later_case()

  fn atomic_path_active_child_alignment(
    {n: Nat},
    {failure_whole: List(LookaroundAdmittedState(n))},
    {failure_current: List(LookaroundAdmittedState(n))},
    {failure_head: LookaroundAdmittedState(n)},
    {failure_tail: List(LookaroundAdmittedState(n))},
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      Cons(failure_head, failure_tail)
    ),
    {selected_whole: List(LookaroundAdmittedState(n))},
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)
  ) -> AtomicPathActiveChildAlignment(n, failure_head, failure_tail, failure_current, selected_current) =
    let anchored_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      Cons(failure_head, failure_tail),
      selected_whole
    ) = trans(
      sym(failure_nonempty_equivalence),
      selected_whole_equivalence
    )
    match atomic_child_cursor_alignment(
      failure_suffix,
      selected_whole_equivalence,
      selected_suffix
    )
      LookaroundAdmittedCursorLeftToRight(alignment) -> match atomic_path_selected_child_suffix_location(
        transport_lookaround_admitted_cursor_suffix_outer(
          anchored_equivalence,
          selected_suffix
        )
      )
        AtomicPathSelectedChildHere(candidate_value, remaining_value) -> AtomicPathActiveChildAlignmentHere(alignment)
        AtomicPathSelectedChildThere(candidate_value, suffix_value) -> AtomicPathActiveChildAlignmentThere(alignment, suffix_value)
      LookaroundAdmittedCursorRightToLeft(alignment) -> AtomicPathActiveChildAlignmentReverse(alignment)

  fn lookaround_admitted_cursor_suffix_alignment(
    {n: Nat},
    {outer: List(LookaroundAdmittedState(n))},
    {left: List(LookaroundAdmittedState(n))},
    {right: List(LookaroundAdmittedState(n))},
    left_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, left),
    right_suffix: LookaroundAdmittedStateCursorSuffix(n, outer, right)
  ) -> LookaroundAdmittedStateCursorAlignment(n, left, right) = match left_suffix
    LookaroundAdmittedStateCursorSuffixHere(left_equality) -> match left_equality
      reflexive() -> match right_suffix
        LookaroundAdmittedStateCursorSuffixHere(right_equality) -> match right_equality
          reflexive() -> LookaroundAdmittedCursorLeftToRight(LookaroundAdmittedStateCursorSuffixHere(reflexive(left)))
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> LookaroundAdmittedCursorLeftToRight(right_suffix)
    LookaroundAdmittedStateCursorSuffixDrop(_, left_prior) -> match right_suffix
      LookaroundAdmittedStateCursorSuffixHere(right_equality) -> match right_equality
        reflexive() -> LookaroundAdmittedCursorRightToLeft(left_suffix)
      LookaroundAdmittedStateCursorSuffixDrop(_, right_prior) -> lookaround_admitted_cursor_suffix_alignment(left_prior, right_prior)




  ## Proper suffix is asymmetric.  Composing the ordinary forward suffix
  ## stored by the strict witness with a hypothetical reverse suffix would
  ## make `head :: tail` a suffix of `tail`, which the finite-list lemma above
  ## eliminates.
  @reducible
  fn atomic_path_strict_cursor_suffix_excludes_reverse(
    {n: Nat},
    {outer: List(LookaroundAdmittedState(n))},
    {inner: List(LookaroundAdmittedState(n))},
    strict: AtomicPathStrictCursorSuffix(n, outer, inner),
    reverse: LookaroundAdmittedStateCursorSuffix(n, inner, outer)
  ) -> Empty = match strict
    AtomicPathStrictCursorSuffixDrop(head, tail, forward) -> atomic_path_cons_cannot_be_suffix_of_its_tail(
      head,
      tail,
      lookaround_admitted_cursor_suffix_compose(forward, reverse)
    )

  ## A single skipped candidate leaves no ambiguous tail case. After dropping
  ## that head, a selected cursor in `current` cannot also be strictly before
  ## `current`. Mixed skipped-prefix consumption uses this as its one-element
  ## base before handling the escaped-commit or rejected-head constructor.
  @reducible
  fn atomic_path_skipped_one_tail_excludes_strict_selection(
    {n: Nat},
    {current: List(LookaroundAdmittedState(n))},
    {selected: List(LookaroundAdmittedState(n))},
    reverse: LookaroundAdmittedStateCursorSuffix(n, current, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current)
  ) -> Empty = atomic_path_strict_cursor_suffix_excludes_reverse(strict, reverse)

  ## A root failure exposes the canonical whole list unchanged. A selected
  ## cursor strictly before that root would therefore make the whole list both
  ## a suffix and a proper prefix of the selected cursor, contradicting strict
  ## cursor asymmetry before any candidate-level refutation is inspected.
  @reducible
  fn atomic_path_root_failure_excludes_strictly_prior_cursor(
    {n: Nat},
    whole: List(LookaroundAdmittedState(n)),
    current: List(LookaroundAdmittedState(n)),
    selected: List(LookaroundAdmittedState(n)),
    @erased equality: Equivalent(List(LookaroundAdmittedState(n)), whole, current),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current)
  ) -> Empty = match equality
    reflexive() -> atomic_path_strict_cursor_suffix_excludes_reverse(strict, selected_suffix)



























  ## An active thread cannot have an accepting path over an empty input.
  ## Keeping this contradiction at the typed path boundary prevents a later
  ## refutation proof from accidentally treating an unconsumed active state as
  ## terminally accepted.
  fn impossible_lookaround_empty_active_path({@erased depth: Nat}, n: Nat, machine: PatternMachine(n), {@erased after_input: List(Char)}, source: Bounded(n), {@erased history: List(Char)}, {@erased capture_context: List(EvidenceInstruction)}, {@erased policy: NewlinePolicy}, {@erased candidates: List(MachineState(n))}, {result: Type}, path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Nil(), after_input, ThreadActive(source), history, policy)) -> result = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible























  fn lookaround_accepting_path_now(depth: Nat, n: Nat, machine: PatternMachine(n), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundAcceptingPathResult(depth, n, machine, Nil(), after_input, ThreadAccepted(), history, policy, capture_context) =
    let path: LookaroundAcceptingPath(depth, n, machine, capture_context, empty_machine_states(n), Nil(), after_input, ThreadAccepted(), history, policy) = LookaroundAcceptedNow()
    LookaroundAcceptingPathFoundAccepted(reflexive(empty_characters()), MachineStateCursorSuffixHere(reflexive(empty_machine_states(n))), path)

  fn lookaround_accepting_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundAcceptingPathResult(depth, n, machine, input, after_input, state, history, policy, capture_context) = match input
    [] -> match state
      ThreadAccepted() -> lookaround_accepting_path_now(depth, n, machine, after_input, history, capture_context, policy)
      ThreadActive(source) ->
        let cursor: MachineStateCursor(n, empty_machine_states(n), empty_machine_states(n)) = MachineStateCursorHere()
        LookaroundAcceptingPathRejectedEmpty(source, cursor, lookaround_path_exhausted(depth, n, machine, after_input, source, history, capture_context, policy, empty_machine_states(n), MachineStateMembersNil(), cursor, reflexive(empty_machine_states(n))))
    [char | rest] -> match state
      ThreadAccepted() -> LookaroundAcceptingPathRejectedAcceptedStep(char, rest, MachineStateCursorHere(), lookaround_path_accepted_with_input(depth, n, machine, char, rest, after_input, history, capture_context, policy))
      ThreadActive(source) -> match lookaround_accepting_members_path(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, machine_state_members(lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), MachineStateCursorHere())
        LookaroundAcceptingMembersRejected(failure, cursor) -> LookaroundAcceptingPathRejectedStep(source, char, rest, cursor, failure)
        LookaroundAcceptingMembersFound(cursor_suffix, path) -> LookaroundAcceptingPathFoundActive(source, char, rest, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), reflexive(lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), cursor_suffix, path)

