    AtomicPathRejectedSkippedHeadPacked(evidence) -> match evidence
      AtomicPathSkippedRejectedCons(_, _, _, _, _, _, _, child_scope_alignment, _, _, _, _, _, _, _, _, child_failure, _, _, _, _) -> match child_scope_alignment
        LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match path
          AtomicSelectedPrefixDone() -> impossible
          AtomicSelectedExactDone() -> impossible
          AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_trace) -> match child_failure
