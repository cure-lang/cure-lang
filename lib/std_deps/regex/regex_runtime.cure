        LookaroundPrefixMembersFound(tail_suffix, path) -> LookaroundPrefixMembersFound(MachineStateCursorSuffixDrop(Active(destination, routine, constraints), tail_suffix), path)
      LookaroundPrefixPathRejectedStep(_, child_char, child_rest, _, child_failure) -> match lookaround_prefix_members_path(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, remaining, MachineStateCursorDrop(Active(destination, routine, constraints), cursor))
        LookaroundPrefixMembersRejected(_, tail_failure, _) -> LookaroundPrefixMembersRejected(source, lookaround_prefix_destination_active_rejected(depth, n, machine, char, child_char, child_rest, after_input, source, history, capture_context, policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, Cons(child_char, child_rest), after_input, history, capture_context, policy), destination, routine, constraints, child_failure, tail_failure, MachineStateMembersActive(destination, routine, constraints, edge, remaining), cursor, reflexive(lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, Cons(child_char, child_rest), after_input, history, capture_context, policy))), cursor)
        LookaroundPrefixMembersFound(tail_suffix, path) -> LookaroundPrefixMembersFound(MachineStateCursorSuffixDrop(Active(destination, routine, constraints), tail_suffix), path)
      LookaroundPrefixPathFoundActive(_, child_char, child_rest, child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix) -> match child_destinations_equivalent
        reflexive() -> LookaroundPrefixMembersFound(MachineStateCursorSuffixHere(reflexive(current)), lookaround_prefix_step_active(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, destination, routine, constraints, edge, MachineStateMembersActive(destination, routine, constraints, edge, remaining), cursor, child_char, child_rest, reflexive(rest), child_destinations, reflexive(child_destinations), child_cursor_suffix, suffix))
    MachineStateMembersAccepted(routine, constraints, edge, remaining) -> match lookaround_prefix_path(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy)
      LookaroundPrefixPathFoundAccepted(suffix) -> LookaroundPrefixMembersFound(MachineStateCursorSuffixHere(reflexive(current)), lookaround_prefix_step_accepted(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, routine, constraints, edge, MachineStateMembersAccepted(routine, constraints, edge, remaining), cursor, MachineStateCursorSuffixHere(reflexive(empty_machine_states(n))), suffix))

  type LookaroundSearchPath(depth: Nat, n: Nat, machine: PatternMachine(n), capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy)
    LookaroundSearchFoundActive : (char: Char) -> (rest: List(Char)) -> (input_equivalent: Equivalent(List(Char), input, Cons(char, rest))) -> (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(state), char, rest, after_input, history, append_routine(capture_context, routine), policy), candidates)) -> (path: LookaroundAcceptingPath(depth, n, machine, append_routine(capture_context, routine), candidates, Cons(char, rest), after_input, ThreadActive(state), history, policy)) -> LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
    LookaroundSearchFoundAccepted : (input_equivalent: Equivalent(List(Char), input, Nil())) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member: ListMember(MachineState(n), Accepted(routine, constraints), starts)) -> (cursor_suffix: MachineStateCursorSuffix(n, Nil(), Nil())) -> (path: LookaroundAcceptingPath(depth, n, machine, append_routine(capture_context, routine), Nil(), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)

  fn lookaround_search_found_accepted(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), input_equivalent: Equivalent(List(Char), input, Nil()), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), member: ListMember(MachineState(n), Accepted(routine, constraints), starts), cursor_suffix: MachineStateCursorSuffix(n, Nil(), Nil()), path: LookaroundAcceptingPath(depth, n, machine, append_routine(capture_context, routine), Nil(), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy) = LookaroundSearchFoundAccepted(input_equivalent, routine, constraints, member, cursor_suffix, path)

  fn lookaround_search_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n))) -> LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context) = match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, machine_state_members(starts), MachineStateCursorHere())
    LookaroundSearchMembersRejected(failure) -> LookaroundSearchResultRejected(failure)
    LookaroundSearchMembersFound(path) -> LookaroundSearchResultFound(path)

  fn lookaround_search_path_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), {current: List(MachineState(n))}, members: MachineStateMembers(n, starts, current), @erased cursor: MachineStateCursor(n, starts, current)) -> LookaroundSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context) = match members
    MachineStateMembersNil() -> LookaroundSearchMembersRejected(lookaround_search_exhausted(depth, n, machine, input, after_input, history, capture_context, policy, starts, MachineStateMembersNil(), cursor))
    MachineStateMembersActive(state, routine, constraints, member, remaining) -> match lookaround_accepting_path(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy)
      LookaroundAcceptingPathRejectedEmpty(_, _, child_failure) -> match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundSearchMembersRejected(tail_failure) -> LookaroundSearchMembersRejected(lookaround_search_active_rejected_empty(depth, n, machine, after_input, history, capture_context, policy, starts, state, routine, constraints, member, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundSearchMembersFound(path) -> LookaroundSearchMembersFound(path)
      LookaroundAcceptingPathRejectedStep(_, char, rest, _, child_failure) -> match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundSearchMembersRejected(tail_failure) -> LookaroundSearchMembersRejected(lookaround_search_active_rejected_step(depth, n, machine, char, rest, after_input, history, capture_context, policy, starts, state, routine, constraints, member, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundSearchMembersFound(path) -> LookaroundSearchMembersFound(path)
      LookaroundAcceptingPathFoundActive(_, char, rest, _, destinations_equivalent, cursor_suffix, path) -> match destinations_equivalent
        reflexive() -> LookaroundSearchMembersFound(LookaroundSearchFoundActive(char, rest, reflexive(Cons(char, rest)), state, routine, constraints, member, cursor_suffix, path))
    MachineStateMembersAccepted(routine, constraints, member, remaining) -> match lookaround_accepting_path(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy)
      LookaroundAcceptingPathRejectedAcceptedStep(char, rest, _, child_failure) -> match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Accepted(routine, constraints), cursor))
        LookaroundSearchMembersRejected(tail_failure) -> LookaroundSearchMembersRejected(lookaround_search_accepted_rejected(depth, n, machine, char, rest, after_input, history, capture_context, policy, starts, routine, constraints, member, child_failure, tail_failure, MachineStateMembersAccepted(routine, constraints, member, remaining), cursor))
        LookaroundSearchMembersFound(path) -> LookaroundSearchMembersFound(path)
      LookaroundAcceptingPathFoundAccepted(input_equivalent, cursor_suffix, path) -> LookaroundSearchMembersFound(lookaround_search_found_accepted(depth, n, machine, input, after_input, history, capture_context, policy, starts, input_equivalent, routine, constraints, member, cursor_suffix, path))

  type LookaroundPrefixSearchPath(depth: Nat, n: Nat, machine: PatternMachine(n), capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy)
    LookaroundPrefixSearchFoundActive : (char: Char) -> (rest: List(Char)) -> (input_equivalent: Equivalent(List(Char), input, Cons(char, rest))) -> (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(state), char, rest, after_input, history, append_routine(capture_context, routine), policy), candidates)) -> (path: LookaroundPrefixPath(depth, n, machine, append_routine(capture_context, routine), candidates, Cons(char, rest), after_input, ThreadActive(state), history, policy)) -> LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
    LookaroundPrefixSearchFoundAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member: ListMember(MachineState(n), Accepted(routine, constraints), starts)) -> (path: LookaroundPrefixPath(depth, n, machine, append_routine(capture_context, routine), Nil(), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)

  type LookaroundAcceptingPathResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundAcceptingPathRejectedEmpty : (source: Bounded(n)) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (failure: LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, Nil(), Nil())) -> LookaroundAcceptingPathResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundAcceptingPathRejectedStep : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (failure: LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> LookaroundAcceptingPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundAcceptingPathRejectedAcceptedStep : (char: Char) -> (rest: List(Char)) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (failure: LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, Nil(), Nil())) -> LookaroundAcceptingPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, policy, capture_context)
    LookaroundAcceptingPathFoundActive : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased destinations: List(MachineState(n))) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, destinations, candidates)) -> (path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, ThreadActive(source), history, policy)) -> LookaroundAcceptingPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundAcceptingPathFoundAccepted : (input_equivalent: Equivalent(List(Char), input, Nil())) -> (cursor_suffix: MachineStateCursorSuffix(n, empty_machine_states(n), empty_machine_states(n))) -> (path: LookaroundAcceptingPath(depth, n, machine, capture_context, empty_machine_states(n), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundAcceptingPathResult(depth, n, machine, input, after_input, ThreadAccepted(), history, policy, capture_context)

  ## Internal result for a destination-list traversal. Unlike the public result
  ## above, this carries the full destination list as a parameter, so recursive
  ## tail failures cannot escape as an unconstrained existential.
  type LookaroundAcceptingMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), destinations: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundAcceptingMembersRejected : (failure: LookaroundPathFailure(depth, n, machine, input, after_input, state, history, capture_context, policy, destinations, current)) -> (@erased cursor: MachineStateCursor(n, destinations, current)) -> LookaroundAcceptingMembersResult(depth, n, machine, destinations, current, input, after_input, state, history, policy, capture_context)
    LookaroundAcceptingMembersFound : {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, current, candidates)) -> (path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, state, history, policy)) -> LookaroundAcceptingMembersResult(depth, n, machine, destinations, current, input, after_input, state, history, policy, capture_context)

  type LookaroundPrefixMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), destinations: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixMembersRejected : (source: Bounded(n)) -> (failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, destinations, current)) -> (@erased cursor: MachineStateCursor(n, destinations, current)) -> LookaroundPrefixMembersResult(depth, n, machine, destinations, current, input, after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixMembersFound : {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, current, candidates)) -> (path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, input, after_input, state, history, policy)) -> LookaroundPrefixMembersResult(depth, n, machine, destinations, current, input, after_input, state, history, policy, capture_context)

  type LookaroundPrefixPathResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixPathRejectedEmpty : (source: Bounded(n)) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (failure: LookaroundPrefixPathFailure(depth, n, machine, Nil(), after_input, source, history, capture_context, policy, Nil(), Nil())) -> LookaroundPrefixPathResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixPathRejectedStep : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (failure: LookaroundPrefixPathFailure(depth, n, machine, Cons(char, rest), after_input, source, history, capture_context, policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> LookaroundPrefixPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixPathFoundActive : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased destinations: List(MachineState(n))) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, destinations, candidates)) -> (path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, ThreadActive(source), history, policy)) -> LookaroundPrefixPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixPathFoundAccepted : (path: LookaroundPrefixPath(depth, n, machine, capture_context, Nil(), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundPrefixPathResult(depth, n, machine, input, after_input, ThreadAccepted(), history, policy, capture_context)

  type LookaroundSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundSearchResultRejected : (failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)
    LookaroundSearchResultFound : (path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)

  type LookaroundSearchMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundSearchMembersRejected : (failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current)) -> LookaroundSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)
    LookaroundSearchMembersFound : (path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)

  type LookaroundPrefixSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixSearchResultRejected : (failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)
    LookaroundPrefixSearchResultFound : (path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)

  ## Constructive completeness is indexed by the evaluator result itself.  The
  ## start list is a result parameter rather than a hidden constructor
  ## existential, so an independent path/failure and the computed branch share
  ## one canonical identity.
  type LookaroundSearchPathCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundSearchPathComplete : (path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundSearchResultFound(path))

  type LookaroundSearchRefutationCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundSearchRefutationComplete : (failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundSearchResultRejected(failure))

  type LookaroundPrefixSearchPathCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundPrefixSearchPathComplete : (path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundPrefixSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundPrefixSearchResultFound(path))

  type LookaroundPrefixSearchRefutationCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundPrefixSearchRefutationComplete : (failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundPrefixSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundPrefixSearchResultRejected(failure))

  type LookaroundPrefixSearchMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixSearchMembersRejected : (failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current)) -> LookaroundPrefixSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)
    LookaroundPrefixSearchMembersFound : (path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundPrefixSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)

  ## The empty start list has no accepting path.  This is the base case used
  ## by the refutation-tree soundness proof: every search-path
  ## constructor carries a membership witness in `starts`, so `starts = []`
  ## is eliminated constructively rather than treated as an unchecked claim.
  fn lookaround_impossible_list_member({item_type: Type}, {item: item_type}, {result: Type}, @erased membership: ListMember(item_type, item, Nil())) -> result = match membership

  fn lookaround_impossible_empty_candidate_equivalence({n: Nat}, {state: MachineState(n)}, {values: List(MachineState(n))}, @erased equality: Equivalent(List(MachineState(n)), empty_machine_states(n), Cons(state, values))) -> Empty = match equality
    reflexive() -> impossible

  ## Compose the erased candidate-list equation with the path's erased
  ## candidate equation without routing either proof through `trans/2`.
  ## `trans` has runtime proof arguments in the generic equality module; using
  ## it here would make a genuinely erased certificate relevant. Matching the
  ## two identity proofs directly keeps this refutation proof erased end-to-end.
  fn lookaround_impossible_accepted_active_candidates(
    {n: Nat},
    {accepted_routine: List(EvidenceInstruction)},
    {accepted_constraints: List(BoundaryConstraint)},
    {@erased accepted_values: List(MachineState(n))},
    {active_destination: Bounded(n)},
    {active_routine: List(EvidenceInstruction)},
    {active_constraints: List(BoundaryConstraint)},
    {@erased active_values: List(MachineState(n))},
    {@erased candidates: List(MachineState(n))},
    @erased accepted_to_candidates: Equivalent(
      List(MachineState(n)),
      Cons(Accepted(accepted_routine, accepted_constraints), accepted_values),
      candidates
    ),
    @erased candidates_to_active: Equivalent(
      List(MachineState(n)),
      candidates,
      Cons(Active(active_destination, active_routine, active_constraints), active_values)
    )
  ) -> Empty = match accepted_to_candidates
    reflexive() -> match candidates_to_active
      reflexive() -> impossible

  fn lookaround_impossible_active_accepted_candidates(
    {n: Nat},
    {active_destination: Bounded(n)},
    {active_routine: List(EvidenceInstruction)},
    {active_constraints: List(BoundaryConstraint)},
    {@erased active_values: List(MachineState(n))},
    {accepted_routine: List(EvidenceInstruction)},
    {accepted_constraints: List(BoundaryConstraint)},
    {@erased accepted_values: List(MachineState(n))},
    {@erased candidates: List(MachineState(n))},
    @erased active_to_candidates: Equivalent(
      List(MachineState(n)),
      Cons(Active(active_destination, active_routine, active_constraints), active_values),
      candidates
    ),
    @erased candidates_to_accepted: Equivalent(
      List(MachineState(n)),
      candidates,
      Cons(Accepted(accepted_routine, accepted_constraints), accepted_values)
    )
  ) -> Empty = match active_to_candidates
    reflexive() -> match candidates_to_accepted
      reflexive() -> impossible

  fn lookaround_search_path_excludes_empty_starts(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, {result: Type}, path: LookaroundSearchPath(depth, n, machine, capture_context, Nil(), input, after_input, history, policy)) -> result = match path
    LookaroundSearchFoundActive(_, _, _, _, _, _, member, _, _) -> lookaround_impossible_list_member(member)
    LookaroundSearchFoundAccepted(_, _, _, member, _, _) -> lookaround_impossible_list_member(member)

  fn lookaround_search_failure_excludes_empty_starts(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, {result: Type}, failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, Nil(), Nil()), path: LookaroundSearchPath(depth, n, machine, capture_context, Nil(), input, after_input, history, policy)) -> result = match failure
    LookaroundSearchExhausted(_, _) -> lookaround_search_path_excludes_empty_starts(depth, n, machine, input, after_input, history, capture_context, policy, path)

  ## A complete search rejection excludes every accepting start path in the
  ## current suffix.  Both sides descend through the same list spine: `Here`
  ## consumes the rejected child certificate, while `There` consumes the tail
  ## search certificate.  The failure index prevents either branch from
  ## silently reusing a certificate for a different start-list suffix.
  fn lookaround_search_failure_excludes_path(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    {starts: List(MachineState(n))},
    {current: List(MachineState(n))},
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current),
    path: LookaroundSearchPath(depth, n, machine, capture_context, current, input, after_input, history, policy)
  ) -> Empty = match failure
    LookaroundSearchExhausted(_, _) -> lookaround_search_path_excludes_empty_starts(depth, n, machine, input, after_input, history, capture_context, policy, path)
    LookaroundSearchActiveRejectedEmpty(_, _, _, _, _, _, _, tail_failure) -> match path
      LookaroundSearchFoundActive(_, _, input_equivalent, _, _, _, _, _, _) -> match input_equivalent
      LookaroundSearchFoundAccepted(input_equivalent, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> impossible
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundAccepted(reflexive(empty_characters()), path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
    LookaroundSearchActiveRejectedStep(_, _, state, routine, constraints, _, _, _, child_failure, tail_failure) -> match path
      LookaroundSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> lookaround_path_failure_recurse_child(
            n,
            machine,
            input,
            state,
            child_failure,
            cursor_suffix,
            child_path
          )
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
      LookaroundSearchFoundAccepted(input_equivalent, _, _, _, _, _) -> match input_equivalent
    LookaroundSearchAcceptedRejected(_, _, routine, constraints, _, _, _, _, tail_failure) -> match path
      LookaroundSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> impossible
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
      LookaroundSearchFoundAccepted(input_equivalent, _, _, _, _, _) -> match input_equivalent

  fn lookaround_path_failure_excludes_accepting_path({@erased depth: Nat}, n: Nat, machine: PatternMachine(n), input: List(Char), {@erased after_input: List(Char)}, state: ThreadState(n), {@erased history: List(Char)}, {@erased capture_context: List(EvidenceInstruction)}, {@erased policy: NewlinePolicy}, @erased destinations: List(MachineState(n)), failure: LookaroundPathFailure(depth, n, machine, input, after_input, state, history, capture_context, policy, destinations, Nil()), path: LookaroundAcceptingPath(depth, n, machine, capture_context, Nil(), input, after_input, state, history, policy)) -> Empty = match failure
    LookaroundPathExhausted(_, source, _, _, _, _) -> impossible_lookaround_empty_active_path(n, machine, source, path)
    LookaroundPathStepExhausted(_, _, _, _, _, _, _, _) -> match path
      LookaroundAcceptedNow() -> impossible
      LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, _, _, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)
      LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, candidate_equivalent, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)
    LookaroundPathAcceptedWithInput(_, _, _) -> match path
      LookaroundAcceptedNow() -> impossible
      LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## The child failure stores the same destination list as both of its cursor
  ## indices.  Name that hidden list at one construction site so the recursive
  ## suffix proof can construct its canonical `Here` cursor without leaving an
  ## implicit index for the elaborator to guess.
  fn lookaround_path_failure_recurse_child(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_destinations: List(MachineState(n))},
    child_failure: LookaroundPathFailure(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, child_destinations, child_destinations),
    {@erased candidates: List(MachineState(n))},
    child_cursor_suffix: MachineStateCursorSuffix(n, child_destinations, candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty =
    lookaround_path_failure_excludes_accepting_suffix(n, machine, input, source, child_destinations, child_destinations, child_failure, candidates, child_cursor_suffix, path)

  fn lookaround_path_failure_recurse_accepted_child(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    rest: List(Char),
    {@erased after_input: List(Char)},
    {@erased child_history: List(Char)},
    {@erased child_capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    child_failure: LookaroundPathFailure(depth, n, machine, rest, after_input, ThreadAccepted(), child_history, child_capture_context, policy, empty_machine_states(n), empty_machine_states(n)),
    child_cursor_suffix: MachineStateCursorSuffix(n, empty_machine_states(n), empty_machine_states(n)),
    suffix: LookaroundAcceptingPath(depth, n, machine, child_capture_context, empty_machine_states(n), rest, after_input, ThreadAccepted(), child_history, policy)
  ) -> Empty =
    lookaround_path_failure_excludes_accepting_path(n, machine, rest, ThreadAccepted(), empty_machine_states(n), child_failure, suffix)

  fn lookaround_path_failure_active_rejected_empty_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    @erased after_input: List(Char),
    @erased source: ThreadState(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, Nil()), after_input, source, history, policy)
  ) -> Empty = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, _, _, _, _) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
          reflexive() -> impossible
    LookaroundAcceptedNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_path_failure_active_rejected_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    @erased after_input: List(Char),
    @erased source: ThreadState(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    child_failure: LookaroundPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy)),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, Cons(child_char, child_rest)), after_input, source, history, policy)
  ) -> Empty = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
          reflexive() -> match child_destinations_equivalent
            reflexive() -> lookaround_path_failure_recurse_child(n, machine, Cons(child_char, child_rest), destination, child_failure, child_cursor_suffix, suffix)
    LookaroundAcceptedNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_path_failure_accepted_rejected_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    @erased after_input: List(Char),
    @erased source: ThreadState(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    child_failure: LookaroundPathFailure(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, empty_machine_states(n), empty_machine_states(n)),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Accepted(routine, constraints), remaining_destinations), candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, source, history, policy)
  ) -> Empty = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, active_destination, active_routine, active_constraints, _, _, _, candidate_equivalent, _, _, _, _, _, _, _, _) ->
      lookaround_impossible_accepted_active_candidates(equality, candidate_equivalent)
    LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, candidate_equivalent, _, child_cursor_suffix, suffix) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> lookaround_path_failure_recurse_accepted_child(n, machine, rest, child_failure, child_cursor_suffix, suffix)

  ## Consume the complete cursor/suffix relation carried by a recursive path
  ## failure. A `Here` suffix means the candidate path must inspect the current
  ## destination head, so the corresponding child failure is recursed into. A
  ## `Drop` suffix means the path starts later in the list; the parent head is
  ## skipped and the tail failure is the induction step.
  ##
  ## The consuming path constructors carry an `Equivalent` proof for their
  ## candidate list. Matching its only constructor normalizes the candidate
  ## list to the same head/tail spine as the failure before descending. The
  ## opposite edge constructor is impossible when the failure head is indexed
  ## as `Active` or `Accepted`, and is discharged constructively.
  fn lookaround_path_failure_excludes_accepting_suffix(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    @erased destinations: List(MachineState(n)),
    @erased remaining_destinations: List(MachineState(n)),
    failure: LookaroundPathFailure(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, destinations, remaining_destinations),
    @erased candidates: List(MachineState(n)),
    candidate_suffix: MachineStateCursorSuffix(n, remaining_destinations, candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty = match input
    [] -> match failure
      LookaroundPathExhausted(_, source, _, _, _, remaining_equivalent) -> match remaining_equivalent
        reflexive() -> match candidate_suffix
          MachineStateCursorSuffixHere(equality) -> match equality
            reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, empty_characters(), ThreadActive(source), destinations, failure, path)
    [char | rest] -> match rest
      [] -> match failure
        LookaroundPathStepExhausted(_, _, _, _, _, _, _, remaining_equivalent) -> match remaining_equivalent
          reflexive() -> match candidate_suffix
            MachineStateCursorSuffixHere(equality) -> match equality
              reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, Cons(char, empty_characters()), ThreadActive(source), destinations, failure, path)
        LookaroundPathDestinationActiveRejectedEmpty(tail_destinations, _, destination, routine, constraints, _, _, _, _, _, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, empty_characters()), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_active_rejected_empty_here(n, machine, char, after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, destination, routine, constraints, candidates, equality, path)
        LookaroundPathDestinationAcceptedRejected(tail_destinations, _, _, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, empty_characters()), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_accepted_rejected_here(n, machine, char, empty_characters(), after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, routine, constraints, child_failure, candidates, equality, path)
      [child_char | child_rest] -> match failure
        LookaroundPathStepExhausted(_, _, _, _, _, _, _, remaining_equivalent) -> match remaining_equivalent
          reflexive() -> match candidate_suffix
            MachineStateCursorSuffixHere(equality) -> match equality
              reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, Cons(char, Cons(child_char, child_rest)), ThreadActive(source), destinations, failure, path)
        LookaroundPathDestinationActiveRejected(tail_destinations, _, _, _, destination, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_active_rejected_here(n, machine, char, child_char, child_rest, after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, destination, routine, constraints, child_failure, candidates, equality, path)
        LookaroundPathDestinationAcceptedRejected(tail_destinations, _, _, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_accepted_rejected_here(n, machine, char, Cons(child_char, child_rest), after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, routine, constraints, child_failure, candidates, equality, path)

  ## Prefix acceptance is intentionally different from exact acceptance: an
  ## accepted thread succeeds immediately, even when input remains.  Its
  ## rejection proof therefore uses the smaller prefix-only failure family and
  ## has no accepted-with-input or accepted-destination rejection cases.
  fn lookaround_prefix_empty_active_path_impossible(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased candidates: List(MachineState(n))},
    {result: Type},
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Nil(), after_input, ThreadActive(source), history, policy)
  ) -> result = match path
    LookaroundPrefixAccepted() -> impossible
    LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    LookaroundPrefixNextAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  fn lookaround_prefix_failure_excludes_empty_candidates(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    @erased destinations: List(MachineState(n)),
    failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, destinations, Nil()),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, Nil(), input, after_input, ThreadActive(source), history, policy)
  ) -> Empty = match failure
    LookaroundPrefixPathExhausted(source, _, _, _) -> lookaround_prefix_empty_active_path_impossible(n, machine, source, path)
    LookaroundPrefixPathStepExhausted(_, _, _, _, _, _) -> match path
      LookaroundPrefixAccepted() -> impossible
      LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, _, _, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)
      LookaroundPrefixNextAccepted(_, _, _, _, _, _, _, _, candidate_equivalent, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)

  fn lookaround_prefix_failure_active_empty_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    @erased after_input: List(Char),
    source: Bounded(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Cons(char, Nil()), after_input, ThreadActive(source), history, policy)
  ) -> Empty = match path
    LookaroundPrefixAccepted() -> impossible
    LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, _, _, _, _) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
    LookaroundPrefixNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_prefix_failure_recurse_child(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_destinations: List(MachineState(n))},
    child_failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, child_destinations, child_destinations),
    {@erased candidates: List(MachineState(n))},
    child_cursor_suffix: MachineStateCursorSuffix(n, child_destinations, candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty =
    lookaround_prefix_failure_excludes_suffix(n, machine, input, after_input, source, history, capture_context, policy, child_destinations, child_destinations, child_failure, child_cursor_suffix, path)

  fn lookaround_prefix_failure_active_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    @erased after_input: List(Char),
    source: Bounded(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    child_failure: LookaroundPrefixPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, destination, history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy)),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Cons(char, Cons(child_char, child_rest)), after_input, ThreadActive(source), history, policy)
  ) -> Empty = match path
    LookaroundPrefixAccepted() -> impossible
    LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
          reflexive() -> match child_destinations_equivalent
            reflexive() -> lookaround_prefix_failure_recurse_child(n, machine, Cons(child_char, child_rest), destination, child_failure, child_cursor_suffix, suffix)
    LookaroundPrefixNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_prefix_failure_excludes_suffix(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    @erased after_input: List(Char),
    source: Bounded(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased destinations: List(MachineState(n)),
    @erased remaining_destinations: List(MachineState(n)),
    failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, destinations, remaining_destinations),
    {@erased candidates: List(MachineState(n))},
    candidate_suffix: MachineStateCursorSuffix(n, remaining_destinations, candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty = match input
    [] -> match failure
      LookaroundPrefixPathExhausted(_, _, _, _) -> match candidate_suffix
        MachineStateCursorSuffixHere(equality) -> match equality
          reflexive() -> lookaround_prefix_failure_excludes_empty_candidates(n, machine, empty_characters(), source, destinations, failure, path)
    [char | rest] -> match rest
      [] -> match failure
        LookaroundPrefixPathStepExhausted(_, _, _, _, _, _) -> match candidate_suffix
          MachineStateCursorSuffixHere(equality) -> match equality
            reflexive() -> lookaround_prefix_failure_excludes_empty_candidates(n, machine, Cons(char, empty_characters()), source, destinations, failure, path)
        LookaroundPrefixDestinationActiveRejectedEmpty(tail_destinations, _, _, destination, routine, constraints, _, _, _, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_prefix_failure_excludes_suffix(n, machine, Cons(char, empty_characters()), after_input, source, history, capture_context, policy, destinations, tail_destinations, tail_failure, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_prefix_failure_active_empty_here(n, machine, char, after_input, source, history, capture_context, policy, tail_destinations, destination, routine, constraints, candidates, equality, path)
      [child_char | child_rest] -> match failure
        LookaroundPrefixPathStepExhausted(_, _, _, _, _, _) -> match candidate_suffix
          MachineStateCursorSuffixHere(equality) -> match equality
            reflexive() -> lookaround_prefix_failure_excludes_empty_candidates(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, failure, path)
        LookaroundPrefixDestinationActiveRejected(tail_destinations, _, _, _, _, destination, routine, constraints, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_prefix_failure_excludes_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), after_input, source, history, capture_context, policy, destinations, tail_destinations, tail_failure, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_prefix_failure_active_here(n, machine, char, child_char, child_rest, after_input, source, history, capture_context, policy, tail_destinations, destination, routine, constraints, child_failure, candidates, equality, path)

  fn lookaround_prefix_search_path_excludes_empty_starts(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    capture_context: List(EvidenceInstruction),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    policy: NewlinePolicy,
    {result: Type},
    path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, Nil(), input, after_input, history, policy)
  ) -> result = match path
    LookaroundPrefixSearchFoundActive(_, _, _, _, _, _, member, _, _) -> lookaround_impossible_list_member(member)
    LookaroundPrefixSearchFoundAccepted(_, _, member, _) -> lookaround_impossible_list_member(member)

  fn lookaround_prefix_search_failure_excludes_path(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    {starts: List(MachineState(n))},
    {current: List(MachineState(n))},
    failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current),
    path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, current, input, after_input, history, policy)
  ) -> Empty = match failure
    LookaroundPrefixSearchExhausted(_, _) -> lookaround_prefix_search_path_excludes_empty_starts(depth, n, machine, capture_context, input, after_input, history, policy, path)
    LookaroundPrefixSearchActiveRejectedEmpty(_, state, routine, constraints, _, _, _, tail_failure) -> match path
      LookaroundPrefixSearchFoundActive(_, _, input_equivalent, _, _, _, _, _, _) -> match input_equivalent
      LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, member, child_path) -> match member
        ListMemberHere() -> impossible
        ListMemberThere(tail_member) -> lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, tail_failure, LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, tail_member, child_path))
    LookaroundPrefixSearchActiveRejectedStep(_, _, _, state, routine, constraints, _, _, child_failure, tail_failure) -> match path
      LookaroundPrefixSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> lookaround_prefix_failure_excludes_suffix(n, machine, input, after_input, state, history, append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(state), path_char, path_rest, after_input, history, append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(state), path_char, path_rest, after_input, history, append_routine(capture_context, routine), policy), child_failure, cursor_suffix, child_path)
          ListMemberThere(tail_member) -> lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, tail_failure, LookaroundPrefixSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path))
      LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, member, child_path) -> match member
        ListMemberHere() -> impossible
        ListMemberThere(tail_member) -> lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, tail_failure, LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, tail_member, child_path))

  fn lookaround_absurd({result: Type}, contradiction: Empty) -> result = match contradiction

  ## Converse direction for exact assertion search.  Any independently
  ## constructed accepting path rules out the evaluator's rejected branch, so
  ## the computed result is constructively known to contain a path.
  fn lookaround_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(failure) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundSearchResultFound(found_path) -> LookaroundSearchPathComplete(found_path)

  ## The dual theorem says that an independently constructed complete failure
  ## tree forces the evaluator into its rejected branch.
  fn lookaround_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(found_failure) -> LookaroundSearchRefutationComplete(found_failure)
    LookaroundSearchResultFound(path) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))

  ## Prefix/lookahead search has the same completeness pair over its smaller,
  ## active-only failure family.
  fn lookaround_prefix_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundPrefixSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundPrefixSearchResultRejected(failure) -> lookaround_absurd(lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundPrefixSearchResultFound(found_path) -> LookaroundPrefixSearchPathComplete(found_path)

  fn lookaround_prefix_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundPrefixSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundPrefixSearchResultRejected(found_failure) -> LookaroundPrefixSearchRefutationComplete(found_failure)
    LookaroundPrefixSearchResultFound(path) -> lookaround_absurd(lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))

  ## Atomic path rejection is retained as erased indexed data.  A rejected
  ## destination stores both the child failure and the remaining-sibling
  ## failure, so the start-list wrapper can carry one complete root tree.
  @reducible
  fn lookaround_admitted_state_thread({n: Nat}, state: LookaroundAdmittedState(n)) -> ThreadState(n) = match state
    LookaroundAdmittedActive(destination, _, _, _, _, _) -> ThreadActive(destination)
    LookaroundAdmittedAccepted(_, _, _, _, _) -> ThreadAccepted()

  ## The child evidence VM starts after the candidate's regular and assertion
  ## instructions have both run.  Keep that context derived from the indexed
  ## candidate rather than accepting an unrelated list at the refutation site;
  ## selected traces use the same construction for their recursive suffix.
  @reducible
  fn lookaround_admitted_state_capture_context({n: Nat}, base: List(EvidenceInstruction), state: LookaroundAdmittedState(n)) -> List(EvidenceInstruction) = match state
    LookaroundAdmittedActive(_, routine, _, _, assertion_markers, _) -> append_routine(append_routine(base, routine), assertion_markers)
    LookaroundAdmittedAccepted(routine, _, _, assertion_markers, _) -> append_routine(append_routine(base, routine), assertion_markers)

  type LookaroundAdmittedStateScope(n: Nat) indices (base: Nat, state: LookaroundAdmittedState(n), depth: Nat)
    LookaroundAdmittedStateScopeActive : (@erased state: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateScope(n, base, LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), atomic_scope_depth_after(routine, base))
    LookaroundAdmittedStateScopeAccepted : (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> LookaroundAdmittedStateScope(n, base, LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), atomic_scope_depth_after(routine, base))

  type AtomicPathRefutation(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathInputExhausted : {@erased source: Bounded(n)} -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, Nil(), Nil())) -> AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), Nil())
    AtomicPathExactAcceptedWithInput : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, Nil(), Nil())) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), Nil())
    AtomicPathDestinationsExhausted : (@erased char: Char) -> (@erased rest: List(Char)) -> {@erased source: Bounded(n)} -> {@erased whole: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Nil())) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Nil())) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil())
    AtomicPathDestinationRejected : (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased candidate: LookaroundAdmittedState(n)) -> (@erased child_scope_depth: Nat) -> {@erased source: Bounded(n)} -> {@erased whole: List(LookaroundAdmittedState(n))} -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(candidate, remaining))) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(candidate, remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), candidate, Cons(candidate, remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> {@erased child_whole: List(LookaroundAdmittedState(n))} -> {@erased child_current: List(LookaroundAdmittedState(n))} -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current)) -> (@erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth)) -> (@erased tail_failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining)) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining))

  ## A root refutation is the complete result for one candidate list.  The
  ## ordinary refutation above also represents a suffix-local result while a
  ## sibling search is still being unwound; those values must not be fed to a
  ## theorem that assumes the selected path starts at the original list head.
  ## Keeping the equality in the index makes that distinction explicit without
  ## adding any runtime certificate data.
  type AtomicPathRootRefutation(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)))
    AtomicPathRootRefutation : (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, whole)) -> AtomicPathRootRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole)

  type AtomicStartRefutation(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char))
    AtomicStartExhausted : AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)
    AtomicStartCandidateRejected : (@erased candidate: LookaroundAdmittedState(n)) -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(candidate, remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), candidate, Cons(candidate, remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_admitted_starts(depth, n, machine, position, input, after_input, history, capture_context, policy))) -> (@erased child_scope_depth: Nat) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, input, after_input, lookaround_admitted_state_thread(candidate), history, lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, reversed_prefix, child_whole, child_current)) -> (@erased tail_failure: AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)) -> AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)

  ## A decision is the only value consumed by an assertion constraint. A
  ## satisfied branch now carries an existential package containing the finite
  ## child path. Refuted branches still record the finite-search outcome (or
  ## an explicit resource/history boundary). The search refutation retains the
  ## complete child and sibling traversal tree; the remaining work is to prove
  ## its soundness and completeness against the machine semantics.
  type LookaheadRefutation(n: Nat, machine: PatternMachine(n)) indices ()
    LookaheadSearchExhausted : {@erased starts: List(MachineState(n))} -> (@erased depth: Nat) -> (input: List(Char)) -> (after_input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaheadRefutation(n, machine)
    LookaheadAtomicSearchRejected : (@erased depth: Nat) -> (position: InitialPosition) -> (input: List(Char)) -> (history: List(Char)) -> (@erased capture_context: List(EvidenceInstruction)) -> (policy: NewlinePolicy) -> (@erased failure: Option(AtomicStartRefutation(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil()))) -> (reason: LookaroundRoutineRejectionReason) -> LookaheadRefutation(n, machine)

  type LookaheadWitness(n: Nat, machine: PatternMachine(n)) indices ()
    LookaheadWitnessPacked : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> {@erased position: InitialPosition} -> {@erased depth: Nat} -> {@erased input: List(Char)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> (@erased selected_trace: AtomicSelectedTrace(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil(), matched, remaining, routine)) -> LookaheadWitness(n, machine)

  type LookaheadDecision(n: Nat, machine: PatternMachine(n)) indices ()
    LookaheadSatisfied : (witness: LookaheadWitness(n, machine)) -> LookaheadDecision(n, machine)
    LookaheadRefuted : (certificate: LookaheadRefutation(n, machine)) -> LookaheadDecision(n, machine)
    LookaheadResourceExhausted : (depth: Nat) -> (input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased exhaustion: LookaroundExhaustion(n)) -> LookaheadDecision(n, machine)

  type LookbehindRefutation(n: Nat, machine: PatternMachine(n)) indices ()
    LookbehindSearchExhausted : {@erased starts: List(MachineState(n))} -> (@erased depth: Nat) -> (input: List(Char)) -> (after_input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookbehindRefutation(n, machine)
    LookbehindHistoryUnavailable : (width: Nat) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased exhaustion: LookaroundExhaustion(n)) -> LookbehindRefutation(n, machine)
    LookbehindAtomicSearchRejected : (@erased depth: Nat) -> (position: InitialPosition) -> (input: List(Char)) -> (after_input: List(Char)) -> (history: List(Char)) -> (@erased capture_context: List(EvidenceInstruction)) -> (policy: NewlinePolicy) -> (@erased failure: Option(AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil()))) -> (reason: LookaroundRoutineRejectionReason) -> LookbehindRefutation(n, machine)

  type LookbehindWitness(n: Nat, machine: PatternMachine(n)) indices ()
    LookbehindWitnessPacked : (routine: List(ExtendedInstruction)) -> {@erased matched: List(Char)} -> {@erased remaining_input: List(Char)} -> {@erased position: InitialPosition} -> {@erased depth: Nat} -> {@erased input: List(Char)} -> {@erased after_input: List(Char)} -> {@erased history: List(Char)} -> {@erased capture_context: List(EvidenceInstruction)} -> {@erased policy: NewlinePolicy} -> (@erased selected_trace: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil(), matched, remaining_input, routine)) -> LookbehindWitness(n, machine)

  type LookbehindDecision(n: Nat, machine: PatternMachine(n)) indices ()
    LookbehindSatisfied : (witness: LookbehindWitness(n, machine)) -> LookbehindDecision(n, machine)
    LookbehindRefuted : (certificate: LookbehindRefutation(n, machine)) -> LookbehindDecision(n, machine)
    LookbehindResourceExhausted : (depth: Nat) -> (input: List(Char)) -> (history: List(Char)) -> (policy: NewlinePolicy) -> (@erased exhaustion: LookaroundExhaustion(n)) -> LookbehindDecision(n, machine)

  ## Nested assertion decisions are existentially packaged because each child
  ## machine has its own state-count index.  They are proof metadata attached
  ## to a parent path; the path constructors erase the list after checking.
  typealias LookaheadDecisionEvidence = Sigma(n: Nat, Sigma(machine: PatternMachine(n), LookaheadDecision(n, machine)))
  typealias LookbehindDecisionEvidence = Sigma(n: Nat, Sigma(machine: PatternMachine(n), LookbehindDecision(n, machine)))
  type LookaroundNestedDecision =
    | LookaheadNestedDecision(Bool, LookaheadDecisionEvidence)
    | LookbehindNestedDecision(Bool, LookbehindDecisionEvidence)

  fn lookaround_nested_decisions(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundNestedDecision) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> []
    Some(LookaroundConstraintAdmitted(_, _, decisions)) -> decisions

  fn lookaround_prefix_search_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n))) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context) = match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, machine_state_members(starts), MachineStateCursorHere())
    LookaroundPrefixSearchMembersRejected(failure) -> LookaroundPrefixSearchResultRejected(failure)
    LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchResultFound(path)

  fn lookaround_prefix_search_path_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), {current: List(MachineState(n))}, members: MachineStateMembers(n, starts, current), @erased cursor: MachineStateCursor(n, starts, current)) -> LookaroundPrefixSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context) = match members
    MachineStateMembersNil() -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_exhausted(depth, n, machine, input, after_input, history, capture_context, policy, starts, MachineStateMembersNil(), cursor))
    MachineStateMembersActive(state, routine, constraints, member, remaining) -> match lookaround_prefix_path(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy)
      LookaroundPrefixPathRejectedEmpty(_, _, child_failure) -> match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundPrefixSearchMembersRejected(tail_failure) -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_active_rejected_empty(depth, n, machine, after_input, history, capture_context, policy, starts, state, routine, constraints, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchMembersFound(path)
      LookaroundPrefixPathRejectedStep(_, char, rest, _, child_failure) -> match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundPrefixSearchMembersRejected(tail_failure) -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_active_rejected_step(depth, n, machine, char, rest, after_input, history, capture_context, policy, starts, state, routine, constraints, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchMembersFound(path)
      LookaroundPrefixPathFoundActive(_, char, rest, _, destinations_equivalent, cursor_suffix, path) -> match destinations_equivalent
        reflexive() -> LookaroundPrefixSearchMembersFound(LookaroundPrefixSearchFoundActive(char, rest, reflexive(Cons(char, rest)), state, routine, constraints, member, cursor_suffix, path))
    MachineStateMembersAccepted(routine, constraints, member, remaining) -> match lookaround_prefix_path(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy)
      LookaroundPrefixPathFoundAccepted(path) -> LookaroundPrefixSearchMembersFound(LookaroundPrefixSearchFoundAccepted(routine, constraints, member, path))

  fn lookahead_witness(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, matched: List(Char), remaining: List(Char), routine: List(ExtendedInstruction), @erased selected_trace: AtomicSelectedTrace(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil(), matched, remaining, routine)) -> LookaheadWitness(n, machine) = LookaheadWitnessPacked(matched, remaining, routine, selected_trace)

  fn lookahead_witness_routine(n: Nat, machine: PatternMachine(n), witness: LookaheadWitness(n, machine)) -> List(ExtendedInstruction) = match witness
    LookaheadWitnessPacked(matched, remaining, routine, selected_trace) -> selected_trace_routine(routine, selected_trace)

  fn lookbehind_witness(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, routine: List(ExtendedInstruction), {@erased matched: List(Char)}, {@erased remaining_input: List(Char)}, @erased selected_trace: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil(), matched, remaining_input, routine)) -> LookbehindWitness(n, machine) = LookbehindWitnessPacked(routine, selected_trace)

  fn lookbehind_witness_routine(n: Nat, machine: PatternMachine(n), witness: LookbehindWitness(n, machine)) -> List(ExtendedInstruction) = match witness
    LookbehindWitnessPacked(routine, selected_trace) -> selected_trace_routine(routine, selected_trace)

  ## The selected-trace index names the exact routine that the atomic
  ## evaluator admitted.  Replay consumers project through this helper rather
  ## than independently choosing a routine, so the capture sidecar and the
  ## checked assertion witness share one construction authority.
  fn selected_trace_routine({depth: Nat}, {n: Nat}, {machine: PatternMachine(n)}, {position: InitialPosition}, {input: List(Char)}, {after_input: List(Char)}, {history: List(Char)}, {capture_context: List(EvidenceInstruction)}, {policy: NewlinePolicy}, {prefix_mode: Bool}, {reversed_prefix: List(Char)}, {matched: List(Char)}, {remaining: List(Char)}, routine: List(ExtendedInstruction), @erased _trace: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, matched, remaining, routine)) -> List(ExtendedInstruction) = routine

  fn lookaround_prefix_filtered_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  fn lookahead_atomic_path_decision(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    result: LookaroundRoutineSearchResult(depth, n, machine, position, input, Nil(), history, capture_context, policy, True(), Nil())
  ) -> LookaheadDecision(n, machine) = match result
    LookaroundRoutineSearchYes(matched, remaining, routine, selected_trace) -> LookaheadSatisfied(lookahead_witness(depth, n, machine, position, input, history, capture_context, policy, matched, remaining, routine, selected_trace))
    LookaroundRoutineSearchNo(failure) -> LookaheadRefuted(LookaheadAtomicSearchRejected(depth, position, input, history, capture_context, policy, Some(failure), LookaroundRoutineRejected()))
    LookaroundRoutineSearchCommit(commit_depth) -> LookaheadRefuted(LookaheadAtomicSearchRejected(depth, position, input, history, capture_context, policy, None(), LookaroundRoutineCommitted(commit_depth)))

  fn lookaround_prefix_search_decision(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaheadDecision(n, machine) = match machine
    MkPatternMachine(_, _) ->
      let atomic_result = atomic_lookaround_routine_initial(depth, n, machine, input, [], position, history, capture_context, policy, true, [])
      lookahead_atomic_path_decision(depth, n, machine, position, input, after_input, history, capture_context, policy, atomic_result)

  fn lookbehind_atomic_path_decision(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    result: LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, False(), Nil())
  ) -> LookbehindDecision(n, machine) = match result
    LookaroundRoutineSearchYes(_, _, routine, selected_trace) -> LookbehindSatisfied(lookbehind_witness(depth, n, machine, position, input, after_input, history, capture_context, policy, routine, selected_trace))
    LookaroundRoutineSearchNo(failure) -> LookbehindRefuted(LookbehindAtomicSearchRejected(depth, position, input, after_input, history, capture_context, policy, Some(failure), LookaroundRoutineRejected()))
    LookaroundRoutineSearchCommit(commit_depth) -> LookbehindRefuted(LookbehindAtomicSearchRejected(depth, position, input, after_input, history, capture_context, policy, None(), LookaroundRoutineCommitted(commit_depth)))

  fn lookaround_search_decision(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookbehindDecision(n, machine) = match machine
    MkPatternMachine(_, _) ->
      let atomic_result = atomic_lookaround_routine_initial(depth, n, machine, input, after_input, position, history, capture_context, policy, false, [])
      lookbehind_atomic_path_decision(depth, n, machine, position, input, after_input, history, capture_context, policy, atomic_result)

  fn lookaround_transition_boundary(char: Char, rest: List(Char), after_input: List(Char), policy: NewlinePolicy) -> Boundary =
    position_boundary(false, newline_char(policy, char), ascii_word(char), option_word(char, true), Some(char), append_characters(rest, after_input))

  fn lookaround_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_first_prefix_loop(n, machine, position, [], input, history, policy)

  fn lookaround_first_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    pickup
      lookaround_machine_accepts(regex_assertion_depth_limit(), n, machine, position, matched_input, remaining_input, history, [], policy) -> Some(%[matched_input, remaining_input])
      else -> match remaining_input
        [] -> None()
        [char | rest] -> lookaround_first_prefix_loop(n, machine, position, [char | reversed_prefix], rest, history, policy)

  fn lookaround_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_last_prefix_loop(n, machine, position, [], input, None(), history, policy)

  fn lookaround_last_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: Option(Tuple(List(Char), List(Char))), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    let current = pickup
      lookaround_machine_accepts(regex_assertion_depth_limit(), n, machine, position, matched_input, remaining_input, history, [], policy) -> Some(%[matched_input, remaining_input])
      else -> previous
    match remaining_input
      [] -> current
      [char | rest] -> lookaround_last_prefix_loop(n, machine, position, [char | reversed_prefix], rest, current, history, policy)

  fn lookaround_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool, history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) = pickup
    greedy -> lookaround_last_prefix(n, machine, position, input, history, policy)
    else -> lookaround_first_prefix(n, machine, position, input, history, policy)

  @reducible
  fn machine_destinations(n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, boundary: Boundary) -> List(MachineState(n)) = match state
    ThreadAccepted() -> []
    ThreadActive(active) -> match machine
      MkPatternMachine(_, next) -> filter_boundary_states(next(active, char), boundary)

  ## Named machines may carry capture-participation constraints on their
  ## destination states. Those constraints are checked against the regular
  ## evidence already executed on the path plus the destination's epsilon
  ## routine: a group that participated contributes its EndCaptureSlot
  ## instruction before the guarded branch is entered. Observe instructions
  ## are intentionally erased from this view; they only advance capture text.
  ## Ordinary machines deliberately continue through `machine_destinations`,
  ## whose indexed proof contract does not mention capture conditions.
  fn extended_regular_instructions(routine: List(ExtendedInstruction)) -> List(EvidenceInstruction) = match routine
    [] -> []
    [Regular(instruction) | rest] -> [instruction | extended_regular_instructions(rest)]
    [Observe(_) | rest] -> extended_regular_instructions(rest)

  fn filter_boundary_states_with_routine({n: Nat}, states: List(MachineState(n)), boundary: Boundary, prior_routine: List(EvidenceInstruction)) -> List(MachineState(n)) = match states
    [] -> []
    [Accepted(routine, constraints) | rest] -> pickup
      constraints_hold_with_routine(constraints, boundary, append_routine(prior_routine, routine)) -> [Accepted(routine, constraints) | filter_boundary_states_with_routine(rest, boundary, prior_routine)]
      else -> filter_boundary_states_with_routine(rest, boundary, prior_routine)
    [Active(state, routine, constraints) | rest] -> pickup
      constraints_hold_with_routine(constraints, boundary, append_routine(prior_routine, routine)) -> [Active(state, routine, constraints) | filter_boundary_states_with_routine(rest, boundary, prior_routine)]
      else -> filter_boundary_states_with_routine(rest, boundary, prior_routine)

  fn named_machine_destinations(n: Nat, machine: PatternMachine(n), state: ThreadState(n), char: Char, boundary: Boundary, prior_routine: List(EvidenceInstruction)) -> List(MachineState(n)) = match state
    ThreadAccepted() -> []
    ThreadActive(active) -> match machine
      MkPatternMachine(_, next) -> filter_boundary_states_with_routine(next(active, char), boundary, prior_routine)

  ## Intrinsic list membership. The witness is erased at every accepting-run
  ## boundary; its only purpose is to make every path edge name a destination
  ## that the checked transition relation actually produced.
  type ListMember(a: Type) indices (value: a, values: List(a))
    ListMemberHere : ListMember(a, value, Cons(value, rest))
    ListMemberThere : (prior : ListMember(a, value, rest)) -> ListMember(a, value, Cons(other, rest))

  ## Turn intrinsic list membership into the ordered cursor suffix consumed by
  ## the atomic refutation induction.  Membership alone does not expose the
  ## suffix list; this Sigma packages that suffix together with the proof that
  ## it is reached only by dropping the preceding ordered heads.
  fn lookaround_admitted_cursor_suffix_here({n: Nat}, value: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n))) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, Cons(value, rest), values)) =
    %[Cons(value, rest), LookaroundAdmittedStateCursorSuffixHere(reflexive(Cons(value, rest)))]

  fn lookaround_admitted_cursor_suffix_there({n: Nat}, head: LookaroundAdmittedState(n), value: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n)), prior: ListMember(LookaroundAdmittedState(n), value, rest)) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), values)) = match lookaround_admitted_cursor_suffix_from_member(value, rest, prior)
    mk_pair(values, suffix) -> %[values, LookaroundAdmittedStateCursorSuffixDrop(head, suffix)]

  fn lookaround_admitted_cursor_suffix_from_member({n: Nat}, value: LookaroundAdmittedState(n), whole: List(LookaroundAdmittedState(n)), member: ListMember(LookaroundAdmittedState(n), value, whole)) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, whole, values)) = match whole
    [] -> impossible
    [head | rest] -> match member
      ListMemberHere() -> lookaround_admitted_cursor_suffix_here(value, rest)
      ListMemberThere(prior) -> lookaround_admitted_cursor_suffix_there(head, value, rest, prior)

  fn member_here({a: Type}, value: a, rest: List(a)) -> ListMember(a, value, Cons(value, rest)) = ListMemberHere()

  fn member_there({a: Type}, head: a, {value: a}, {rest: List(a)}, member: ListMember(a, value, rest)) -> ListMember(a, value, Cons(head, rest)) = ListMemberThere(member)

  fn transport_list_member({a: Type}, value: a, {left: List(a)}, {right: List(a)}, member: ListMember(a, value, left), equality: Equivalent(List(a), left, right)) -> ListMember(a, value, right) = match equality
    reflexive() -> member

  ## A candidate list whose every element is paired with erased evidence that it
  ## belongs to the original transition result. State and proof are introduced by
  ## the same constructor, so dependent pattern refinement never has to relate two
  ## sibling scrutinees.
  type MachineStateMembers(n: Nat) indices (whole: List(MachineState(n)), remaining_values: List(MachineState(n)))
    MachineStateMembersNil : MachineStateMembers(n, whole, Nil())
    MachineStateMembersActive : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member : ListMember(MachineState(n), Active(state, routine, constraints), whole)) -> (remaining: MachineStateMembers(n, whole, values)) -> MachineStateMembers(n, whole, Cons(Active(state, routine, constraints), values))
    MachineStateMembersAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member : ListMember(MachineState(n), Accepted(routine, constraints), whole)) -> (remaining: MachineStateMembers(n, whole, values)) -> MachineStateMembers(n, whole, Cons(Accepted(routine, constraints), values))

  ## Normalize the terminal member spine at the same construction site as its
  ## destination equation.  `MachineStateMembersNil` deliberately permits an
  ## arbitrary original list because it is a traversal suffix witness; this
  ## helper uses the checked equation to transport that suffix to the canonical
  ## empty list before a refutation proof consumes it.
  fn lookaround_empty_members_normalized(
    {n: Nat},
    {whole: List(MachineState(n))},
    members: MachineStateMembers(n, whole, Nil()),
    equivalence: Equivalent(List(MachineState(n)), whole, empty_machine_states(n))
  ) -> MachineStateMembers(n, empty_machine_states(n), Nil()) = match equivalence
    reflexive() -> members

  fn machine_state_members_active_current_edge({n: Nat}, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {whole: List(MachineState(n))}, {values: List(MachineState(n))}, members: MachineStateMembers(n, whole, Cons(Active(state, routine, constraints), values))) -> ListMember(MachineState(n), Active(state, routine, constraints), Cons(Active(state, routine, constraints), values)) = match members
    MachineStateMembersActive(_, _, _, _, _) -> ListMemberHere()

  fn machine_state_members_accepted_current_edge({n: Nat}, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {whole: List(MachineState(n))}, {values: List(MachineState(n))}, members: MachineStateMembers(n, whole, Cons(Accepted(routine, constraints), values))) -> ListMember(MachineState(n), Accepted(routine, constraints), Cons(Accepted(routine, constraints), values)) = match members
    MachineStateMembersAccepted(_, _, _, _) -> ListMemberHere()

  fn weaken_machine_state_members({n: Nat}, head: MachineState(n), {whole: List(MachineState(n))}, {values: List(MachineState(n))}, members: MachineStateMembers(n, whole, values)) -> MachineStateMembers(n, Cons(head, whole), values) = match members
    MachineStateMembersNil() -> MachineStateMembersNil()
    MachineStateMembersActive(state, routine, constraints, member, remaining) -> MachineStateMembersActive(state, routine, constraints, member_there(head, member), weaken_machine_state_members(head, remaining))
    MachineStateMembersAccepted(routine, constraints, member, remaining) -> MachineStateMembersAccepted(routine, constraints, member_there(head, member), weaken_machine_state_members(head, remaining))

  fn machine_state_members({n: Nat}, values: List(MachineState(n))) -> MachineStateMembers(n, values, values) = match values
    [] -> MachineStateMembersNil()
    [Active(state, routine, constraints) | rest] -> MachineStateMembersActive(state, routine, constraints, member_here(Active(state, routine, constraints), rest), weaken_machine_state_members(Active(state, routine, constraints), machine_state_members(rest)))
    [Accepted(routine, constraints) | rest] -> MachineStateMembersAccepted(routine, constraints, member_here(Accepted(routine, constraints), rest), weaken_machine_state_members(Accepted(routine, constraints), machine_state_members(rest)))

  ## Turn a structurally enumerated candidate list into the compact erased
  ## exhaustion witness used by assertion refutations.  The recursive call is
  ## the only way to obtain the Nil remainder, so callers cannot manufacture a
  ## certificate for a list whose traversal has not terminated.
  fn lookaround_exhaustion_from_members({n: Nat}, {whole: List(MachineState(n))}, {values: List(MachineState(n))}, members: MachineStateMembers(n, whole, values)) -> LookaroundExhaustion(n) = match members
    MachineStateMembersNil() -> LookaroundExhausted(whole, MachineStateMembersNil(), ())
    MachineStateMembersActive(_, _, _, _, remaining) -> lookaround_exhaustion_from_members(remaining)
    MachineStateMembersAccepted(_, _, _, remaining) -> lookaround_exhaustion_from_members(remaining)

  fn lookaround_exhaustion_from_list({n: Nat}, values: List(MachineState(n))) -> LookaroundExhaustion(n) = lookaround_exhaustion_from_members(machine_state_members(values))

  ## A single winning NFA path through the evidence VM.  Both the starting
  ## thread and final evidence are indices: `AcceptingNow` can close only at an
  ## accepted thread carrying exactly that evidence, while `AcceptingNext` can
  ## advance only to a member of `step_evidence_thread`.  Consequently a path
  ## cannot invent a state, skip an input character, or claim evidence different
  ## from the VM thread it reaches.
  ##
  ## Boundary filtering is part of the indexed edge, including the exact suffix
  ## used by the runtime boundary calculation. This covers zero-width boundary
  ## constraints without adding an unchecked side condition to the theorem.
  ## One evidence-preserving transition. It separates machine reachability from
  ## routine execution: `edge` proves the destination came from the checked
  ## bounded transition relation, and `execution` proves that destination's
  ## routine produced exactly the evidence/capture state named by the result.
  type EvidenceStep(n: Nat, machine: PatternMachine(n)) indices (char: Char, boundary: Boundary, source_state: ThreadState(n), source_evidence: List(Evidence), source_captures: List(CaptureFrame), destination_state: ThreadState(n), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame))
    EvidenceStepActive : (destination: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Active(destination, routine, constraints), machine_destinations(n, machine, source_state, char, boundary))) -> (execution : RoutineExecution(routine, source_evidence, record_capture_char(source_captures, char), result_evidence, result_captures)) -> EvidenceStep(n, machine, char, boundary, source_state, source_evidence, source_captures, ThreadActive(destination), result_evidence, result_captures)
    EvidenceStepAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge : ListMember(MachineState(n), Accepted(routine, constraints), machine_destinations(n, machine, source_state, char, boundary))) -> (execution : RoutineExecution(routine, source_evidence, record_capture_char(source_captures, char), result_evidence, result_captures)) -> EvidenceStep(n, machine, char, boundary, source_state, source_evidence, source_captures, ThreadAccepted(), result_evidence, result_captures)

  type AcceptingFrom(n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), extended_routine: List(ExtendedInstruction))
    AcceptingNow : AcceptingFrom(n, machine, Nil(), after_input, ThreadAccepted(), evidence, captures, evidence, Nil())
    AcceptingNextActive : (destination: Bounded(n)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge : ListMember(MachineState(n), Active(destination, regular, constraints), machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input)))) -> (execution : RoutineExecution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures)) -> (suffix : AcceptingFrom(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> AcceptingFrom(n, machine, Cons(char, rest), after_input, state, current_evidence, captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine))
    AcceptingNextAccepted : (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge : ListMember(MachineState(n), Accepted(regular, constraints), machine_destinations(n, machine, state, char, transition_boundary_before(char, rest, after_input)))) -> (execution : RoutineExecution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures)) -> (suffix : AcceptingFrom(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> AcceptingFrom(n, machine, Cons(char, rest), after_input, state, current_evidence, captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine))

  ## Atomic commitment is runtime control state, not part of the ordinary
  ## proof-carrying search result. A commit failure stops siblings at the
  ## scope that closed, while an outer scope may still propagate it.
  type AtomicScopeEffect = AtomicScopeEffect(Nat, Option(Nat))
  type AtomicSearchResult = AtomicSearchNo | AtomicSearchCommit(Nat) | AtomicSearchYes

  ## The atomic evaluator records the exact start and destination sequence it
  ## selected. The trace is indexed by the machine's state count and retained
  ## only as erased proof data; constructing it does not add a runtime path
  ## object to emitted matchers.
  type AtomicSelectedPathTrace(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), candidate_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicSelectedPrefixDone : AtomicSelectedPathTrace(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, True(), reversed_prefix, Nil(), evidence_reverse_chars(reversed_prefix), input, Nil())
    AtomicSelectedExactDone : AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), evidence_reverse_chars(reversed_prefix), Nil(), Nil())
    AtomicSelectedTransitionActive : (@erased source: Bounded(n)) -> (@erased char: Char) -> (@erased destination: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> {@erased child_whole: List(LookaroundAdmittedState(n))} -> {@erased child_current: List(LookaroundAdmittedState(n))} -> (@erased child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased suffix: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_current, matched, remaining_input, suffix_routine)) -> AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))
    AtomicSelectedTransitionAccepted : (@erased source: Bounded(n)) -> (@erased char: Char) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> {@erased child_whole: List(LookaroundAdmittedState(n))} -> {@erased child_current: List(LookaroundAdmittedState(n))} -> (@erased child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased suffix: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_current, matched, remaining_input, suffix_routine)) -> AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))

  type AtomicSelectedTrace(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicSelectedStartActive : (@erased state: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_admitted_starts(depth, n, machine, position, input, after_input, history, capture_context, policy))) -> {@erased selected_whole: List(LookaroundAdmittedState(n))} -> {@erased selected_current: List(LookaroundAdmittedState(n))} -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)) -> {@erased selected_origin: List(LookaroundAdmittedState(n))} -> (@erased selected_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), selected_origin, selected_whole)) -> (@erased suffix: AtomicSelectedPathTrace(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, selected_current, matched, remaining_input, suffix_routine)) -> AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, matched, remaining_input, append_extended_routines(regular_routine(routine), append_extended_routines(assertion_routine, suffix_routine)))
    AtomicSelectedStartAccepted : (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> {@erased whole: List(LookaroundAdmittedState(n))} -> {@erased remaining: List(LookaroundAdmittedState(n))} -> (@erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased edge: ListMember(LookaroundAdmittedState(n), LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_admitted_starts(depth, n, machine, position, input, after_input, history, capture_context, policy))) -> {@erased selected_whole: List(LookaroundAdmittedState(n))} -> {@erased selected_current: List(LookaroundAdmittedState(n))} -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)) -> {@erased selected_origin: List(LookaroundAdmittedState(n))} -> (@erased selected_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), selected_origin, selected_whole)) -> (@erased suffix: AtomicSelectedPathTrace(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, Z()), prefix_mode, reversed_prefix, selected_current, matched, remaining_input, suffix_routine)) -> AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, matched, remaining_input, append_extended_routines(regular_routine(routine), append_extended_routines(assertion_routine, suffix_routine)))

  type AtomicPathSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char))
    AtomicPathSearchRootActiveNo : (@erased source: Bounded(n)) -> (@erased failure: AtomicPathRootRefutation(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil())) -> AtomicPathSearchResult(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchRootExactNo : (@erased failure: AtomicPathRootRefutation(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil())) -> AtomicPathSearchResult(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix)
    ## This is a complete root-list refutation for any thread state. The two
    ## specialized root constructors above remain useful for the indexed
    ## empty-input and exact-terminal cases; this constructor covers the
    ## non-empty destination list without weakening the suffix-local No case.
    AtomicPathSearchRootNo : (@erased whole: List(LookaroundAdmittedState(n))) -> (@erased failure: AtomicPathRootRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchNo : (@erased whole: List(LookaroundAdmittedState(n))) -> (current: List(LookaroundAdmittedState(n))) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, current)) -> (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchCommit : (commit_depth: Nat) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> (@erased selected_whole: List(LookaroundAdmittedState(n))) -> (@erased selected_current: List(LookaroundAdmittedState(n))) -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)) -> (@erased selected_origin: List(LookaroundAdmittedState(n))) -> (@erased selected_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), selected_origin, selected_whole)) -> (@erased trace: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)

  ## Internal destination-list results retain the exact current admitted-state
  ## suffix in their type.  The public search result must hide that list at the
  ## matcher boundary, but recursive sibling traversal needs the stronger
  ## index so a tail refutation is known to begin at `remaining`, not at an
  ## unconstrained suffix of the original destination list.
  type AtomicPathMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathMembersNo : (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, current)) -> (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathMembersEscapedNo : (@erased skipped: List(LookaroundAdmittedState(n))) -> (tail_current: List(LookaroundAdmittedState(n))) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, tail_current)) -> (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_current)) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, atomic_admitted_prepend(skipped, tail_current))
    AtomicPathMembersCommit : (commit_depth: Nat) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathMembersYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> (@erased selected_whole: List(LookaroundAdmittedState(n))) -> (@erased selected_current: List(LookaroundAdmittedState(n))) -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)) -> (@erased selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), current, selected_whole)) -> (@erased trace: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine)) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)

  type LookaroundRoutineSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char))
    LookaroundRoutineSearchNo : (@erased failure: AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)
    LookaroundRoutineSearchCommit : (commit_depth: Nat) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)
    LookaroundRoutineSearchYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> (@erased trace: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, matched, remaining, routine)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)

  type LookaroundRoutineRejectionReason = LookaroundRoutineRejected | LookaroundRoutineCommitted(Nat)

  ## The runtime search never compares scope depths with an unchecked Boolean.
  ## This finite decision relation carries the proof that a commit is either
  ## at-or-inside the current scope (so siblings are blocked) or strictly
  ## deeper than it (so the commit belongs to an inner scope and outer
  ## siblings remain eligible).  The evidence fields are erased after the
  ## branch has been selected.
  type AtomicDepthAtLeast indices (left: Nat, right: Nat)
    AtomicDepthAtLeastZero : AtomicDepthAtLeast(Z(), Z())
    AtomicDepthAtLeastFromZero : AtomicDepthAtLeast(S(left), Z())
    AtomicDepthAtLeastStep : (@erased prior: AtomicDepthAtLeast(left, right)) -> AtomicDepthAtLeast(S(left), S(right))

  type AtomicDepthBelow indices (left: Nat, right: Nat)
    AtomicDepthBelowZero : AtomicDepthBelow(Z(), S(right))
    AtomicDepthBelowStep : (@erased prior: AtomicDepthBelow(left, right)) -> AtomicDepthBelow(S(left), S(right))

  type AtomicDepthComparison indices (left: Nat, right: Nat)
    AtomicDepthStops : (@erased proof: AtomicDepthAtLeast(left, right)) -> AtomicDepthComparison(left, right)
    AtomicDepthPasses : (@erased proof: AtomicDepthBelow(left, right)) -> AtomicDepthComparison(left, right)

  ## A named commitment decision keeps the control invariant visible at every
  ## search boundary: a commit at the current scope or an enclosing scope
  ## blocks the remaining siblings, while a commit strictly inside the current
  ## scope escapes to the caller so an outer alternative may still run.
  type AtomicCommitDisposition indices (current: Nat, commit: Nat)
    AtomicCommitBlocks : (@erased proof: AtomicDepthAtLeast(current, commit)) -> AtomicCommitDisposition(current, commit)
    AtomicCommitEscapes : (@erased proof: AtomicDepthBelow(current, commit)) -> AtomicCommitDisposition(current, commit)

  @reducible
  fn atomic_depth_comparison(left: Nat, right: Nat) -> AtomicDepthComparison(left, right) = match left
    Z() -> match right
      Z() -> AtomicDepthStops(AtomicDepthAtLeastZero())
      S(rest) -> AtomicDepthPasses(AtomicDepthBelowZero())
    S(left_rest) -> match right
      Z() -> AtomicDepthStops(AtomicDepthAtLeastFromZero())
      S(right_rest) -> match atomic_depth_comparison(left_rest, right_rest)
        AtomicDepthStops(prior) -> AtomicDepthStops(AtomicDepthAtLeastStep(prior))
        AtomicDepthPasses(prior) -> AtomicDepthPasses(AtomicDepthBelowStep(prior))

  @reducible
  fn atomic_commit_disposition(current: Nat, commit: Nat) -> AtomicCommitDisposition(current, commit) = match atomic_depth_comparison(current, commit)
    AtomicDepthStops(proof) -> AtomicCommitBlocks(proof)
    AtomicDepthPasses(proof) -> AtomicCommitEscapes(proof)

  @reducible
  fn atomic_scope_effect(routine: List(EvidenceInstruction), depth: Nat) -> AtomicScopeEffect = match routine
    [] -> AtomicScopeEffect(depth, None())
    [BeginAtomic() | rest] -> match atomic_scope_effect(rest, S(depth))
      AtomicScopeEffect(next_depth, closed) -> AtomicScopeEffect(next_depth, closed)
    [EndAtomic() | rest] -> match depth
      Z() -> atomic_scope_effect(rest, depth)
      S(previous) -> match atomic_scope_effect(rest, previous)
        AtomicScopeEffect(next_depth, closed) -> match closed
          None() -> AtomicScopeEffect(next_depth, Some(S(previous)))
          Some(existing) -> AtomicScopeEffect(next_depth, Some(existing))
    [_ | rest] -> atomic_scope_effect(rest, depth)

  @reducible
  fn atomic_depth_max(left: Nat, right: Nat) -> Nat = match left
    Z() -> right
    S(left_rest) -> match right
      Z() -> S(left_rest)
      S(right_rest) -> S(atomic_depth_max(left_rest, right_rest))

  @reducible
  fn atomic_scope_max_depth(routine: List(EvidenceInstruction), depth: Nat) -> Nat =
    atomic_scope_max_depth_with(routine, depth, depth)

  @reducible
  fn atomic_scope_max_depth_with(routine: List(EvidenceInstruction), depth: Nat, maximum: Nat) -> Nat = match routine
    [] -> maximum
    [BeginAtomic() | rest] -> atomic_scope_max_depth_with(rest, S(depth), atomic_depth_max(maximum, S(depth)))
    [EndAtomic() | rest] -> match depth
      Z() -> atomic_scope_max_depth_with(rest, depth, maximum)
      S(previous) -> atomic_scope_max_depth_with(rest, previous, maximum)
    [_ | rest] -> atomic_scope_max_depth_with(rest, depth, maximum)

  fn atomic_runtime_accepting_from(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), evidence: List(Evidence), captures: List(CaptureFrame), depth: Nat) -> AtomicSearchResult = match input
    [] -> match state
      ThreadAccepted() -> AtomicSearchYes()
      ThreadActive(_) -> AtomicSearchNo()
    [char | rest] -> match machine
      MkPatternMachine(_, next) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, state, evidence, captures, depth, filter_boundary_states(next_for_thread(n, next, state, char), transition_boundary_before(char, rest, after_input)))

  @reducible
  fn next_for_thread(n: Nat, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: ThreadState(n), char: Char) -> List(MachineState(n)) = match state
    ThreadAccepted() -> []
    ThreadActive(active) -> next(active, char)

  fn atomic_runtime_accepting_members(n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), source_evidence: List(Evidence), source_captures: List(CaptureFrame), depth: Nat, destinations: List(MachineState(n))) -> AtomicSearchResult = match destinations
    [] -> AtomicSearchNo()
    [Active(state, routine, _) | remaining] -> match execute_routine(routine, source_evidence, record_capture_char(source_captures, char))
      EvidenceExecution(next_evidence, next_captures) -> match atomic_scope_effect(routine, depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_runtime_accepting_from(n, machine, rest, after_input, ThreadActive(state), next_evidence, next_captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
    [Accepted(routine, _) | remaining] -> match execute_routine(routine, source_evidence, record_capture_char(source_captures, char))
      EvidenceExecution(next_evidence, next_captures) -> match atomic_scope_effect(routine, depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_runtime_accepting_from(n, machine, rest, after_input, ThreadAccepted(), next_evidence, next_captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_runtime_accepting_members(n, machine, char, rest, after_input, source_state, source_evidence, source_captures, depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)

  fn atomic_runtime_initial_members(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), starts: List(MachineState(n))) -> AtomicSearchResult =
    atomic_runtime_initial_members_with_commit(n, machine, input, after_input, None(), starts)

  fn atomic_runtime_initial_members_with_commit(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), blocked_depth: Option(Nat), starts: List(MachineState(n))) -> AtomicSearchResult = match starts
    [] -> AtomicSearchNo()
    [head | remaining] -> match blocked_depth
      Some(commit_depth) -> match atomic_commit_disposition(atomic_scope_max_depth(machine_state_routine(n, head), Z()), commit_depth)
        AtomicCommitBlocks(_) -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, blocked_depth, remaining)
        AtomicCommitEscapes(_) -> atomic_runtime_initial_member(n, machine, input, after_input, blocked_depth, head, remaining)
      None() -> atomic_runtime_initial_member(n, machine, input, after_input, blocked_depth, head, remaining)

  fn atomic_runtime_initial_member(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), blocked_depth: Option(Nat), head: MachineState(n), remaining: List(MachineState(n))) -> AtomicSearchResult = match head
    Active(state, routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_runtime_accepting_from(n, machine, input, after_input, ThreadActive(state), evidence, captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, blocked_depth, remaining)
    Accepted(routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(evidence, captures) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_runtime_accepting_from(n, machine, input, after_input, ThreadAccepted(), evidence, captures, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_runtime_initial_members_with_commit(n, machine, input, after_input, blocked_depth, remaining)

  fn atomic_runtime_accepts(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> Bool = match machine
    MkPatternMachine(starts, _) -> match atomic_runtime_initial_members(n, machine, input, after_input, filter_boundary_states(starts, initial_position_boundary(position, append_characters(input, after_input))))
      AtomicSearchYes() -> true
      AtomicSearchNo() -> false
      AtomicSearchCommit(_) -> false

  ## Atomic assertion search is the same finite ordered search as the ordinary
  ## assertion path, but every destination is first passed through the
  ## depth-aware lookaround constraint filter. This is what makes an assertion
  ## inside an atomic scope observable without introducing a host backtracking
  ## stack or rebuilding a child machine per attempt.
  fn atomic_lookaround_accepting_from(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat) -> AtomicSearchResult = match input
    [] -> match state
      ThreadAccepted() -> AtomicSearchYes()
      ThreadActive(_) -> AtomicSearchNo()
    [char | rest] -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, state, history, capture_context, policy, scope_depth, lookaround_machine_destinations(depth, n, machine, state, char, rest, after_input, history, capture_context, policy))

  fn atomic_lookaround_accepting_members(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, destinations: List(MachineState(n))) -> AtomicSearchResult = match destinations
    [] -> AtomicSearchNo()
    [Active(state, routine, _) | remaining] -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, scope_depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_lookaround_accepting_from(depth, n, machine, rest, after_input, ThreadActive(state), history_push_bounded(history, char), append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
    [Accepted(routine, _) | remaining] -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, scope_depth)
        AtomicScopeEffect(next_depth, closed_depth) -> match atomic_lookaround_accepting_from(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
            AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)
          AtomicSearchNo() -> match closed_depth
            None() -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
            Some(commit_depth) -> match atomic_commit_disposition(scope_depth, commit_depth)
              AtomicCommitEscapes(_) -> atomic_lookaround_accepting_members(depth, n, machine, char, rest, after_input, source_state, history, capture_context, policy, scope_depth, remaining)
              AtomicCommitBlocks(_) -> AtomicSearchCommit(commit_depth)

  fn atomic_lookaround_initial_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), starts: List(MachineState(n))) -> AtomicSearchResult = match starts
    [] -> AtomicSearchNo()
    [head | remaining] -> match blocked_depth
      Some(commit_depth) -> match atomic_commit_disposition(atomic_scope_max_depth(machine_state_routine(n, head), Z()), commit_depth)
        AtomicCommitBlocks(_) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)
        AtomicCommitEscapes(_) -> atomic_lookaround_initial_member(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, head, remaining)
      None() -> atomic_lookaround_initial_member(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, head, remaining)

  fn atomic_lookaround_initial_member(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), head: MachineState(n), remaining: List(MachineState(n))) -> AtomicSearchResult = match head
    Active(state, routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_lookaround_accepting_from(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)
    Accepted(routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_lookaround_accepting_from(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)

  ## The capture replay evaluator mirrors the atomic lookaround search above.
  ## It is deliberately separate from the Boolean evaluator: preserving the
  ## selected routine must not alter the acceptance authority used by typed
  ## extraction. Every successful branch prepends the observed character and
  ## epsilon routine in the same order as the certified extended path.
  ## `prefix` changes only the acceptance point: a prefix search may close as
  ## soon as the ordered machine reaches `ThreadAccepted`, even when input
  ## remains.  The machine's start/destination order still chooses the path,
  ## so lazy repeats and ordered alternation are preserved by the same DFS.
  ## `reversed_prefix` records exactly the characters consumed on that path;
  ## the result also carries the unconsumed suffix so callers never reconstruct
  ## it by retrying every possible endpoint.
  fn atomic_path_input_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), Nil()) = AtomicPathInputExhausted(LookaroundAdmittedStateCursorWitnessHere())

  fn atomic_path_exact_accepted_with_input_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), Nil()) = AtomicPathExactAcceptedWithInput(char, rest, LookaroundAdmittedStateCursorWitnessHere())

  fn atomic_path_root_exact_accepted_with_input_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathRootRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil()) = AtomicPathRootRefutation(atomic_path_exact_accepted_with_input_evidence(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix))

  fn atomic_path_root_input_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil()) = AtomicPathRootRefutation(atomic_path_input_exhausted_evidence(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix))

  fn atomic_path_root_exact_accepted_with_input_search({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix) = AtomicPathSearchRootExactNo(atomic_path_root_exact_accepted_with_input_evidence(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix))

  fn atomic_path_search_root_active_no({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), @erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil())) -> AtomicPathSearchResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = AtomicPathSearchRootActiveNo(source, failure)

  fn atomic_path_root_input_exhausted_search({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = atomic_path_search_root_active_no(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, atomic_path_root_input_exhausted_evidence(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix))

  fn atomic_path_destinations_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, cursor: LookaroundAdmittedStateCursor(n, whole, Nil()), witness: LookaroundAdmittedStateCursorWitness(n, whole, Nil()), canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil()) = AtomicPathDestinationsExhausted(char, rest, cursor, witness, canonical)

