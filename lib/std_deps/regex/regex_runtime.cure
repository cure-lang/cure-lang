    {selected_skipped_package: Type},
    package: AtomicPathCommitSelectedLocationPackage(
      n,
      AtomicPathCommitStructureExistentialPackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, whole,
        Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
        commit_depth,
        AtomicPathCommitAfterFailureKind(AtomicPathFailureAtRootKind(), AtomicPathFailureDestinationsExhausted())
      ),
      LookaroundAdmittedStateCursorSuffixPackage(
        n,
        whole,
        Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining)
      ),
      AtomicSelectedPathTracePackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, selected_current, matched,
        remaining_input, selected_routine, path
      ),
      selected_skipped_package,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
      selected_current
    ),
    left_case: (AtomicPathCommitSelectedLocationPackage(
      n,
      AtomicPathCommitStructureExistentialPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining), commit_depth, AtomicPathCommitAfterFailureKind(AtomicPathFailureAtRootKind(), AtomicPathFailureDestinationsExhausted())),
      LookaroundAdmittedStateCursorSuffixPackage(n, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining)),
      AtomicSelectedPathTracePackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, selected_routine, path),
      selected_skipped_package,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
      selected_current
    )) -> Empty,
    right_case: (AtomicPathCommitSelectedLocationPackage(
      n,
      AtomicPathCommitStructureExistentialPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining), commit_depth, AtomicPathCommitAfterFailureKind(AtomicPathFailureAtRootKind(), AtomicPathFailureDestinationsExhausted())),
      LookaroundAdmittedStateCursorSuffixPackage(n, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining)),
      AtomicSelectedPathTracePackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, selected_routine, path),
      selected_skipped_package,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
      selected_current
    )) -> Empty
  ) -> Empty = match package
    AtomicPathCommitSelectedSamePacked(commit_package, _, trace_package, _, equality) -> match commit_package
      AtomicPathCommitStructureExistentialPacked(_, structure) -> match equality
        reflexive() -> atomic_path_commit_after_root_destinations_exhausted_excludes_aligned_selected_package(
          structure,
          trace_package
