  type AtomicSelectedTraceExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), selected_start: LookaroundAdmittedState(n), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicSelectedTraceExistentialPacked : {@erased trace: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)} -> (package: AtomicSelectedTracePackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine, trace)) -> AtomicSelectedTraceExistentialPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)

  ## A rejected destination's selected sibling tail carries three pieces of
  ## proof-only state together: the recursive refutation (whose failure kind
  ## remains existential), the cursor suffix from the rejected tail to the
  ## selected current list, and the selected path itself.  Keeping these in a
  ## single indexed package means arbitrary sibling recursion can consume the
  ## exact tail produced by the parent construction site instead of rebuilding
  ## any of the erased evidence.
  type AtomicPathSelectedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicPathSelectedTailPackagePacked : (@erased tail: AtomicPathTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining)) -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, remaining, selected_current)) -> (@erased path: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, selected_routine)) -> AtomicPathSelectedTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current, matched, remaining_input, selected_routine)

  ## The selected-suffix dispatcher returns a proof-only branch instead of a
  ## higher-order continuation.  The tail branch retains the exact package
  ## produced at the rejected-destination construction site; consumers can
  ## then recurse on that package without putting an erased proof in a runtime
  ## closure.
  type AtomicPathSelectedTailDispatch(result: Type, depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicPathSelectedTailHead : (value: result) -> AtomicPathSelectedTailDispatch(result, depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current, matched, remaining_input, selected_routine)
    AtomicPathSelectedTailTail : (@erased package: AtomicPathSelectedTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current, matched, remaining_input, selected_routine)) -> AtomicPathSelectedTailDispatch(result, depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current, matched, remaining_input, selected_routine)

  ## Package the child evidence carried by an active selected transition at the
  ## construction site.  The selected whole/current lists are deliberately
  ## constructor-local existentials: consumers must refine this package to
  ## obtain them, rather than identifying either list with a caller-owned
  ## cursor by assumption.
  type AtomicPathActiveChildSelectionPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicPathActiveChildSelectionPackageActive : (@erased source: Bounded(n)) -> (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased destination: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_selected_whole)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, child_whole)) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, child_selected_whole, child_current)) -> (@erased child_selection_from_origin: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased child_skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_whole, child_whole, child_current, child_skipped_kind)) -> (@erased child_trace: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_current, matched, remaining_input, suffix_routine)) -> (@erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))) -> AtomicPathActiveChildSelectionPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))

  ## Consume the package only in an erased argument position.  A package is a
  ## proof-only existential: constructing it as a relevant let value would make
  ## the erased path witness appear relevant even though every constructor field
  ## is erased.  This boundary keeps construction and elimination at one
  ## authority while the continuation remains ordinary result code.
  @reducible
  fn atomic_path_active_child_selection_package_consume(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased package: AtomicPathActiveChildSelectionPackage(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      matched,
      remaining_input,
      selected_routine
    ),
    continuation: result
  ) -> result = match package
    AtomicPathActiveChildSelectionPackageActive(_, _, _, _, _, _, _, _, _, _, _, child_selected_whole_equivalence, child_origin_canonical, _, _, _, _, _, _, _) ->
      match child_selected_whole_equivalence
        reflexive() -> match child_origin_canonical
          AtomicPathSearchOriginActive(_, _, _, _) -> continuation

  ## Selected-trace counterpart of the blocked-member induction. The blocked
  ## head's skip/allow evidence is threaded through the recursive tail package
  ## together with the inherited membership predecessor and selected path.
  type AtomicStartBlockedSelectedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_start: LookaroundAdmittedState(n), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicStartBlockedSelectedTailPackagePacked : {@erased tail_kind: AtomicStartFailureKind} -> (@erased tail_failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> (@erased tail_evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> {@erased blocked_depth: Option(Nat)} -> {@erased skip_kind: AtomicStartSkipKind} -> (@erased skip: AtomicStartSkipEvidence(blocked_depth, skip_kind)) -> (@erased allowed: AtomicStartAllowed(blocked_depth, skip_kind)) -> (@erased membership: ListMember(LookaroundAdmittedState(n), selected_start, remaining)) -> (@erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)) -> AtomicStartBlockedSelectedTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, selected_start, matched, remaining_input, selected_routine)

  @reducible
  fn atomic_start_blocked_member_induction_selected_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    head_case: result,
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(prior) -> match _evidence
      AtomicStartNoBlockedEvidence(_, _, _, _, tail_failure, tail_evidence) ->
        tail_case(AtomicStartBlockedSelectedTailPackagePacked(
          tail_failure,
          tail_evidence,
          skip,
          allowed,
          prior,
          path
        ))

  ## Internal start-list results keep the exact current suffix. The public
  ## routine result is produced only after the root map below wraps a complete
  ## whole-to-whole refutation.
  type AtomicStartMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicStartMembersNo : (@erased kind: AtomicStartFailureKind) -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, kind)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current)
    ## The active root/empty branch retains its stronger child proof package at
    ## the evaluator result boundary.  The parent and child contexts stay
    ## separate in the package indices, while the ordinary failure/evidence
    ## values remain available to existing runtime adapters.  The explicit
    ## `active_current_equivalence` field records that the current spine at
    ## this construction site is exactly the active head followed by its
    ## recursive tail; consumers must refine that equality before publishing
    ## a root result.
    AtomicStartMembersActiveRootNo : (@erased active_state: Bounded(n)) -> (@erased thread_refinement: AtomicStartActiveThreadRefinement(n, ThreadActive(active_state), active_state)) -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, AtomicStartFailureRejected())) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, AtomicStartFailureRejected())) -> (@erased child_scope_depth: Nat) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_kind: AtomicPathFailureKind) -> (@erased active_current_equivalence: Equivalent(List(LookaroundAdmittedState(n)), current, Cons(LookaroundAdmittedActive(active_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining))) -> (@erased package: AtomicStartActiveRootTailProofPackageAt(depth, n, machine, position, capture_context, append_routine(append_routine(capture_context, routine), assertion_markers), input, after_input, history, policy, prefix_mode, reversed_prefix, ThreadActive(active_state), routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_whole, child_current, child_kind, child_scope_depth)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current)
    ## A recursive no-result branch remembers that its tail was active-headed;
    ## both the parent and recursive-tail refutation payloads remain indexed.
    AtomicStartMembersTailActiveNo : (@erased candidate: LookaroundAdmittedState(n)) -> (@erased remaining: List(LookaroundAdmittedState(n))) -> (@erased kind: AtomicStartFailureKind) -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), kind)) -> (@erased tail_kind: AtomicStartFailureKind) -> (@erased tail_failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> (@erased tail_evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining))
    AtomicStartMembersCommit : (commit_depth: Nat) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current)
