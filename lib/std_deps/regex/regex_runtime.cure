  ## A structural Same comparison is useful as proof authority only after
  ## both shapes have been checked against their exact cursor packages.  With
  ## the outer origins aligned, equal Here/Drop spines force the two hidden
  ## inner cursors to be equal as well.
  @reducible
  local fn lookaround_admitted_cursor_same_shape_inner_equivalent(
    {n: Nat},
    {@erased left_outer: List(LookaroundAdmittedState(n))},
    {@erased left_inner: List(LookaroundAdmittedState(n))},
    {@erased right_outer: List(LookaroundAdmittedState(n))},
    {@erased right_inner: List(LookaroundAdmittedState(n))},
    {left_shape: LookaroundAdmittedStateCursorShape},
    {right_shape: LookaroundAdmittedStateCursorShape},
    left_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, left_outer, left_inner, left_shape
    ),
    right_cursor: LookaroundAdmittedStateCursorShapedPackage(
      n, right_outer, right_inner, right_shape
    ),
    same_authority: AtomicPathCursorShapesSameAuthority(
      left_shape, right_shape
    ),
    @erased outer_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)), left_outer, right_outer
    )
  ) -> LookaroundAdmittedCursorInnerEquivalentAuthority(
    n, left_inner, right_inner
  ) = match same_authority
    AtomicPathCursorShapesSameHere() -> match left_cursor
      LookaroundAdmittedStateCursorHereShapedPacked(left_equality) -> match right_cursor
        LookaroundAdmittedStateCursorHereShapedPacked(right_equality) ->
          LookaroundAdmittedCursorInnerEquivalentPacked(
            trans(sym(left_equality), trans(outer_equivalence, right_equality))
          )
    AtomicPathCursorShapesSameDrop(prior) -> match left_cursor
      LookaroundAdmittedStateCursorDropShapedPacked(_, left_prior) -> match right_cursor
        LookaroundAdmittedStateCursorDropShapedPacked(_, right_prior) -> match outer_equivalence
          reflexive() -> lookaround_admitted_cursor_same_shape_inner_equivalent(
              left_prior,
              right_prior,
              prior,
              reflexive()
            )

























































































































































  ## Converse direction for exact assertion search.  Any independently
  ## constructed accepting path rules out the evaluator's rejected branch, so
  ## the computed result is constructively known to contain a path.
  fn lookaround_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(failure) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundSearchResultFound(found_path) -> LookaroundSearchPathComplete(found_path)

  ## The dual theorem says that an independently constructed complete failure
  ## tree forces the evaluator into its rejected branch.
  fn lookaround_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(found_failure) -> LookaroundSearchRefutationComplete(found_failure)
    LookaroundSearchResultFound(path) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))













































































































































































































































  fn atomic_path_recursive_commit_selected_child_same_after_failure_here_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(
      depth, n, machine
    )) -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(
      _, selected_child, _
    ) -> match selected_child
      AtomicPathSkippedPrefixCursorShapedExistentialPacked(selected_payload) -> match selected_payload
        AtomicPathSkippedPrefixCursorShapedEmptyPacked(structure) -> match structure
          AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
            empty_case(
              AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked(package)
            )

  fn atomic_path_recursive_commit_selected_child_same_aligned_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameExistentialPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
    depth, n, machine
  ) = match package
    AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
      {rest = rest}, {after_input = after_input}, {history = history},
      {capture_context = capture_context}, {policy = policy},
      {scope_depth = scope_depth}, {prefix_mode = prefix_mode},
      {reversed_prefix = reversed_prefix}, {matched = matched},
      {remaining_input = remaining_input},
      _, right_shape, commit_payload, selected_payload, same_authority
    ) -> match commit_payload
      AtomicPathCommitChildCursorPayloadPacked(
        {child_whole = left_whole}, {child_current = left_current},
        context_alignment, scope_alignment, child_origin_equivalence,
        child_origin_canonical, _, left_cursor, commit
      ) -> match selected_payload
        AtomicPathSelectedChildCursorActivePacked(
          {child_whole = right_whole}, {child_current = right_current},
          {child_skipped_kind = skipped_kind},
          {suffix_routine = suffix_routine}, {suffix = suffix},
          destination, routine, constraints, assertion_routine,
          assertion_markers, nested_decisions, right_origin_canonical, _,
          selected_skipped, selected_suffix, right_cursor
        ) -> match context_alignment
          LookaroundAdmittedStateCaptureContextActive() -> match scope_alignment
            LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match atomic_path_search_origin_alignment(child_origin_canonical, right_origin_canonical)
              AtomicPathSearchOriginsAligned(origin_equivalence) ->
                AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
                  commit,
                  selected_skipped,
                  selected_suffix,
                  atomic_selected_path_trace_existential_runtime_envelope(
                    right_shape,
                    selected_suffix
                  ),
                  lookaround_admitted_cursor_same_shape_inner_equivalent(
                    left_cursor,
                    right_cursor,
                    same_authority,
                    trans(child_origin_equivalence, origin_equivalence)
                  ),
                  package
                )
        AtomicPathSelectedChildCursorAcceptedPacked(
          {child_whole = right_whole}, {child_current = right_current},
          {child_skipped_kind = skipped_kind},
          {suffix_routine = suffix_routine}, {suffix = suffix},
          routine, constraints, assertion_routine, assertion_markers,
          nested_decisions, right_origin_canonical, _, selected_skipped,
          selected_suffix, right_cursor
        ) -> match context_alignment
          LookaroundAdmittedStateCaptureContextAccepted() -> match scope_alignment
            LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match atomic_path_search_origin_alignment(child_origin_canonical, right_origin_canonical)
              AtomicPathSearchOriginsAligned(origin_equivalence) ->
                AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
                  commit,
                  selected_skipped,
                  selected_suffix,
                  atomic_selected_path_trace_existential_runtime_envelope(
                    right_shape,
                    selected_suffix
                  ),
                  lookaround_admitted_cursor_same_shape_inner_equivalent(
                    left_cursor,
                    right_cursor,
                    same_authority,
                    trans(child_origin_equivalence, origin_equivalence)
                  ),
                  package
                )

  fn atomic_path_recursive_commit_selected_child_same_continuation_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
    depth, n, machine
  ) = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked(aligned)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructureFromChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSameFromChildPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_from_child_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructurePastEscapedPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_past_escaped_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) ->
      AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked(
        aligned
      )








  ## Common runtime dispatcher for recursive commit/selection authorities.
  ## The finite tag chooses a branch. Same is aligned and classifies its local
  ## child terminal once before reaching the recursive callback; strict
  ## directions retain the original existential unchanged. No erased child
  ## index is reconstructed and no tag is treated as proof evidence.
  fn atomic_path_recursive_commit_selected_existential_dispatch(
    {result: Type}, {depth: Nat}, {n: Nat},
    {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    ),
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> result,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> result,
    invalid_case: () -> result
  ) -> result = match package
    AtomicPathRecursiveCommitSelectedExistentialPacked(_) ->
      correlated_case(package)
    AtomicPathRecursiveCommitSelectedChildExistentialPacked(pair) -> match pair
      AtomicPathCommitSelectedChildCursorPacked(left_shape, right_shape, commit_payload, selected_payload, comparison) -> match comparison
        AtomicPathCursorShapeComparisonSame(same_authority) ->
          atomic_path_recursive_commit_selected_child_same_after_failure_terminal_dispatch(
            atomic_path_recursive_commit_selected_child_same_after_failure_terminal_package(
              atomic_path_recursive_commit_selected_child_same_aligned_package(
                AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
                  left_shape,
                  right_shape,
                  commit_payload,
                  selected_payload,
                  same_authority
                )
              )
            ),
            fn(input_exhausted) ->
              atomic_path_recursive_commit_selected_child_same_input_exhausted_fold(
                input_exhausted,
                fn(_) -> invalid_case()
              ),
            fn(exact_accepted) ->
              atomic_path_recursive_commit_selected_child_same_exact_accepted_fold(
                exact_accepted,
                fn(_) -> invalid_case()
              ),
            fn(root_exhausted) ->
              atomic_path_recursive_commit_selected_child_same_root_destinations_exhausted_fold(
                root_exhausted,
                fn(_) -> invalid_case()
              ),
            fn(unclassified) ->
              same_case(
                atomic_path_recursive_commit_selected_child_same_continuation_package(
                  unclassified
                )
              ),
            invalid_case
          )
        AtomicPathCursorShapeComparisonLeftAfter(_) -> left_case(package)
        AtomicPathCursorShapeComparisonRightAfter(_) -> right_case(package)

  ## Enter the next recursive child only from a fixed propagated-Same branch.
  ## The projected commit and selected suffix already exist as relevant
  ## values. Their erased inner equality is consumed solely on a path whose
  ## result is Empty; no transported package escapes this eliminator.
  fn atomic_path_recursive_commit_selected_child_same_projected_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameProjectedPackage(
      depth, n, machine
    ),
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> Empty,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(_, aligned) -> match aligned
      AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
        commit, _, selected_suffix, _, inner_equivalence, source
      ) -> match source
        AtomicPathRecursiveCommitSelectedChildSameExistentialPacked(
          _, right_shape, _, _, _
        ) -> match commit
          AtomicPathCommitStructureCursorClassifiedFromChildPacked(child_commit) -> match child_commit
            AtomicPathCommitStructureCursorExistentialPacked(
              _, _, child_structure
            ) -> match child_structure
              AtomicPathCommitStructureFromChildPacked(
                _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
              ) -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> atomic_path_recursive_commit_selected_existential_dispatch(
                    atomic_path_commit_child_selected_location_package(
                      atomic_path_commit_structure_cursor_from_child_child_package(
                        child_commit
                      ),
                      atomic_selected_path_trace_runtime_envelope(
                        right_shape,
                        selected_suffix
                      )
                    ),
                    correlated_case,
                    same_case,
                    left_case,
                    right_case,
                    invalid_case
                  )
          AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(child_commit) -> match child_commit
            AtomicPathCommitStructureCursorExistentialPacked(
              _, _, child_structure
            ) -> match child_structure
              AtomicPathCommitStructurePastEscapedPacked(
                _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
              ) -> match inner_equivalence
                LookaroundAdmittedCursorInnerEquivalentPacked(equality) -> match equality
                  reflexive() -> atomic_path_recursive_commit_selected_existential_dispatch(
                    atomic_path_commit_child_selected_location_package(
                      atomic_path_commit_structure_cursor_past_escaped_child_package(
                        child_commit
                      ),
                      atomic_selected_path_trace_runtime_envelope(
                        right_shape,
                        selected_suffix
                      )
                    ),
                    correlated_case,
                    same_case,
                    left_case,
                    right_case,
                    invalid_case
                  )
          AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
            invalid_case()
          AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
            invalid_case()
      AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
        _, _, _, _, _, _
      ) -> invalid_case()

  ## Structural Same continuation routing. Propagated child commits must enter
  ## the fixed Empty transport; local branches remain exact proof obligations
  ## for the eventual common induction theorem.
  fn atomic_path_recursive_commit_selected_child_same_continuation_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    ),
    after_failure_here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    after_failure_there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    after_failure_reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    past_rejected_empty_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    correlated_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    same_case: (AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
      depth, n, machine
    )) -> Empty,
    left_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    right_case: (AtomicPathRecursiveCommitSelectedExistentialPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked(aligned) ->
      atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_fold(
        aligned,
        after_failure_here_case,
        after_failure_there_case,
        after_failure_reverse_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSameFromChildPacked(projected) ->
      atomic_path_recursive_commit_selected_child_same_projected_dispatch(
        projected,
        correlated_case,
        same_case,
        left_case,
        right_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked(projected) ->
      atomic_path_recursive_commit_selected_child_same_projected_dispatch(
        projected,
        correlated_case,
        same_case,
        left_case,
        right_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked(aligned) ->
      atomic_path_recursive_commit_selected_child_same_past_rejected_empty_fold(
        aligned,
        past_rejected_empty_case,
        invalid_case
      )
    AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked(_) ->
      invalid_case()









  ## Terminal classification has already removed the three local child
  ## terminal kinds before this fold is entered. Descend the relevant selected
  ## skipped-prefix spine to its exact empty tail, retain that correlated
  ## package across child-kind dispatch, and expose only destination rejection
  ## to the recursive consumer. Any inconsistent terminal or commit
  ## classification remains an explicit impossible obligation.
  fn atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    )) -> Empty,
    there_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureTherePackage(
      depth, n, machine
    )) -> Empty,
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(after_failure_empty) ->
            atomic_path_recursive_commit_selected_child_same_after_failure_empty_kind_dispatch(
              after_failure_empty,
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(destination_rejected) ->
                atomic_path_recursive_commit_selected_child_same_destination_rejected_alignment_fold(
                  destination_rejected,
                  here_case,
                  there_case,
                  reverse_case,
                  invalid_case
                ),
              invalid_case
            ),
          fn(_) -> invalid_case(),
          invalid_case
        )
    )

  ## PastRejected carries a recursive sibling commit, but its selected prefix
  ## may still expose any of the four relevant constructors. Consume that
  ## prefix structurally before projecting the sibling: the callback receives
  ## one exact empty authority, while AfterFailure and malformed propagated
  ## classifications remain explicit invalid obligations.
  fn atomic_path_recursive_commit_selected_child_same_past_rejected_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    past_rejected_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(_) -> invalid_case(),
          fn(past_rejected) ->
            atomic_path_recursive_commit_selected_child_same_past_rejected_reverse_fold(
              past_rejected,
              past_rejected_case,
              invalid_case
            ),
          invalid_case
        )
    )


































































































































































































  ## Consume a recursively rejected active-child refutation at the construction
  ## site. This named boundary retains the child/refutation distinction while
  ## delegating the ordered cursor cases to the single alignment authority.
  ## Keeping the wrapper proof-only avoids rebuilding erased GADT evidence in a
  ## runtime-valued parent fold.
  @reducible
  fn atomic_path_active_child_rejection_excludes_trace(
    {@erased depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    destination: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    child_scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure_current: List(LookaroundAdmittedState(n)),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    selected_whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      failure_current,
      AtomicPathFailureDestinationRejected()
    ),
    {child_path_current: List(LookaroundAdmittedState(n))},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      child_path_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_excludes_aligned_trace(
    machine,
    child_char,
    child_rest,
    after_input,
    destination,
    history,
    capture_context,
    policy,
    child_scope_depth,
    prefix_mode,
    reversed_prefix,
    failure_whole,
    failure_current,
    failure_suffix,
    failure_nonempty,
    selected_whole,
    selected_whole_equivalence,
    selected_suffix,
    child_failure,
    child_path,
    left_case,
    left_tail_case,
    right_case
  )
