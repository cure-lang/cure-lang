  ## Relevant existential tying one erased cause to its exact recursive
  ## structure. Location carriers retain this package intact, so a strict
  ## branch cannot pair a cause with another commit's structure.
  type AtomicPathCommitStructureExistentialPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), commit_depth: Nat, kind: AtomicPathCommitCauseKind)
