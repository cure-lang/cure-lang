    LookaroundSearchMembersFound(path) -> LookaroundSearchResultFound(path)

  fn lookaround_search_path_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), {current: List(MachineState(n))}, members: MachineStateMembers(n, starts, current), @erased cursor: MachineStateCursor(n, starts, current)) -> LookaroundSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context) = match members
    MachineStateMembersNil() -> LookaroundSearchMembersRejected(lookaround_search_exhausted(depth, n, machine, input, after_input, history, capture_context, policy, starts, MachineStateMembersNil(), cursor))
    MachineStateMembersActive(state, routine, constraints, member, remaining) -> match lookaround_accepting_path(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy)
      LookaroundAcceptingPathRejectedEmpty(_, _, child_failure) -> match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundSearchMembersRejected(tail_failure) -> LookaroundSearchMembersRejected(lookaround_search_active_rejected_empty(depth, n, machine, after_input, history, capture_context, policy, starts, state, routine, constraints, member, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundSearchMembersFound(path) -> LookaroundSearchMembersFound(path)
      LookaroundAcceptingPathRejectedStep(_, char, rest, _, child_failure) -> match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundSearchMembersRejected(tail_failure) -> LookaroundSearchMembersRejected(lookaround_search_active_rejected_step(depth, n, machine, char, rest, after_input, history, capture_context, policy, starts, state, routine, constraints, member, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundSearchMembersFound(path) -> LookaroundSearchMembersFound(path)
      LookaroundAcceptingPathFoundActive(_, char, rest, _, destinations_equivalent, cursor_suffix, path) -> match destinations_equivalent
        reflexive() -> LookaroundSearchMembersFound(LookaroundSearchFoundActive(char, rest, reflexive(Cons(char, rest)), state, routine, constraints, member, cursor_suffix, path))
    MachineStateMembersAccepted(routine, constraints, member, remaining) -> match lookaround_accepting_path(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy)
      LookaroundAcceptingPathRejectedAcceptedStep(char, rest, _, child_failure) -> match lookaround_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Accepted(routine, constraints), cursor))
        LookaroundSearchMembersRejected(tail_failure) -> LookaroundSearchMembersRejected(lookaround_search_accepted_rejected(depth, n, machine, char, rest, after_input, history, capture_context, policy, starts, routine, constraints, member, child_failure, tail_failure, MachineStateMembersAccepted(routine, constraints, member, remaining), cursor))
        LookaroundSearchMembersFound(path) -> LookaroundSearchMembersFound(path)
      LookaroundAcceptingPathFoundAccepted(input_equivalent, cursor_suffix, path) -> LookaroundSearchMembersFound(lookaround_search_found_accepted(depth, n, machine, input, after_input, history, capture_context, policy, starts, input_equivalent, routine, constraints, member, cursor_suffix, path))

  type LookaroundPrefixSearchPath(depth: Nat, n: Nat, machine: PatternMachine(n), capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy)
    LookaroundPrefixSearchFoundActive : (char: Char) -> (rest: List(Char)) -> (input_equivalent: Equivalent(List(Char), input, Cons(char, rest))) -> (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(state), char, rest, after_input, history, append_routine(capture_context, routine), policy), candidates)) -> (path: LookaroundPrefixPath(depth, n, machine, append_routine(capture_context, routine), candidates, Cons(char, rest), after_input, ThreadActive(state), history, policy)) -> LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
    LookaroundPrefixSearchFoundAccepted : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (member: ListMember(MachineState(n), Accepted(routine, constraints), starts)) -> (path: LookaroundPrefixPath(depth, n, machine, append_routine(capture_context, routine), Nil(), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)

  type LookaroundAcceptingPathResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundAcceptingPathRejectedEmpty : (source: Bounded(n)) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (failure: LookaroundPathFailure(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, Nil(), Nil())) -> LookaroundAcceptingPathResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundAcceptingPathRejectedStep : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (failure: LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> LookaroundAcceptingPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundAcceptingPathRejectedAcceptedStep : (char: Char) -> (rest: List(Char)) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (failure: LookaroundPathFailure(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, Nil(), Nil())) -> LookaroundAcceptingPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, policy, capture_context)
    LookaroundAcceptingPathFoundActive : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased destinations: List(MachineState(n))) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, destinations, candidates)) -> (path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, ThreadActive(source), history, policy)) -> LookaroundAcceptingPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundAcceptingPathFoundAccepted : (input_equivalent: Equivalent(List(Char), input, Nil())) -> (cursor_suffix: MachineStateCursorSuffix(n, empty_machine_states(n), empty_machine_states(n))) -> (path: LookaroundAcceptingPath(depth, n, machine, capture_context, empty_machine_states(n), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundAcceptingPathResult(depth, n, machine, input, after_input, ThreadAccepted(), history, policy, capture_context)

  ## Internal result for a destination-list traversal. Unlike the public result
  ## above, this carries the full destination list as a parameter, so recursive
  ## tail failures cannot escape as an unconstrained existential.
  type LookaroundAcceptingMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), destinations: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundAcceptingMembersRejected : (failure: LookaroundPathFailure(depth, n, machine, input, after_input, state, history, capture_context, policy, destinations, current)) -> (@erased cursor: MachineStateCursor(n, destinations, current)) -> LookaroundAcceptingMembersResult(depth, n, machine, destinations, current, input, after_input, state, history, policy, capture_context)
    LookaroundAcceptingMembersFound : {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, current, candidates)) -> (path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, state, history, policy)) -> LookaroundAcceptingMembersResult(depth, n, machine, destinations, current, input, after_input, state, history, policy, capture_context)

  type LookaroundPrefixMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), destinations: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixMembersRejected : (source: Bounded(n)) -> (failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, destinations, current)) -> (@erased cursor: MachineStateCursor(n, destinations, current)) -> LookaroundPrefixMembersResult(depth, n, machine, destinations, current, input, after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixMembersFound : {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, current, candidates)) -> (path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, input, after_input, state, history, policy)) -> LookaroundPrefixMembersResult(depth, n, machine, destinations, current, input, after_input, state, history, policy, capture_context)

  type LookaroundPrefixPathResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixPathRejectedEmpty : (source: Bounded(n)) -> (@erased cursor: MachineStateCursor(n, Nil(), Nil())) -> (failure: LookaroundPrefixPathFailure(depth, n, machine, Nil(), after_input, source, history, capture_context, policy, Nil(), Nil())) -> LookaroundPrefixPathResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixPathRejectedStep : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased cursor: MachineStateCursor(n, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> (failure: LookaroundPrefixPathFailure(depth, n, machine, Cons(char, rest), after_input, source, history, capture_context, policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> LookaroundPrefixPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixPathFoundActive : (source: Bounded(n)) -> (char: Char) -> (rest: List(Char)) -> (@erased destinations: List(MachineState(n))) -> (@erased destinations_equivalent: Equivalent(List(MachineState(n)), destinations, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> {@erased candidates: List(MachineState(n))} -> (cursor_suffix: MachineStateCursorSuffix(n, destinations, candidates)) -> (path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, ThreadActive(source), history, policy)) -> LookaroundPrefixPathResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, policy, capture_context)
    LookaroundPrefixPathFoundAccepted : (path: LookaroundPrefixPath(depth, n, machine, capture_context, Nil(), input, after_input, ThreadAccepted(), history, policy)) -> LookaroundPrefixPathResult(depth, n, machine, input, after_input, ThreadAccepted(), history, policy, capture_context)

  type LookaroundSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundSearchResultRejected : (failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)
    LookaroundSearchResultFound : (path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)

  type LookaroundSearchMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundSearchMembersRejected : (failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current)) -> LookaroundSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)
    LookaroundSearchMembersFound : (path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)

  type LookaroundPrefixSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixSearchResultRejected : (failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)
    LookaroundPrefixSearchResultFound : (path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context)

  ## Constructive completeness is indexed by the evaluator result itself.  The
  ## start list is a result parameter rather than a hidden constructor
  ## existential, so an independent path/failure and the computed branch share
  ## one canonical identity.
  type LookaroundSearchPathCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundSearchPathComplete : (path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundSearchResultFound(path))

  type LookaroundSearchRefutationCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundSearchRefutationComplete : (failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundSearchResultRejected(failure))

  type LookaroundPrefixSearchPathCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundPrefixSearchPathComplete : (path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundPrefixSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundPrefixSearchResultFound(path))

  type LookaroundPrefixSearchRefutationCompleteness(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction), starts: List(MachineState(n))) indices (result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context))
    LookaroundPrefixSearchRefutationComplete : (failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)) -> LookaroundPrefixSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, LookaroundPrefixSearchResultRejected(failure))

  type LookaroundPrefixSearchMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n), starts: List(MachineState(n)), current: List(MachineState(n))) indices (input: List(Char), after_input: List(Char), history: List(Char), policy: NewlinePolicy, capture_context: List(EvidenceInstruction))
    LookaroundPrefixSearchMembersRejected : (failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current)) -> LookaroundPrefixSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)
    LookaroundPrefixSearchMembersFound : (path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)) -> LookaroundPrefixSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context)





  fn lookaround_search_path_excludes_empty_starts(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, {result: Type}, path: LookaroundSearchPath(depth, n, machine, capture_context, Nil(), input, after_input, history, policy)) -> result = match path
    LookaroundSearchFoundActive(_, _, _, _, _, _, member, _, _) -> lookaround_impossible_list_member(member)
    LookaroundSearchFoundAccepted(_, _, _, member, _, _) -> lookaround_impossible_list_member(member)

  fn lookaround_search_failure_excludes_empty_starts(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, {result: Type}, failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, Nil(), Nil()), path: LookaroundSearchPath(depth, n, machine, capture_context, Nil(), input, after_input, history, policy)) -> result = match failure
    LookaroundSearchExhausted(_, _) -> lookaround_search_path_excludes_empty_starts(depth, n, machine, input, after_input, history, capture_context, policy, path)

  ## A complete search rejection excludes every accepting start path in the
  ## current suffix.  Both sides descend through the same list spine: `Here`
  ## consumes the rejected child certificate, while `There` consumes the tail
  ## search certificate.  The failure index prevents either branch from
  ## silently reusing a certificate for a different start-list suffix.
  fn lookaround_search_failure_excludes_path(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    {starts: List(MachineState(n))},
    {current: List(MachineState(n))},
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current),
    path: LookaroundSearchPath(depth, n, machine, capture_context, current, input, after_input, history, policy)
  ) -> Empty = match failure
    LookaroundSearchExhausted(_, _) -> lookaround_search_path_excludes_empty_starts(depth, n, machine, input, after_input, history, capture_context, policy, path)
    LookaroundSearchActiveRejectedEmpty(_, _, _, _, _, _, _, tail_failure) -> match path
      LookaroundSearchFoundActive(_, _, input_equivalent, _, _, _, _, _, _) -> match input_equivalent
      LookaroundSearchFoundAccepted(input_equivalent, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> impossible
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundAccepted(reflexive(empty_characters()), path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
    LookaroundSearchActiveRejectedStep(_, _, state, routine, constraints, _, _, _, child_failure, tail_failure) -> match path
      LookaroundSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> lookaround_path_failure_recurse_child(
            n,
            machine,
            input,
            state,
            child_failure,
            cursor_suffix,
            child_path
          )
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
      LookaroundSearchFoundAccepted(input_equivalent, _, _, _, _, _) -> match input_equivalent
    LookaroundSearchAcceptedRejected(_, _, routine, constraints, _, _, _, _, tail_failure) -> match path
      LookaroundSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> impossible
          ListMemberThere(tail_member) -> lookaround_search_failure_excludes_path(
            depth,
            n,
            machine,
            input,
            after_input,
            history,
            capture_context,
            policy,
            tail_failure,
            LookaroundSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path)
          )
      LookaroundSearchFoundAccepted(input_equivalent, _, _, _, _, _) -> match input_equivalent

  fn lookaround_path_failure_excludes_accepting_path({@erased depth: Nat}, n: Nat, machine: PatternMachine(n), input: List(Char), {@erased after_input: List(Char)}, state: ThreadState(n), {@erased history: List(Char)}, {@erased capture_context: List(EvidenceInstruction)}, {@erased policy: NewlinePolicy}, @erased destinations: List(MachineState(n)), failure: LookaroundPathFailure(depth, n, machine, input, after_input, state, history, capture_context, policy, destinations, Nil()), path: LookaroundAcceptingPath(depth, n, machine, capture_context, Nil(), input, after_input, state, history, policy)) -> Empty = match failure
    LookaroundPathExhausted(_, source, _, _, _, _) -> impossible_lookaround_empty_active_path(n, machine, source, path)
    LookaroundPathStepExhausted(_, _, _, _, _, _, _, _) -> match path
      LookaroundAcceptedNow() -> impossible
      LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, _, _, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)
      LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, candidate_equivalent, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)
    LookaroundPathAcceptedWithInput(_, _, _) -> match path
      LookaroundAcceptedNow() -> impossible
      LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## The child failure stores the same destination list as both of its cursor
  ## indices.  Name that hidden list at one construction site so the recursive
  ## suffix proof can construct its canonical `Here` cursor without leaving an
  ## implicit index for the elaborator to guess.
  fn lookaround_path_failure_recurse_child(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_destinations: List(MachineState(n))},
    child_failure: LookaroundPathFailure(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, child_destinations, child_destinations),
    {@erased candidates: List(MachineState(n))},
    child_cursor_suffix: MachineStateCursorSuffix(n, child_destinations, candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty =
    lookaround_path_failure_excludes_accepting_suffix(n, machine, input, source, child_destinations, child_destinations, child_failure, candidates, child_cursor_suffix, path)

  fn lookaround_path_failure_recurse_accepted_child(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    rest: List(Char),
    {@erased after_input: List(Char)},
    {@erased child_history: List(Char)},
    {@erased child_capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    child_failure: LookaroundPathFailure(depth, n, machine, rest, after_input, ThreadAccepted(), child_history, child_capture_context, policy, empty_machine_states(n), empty_machine_states(n)),
    child_cursor_suffix: MachineStateCursorSuffix(n, empty_machine_states(n), empty_machine_states(n)),
    suffix: LookaroundAcceptingPath(depth, n, machine, child_capture_context, empty_machine_states(n), rest, after_input, ThreadAccepted(), child_history, policy)
  ) -> Empty =
    lookaround_path_failure_excludes_accepting_path(n, machine, rest, ThreadAccepted(), empty_machine_states(n), child_failure, suffix)

  fn lookaround_path_failure_active_rejected_empty_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    @erased after_input: List(Char),
    @erased source: ThreadState(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, Nil()), after_input, source, history, policy)
  ) -> Empty = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, _, _, _, _) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
          reflexive() -> impossible
    LookaroundAcceptedNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_path_failure_active_rejected_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    @erased after_input: List(Char),
    @erased source: ThreadState(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    child_failure: LookaroundPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy)),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, Cons(child_char, child_rest)), after_input, source, history, policy)
  ) -> Empty = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
          reflexive() -> match child_destinations_equivalent
            reflexive() -> lookaround_path_failure_recurse_child(n, machine, Cons(child_char, child_rest), destination, child_failure, child_cursor_suffix, suffix)
    LookaroundAcceptedNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_path_failure_accepted_rejected_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    @erased after_input: List(Char),
    @erased source: ThreadState(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    child_failure: LookaroundPathFailure(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, empty_machine_states(n), empty_machine_states(n)),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Accepted(routine, constraints), remaining_destinations), candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, Cons(char, rest), after_input, source, history, policy)
  ) -> Empty = match path
    LookaroundAcceptedNow() -> impossible
    LookaroundAcceptedNextActive(_, _, _, active_destination, active_routine, active_constraints, _, _, _, candidate_equivalent, _, _, _, _, _, _, _, _) ->
      lookaround_impossible_accepted_active_candidates(equality, candidate_equivalent)
    LookaroundAcceptedNextAccepted(_, _, _, _, _, _, _, _, candidate_equivalent, _, child_cursor_suffix, suffix) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> lookaround_path_failure_recurse_accepted_child(n, machine, rest, child_failure, child_cursor_suffix, suffix)

  ## Consume the complete cursor/suffix relation carried by a recursive path
  ## failure. A `Here` suffix means the candidate path must inspect the current
  ## destination head, so the corresponding child failure is recursed into. A
  ## `Drop` suffix means the path starts later in the list; the parent head is
  ## skipped and the tail failure is the induction step.
  ##
  ## The consuming path constructors carry an `Equivalent` proof for their
  ## candidate list. Matching its only constructor normalizes the candidate
  ## list to the same head/tail spine as the failure before descending. The
  ## opposite edge constructor is impossible when the failure head is indexed
  ## as `Active` or `Accepted`, and is discharged constructively.
  fn lookaround_path_failure_excludes_accepting_suffix(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    @erased destinations: List(MachineState(n)),
    @erased remaining_destinations: List(MachineState(n)),
    failure: LookaroundPathFailure(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, destinations, remaining_destinations),
    @erased candidates: List(MachineState(n)),
    candidate_suffix: MachineStateCursorSuffix(n, remaining_destinations, candidates),
    path: LookaroundAcceptingPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty = match input
    [] -> match failure
      LookaroundPathExhausted(_, source, _, _, _, remaining_equivalent) -> match remaining_equivalent
        reflexive() -> match candidate_suffix
          MachineStateCursorSuffixHere(equality) -> match equality
            reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, empty_characters(), ThreadActive(source), destinations, failure, path)
    [char | rest] -> match rest
      [] -> match failure
        LookaroundPathStepExhausted(_, _, _, _, _, _, _, remaining_equivalent) -> match remaining_equivalent
          reflexive() -> match candidate_suffix
            MachineStateCursorSuffixHere(equality) -> match equality
              reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, Cons(char, empty_characters()), ThreadActive(source), destinations, failure, path)
        LookaroundPathDestinationActiveRejectedEmpty(tail_destinations, _, destination, routine, constraints, _, _, _, _, _, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, empty_characters()), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_active_rejected_empty_here(n, machine, char, after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, destination, routine, constraints, candidates, equality, path)
        LookaroundPathDestinationAcceptedRejected(tail_destinations, _, _, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, empty_characters()), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_accepted_rejected_here(n, machine, char, empty_characters(), after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, routine, constraints, child_failure, candidates, equality, path)
      [child_char | child_rest] -> match failure
        LookaroundPathStepExhausted(_, _, _, _, _, _, _, remaining_equivalent) -> match remaining_equivalent
          reflexive() -> match candidate_suffix
            MachineStateCursorSuffixHere(equality) -> match equality
              reflexive() -> lookaround_path_failure_excludes_accepting_path(n, machine, Cons(char, Cons(child_char, child_rest)), ThreadActive(source), destinations, failure, path)
        LookaroundPathDestinationActiveRejected(tail_destinations, _, _, _, destination, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_active_rejected_here(n, machine, char, child_char, child_rest, after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, destination, routine, constraints, child_failure, candidates, equality, path)
        LookaroundPathDestinationAcceptedRejected(tail_destinations, _, _, routine, constraints, _, _, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_path_failure_excludes_accepting_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, tail_destinations, tail_failure, candidates, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_path_failure_accepted_rejected_here(n, machine, char, Cons(child_char, child_rest), after_input, ThreadActive(source), history, capture_context, policy, tail_destinations, routine, constraints, child_failure, candidates, equality, path)

  ## Prefix acceptance is intentionally different from exact acceptance: an
  ## accepted thread succeeds immediately, even when input remains.  Its
  ## rejection proof therefore uses the smaller prefix-only failure family and
  ## has no accepted-with-input or accepted-destination rejection cases.
  fn lookaround_prefix_empty_active_path_impossible(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased candidates: List(MachineState(n))},
    {result: Type},
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Nil(), after_input, ThreadActive(source), history, policy)
  ) -> result = match path
    LookaroundPrefixAccepted() -> impossible
    LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    LookaroundPrefixNextAccepted(_, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  fn lookaround_prefix_failure_excludes_empty_candidates(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    @erased destinations: List(MachineState(n)),
    failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, destinations, Nil()),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, Nil(), input, after_input, ThreadActive(source), history, policy)
  ) -> Empty = match failure
    LookaroundPrefixPathExhausted(source, _, _, _) -> lookaround_prefix_empty_active_path_impossible(n, machine, source, path)
    LookaroundPrefixPathStepExhausted(_, _, _, _, _, _) -> match path
      LookaroundPrefixAccepted() -> impossible
      LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, _, _, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)
      LookaroundPrefixNextAccepted(_, _, _, _, _, _, _, _, candidate_equivalent, _, _, _) -> lookaround_impossible_empty_candidate_equivalence(candidate_equivalent)

  fn lookaround_prefix_failure_active_empty_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    @erased after_input: List(Char),
    source: Bounded(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Cons(char, Nil()), after_input, ThreadActive(source), history, policy)
  ) -> Empty = match path
    LookaroundPrefixAccepted() -> impossible
    LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, _, _, _, _) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
    LookaroundPrefixNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_prefix_failure_recurse_child(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    {@erased after_input: List(Char)},
    source: Bounded(n),
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased child_destinations: List(MachineState(n))},
    child_failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, child_destinations, child_destinations),
    {@erased candidates: List(MachineState(n))},
    child_cursor_suffix: MachineStateCursorSuffix(n, child_destinations, candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty =
    lookaround_prefix_failure_excludes_suffix(n, machine, input, after_input, source, history, capture_context, policy, child_destinations, child_destinations, child_failure, child_cursor_suffix, path)

  fn lookaround_prefix_failure_active_here(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    @erased after_input: List(Char),
    source: Bounded(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased remaining_destinations: List(MachineState(n)),
    destination: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    child_failure: LookaroundPrefixPathFailure(depth, n, machine, Cons(child_char, child_rest), after_input, destination, history_push_bounded(history, char), append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(destination), child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(capture_context, routine), policy)),
    @erased candidates: List(MachineState(n)),
    @erased equality: Equivalent(List(MachineState(n)), Cons(Active(destination, routine, constraints), remaining_destinations), candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, Cons(char, Cons(child_char, child_rest)), after_input, ThreadActive(source), history, policy)
  ) -> Empty = match path
    LookaroundPrefixAccepted() -> impossible
    LookaroundPrefixNextActive(_, _, _, _, _, _, _, _, _, candidate_equivalent, _, _, _, child_input_equivalent, child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix) -> match equality
      reflexive() -> match candidate_equivalent
        reflexive() -> match child_input_equivalent
          reflexive() -> match child_destinations_equivalent
            reflexive() -> lookaround_prefix_failure_recurse_child(n, machine, Cons(child_char, child_rest), destination, child_failure, child_cursor_suffix, suffix)
    LookaroundPrefixNextAccepted(_, _, _, accepted_routine, accepted_constraints, _, _, _, candidate_equivalent, _, _, _) ->
      lookaround_impossible_active_accepted_candidates(equality, candidate_equivalent)

  fn lookaround_prefix_failure_excludes_suffix(
    {@erased depth: Nat},
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    @erased after_input: List(Char),
    source: Bounded(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased destinations: List(MachineState(n)),
    @erased remaining_destinations: List(MachineState(n)),
    failure: LookaroundPrefixPathFailure(depth, n, machine, input, after_input, source, history, capture_context, policy, destinations, remaining_destinations),
    {@erased candidates: List(MachineState(n))},
    candidate_suffix: MachineStateCursorSuffix(n, remaining_destinations, candidates),
    path: LookaroundPrefixPath(depth, n, machine, capture_context, candidates, input, after_input, ThreadActive(source), history, policy)
  ) -> Empty = match input
    [] -> match failure
      LookaroundPrefixPathExhausted(_, _, _, _) -> match candidate_suffix
        MachineStateCursorSuffixHere(equality) -> match equality
          reflexive() -> lookaround_prefix_failure_excludes_empty_candidates(n, machine, empty_characters(), source, destinations, failure, path)
    [char | rest] -> match rest
      [] -> match failure
        LookaroundPrefixPathStepExhausted(_, _, _, _, _, _) -> match candidate_suffix
          MachineStateCursorSuffixHere(equality) -> match equality
            reflexive() -> lookaround_prefix_failure_excludes_empty_candidates(n, machine, Cons(char, empty_characters()), source, destinations, failure, path)
        LookaroundPrefixDestinationActiveRejectedEmpty(tail_destinations, _, _, destination, routine, constraints, _, _, _, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_prefix_failure_excludes_suffix(n, machine, Cons(char, empty_characters()), after_input, source, history, capture_context, policy, destinations, tail_destinations, tail_failure, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_prefix_failure_active_empty_here(n, machine, char, after_input, source, history, capture_context, policy, tail_destinations, destination, routine, constraints, candidates, equality, path)
      [child_char | child_rest] -> match failure
        LookaroundPrefixPathStepExhausted(_, _, _, _, _, _) -> match candidate_suffix
          MachineStateCursorSuffixHere(equality) -> match equality
            reflexive() -> lookaround_prefix_failure_excludes_empty_candidates(n, machine, Cons(char, Cons(child_char, child_rest)), source, destinations, failure, path)
        LookaroundPrefixDestinationActiveRejected(tail_destinations, _, _, _, _, destination, routine, constraints, _, _, child_failure, tail_failure, _) -> match candidate_suffix
          MachineStateCursorSuffixDrop(_, tail_suffix) ->
            lookaround_prefix_failure_excludes_suffix(n, machine, Cons(char, Cons(child_char, child_rest)), after_input, source, history, capture_context, policy, destinations, tail_destinations, tail_failure, tail_suffix, path)
          MachineStateCursorSuffixHere(equality) ->
            lookaround_prefix_failure_active_here(n, machine, char, child_char, child_rest, after_input, source, history, capture_context, policy, tail_destinations, destination, routine, constraints, child_failure, candidates, equality, path)

  fn lookaround_prefix_search_path_excludes_empty_starts(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    capture_context: List(EvidenceInstruction),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    policy: NewlinePolicy,
    {result: Type},
    path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, Nil(), input, after_input, history, policy)
  ) -> result = match path
    LookaroundPrefixSearchFoundActive(_, _, _, _, _, _, member, _, _) -> lookaround_impossible_list_member(member)
    LookaroundPrefixSearchFoundAccepted(_, _, member, _) -> lookaround_impossible_list_member(member)

  fn lookaround_prefix_search_failure_excludes_path(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    {starts: List(MachineState(n))},
    {current: List(MachineState(n))},
    failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, current),
    path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, current, input, after_input, history, policy)
  ) -> Empty = match failure
    LookaroundPrefixSearchExhausted(_, _) -> lookaround_prefix_search_path_excludes_empty_starts(depth, n, machine, capture_context, input, after_input, history, policy, path)
    LookaroundPrefixSearchActiveRejectedEmpty(_, state, routine, constraints, _, _, _, tail_failure) -> match path
      LookaroundPrefixSearchFoundActive(_, _, input_equivalent, _, _, _, _, _, _) -> match input_equivalent
      LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, member, child_path) -> match member
        ListMemberHere() -> impossible
        ListMemberThere(tail_member) -> lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, tail_failure, LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, tail_member, child_path))
    LookaroundPrefixSearchActiveRejectedStep(_, _, _, state, routine, constraints, _, _, child_failure, tail_failure) -> match path
      LookaroundPrefixSearchFoundActive(path_char, path_rest, input_equivalent, path_state, path_routine, path_constraints, member, cursor_suffix, child_path) -> match input_equivalent
        reflexive() -> match member
          ListMemberHere() -> lookaround_prefix_failure_excludes_suffix(n, machine, input, after_input, state, history, append_routine(capture_context, routine), policy, lookaround_machine_destinations(depth, n, machine, ThreadActive(state), path_char, path_rest, after_input, history, append_routine(capture_context, routine), policy), lookaround_machine_destinations(depth, n, machine, ThreadActive(state), path_char, path_rest, after_input, history, append_routine(capture_context, routine), policy), child_failure, cursor_suffix, child_path)
          ListMemberThere(tail_member) -> lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, tail_failure, LookaroundPrefixSearchFoundActive(path_char, path_rest, reflexive(Cons(path_char, path_rest)), path_state, path_routine, path_constraints, tail_member, cursor_suffix, child_path))
      LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, member, child_path) -> match member
        ListMemberHere() -> impossible
        ListMemberThere(tail_member) -> lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, tail_failure, LookaroundPrefixSearchFoundAccepted(path_routine, path_constraints, tail_member, child_path))


  ## Converse direction for exact assertion search.  Any independently
  ## constructed accepting path rules out the evaluator's rejected branch, so
  ## the computed result is constructively known to contain a path.
  fn lookaround_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(failure) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundSearchResultFound(found_path) -> LookaroundSearchPathComplete(found_path)

  ## The dual theorem says that an independently constructed complete failure
  ## tree forces the evaluator into its rejected branch.
  fn lookaround_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(found_failure) -> LookaroundSearchRefutationComplete(found_failure)
    LookaroundSearchResultFound(path) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))

  ## Prefix/lookahead search has the same completeness pair over its smaller,
  ## active-only failure family.
  fn lookaround_prefix_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundPrefixSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundPrefixSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundPrefixSearchResultRejected(failure) -> lookaround_absurd(lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundPrefixSearchResultFound(found_path) -> LookaroundPrefixSearchPathComplete(found_path)

  fn lookaround_prefix_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_prefix_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundPrefixSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundPrefixSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundPrefixSearchResultRejected(found_failure) -> LookaroundPrefixSearchRefutationComplete(found_failure)
    LookaroundPrefixSearchResultFound(path) -> lookaround_absurd(lookaround_prefix_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))




















  typealias AtomicPathRejectedTailAt(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n))) = AtomicPathTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)


























  fn lookaround_prefix_search_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n))) -> LookaroundPrefixSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context) = match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, machine_state_members(starts), MachineStateCursorHere())
    LookaroundPrefixSearchMembersRejected(failure) -> LookaroundPrefixSearchResultRejected(failure)
    LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchResultFound(path)

  fn lookaround_prefix_search_path_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, starts: List(MachineState(n)), {current: List(MachineState(n))}, members: MachineStateMembers(n, starts, current), @erased cursor: MachineStateCursor(n, starts, current)) -> LookaroundPrefixSearchMembersResult(depth, n, machine, starts, current, input, after_input, history, policy, capture_context) = match members
    MachineStateMembersNil() -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_exhausted(depth, n, machine, input, after_input, history, capture_context, policy, starts, MachineStateMembersNil(), cursor))
    MachineStateMembersActive(state, routine, constraints, member, remaining) -> match lookaround_prefix_path(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy)
      LookaroundPrefixPathRejectedEmpty(_, _, child_failure) -> match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundPrefixSearchMembersRejected(tail_failure) -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_active_rejected_empty(depth, n, machine, after_input, history, capture_context, policy, starts, state, routine, constraints, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchMembersFound(path)
      LookaroundPrefixPathRejectedStep(_, char, rest, _, child_failure) -> match lookaround_prefix_search_path_members(depth, n, machine, input, after_input, history, capture_context, policy, starts, remaining, MachineStateCursorDrop(Active(state, routine, constraints), cursor))
        LookaroundPrefixSearchMembersRejected(tail_failure) -> LookaroundPrefixSearchMembersRejected(lookaround_prefix_search_active_rejected_step(depth, n, machine, char, rest, after_input, history, capture_context, policy, starts, state, routine, constraints, child_failure, tail_failure, MachineStateMembersActive(state, routine, constraints, member, remaining), cursor))
        LookaroundPrefixSearchMembersFound(path) -> LookaroundPrefixSearchMembersFound(path)
      LookaroundPrefixPathFoundActive(_, char, rest, _, destinations_equivalent, cursor_suffix, path) -> match destinations_equivalent
        reflexive() -> LookaroundPrefixSearchMembersFound(LookaroundPrefixSearchFoundActive(char, rest, reflexive(Cons(char, rest)), state, routine, constraints, member, cursor_suffix, path))
    MachineStateMembersAccepted(routine, constraints, member, remaining) -> match lookaround_prefix_path(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy)
      LookaroundPrefixPathFoundAccepted(path) -> LookaroundPrefixSearchMembersFound(LookaroundPrefixSearchFoundAccepted(routine, constraints, member, path))












  fn lookaround_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_first_prefix_loop(n, machine, position, [], input, history, policy)

  fn lookaround_first_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    pickup
      lookaround_machine_accepts(regex_assertion_depth_limit(), n, machine, position, matched_input, remaining_input, history, [], policy) -> Some(%[matched_input, remaining_input])
      else -> match remaining_input
        [] -> None()
        [char | rest] -> lookaround_first_prefix_loop(n, machine, position, [char | reversed_prefix], rest, history, policy)

  fn lookaround_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    lookaround_last_prefix_loop(n, machine, position, [], input, None(), history, policy)

  fn lookaround_last_prefix_loop(n: Nat, machine: PatternMachine(n), position: InitialPosition, reversed_prefix: List(Char), remaining_input: List(Char), previous: Option(Tuple(List(Char), List(Char))), history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) =
    let matched_input = evidence_reverse_chars(reversed_prefix)
    let current = pickup
      lookaround_machine_accepts(regex_assertion_depth_limit(), n, machine, position, matched_input, remaining_input, history, [], policy) -> Some(%[matched_input, remaining_input])
      else -> previous
    match remaining_input
      [] -> current
      [char | rest] -> lookaround_last_prefix_loop(n, machine, position, [char | reversed_prefix], rest, current, history, policy)

  fn lookaround_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool, history: List(Char), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char))) = pickup
    greedy -> lookaround_last_prefix(n, machine, position, input, history, policy)
    else -> lookaround_first_prefix(n, machine, position, input, history, policy)








  ## Generic construction-site eliminator for a rejected start suffix. The
  ## failure and no-result witness are indexed by the same `Cons(head, rest)`
  ## spine; only the membership witness decides whether the supplied proof is
  ## the head case or the recursively prepared tail case.  The `There` branch
  ## receives the typed tail package extracted from the rejected constructor;
  ## it does not recover or classify the existential tail failure kind.
  @reducible
  fn atomic_start_rejected_member_induction(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    head: LookaroundAdmittedState(n),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    head_case: result,
    tail_case: (AtomicStartRejectedTailAt(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, rest)) -> result
  ) -> result = match atomic_start_member_location(selected_start, head, rest, membership)
    AtomicStartMemberHere(_) -> head_case
    AtomicStartMemberThere(_, _) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) ->
        tail_case(AtomicStartTailPackagePacked(tail_failure, tail_evidence))


  ## Selected-trace counterpart of the erased rejected-member induction.  A
  ## `There` witness contains the exact prior membership for the recursive
  ## tail; package that witness together with the tail refutation/evidence and
  ## the unchanged selected trace before invoking the continuation.  This is
  ## the canonical transport boundary for arbitrary sibling recursion.
  @reducible
  fn atomic_start_rejected_member_induction_selected_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    head_case: result,
    tail_case: (AtomicStartSelectedTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, rest, selected_start, matched, remaining_input, selected_routine)) -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(prior) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) ->
        tail_case(AtomicStartSelectedTailPackagePacked(tail_failure, tail_evidence, prior, path))

  ## Package-preserving dual of the selected rejected-member induction. The
  ## exact selected-start package is relevant context and is transported
  ## unchanged when membership advances into the sibling tail.
  @reducible
  fn atomic_start_rejected_member_induction_selected_package(
    {result: Type}, {depth: Nat}, {n: Nat},
    machine: PatternMachine(n), position: InitialPosition,
    input: List(Char), after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    prefix_mode: Bool, reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(head, rest), AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(head, rest), AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    head_case: result,
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole, rest,
      selected_start, matched, remaining_input, selected_routine
    )) -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(prior) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) -> tail_case(
        AtomicStartSelectedTailTracePacked(
          tail_failure,
          tail_evidence,
          prior,
          trace_package
        )
      )

  ## Construction-site wrapper for a successful atomic witness.  The
  ## membership argument remains relevant here so the Here/There split can
  ## drive proof-only continuations; the linked witness is erased and fixes
  ## the same whole/current spine and selected trace at the type level.
  @reducible
  fn atomic_selected_start_witness_induction_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased _allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      routine
    ),
    head_case: result,
    tail_case: () -> result
  ) -> result = atomic_start_rejected_member_induction_erased(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    head_case,
    tail_case
  )


  ## Construction-site head consumer for the first active rejected start. The
  ## child input is empty, so the indexed active-child refutation can be sent
  ## directly to the existing path contradiction. A later duplicate/member is
  ## delegated to the typed tail continuation; this helper therefore proves
  ## the `Here` branch without pretending that membership is unique in the
  ## presence of duplicate start states.
  fn atomic_start_rejected_member_here_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(depth, n, machine, position, Nil(), after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, rest, selected_start, matched, remaining_input, selected_routine)) -> Empty
  ) -> Empty =
    match atomic_start_member_location(
      selected_start,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      rest,
      membership
    )
      AtomicStartMemberHere(_) -> match failure
        AtomicStartCandidateRejected(_, _, _, _, _, _, _, _, _, _, _, _, _) ->
          atomic_start_candidate_rejection_excludes_trace(
            machine,
            position,
            after_input,
            history,
            capture_context,
            policy,
            prefix_mode,
            reversed_prefix,
            state,
            routine,
            constraints,
            assertion_routine,
            assertion_markers,
            nested_decisions,
            AtomicPathInputExhausted(LookaroundAdmittedStateCursorWitnessHere(), empty_lookaround_admitted_cursor_suffix(n)),
            empty_lookaround_admitted_cursor_suffix(n),
            path
          )
      AtomicStartMemberThere(_, prior) -> match failure
        AtomicStartCandidateRejected(_, _, _, _, _, _, _, _, _, _, child_failure, _, _) -> match child_failure
          AtomicPathInputExhausted(child_witness, child_suffix) -> match evidence
            AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) ->
              tail_case(AtomicStartSelectedTailPackagePacked(
                tail_failure,
                tail_evidence,
                prior,
                path
              ))


  fn lookaround_admitted_cursor_suffix_there({n: Nat}, head: LookaroundAdmittedState(n), value: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n)), prior: ListMember(LookaroundAdmittedState(n), value, rest)) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, Cons(head, rest), values)) = match lookaround_admitted_cursor_suffix_from_member(value, rest, prior)
    mk_pair(values, suffix) -> %[values, LookaroundAdmittedStateCursorSuffixDrop(head, suffix)]

  fn lookaround_admitted_cursor_suffix_from_member({n: Nat}, value: LookaroundAdmittedState(n), whole: List(LookaroundAdmittedState(n)), member: ListMember(LookaroundAdmittedState(n), value, whole)) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, whole, values)) = match whole
    [] -> impossible
    [head | rest] -> match member
      ListMemberHere() -> lookaround_admitted_cursor_suffix_here(value, rest)
      ListMemberThere(prior) -> lookaround_admitted_cursor_suffix_there(head, value, rest, prior)

























  ## A rejected destination's selected sibling tail carries three pieces of
  ## proof-only state together: the recursive refutation (whose failure kind
  ## remains existential), the cursor suffix from the rejected tail to the
  ## selected current list, and the selected path itself.  Keeping these in a
  ## single indexed package means arbitrary sibling recursion can consume the
  ## exact tail produced by the parent construction site instead of rebuilding
  ## any of the erased evidence.
  type AtomicPathSelectedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicPathSelectedTailPackagePacked : (@erased tail: AtomicPathTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining)) -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, remaining, selected_current)) -> (@erased path: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining_input, selected_routine)) -> AtomicPathSelectedTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current, matched, remaining_input, selected_routine)

  ## The selected-suffix dispatcher returns a proof-only branch instead of a
  ## higher-order continuation.  The tail branch retains the exact package
  ## produced at the rejected-destination construction site; consumers can
  ## then recurse on that package without putting an erased proof in a runtime
  ## closure.
  type AtomicPathSelectedTailDispatch(result: Type, depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicPathSelectedTailHead : (value: result) -> AtomicPathSelectedTailDispatch(result, depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current, matched, remaining_input, selected_routine)
