        LookaroundAcceptingMembersFound(parent_suffix, lookaround_accepting_step_active(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, destination, routine, constraints, edge, members, cursor, child_char, child_rest, reflexive(rest), child_destinations, child_destinations_equivalent, child_cursor_suffix, suffix))
    MachineStateMembersAccepted(routine, constraints, edge, remaining) -> match lookaround_accepting_path(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy)
