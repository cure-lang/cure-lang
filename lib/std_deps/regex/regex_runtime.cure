      atomic_path_commit_after_failure_excludes_rejected_prefix(cause, evidence)

  ## Consume the exact commit existential only after both relevant package
  ## constructors have established the paired local-failure/rejected-head
  ## case. The cause remains erased and is never used as a branch selector.
  @reducible
  fn atomic_path_commit_after_failure_excludes_selected_rejected_packages(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_kind: AtomicPathSkippedPrefixKind},
    commit_package: AtomicPathCommitStructureExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), commit_depth,
      AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind)
    ),
    skipped_structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      AtomicPathSkippedPrefixRejectedConsKind(
        child_prefix_kind,
        child_kind,
        tail_kind
      )
    )
  ) -> Empty = match commit_package
    AtomicPathCommitStructureExistentialPacked(cause, _) ->
      atomic_path_commit_after_failure_excludes_selected_rejected_head_package(
        cause,
        skipped_structure
      )

  ## Every cursor-location constructor closes for this paired case. The
  ## contradiction is semantic (blocking close versus continuation), so it
  ## does not depend on whether the independently compared cursor is equal,
  ## earlier, or later; the relevant location carrier merely guarantees that
  ## all four authorities came from one comparison.
  @reducible
  fn atomic_path_commit_after_failure_excludes_selected_rejected_location_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_kind: AtomicPathSkippedPrefixKind},
    {commit_cursor_package: Type}, {selected_trace_package: Type},
    package: AtomicPathCommitSelectedLocationPackage(
      n,
      AtomicPathCommitStructureExistentialPackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, whole, Cons(candidate, remaining),
        commit_depth,
        AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind)
      ),
      commit_cursor_package,
      selected_trace_package,
      AtomicPathSkippedPrefixStructurePackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, whole, Cons(candidate, remaining),
        selected_current,
        AtomicPathSkippedPrefixRejectedConsKind(
          child_prefix_kind,
          child_kind,
          tail_kind
        )
      ),
      Cons(candidate, remaining),
      selected_current
    )
  ) -> Empty = match package
    AtomicPathCommitSelectedSamePacked(commit_package, _, _, skipped_structure, _) ->
      atomic_path_commit_after_failure_excludes_selected_rejected_packages(
        commit_package,
        skipped_structure
      )
    AtomicPathCommitSelectedLeftAfterPacked(commit_package, _, _, skipped_structure, _) ->
      atomic_path_commit_after_failure_excludes_selected_rejected_packages(
        commit_package,
        skipped_structure
      )
    AtomicPathCommitSelectedRightAfterPacked(commit_package, _, _, skipped_structure, _) ->
      atomic_path_commit_after_failure_excludes_selected_rejected_packages(
        commit_package,
        skipped_structure
      )


  @reducible
  fn atomic_path_commit_past_escaped_skipped_tail(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased head_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased skipped_tail_kind: AtomicPathSkippedPrefixKind},
    @erased cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitPastEscapedKind(head_commit_kind, tail_commit_kind)),
    @erased skipped: AtomicPathSkippedPrefixEvidence(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), selected_current, AtomicPathSkippedPrefixEscapedConsKind(head_commit_kind, skipped_tail_kind))
  ) -> AtomicPathCommitSkippedTailPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current) = match cause
    AtomicPathCommitPastEscaped(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause) -> match skipped
      AtomicPathEscapedCommitCons(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, skipped_kind, skipped_tail) -> AtomicPathCommitSkippedTailPacked(tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause, skipped_kind, skipped_tail)

  @reducible
  fn atomic_path_commit_past_rejected_skipped_tail(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased skipped_tail_kind: AtomicPathSkippedPrefixKind},
    @erased cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), commit_depth, AtomicPathCommitPastRejectedKind(child_prefix_kind, child_kind, tail_commit_kind)),
    @erased skipped: AtomicPathSkippedPrefixEvidence(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), selected_current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, skipped_tail_kind))
  ) -> AtomicPathCommitSkippedTailPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, selected_current) = match cause
    AtomicPathCommitPastRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause) -> match skipped
      AtomicPathSkippedRejectedCons(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, skipped_kind, skipped_tail) -> AtomicPathCommitSkippedTailPacked(tail_depth, tail_origin_equivalence, tail_origin_canonical, tail_suffix, tail_kind, tail_cause, skipped_kind, skipped_tail)



  ## A root-indexed failure exposes the complete candidate spine. A selected
  ## cursor strictly before that root contradicts finite suffix asymmetry.
  ## The prefix kind fixes the erased constructor, so no runtime tag is read.
  @reducible
  fn atomic_path_failure_at_root_excludes_strict_selection(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    whole: List(LookaroundAdmittedState(n)),
    current: List(LookaroundAdmittedState(n)),
    selected: List(LookaroundAdmittedState(n)),
    @erased prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureAtRootKind()),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current)
  ) -> Empty = match prefix
    AtomicPathFailureAtRoot(equality) -> atomic_path_root_failure_excludes_strictly_prior_cursor(whole, current, selected, equality, selected_suffix, strict)

  ## Dispatch the reverse-cursor proof from its indexed construction source.
  ## Root failures close by finite suffix asymmetry. Only a genuinely skipped
  ## prefix is delegated to the recursive mixed-prefix consumer.
  @reducible
  fn atomic_path_failure_prefix_reverse_dispatch(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    whole: List(LookaroundAdmittedState(n)),
    current: List(LookaroundAdmittedState(n)),
    selected: List(LookaroundAdmittedState(n)),
    kind: AtomicPathFailurePrefixKind,
    @erased prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, kind),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current),
    after_skipped_case: () -> Empty
  ) -> Empty = match kind
    AtomicPathFailureAtRootKind() -> match prefix
      AtomicPathFailureAtRoot(_) -> atomic_path_failure_at_root_excludes_strict_selection(
        whole,
        current,
        selected,
        prefix,
        selected_suffix,
        strict
      )
    AtomicPathFailureAfterSkippedKind(skipped_kind) -> match skipped_kind
      AtomicPathSkippedPrefixEmptyKind() -> match prefix
        AtomicPathFailureAfterSkipped(_, _) -> atomic_path_failure_after_empty_skipped_excludes_strict_selection(
          whole,
          current,
          selected,
          prefix,
          selected_suffix,
          strict
        )
      AtomicPathSkippedPrefixEscapedOneKind(_) -> after_skipped_case()
      AtomicPathSkippedPrefixEscapedConsKind(_, _) -> after_skipped_case()
      AtomicPathSkippedPrefixRejectedConsKind(_, _, _) -> after_skipped_case()


  @reducible
  fn atomic_path_failure_after_skipped_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased skipped_kind: AtomicPathSkippedPrefixKind},
    @erased prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureAfterSkippedKind(skipped_kind))
  ) -> AtomicPathFailureSkippedPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, skipped_kind) = match prefix
    AtomicPathFailureAfterSkipped(_, evidence) -> AtomicPathFailureSkippedPacked(evidence)

  ## The public indexed type admits an empty skipped-prefix index so generic
  ## construction remains closed under recursion. In that base case the
  ## skipped evidence identifies `whole` and `current`, reducing the alleged
  ## reverse selection to the same finite asymmetry contradiction as a root
  ## failure.
  @reducible
  fn atomic_path_failure_after_empty_skipped_excludes_strict_selection(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    whole: List(LookaroundAdmittedState(n)),
    current: List(LookaroundAdmittedState(n)),
    selected: List(LookaroundAdmittedState(n)),
    @erased prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureAfterSkippedKind(AtomicPathSkippedPrefixEmptyKind())),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, selected),
    strict: AtomicPathStrictCursorSuffix(n, selected, current)
  ) -> Empty = match prefix
    AtomicPathFailureAfterSkipped(_, evidence) -> match evidence
      AtomicPathSkippedPrefixEmpty() -> atomic_path_strict_cursor_suffix_excludes_reverse(strict, selected_suffix)
























  fn atomic_lookaround_initial_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), starts: List(MachineState(n))) -> AtomicSearchResult = match starts
    [] -> AtomicSearchNo()
    [head | remaining] -> match blocked_depth
      Some(commit_depth) -> match atomic_commit_disposition(atomic_scope_max_depth(machine_state_routine(n, head), Z()), commit_depth)
        AtomicCommitBlocks(_) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)
        AtomicCommitEscapes(_) -> atomic_lookaround_initial_member(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, head, remaining)
      None() -> atomic_lookaround_initial_member(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, head, remaining)

  fn atomic_lookaround_initial_member(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), head: MachineState(n), remaining: List(MachineState(n))) -> AtomicSearchResult = match head
    Active(state, routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_lookaround_accepting_from(depth, n, machine, input, after_input, ThreadActive(state), history, append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)
    Accepted(routine, _) -> match execute_routine(routine, [], [])
      EvidenceExecution(_, _) -> match atomic_scope_effect(routine, Z())
        AtomicScopeEffect(next_depth, _) -> match atomic_lookaround_accepting_from(depth, n, machine, input, after_input, ThreadAccepted(), history, append_routine(capture_context, routine), policy, next_depth)
          AtomicSearchYes() -> AtomicSearchYes()
          AtomicSearchCommit(commit_depth) -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, Some(commit_depth), remaining)
          AtomicSearchNo() -> atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, blocked_depth, remaining)












  ## Extract the typed sibling-tail package from a rejected destination.  The
  ## parent failure kind and current spine are already fixed by this function's
  ## index, so the single constructor match is proof-only and emits no runtime
  ## failure classification.
  fn atomic_path_destination_rejected_tail_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    @erased evidence: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    )
  ) -> AtomicPathRejectedTailAt(
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(source),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = match evidence
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) -> AtomicPathTailPackagePacked(tail_failure)

  ## Refine a non-empty existential tail at its proof-only construction
  ## boundary.  A tail package whose current spine starts with `candidate`
  ## can only contain a destination-rejection refutation.  The contradiction
  ## is consumed here rather than returned as an erased runtime value.
  @reducible
  fn atomic_path_rejected_tail_refinement(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil())
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match package
    AtomicPathTailPackagePacked(failure) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        atomic_path_destinations_exhausted_tail_refinement(
          machine,
          char,
          rest,
          after_input,
          source,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          atomic_path_destination_rejected_tail_package(
            machine,
            char,
            rest,
            after_input,
            source,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            failure
          ),
          matched,
          remaining_input,
          routine,
          LookaroundAdmittedStateCursorSuffixHere(
            reflexive(empty_lookaround_admitted_states(n))
          ),
          path
        )

  ## Consume the selected-tail package produced by a two-sibling rejected
  ## destination.  The parent construction site has already fixed the
  ## selected cursor to the empty tail, so the dispatch can only carry the
  ## recursive package for `candidate`; refining that package reuses the
  ## existing singleton tail contradiction without rebuilding its failure.
  @reducible
  fn atomic_path_rejected_tail_dispatch_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    dispatch: AtomicPathSelectedTailDispatch(
      Empty,
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil()),
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match dispatch
    AtomicPathSelectedTailHead(value) -> lookaround_absurd(value)
    AtomicPathSelectedTailTail(package) -> match package
      AtomicPathSelectedTailPackagePacked(tail_package, _tail_suffix, path) ->
        atomic_path_rejected_tail_refinement(
          machine,
          char,
          rest,
          after_input,
          source,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          candidate,
          tail_package,
          matched,
          remaining_input,
          routine,
          path
        )

  ## Consume the selected-tail package after the outer candidate and one
  ## nested candidate have both been rejected.  The package's remaining
  ## cursor is exactly `Cons(nested_candidate, Cons(tail_candidate, Nil()))`;
  ## refining its destination-rejection branch constructs the final singleton
  ## package from the same failure tree and hands it to the existing
  ## contradiction.  All package fields remain erased.
  @reducible
  fn atomic_path_rejected_tail_dispatch_excludes_nested_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    nested_candidate: LookaroundAdmittedState(n),
    tail_candidate: LookaroundAdmittedState(n),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    dispatch: AtomicPathSelectedTailDispatch(
      Empty,
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(nested_candidate, Cons(tail_candidate, Nil())),
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match dispatch
    AtomicPathSelectedTailHead(value) -> lookaround_absurd(value)
    AtomicPathSelectedTailTail(package) -> match package
      AtomicPathSelectedTailPackagePacked(_tail_package, _tail_suffix, path) ->
        match _tail_package
          AtomicPathTailPackagePacked(tail_failure) -> match tail_failure
            AtomicPathInputExhausted(_, _) -> impossible
            AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
            AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
            AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
              atomic_path_rejected_tail_refinement(
                machine,
                char,
                rest,
                after_input,
                source,
                history,
                capture_context,
                policy,
                scope_depth,
                prefix_mode,
                reversed_prefix,
                whole,
                tail_candidate,
                atomic_path_destination_rejected_tail_package(
                  machine,
                  char,
                  rest,
                  after_input,
                  source,
                  history,
                  capture_context,
                  policy,
                  scope_depth,
                  prefix_mode,
                  reversed_prefix,
                  tail_failure
                ),
                matched,
                remaining_input,
                routine,
                path
              )

  ## Consume an arbitrary-length rejected destination tail from the typed
  ## package boundary.  Keeping the package as an erased argument preserves
  ## the construction-site elimination discipline used by the shorter tail
  ## consumers below.
  @reducible
  fn atomic_path_rejected_tail_package_step(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {@erased remaining: List(LookaroundAdmittedState(n))},
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining)
    )
  ) -> AtomicPathTailPackage(
    depth,
    n,
    machine,
    Cons(char, rest),
    after_input,
    ThreadActive(state),
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = match package
    AtomicPathTailPackagePacked(failure) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) -> AtomicPathTailPackagePacked(tail_failure)

  @reducible
  fn atomic_path_rejected_tail_fold_from_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased remaining: List(LookaroundAdmittedState(n))},
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      Nil()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> match package
        AtomicPathTailPackagePacked(failure) -> match failure
          AtomicPathInputExhausted(_, _) -> impossible
          AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
          AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> atomic_path_failure_excludes_aligned_trace(
            machine,
            char,
            rest,
            after_input,
            state,
            history,
            capture_context,
            policy,
            scope_depth,
            prefix_mode,
            reversed_prefix,
            whole,
            failure,
            matched,
            remaining_input,
            routine,
            LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n))),
            path
          )
          AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    LookaroundAdmittedStateCursorSuffixDrop(next, tail_suffix) ->
      let tail_package = atomic_path_rejected_tail_package_step(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        next,
        package
      )
      atomic_path_rejected_tail_fold_from_package(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        tail_package,
        matched,
        remaining_input,
        routine,
        tail_suffix,
        path
      )

  ## Recursively consume rejected destination siblings until the selected
  ## sibling is accepted.  The selected path's head index excludes active
  ## transitions at this boundary; an exact accepted-child failure is then
  ## discharged by the canonical exact-child eliminator.
  @reducible
  fn atomic_path_rejected_tail_fold_to_accepted(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {selected_remaining: List(LookaroundAdmittedState(n))},
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> match failure
        AtomicPathInputExhausted(_, _) -> impossible
        AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
        AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, _, child_scope_alignment, _, _, _, _) -> match path
          AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
          AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> match child_scope_alignment
            LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match child_failure
              AtomicPathExactAcceptedWithInput(_, _, _, _) -> atomic_path_failure_excludes_selected_suffix(
                machine,
                char,
                rest,
                after_input,
                ThreadActive(state),
                history,
                capture_context,
                policy,
                scope_depth,
                reversed_prefix,
                accepted_routine,
                accepted_constraints,
                accepted_assertion_routine,
                accepted_assertion_markers,
                accepted_nested_decisions,
                child_failure,
                path
              )
    LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) ->
      match failure
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) ->
          atomic_path_rejected_tail_fold_to_accepted_from_failure(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
          reversed_prefix,
          whole,
          tail_failure,
        accepted_routine,
        accepted_constraints,
        accepted_assertion_routine,
        accepted_assertion_markers,
        accepted_nested_decisions,
        tail_suffix,
        path
          )

  ## Recurse through a rejected sibling tail until the selected accepted
  ## sibling is at its head. The refutation is consumed directly at each
  ## constructor boundary, so the existential tail failure never needs a
  ## runtime package or a special-case wrapper.
  @reducible
  fn atomic_path_rejected_tail_fold_to_accepted_from_failure(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathFailureKind},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      kind
    ),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {selected_remaining: List(LookaroundAdmittedState(n))},
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> match failure
        AtomicPathInputExhausted(_, _) -> impossible
        AtomicPathExactAcceptedWithInput(_, _, _, _) -> impossible
        AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> impossible
        AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, _, child_scope_alignment, _, _, _, tail_failure) -> match path
          AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> match child_scope_alignment
            LookaroundAdmittedStateScopeAccepted(_, _, _, _, _) -> match child_failure
              AtomicPathExactAcceptedWithInput(_, _, _, _) -> atomic_path_failure_excludes_selected_suffix(
                machine,
                char,
                rest,
                after_input,
                ThreadActive(state),
                history,
                capture_context,
                policy,
                scope_depth,
                reversed_prefix,
                accepted_routine,
                accepted_constraints,
                accepted_assertion_routine,
                accepted_assertion_markers,
                accepted_nested_decisions,
                child_failure,
                path
              )
    LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) -> match failure
      AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure) ->
        atomic_path_rejected_tail_fold_to_accepted_from_failure(
          machine,
          char,
          rest,
          after_input,
          state,
          history,
          capture_context,
          policy,
          scope_depth,
          prefix_mode,
          reversed_prefix,
          whole,
          tail_failure,
          accepted_routine,
          accepted_constraints,
          accepted_assertion_routine,
          accepted_assertion_markers,
          accepted_nested_decisions,
          tail_suffix,
          path
        )

  ## Consume an arbitrary-length rejected destination tail.  Unlike the
  ## historical two- and three-sibling helpers above, this fold recurses on
  ## the indexed tail spine itself.  The selected trace is fixed at `Nil()`;
  ## each `Drop` suffix therefore transports exactly the next tail cursor, and
  ## the recursive call refines the existential tail failure at that same
  ## construction site.  The final empty tail is discharged by the aligned
  ## destination-exhaustion eliminator.  All arguments carrying failure,
  ## cursor, and path evidence remain erased.
  @reducible
  fn atomic_path_rejected_tail_fold_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    remaining: List(LookaroundAdmittedState(n)),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      Nil()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match selection_from_current
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> impossible
    LookaroundAdmittedStateCursorSuffixDrop(_, tail_suffix) ->
      let tail_package: AtomicPathTailPackage(
        depth,
        n,
        machine,
        Cons(char, rest),
        after_input,
        ThreadActive(state),
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        remaining
      ) = atomic_path_destination_rejected_tail_package(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        failure
      )
      atomic_path_rejected_tail_fold_from_package(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        tail_package,
        matched,
        remaining_input,
        routine,
        tail_suffix,
        path
      )

  ## The empty-tail counterpart fixes the existential package's kind at the
  ## destination-exhaustion constructor.  It is used only after a rejected
  ## sibling has been refined, so the nested proof consumes the actual tail
  ## package rather than manufacturing an exhaustion witness.
  @reducible
  fn atomic_path_destinations_exhausted_tail_refinement(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased package: AtomicPathTailPackage(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased tail_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Nil(),
      Nil()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = atomic_path_tail_package_destinations_exhausted_excludes_trace(
    machine,
    char,
    rest,
    after_input,
    source,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    package,
    matched,
    remaining_input,
    routine,
    tail_suffix,
    path
  )






























  ## The root exhaustion consumer keeps the public wrapper and its parallel
  ## no-result evidence together at the first complete start-list boundary.
  ## Matching both packages refines the root list to `Nil()`; the selected
  ## membership is then impossible, so no recursive failure tag or runtime
  ## proof payload needs to be inspected.
  @reducible
  fn atomic_start_root_exhaustion_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    @erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    {item: LookaroundAdmittedState(n)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, item, matched, remaining_input, routine)
  ) -> Empty = match failure
    AtomicStartExhausted(_, _) -> atomic_start_failure_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      membership,
      failure,
      path
    )


  @reducible
  fn atomic_start_refutation_exhaustion_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    @erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    {item: LookaroundAdmittedState(n)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      item,
      matched,
      remaining_input,
      routine
    )
  ) -> result = lookaround_absurd(atomic_start_root_exhaustion_excludes_trace(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    path
  ))

  ## Public selected-trace adapter for an exhausted start root.  The root
  ## wrapper and its parallel no-result evidence both refine the complete
  ## start list to `Nil()`, while the selected trace still carries the member
  ## it claims to have chosen.  Passing that impossible membership through
  ## the existing root exhaustion consumer closes this failure family without
  ## inspecting an erased failure tag or retrying the machine search.
  @reducible
  fn atomic_start_refutation_exhausted_selected_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Nil()
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Nil(),
      Nil(),
      AtomicStartFailureExhausted()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Nil(),
      Nil(),
      AtomicStartFailureExhausted()
    ),
    {selected_start: LookaroundAdmittedState(n)},
    @erased membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Nil()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    )
  ) -> result = atomic_start_refutation_exhaustion_excludes_trace(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    path
  )

  ## Root blocked failures retain their exact parent failure/evidence pair
  ## while entering the typed non-empty-tail dispatcher.  The package is
  ## constructed at this boundary, and the later-sibling obligation remains a
  ## zero-argument proof-only continuation; no existential tail kind or
  ## commitment tag is promoted into runtime control.
  @reducible
  fn atomic_start_root_blocked_tail_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(candidate, remaining)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> result =
    let package: AtomicStartTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining)
    ) = AtomicStartTailPackagePacked(failure, evidence)
    lookaround_absurd(atomic_start_rejected_member_there_nonempty_tail_blocked_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      candidate,
      package,
      failure,
      evidence,
      skip,
      allowed,
      membership,
      path,
      tail_case
    ))

  ## A public blocked root refutation is consumed only after its existential
  ## whole/current list has been refined to a non-empty spine.  This keeps the
  ## root wrapper and its parallel no-result evidence aligned while handing
  ## the exact parent pair to the typed tail bridge; no failure constructor is
  ## inspected as runtime control flow.
  @reducible
  fn atomic_start_refutation_blocked_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(candidate, remaining)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> result = atomic_start_root_blocked_tail_dispatch(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    candidate,
    failure,
    evidence,
    skip,
    allowed,
    membership,
    path,
    tail_case
  )

  ## A rejected public root refutation uses the same shared `Here`/`There`
  ## induction as an ordinary rejected tail.  The root's existential list is
  ## refined to a non-empty spine by the indexed failure/evidence pair, while
  ## callers supply the head contradiction and the proof-only sibling
  ## continuation.  No rejected-tail constructor is recovered at runtime.
  @reducible
  fn atomic_start_refutation_rejected_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(candidate, remaining)
    ),
    head_case: result,
    tail_case: () -> result
  ) -> result = atomic_start_rejected_member_induction_erased(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    head_case,
    tail_case
  )

  ## Consume the public root certificate against the selected-start witness.
  ## The root constructor's indexed whole list is carried alongside the
  ## constructor-specific root packages; after that refinement the shared
  ## rejected fold can consume the exact membership edge without rebuilding a
  ## start list or introducing runtime proof dispatch.
  @reducible
  fn atomic_start_refutation_excludes_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining)
    ),
    @erased root_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased root_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased _witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    selected_member: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(candidate, remaining)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    head_case: Empty,
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_rejected_member_induction_selected_erased(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    root_failure,
    root_evidence,
    selected_member,
    path,
    head_case,
    tail_case
  )

  ## Package-native rejected-root adapter. Unlike the legacy public bridge it
  ## does not accept an erased witness merely to recover the selected trace;
  ## the exact trace and its recursive package arrive already correlated.
  @reducible
  fn atomic_start_refutation_excludes_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, input: List(Char), after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, prefix_mode: Bool,
    reversed_prefix: List(Char),
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased root_failure: AtomicStartMembersRefutation(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(candidate, remaining), Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased root_evidence: AtomicStartNoEvidence(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(candidate, remaining), Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    selected_member: ListMember(
      LookaroundAdmittedState(n), selected_start, Cons(candidate, remaining)
    ),
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    head_case: Empty,
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(candidate, remaining), remaining, selected_start, matched,
      remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_rejected_member_induction_selected_package(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    root_failure,
    root_evidence,
    selected_member,
    trace_package,
    head_case,
    tail_case
  )

  ## Wire a blocked public root certificate into the selected-trace root
  ## consumer. Commitment and allowance evidence remain erased indices; the
  ## canonical blocked-root bridge owns the `Here`/`There` fold and receives a
  ## proof-only continuation for the later sibling.
  @reducible
  fn atomic_start_refutation_blocked_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    candidate: LookaroundAdmittedState(n),
    remaining: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(candidate, remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_blocked_excludes_trace(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    candidate,
    failure,
    evidence,
    skip,
    allowed,
    membership,
    path,
    sibling_tail_case
  )


  ## Public selected-trace adapter for the accepted root at empty input.  The
  ## accepted-head child certificate is impossible by the indexed polarity
  ## above; the sibling case is still handed to the shared start-list fold so
  ## later candidates retain their selected trace.
  @reducible
  fn atomic_start_refutation_rejected_accepted_empty_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    {@erased child_kind: AtomicPathFailureKind},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      child_kind
    ),
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining)
    ),
    @erased root_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    @erased root_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    selected_member: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let head_case: Empty = atomic_start_accepted_empty_child_excludes_trace(
      machine,
      after_input,
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      reversed_prefix,
      child_failure
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      assert_type Nil() : List(Char),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      _refutation,
      root_failure,
      root_evidence,
      witness,
      selected_member,
      path,
      head_case,
      sibling_tail_case
    )

  ## Wire the concrete accepted-root contradiction into the public
  ## selected-trace consumer. Accepted roots consume a non-empty exact child
  ## input, so the package carries the child refutation and cursor suffix that
  ## the exact-child eliminator needs. The root wrapper, package, failure,
  ## evidence, witness, membership, and selected trace all share one indexed
  ## accepted-head spine.
  @reducible
  fn atomic_start_refutation_rejected_accepted_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartAcceptedRejectedTailPackage(
      depth,
      n,
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      child_whole,
      child_current
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let head_case: Empty = atomic_start_rejected_member_there_nonempty_tail_accepted_excludes_trace(
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      package,
      membership,
      path,
      selected_path,
      sibling_tail_case
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      _refutation,
      failure,
      evidence,
      witness,
      membership,
      selected_path,
      head_case,
      sibling_tail_case
    )

  ## Wire the concrete active-root contradiction into the public selected-trace
  ## consumer. The head proof is built once at this construction site; the
  ## sibling obligation remains a proof-only continuation for the recursive
  ## start-list fold.
  @reducible
  fn atomic_start_refutation_rejected_active_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    active_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty,
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty =
    let head_case: Empty = atomic_start_refutation_rejected_active_excludes_trace(
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      rest,
      selected_start,
      failure,
      evidence,
      membership,
      path,
      active_tail_case
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      assert_type Nil() : List(Char),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      _refutation,
      failure,
      evidence,
      witness,
      membership,
      path,
      head_case,
      sibling_tail_case
    )

  ## The concrete active root case supplies the first head continuation to the
  ## shared rejected-root fold.  Its child input is definitionally empty, so
  ## the existing active-child consumer can eliminate the selected trace; a
  ## later sibling receives the exact root-tail package through `tail_case`.
  @reducible
  fn atomic_start_refutation_rejected_active_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_rejected_member_here_excludes_trace(
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    path,
    tail_case
  )

  ## Package-native active-root contradiction. Membership is the relevant
  ## discriminator: Here refines the selected package to the rejected active
  ## candidate, while There preserves that same package across the rejected
  ## sibling tail. No erased selected trace is inspected.
  @reducible
  fn atomic_start_refutation_rejected_active_excludes_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, prefix_mode: Bool,
    reversed_prefix: List(Char), state: Bounded(n),
    routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased _failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole, rest,
      selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = match atomic_start_member_location(
    selected_start,
    LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
    rest,
    membership
  )
    AtomicStartMemberHere(_) -> atomic_start_candidate_rejection_excludes_package(
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      trace_package
    )
    AtomicStartMemberThere(_, prior) -> match evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) -> tail_case(
        AtomicStartSelectedTailTracePacked(
          tail_failure,
          tail_evidence,
          prior,
          trace_package
        )
      )

  ## Public package-native active-root wrapper. This is the migration target
  ## for callers that already receive `AtomicSelectedTracePackage` from the
  ## start-search success result.
  @reducible
  fn atomic_start_refutation_rejected_active_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, prefix_mode: Bool,
    reversed_prefix: List(Char), state: Bounded(n),
    routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      rest, selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_rejected_active_excludes_package(
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    trace_package,
    tail_case
  )

  ## Package-native accepted-root contradiction. The selected membership owns
  ## the only relevant branch: Here exposes an accepted start package whose
  ## exact child still has input and is therefore impossible; There forwards
  ## the exact selected package with the rejected sibling tail.
  @reducible
  fn atomic_start_refutation_rejected_accepted_excludes_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, child_char: Char, child_rest: List(Char),
    after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased _failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix, whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix, whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix, whole, rest,
      selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = match atomic_start_member_location(
    selected_start,
    LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
    rest,
    membership
  )
    AtomicStartMemberHere(_) -> atomic_start_accepted_candidate_rejection_excludes_package(
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      trace_package
    )
    AtomicStartMemberThere(_, prior) -> match evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) -> tail_case(
        AtomicStartSelectedTailTracePacked(
          tail_failure,
          tail_evidence,
          prior,
          trace_package
        )
      )

  ## Public package-native accepted-root wrapper. Unlike the trace-only
  ## predecessor it needs neither the accepted-tail recovery package nor a
  ## second erased trace specialized to the head candidate.
  @reducible
  fn atomic_start_refutation_rejected_accepted_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, child_char: Char, child_rest: List(Char),
    after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest, selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_rejected_accepted_excludes_package(
    machine,
    position,
    child_char,
    child_rest,
    after_input,
    history,
    capture_context,
    policy,
    reversed_prefix,
    accepted_routine,
    accepted_constraints,
    accepted_assertion_routine,
    accepted_assertion_markers,
    accepted_nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    trace_package,
    tail_case
  )

  ## An active start candidate rejected by its child cannot also be the head of
  ## a selected trace.  The rejection constructor publishes the child's exact
  ## suffix and refutation; this consumer passes both to the indexed child
  ## theorem instead of rebuilding either witness from an unindexed list.
  fn atomic_start_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      policy,
      atomic_scope_depth_after(routine, Z()),
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureInputExhausted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartActive(_, _, _, _, _, _, _, _, _, _, _, _, _, suffix) ->
      atomic_path_child_input_exhaustion_excludes_trace(
        machine,
        after_input,
        state,
        history,
        append_routine(append_routine(capture_context, routine), assertion_markers),
        policy,
        atomic_scope_depth_after(routine, Z()),
        prefix_mode,
        reversed_prefix,
        child_failure,
        child_suffix,
        suffix
      )


  ## An accepted start candidate cannot be selected when its child search
  ## rejects an exact match that leaves input behind.  The child failure's
  ## cursor suffix is consumed by the existing exact-child eliminator; this
  ## keeps start-list rejection on the same construction-site proof path as
  ## destination rejection.
  fn atomic_start_accepted_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureExactAccepted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartAccepted(_, _, _, _, _, _, _, _, _, _, _, _, suffix) ->
      atomic_path_child_exact_failure_excludes_trace(
        machine,
        child_char,
        child_rest,
        after_input,
        history,
        append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
        policy,
        atomic_scope_depth_after(accepted_routine, Z()),
        reversed_prefix,
        child_failure,
        child_suffix,
        suffix
      )


  ## A singleton accepted tail publishes its rejection through the typed
  ## no-result witness. Matching that witness establishes the rejected-tail
  ## branch before the separately indexed exact-child certificate is forwarded
  ## to the accepted-start eliminator; no raw `AtomicStartMembersRefutation`
  ## match is needed.
  fn atomic_start_tail_accepted_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureExactAccepted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_start_accepted_candidate_rejection_excludes_trace(
        machine,
        position,
        child_char,
        child_rest,
        after_input,
        history,
        capture_context,
        policy,
        reversed_prefix,
        accepted_routine,
        accepted_constraints,
        accepted_assertion_routine,
        accepted_assertion_markers,
        accepted_nested_decisions,
        child_failure,
        child_suffix,
        path
      )

  ## The recursive active-start case uses the same typed no-result witness,
  ## but its child contradiction is input exhaustion rather than exact
  ## accepted-with-trailing-input.  The parent path is indexed at the same
  ## active head, so the existing active-start eliminator discharges it.
  fn atomic_start_tail_active_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      policy,
      atomic_scope_depth_after(routine, Z()),
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureInputExhausted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_start_candidate_rejection_excludes_trace(
        machine,
        position,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        state,
        routine,
        constraints,
        assertion_routine,
        assertion_markers,
        nested_decisions,
        child_failure,
        child_suffix,
        path
      )

  ## A blocked active start with no remaining sibling is eliminated through
  ## the typed blocked-tail witness.  The stored parent failure is passed to
  ## the existing commitment contradiction, preserving the skip/allow index.
  fn atomic_start_tail_blocked_active_candidate_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureBlocked()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoBlockedEvidence(_, _, _, scope, _, _) -> atomic_start_scope_record_excludes_allowed(scope, skip, allowed)

  ## The accepted blocked-tail base is identical at the proof boundary, with
  ## the selected-start index choosing the accepted constructor explicitly.
  fn atomic_start_tail_blocked_accepted_candidate_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureBlocked()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoBlockedEvidence(_, _, _, scope, _, _) -> atomic_start_scope_record_excludes_allowed(scope, skip, allowed)


  fn atomic_start_tail_exhaustion_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    @erased _tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Nil()),
    {item: LookaroundAdmittedState(n)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    @erased tail_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil(),
      AtomicStartFailureExhausted()
    ),
    {selected_start: LookaroundAdmittedState(n)},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    )
  ) -> Empty =
    let _ = atomic_start_tail_suffix_is_empty(_tail_suffix)
    atomic_start_failure_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      membership,
      tail_failure,
      path
    )

  ## The child-specific wrapper retains the refutation's own suffix witness
  ## while reducing the exhausted-input branch to the generic contradiction.
  ## This is the first theorem boundary where the stored refutation suffix is
  ## consumed rather than merely transported.
  fn atomic_path_child_input_exhaustion_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, {current: List(LookaroundAdmittedState(n))}, @erased failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureInputExhausted()), @erased failure_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current), {path_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathInputExhausted(_, stored_suffix) -> match failure_suffix
      LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_suffix
        LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path)
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## Base case for destination rejection: when an active candidate is rejected
  ## at the first character, its child refutation is indexed at exhausted
  ## input, while a selected trace at that same candidate must expose an active
  ## child suffix.  The two indices are disjoint.  This is the first concrete
  ## destination-rejection slice; the general tail/child induction remains
  ## parameterized by the corresponding candidate-suffix alignment.
