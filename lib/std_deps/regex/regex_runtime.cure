  fn lookaround_prefix_path(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> LookaroundPrefixPathResult(depth, n, machine, input, after_input, state, history, policy, capture_context) = match state
    ThreadAccepted() -> lookaround_prefix_path_now(depth, n, machine, input, after_input, history, capture_context, policy)
    ThreadActive(source) -> match input
      [] ->
        let cursor: MachineStateCursor(n, empty_machine_states(n), empty_machine_states(n)) = MachineStateCursorHere()
        LookaroundPrefixPathRejectedEmpty(source, cursor, lookaround_prefix_path_exhausted(depth, n, machine, after_input, source, history, capture_context, policy, empty_machine_states(n), MachineStateMembersNil(), cursor, reflexive(empty_machine_states(n))))
      [char | rest] -> match lookaround_prefix_members_path(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, machine_state_members(lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), MachineStateCursorHere())
        LookaroundPrefixMembersRejected(_, failure, cursor) -> LookaroundPrefixPathRejectedStep(source, char, rest, cursor, failure)
        LookaroundPrefixMembersFound(cursor_suffix, path) -> LookaroundPrefixPathFoundActive(source, char, rest, lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy), reflexive(lookaround_machine_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), cursor_suffix, path)

