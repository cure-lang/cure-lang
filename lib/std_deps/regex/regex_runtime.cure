  fn atomic_path_commit_after_root_destinations_exhausted_excludes_aligned_selected_trace(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased active_state: Bounded(n)},
    {@erased active_routine: List(EvidenceInstruction)},
    {@erased active_constraints: List(BoundaryConstraint)},
    {@erased active_assertion_routine: List(ExtendedInstruction)},
    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    @erased cause: AtomicPathCommitCause(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining), commit_depth, AtomicPathCommitAfterFailureKind(AtomicPathFailureAtRootKind(), AtomicPathFailureDestinationsExhausted())),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining), matched, remaining_input, selected_routine)
