  fn atomic_lookaround_routine_initial_members(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), position: InitialPosition, history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, blocked_depth: Option(Nat), whole: List(LookaroundAdmittedState(n)), starts: List(LookaroundAdmittedState(n)), @erased cursor: LookaroundAdmittedStateCursor(n, whole, starts), @erased witness: LookaroundAdmittedStateCursorWitness(n, whole, starts), @erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, starts), @erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_admitted_starts(depth, n, machine, position, input, after_input, history, capture_context, policy)), prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicStartMembersResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, starts) = match starts
    [] -> AtomicStartMembersNo(AtomicStartFailureExhausted(), AtomicStartExhausted(suffix, canonical), AtomicStartNoExhaustedEvidence(suffix, canonical))
    [LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions) | remaining] -> atomic_lookaround_routine_initial_active(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, remaining, cursor, witness, suffix, canonical, prefix_mode, reversed_prefix)
    [LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions) | remaining] -> atomic_lookaround_routine_initial_accepted(depth, n, machine, input, after_input, position, history, capture_context, policy, blocked_depth, whole, routine, constraints, assertion_routine, assertion_markers, nested_decisions, remaining, cursor, witness, suffix, canonical, prefix_mode, reversed_prefix)

  fn atomic_lookaround_start_selection(n: Nat, state: MachineState(n), blocked_depth: Option(Nat)) -> AtomicStartSelection(blocked_depth) = match blocked_depth
    None() -> AtomicStartSelectionAllowed(AtomicStartAllowedNone())
    Some(commit_depth) -> match atomic_commit_disposition(atomic_scope_max_depth(machine_state_routine(n, state), Z()), commit_depth)
      AtomicCommitBlocks(proof) -> AtomicStartSelectionBlocked(AtomicStartSkipByScope(proof))
      AtomicCommitEscapes(proof) -> AtomicStartSelectionAllowed(AtomicStartAllowedEscape(proof))

  @reducible
  fn atomic_depth_at_least_excludes_below(
    {result: Type},
    {left: Nat},
    {right: Nat},
    @erased at_least: AtomicDepthAtLeast(left, right),
    @erased below: AtomicDepthBelow(left, right)
  ) -> result = match at_least
    AtomicDepthAtLeastZero() -> match below
      AtomicDepthBelowZero() -> impossible
    AtomicDepthAtLeastFromZero() -> match below
      AtomicDepthBelowZero() -> impossible
      AtomicDepthBelowStep(_) -> impossible
    AtomicDepthAtLeastStep(prior) -> match below
      AtomicDepthBelowZero() -> impossible
      AtomicDepthBelowStep(next) -> atomic_depth_at_least_excludes_below(prior, next)

  ## The same routine close cannot both permit sibling traversal and block it.
  ## Equality of the indexed close first rules out None versus Some; for two
  ## Some values it identifies the commit depth before the finite order
  ## contradiction is consumed.
  @reducible
  fn atomic_path_failure_continuation_excludes_blocked(
    {scope_depth: Nat},
    {closed_depth: Option(Nat)},
    {commit_depth: Nat},
    @erased continuation: AtomicPathFailureContinuation(scope_depth, closed_depth),
    @erased close_canonical: Equivalent(Option(Nat), closed_depth, Some(commit_depth)),
    @erased blocked: AtomicDepthAtLeast(scope_depth, commit_depth)
  ) -> Empty = match continuation
    AtomicPathSiblingNoClose(no_close) -> match trans(sym(no_close), close_canonical)
    AtomicPathSiblingEscapedClose(_, escaped_close, escaped) -> match trans(sym(escaped_close), close_canonical)
      reflexive() -> atomic_depth_at_least_excludes_below(blocked, escaped)

  fn atomic_start_scope_selection_excludes(
    {result: Type},
    {scope_depth: Nat},
    {blocked_depth: Nat},
    @erased blocked: AtomicStartScopeSelection(scope_depth, blocked_depth, AtomicStartScopeBlockedRole()),
    @erased allowed: AtomicStartScopeSelection(scope_depth, blocked_depth, AtomicStartScopeAllowedRole())
  ) -> result = match blocked
    AtomicStartScopeBlocked(at_least) -> match allowed
      AtomicStartScopeAllowed(below) -> atomic_depth_at_least_excludes_below(at_least, below)

  ## The origin token is part of the evidence index.  Candidate commits,
  ## blocked outer commits, and escaped outer commits therefore cannot be
  ## mistaken for one another when a refutation is consumed.
  fn atomic_start_skip_excludes_allowed(
    {result: Type},
    {blocked_depth: Option(Nat)},
    {kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind)
  ) -> result = match skip
    AtomicStartSkipByCommit(_) -> match allowed
    AtomicStartSkipByScope(proof) -> match allowed
      AtomicStartAllowedEscape(_) -> impossible

  ## The blocked-tail dispatcher consumes the construction-site scope record
  ## before applying the ordinary skip/allow contradiction. This keeps the
  ## exact admitted candidate and its canonical skip token together at the
  ## boundary where a rejected tail is compared with a selected trace.
  fn atomic_start_scope_record_excludes_allowed(
    {result: Type},
    {n: Nat},
    {blocked_depth: Option(Nat)},
    {kind: AtomicStartSkipKind},
    @erased scope: AtomicStartScopeEvidence(n, AtomicStartScopeEvidenceBlockedRole()),
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind)
  ) -> result = match scope
    AtomicStartScopeEvidenceRecorded(_, _) -> atomic_start_skip_excludes_allowed(skip, allowed)

  ## A blocked start candidate cannot also be the selected start.  The
  ## refutation and selected trace are both consumed at this construction
  ## boundary: the blocked candidate publishes the exact skip token, while a
  ## selected start publishes the matching `AtomicStartAllowed` evidence.
  ## Their indexed commitment decisions are disjoint, so no runtime flag or
  ## second search is needed.
  fn atomic_start_blocked_active_candidate_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureBlocked()
    ),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartActive(_, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> atomic_start_skip_excludes_allowed(skip, allowed)

  ## The same blocked-start contradiction applies to an accepted machine
  ## candidate.  Keeping this branch separate from the active constructor
  ## lets the selected-start index eliminate the other constructor without a
  ## runtime inspection of an erased state tag.
  fn atomic_start_blocked_accepted_candidate_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureBlocked()
    ),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartAccepted(_, _, _, _, _, _, _, _, _, _, _, _, suffix) -> atomic_start_skip_excludes_allowed(skip, allowed)

  fn atomic_scope_depth_after(routine: List(EvidenceInstruction), depth: Nat) -> Nat = match atomic_scope_effect(routine, depth)
    AtomicScopeEffect(next_depth, _) -> next_depth

  ## An active atomic path cannot exist at an exhausted input.  The selected
  ## trace has only terminal constructors at an empty input, and both terminal
  ## constructors require `ThreadAccepted`; eliminating that indexed mismatch
  ## is the first machine-denotation refutation lemma for the atomic tree.
  fn atomic_path_input_exhaustion_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {candidate_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, candidate_current, matched, remaining_input, routine)) -> result = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible

  ## Erased-context counterpart for nested construction sites.  A selected
  ## suffix extracted from an erased transition cannot be passed to the
  ## polymorphic eliminator above because its context arguments are relevant
  ## there.  This proof-only leaf repeats the same indexed absurdity with every
  ## premise erased, so nested dispatch can consume the suffix without
  ## manufacturing a runtime argument or weakening relevance checking.
  @reducible
  fn atomic_path_input_exhaustion_excludes_trace_erased(
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    {@erased after_input: List(Char)},
    {@erased state: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool},
    {@erased reversed_prefix: List(Char)},
    {@erased candidate_current: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible

  ## Erased-context exact counterpart.  It is the accepted-thread/non-empty
  ## input absurdity used when a nested selected transition is unpacked from
  ## an erased parent trace.
  @reducible
  fn atomic_path_exact_failure_excludes_trace_erased(
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    {@erased char: Char},
    {@erased rest: List(Char)},
    {@erased after_input: List(Char)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy},
    {@erased scope_depth: Nat},
    {@erased reversed_prefix: List(Char)},
    {@erased candidate_current: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased routine: List(ExtendedInstruction)},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadAccepted(),
      history,
      capture_context,
      policy,
      scope_depth,
      False(),
      reversed_prefix,
      Nil(),
      Nil(),
      AtomicPathFailureExactAccepted()
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadAccepted(),
      history,
      capture_context,
      policy,
      scope_depth,
      False(),
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    )
  ) -> Empty = match path
    AtomicSelectedPrefixDone() -> impossible
    AtomicSelectedExactDone() -> impossible
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## A start-list refutation at the empty suffix cannot coexist with any
  ## selected atomic trace.  The membership witness is the same construction
  ## authority used by the ordinary lookaround refutation theorem: once the
  ## current start suffix is `Nil()`, the selected start has no possible edge.
  ## This is the start-list base case; candidate and blocked-sibling induction
  ## consumes the corresponding `Here`/`There` witnesses below.
  fn atomic_start_failure_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {item: LookaroundAdmittedState(n)},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    @erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, Nil(), AtomicStartFailureExhausted()),
    {selected_start: LookaroundAdmittedState(n)},
    @erased _path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, routine)
  ) -> Empty = match failure
    AtomicStartExhausted(_, _) -> lookaround_impossible_list_member(membership)

  ## The root exhaustion consumer keeps the public wrapper and its parallel
  ## no-result evidence together at the first complete start-list boundary.
  ## Matching both packages refines the root list to `Nil()`; the selected
  ## membership is then impossible, so no recursive failure tag or runtime
  ## proof payload needs to be inspected.
  @reducible
  fn atomic_start_root_exhaustion_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    @erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    {item: LookaroundAdmittedState(n)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, item, matched, remaining_input, routine)
  ) -> Empty = match failure
    AtomicStartExhausted(_, _) -> atomic_start_failure_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      membership,
      failure,
      path
    )

  ## The public start refutation is an existential wrapper around the complete
  ## root member traversal.  Construct and eliminate that wrapper at the same
  ## root boundary: the exhausted constructor exposes the empty root suffix
  ## required by `atomic_start_root_exhaustion_excludes_trace`, while retaining
  ## the public certificate shape used by the decision result.
  @reducible
  fn atomic_start_refutation_root_exhausted(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    @erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted())
  ) -> AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil()) = AtomicStartRefutationRoot(failure, evidence)

  @reducible
  fn atomic_start_refutation_exhaustion_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    @erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicStartFailureExhausted()),
    {item: LookaroundAdmittedState(n)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      item,
      matched,
      remaining_input,
      routine
    )
  ) -> result = lookaround_absurd(atomic_start_root_exhaustion_excludes_trace(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    path
  ))

  ## Public selected-trace adapter for an exhausted start root.  The root
  ## wrapper and its parallel no-result evidence both refine the complete
  ## start list to `Nil()`, while the selected trace still carries the member
  ## it claims to have chosen.  Passing that impossible membership through
  ## the existing root exhaustion consumer closes this failure family without
  ## inspecting an erased failure tag or retrying the machine search.
  @reducible
  fn atomic_start_refutation_exhausted_selected_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Nil()
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Nil(),
      Nil(),
      AtomicStartFailureExhausted()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Nil(),
      Nil(),
      AtomicStartFailureExhausted()
    ),
    {selected_start: LookaroundAdmittedState(n)},
    @erased membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Nil()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    )
  ) -> result = atomic_start_refutation_exhaustion_excludes_trace(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    path
  )

  ## Root blocked failures retain their exact parent failure/evidence pair
  ## while entering the typed non-empty-tail dispatcher.  The package is
  ## constructed at this boundary, and the later-sibling obligation remains a
  ## zero-argument proof-only continuation; no existential tail kind or
  ## commitment tag is promoted into runtime control.
  @reducible
  fn atomic_start_root_blocked_tail_dispatch(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(candidate, remaining)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> result =
    let package: AtomicStartTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining)
    ) = AtomicStartTailPackagePacked(failure, evidence)
    lookaround_absurd(atomic_start_rejected_member_there_nonempty_tail_blocked_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      candidate,
      package,
      failure,
      evidence,
      skip,
      allowed,
      membership,
      path,
      tail_case
    ))

  ## A public blocked root refutation is consumed only after its existential
  ## whole/current list has been refined to a non-empty spine.  This keeps the
  ## root wrapper and its parallel no-result evidence aligned while handing
  ## the exact parent pair to the typed tail bridge; no failure constructor is
  ## inspected as runtime control flow.
  @reducible
  fn atomic_start_refutation_blocked_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(candidate, remaining)),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> result = atomic_start_root_blocked_tail_dispatch(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    candidate,
    failure,
    evidence,
    skip,
    allowed,
    membership,
    path,
    tail_case
  )

  ## A rejected public root refutation uses the same shared `Here`/`There`
  ## induction as an ordinary rejected tail.  The root's existential list is
  ## refined to a non-empty spine by the indexed failure/evidence pair, while
  ## callers supply the head contradiction and the proof-only sibling
  ## continuation.  No rejected-tail constructor is recovered at runtime.
  @reducible
  fn atomic_start_refutation_rejected_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(candidate, remaining)
    ),
    head_case: result,
    tail_case: () -> result
  ) -> result = atomic_start_rejected_member_induction_erased(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    failure,
    evidence,
    membership,
    head_case,
    tail_case
  )

  ## Consume the public root certificate against the selected-start witness.
  ## The root constructor's indexed whole list is carried alongside the
  ## constructor-specific root packages; after that refinement the shared
  ## rejected fold can consume the exact membership edge without rebuilding a
  ## start list or introducing runtime proof dispatch.
  @reducible
  fn atomic_start_refutation_excludes_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining)
    ),
    @erased root_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased root_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased _witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    selected_member: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(candidate, remaining)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    head_case: Empty,
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_rejected_member_induction_selected_erased(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    root_failure,
    root_evidence,
    selected_member,
    path,
    head_case,
    tail_case
  )

  ## Package-native rejected-root adapter. Unlike the legacy public bridge it
  ## does not accept an erased witness merely to recover the selected trace;
  ## the exact trace and its recursive package arrive already correlated.
  @reducible
  fn atomic_start_refutation_excludes_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, input: List(Char), after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, prefix_mode: Bool,
    reversed_prefix: List(Char),
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased root_failure: AtomicStartMembersRefutation(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(candidate, remaining), Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    @erased root_evidence: AtomicStartNoEvidence(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(candidate, remaining), Cons(candidate, remaining),
      AtomicStartFailureRejected()
    ),
    selected_member: ListMember(
      LookaroundAdmittedState(n), selected_start, Cons(candidate, remaining)
    ),
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    head_case: Empty,
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, input, after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(candidate, remaining), remaining, selected_start, matched,
      remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_rejected_member_induction_selected_package(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    root_failure,
    root_evidence,
    selected_member,
    trace_package,
    head_case,
    tail_case
  )

  ## Wire a blocked public root certificate into the selected-trace root
  ## consumer. Commitment and allowance evidence remain erased indices; the
  ## canonical blocked-root bridge owns the `Here`/`There` fold and receives a
  ## proof-only continuation for the later sibling.
  @reducible
  fn atomic_start_refutation_blocked_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    candidate: LookaroundAdmittedState(n),
    remaining: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      Cons(candidate, remaining),
      AtomicStartFailureBlocked()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(candidate, remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartBlockedSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(candidate, remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_blocked_excludes_trace(
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    candidate,
    failure,
    evidence,
    skip,
    allowed,
    membership,
    path,
    sibling_tail_case
  )

  ## An accepted start candidate cannot be rejected at the empty-input
  ## boundary.  Its child search is indexed at `ThreadAccepted()` and `Nil()`;
  ## the only empty-input refutation constructor is active-only.  Keep this
  ## contradiction at the construction site so the public selected-trace fold
  ## never needs a runtime failure tag or a second child search.
  @reducible
  fn atomic_start_accepted_empty_child_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    reversed_prefix: List(Char),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    {@erased child_kind: AtomicPathFailureKind},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadAccepted(),
      history,
      capture_context,
      policy,
      scope_depth,
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      child_kind
    )
  ) -> result = match child_failure
    AtomicPathInputExhausted(_, _) -> impossible

  ## Public selected-trace adapter for the accepted root at empty input.  The
  ## accepted-head child certificate is impossible by the indexed polarity
  ## above; the sibling case is still handed to the shared start-list fold so
  ## later candidates retain their selected trace.
  @reducible
  fn atomic_start_refutation_rejected_accepted_empty_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    {@erased child_kind: AtomicPathFailureKind},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      child_kind
    ),
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining)
    ),
    @erased root_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    @erased root_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {@erased selected_start: LookaroundAdmittedState(n)},
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    selected_member: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      remaining,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let head_case: Empty = atomic_start_accepted_empty_child_excludes_trace(
      machine,
      after_input,
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      reversed_prefix,
      child_failure
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      assert_type Nil() : List(Char),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      _refutation,
      root_failure,
      root_evidence,
      witness,
      selected_member,
      path,
      head_case,
      sibling_tail_case
    )

  ## Wire the concrete accepted-root contradiction into the public
  ## selected-trace consumer. Accepted roots consume a non-empty exact child
  ## input, so the package carries the child refutation and cursor suffix that
  ## the exact-child eliminator needs. The root wrapper, package, failure,
  ## evidence, witness, membership, and selected trace all share one indexed
  ## accepted-head spine.
  @reducible
  fn atomic_start_refutation_rejected_accepted_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartAcceptedRejectedTailPackage(
      depth,
      n,
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      child_whole,
      child_current
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let head_case: Empty = atomic_start_rejected_member_there_nonempty_tail_accepted_excludes_trace(
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      package,
      membership,
      path,
      selected_path,
      sibling_tail_case
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      _refutation,
      failure,
      evidence,
      witness,
      membership,
      selected_path,
      head_case,
      sibling_tail_case
    )

  ## Wire the concrete active-root contradiction into the public selected-trace
  ## consumer. The head proof is built once at this construction site; the
  ## sibling obligation remains a proof-only continuation for the recursive
  ## start-list fold.
  @reducible
  fn atomic_start_refutation_rejected_active_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    active_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty,
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty =
    let head_case: Empty = atomic_start_refutation_rejected_active_excludes_trace(
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      rest,
      selected_start,
      failure,
      evidence,
      membership,
      path,
      active_tail_case
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      assert_type Nil() : List(Char),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      _refutation,
      failure,
      evidence,
      witness,
      membership,
      path,
      head_case,
      sibling_tail_case
    )

  ## The concrete active root case supplies the first head continuation to the
  ## shared rejected-root fold.  Its child input is definitionally empty, so
  ## the existing active-child consumer can eliminate the selected trace; a
  ## later sibling receives the exact root-tail package through `tail_case`.
  @reducible
  fn atomic_start_refutation_rejected_active_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_rejected_member_here_excludes_trace(
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    path,
    tail_case
  )

  ## Package-native active-root contradiction. Membership is the relevant
  ## discriminator: Here refines the selected package to the rejected active
  ## candidate, while There preserves that same package across the rejected
  ## sibling tail. No erased selected trace is inspected.
  @reducible
  fn atomic_start_refutation_rejected_active_excludes_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, prefix_mode: Bool,
    reversed_prefix: List(Char), state: Bounded(n),
    routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased _failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, whole, rest,
      selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = match atomic_start_member_location(
    selected_start,
    LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
    rest,
    membership
  )
    AtomicStartMemberHere(_) -> atomic_start_candidate_rejection_excludes_package(
      machine,
      position,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      state,
      routine,
      constraints,
      assertion_routine,
      assertion_markers,
      nested_decisions,
      trace_package
    )
    AtomicStartMemberThere(_, prior) -> match evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) -> tail_case(
        AtomicStartSelectedTailTracePacked(
          tail_failure,
          tail_evidence,
          prior,
          trace_package
        )
      )

  ## Public package-native active-root wrapper. This is the migration target
  ## for callers that already receive `AtomicSelectedTracePackage` from the
  ## start-search success result.
  @reducible
  fn atomic_start_refutation_rejected_active_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, prefix_mode: Bool,
    reversed_prefix: List(Char), state: Bounded(n),
    routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix, selected_start,
      matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), rest),
      rest, selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_rejected_active_excludes_package(
    machine,
    position,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    state,
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    trace_package,
    tail_case
  )

  ## Package-native accepted-root contradiction. The selected membership owns
  ## the only relevant branch: Here exposes an accepted start package whose
  ## exact child still has input and is therefore impossible; There forwards
  ## the exact selected package with the rejected sibling tail.
  @reducible
  fn atomic_start_refutation_rejected_accepted_excludes_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, child_char: Char, child_rest: List(Char),
    after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased _failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix, whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix, whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix, whole, rest,
      selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = match atomic_start_member_location(
    selected_start,
    LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
    rest,
    membership
  )
    AtomicStartMemberHere(_) -> atomic_start_accepted_candidate_rejection_excludes_package(
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      trace_package
    )
    AtomicStartMemberThere(_, prior) -> match evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, tail_failure, tail_evidence) -> tail_case(
        AtomicStartSelectedTailTracePacked(
          tail_failure,
          tail_evidence,
          prior,
          trace_package
        )
      )

  ## Public package-native accepted-root wrapper. Unlike the trace-only
  ## predecessor it needs neither the accepted-tail recovery package nor a
  ## second erased trace specialized to the head candidate.
  @reducible
  fn atomic_start_refutation_rejected_accepted_selected_package(
    {depth: Nat}, {n: Nat}, machine: PatternMachine(n),
    position: InitialPosition, child_char: Char, child_rest: List(Char),
    after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    @erased failure: AtomicStartMembersRefutation(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(
      LookaroundAdmittedState(n), selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine
    )},
    trace_package: AtomicSelectedTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      selected_start, matched, remaining_input, selected_routine, path
    ),
    tail_case: (AtomicStartSelectedTailTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest, selected_start, matched, remaining_input, selected_routine
    )) -> Empty
  ) -> Empty = atomic_start_refutation_rejected_accepted_excludes_package(
    machine,
    position,
    child_char,
    child_rest,
    after_input,
    history,
    capture_context,
    policy,
    reversed_prefix,
    accepted_routine,
    accepted_constraints,
    accepted_assertion_routine,
    accepted_assertion_markers,
    accepted_nested_decisions,
    rest,
    selected_start,
    failure,
    evidence,
    membership,
    trace_package,
    tail_case
  )

  ## An active start candidate rejected by its child cannot also be the head of
  ## a selected trace.  The rejection constructor publishes the child's exact
  ## suffix and refutation; this consumer passes both to the indexed child
  ## theorem instead of rebuilding either witness from an unindexed list.
  fn atomic_start_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      policy,
      atomic_scope_depth_after(routine, Z()),
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureInputExhausted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartActive(_, _, _, _, _, _, _, _, _, _, _, _, _, suffix) ->
      atomic_path_child_input_exhaustion_excludes_trace(
        machine,
        after_input,
        state,
        history,
        append_routine(append_routine(capture_context, routine), assertion_markers),
        policy,
        atomic_scope_depth_after(routine, Z()),
        prefix_mode,
        reversed_prefix,
        child_failure,
        child_suffix,
        suffix
      )

  ## Package-native form of the active start contradiction. The selected
  ## start constructor exposes its exact child path package directly; at empty
  ## child input no constructor can inhabit that active-thread package.
  fn atomic_start_candidate_rejection_excludes_package(
    {result: Type}, {depth: Nat}, {n: Nat},
    machine: PatternMachine(n), position: InitialPosition,
    after_input: List(Char), history: List(Char),
    capture_context: List(EvidenceInstruction), policy: NewlinePolicy,
    prefix_mode: Bool, reversed_prefix: List(Char), state: Bounded(n),
    routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched, remaining_input, selected_routine
    )},
    package: AtomicSelectedTracePackage(
      depth, n, machine, position, Nil(), after_input, history,
      capture_context, policy, prefix_mode, reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched, remaining_input, selected_routine, path
    )
  ) -> result = match package
    AtomicSelectedStartAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedStartActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix_package) -> match suffix_package
      AtomicSelectedPathTracePrefixDonePacked() -> impossible
      AtomicSelectedPathTraceExactDonePacked() -> impossible
      AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## An accepted start candidate cannot be selected when its child search
  ## rejects an exact match that leaves input behind.  The child failure's
  ## cursor suffix is consumed by the existing exact-child eliminator; this
  ## keeps start-list rejection on the same construction-site proof path as
  ## destination rejection.
  fn atomic_start_accepted_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureExactAccepted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match path
    AtomicSelectedStartAccepted(_, _, _, _, _, _, _, _, _, _, _, _, suffix) ->
      atomic_path_child_exact_failure_excludes_trace(
        machine,
        child_char,
        child_rest,
        after_input,
        history,
        append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
        policy,
        atomic_scope_depth_after(accepted_routine, Z()),
        reversed_prefix,
        child_failure,
        child_suffix,
        suffix
      )

  ## Package-native accepted-start dual. Exact mode with remaining child input
  ## admits no accepted-thread suffix package constructor.
  fn atomic_start_accepted_candidate_rejection_excludes_package(
    {result: Type}, {depth: Nat}, {n: Nat},
    machine: PatternMachine(n), position: InitialPosition,
    child_char: Char, child_rest: List(Char), after_input: List(Char),
    history: List(Char), capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy, reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {matched: List(Char)}, {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedTrace(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched, remaining_input, selected_routine
    )},
    package: AtomicSelectedTracePackage(
      depth, n, machine, position, Cons(child_char, child_rest), after_input,
      history, capture_context, policy, False(), reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched, remaining_input, selected_routine, path
    )
  ) -> result = match package
    AtomicSelectedStartActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
    AtomicSelectedStartAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix_package) -> match suffix_package
      AtomicSelectedPathTracePrefixDonePacked() -> impossible
      AtomicSelectedPathTraceExactDonePacked() -> impossible
      AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## A singleton accepted tail publishes its rejection through the typed
  ## no-result witness. Matching that witness establishes the rejected-tail
  ## branch before the separately indexed exact-child certificate is forwarded
  ## to the accepted-start eliminator; no raw `AtomicStartMembersRefutation`
  ## match is needed.
  fn atomic_start_tail_accepted_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadAccepted(),
      history,
      append_routine(append_routine(capture_context, accepted_routine), accepted_assertion_markers),
      policy,
      atomic_scope_depth_after(accepted_routine, Z()),
      False(),
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureExactAccepted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_start_accepted_candidate_rejection_excludes_trace(
        machine,
        position,
        child_char,
        child_rest,
        after_input,
        history,
        capture_context,
        policy,
        reversed_prefix,
        accepted_routine,
        accepted_constraints,
        accepted_assertion_routine,
        accepted_assertion_markers,
        accepted_nested_decisions,
        child_failure,
        child_suffix,
        path
      )

  ## The recursive active-start case uses the same typed no-result witness,
  ## but its child contradiction is input exhaustion rather than exact
  ## accepted-with-trailing-input.  The parent path is indexed at the same
  ## active head, so the existing active-start eliminator discharges it.
  fn atomic_start_tail_active_candidate_rejection_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Nil(),
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(capture_context, routine), assertion_markers),
      policy,
      atomic_scope_depth_after(routine, Z()),
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      AtomicPathFailureInputExhausted()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureRejected()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Nil(),
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
      atomic_start_candidate_rejection_excludes_trace(
        machine,
        position,
        after_input,
        history,
        capture_context,
        policy,
        prefix_mode,
        reversed_prefix,
        state,
        routine,
        constraints,
        assertion_routine,
        assertion_markers,
        nested_decisions,
        child_failure,
        child_suffix,
        path
      )

  ## A blocked active start with no remaining sibling is eliminated through
  ## the typed blocked-tail witness.  The stored parent failure is passed to
  ## the existing commitment contradiction, preserving the skip/allow index.
  fn atomic_start_tail_blocked_active_candidate_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining),
      AtomicStartFailureBlocked()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedActive(state, routine, constraints, assertion_routine, assertion_markers, nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoBlockedEvidence(_, _, _, scope, _, _) -> atomic_start_scope_record_excludes_allowed(scope, skip, allowed)

  ## The accepted blocked-tail base is identical at the proof boundary, with
  ## the selected-start index choosing the accepted constructor explicitly.
  fn atomic_start_tail_blocked_accepted_candidate_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    {whole: List(LookaroundAdmittedState(n))},
    {remaining: List(LookaroundAdmittedState(n))},
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased skip: AtomicStartSkipEvidence(blocked_depth, kind),
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), remaining),
      AtomicStartFailureBlocked()
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> result = match evidence
    AtomicStartNoBlockedEvidence(_, _, _, scope, _, _) -> atomic_start_scope_record_excludes_allowed(scope, skip, allowed)

  ## A rejected head with no remaining siblings exposes an empty tail.  The
  ## published tail cursor must be consumed before delegating to the existing
  ## empty-start contradiction; a fabricated `Drop` suffix cannot cross this
  ## boundary.
  @reducible
  fn atomic_start_tail_suffix_is_empty(
    {n: Nat},
    {whole: List(LookaroundAdmittedState(n))},
    @erased _suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Nil())
  ) -> Unit = ()

  fn atomic_start_tail_exhaustion_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    @erased _tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Nil()),
    {item: LookaroundAdmittedState(n)},
    @erased membership: ListMember(LookaroundAdmittedState(n), item, Nil()),
    @erased tail_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil(),
      AtomicStartFailureExhausted()
    ),
    {selected_start: LookaroundAdmittedState(n)},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    )
  ) -> Empty =
    let _ = atomic_start_tail_suffix_is_empty(_tail_suffix)
    atomic_start_failure_excludes_trace(
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      membership,
      tail_failure,
      path
    )

  ## The child-specific wrapper retains the refutation's own suffix witness
  ## while reducing the exhausted-input branch to the generic contradiction.
  ## This is the first theorem boundary where the stored refutation suffix is
  ## consumed rather than merely transported.
  fn atomic_path_child_input_exhaustion_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), state: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, {current: List(LookaroundAdmittedState(n))}, @erased failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureInputExhausted()), @erased failure_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current), {path_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(state), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path_current, matched, remaining_input, routine)) -> result = match failure
    AtomicPathInputExhausted(_, stored_suffix) -> match failure_suffix
      LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_suffix
        LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, path)
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## Base case for destination rejection: when an active candidate is rejected
  ## at the first character, its child refutation is indexed at exhausted
  ## input, while a selected trace at that same candidate must expose an active
  ## child suffix.  The two indices are disjoint.  This is the first concrete
  ## destination-rejection slice; the general tail/child induction remains
  ## parameterized by the corresponding candidate-suffix alignment.
  fn atomic_path_destination_rejection_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), destination: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {remaining: List(LookaroundAdmittedState(n))}, @erased child_current: List(LookaroundAdmittedState(n)), @erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), Nil(), child_current, AtomicPathFailureInputExhausted()), {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, source_state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match path
    AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, destination, history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, [char | reversed_prefix], suffix)
    AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> impossible

  ## When the rejected child is itself exhausted, the selected child suffix is
  ## threaded alongside the selected child trace, while the stored refutation
  ## suffix is consumed at its empty-input constructor. The selected suffix is
  ## an erased index witness; the contradiction needs only the child trace's
  ## exhausted-input index, so its structural alignment remains a later
  ## recursive slice rather than an invented runtime check.
  fn atomic_path_destination_rejection_excludes_aligned_child({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), destination: Bounded(n), routine: List(EvidenceInstruction), assertion_markers: List(EvidenceInstruction), {selection_whole: List(LookaroundAdmittedState(n))}, {selection_current: List(LookaroundAdmittedState(n))}, {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased _child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, selection_whole, selection_current), @erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), Nil(), Nil(), AtomicPathFailureInputExhausted()), @erased child_failure_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), Nil()), @erased child_path: AtomicSelectedPathTrace(depth, n, machine, Nil(), after_input, ThreadActive(destination), history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), selection_current, matched, remaining_input, selected_routine)) -> result = match child_failure
    AtomicPathInputExhausted(_, stored_suffix) -> match child_failure_suffix
        LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_suffix
          LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_input_exhaustion_excludes_trace(machine, after_input, destination, history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, [char | reversed_prefix], child_path)
        LookaroundAdmittedStateCursorSuffixDrop(_, _) -> impossible

  ## Consume the child suffix at the destination-rejection construction site.
  ## The parent failure is active and the child input is exhausted, so the
  ## selected parent trace can only expose the active transition constructor.
  ## Its child trace and selected-child suffix are passed together with the
  ## refutation's published suffix; the aligned-child theorem consumes the
  ## stored child suffix before eliminating the exhausted child.
  fn atomic_path_destination_rejection_excludes_stored_aligned_child({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), destination: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {whole: List(LookaroundAdmittedState(n))}, {remaining: List(LookaroundAdmittedState(n))}, @erased failure: AtomicPathRefutation(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), AtomicPathFailureDestinationRejected()), {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, child_suffix, child_scope_alignment, _, _, _, _) -> match path
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_selection_suffix, child_selection_from_origin, _, _, child_trace) -> match child_scope_alignment
        LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match child_failure
          AtomicPathInputExhausted(_, stored_child_suffix) -> match child_suffix
            LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_child_suffix
              LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_destination_rejection_excludes_aligned_child(machine, char, after_input, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, destination, routine, assertion_markers, child_selection_suffix, child_failure, child_suffix, child_trace)

  ## An accepted destination cannot be rejected at exhausted child input. The
  ## child refutation is indexed at `ThreadAccepted()` and `Nil()` input, while
  ## `AtomicPathInputExhausted` is active-only; no child refutation exists, so
  ## this branch is discharged before selected-trace inspection.
  fn atomic_path_accepted_destination_rejection_excludes_trace({result: Type}, {depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {remaining: List(LookaroundAdmittedState(n))}, @erased child_kind: AtomicPathFailureKind, @erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(capture_context, routine), policy, atomic_scope_depth_after(routine, scope_depth), False(), Cons(char, reversed_prefix), Nil(), Nil(), child_kind), {matched: List(Char)}, {remaining_input: List(Char)}, {selected_routine: List(ExtendedInstruction)}, @erased _path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, source_state, history, capture_context, policy, scope_depth, False(), reversed_prefix, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> result = match child_failure
    AtomicPathInputExhausted(_, _) -> impossible

  ## An accepted candidate with remaining child input cannot be part of a
  ## selected transition when its child refutation is the exact terminal
  ## rejection.  The outer transition carries the child selected trace, so
  ## this branch consumes that suffix directly instead of treating the child
  ## failure as an unrelated erased flag.
  fn atomic_path_failure_excludes_selected_suffix({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), {@erased remaining: List(LookaroundAdmittedState(n))}, @erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, ThreadAccepted(), history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), False(), Cons(char, reversed_prefix), Nil(), Nil(), AtomicPathFailureExactAccepted()), {@erased matched: List(Char)}, {@erased remaining_input: List(Char)}, {@erased selected_routine: List(ExtendedInstruction)}, @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, source_state, history, capture_context, policy, scope_depth, False(), reversed_prefix, Cons(LookaroundAdmittedAccepted(routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, selected_routine)) -> Empty = match child_failure
    AtomicPathExactAcceptedWithInput(child_char, child_rest, _, _) -> match path
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix) -> atomic_path_exact_failure_excludes_trace(machine, child_char, child_rest, after_input, history_push_bounded(history, char), append_routine(append_routine(capture_context, routine), assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), Cons(char, reversed_prefix), child_failure, suffix)

  ## A rejected head can leave a selected trace in a non-empty sibling tail.
  ## When that tail refutation reaches destination exhaustion, its current
  ## spine is definitionally empty; the selected suffix therefore contradicts
  ## the exhaustion leaf through the cursor relation alone.
  fn atomic_path_tail_destinations_exhausted_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    @erased _failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil()),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil(),
      AtomicPathFailureDestinationsExhausted()
    ),
    {selected_candidate: LookaroundAdmittedState(n)},
    {@erased selected_remaining: List(LookaroundAdmittedState(n))},
    @erased tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Nil(),
      Cons(selected_candidate, selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(selected_candidate, selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = atomic_path_destinations_exhausted_excludes_trace(tail_selected_suffix)

  ## A recursively rejected active child can leave a singleton sibling tail
  ## whose search reaches destination exhaustion.  This construction-site
  ## consumer keeps the child refutation at its indexed destination-rejection
  ## boundary and forwards the tail cursor to the existing exhaustion lemma.
  ## The child path remains proof-only; no failure tag or cursor is emitted.
  fn atomic_path_active_child_rejection_excludes_tail_exhaustion(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Nil()),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil(),
      AtomicPathFailureDestinationsExhausted()
    ),
    {selected_current: List(LookaroundAdmittedState(n))},
    @erased tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Nil(),
      selected_current
    ),
    matched: List(Char),
    remaining_input: List(Char),
    selected_routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      selected_current,
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match tail_selected_suffix
    LookaroundAdmittedStateCursorSuffixHere(equality) -> match equality
      reflexive() -> atomic_path_active_destinations_exhausted_excludes_trace(
        machine,
        child_char,
        child_rest,
        after_input,
        source,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        matched,
        remaining_input,
        selected_routine,
        tail_failure,
        path
