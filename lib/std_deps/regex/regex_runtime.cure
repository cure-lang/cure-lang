        failure_current,
        failure_suffix,
        failure_nonempty,
        selected_whole,
        selected_whole_equivalence,
        selected_suffix,
        left_case,
        left_tail_case,
        right_case
      )

  ## Consume a recursively rejected active-child refutation at the construction
  ## site. This named boundary retains the child/refutation distinction while
  ## delegating the ordered cursor cases to the single alignment authority.
  ## Keeping the wrapper proof-only avoids rebuilding erased GADT evidence in a
  ## runtime-valued parent fold.
  @reducible
  fn atomic_path_active_child_rejection_excludes_trace(
    {@erased depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    destination: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    child_scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure_current: List(LookaroundAdmittedState(n)),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    selected_whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      failure_current,
      AtomicPathFailureDestinationRejected()
    ),
    {child_path_current: List(LookaroundAdmittedState(n))},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      child_path_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_excludes_aligned_trace(
    machine,
    child_char,
    child_rest,
    after_input,
    destination,
    history,
    capture_context,
    policy,
    child_scope_depth,
    prefix_mode,
    reversed_prefix,
    failure_whole,
    failure_current,
    failure_suffix,
    failure_nonempty,
    selected_whole,
    selected_whole_equivalence,
    selected_suffix,
    child_failure,
    child_path,
    left_case,
    left_tail_case,
    right_case
  )



  ## First-order induction over a rejected destination's sibling tail.  The
  ## selected trace is either aligned with the rejected head (the supplied
  ## construction-site contradiction) or starts in the tail.  In the latter
  ## case the refutation's own tail is structurally smaller, so the canonical
  ## fold consumes it without packing an existential callback or opening an
  ## erased failure kind.  This construction-site boundary supplies the
  ## aligned and tail contradictions to that fold; destination exhaustion is
  ## its recursive base, while input exhaustion and exact acceptance are
  ## excluded by the active/non-empty indices before any runtime branch can be
  ## generated.
  @reducible
  fn atomic_path_destination_rejection_excludes_recursive_tail_induction(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    @erased matched: List(Char),
    @erased remaining_input: List(Char),
    @erased routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      candidate_current
    ),
    @erased tail_alignment: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      candidate_current
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    ),
    head_case: Empty,
    tail_case: Empty
  ) -> Empty = atomic_path_destination_rejection_excludes_recursive_tail_rejected(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    failure,
    matched,
    remaining_input,
    routine,
    selection_from_current,
    tail_alignment,
    path,
    head_case,
    tail_case
  )







  ## A two-sibling rejected tail reaches the same singleton recursion after
  ## the outer candidate is skipped.  The nested rejected candidate is fixed
  ## at the head of the parent's sibling tail and its own tail is fixed at
  ## `Nil()`, so the nested destination-exhaustion branch can reuse the
  ## canonical active-child exhaustion consumer.  The parent tail package is
  ## refined twice at this construction site; the resulting `Drop` suffixes
  ## are erased cursor evidence and add no runtime state.
  fn atomic_path_destination_rejection_excludes_nested_tail_rejection(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    candidate: LookaroundAdmittedState(n),
    nested_candidate: LookaroundAdmittedState(n),
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, Cons(nested_candidate, Nil())),
      AtomicPathFailureDestinationRejected()
    ),
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Nil(),
      matched,
      remaining_input,
      routine
    )
  ) -> Empty =
    let nested_package: AtomicPathRejectedTailAt(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(nested_candidate, Nil())
    ) = atomic_path_destination_rejected_tail_package(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      failure
    )
    let nested_result: Empty = atomic_path_rejected_tail_refinement(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      nested_candidate,
      nested_package,
      matched,
      remaining_input,
      routine,
      path
    )
    atomic_path_rejected_tail_dispatch_excludes_trace(
      machine,
      char,
      rest,
      after_input,
      state,
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      nested_candidate,
      matched,
      remaining_input,
      routine,
      atomic_path_destination_rejection_excludes_recursive_tail(
        machine,
        char,
        rest,
        after_input,
        state,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        candidate,
        failure,
        matched,
        remaining_input,
        routine,
        LookaroundAdmittedStateCursorSuffixDrop(
          candidate,
          LookaroundAdmittedStateCursorSuffixDrop(
            nested_candidate,
            LookaroundAdmittedStateCursorSuffixHere(reflexive(empty_lookaround_admitted_states(n)))
          )
        ),
        path,
        nested_result
      )
    )
