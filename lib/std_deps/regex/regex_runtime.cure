      AtomicSelectedPrefixDone() -> impossible
      AtomicSelectedExactDone() -> impossible
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_trace) -> match nested_failure
        AtomicPathInputExhausted(_, _) -> atomic_path_input_exhaustion_excludes_trace_erased(child_trace)
