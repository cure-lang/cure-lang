  fn atomic_lookaround_routine_accepting_from(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = match state
    ThreadAccepted() -> match prefix_mode
      True() -> AtomicPathSearchYes(evidence_reverse_chars(reversed_prefix), input, empty_extended_instructions(), empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n), empty_lookaround_admitted_cursor_suffix(n), empty_lookaround_admitted_states(n), reflexive(empty_lookaround_admitted_states(n)), AtomicSelectedPrefixDone())
      False() -> match input
        [] -> AtomicPathSearchYes(evidence_reverse_chars(reversed_prefix), [], empty_extended_instructions(), empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n), empty_lookaround_admitted_cursor_suffix(n), empty_lookaround_admitted_states(n), reflexive(empty_lookaround_admitted_states(n)), AtomicSelectedExactDone())
        [char | rest] -> atomic_path_root_exact_accepted_with_input_search(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix)
    ThreadActive(source) -> match input
      [] -> atomic_path_root_input_exhausted_search(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
      [char | rest] -> atomic_lookaround_routine_members(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)

  fn atomic_lookaround_routine_members(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) =
    let destinations: List(LookaroundAdmittedState(n)) = lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)
    let cursor: LookaroundAdmittedStateCursor(n, destinations, destinations) = LookaroundAdmittedStateCursorHere()
    let witness: LookaroundAdmittedStateCursorWitness(n, destinations, destinations) = LookaroundAdmittedStateCursorWitnessHere()
    atomic_path_members_root_to_search(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      atomic_lookaround_routine_members_from(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, destinations, destinations, cursor, witness, reflexive(destinations))
    )

  fn atomic_path_members_to_search(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, current: List(LookaroundAdmittedState(n)), result: AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = match result
    AtomicPathMembersNo(witness, failure) -> AtomicPathSearchNo(whole, current, witness, failure)
    AtomicPathMembersEscapedNo(_, tail_current, witness, failure) -> AtomicPathSearchNo(whole, tail_current, witness, failure)
    AtomicPathMembersCommit(commit_depth) -> AtomicPathSearchCommit(commit_depth)
    AtomicPathMembersYes(matched, remaining, routine, selected_whole, selected_current, selection_suffix, selected_whole_equivalence, trace) -> AtomicPathSearchYes(matched, remaining, routine, selected_whole, selected_current, selection_suffix, current, selected_whole_equivalence, trace)

  fn atomic_path_members_root_to_search(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, result: AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, whole)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = match result
    AtomicPathMembersNo(_, failure) -> AtomicPathSearchRootNo(whole, AtomicPathRootRefutation(failure))
    AtomicPathMembersEscapedNo(_, tail_current, witness, failure) -> AtomicPathSearchNo(whole, tail_current, witness, failure)
    AtomicPathMembersCommit(commit_depth) -> AtomicPathSearchCommit(commit_depth)
    AtomicPathMembersYes(matched, remaining, routine, selected_whole, selected_current, selection_suffix, selected_whole_equivalence, trace) -> AtomicPathSearchYes(matched, remaining, routine, selected_whole, selected_current, selection_suffix, whole, selected_whole_equivalence, trace)

  ## A commitment that belongs to an inner scope escapes this candidate and
  ## lets the ordered sibling search continue.  If that sibling search later
  ## succeeds, its selected candidate suffix is relative to `remaining`; add
  ## the escaped candidate back to the front so the result is indexed by the
  ## original ordered destination list.  No and commit results carry no
  ## selected path and therefore pass through unchanged.
  fn atomic_lookaround_routine_add_skipped_candidate(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), source_state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), candidate: LookaroundAdmittedState(n), {whole: List(LookaroundAdmittedState(n))}, current: List(LookaroundAdmittedState(n)), result: AtomicPathMembersResult(depth, n, machine, input, after_input, source_state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)) -> AtomicPathMembersResult(depth, n, machine, input, after_input, source_state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, current)) = match result
    AtomicPathMembersNo(witness, failure) -> AtomicPathMembersEscapedNo([candidate], current, witness, failure)
    AtomicPathMembersEscapedNo(skipped, tail_current, witness, failure) -> AtomicPathMembersEscapedNo([candidate | skipped], tail_current, witness, failure)
    AtomicPathMembersCommit(commit_depth) -> AtomicPathMembersCommit(commit_depth)
    AtomicPathMembersYes(matched, remaining_input, routine, selected_whole, selected_current, selection_suffix, selected_whole_equivalence, trace) -> AtomicPathMembersYes(matched, remaining_input, routine, Cons(candidate, selected_whole), selected_current, LookaroundAdmittedStateCursorSuffixDrop(candidate, selection_suffix), lookaround_admitted_state_cons_equivalent(candidate, selected_whole_equivalence), trace)

  fn atomic_lookaround_routine_tail_after_failure(depth: Nat, n: Nat, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), candidate: LookaroundAdmittedState(n), child_capture_context: List(EvidenceInstruction), child_scope_depth: Nat, @erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth), @erased child_whole: List(LookaroundAdmittedState(n)), @erased child_current: List(LookaroundAdmittedState(n)), @erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(candidate, remaining)), @erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(candidate, remaining)), @erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), @erased child_failure: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current)) -> AtomicPathMembersResult(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining)) = match atomic_lookaround_routine_members_from(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, LookaroundAdmittedStateCursorDrop(candidate, cursor), LookaroundAdmittedStateCursorWitnessDrop(candidate, witness), canonical