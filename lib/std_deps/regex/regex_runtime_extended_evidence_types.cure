@group(:text)
mod Std.Regex.Runtime.ExtendedEvidenceTypes
  use Std.Regex.Runtime.MatchType

  use Std.Regex.Runtime.StateOps

  use Std.Regex.Runtime.PatternMachines

  use Std.Regex.Runtime.StagedOps

  use Std.Regex.Runtime.Compilation

  use Std.Regex.Runtime.MachineLaws

  use Std.Regex.Runtime.MachineFilters

  use Std.Regex.Runtime.SubjectContext

  use Std.Regex.Runtime.CharacterPredicates

  use Std.Regex.Runtime.Position

  use Std.Regex.Runtime.TransitionRows

  use Std.Regex.Runtime.CaptureConditions

  use Std.Regex.Runtime.Boundaries

  use Std.Regex.Runtime.AtomicDiagnostics

  use Std.Regex.Runtime.ClassKinds

  use Std.Regex.Runtime.Named

  use Std.Regex.Runtime.Split

  use Std.Regex.Core.Capture

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Char

  use Std.Option

  use Std.List

  use Std.String

  use Std.Syntax

  use Std.Bounded

  use Std.Equivalent

  use Std.Sigma

  use Std.Decision

  ## The generalized Thompson proof uses an NFA-independent stream. `Observe`
  ## advances capture input; `Regular` embeds the evidence VM language.
  type ExtendedInstruction = Regular(EvidenceInstruction) | Observe(Char)

  @reducible
  fn regular_routine(routine: List(EvidenceInstruction)) -> List(ExtendedInstruction) = match routine
    [] -> []
    [instruction | rest] -> [Regular(instruction) | regular_routine(rest)]

  ## Thompson's evidence proof reasons over one NFA-independent instruction
  ## stream. `Observe` records the consumed character (and advances open capture
  ## frames); `Regular` embeds the existing VM instruction language.
  type ExtendedExecution = ExtendedExecution(Option(Char), List(Evidence), List(CaptureFrame))

  @reducible
  fn transition_routine(char: Char, routine: List(EvidenceInstruction)) -> List(ExtendedInstruction) =
    [Observe(char) | regular_routine(routine)]

  @reducible
  fn append_extended_routines(left: List(ExtendedInstruction), right: List(ExtendedInstruction)) -> List(ExtendedInstruction) = match left
    [] -> right
    [instruction | rest] -> [instruction | append_extended_routines(rest, right)]
end
