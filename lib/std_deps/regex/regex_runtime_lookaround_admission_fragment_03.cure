    {@erased rejected_child_state: ThreadState(n)},
    {@erased rejected_child_history: List(Char)},
    {@erased rejected_child_failure_capture_context: List(EvidenceInstruction)},
    {@erased rejected_child_evidence_capture_context: List(EvidenceInstruction)},
    {@erased rejected_child_policy: NewlinePolicy},
    {@erased rejected_child_scope_depth: Nat},
    {@erased rejected_child_prefix_mode: Bool},
    {@erased rejected_child_reversed_prefix: List(Char)},
    {@erased rejected_child_whole: List(LookaroundAdmittedState(n))},
    {@erased rejected_child_current: List(LookaroundAdmittedState(n))},
    {@erased rejected_child_kind: AtomicPathFailureKind},
    rejected_child_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, rejected_child_whole, rejected_child_current
    ),
    @erased rejected_child_failure: AtomicPathRefutation(
      depth, n, machine, rejected_child_input, rejected_child_after_input,
      rejected_child_state, rejected_child_history,
      rejected_child_failure_capture_context, rejected_child_policy,
      rejected_child_scope_depth, rejected_child_prefix_mode,
      rejected_child_reversed_prefix, rejected_child_whole,
      rejected_child_current, rejected_child_kind
    ),
    @erased rejected_child_evidence: AtomicPathNoEvidence(
      depth, n, machine, rejected_child_input, rejected_child_after_input,
      rejected_child_state, rejected_child_history,
      rejected_child_evidence_capture_context, rejected_child_policy,
      rejected_child_scope_depth, rejected_child_prefix_mode,
      rejected_child_reversed_prefix, rejected_child_whole,
      rejected_child_current, rejected_child_kind
    ),
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)}, {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased selected_trace: AtomicSelectedPathTrace(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, selected_current,
      matched, remaining_input, selected_routine
    )},
    selected_trace_package: AtomicSelectedPathTracePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, selected_current,
      matched, remaining_input, selected_routine, selected_trace
    )
  ) -> AtomicPathRejectedSelectedTracePairPackage(
    depth, n, machine, input, after_input, state, history, capture_context,
    policy, scope_depth, prefix_mode, reversed_prefix, selected_current
  ) = AtomicPathRejectedSelectedTracePairPacked(
    rejected_child_cursor,
    rejected_child_failure,
    rejected_child_evidence,
    selected_trace_package
  )

  ## Relevant constructor correlation for a successful search's skipped
  ## prefix. The evidence remains erased, while the relevant constructor and
  ## recursive tail package make its exact skip shape available to strict
  ## commit/selection proofs without inspecting an erased sum.
  type AtomicPathSkippedPrefixStructurePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), front: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), kind: AtomicPathSkippedPrefixKind)
    AtomicPathSkippedPrefixStructureEmptyPacked : (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, current, AtomicPathSkippedPrefixEmptyKind())) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, current, AtomicPathSkippedPrefixEmptyKind())
    AtomicPathSkippedPrefixStructureEscapedOnePacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased commit_kind: AtomicPathCommitCauseKind} -> (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, current), current, AtomicPathSkippedPrefixEscapedOneKind(commit_kind))) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, current), current, AtomicPathSkippedPrefixEscapedOneKind(commit_kind))
    AtomicPathSkippedPrefixStructureEscapedConsPacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased tail_front: List(LookaroundAdmittedState(n))} -> {@erased commit_kind: AtomicPathCommitCauseKind} -> {@erased tail_kind: AtomicPathSkippedPrefixKind} -> (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixEscapedConsKind(commit_kind, tail_kind))) -> (tail_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_front, current, tail_kind)) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixEscapedConsKind(commit_kind, tail_kind))
    AtomicPathSkippedPrefixStructureRejectedConsPacked : {@erased candidate: LookaroundAdmittedState(n)} -> {@erased tail_front: List(LookaroundAdmittedState(n))} -> {@erased child_prefix_kind: AtomicPathFailurePrefixKind} -> {@erased child_kind: AtomicPathFailureKind} -> {@erased tail_kind: AtomicPathSkippedPrefixKind} -> (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, tail_kind))) -> (tail_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_front, current, tail_kind)) -> (rejected_selected_pair: AtomicPathRejectedSelectedTracePairPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, current)) -> AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, tail_front), current, AtomicPathSkippedPrefixRejectedConsKind(child_prefix_kind, child_kind, tail_kind))

  type AtomicPathFailurePrefixEvidence(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)), kind: AtomicPathFailurePrefixKind)
    AtomicPathFailureAtRoot : (@erased equality: Equivalent(List(LookaroundAdmittedState(n)), whole, current)) -> AtomicPathFailurePrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureAtRootKind())
    AtomicPathFailureAfterSkipped : (@erased skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, whole, current, skipped_kind)) -> AtomicPathFailurePrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, AtomicPathFailureAfterSkippedKind(skipped_kind))

  type AtomicPathSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char))
    ## Preserve the empty-input equation at the relevant evaluator boundary.
    ## The generic active-root rejection below cannot recover this equation
    ## from its erased refutation after publication.
    AtomicPathSearchRootActiveInputExhaustedNo : (@erased source: Bounded(n)) -> (@erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted())) -> AtomicPathSearchResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchRootActiveNo : (@erased source: Bounded(n)) -> (kind: AtomicPathFailureKind) -> (@erased failure: AtomicPathRootRefutation(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), kind)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchRootExactNo : (kind: AtomicPathFailureKind) -> (@erased failure: AtomicPathRootRefutation(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), kind)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix)
    ## This is a complete root-list refutation for any thread state. The two
    ## specialized root constructors above remain useful for the indexed
    ## empty-input and exact-terminal cases; this constructor covers the
    ## non-empty destination list without weakening the suffix-local No case.
    AtomicPathSearchRootNo : (@erased whole: List(LookaroundAdmittedState(n))) -> (@erased origin: List(LookaroundAdmittedState(n))) -> (@erased origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, origin)) -> (kind: AtomicPathFailureKind) -> (@erased failure: AtomicPathRootRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, kind)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchNo : (@erased skipped: List(LookaroundAdmittedState(n))) -> (@erased whole: List(LookaroundAdmittedState(n))) -> (current: List(LookaroundAdmittedState(n))) -> (@erased skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, whole, current, skipped_kind)) -> (@erased origin: List(LookaroundAdmittedState(n))) -> (@erased origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, origin)) -> (@erased origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, origin)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, current)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)) -> (suffix_package: LookaroundAdmittedStateCursorSuffixPackage(n, whole, current)) -> (kind: AtomicPathFailureKind) -> (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, kind)) -> (@erased evidence: AtomicPathNoEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, kind)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchCommit : (commit_depth: Nat) -> (@erased whole: List(LookaroundAdmittedState(n))) -> (@erased current: List(LookaroundAdmittedState(n))) -> {@erased origin: List(LookaroundAdmittedState(n))} -> (@erased origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, origin)) -> (@erased origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, origin)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, current)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)) -> (suffix_package: LookaroundAdmittedStateCursorSuffixPackage(n, whole, current)) -> (@erased commit_kind: AtomicPathCommitCauseKind) -> (@erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, commit_kind)) -> (structure: AtomicPathCommitStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, commit_kind, cause)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
    AtomicPathSearchYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> (@erased selected_whole: List(LookaroundAdmittedState(n))) -> (@erased selected_current: List(LookaroundAdmittedState(n))) -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)) -> (selection_suffix_package: LookaroundAdmittedStateCursorSuffixPackage(n, selected_whole, selected_current)) -> (@erased selected_origin: List(LookaroundAdmittedState(n))) -> (@erased selected_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), selected_origin, selected_whole)) -> (@erased selected_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, selected_origin)) -> (@erased selection_from_origin: LookaroundAdmittedStateCursorSuffix(n, selected_origin, selected_current)) -> (selection_from_origin_package: LookaroundAdmittedStateCursorSuffixPackage(n, selected_origin, selected_current)) -> (@erased skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_origin, selected_origin, selected_current, skipped_kind)) -> (skipped_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_origin, selected_origin, selected_current, skipped_kind)) -> (@erased trace: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine)) -> (trace_package: AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine, trace)) -> (trace_envelope: AtomicSelectedPathTraceRuntimeEnvelope(AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine, trace))) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)

  ## Internal destination-list results retain the exact current admitted-state
  ## suffix in their type.  The public search result must hide that list at the
  ## matcher boundary, but recursive sibling traversal needs the stronger
  ## index so a tail refutation is known to begin at `remaining`, not at an
  ## unconstrained suffix of the original destination list.
  type AtomicPathMembersResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathMembersNo : (@erased origin: List(LookaroundAdmittedState(n))) -> (@erased origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, origin)) -> (@erased origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, origin)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, current)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)) -> (suffix_package: LookaroundAdmittedStateCursorSuffixPackage(n, whole, current)) -> (kind: AtomicPathFailureKind) -> (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, kind)) -> (@erased evidence: AtomicPathNoEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, kind)) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathMembersEscapedNo : (@erased skipped: List(LookaroundAdmittedState(n))) -> (tail_current: List(LookaroundAdmittedState(n))) -> (@erased skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, tail_current, skipped_kind)) -> (@erased origin: List(LookaroundAdmittedState(n))) -> (@erased origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, origin)) -> (@erased origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, origin)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, tail_current)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, tail_current)) -> (suffix_package: LookaroundAdmittedStateCursorSuffixPackage(n, whole, tail_current)) -> (kind: AtomicPathFailureKind) -> (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_current, kind)) -> (@erased evidence: AtomicPathNoEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, tail_current, kind)) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathMembersCommit : (commit_depth: Nat) -> {@erased origin: List(LookaroundAdmittedState(n))} -> (@erased origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, origin)) -> (@erased origin_canonical: AtomicPathSearchOrigin(depth, n, machine, input, after_input, state, history, capture_context, policy, origin)) -> (@erased witness: LookaroundAdmittedStateCursorWitness(n, whole, current)) -> (@erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, current)) -> (suffix_package: LookaroundAdmittedStateCursorSuffixPackage(n, whole, current)) -> (@erased commit_kind: AtomicPathCommitCauseKind) -> (@erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, commit_kind)) -> (structure: AtomicPathCommitStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, commit_kind, cause)) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)
    AtomicPathMembersYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> (@erased selected_whole: List(LookaroundAdmittedState(n))) -> (@erased selected_current: List(LookaroundAdmittedState(n))) -> (@erased selection_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current)) -> (selection_suffix_package: LookaroundAdmittedStateCursorSuffixPackage(n, selected_whole, selected_current)) -> (@erased selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), current, selected_whole)) -> (@erased selection_from_current: LookaroundAdmittedStateCursorSuffix(n, current, selected_current)) -> (selection_from_current_package: LookaroundAdmittedStateCursorSuffixPackage(n, current, selected_current)) -> (@erased skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, selected_current, skipped_kind)) -> (skipped_structure: AtomicPathSkippedPrefixStructurePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, selected_current, skipped_kind)) -> (@erased trace: AtomicSelectedPathTrace(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine)) -> (trace_package: AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine, trace)) -> (trace_envelope: AtomicSelectedPathTraceRuntimeEnvelope(AtomicSelectedPathTracePackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, selected_current, matched, remaining, routine, trace))) -> AtomicPathMembersResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)

  type LookaroundRoutineSearchResult(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char))
    LookaroundRoutineSearchNo : {@erased whole: List(LookaroundAdmittedState(n))} -> (@erased failure: AtomicStartRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)
    LookaroundRoutineSearchCommit : (commit_depth: Nat) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)
    LookaroundRoutineSearchYes : (matched: List(Char)) -> (remaining: List(Char)) -> (routine: List(ExtendedInstruction)) -> {@erased blocked_depth: Option(Nat)} -> {@erased kind: AtomicStartSkipKind} -> (trace_package: AtomicSelectedTraceExistentialPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining, routine)) -> (@erased witness: AtomicSelectedStartWitness(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, current, selected_start, blocked_depth, kind, matched, remaining, routine)) -> LookaroundRoutineSearchResult(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix)

  ## The capture replay evaluator mirrors the atomic lookaround search above.
  ## It is deliberately separate from the Boolean evaluator: preserving the
  ## selected routine must not alter the acceptance authority used by typed
  ## extraction. Every successful branch prepends the observed character and
  ## epsilon routine in the same order as the certified extended path.
  ## `prefix` changes only the acceptance point: a prefix search may close as
  ## soon as the ordered machine reaches `ThreadAccepted`, even when input
  ## remains.  The machine's start/destination order still chooses the path,
  ## so lazy repeats and ordered alternation are preserved by the same DFS.
  ## `reversed_prefix` records exactly the characters consumed on that path;
  ## the result also carries the unconsumed suffix so callers never reconstruct
  ## it by retrying every possible endpoint.
  fn atomic_path_input_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicPathFailureInputExhausted()) = AtomicPathInputExhausted(LookaroundAdmittedStateCursorWitnessHere(), empty_lookaround_admitted_cursor_suffix(n))

  fn atomic_path_exact_accepted_with_input_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), Nil(), AtomicPathFailureExactAccepted()) = AtomicPathExactAcceptedWithInput(char, rest, LookaroundAdmittedStateCursorWitnessHere(), empty_lookaround_admitted_cursor_suffix(n))

  fn atomic_path_no_exact_accepted_with_input({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathNoEvidence(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), Nil(), AtomicPathFailureExactAccepted()) = AtomicPathNoExactAcceptedWithInput()

  fn atomic_path_no_input_exhausted({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathNoEvidence(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicPathFailureInputExhausted()) = AtomicPathNoInputExhausted()

  fn atomic_path_root_exact_accepted_with_input_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathRootRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), AtomicPathFailureExactAccepted()) = AtomicPathRootRefutation(reflexive(empty_lookaround_admitted_states(n)), AtomicPathSearchOriginAccepted(), atomic_path_exact_accepted_with_input_evidence(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix), atomic_path_no_exact_accepted_with_input(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix))

  fn atomic_path_root_input_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted()) = AtomicPathRootRefutation(reflexive(empty_lookaround_admitted_states(n)), AtomicPathSearchOriginActiveEmpty(), atomic_path_input_exhausted_evidence(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix), atomic_path_no_input_exhausted(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix))

  fn atomic_path_root_exact_accepted_with_input_search({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, Cons(char, rest), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix) = AtomicPathSearchRootExactNo(AtomicPathFailureExactAccepted(), atomic_path_root_exact_accepted_with_input_evidence(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix))

  fn atomic_path_search_root_active_no({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), @erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted())) -> AtomicPathSearchResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = AtomicPathSearchRootActiveInputExhaustedNo(source, failure)

  fn atomic_path_root_input_exhausted_search({depth: Nat}, {n: Nat}, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = atomic_path_search_root_active_no(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, atomic_path_root_input_exhausted_evidence(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix))

  fn atomic_path_destinations_exhausted_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), {whole: List(LookaroundAdmittedState(n))}, cursor: LookaroundAdmittedStateCursor(n, whole, Nil()), witness: LookaroundAdmittedStateCursorWitness(n, whole, Nil()), suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Nil()), canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Nil(), AtomicPathFailureDestinationsExhausted()) = AtomicPathDestinationsExhausted(char, rest, cursor, witness, suffix, canonical)

  fn atomic_path_destination_rejected_evidence({depth: Nat}, {n: Nat}, machine: PatternMachine(n), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), candidate: LookaroundAdmittedState(n), child_capture_context: List(EvidenceInstruction), @erased child_context_alignment: LookaroundAdmittedStateCaptureContext(n, capture_context, candidate, child_capture_context), child_scope_depth: Nat, whole: List(LookaroundAdmittedState(n)), @erased remaining: List(LookaroundAdmittedState(n)), @erased cursor: LookaroundAdmittedStateCursor(n, whole, Cons(candidate, remaining)), @erased witness: LookaroundAdmittedStateCursorWitness(n, whole, Cons(candidate, remaining)), @erased suffix: LookaroundAdmittedStateCursorSuffix(n, whole, Cons(candidate, remaining)), @erased edge: ListMember(LookaroundAdmittedState(n), candidate, Cons(candidate, remaining)), @erased canonical: Equivalent(List(LookaroundAdmittedState(n)), whole, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy)), @erased child_whole: List(LookaroundAdmittedState(n)), @erased child_current: List(LookaroundAdmittedState(n)), @erased child_prefix_kind: AtomicPathFailurePrefixKind, @erased child_prefix: AtomicPathFailurePrefixEvidence(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), child_capture_context, policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_prefix_kind), @erased child_origin: List(LookaroundAdmittedState(n)), @erased child_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_origin), @erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_origin), @erased child_kind: AtomicPathFailureKind, @erased child_evidence: AtomicPathRefutation(depth, n, machine, rest, after_input, lookaround_admitted_state_thread(candidate), history_push_bounded(history, char), lookaround_admitted_state_capture_context(capture_context, candidate), policy, child_scope_depth, prefix_mode, Cons(char, reversed_prefix), child_whole, child_current, child_kind), @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current), @erased child_scope_alignment: LookaroundAdmittedStateScope(n, scope_depth, candidate, child_scope_depth), @erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, whole, remaining), @erased tail_origin: List(LookaroundAdmittedState(n)), @erased tail_origin_equivalence: Equivalent(List(LookaroundAdmittedState(n)), whole, tail_origin), @erased tail_kind: AtomicPathFailureKind, @erased tail_failure: AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> AtomicPathRefutation(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(candidate, remaining), AtomicPathFailureDestinationRejected()) = AtomicPathDestinationRejected(char, rest, candidate, child_scope_depth, remaining, cursor, witness, suffix, edge, canonical, child_context_alignment, child_prefix_kind, child_prefix, child_origin_equivalence, child_origin_canonical, child_kind, child_evidence, child_suffix, child_scope_alignment, tail_suffix, tail_origin_equivalence, tail_kind, tail_failure)

  fn atomic_lookaround_routine_accepting_from(depth: Nat, n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char)) -> AtomicPathSearchResult(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix) = match state
    ThreadAccepted() -> match prefix_mode
      True() -> AtomicPathSearchYes(evidence_reverse_chars(reversed_prefix), input, empty_extended_instructions(), empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n), empty_lookaround_admitted_cursor_suffix(n), lookaround_admitted_cursor_suffix_package_here(reflexive(empty_lookaround_admitted_states(n))), empty_lookaround_admitted_states(n), reflexive(empty_lookaround_admitted_states(n)), AtomicPathSearchOriginAccepted(), empty_lookaround_admitted_cursor_suffix(n), lookaround_admitted_cursor_suffix_package_here(reflexive(empty_lookaround_admitted_states(n))), AtomicPathSkippedPrefixEmptyKind(), AtomicPathSkippedPrefixEmpty(), AtomicPathSkippedPrefixStructureEmptyPacked(AtomicPathSkippedPrefixEmpty()), AtomicSelectedPrefixDone(), atomic_selected_path_trace_prefix_done_package(depth, n, machine, input, after_input, history, capture_context, policy, scope_depth, reversed_prefix), atomic_selected_path_trace_runtime_envelope(LookaroundAdmittedStateCursorShapeHere(), atomic_selected_path_trace_prefix_done_package(depth, n, machine, input, after_input, history, capture_context, policy, scope_depth, reversed_prefix)))
      False() -> match input
        [] -> AtomicPathSearchYes(evidence_reverse_chars(reversed_prefix), [], empty_extended_instructions(), empty_lookaround_admitted_states(n), empty_lookaround_admitted_states(n), empty_lookaround_admitted_cursor_suffix(n), lookaround_admitted_cursor_suffix_package_here(reflexive(empty_lookaround_admitted_states(n))), empty_lookaround_admitted_states(n), reflexive(empty_lookaround_admitted_states(n)), AtomicPathSearchOriginAccepted(), empty_lookaround_admitted_cursor_suffix(n), lookaround_admitted_cursor_suffix_package_here(reflexive(empty_lookaround_admitted_states(n))), AtomicPathSkippedPrefixEmptyKind(), AtomicPathSkippedPrefixEmpty(), AtomicPathSkippedPrefixStructureEmptyPacked(AtomicPathSkippedPrefixEmpty()), AtomicSelectedExactDone(), atomic_selected_path_trace_exact_done_package(depth, n, machine, after_input, history, capture_context, policy, scope_depth, reversed_prefix), atomic_selected_path_trace_runtime_envelope(LookaroundAdmittedStateCursorShapeHere(), atomic_selected_path_trace_exact_done_package(depth, n, machine, after_input, history, capture_context, policy, scope_depth, reversed_prefix)))
        [char | rest] -> atomic_path_root_exact_accepted_with_input_search(machine, char, rest, after_input, history, capture_context, policy, scope_depth, reversed_prefix)
    ThreadActive(source) -> match input
      [] -> atomic_path_root_input_exhausted_search(machine, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
      [char | rest] -> atomic_lookaround_routine_members(depth, n, machine, char, rest, after_input, source, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix)
end
