  ## The atomic evaluator records the exact start and destination sequence it
  ## selected. The trace is indexed by the machine's state count and retained
  ## only as erased proof data; constructing it does not add a runtime path
  ## object to emitted matchers.
  type AtomicSelectedPathTrace(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), candidate_current: List(LookaroundAdmittedState(n)), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
