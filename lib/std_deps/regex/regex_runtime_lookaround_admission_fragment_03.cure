    AtomicSelectedPathTraceExactDonePacked : AtomicSelectedPathTracePackage(depth, n, machine, Nil(), after_input, ThreadAccepted(), history, capture_context, policy, scope_depth, False(), reversed_prefix, Nil(), evidence_reverse_chars(reversed_prefix), Nil(), Nil(), AtomicSelectedExactDone())
