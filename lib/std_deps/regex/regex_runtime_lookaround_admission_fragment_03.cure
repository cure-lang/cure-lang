  ## Publish the active root package from the real initial-tail result.  The
  ## child refutation is accepted only at its empty-input/root indices, while
  ## the sibling tail remains existentially typed behind `AtomicStartTailPackage`.
  ## This helper has no runtime payload: every proof argument is erased.
  @reducible
  fn atomic_start_active_root_tail_from_no(
    @erased depth: Nat,
    @erased n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    child_input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased whole: List(LookaroundAdmittedState(n)),
    @erased remaining: List(LookaroundAdmittedState(n)),
    @erased tail_kind: AtomicStartFailureKind,
    @erased tail_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    ),
    @erased tail_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    )
  ) -> AtomicStartTailPackage(
    depth,
    n,
    machine,
    position,
    child_input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    remaining
  ) = AtomicStartTailPackagePacked(tail_failure, tail_evidence)

  @reducible
  fn atomic_start_rejected_active_root_package(
    @erased depth: Nat,
    @erased n: Nat,
    machine: PatternMachine(n),
    position: InitialPosition,
    child_input: List(Char),
    after_input: List(Char),
    history: List(Char),
    parent_capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    state: Bounded(n),
    routine: List(EvidenceInstruction),
    constraints: List(BoundaryConstraint),
    assertion_routine: List(ExtendedInstruction),
    assertion_markers: List(EvidenceInstruction),
    nested_decisions: List(LookaroundNestedDecision),
    child_scope_depth: Nat,
    @erased whole: List(LookaroundAdmittedState(n)),
    @erased remaining: List(LookaroundAdmittedState(n)),
    @erased child_whole: List(LookaroundAdmittedState(n)),
    @erased child_current: List(LookaroundAdmittedState(n)),
    @erased child_kind: AtomicPathFailureKind,
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      child_input,
      after_input,
      ThreadActive(state),
      history,
      append_routine(append_routine(parent_capture_context, routine), assertion_markers),
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      child_whole,
      child_current,
      child_kind
    ),
    {@erased tail_kind: AtomicStartFailureKind},
    @erased tail_failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      parent_capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    ),
    @erased tail_evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      parent_capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind
    )
  ) -> AtomicStartActiveRootTailProofPackageAt(
    depth,
    n,
    machine,
    position,
    parent_capture_context,
    append_routine(append_routine(parent_capture_context, routine), assertion_markers),
    child_input,
    after_input,
    history,
    policy,
    prefix_mode,
    reversed_prefix,
    ThreadActive(state),
    routine,
    constraints,
    assertion_routine,
    assertion_markers,
    nested_decisions,
    whole,
    remaining,
    child_whole,
    child_current,
    child_kind,
    child_scope_depth
  ) = AtomicStartActiveRootTailProofPackageAtPacked(
    atomic_start_active_root_tail_from_no(
      depth,
      n,
      machine,
      position,
      child_input,
      after_input,
      history,
      parent_capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      remaining,
      tail_kind,
      tail_failure,
      tail_evidence
    ),
    child_failure
  )

  ## The successful path's origin is not an arbitrary erased list.  Terminal
  ## accepted searches originate at the empty admitted list; consuming active
  ## searches originate at the exact filtered transition list published by
  ## the member traversal.  This small indexed witness keeps that distinction
  ## available without putting the full machine computation in a constructor
  ## result index.
  type AtomicPathSearchOrigin(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, origin: List(LookaroundAdmittedState(n)))
    AtomicPathSearchOriginAccepted : AtomicPathSearchOrigin(depth, n, machine, input, after_input, ThreadAccepted(), history, capture_context, policy, empty_lookaround_admitted_states(n))
    AtomicPathSearchOriginActiveEmpty : {@erased source: Bounded(n)} -> AtomicPathSearchOrigin(depth, n, machine, Nil(), after_input, ThreadActive(source), history, capture_context, policy, empty_lookaround_admitted_states(n))
    AtomicPathSearchOriginActive : (char: Char) -> (rest: List(Char)) -> (source: Bounded(n)) -> (@erased canonical: Equivalent(List(LookaroundAdmittedState(n)), origin, lookaround_machine_admitted_destinations(depth, n, machine, ThreadActive(source), char, rest, after_input, history, capture_context, policy))) -> AtomicPathSearchOrigin(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, origin)

  ## Proof-only cause retained whenever the atomic path fold returns Commit.
  ## A local close records the rejected child that preceded the close; a
  ## propagated close retains the child's own cause. Both constructors retain
  ## the exact blocking depth comparison selected by the runtime branch.
