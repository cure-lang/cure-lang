  @reducible
  fn append_after_empty_tail(char: Char, rest: List(Char), right: List(Char), rest_empty: Equivalent(List(Char), rest, proof_empty_characters())) -> Equivalent(List(Char), Cons(char, right), append_characters(Cons(char, rest), right)) = match rest_empty
    reflexive() -> reflexive(Cons(char, right))

  @reducible
  fn append_empty_tail_after(rest: List(Char), right: List(Char), after_input: List(Char), rest_empty: Equivalent(List(Char), rest, proof_empty_characters())) -> Equivalent(List(Char), append_characters(rest, append_characters(right, after_input)), append_characters(right, after_input)) = match rest_empty
    reflexive() -> reflexive(append_characters(right, after_input))

  @reducible
  fn append_input_partition(left: List(Char), right: List(Char)) -> InputPartition(append_characters(left, right), left, right) = match left
    Nil() -> InputPartitionHere(right)
    Cons(char, rest) -> InputPartitionThere(char, append_input_partition(rest, right))

  @reducible
  fn partition_append_after({input: List(Char)}, {left: List(Char)}, {right: List(Char)}, after_input: List(Char), proof: InputPartition(input, left, right)) -> Equivalent(List(Char), append_characters(input, after_input), append_characters(left, append_characters(right, after_input))) = match proof
    InputPartitionHere(parts_right) -> reflexive(append_characters(parts_right, after_input))
    InputPartitionThere(char, prior) -> rewrite partition_append_after(after_input, prior) in reflexive(append_characters(left, append_characters(right, after_input)))

  @reducible
  fn transport_concat_right_acceptance(n: Nat, machine: PatternMachine(n), first_position: InitialPosition, second_position: InitialPosition, input: List(Char), after_input: List(Char), first_evidence: List(Evidence), second_evidence: List(Evidence), first_captures: List(CaptureFrame), second_captures: List(CaptureFrame), final_evidence: List(Evidence), position_equality: Equivalent(InitialPosition, first_position, second_position), evidence_equality: Equivalent(List(Evidence), first_evidence, second_evidence), captures_equality: Equivalent(List(CaptureFrame), first_captures, second_captures), boxed: ConcatRightAcceptance(n, machine, input, after_input, first_evidence, final_evidence, first_position, first_captures)) -> ConcatRightAcceptance(n, machine, input, after_input, second_evidence, final_evidence, second_position, second_captures) = match position_equality
    reflexive() -> match evidence_equality
      reflexive() -> match captures_equality
        reflexive() -> boxed
end
