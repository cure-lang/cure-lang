  @reducible
  fn box_concat_right_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> ConcatRightAcceptance(n, machine, input, after_input, input_evidence, final_evidence, position, input_captures) = acceptance_start_view(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)

  @reducible
  fn unbox_concat_right_acceptance(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), boxed: ConcatRightAcceptance(n, machine, input, after_input, input_evidence, final_evidence, position, input_captures)) -> AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence) = acceptance_from_start_view(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, boxed)

  @reducible
  fn accepted_start_now_view(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), edge: ListMember(MachineState(n), Accepted(regular, constraints), initial_machine_destinations(n, machine, position, input, after_input)), execution: RoutineExecution(regular, input_evidence, input_captures, initial_evidence, initial_captures), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), initial_evidence, initial_captures, final_evidence, path_routine)) -> AcceptedStartNowView(n, machine, position, after_input, input_evidence, input_captures, input, final_evidence, regular, constraints, initial_evidence, initial_captures, path_routine) = match path
    AcceptingNow() -> AcceptedStartNow(edge, execution)
    AcceptingNextActive(_, _, _, _, _, _, impossible_edge, _, _) -> impossible_list_member(impossible_edge)
    AcceptingNextAccepted(_, _, _, _, _, impossible_edge, _, _) -> impossible_list_member(impossible_edge)

  @reducible
  fn accepted_path_final_captures(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> Equivalent(List(CaptureFrame), accepting_final_captures(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine, path), captures) = match path
    AcceptingNow() -> reflexive(captures)
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  @reducible
  fn accepted_path_final_evidence(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> Equivalent(List(Evidence), final_evidence, current_evidence) = match path
    AcceptingNow() -> reflexive(current_evidence)
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  @reducible
  fn accepted_path_input_empty(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine)) -> Equivalent(List(Char), input, proof_empty_characters()) = match path
    AcceptingNow() -> reflexive(proof_empty_characters())
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> impossible_list_member(edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, _, _) -> impossible_list_member(edge)

  @reducible
  fn lift_append_left_member(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, left)) -> ListMember(MachineState(n), value, append_machine_states(n, left, right)) = match left
    Nil() -> impossible_list_member(edge)
    Cons(head, rest) -> match edge
      ListMemberHere() -> member_here(head, append_machine_states(n, rest, right))
      ListMemberThere(prior) -> member_there(head, lift_append_left_member(n, rest, right, value, prior))

  @reducible
  fn lift_filtered_right_active_member(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(right_count), routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Active(state, routine, Nil()), filter_machine_states(right_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_right(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Active(inject_alternate_right(left_count, right_count, head_state), head_routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Active(inject_alternate_right(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, prior))
      False() -> lift_filtered_right_active_member(left_count, right_count, rest, marker, boundary, state, routine, edge)

  @reducible
  fn lift_filtered_right_accepted_member(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), edge: ListMember(MachineState(right_count), Accepted(routine, Nil()), filter_machine_states(right_count, states, boundary))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> impossible
        ListMemberThere(prior) -> member_there(Active(inject_alternate_right(left_count, right_count, head_state), head_routine, Nil()), lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)
    Cons(Accepted(head_routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> match edge
        ListMemberHere() -> member_here(Accepted(append_branch_marker(head_routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, rest, marker), boundary))
        ListMemberThere(prior) -> member_there(Accepted(append_branch_marker(head_routine, marker), Nil()), lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, prior))
      False() -> lift_filtered_right_accepted_member(left_count, right_count, rest, marker, boundary, routine, edge)

  @reducible
  fn lift_alternate_right_active_edge(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, state: Bounded(right_count), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(right_count), Active(state, routine, constraints), filter_machine_states(right_count, states, boundary)), origin: FilteredStateOrigin(right_count, states, boundary, Active(state, routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_right(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> lift_filtered_right_active_member(left_count, right_count, states, marker, boundary, state, routine, edge)
    FilteredAcceptedStateOrigin(_, _, _, _) -> impossible

  @reducible
  fn lift_alternate_right_accepted_edge(left_count: Nat, right_count: Nat, states: List(MachineState(right_count)), marker: EvidenceInstruction, boundary: Boundary, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(right_count), Accepted(routine, constraints), filter_machine_states(right_count, states, boundary)), origin: FilteredStateOrigin(right_count, states, boundary, Accepted(routine, constraints))) -> ListMember(MachineState(plus(left_count, right_count)), Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, states, marker), boundary)) = match origin
    FilteredActiveStateOrigin(_, _, _, _, _) -> impossible
    FilteredAcceptedStateOrigin(_, _, _, _) -> lift_filtered_right_accepted_member(left_count, right_count, states, marker, boundary, routine, edge)

  @reducible
  fn concat_right_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), source: Bounded(right_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), concat_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next)), ThreadActive(inject_alternate_right(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitPair()), boundary)) =
    rewrite split_injected_right(left_count, source) in rewrite finish_pair_is_mark_branch(right_next(source, char)) in reflexive(filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitPair()), boundary))

  @reducible
  fn concat_right_transition_member(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), source: Bounded(right_count), char: Char, boundary: Boundary, destination: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), destination, filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitPair()), boundary))) -> ListMember(MachineState(plus(left_count, right_count)), destination, machine_destinations(plus(left_count, right_count), concat_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next)), ThreadActive(inject_alternate_right(left_count, right_count, source)), char, boundary)) = match concat_right_destinations_equivalent(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, boundary)
    reflexive() -> edge

  @reducible
  fn lift_concat_right_active_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), child_routine: List(ExtendedInstruction), path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> ConcatRightActivePathEmbedding(left_count, left_machine, right_count, right_machine, input, after_input, source, current_evidence, current_captures, child_final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNow() -> impossible
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match lift_concat_right_active_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), rest, after_input, destination, destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix)
            mk_pair(combined_suffix_routine, combined_suffix) ->
              let origin = filtered_state_origin(right_count, right_next(source, char), transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_right_active_edge(left_count, right_count, right_next(source, char), EmitPair(), transition_boundary_before(char, rest, after_input), destination, regular, constraints, edge, origin)
              let combined_edge = concat_right_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, transition_boundary_before(char, rest, after_input), Active(inject_alternate_right(left_count, right_count, destination), regular, Nil()), filtered_combined_edge)
              let combined_routine = append_extended_routines(transition_routine(char, regular), combined_suffix_routine)
              %[combined_routine, AcceptingNextActive(inject_alternate_right(left_count, right_count, destination), regular, empty_constraints(), destination_evidence, destination_captures, combined_suffix_routine, combined_edge, execution, combined_suffix)]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match suffix
            AcceptingNow() ->
              let marker_execution: RoutineExecution(Cons(EmitPair(), Nil()), destination_evidence, destination_captures, Cons(PairEvidence(), destination_evidence), destination_captures) = RoutineStep(EmitPair(), RoutineDone())
              let combined_execution = append_routine_execution(regular, Cons(EmitPair(), Nil()), current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, Cons(PairEvidence(), destination_evidence), destination_captures, execution, marker_execution)
              let origin = filtered_state_origin(right_count, right_next(source, char), transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_right_accepted_edge(left_count, right_count, right_next(source, char), EmitPair(), transition_boundary_before(char, rest, after_input), regular, constraints, edge, origin)
              let combined_edge = concat_right_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, source, char, transition_boundary_before(char, rest, after_input), Accepted(append_branch_marker(regular, EmitPair()), Nil()), filtered_combined_edge)
              let no_extended: List(ExtendedInstruction) = Nil()
              let combined_routine = append_extended_routines(transition_routine(char, append_branch_marker(regular, EmitPair())), no_extended)
              %[combined_routine, AcceptingNextAccepted(append_branch_marker(regular, EmitPair()), empty_constraints(), Cons(PairEvidence(), destination_evidence), destination_captures, no_extended, combined_edge, combined_execution, AcceptingNow())]
            AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
            AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible

  @reducible
  fn concat_left_active_path_routine(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, left_input: List(Char), right_input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), right_final_evidence: List(Evidence), embedding: ConcatLeftActivePathEmbedding(left_count, left_machine, right_count, right_machine, position, left_input, right_input, after_input, source, current_evidence, current_captures, right_final_evidence)) -> List(ExtendedInstruction) = match embedding
