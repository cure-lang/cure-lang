  @reducible
  fn concat_left_active_path_value(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, left_input: List(Char), right_input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), right_final_evidence: List(Evidence), embedding: ConcatLeftActivePathEmbedding(left_count, left_machine, right_count, right_machine, position, left_input, right_input, after_input, source, current_evidence, current_captures, right_final_evidence)) -> AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), append_characters(left_input, right_input), after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, Cons(PairEvidence(), right_final_evidence), concat_left_active_path_routine(left_count, left_machine, right_count, right_machine, position, left_input, right_input, after_input, source, current_evidence, current_captures, right_final_evidence, embedding)) = match embedding
