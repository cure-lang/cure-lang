  @reducible
  fn advance_position_after_empty_tail(position: InitialPosition, char: Char, rest: List(Char), rest_empty: Equivalent(List(Char), rest, proof_empty_characters())) -> Equivalent(InitialPosition, advance_initial_position(position, Cons(char, rest)), advance_initial_position(position, Cons(char, Nil()))) = match rest_empty
