  @reducible
  fn prepend_concat_left_active_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), char: Char, rest: List(Char), right_input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), destination: Bounded(left_count), regular: List(EvidenceInstruction), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), edge: ListMember(MachineState(plus(left_count, right_count)), Active(inject_alternate_left(left_count, right_count, destination), regular, empty_constraints()), machine_destinations(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, transition_boundary_before(char, append_characters(rest, right_input), after_input))), execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures), right_final_evidence: List(Evidence), suffix: AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), append_characters(rest, right_input), after_input, ThreadActive(inject_alternate_left(left_count, right_count, destination)), destination_evidence, destination_captures, Cons(PairEvidence(), right_final_evidence), suffix_routine)) -> AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), append_characters(Cons(char, rest), right_input), after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, Cons(PairEvidence(), right_final_evidence), append_extended_routines(transition_routine(char, regular), suffix_routine)) =
