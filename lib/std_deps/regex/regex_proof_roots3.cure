  fn lift_alternate_left_accepted_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), regular: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), edge: ListMember(MachineState(left_count), Accepted(regular, Nil()), initial_machine_destinations(left_count, left_machine, position, input, after_input)), execution: RoutineExecution(regular, input_evidence, input_captures, initial_evidence, initial_captures), child_final_evidence: List(Evidence), path_routine: List(ExtendedInstruction), path: AcceptingFrom(left_count, left_machine, input, after_input, ThreadAccepted(), initial_evidence, initial_captures, child_final_evidence, path_routine)) -> AlternateLeftAcceptanceEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, input_evidence, input_captures, child_final_evidence) = match path
    AcceptingNow() ->
      let marker_done: RoutineExecution(Nil(), Cons(LeftEvidence(), initial_evidence), initial_captures, Cons(LeftEvidence(), initial_evidence), initial_captures) = RoutineDone()
      let marker_execution: RoutineExecution(Cons(EmitLeft(), Nil()), initial_evidence, initial_captures, Cons(LeftEvidence(), initial_evidence), initial_captures) = RoutineStep(EmitLeft(), marker_done)
      let combined_execution = append_routine_execution(regular, Cons(EmitLeft(), Nil()), input_evidence, input_captures, initial_evidence, initial_captures, Cons(LeftEvidence(), initial_evidence), initial_captures, execution, marker_execution)
      let combined_edge = lift_alternate_left_initial_accepted_member(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, regular, edge)
      %[Accepted(append_branch_marker(regular, EmitLeft()), Nil()), Cons(LeftEvidence(), initial_evidence), initial_captures, Nil(), combined_edge, combined_execution, AcceptingNow()]
    AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
    AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible

  fn lift_alternate_right_accepted_acceptance(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), regular: List(EvidenceInstruction), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), edge: ListMember(MachineState(right_count), Accepted(regular, Nil()), initial_machine_destinations(right_count, right_machine, position, input, after_input)), execution: RoutineExecution(regular, input_evidence, input_captures, initial_evidence, initial_captures), child_final_evidence: List(Evidence), path_routine: List(ExtendedInstruction), path: AcceptingFrom(right_count, right_machine, input, after_input, ThreadAccepted(), initial_evidence, initial_captures, child_final_evidence, path_routine)) -> AlternateRightAcceptanceEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, input_evidence, input_captures, child_final_evidence) = match path
    AcceptingNow() ->
      let marker_done: RoutineExecution(Nil(), Cons(RightEvidence(), initial_evidence), initial_captures, Cons(RightEvidence(), initial_evidence), initial_captures) = RoutineDone()
      let marker_execution: RoutineExecution(Cons(EmitRight(), Nil()), initial_evidence, initial_captures, Cons(RightEvidence(), initial_evidence), initial_captures) = RoutineStep(EmitRight(), marker_done)
      let combined_execution = append_routine_execution(regular, Cons(EmitRight(), Nil()), input_evidence, input_captures, initial_evidence, initial_captures, Cons(RightEvidence(), initial_evidence), initial_captures, execution, marker_execution)
      let combined_edge = lift_alternate_right_initial_accepted_member(left_count, left_machine, right_count, right_machine, prefer_right, position, input, after_input, regular, edge)
