    AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
    AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible

  typealias AlternateAcceptanceProjection(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = Sigma(right_branch: Bool, AlternateAcceptanceBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence, right_branch))

  fn projected_alternate_left({left_count: Nat}, {left_machine: PatternMachine(left_count)}, {right_count: Nat}, {right_machine: PatternMachine(right_count)}, {position: InitialPosition}, {input: List(Char)}, {after_input: List(Char)}, {final_evidence: List(Evidence)}, projection: AlternateLeftAcceptanceProjection(left_count, left_machine, position, input, after_input, final_evidence)) -> AlternateAcceptanceBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence, False()) = ProjectedAlternateLeft(projection)

  fn projected_alternate_right({left_count: Nat}, {left_machine: PatternMachine(left_count)}, {right_count: Nat}, {right_machine: PatternMachine(right_count)}, {position: InitialPosition}, {input: List(Char)}, {after_input: List(Char)}, {final_evidence: List(Evidence)}, projection: AlternateRightAcceptanceProjection(right_count, right_machine, position, input, after_input, final_evidence)) -> AlternateAcceptanceBranch(left_count, left_machine, right_count, right_machine, position, input, after_input, final_evidence, True()) = ProjectedAlternateRight(projection)

  fn alternate_acceptance_from_left_projection({left_count: Nat}, {left_machine: PatternMachine(left_count)}, {right_count: Nat}, {right_machine: PatternMachine(right_count)}, {position: InitialPosition}, {input: List(Char)}, {after_input: List(Char)}, {input_evidence: List(Evidence)}, {input_captures: List(CaptureFrame)}, {final_evidence: List(Evidence)}, projection: AlternateLeftAcceptanceFromProjection(left_count, left_machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AlternateAcceptanceFromProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence) = %[False(), ProjectedAlternateFromLeft(projection)]

  fn alternate_acceptance_from_right_projection({left_count: Nat}, {left_machine: PatternMachine(left_count)}, {right_count: Nat}, {right_machine: PatternMachine(right_count)}, {position: InitialPosition}, {input: List(Char)}, {after_input: List(Char)}, {input_evidence: List(Evidence)}, {input_captures: List(CaptureFrame)}, {final_evidence: List(Evidence)}, projection: AlternateRightAcceptanceFromProjection(right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AlternateAcceptanceFromProjection(left_count, left_machine, right_count, right_machine, position, input, after_input, input_evidence, input_captures, final_evidence) = %[True(), ProjectedAlternateFromRight(projection)]

  fn boundary_acceptance_path_from_parts(constraint: BoundaryConstraint, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), destination: MachineState(Z()), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, edge: ListMember(MachineState(Z()), destination, initial_machine_destinations(Z(), boundary_pattern_machine(constraint), position, input, after_input)), initial_execution: RoutineExecution(machine_state_routine(Z(), destination), input_evidence, input_captures, initial_evidence, initial_captures), path: AcceptingFrom(Z(), boundary_pattern_machine(constraint), input, after_input, machine_state_thread(Z(), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> Encodes(UnitC(), final_evidence, input_evidence) = match boundary_starts_view(constraint, position, append_characters(input, after_input))
    BoundaryStartsUnavailable() -> impossible_list_member(edge)
    BoundaryStartsExact() -> match edge
      ListMemberHere() -> match initial_execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineDone() -> match accepted_path_view(Z(), boundary_pattern_machine(constraint), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
            AcceptedPathNow() -> EncodesUnit()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_acceptance_input_empty_parts(constraint: BoundaryConstraint, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), destination: MachineState(Z()), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, edge: ListMember(MachineState(Z()), destination, initial_machine_destinations(Z(), boundary_pattern_machine(constraint), position, input, after_input)), path: AcceptingFrom(Z(), boundary_pattern_machine(constraint), input, after_input, machine_state_thread(Z(), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> Equivalent(List(Char), input, Nil()) = match boundary_starts_view(constraint, position, append_characters(input, after_input))
    BoundaryStartsUnavailable() -> impossible_list_member(edge)
    BoundaryStartsExact() -> match edge
      ListMemberHere() -> accepted_path_input_empty(Z(), boundary_pattern_machine(constraint), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_acceptance_path_from_encodes(test: Char -> Bool, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, acceptance: AcceptancePathFrom(S(Z()), predicate_pattern_machine(test), position, input, after_input, input_evidence, input_captures, final_evidence)) -> Encodes(CharC(), final_evidence, input_evidence) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> match predicate_starts_view(test, position, input, after_input)
      PredicateStartsExact() -> match edge
        ListMemberHere() -> match initial_execution
          RoutineDone() -> predicate_arbitrary_path_from_encodes(test, input, after_input, initial_evidence, initial_captures, path)
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_acceptance_captures_parts(constraint: BoundaryConstraint, input: List(Char), after_input: List(Char), position: InitialPosition, input_evidence: List(Evidence), input_captures: List(CaptureFrame), destination: MachineState(Z()), initial_evidence: List(Evidence), initial_captures: List(CaptureFrame), path_routine: List(ExtendedInstruction), {final_evidence: List(Evidence)}, edge: ListMember(MachineState(Z()), destination, initial_machine_destinations(Z(), boundary_pattern_machine(constraint), position, input, after_input)), initial_execution: RoutineExecution(machine_state_routine(Z(), destination), input_evidence, input_captures, initial_evidence, initial_captures), path: AcceptingFrom(Z(), boundary_pattern_machine(constraint), input, after_input, machine_state_thread(Z(), destination), initial_evidence, initial_captures, final_evidence, path_routine)) -> Equivalent(List(CaptureFrame), accepting_final_captures(Z(), boundary_pattern_machine(constraint), input, after_input, machine_state_thread(Z(), destination), initial_evidence, initial_captures, final_evidence, path_routine, path), record_capture_input(input_captures, input)) = match boundary_starts_view(constraint, position, append_characters(input, after_input))
    BoundaryStartsUnavailable() -> impossible_list_member(edge)
    BoundaryStartsExact() -> match edge
      ListMemberHere() -> match initial_execution
        RoutineStep(_, after_emit) -> match after_emit
          RoutineDone() -> match path
            AcceptingNow() -> reflexive(input_captures)
            AcceptingNextActive(_, _, _, _, _, _, impossible_edge, _, _) -> impossible_list_member(impossible_edge)
            AcceptingNextAccepted(_, _, _, _, _, impossible_edge, _, _) -> impossible_list_member(impossible_edge)
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_path_captures(test: Char -> Bool, input: List(Char), after_input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), input, after_input, predicate_machine_thread(), current_evidence, captures, final_evidence, routine)) -> Equivalent(List(CaptureFrame), accepting_final_captures(S(Z()), predicate_pattern_machine(test), input, after_input, predicate_machine_thread(), current_evidence, captures, final_evidence, routine, path), record_capture_input(captures, input)) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> predicate_active_capture_impossible(test, char, transition_boundary_before(char, rest, after_input), edge)
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match predicate_accepted_edge_view(test, char, transition_boundary_before(char, rest, after_input), regular, constraints, edge)
        PredicateAcceptedEdgeExact() -> match predicate_capture_execution_view(test, char, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution)
          PredicateCaptureExecutionExact() -> match accepted_path_view(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
            AcceptedPathNow() -> rewrite accepted_path_input_empty(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix) in
              capture_equivalent_transitive(
                  accepting_final_captures(S(Z()), MkPatternMachine(Cons(Active(First(), Nil(), Nil()), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), Cons(char, Nil()), after_input, ThreadActive(First()), current_evidence, captures, final_evidence, Cons(Observe(char), Cons(Regular(EmitChar(char)), Nil())), path),
                  accepting_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix),
                  record_capture_input(captures, Cons(char, Nil())),
                  reflexive(accepting_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)),
                  capture_equivalent_transitive(
                accepting_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix),
                record_capture_char(captures, char),
                record_capture_input(captures, Cons(char, Nil())),
                accepted_path_final_captures(S(Z()), MkPatternMachine(Cons(predicate_machine_start(), Nil()), fn(state, next_char) -> predicate_machine_next(test, state, next_char)), rest, after_input, destination_evidence, destination_captures, final_evidence, suffix_routine, suffix),
                record_capture_single(captures, char)
              ))

  fn filtered_group_start_origin(n: Nat, starts: List(MachineState(n)), boundary: Boundary, filtered: MachineState(n), edge: ListMember(MachineState(n), filtered, filter_machine_states(n, finish_capture(prefix_routine(BeginCapture(), starts)), boundary))) -> FilteredGroupStartOrigin(n, starts, boundary, filtered) = match filtered_finish_capture_origin(n, prefix_routine(BeginCapture(), starts), boundary, filtered, edge)
    FilteredCaptureActiveOrigin(state, prefixed_routine, constraints, prefixed_edge, holds) -> match prefix_routine_origin(BeginCapture(), starts, Active(state, prefixed_routine, constraints), prefixed_edge)
      PrefixedActiveOrigin(_, child_routine, _, child_edge) -> GroupStartActiveOrigin(state, child_routine, constraints, child_edge, holds)
    FilteredCaptureAcceptedOrigin(prefixed_routine, constraints, prefixed_edge, holds) -> match prefix_routine_origin(BeginCapture(), starts, Accepted(prefixed_routine, constraints), prefixed_edge)
      PrefixedAcceptedOrigin(child_routine, _, child_edge) -> GroupStartAcceptedOrigin(child_routine, constraints, child_edge, holds)

  fn group_transition_origin(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), source: Bounded(n), char: Char, boundary: Boundary, destination: MachineState(n), edge: ListMember(MachineState(n), destination, machine_destinations(n, group_pattern_machine(n, starts, next), ThreadActive(source), char, boundary))) -> FilteredFinishCaptureOrigin(n, next(source, char), boundary, destination) =
    filtered_finish_capture_origin(n, next(source, char), boundary, destination, edge)

  fn project_group_accepted_origin(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), edge: ListMember(MachineState(n), Accepted(regular, constraints), machine_destinations(n, group_pattern_machine(n, starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input))), execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures), {final_evidence: List(Evidence)}, suffix: AcceptingFrom(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine), path: AcceptingFrom(n, group_pattern_machine(n, starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine)), origin: FilteredFinishCaptureOrigin(n, next(source, char), transition_boundary_before(char, rest, after_input), Accepted(regular, constraints))) -> GroupActivePathProjection(n, starts, next, Cons(char, rest), after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, group_pattern_machine(n, starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), path)) = match origin
    FilteredCaptureAcceptedOrigin(child_regular, child_constraints, child_edge, holds) ->
      let parent_suffix_exact = accepting_next_accepted_final_captures(n, group_pattern_machine(n, starts, next), char, rest, after_input, source, current_evidence, current_captures, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, final_evidence, suffix, path)
      let terminal_projection = project_group_accepted_transition(n, starts, next, char, rest, after_input, source, current_evidence, current_captures, child_regular, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, path, child_constraints, child_edge, holds, accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix), parent_suffix_exact)
      transport_group_active_projection_to_path(n, starts, next, Cons(char, rest), after_input, source, current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), path, accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix), parent_suffix_exact, terminal_projection)

  fn project_group_active_transition(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), char: Char, rest: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), destination: Bounded(n), child_regular: List(EvidenceInstruction), child_constraints: List(BoundaryConstraint), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), edge: ListMember(MachineState(n), Active(destination, child_regular, empty_constraints()), machine_destinations(n, group_pattern_machine(n, starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input))), execution: RoutineExecution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures), {final_evidence: List(Evidence)}, suffix: AcceptingFrom(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine), path: AcceptingFrom(n, group_pattern_machine(n, starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, child_regular), suffix_routine)), child_edge: ListMember(MachineState(n), Active(destination, child_regular, child_constraints), next(source, char)), holds: Equivalent(Bool, constraints_hold(child_constraints, transition_boundary_before(char, rest, after_input)), True()), child_projection: GroupActivePathProjection(n, starts, next, rest, after_input, destination, destination_evidence, destination_captures, final_evidence, accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix))) -> GroupActivePathProjection(n, starts, next, Cons(char, rest), after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, group_pattern_machine(n, starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, child_regular), suffix_routine), path)) =
    match child_projection
      ProjectedGroupMissingFrame(child_final_evidence, child_suffix_routine, child_suffix, child_suffix_execution, combined_final_captures, captures_exact, projected_final_evidence, projected_evidence_exact, child_final_captures, child_projection_captures_exact) ->
        let filtered_edge = inner_transition_member(n, starts, next, source, char, transition_boundary_before(char, rest, after_input), Active(destination, child_regular, empty_constraints()), filter_active_member(n, next(source, char), transition_boundary_before(char, rest, after_input), destination, child_regular, child_constraints, child_edge, holds))
        let child_path: AcceptingFrom(n, MkPatternMachine(starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine)) = AcceptingNextActive(destination, child_regular, empty_constraints(), destination_evidence, destination_captures, child_suffix_routine, filtered_edge, execution, child_suffix)
        let transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
        let child_execution = append_extended_routine_execution(transition_routine(char, child_regular), child_suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, child_final_evidence, empty_captures(), transition_execution, child_suffix_execution)
        let suffix_to_combined: Equivalent(List(CaptureFrame), accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix), combined_final_captures) = child_projection_captures_exact
        let final_to_child: Equivalent(List(Evidence), final_evidence, child_final_evidence) = projected_evidence_exact
        let parent_projection: GroupActivePathProjection(n, starts, next, Cons(char, rest), after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)) = ProjectedGroupMissingFrame(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), child_path, child_execution, combined_final_captures, captures_exact, final_evidence, final_to_child, accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix), suffix_to_combined)
        lift_group_active_projection(n, starts, next, char, rest, after_input, source, current_evidence, current_captures, destination, child_regular, empty_constraints(), destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, path, parent_projection)
      ProjectedGroupClosedFrame(child_final_evidence, child_suffix_routine, chars, saved, outer, child_suffix, child_suffix_execution, combined_final_captures, captures_exact, projected_final_evidence, projected_evidence_exact, child_final_captures, child_projection_captures_exact) ->
        let filtered_edge = inner_transition_member(n, starts, next, source, char, transition_boundary_before(char, rest, after_input), Active(destination, child_regular, empty_constraints()), filter_active_member(n, next(source, char), transition_boundary_before(char, rest, after_input), destination, child_regular, child_constraints, child_edge, holds))
        let child_path: AcceptingFrom(n, MkPatternMachine(starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine)) = AcceptingNextActive(destination, child_regular, empty_constraints(), destination_evidence, destination_captures, child_suffix_routine, filtered_edge, execution, child_suffix)
        let transition_execution = ExtendedEvidenceObserve(char, extend_routine_execution(child_regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, execution))
        let final_captures = Cons(CaptureFrame(chars, saved), outer)
        let child_execution = append_extended_routine_execution(transition_routine(char, child_regular), child_suffix_routine, current_evidence, current_captures, destination_evidence, destination_captures, child_final_evidence, final_captures, transition_execution, child_suffix_execution)
        let suffix_to_combined: Equivalent(List(CaptureFrame), accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix), combined_final_captures) = child_projection_captures_exact
        let closed_evidence = Cons(StringEvidence(captured_string(chars)), saved)
        let final_to_closed: Equivalent(List(Evidence), final_evidence, closed_evidence) = projected_evidence_exact
        let parent_projection: GroupActivePathProjection(n, starts, next, Cons(char, rest), after_input, source, current_evidence, current_captures, final_evidence, accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)) = ProjectedGroupClosedFrame(child_final_evidence, append_extended_routines(transition_routine(char, child_regular), child_suffix_routine), chars, saved, outer, child_path, child_execution, combined_final_captures, captures_exact, final_evidence, final_to_closed, accepting_final_captures(n, group_pattern_machine(n, starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix), suffix_to_combined)
        lift_group_active_projection(n, starts, next, char, rest, after_input, source, current_evidence, current_captures, destination, child_regular, empty_constraints(), destination_evidence, destination_captures, suffix_routine, edge, execution, suffix, path, parent_projection)

  fn acceptance_with_execution(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> SomeAcceptanceWithExecution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence) = match acceptance_path_execution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)
    AcceptanceExecuted(final_captures, execution) -> SomeAcceptedWithExecution(final_captures, AcceptedWithExecution(acceptance, execution))

  fn transport_staged_machine_acceptance(
    {shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    final_evidence: List(Evidence),
    extended_routine: List(ExtendedInstruction),
    acceptance: MachineAcceptance(thompson_state_count(compilation), staged_machine_from_compilation(compilation), position, input, after_input, final_evidence, extended_routine)
  ) -> MachineAcceptance(thompson_state_count(compilation), thompson_machine(compilation), position, input, after_input, final_evidence, extended_routine) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, execution, routine_certificate, path) ->
      let initial_edge = transport_list_member(destination, edge, staged_initial_destinations_equivalent(compilation, position, input, after_input))
      MachineAccepted(
        destination,
        initial_evidence,
        initial_captures,
        path_routine,
        initial_edge,
        execution,
        routine_certificate,
        transport_staged_accepting_from(compilation, input, after_input, machine_state_thread(thompson_state_count(compilation), destination), initial_evidence, initial_captures, final_evidence, path_routine, path)
      )

  fn group_child_execution_is_canonical(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {final_evidence: List(Evidence)}, {final_captures: List(CaptureFrame)}, projection: GroupAcceptanceFromProjection(n, starts, next, position, input, after_input, input_evidence, input_captures, final_evidence, final_captures)) -> Unit = match projection
    ProjectedGroupAcceptanceMissingFrame(_, AcceptedWithExecution(_, _), _, _, _, _) -> ()
    ProjectedGroupAcceptanceClosedFrame(_, _, _, _, AcceptedWithExecution(_, _), _, _, _, _) -> ()

  fn impossible_missing_group_capture(
    {result: Type},
    input_evidence: List(Evidence),
    input_captures: List(CaptureFrame),
    input: List(Char),
    missing: Equivalent(
      List(CaptureFrame),
      Nil(),
      record_capture_input(Cons(CaptureFrame(Nil(), input_evidence), input_captures), input)
    )
  ) -> result = match recorded_open_capture_view(Nil(), input_evidence, input_captures, input, Nil(), missing)

  fn grouped_predicate_path_encodes(test: Char -> Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), group_pattern_machine(S(Z()), Cons(predicate_machine_start(), Nil()), predicate_machine_next(test)), Cons(char, Nil()), after_input, ThreadActive(First()), Nil(), Cons(CaptureFrame(Nil(), Nil()), Nil()), final_evidence, routine)) -> Encodes(StringC, final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> grouped_predicate_active_impossible(test, char, transition_boundary_before(char, Nil(), after_input), edge)
    AcceptingNextAccepted(_, _, _, _, _, edge, execution, suffix) -> grouped_predicate_accepted_encodes(test, char, after_input, edge, execution, suffix)

  fn predicate_concat_right_execution_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), destination_evidence: List(Evidence), destination_captures: List(CaptureFrame), suffix_routine: List(ExtendedInstruction), @erased final_evidence: List(Evidence), execution: RoutineExecution(Cons(EmitChar(right_char), Cons(EmitPair(), Nil())), Cons(CharacterEvidence(left_char), empty_evidence()), record_capture_char(Nil(), right_char), destination_evidence, destination_captures), suffix: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), empty_characters(), after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match execution
    RoutineStep(_, after_right) -> match after_right
      RoutineStep(_, after_pair) -> match after_pair
        RoutineDone() -> match suffix
          AcceptingNow() -> encodes_character_pair(left_char, right_char)

  fn impossible_predicate_concat_first_accepted(left: Char -> Bool, right: Char -> Bool, char: Char, boundary: Boundary, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {result: Type}, edge: ListMember(MachineState(plus(S(Z()), S(Z()))), Accepted(regular, constraints), machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), predicate_concat_start_thread(), char, boundary))) -> result = match predicate_concat_first_view(left, right, char, boundary)
    PredicateConcatFirstRejects() -> impossible_concat_accepted_tail(regular, constraints, edge)
    PredicateConcatFirstAccepts() -> match edge
      ListMemberThere(prior) -> impossible_concat_accepted_tail(regular, constraints, prior)

  fn predicate_concat_right_path_encodes(left: Char -> Bool, right: Char -> Bool, left_char: Char, right_char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), Cons(right_char, empty_characters()), after_input, predicate_concat_middle_thread(), Cons(CharacterEvidence(left_char), empty_evidence()), Nil(), final_evidence, routine)) -> Encodes(PairC(CharC, CharC), final_evidence, empty_evidence()) = match path
    AcceptingNextActive(_, _, _, _, _, _, edge, _, _) -> match predicate_concat_second_view(left, right, right_char, transition_boundary_before(right_char, empty_characters(), after_input))
      PredicateConcatSecondRejects() -> impossible_list_member(edge)
      PredicateConcatSecondAccepts() -> match edge
        ListMemberThere(prior) -> impossible_list_member(prior)
    AcceptingNextAccepted(regular, constraints, _, _, _, edge, execution, suffix) -> match predicate_concat_second_view(left, right, right_char, transition_boundary_before(right_char, empty_characters(), after_input))
      PredicateConcatSecondRejects() -> impossible_list_member(edge)
      PredicateConcatSecondAccepts() -> match predicate_concat_accepted_edge_view(right_char, regular, constraints, edge)
        PredicateConcatAcceptedEdgeExact() -> match execution
          RoutineStep(_, after_right) -> match after_right
            RoutineStep(_, after_pair) -> match after_pair
              RoutineDone() -> match suffix
                AcceptingNow() -> encodes_character_pair(left_char, right_char)

  fn predicate_alternate_initial_view(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(S(Z()), S(Z()))), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_alternate_mode_machine(left, right, prefer_right), position, input, after_input))) -> PredicateAlternateInitialView(prefer_right, destination) = match predicate_alternate_starts_view(left, right, prefer_right, position, input, after_input)
    PredicateAlternateStartsLeftFirst() -> match edge
      ListMemberHere() -> PredicateAlternateInitialLeft()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateAlternateInitialRight()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
    PredicateAlternateStartsRightFirst() -> match edge
      ListMemberHere() -> PredicateAlternateInitialRight()
      ListMemberThere(prior) -> match prior
        ListMemberHere() -> PredicateAlternateInitialLeft()
        ListMemberThere(impossible) -> impossible_list_member(impossible)
end
