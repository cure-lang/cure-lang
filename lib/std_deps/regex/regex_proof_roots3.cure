  fn acceptance_execution_witness(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> SomeAcceptanceExecutionWitness(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance, True()) = match acceptance_path_execution(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance)
    AcceptanceExecuted(final_captures, execution) -> SomeWitnessedAcceptanceExecution(final_captures, WitnessedAcceptanceExecution(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance), execution, reflexive(acceptance_extended_routine(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence, acceptance))))

  fn predicate_concat_initial_destination_view(left: Char -> Bool, right: Char -> Bool, position: InitialPosition, input: List(Char), after_input: List(Char), destination: MachineState(plus(S(Z()), S(Z()))), edge: ListMember(MachineState(plus(S(Z()), S(Z()))), destination, initial_machine_destinations(plus(S(Z()), S(Z())), predicate_concat_machine(left, right), position, input, after_input))) -> PredicateConcatInitialDestinationView(destination) = match predicate_concat_starts_view(left, right, position, input, after_input)
    PredicateConcatStartsExact() -> match edge
      ListMemberHere() -> PredicateConcatInitialDestinationExact()
      ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_machine_acceptance_encodes(constraint: BoundaryConstraint, position: InitialPosition, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, empty_characters(), after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, _, _, _, edge, initial_execution, _, path) -> match boundary_starts_view(constraint, position, after_input)
      BoundaryStartsUnavailable() -> impossible_list_member(edge)
      BoundaryStartsExact() -> match edge
        ListMemberHere() -> match path
          AcceptingNow() -> match initial_execution
            RoutineStep(_, after_emit) -> match after_emit
              RoutineDone() -> EncodesUnit()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn boundary_machine_arbitrary_acceptance_encodes(constraint: BoundaryConstraint, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(Z(), boundary_pattern_machine(constraint), position, input, after_input, final_evidence, routine)) -> Encodes(UnitC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, initial_evidence, initial_captures, path_routine, edge, initial_execution, _, path) -> match boundary_starts_view(constraint, position, append_characters(input, after_input))
      BoundaryStartsUnavailable() -> impossible_list_member(edge)
      BoundaryStartsExact() -> match edge
        ListMemberHere() -> match initial_execution
          RoutineStep(_, after_emit) -> match after_emit
            RoutineDone() -> match accepted_path_view(Z(), boundary_pattern_machine(constraint), input, after_input, initial_evidence, initial_captures, final_evidence, path_routine, path)
              AcceptedPathNow() -> EncodesUnit()
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn predicate_path_routine_encodes(test: Char -> Bool, char: Char, after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {path_evidence: List(Evidence)}, {path_captures: List(CaptureFrame)}, {path_final_evidence: List(Evidence)}, {routine: List(ExtendedInstruction)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), path_evidence, path_captures, path_final_evidence, routine), execution: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(CharC, output_evidence, input_evidence) =
    match predicate_path_routine_view(test, char, after_input, path)
      PredicateRoutineExact() -> predicate_transition_routine_encodes(char, execution)

  fn predicate_path_view(test: Char -> Bool, char: Char, after_input: List(Char), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(S(Z()), predicate_pattern_machine(test), Cons(char, Nil()), after_input, predicate_machine_thread(), Nil(), Nil(), final_evidence, routine)) -> PredicatePathView(char, final_evidence, routine) = match predicate_path_routine_view(test, char, after_input, path)
    PredicateRoutineExact() -> predicate_exact_path_view(test, char, after_input, path)

  fn predicate_machine_acceptance_encodes(test: Char -> Bool, char: Char, after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, Cons(char, empty_characters()), after_input, final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(destination, initial_evidence, initial_captures, path_routine, edge, initial_execution, routine_certificate, path) ->
      match predicate_initial_path_view(test, char, after_input, position, destination, final_evidence, path_routine, edge, initial_execution, path)
        PredicatePathExact() -> encodes_character_empty(char)

  fn predicate_machine_arbitrary_acceptance_encodes(test: Char -> Bool, input: List(Char), after_input: List(Char), position: InitialPosition, @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), acceptance: MachineAcceptance(S(Z()), predicate_pattern_machine(test), position, input, after_input, final_evidence, routine)) -> Encodes(CharC, final_evidence, empty_evidence()) = match acceptance
    MachineAccepted(_, _, _, path_routine, edge, initial_execution, _, path) -> match predicate_starts_view(test, position, input, after_input)
      PredicateStartsExact() -> match edge
        ListMemberHere() -> match initial_execution
          RoutineDone() -> predicate_arbitrary_path_encodes(test, input, after_input, final_evidence, path_routine, path)
        ListMemberThere(prior) -> impossible_list_member(prior)

  fn lift_repeat_closing_transition_member(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations), holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> ListMember(MachineState(n), Accepted(append_routine(routine, Cons(EndList(), Nil())), Nil()), filter_machine_states(n, repeat_destinations(destinations, starts, lazy), boundary)) =
    filter_accepted_member(n, repeat_destinations(destinations, starts, lazy), boundary, append_routine(routine, Cons(EndList(), Nil())), constraints, lift_repeat_destinations_closing_member(n, destinations, starts, lazy, routine, constraints, edge), holds)

  fn lift_repeat_destinations_reentry_member(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations), state: Bounded(n), start_routine: List(EvidenceInstruction), start_constraints: List(BoundaryConstraint), start_edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> ListMember(MachineState(n), Active(state, append_routine(routine, start_routine), append_constraints(constraints, start_constraints)), repeat_destinations(destinations, starts, lazy)) = match destinations
    Nil() -> impossible_list_member(edge)
    Cons(Active(head_state, head_routine, head_constraints), rest) -> match edge
      ListMemberThere(prior) -> member_there(Active(head_state, head_routine, head_constraints), lift_repeat_destinations_reentry_member(n, rest, starts, lazy, routine, constraints, prior, state, start_routine, start_constraints, start_edge))
    Cons(Accepted(head_routine, head_constraints), rest) -> match edge
      ListMemberHere() -> lift_append_left_member(n, repeat_destination_order(head_routine, head_constraints, starts, lazy), repeat_destinations(rest, starts, lazy), Active(state, append_routine(head_routine, start_routine), append_constraints(head_constraints, start_constraints)), lift_repeat_destination_reentry_order_member(n, head_routine, head_constraints, starts, lazy, state, start_routine, start_constraints, start_edge))
      ListMemberThere(prior) -> lift_append_right_member(n, repeat_destination_order(head_routine, head_constraints, starts, lazy), repeat_destinations(rest, starts, lazy), Active(state, append_routine(routine, start_routine), append_constraints(constraints, start_constraints)), lift_repeat_destinations_reentry_member(n, rest, starts, lazy, routine, constraints, prior, state, start_routine, start_constraints, start_edge))

  ## Path constructors consume already-filtered child edges.  Recover the raw
  ## boundary constraints once here and feed them to the canonical Repeat
  ## transformation lemmas above, keeping path assembly independent of the
  ## representation of `filter_machine_states`.
  fn lift_repeat_filtered_active_transition_member(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, routine, constraints), filter_machine_states(n, destinations, boundary))) -> ListMember(MachineState(n), Active(state, routine, Nil()), filter_machine_states(n, repeat_destinations(destinations, starts, lazy), boundary)) = match filtered_state_origin(n, destinations, boundary, Active(state, routine, constraints), edge)
    FilteredActiveStateOrigin(_, raw_routine, raw_constraints, raw_edge, holds) -> lift_repeat_active_transition_member(n, destinations, starts, lazy, boundary, state, raw_routine, raw_constraints, raw_edge, holds)

  fn lift_repeat_initial_active_member(n: Nat, starts: List(MachineState(n)), lazy: Bool, boundary: Boundary, state: Bounded(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), edge: ListMember(MachineState(n), Active(state, routine, constraints), starts), holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> ListMember(MachineState(n), Active(state, Cons(BeginList(), routine), Nil()), filter_machine_states(n, repeat_machine_starts(starts, lazy), boundary)) =
    filter_active_member(n, repeat_machine_starts(starts, lazy), boundary, state, Cons(BeginList(), routine), constraints, lift_repeat_start_active_member(n, starts, lazy, state, routine, constraints, edge), holds)

  fn filtered_append_active_true_origin(n: Nat, state: Bounded(n), routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Active(state, routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Active(state, routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_accepted_true_origin(n: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, Cons(Accepted(routine, Nil()), filter_machine_states(n, append_machine_states(n, rest, right), boundary)))) -> FilteredAppendMemberOrigin(n, Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value) = match edge
    ListMemberHere() -> filtered_append_member_left(Cons(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)), filter_machine_states(n, right, boundary), value, member_here(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_append_member(Accepted(routine, Nil()), filter_machine_states(n, rest, boundary), filter_machine_states(n, right, boundary), value, filtered_append_member_origin(n, rest, right, boundary, value, prior))

  fn filtered_append_member_origin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary))) -> FilteredAppendMemberOrigin(n, filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value) = match left
    Nil() -> filtered_append_member_right(filter_machine_states(n, left, boundary), filter_machine_states(n, right, boundary), value, edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_active_true_origin(n, state, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_append_accepted_true_origin(n, routine, rest, right, boundary, value, edge)
      False() -> filtered_append_member_origin(n, rest, right, boundary, value, edge)

  fn filtered_left_active_true_origin(left_count: Nat, right_count: Nat, state: Bounded(left_count), routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Active(inject_alternate_left(left_count, right_count, state), routine, Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_active_origin(left_count, right_count, marker, Cons(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)), state, routine, member_here(Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Active(state, routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_left_accepted_true_origin(left_count: Nat, right_count: Nat, routine: List(EvidenceInstruction), rest: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, Cons(Accepted(append_branch_marker(routine, marker), Nil()), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, rest, marker), boundary)))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), combined) = match edge
    ListMemberHere() -> filtered_left_accepted_origin(left_count, right_count, marker, Cons(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)), routine, member_here(Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary)))
    ListMemberThere(prior) -> prepend_filtered_left_origin(left_count, right_count, marker, Accepted(routine, Nil()), filter_machine_states(left_count, rest, boundary), combined, filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, prior))

  fn filtered_left_marked_state_origin(left_count: Nat, right_count: Nat, states: List(MachineState(left_count)), marker: EvidenceInstruction, boundary: Boundary, combined: MachineState(plus(left_count, right_count)), edge: ListMember(MachineState(plus(left_count, right_count)), combined, filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, states, marker), boundary))) -> FilteredLeftMarkedStateOrigin(left_count, right_count, marker, filter_machine_states(left_count, states, boundary), combined) = match states
    Nil() -> impossible_list_member(edge)
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_active_true_origin(left_count, right_count, state, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> filtered_left_accepted_true_origin(left_count, right_count, routine, rest, marker, boundary, combined, edge)
      False() -> filtered_left_marked_state_origin(left_count, right_count, rest, marker, boundary, combined, edge)

  fn lift_alternate_left_active_path(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence), child_routine: List(ExtendedInstruction), path: AcceptingFrom(left_count, left_machine, input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> AlternateLeftActivePathEmbedding(left_count, left_machine, right_count, right_machine, prefer_right, input, after_input, source, current_evidence, current_captures, child_final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> impossible
      AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
      AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible
    Cons(char, rest) -> match left_machine
      MkPatternMachine(left_starts, left_next) -> match right_machine
        MkPatternMachine(right_starts, right_next) -> match path
          AcceptingNow() -> impossible
          AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match lift_alternate_left_active_path(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right, rest, after_input, destination, destination_evidence, destination_captures, child_final_evidence, suffix_routine, suffix)
            mk_pair(combined_suffix_routine, combined_suffix) ->
              let origin = filtered_state_origin(left_count, left_next(source, char), transition_boundary_before(char, rest, after_input), Active(destination, regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_left_active_edge(left_count, right_count, left_next(source, char), EmitLeft(), transition_boundary_before(char, rest, after_input), destination, regular, constraints, edge, origin)
              let combined_edge = alternate_left_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Active(inject_alternate_left(left_count, right_count, destination), regular, Nil()), filtered_combined_edge)
              let combined_routine = append_extended_routines(transition_routine(char, regular), combined_suffix_routine)
              %[combined_routine, AcceptingNextActive(inject_alternate_left(left_count, right_count, destination), regular, empty_constraints(), destination_evidence, destination_captures, combined_suffix_routine, combined_edge, execution, combined_suffix)]
          AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match suffix
            AcceptingNow() ->
              let marker_execution: RoutineExecution(Cons(EmitLeft(), Nil()), destination_evidence, destination_captures, Cons(LeftEvidence(), destination_evidence), destination_captures) = RoutineStep(EmitLeft(), RoutineDone())
              let combined_execution = append_routine_execution(regular, Cons(EmitLeft(), Nil()), current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures, Cons(LeftEvidence(), destination_evidence), destination_captures, execution, marker_execution)
              let origin = filtered_state_origin(left_count, left_next(source, char), transition_boundary_before(char, rest, after_input), Accepted(regular, constraints), edge)
              let filtered_combined_edge = lift_alternate_left_accepted_edge(left_count, right_count, left_next(source, char), EmitLeft(), transition_boundary_before(char, rest, after_input), regular, constraints, edge, origin)
              let combined_edge = alternate_left_transition_member(left_count, left_starts, left_next, right_count, right_starts, right_next, prefer_right, source, char, transition_boundary_before(char, rest, after_input), Accepted(append_branch_marker(regular, EmitLeft()), Nil()), filtered_combined_edge)
              let no_extended: List(ExtendedInstruction) = Nil()
              let combined_routine = append_extended_routines(transition_routine(char, append_branch_marker(regular, EmitLeft())), no_extended)
              %[combined_routine, AcceptingNextAccepted(append_branch_marker(regular, EmitLeft()), empty_constraints(), Cons(LeftEvidence(), destination_evidence), destination_captures, no_extended, combined_edge, combined_execution, AcceptingNow())]
            AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
            AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible

  fn lift_concat_acceptances(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, left_input: List(Char), right_input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), left_final_evidence: List(Evidence), left_acceptance: AcceptancePathFrom(left_count, left_machine, position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, left_final_evidence), right_final_evidence: List(Evidence), right_acceptance: AcceptancePathFrom(right_count, right_machine, advance_initial_position(position, left_input), right_input, after_input, left_final_evidence, acceptance_path_final_captures(left_count, left_machine, position, left_input, append_characters(right_input, after_input), input_evidence, input_captures, left_final_evidence, left_acceptance), right_final_evidence)) -> AcceptancePathFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), position, append_characters(left_input, right_input), after_input, input_evidence, input_captures, Cons(PairEvidence(), right_final_evidence)) = match right_machine
    MkPatternMachine(right_starts, right_next) -> lift_concat_acceptances_with_right(left_count, left_machine, right_count, right_starts, right_next, position, left_input, right_input, after_input, input_evidence, input_captures, left_final_evidence, left_acceptance, right_final_evidence, right_acceptance)

