@group(:text)
mod Std.Regex.Runtime.PatternMachines
  use Std.Regex.Runtime.StateOps


  use Std.Regex.Runtime.TransitionRows

  use Std.Regex.Runtime.CaptureConditions

  use Std.Regex.Runtime.Boundaries

  use Std.Regex.Runtime.AtomicDiagnostics

  use Std.Regex.Runtime.ClassKinds

  use Std.Regex.Runtime.Named

  use Std.Regex.Runtime.Split

  use Std.Regex.Core.Capture

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Char

  use Std.Option

  use Std.List

  use Std.String

  use Std.Syntax

  use Std.Bounded

  use Std.Equivalent

  use Std.Sigma

  use Std.Decision

  @reducible
  fn predicate_machine_destinations(holds: Bool, char: Char) -> List(MachineState(S(Z()))) = match holds
    False() -> []
    True() -> [Accepted([EmitChar(char)], [])]

  @reducible
  fn predicate_machine_next(test: Char -> Bool, _state: Bounded(S(Z())), char: Char) -> List(MachineState(S(Z()))) =
    predicate_machine_destinations(test(char), char)

  @reducible
  fn empty_machine_next({n: Nat}, _state: Bounded(n), _char: Char) -> List(MachineState(n)) = []

  @reducible
  fn group_machine_next_with({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), end_instruction: EvidenceInstruction, state: Bounded(n), char: Char) -> List(MachineState(n)) =
    match next(state, char)
      [] -> []
      [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [end_instruction]), constraints) | finish_capture_with(end_instruction, rest)]
      [Active(active, routine, constraints) | rest] -> [Active(active, routine, constraints) | finish_capture_with(end_instruction, rest)]

  @reducible
  fn group_machine_next({n: Nat}, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    group_machine_next_with(next, EndCapture(), state, char)

  ## Atomic scopes preserve every ordinary machine state, but mark entry and
  ## every accepting exit in the routine stream.  The ordered search consumes
  ## these markers to discard lower-priority siblings after the first exit;
  ## transition construction itself remains the same finite Thompson machine.
  @reducible
  fn atomic_start_states({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> [Active(state, [BeginAtomic() | routine], constraints) | atomic_start_states(rest)]
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine([BeginAtomic()], append_routine(routine, [EndAtomic()])), constraints) | atomic_start_states(rest)]

  @reducible
  fn atomic_destination_states({n: Nat}, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, constraints) | atomic_destination_states(rest)]
    [Accepted(routine, constraints) | rest] -> [Accepted(append_routine(routine, [EndAtomic()]), constraints) | atomic_destination_states(rest)]

  @reducible
  fn atomic_pattern_machine({n: Nat}, machine: PatternMachine(n)) -> PatternMachine(n) = match machine
    MkPatternMachine(starts, next) -> MkPatternMachine(
      atomic_start_states(starts),
      fn(state) -> fn(char) -> atomic_destination_states(next(state, char))
    )

  @reducible
  fn concat_machine_next_from_side(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), side: BoundedSum(left_count, right_count), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    match side
      BoundedLeft(left_state) -> continue_with_right(left_count, left_next(left_state, char), right_starts)
      BoundedRight(right_state) -> inject_right_states(left_count, finish_pair(right_next(right_state, char)))

  @reducible
  fn concat_machine_next(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    concat_machine_next_from_side(left_count, left_next, right_starts, right_next, split_sum(left_count, state), char)

  @reducible
  fn alternate_machine_next_from_side(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), side: BoundedSum(left_count, right_count), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    match side
      BoundedLeft(left_state) -> inject_left_states(mark_branch(left_next(left_state, char), EmitLeft()))
      BoundedRight(right_state) -> inject_right_states(left_count, mark_branch(right_next(right_state, char), EmitRight()))

  @reducible
  fn alternate_machine_next(left_count: Nat, {right_count: Nat}, left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), state: Bounded(plus(left_count, right_count)), char: Char) -> List(MachineState(plus(left_count, right_count))) =
    alternate_machine_next_from_side(left_count, left_next, right_next, split_sum(left_count, state), char)

  @reducible
  fn alternate_starts_order({n: Nat}, left: List(MachineState(n)), right: List(MachineState(n)), prefer_right: Bool) -> List(MachineState(n)) = match prefer_right
    True() -> append_states(right, left)
    False() -> append_states(left, right)

  @reducible
  fn alternate_machine_starts(left_count: Nat, {right_count: Nat}, left_starts: List(MachineState(left_count)), right_starts: List(MachineState(right_count)), prefer_right: Bool) -> List(MachineState(plus(left_count, right_count))) =
    let marked_left: List(MachineState(plus(left_count, right_count))) = inject_left_states(mark_branch(left_starts, EmitLeft()))
    let marked_right: List(MachineState(plus(left_count, right_count))) = inject_right_states(left_count, mark_branch(right_starts, EmitRight()))
    alternate_starts_order(marked_left, marked_right, prefer_right)

  @reducible
  fn alternate_pattern_machine(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool) -> PatternMachine(plus(left_count, right_count)) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        MkPatternMachine(
          alternate_machine_starts(left_count, left_starts, right_starts, prefer_right),
          alternate_machine_next(left_count, left_next, right_next)
        )

  @reducible
  fn repeat_machine_starts({n: Nat}, starts: List(MachineState(n)), lazy: Bool) -> List(MachineState(n)) =
    let empty: List(MachineState(n)) = [Accepted([BeginList(), EndList()], [])]
    let consuming: List(MachineState(n)) = enter_repeat([BeginList()], starts)
    pickup
      lazy -> append_states(empty, consuming)
      else -> append_states(consuming, empty)

  @reducible
  fn repeat_machine_next({n: Nat}, starts: List(MachineState(n)), lazy: Bool, next: (Bounded(n)) -> Char -> List(MachineState(n)), state: Bounded(n), char: Char) -> List(MachineState(n)) =
    repeat_destinations(next(state, char), starts, lazy)

  @reducible
  fn empty_pattern_machine() -> PatternMachine(Z()) =
    let starts: List(MachineState(Z())) = [Accepted([EmitUnit()], [])]
    MkPatternMachine(starts, empty_machine_next)

  @reducible
  fn boundary_pattern_machine(constraint: BoundaryConstraint) -> PatternMachine(Z()) =
    let routine: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
    let constraints: List(BoundaryConstraint) = Cons(constraint, Nil())
    let starts: List(MachineState(Z())) = Cons(Accepted(routine, constraints), Nil())
    MkPatternMachine(starts, empty_machine_next)

  @reducible
  fn capture_condition_constraint(slot: Nat, participated: Bool) -> BoundaryConstraint = pickup
    participated -> capture_participated_constraint(slot)
    else -> capture_absent_constraint(slot)

  @reducible
  fn guard_states({n: Nat}, constraint: BoundaryConstraint, states: List(MachineState(n))) -> List(MachineState(n)) = match states
    [] -> []
    [Active(state, routine, constraints) | rest] -> [Active(state, routine, append_constraints([constraint], constraints)) | guard_states(constraint, rest)]
    [Accepted(routine, constraints) | rest] -> [Accepted(routine, append_constraints([constraint], constraints)) | guard_states(constraint, rest)]

  @reducible
  fn guard_pattern_machine({n: Nat}, constraint: BoundaryConstraint, machine: PatternMachine(n)) -> PatternMachine(n) = match machine
    MkPatternMachine(starts, next) -> MkPatternMachine(guard_states(constraint, starts), next)

  @reducible
  fn predicate_machine_start() -> MachineState(S(Z())) =
    let routine: List(EvidenceInstruction) = []
    let constraints: List(BoundaryConstraint) = []
    Active(First(), routine, constraints)

  @reducible
  fn predicate_machine_thread() -> ThreadState(S(Z())) = ThreadActive(First())

  @reducible
  fn predicate_accepting_destination(char: Char) -> MachineState(S(Z())) =
    let routine: List(EvidenceInstruction) = [EmitChar(char)]
    let constraints: List(BoundaryConstraint) = []
    Accepted(routine, constraints)

  @reducible
  fn predicate_pattern_machine(test: Char -> Bool) -> PatternMachine(S(Z())) =
    let starts: List(MachineState(S(Z()))) = [predicate_machine_start()]
    MkPatternMachine(starts, predicate_machine_next(test))

  @reducible
  fn group_pattern_machine(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n))) -> PatternMachine(n) =
    MkPatternMachine(
      finish_capture(prefix_routine(BeginCapture(), starts)),
      group_machine_next(next)
    )

  @reducible
  fn group_pattern_machine_with_slot(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), slot: Nat) -> PatternMachine(n) =
    MkPatternMachine(
      finish_capture_with(EndCaptureSlot(slot), prefix_routine(BeginCaptureSlot(slot), starts)),
      group_machine_next_with(next, EndCaptureSlot(slot))
    )

  @reducible
  fn concat_pattern_machine(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count)) -> PatternMachine(plus(left_count, right_count)) = match left_machine
    MkPatternMachine(left_starts, left_next) -> match right_machine
      MkPatternMachine(right_starts, right_next) ->
        MkPatternMachine(
          continue_with_right(left_count, left_starts, right_starts),
          concat_machine_next(left_count, left_next, right_starts, right_next)
        )

  @reducible
  fn repeat_pattern_machine(n: Nat, machine: PatternMachine(n), lazy: Bool) -> PatternMachine(n) = match machine
    MkPatternMachine(starts, next) ->
      MkPatternMachine(
        repeat_machine_starts(starts, lazy),
        repeat_machine_next(starts, lazy, next)
      )
end
