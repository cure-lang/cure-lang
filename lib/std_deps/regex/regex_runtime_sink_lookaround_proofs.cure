  ## Recover the ordered front-to-current cursor solely from the relevant
  ## skipped-prefix structure. Each erased evidence match has one constructor
  ## fixed by the already-selected relevant branch; erased fields affect only
  ## indices and never runtime control.
  @reducible
  fn atomic_path_skipped_prefix_structure_cursor_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased front: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased kind: AtomicPathSkippedPrefixKind},
    structure: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, input, after_input, state, history, capture_context,
      policy, scope_depth, prefix_mode, reversed_prefix, whole, front,
      current, kind
    )
  ) -> LookaroundAdmittedStateCursorSuffixPackage(n, front, current) = match structure
    AtomicPathSkippedPrefixStructureEmptyPacked(evidence) -> match evidence
      AtomicPathSkippedPrefixEmpty() ->
        lookaround_admitted_cursor_suffix_package_here(reflexive(current))
    AtomicPathSkippedPrefixStructureEscapedOnePacked(evidence) -> match evidence
      AtomicPathEscapedCommitOne(_, _, _, candidate, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        lookaround_admitted_cursor_suffix_package_drop(
          candidate,
          lookaround_admitted_cursor_suffix_package_here(reflexive(current))
        )
    AtomicPathSkippedPrefixStructureEscapedConsPacked(evidence, tail_structure) -> match evidence
      AtomicPathEscapedCommitCons(_, _, _, candidate, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        lookaround_admitted_cursor_suffix_package_drop(
          candidate,
          atomic_path_skipped_prefix_structure_cursor_package(tail_structure)
        )
    AtomicPathSkippedPrefixStructureRejectedConsPacked(evidence, tail_structure, _) -> match evidence
      AtomicPathSkippedRejectedCons(_, _, _, candidate, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) ->
        lookaround_admitted_cursor_suffix_package_drop(
          candidate,
          atomic_path_skipped_prefix_structure_cursor_package(tail_structure)
        )

