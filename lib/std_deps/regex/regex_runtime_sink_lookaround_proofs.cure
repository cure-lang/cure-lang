  ## Explicit-arity form for dependent constructor telescopes, where the
  ## hidden `n` cannot always be recovered before every later field is known.
  @reducible
  fn lookaround_admitted_state_thread_at(n: Nat, state: LookaroundAdmittedState(n)) -> ThreadState(n) = match state
    LookaroundAdmittedActive(destination, _, _, _, _, _) -> ThreadActive(destination)
    LookaroundAdmittedAccepted(_, _, _, _, _) -> ThreadAccepted()

  ## A rejected destination publishes a recursive sibling-tail refutation.  The
  ## package keeps that existential failure kind behind an indexed proof-only
  ## boundary, so consumers can refine the tail at its construction site
  ## without inspecting an erased failure tag at runtime.
  type AtomicPathTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), current: List(LookaroundAdmittedState(n)))
    AtomicPathTailPackagePacked : {@erased kind: AtomicPathFailureKind} -> (@erased failure: AtomicPathRefutation(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, kind)) -> AtomicPathTailPackage(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current)

  ## Transport a selected trace across one rejected sibling boundary.  The
  ## tail membership is relevant at this construction site; the resulting
  ## package is erased and records that its current spine is exactly the
  ## recursive tail rather than the parent `Cons(head, tail)` list.
  @reducible
  fn atomic_selected_start_witness_tail(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {tail_rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    tail_membership: ListMember(LookaroundAdmittedState(n), selected_start, tail_rest),
    {blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    @erased allowed: AtomicStartAllowed(blocked_depth, kind),
    @erased scope: AtomicStartScopeEvidence(n, AtomicStartScopeEvidenceAllowedRole()),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      routine
    )
  ) -> AtomicSelectedStartWitness(
    depth,
    n,
    machine,
    position,
    input,
    after_input,
    history,
    capture_context,
    policy,
    prefix_mode,
    reversed_prefix,
    whole,
    tail_rest,
    selected_start,
    blocked_depth,
    kind,
    matched,
    remaining_input,
    routine
  ) = AtomicSelectedStartWitnessPacked(whole, tail_rest, allowed, scope, tail_membership, path)

  fn lookaround_nested_decisions(depth: Nat, constraints: List(BoundaryConstraint), boundary: Boundary, remaining: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(LookaroundNestedDecision) = match lookaround_constraints_admission(depth, constraints, boundary, remaining, history, capture_context, policy)
    None() -> []
    Some(LookaroundConstraintAdmitted(_, _, decisions)) -> decisions

  fn lookaround_prefix_filtered_starts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> List(MachineState(n)) = match machine
    MkPatternMachine(starts, _) -> lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy)

  ## Proof-only counterpart of the package-carrying induction boundary.  The
  ## recursive branch deliberately invokes a zero-argument continuation: the
  ## caller closes over the typed tail package and membership instead of
  ## passing erased witnesses as runtime callback arguments (which E104
  ## rejects).  This is the continuation shape used by the non-empty `There`
  ## proof; it adds no runtime branch or proof payload.
  @reducible
  fn atomic_start_rejected_member_induction_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureRejected()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    head_case: result,
    tail_case: () -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(_) -> match _evidence
      AtomicStartNoRejectedEvidence(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> tail_case()

  ## Blocked counterpart of the proof-only induction boundary.  A blocked
  ## candidate carries a skip/allow commitment rather than a rejected-child
  ## tail package, so its evidence index has its own constructor.  The
  ## continuation remains zero-argument for the same erased-witness reason.
  @reducible
  fn atomic_start_blocked_member_induction_erased(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {@erased head: LookaroundAdmittedState(n)},
    {@erased rest: List(LookaroundAdmittedState(n))},
    {@erased selected_start: LookaroundAdmittedState(n)},
    @erased _failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    @erased _evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, rest),
      AtomicStartFailureBlocked()
    ),
    membership: ListMember(LookaroundAdmittedState(n), selected_start, Cons(head, rest)),
    head_case: result,
    tail_case: () -> result
  ) -> result = match membership
    ListMemberHere() -> head_case
    ListMemberThere(_) -> match _evidence
      AtomicStartNoBlockedEvidence(_, _, _, _, _, _) -> tail_case()

  ## Turn intrinsic list membership into the ordered cursor suffix consumed by
  ## the atomic refutation induction.  Membership alone does not expose the
  ## suffix list; this Sigma packages that suffix together with the proof that
  ## it is reached only by dropping the preceding ordered heads.
  fn lookaround_admitted_cursor_suffix_here({n: Nat}, value: LookaroundAdmittedState(n), rest: List(LookaroundAdmittedState(n))) -> Sigma(values: List(LookaroundAdmittedState(n)), LookaroundAdmittedStateCursorSuffix(n, Cons(value, rest), values)) =
    %[Cons(value, rest), LookaroundAdmittedStateCursorSuffixHere(reflexive(Cons(value, rest)))]

  ## Package the child evidence carried by an active selected transition at the
  ## construction site.  The selected whole/current lists are deliberately
  ## constructor-local existentials: consumers must refine this package to
  ## obtain them, rather than identifying either list with a caller-owned
  ## cursor by assumption.
  type AtomicPathActiveChildSelectionPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (input: List(Char), after_input: List(Char), state: ThreadState(n), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, scope_depth: Nat, prefix_mode: Bool, reversed_prefix: List(Char), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicPathActiveChildSelectionPackageActive : (@erased source: Bounded(n)) -> (@erased char: Char) -> (@erased rest: List(Char)) -> (@erased destination: Bounded(n)) -> (@erased routine: List(EvidenceInstruction)) -> (@erased constraints: List(BoundaryConstraint)) -> (@erased assertion_routine: List(ExtendedInstruction)) -> (@erased assertion_markers: List(EvidenceInstruction)) -> (@erased nested_decisions: List(LookaroundNestedDecision)) -> (@erased child_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole: List(LookaroundAdmittedState(n))) -> (@erased child_selected_whole_equivalence: Equivalent(List(LookaroundAdmittedState(n)), child_whole, child_selected_whole)) -> (@erased child_origin_canonical: AtomicPathSearchOrigin(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, child_whole)) -> (@erased child_current: List(LookaroundAdmittedState(n))) -> (@erased child_selection_suffix: LookaroundAdmittedStateCursorSuffix(n, child_selected_whole, child_current)) -> (@erased child_selection_from_origin: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current)) -> (@erased child_skipped_kind: AtomicPathSkippedPrefixKind) -> (@erased child_skipped_evidence: AtomicPathSkippedPrefixEvidence(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_whole, child_whole, child_current, child_skipped_kind)) -> (@erased child_trace: AtomicSelectedPathTrace(depth, n, machine, rest, after_input, ThreadActive(destination), history_push_bounded(history, char), lookaround_admitted_active_capture_context(capture_context, routine, assertion_markers), policy, atomic_scope_depth_after(routine, scope_depth), prefix_mode, Cons(char, reversed_prefix), child_current, matched, remaining_input, suffix_routine)) -> (@erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(destination, routine, constraints, assertion_routine, assertion_markers, nested_decisions), remaining), matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))) -> AtomicPathActiveChildSelectionPackage(depth, n, machine, Cons(char, rest), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, matched, remaining_input, append_extended_routines(transition_routine(char, routine), append_extended_routines(assertion_routine, suffix_routine)))

  ## Selected-trace counterpart of the blocked-member induction. The blocked
  ## head's skip/allow evidence is threaded through the recursive tail package
  ## together with the inherited membership predecessor and selected path.
  type AtomicStartBlockedSelectedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_start: LookaroundAdmittedState(n), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicStartBlockedSelectedTailPackagePacked : {@erased tail_kind: AtomicStartFailureKind} -> (@erased tail_failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> (@erased tail_evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, tail_kind)) -> {@erased blocked_depth: Option(Nat)} -> {@erased skip_kind: AtomicStartSkipKind} -> (@erased skip: AtomicStartSkipEvidence(blocked_depth, skip_kind)) -> (@erased allowed: AtomicStartAllowed(blocked_depth, skip_kind)) -> (@erased membership: ListMember(LookaroundAdmittedState(n), selected_start, remaining)) -> (@erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)) -> AtomicStartBlockedSelectedTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, selected_start, matched, remaining_input, selected_routine)

  type AtomicStartTailEvidence(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)))
    AtomicStartTailEvidencePacked : {@erased kind: AtomicStartFailureKind} -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> AtomicStartTailEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)

  ## A selected-tail package retains the inherited membership and trace while
  ## the rejected start fold moves past one sibling.  The recursive failure
  ## kind stays existential, exactly as in `AtomicStartTailPackage`; the
  ## selected membership is the additional evidence that lets the next
  ## construction site continue the same selected-start contradiction rather
  ## than falling back to a zero-argument assumption.
  type AtomicStartSelectedTailPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_start: LookaroundAdmittedState(n), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicStartSelectedTailPackagePacked : {@erased kind: AtomicStartFailureKind} -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased membership: ListMember(LookaroundAdmittedState(n), selected_start, remaining)) -> (@erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)) -> AtomicStartSelectedTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, selected_start, matched, remaining_input, selected_routine)

  type AtomicStartSelectedTailTracePackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), selected_start: LookaroundAdmittedState(n), matched: List(Char), remaining_input: List(Char), selected_routine: List(ExtendedInstruction))
    AtomicStartSelectedTailTracePacked : {@erased kind: AtomicStartFailureKind} -> (@erased failure: AtomicStartMembersRefutation(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased evidence: AtomicStartNoEvidence(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, kind)) -> (@erased membership: ListMember(LookaroundAdmittedState(n), selected_start, remaining)) -> {@erased path: AtomicSelectedTrace(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine)} -> (trace_package: AtomicSelectedTracePackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, selected_start, matched, remaining_input, selected_routine, path)) -> AtomicStartSelectedTailTracePackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining, selected_start, matched, remaining_input, selected_routine)

  typealias AtomicStartRejectedTailAt(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n))) = AtomicStartTailPackage(depth, n, machine, position, input, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)

  ## The active child certificate is factored out so interface registration
  ## sees its dependent scope index as a complete constructor boundary.
  type AtomicStartActiveChildFailure(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), child_scope_depth: Nat)
    AtomicStartActiveChildFailurePacked : (@erased failure: AtomicPathRootRefutation(depth, n, machine, Nil(), after_input, thread_state, history, capture_context, policy, child_scope_depth, prefix_mode, reversed_prefix, Nil(), AtomicPathFailureInputExhausted())) -> AtomicStartActiveChildFailure(depth, n, machine, after_input, history, capture_context, policy, prefix_mode, reversed_prefix, thread_state, child_scope_depth)

  ## The construction-site proof package keeps the parent and child capture
  ## contexts separate.  The parent context is used by the rejected start
  ## evidence and tail package; the child context is the exact context after
  ## the active candidate's regular routine and assertion markers.  Keeping
  ## both in the indices prevents a later proof consumer from silently
  ## substituting one VM context for the other.
  type AtomicStartActiveRootTailProofPackage(depth: Nat, n: Nat, machine: PatternMachine(n)) indices (position: InitialPosition, parent_capture_context: List(EvidenceInstruction), child_capture_context: List(EvidenceInstruction), after_input: List(Char), history: List(Char), policy: NewlinePolicy, prefix_mode: Bool, reversed_prefix: List(Char), thread_state: ThreadState(n), routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), assertion_routine: List(ExtendedInstruction), assertion_markers: List(EvidenceInstruction), nested_decisions: List(LookaroundNestedDecision), whole: List(LookaroundAdmittedState(n)), remaining: List(LookaroundAdmittedState(n)), child_scope_depth: Nat)
    AtomicStartActiveRootTailProofPackagePacked : (@erased tail: AtomicStartTailPackage(depth, n, machine, position, Nil(), after_input, history, parent_capture_context, policy, prefix_mode, reversed_prefix, whole, remaining)) -> (@erased child_failure: AtomicPathRefutation(depth, n, machine, Nil(), after_input, thread_state, history, child_capture_context, policy, child_scope_depth, prefix_mode, reversed_prefix, Nil(), Nil(), AtomicPathFailureInputExhausted())) -> AtomicStartActiveRootTailProofPackage(depth, n, machine, position, parent_capture_context, child_capture_context, after_input, history, policy, prefix_mode, reversed_prefix, thread_state, routine, constraints, assertion_routine, assertion_markers, nested_decisions, whole, remaining, child_scope_depth)

  fn atomic_start_rejected_tail_package(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    {whole: List(LookaroundAdmittedState(n))},
    {candidate: LookaroundAdmittedState(n)},
    {remaining: List(LookaroundAdmittedState(n))},
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      input,
      after_input,
      history,
      capture_context,
      policy,
      prefix_mode,
      reversed_prefix,
      whole,
