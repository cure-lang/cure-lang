    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, selected_current, matched, remaining_input,
      selected_routine
    )},
    {selected_skipped_package: Type},
    package: AtomicPathCommitSelectedLocationPackage(
      n,
      AtomicPathCommitStructureExistentialPackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, whole,
        Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
        commit_depth,
        AtomicPathCommitAfterFailureKind(AtomicPathFailureAtRootKind(), AtomicPathFailureDestinationsExhausted())
      ),
      LookaroundAdmittedStateCursorSuffixPackage(
        n,
        whole,
        Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining)
      ),
      AtomicSelectedPathTracePackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, selected_current, matched,
        remaining_input, selected_routine, path
      ),
      selected_skipped_package,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining),
      selected_current
