  ## Recursive escaped-head consumer. The relevant outer EscapedCons exposes
  ## its selected tail, and the paired commit projection exposes the matching
  ## commit tail before the two-way tail fold selects Same or RightAfter.
  @reducible
  fn atomic_path_commit_past_escaped_selected_tail_location_fold(
    {result: Type}, {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), commit_depth,
      AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind)
    ),
    commit_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, whole, Cons(candidate, remaining)
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      AtomicPathSkippedPrefixEscapedConsKind(
        child_commit_kind, tail_skipped_kind
      )
    ),
    same_case: (AtomicPathRecursiveCommitSelectedSamePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedRightPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result
  ) -> result = match selected_skipped
    AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
      atomic_path_commit_selected_tail_location_fold(
        atomic_path_commit_structure_past_escaped_tail_package(
          commit,
          commit_cursor
        ),
        selected_trace,
        tail_structure,
        same_case,
        right_case
      )

  ## Recursive rejected-head consumer. The shared child prefix/failure
  ## indices identify the same skipped candidate before its commit and
  ## selected tails enter the two-way recursive location fold.
  @reducible
  fn atomic_path_commit_past_rejected_selected_tail_location_fold(
    {result: Type}, {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_skipped_kind: AtomicPathSkippedPrefixKind},
    commit: AtomicPathCommitStructureExistentialPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), commit_depth,
      AtomicPathCommitPastRejectedKind(
        child_prefix_kind, child_kind, tail_commit_kind
      )
    ),
    commit_cursor: LookaroundAdmittedStateCursorSuffixPackage(
      n, whole, Cons(candidate, remaining)
    ),
    selected_trace: selected_trace_package,
    selected_skipped: AtomicPathSkippedPrefixStructurePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      AtomicPathSkippedPrefixRejectedConsKind(
        child_prefix_kind, child_kind, tail_skipped_kind
      )
    ),
    same_case: (AtomicPathRecursiveCommitSelectedSamePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedRightPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result
  ) -> result = match selected_skipped
    AtomicPathSkippedPrefixStructureRejectedConsPacked(_, tail_structure, _) ->
      atomic_path_commit_selected_tail_location_fold(
        atomic_path_commit_structure_past_rejected_tail_package(
          commit,
          commit_cursor
        ),
        selected_trace,
        tail_structure,
        same_case,
        right_case
      )

  ## Same-cursor root-destination terminal. Select both relevant packages
  ## before consuming the erased cursor equality, then reuse the exact
  ## structure/trace contradiction.
  @reducible
  fn atomic_path_recursive_commit_after_root_destinations_exhausted_same_excludes_selected_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased active_state: Bounded(n)},
    {@erased active_routine: List(EvidenceInstruction)},
    {@erased active_constraints: List(BoundaryConstraint)},
    {@erased active_assertion_routine: List(ExtendedInstruction)},
    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    {@erased path: AtomicSelectedPathTrace(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, selected_current, matched, remaining_input,
      selected_routine
    )},
    package: AtomicPathRecursiveCommitSelectedSamePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole,
      Cons(LookaroundAdmittedActive(
        active_state, active_routine, active_constraints,
        active_assertion_routine, active_assertion_markers,
        active_nested_decisions
      ), remaining),
      selected_current,
      commit_depth,
      AtomicPathCommitAfterFailureKind(
        AtomicPathFailureAtRootKind(),
        AtomicPathFailureDestinationsExhausted()
      ),
      AtomicSelectedPathTracePackage(
        depth, n, machine, Cons(char, rest), after_input,
        ThreadActive(source), history, capture_context, policy, scope_depth,
        prefix_mode, reversed_prefix, selected_current, matched,
        remaining_input, selected_routine, path
      ),
      AtomicPathSkippedPrefixEmptyKind()
    )
  ) -> Empty = match package
    AtomicPathCommitSelectedSameAuthorityPacked(commit_package, _, trace_package, _, equality) -> match commit_package
      AtomicPathCommitStructureCursorExistentialPacked(_, _, structure) -> match equality
        reflexive() -> atomic_path_commit_after_root_destinations_exhausted_excludes_aligned_selected_package(
          structure,
          trace_package
        )

  ## Propagated escaped RightAfter branch. The right-authority fixes the outer
  ## direction, then the paired relevant structures produce the next
  ## one-constructor Same/Right authority.
  @reducible
  fn atomic_path_recursive_commit_past_escaped_right_selected_tail_location_fold(
    {result: Type}, {selected_trace_package: Type},
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased rest: List(Char)},
    {@erased after_input: List(Char)}, {@erased source: Bounded(n)},
    {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased candidate: LookaroundAdmittedState(n)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased selected_current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_commit_kind: AtomicPathCommitCauseKind},
    {@erased tail_skipped_kind: AtomicPathSkippedPrefixKind},
    package: AtomicPathRecursiveCommitSelectedRightPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, Cons(candidate, remaining), selected_current,
      commit_depth,
      AtomicPathCommitPastEscapedKind(child_commit_kind, tail_commit_kind),
      selected_trace_package,
      AtomicPathSkippedPrefixEscapedConsKind(
        child_commit_kind, tail_skipped_kind
      )
    ),
    same_case: (AtomicPathRecursiveCommitSelectedSamePackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result,
    right_case: (AtomicPathRecursiveCommitSelectedRightPackage(
      depth, n, machine, Cons(char, rest), after_input, ThreadActive(source),
      history, capture_context, policy, scope_depth, prefix_mode,
      reversed_prefix, whole, remaining, selected_current, commit_depth,
      tail_commit_kind, selected_trace_package, tail_skipped_kind
    )) -> result
  ) -> result = match package
    AtomicPathCommitSelectedRightAuthorityPacked(commit_package, _, selected_trace, selected_skipped, _) -> match selected_skipped
      AtomicPathSkippedPrefixStructureEscapedConsPacked(_, tail_structure) ->
        atomic_path_commit_selected_tail_location_fold(
          atomic_path_commit_structure_cursor_past_escaped_tail_package(
            commit_package
          ),
          selected_trace,
          tail_structure,
          same_case,
          right_case
        )

  ## Propagated rejected RightAfter branch, indexed by the same child failure
