  ## A sibling tail may reject an active candidate after that candidate's child
  ## runs out of input.  At this construction site the selected parent trace
  ## exposes an active transition, so the existing aligned-child eliminator
  ## consumes the exhausted child trace without inspecting any erased cursor
  ## payload at runtime.  This is the active-child counterpart of the accepted
  ## tail theorem above.
  fn atomic_path_tail_active_child_exhaustion_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased head: LookaroundAdmittedState(n)},
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    {@erased tail_remaining: List(LookaroundAdmittedState(n))},
    @erased _failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(head, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining)),
      AtomicPathFailureDestinationRejected()
    ),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {@erased selected_remaining: List(LookaroundAdmittedState(n))},
    @erased _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Nil()),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    )
  ) -> Empty = match tail_failure
    AtomicPathDestinationRejected(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_failure, child_suffix, child_scope_alignment, _, _, _, _) -> match path
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_selection_suffix, _, _, _, child_trace) -> match child_scope_alignment
        LookaroundAdmittedStateScopeActive(_, _, _, _, _, _) -> match child_failure
          AtomicPathInputExhausted(_, stored_child_suffix) -> match child_suffix
            LookaroundAdmittedStateCursorSuffixHere(_) -> match stored_child_suffix
              LookaroundAdmittedStateCursorSuffixHere(_) -> atomic_path_active_child_rejection_head_active_excludes_trace(
                machine,
                char,
                after_input,
                source,
                history,
                capture_context,
                policy,
                scope_depth,
                prefix_mode,
                reversed_prefix,
                active_state,
                active_routine,
                active_constraints,
                active_assertion_routine,
                active_assertion_markers,
                active_nested_decisions,
                tail_failure,
                path
              )

  ## Consume a destination-exhaustion sibling tail through its typed package.
  ## The package's `Nil()` current index fixes the only tail shape that can
  ## reach the destination-exhaustion constructor; no erased tail kind or
  ## current list is inspected by runtime code.
  fn atomic_path_tail_package_destinations_exhausted_excludes_trace(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased package: AtomicPathRejectedTailAt(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Nil()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    matched: List(Char),
    remaining_input: List(Char),
    routine: List(ExtendedInstruction),
    @erased tail_suffix: LookaroundAdmittedStateCursorSuffix(n, Nil(), candidate_current),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    )
  ) -> result = match package
    AtomicPathTailPackagePacked(tail_failure) -> match tail_failure
      AtomicPathDestinationsExhausted(_, _, _, _, _, _) -> atomic_path_failure_excludes_aligned_trace(
        machine,
        char,
        rest,
        after_input,
        source,
        history,
        capture_context,
        policy,
        scope_depth,
        prefix_mode,
        reversed_prefix,
        whole,
        tail_failure,
        matched,
        remaining_input,
        routine,
        tail_suffix,
        path
      )

  ## A singleton recursively rejected child can expose one more indexed leaf.
  ## When its selected suffix is the same head as the stored failure cursor,
  ## and that head is active, the nested destination rejection has an empty
  ## child input after its one transition.  Reuse the existing terminal
  ## active-child contradiction at this construction site; all other cursor,
  ## state, and input shapes remain on the generic alignment continuations.
  @reducible
  fn atomic_path_active_child_rejection_singleton_active_excludes_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    after_input: List(Char),
    destination: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    child_scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    {failure_whole: List(LookaroundAdmittedState(n))},
    {@erased failure_remaining: List(LookaroundAdmittedState(n))},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), failure_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, Nil()),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), failure_remaining),
      matched,
      remaining_input,
      child_selected_routine
    )
  ) -> Empty = atomic_path_active_child_rejection_head_active_excludes_trace(
    machine,
    child_char,
    after_input,
    destination,
    history,
    capture_context,
    policy,
    child_scope_depth,
    prefix_mode,
    reversed_prefix,
    active_state,
    active_routine,
    active_constraints,
    active_assertion_routine,
    active_assertion_markers,
    active_nested_decisions,
    child_failure,
    child_path
  )

  ## Prefix selection is an outer endpoint policy.  The atomic machine still
  ## chooses the first path for each exact candidate, but shortest/longest
  ## selection must range over all candidate endpoints just like the ordinary
  ## lookaround prefix API.  Calling the exact atomic authority for each
  ## candidate keeps commitment semantics identical at every endpoint and
  ## returns the routine belonging to the selected candidate.
  fn atomic_lookaround_routine_prefix(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), greedy: Bool, history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Option(Tuple(List(Char), List(Char), List(ExtendedInstruction))) = match machine
    MkPatternMachine(_, _) -> pickup
      greedy -> atomic_lookaround_routine_last_prefix(depth, n, machine, position, [], input, None(), history, capture_context, policy)
      else -> atomic_lookaround_routine_first_prefix(depth, n, machine, position, [], input, history, capture_context, policy)

  fn atomic_lookaround_accepts(depth: Nat, n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), history: List(Char), capture_context: List(EvidenceInstruction), policy: NewlinePolicy) -> Bool = match machine
    MkPatternMachine(starts, _) -> match atomic_lookaround_initial_members(depth, n, machine, input, after_input, history, capture_context, policy, None(), lookaround_filter_boundary_states(depth, starts, position_boundary_for_history(position, append_characters(input, after_input), history), append_characters(input, after_input), history, capture_context, policy))
      AtomicSearchYes() -> true
      AtomicSearchNo() -> false
      AtomicSearchCommit(_) -> false

  fn atomic_runtime_first_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    atomic_runtime_first_prefix_loop(n, machine, position, [], input)

  fn atomic_runtime_last_prefix(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char)) -> Option(Tuple(List(Char), List(Char))) =
    atomic_runtime_last_prefix_loop(n, machine, position, [], input, None())
end
