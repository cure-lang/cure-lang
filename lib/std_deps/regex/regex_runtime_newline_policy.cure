@group(:text)
mod Std.Regex.Runtime.NewlinePolicy
  use Std.Regex.Runtime.StateOps
  use Std.Regex.Runtime.PatternMachines
  use Std.Regex.Runtime.StagedOps
  use Std.Regex.Runtime.Compilation
  use Std.Regex.Runtime.MachineLaws
  use Std.Regex.Runtime.MachineFilters
  use Std.Regex.Runtime.SubjectContext
  use Std.Regex.Runtime.CharacterPredicates
  use Std.Regex.Runtime.Position
  use Std.Regex.Runtime.Evidence
  use Std.Regex.Runtime.NamedCapture
  use Std.Regex.Runtime.Compiler
  use Std.Regex.Runtime.AtomicPlan
  use Std.Regex.Runtime.LookaroundContext
  use Std.Regex.Runtime.EvidenceThreads






























  use Std.Regex.Runtime.TransitionRows

  use Std.Regex.Runtime.CaptureConditions

  use Std.Regex.Runtime.Boundaries

  use Std.Regex.Runtime.AtomicDiagnostics

  use Std.Regex.Runtime.ClassKinds

  use Std.Regex.Runtime.Named

  use Std.Regex.Runtime.Split

  use Std.Regex.Core.Capture

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Char

  use Std.Option

  use Std.List

  use Std.String

  use Std.Syntax

  use Std.Bounded

  use Std.Equivalent

  use Std.Sigma

  use Std.Decision

  fn line_break_pair_start_policy(policy: NewlinePolicy) -> Bool = match policy
      LFNewline() -> false
      CRNewline() -> false
      CRLFNewline() -> true
      AnyCRLFNewline() -> true
      AnyUnicodeNewline() -> true

  fn line_break_pair_start_test(policy: NewlinePolicy, char: Char) -> Bool = char == '\r' and line_break_pair_start_policy(policy)

  fn line_break_pair_test(policy: NewlinePolicy, expected: Char) -> Char -> Bool =
    fn(char) -> char == expected and (line_break_pair_start_test(policy, char) or line_break_pair_end_test(policy, char))

  fn line_break_pair_end_policy(policy: NewlinePolicy) -> Bool = match policy
      LFNewline() -> false
      CRNewline() -> false
      CRLFNewline() -> true
      AnyCRLFNewline() -> true
      AnyUnicodeNewline() -> true

  fn line_break_pair_end_test(policy: NewlinePolicy, char: Char) -> Bool = char == '\n' and line_break_pair_end_policy(policy)

  fn line_break_scalar_test(policy: NewlinePolicy, expected: Char) -> Char -> Bool =
    fn(char) -> char == expected and line_break_scalar_policy(policy, char)

  fn line_break_scalar_policy(policy: NewlinePolicy, char: Char) -> Bool = match policy
      LFNewline() -> char == '\n'
      CRNewline() -> char == '\r'
      CRLFNewline() -> false
      AnyCRLFNewline() -> char == '\r' or char == '\n'
      AnyUnicodeNewline() -> Std.Char.is_newline(char)
end
