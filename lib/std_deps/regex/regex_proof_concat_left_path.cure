  @reducible
  fn shared_execution_final_captures({first_routine: List(ExtendedInstruction)}, {second_routine: List(ExtendedInstruction)}, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {first_final_evidence: List(Evidence)}, {second_final_evidence: List(Evidence)}, first_final_captures: List(CaptureFrame), second_final_captures: List(CaptureFrame), shared_final_captures: List(CaptureFrame), first_canonical: ExtendedEvidenceRoutineExecution(first_routine, input_evidence, input_captures, first_final_evidence, first_final_captures), second_canonical: ExtendedEvidenceRoutineExecution(second_routine, input_evidence, input_captures, second_final_evidence, second_final_captures), first_shared: ExtendedEvidenceRoutineExecution(first_routine, input_evidence, input_captures, first_final_evidence, shared_final_captures), second_shared: ExtendedEvidenceRoutineExecution(second_routine, input_evidence, input_captures, second_final_evidence, shared_final_captures)) -> Equivalent(List(CaptureFrame), first_final_captures, second_final_captures) = match extended_routine_execution_unique(input_evidence, input_captures, first_canonical, first_shared)
