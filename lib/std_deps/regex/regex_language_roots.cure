  use Std.Regex.Runtime.ExtendedEvidenceTypes

  use Std.Regex.Runtime.MachineEntryPrimitives

  use Std.Regex.Runtime.PatternMachinePrimitives

  use Std.Regex.Runtime.MachineTransitionPrimitives

  use Std.Regex.Proof.EquivalenceLaws

  use Std.Regex.Runtime.MachineSearch

  use Std.Regex.Runtime.MachineTransitions

  use Std.Regex.Runtime.MachineEntry

