  typealias AlternateLeftActivePathEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence)) = Sigma(combined_routine: List(ExtendedInstruction), AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_left(left_count, right_count, source)), current_evidence, current_captures, Cons(LeftEvidence(), child_final_evidence), combined_routine))

  typealias AlternateRightActivePathEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), prefer_right: Bool, input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence)) = Sigma(combined_routine: List(ExtendedInstruction), AcceptingFrom(plus(left_count, right_count), alternate_pattern_machine(left_count, left_machine, right_count, right_machine, prefer_right), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, Cons(RightEvidence(), child_final_evidence), combined_routine))

  ## Once an alternate thread is known to inhabit one injection image, every
  ## outgoing edge comes from that same child machine. The Bounded inverse laws
  ## rewrite the combined source before the transition is classified; no raw-Nat
  ## comparison or unchecked projection is involved.
  fn alternate_left_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(left_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_left(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary)) =
    rewrite split_injected_left_at(right_count, source) in reflexive(filter_machine_states(plus(left_count, right_count), alternate_left_states(left_count, right_count, left_next(source, char), EmitLeft()), boundary))

  fn alternate_right_destinations_equivalent(left_count: Nat, left_starts: List(MachineState(left_count)), left_next: (Bounded(left_count)) -> Char -> List(MachineState(left_count)), right_count: Nat, right_starts: List(MachineState(right_count)), right_next: (Bounded(right_count)) -> Char -> List(MachineState(right_count)), prefer_right: Bool, source: Bounded(right_count), char: Char, boundary: Boundary) -> Equivalent(List(MachineState(plus(left_count, right_count))), machine_destinations(plus(left_count, right_count), alternate_pattern_machine(left_count, MkPatternMachine(left_starts, left_next), right_count, MkPatternMachine(right_starts, right_next), prefer_right), ThreadActive(inject_alternate_right(left_count, right_count, source)), char, boundary), filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitRight()), boundary)) =
    rewrite split_injected_right(left_count, source) in reflexive(filter_machine_states(plus(left_count, right_count), alternate_right_states(left_count, right_count, right_next(source, char), EmitRight()), boundary))

  fn transport_alternate_edge({n: Nat}, {value: MachineState(n)}, {source: List(MachineState(n))}, {target: List(MachineState(n))}, equality: Equivalent(List(MachineState(n)), source, target), edge: ListMember(MachineState(n), value, source)) -> ListMember(MachineState(n), value, target) = match equality
    reflexive() -> edge

  fn finish_pair_is_mark_branch({n: Nat}, states: List(MachineState(n))) -> Equivalent(List(MachineState(n)), finish_pair(states), mark_branch(states, EmitPair())) = match states
    Nil() ->
      let empty: List(MachineState(n)) = Nil()
      reflexive(empty)
    Cons(Active(state, routine, constraints), rest) -> rewrite finish_pair_is_mark_branch(rest) in reflexive(Cons(Active(state, routine, constraints), mark_branch(rest, EmitPair())))
    Cons(Accepted(routine, constraints), rest) -> rewrite finish_pair_is_mark_branch(rest) in reflexive(Cons(Accepted(append_routine(routine, Cons(EmitPair(), Nil())), constraints), mark_branch(rest, EmitPair())))

  typealias ConcatRightActivePathEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), input: List(Char), after_input: List(Char), source: Bounded(right_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence)) = Sigma(combined_routine: List(ExtendedInstruction), AcceptingFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), input, after_input, ThreadActive(inject_alternate_right(left_count, right_count, source)), current_evidence, current_captures, Cons(PairEvidence(), child_final_evidence), combined_routine))

  typealias NullableLeftActiveRightConcatEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), right_final_evidence: List(Evidence)) = AcceptancePathFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), position, input, after_input, input_evidence, input_captures, Cons(PairEvidence(), right_final_evidence))

  typealias NullableLeftAcceptedRightConcatEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), right_final_evidence: List(Evidence)) = AcceptancePathFrom(plus(left_count, right_count), concat_pattern_machine(left_count, left_machine, right_count, right_machine), position, input, after_input, input_evidence, input_captures, Cons(PairEvidence(), right_final_evidence))

  fn impossible_empty_active_path(n: Nat, machine: PatternMachine(n), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction), {result: Type}, path: AcceptingFrom(n, machine, Nil(), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine)) -> result = match path
    AcceptingNow() -> impossible
    AcceptingNextActive(_, _, _, _, _, _, _, _, _) -> impossible
    AcceptingNextAccepted(_, _, _, _, _, _, _, _) -> impossible

  type ConcatLeftActivePathEmbedding(left_count: Nat, left_machine: PatternMachine(left_count), right_count: Nat, right_machine: PatternMachine(right_count), position: InitialPosition, left_input: List(Char), right_input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), right_final_evidence: List(Evidence)) indices ()
