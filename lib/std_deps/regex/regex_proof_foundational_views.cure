  type ExactGroupActiveInputView(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), chars: List(Char), saved: List(Evidence), outer: List(CaptureFrame)) indices (final_evidence: List(Evidence), input: List(Char), routine: List(ExtendedInstruction), path: AcceptingFrom(n, MkPatternMachine(starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine))
    ExactGroupActiveNextActive : (char: Char) -> (rest: List(Char)) -> (destination: Bounded(n)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (final_evidence: List(Evidence)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge: ListMember(MachineState(n), Active(destination, regular, constraints), machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input)))) -> (execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures)) -> (suffix: AcceptingFrom(n, MkPatternMachine(starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> (captures_exact: Equivalent(List(CaptureFrame), accepting_final_captures(n, MkPatternMachine(starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix)), Cons(CaptureFrame(chars, saved), outer))) -> ExactGroupActiveInputView(n, starts, next, after_input, source, current_evidence, current_captures, chars, saved, outer, final_evidence, Cons(char, rest), append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix))
    ExactGroupActiveNextAccepted : (char: Char) -> (rest: List(Char)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (final_evidence: List(Evidence)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge: ListMember(MachineState(n), Accepted(regular, constraints), machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input)))) -> (execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures)) -> (suffix: AcceptingFrom(n, MkPatternMachine(starts, next), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine)) -> (captures_exact: Equivalent(List(CaptureFrame), accepting_final_captures(n, MkPatternMachine(starts, next), Cons(char, rest), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix)), Cons(CaptureFrame(chars, saved), outer))) -> ExactGroupActiveInputView(n, starts, next, after_input, source, current_evidence, current_captures, chars, saved, outer, final_evidence, Cons(char, rest), append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix))

  type ExactOpenCaptureStack(chars: List(Char), saved: List(Evidence), outer: List(CaptureFrame)) indices (captures: List(CaptureFrame))
    ExactOpenCaptureStackHere : ExactOpenCaptureStack(chars, saved, outer, Cons(CaptureFrame(chars, saved), outer))

  type GroupActivePathEmbedding(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), chars: List(Char), saved: List(Evidence), outer: List(CaptureFrame)) indices (input: List(Char), after_input: List(Char))
    GroupActivePathLifted : (routine: List(ExtendedInstruction)) -> (path: AcceptingFrom(n, group_pattern_machine(n, starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, Cons(StringEvidence(captured_string(chars)), saved), routine)) -> (captures_exact: Equivalent(List(CaptureFrame), accepting_final_captures(n, group_pattern_machine(n, starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, Cons(StringEvidence(captured_string(chars)), saved), routine, path), outer)) -> GroupActivePathEmbedding(n, starts, next, source, current_evidence, current_captures, chars, saved, outer, input, after_input)

  fn prepend_begin_capture_execution(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame), execution: RoutineExecution(routine, input_evidence, Cons(CaptureFrame(Nil(), input_evidence), input_captures), output_evidence, output_captures)) -> RoutineExecution(Cons(BeginCapture(), routine), input_evidence, input_captures, output_evidence, output_captures) =
    RoutineStep(BeginCapture(), execution)

  type FilteredFinishCaptureOrigin(n: Nat, states: List(MachineState(n)), boundary: Boundary) indices (filtered: MachineState(n))
    FilteredCaptureActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), states)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredFinishCaptureOrigin(n, states, boundary, Active(state, routine, Nil()))
    FilteredCaptureAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), states)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredFinishCaptureOrigin(n, states, boundary, Accepted(append_routine(routine, Cons(EndCapture(), Nil())), Nil()))

  type FilteredGroupStartOrigin(n: Nat, starts: List(MachineState(n)), boundary: Boundary) indices (filtered: MachineState(n))
    GroupStartActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredGroupStartOrigin(n, starts, boundary, Active(state, Cons(BeginCapture(), routine), Nil()))
    GroupStartAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), starts)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredGroupStartOrigin(n, starts, boundary, Accepted(append_routine(Cons(BeginCapture(), routine), Cons(EndCapture(), Nil())), Nil()))

  fn inner_transition_member(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), source: Bounded(n), char: Char, boundary: Boundary, destination: MachineState(n), edge: ListMember(MachineState(n), destination, filter_machine_states(n, next(source, char), boundary))) -> ListMember(MachineState(n), destination, machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, boundary)) = edge

  type GroupActivePathProjection(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), input: List(Char), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame)) indices (final_evidence: List(Evidence), combined_final_captures: List(CaptureFrame))
    ProjectedGroupMissingFrame : (child_final_evidence: List(Evidence)) -> (child_routine: List(ExtendedInstruction)) -> (child_path: AcceptingFrom(n, MkPatternMachine(starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> (child_execution: ExtendedEvidenceRoutineExecution(child_routine, current_evidence, current_captures, child_final_evidence, Nil())) -> (combined_final_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), combined_final_captures, Nil())) -> (@erased projected_final_evidence: List(Evidence)) -> (projected_evidence_exact: Equivalent(List(Evidence), projected_final_evidence, child_final_evidence)) -> (projected_final_captures: List(CaptureFrame)) -> (projected_captures_exact: Equivalent(List(CaptureFrame), projected_final_captures, combined_final_captures)) -> GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, projected_final_evidence, projected_final_captures)
    ProjectedGroupClosedFrame : (child_final_evidence: List(Evidence)) -> (child_routine: List(ExtendedInstruction)) -> (chars: List(Char)) -> (saved: List(Evidence)) -> (outer: List(CaptureFrame)) -> (child_path: AcceptingFrom(n, MkPatternMachine(starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, child_routine)) -> (child_execution: ExtendedEvidenceRoutineExecution(child_routine, current_evidence, current_captures, child_final_evidence, Cons(CaptureFrame(chars, saved), outer))) -> (combined_final_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), combined_final_captures, outer)) -> (@erased projected_final_evidence: List(Evidence)) -> (projected_evidence_exact: Equivalent(List(Evidence), projected_final_evidence, Cons(StringEvidence(captured_string(chars)), saved))) -> (projected_final_captures: List(CaptureFrame)) -> (projected_captures_exact: Equivalent(List(CaptureFrame), projected_final_captures, combined_final_captures)) -> GroupActivePathProjection(n, starts, next, input, after_input, source, current_evidence, current_captures, projected_final_evidence, projected_final_captures)

  fn transport_acceptance_machine({n: Nat}, left: PatternMachine(n), right: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), equality: Equivalent(PatternMachine(n), left, right), acceptance: AcceptancePathFrom(n, left, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AcceptancePathFrom(n, right, position, input, after_input, input_evidence, input_captures, final_evidence) = match equality
    reflexive() -> acceptance

  fn initial_machine_destinations_equation(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char)) -> Equivalent(
    List(MachineState(n)),
    initial_machine_destinations(n, machine, position, input, after_input),
    filter_boundary_states(pattern_machine_starts(machine), initial_position_boundary(position, append_characters(input, after_input)))
  ) = match machine
    MkPatternMachine(starts, next) -> reflexive(filter_boundary_states(starts, initial_position_boundary(position, append_characters(input, after_input))))

  fn machine_destinations_equation(n: Nat, machine: PatternMachine(n), state: Bounded(n), char: Char, boundary: Boundary) -> Equivalent(
    List(MachineState(n)),
    machine_destinations(n, machine, ThreadActive(state), char, boundary),
    filter_boundary_states(pattern_machine_next_at(machine, state, char), boundary)
  ) = match machine
    MkPatternMachine(starts, next) -> reflexive(filter_boundary_states(next(state, char), boundary))

  fn filter_boundary_equation(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, equality: Equivalent(List(MachineState(n)), left, right)) -> Equivalent(
    List(MachineState(n)),
    filter_boundary_states(left, boundary),
    filter_boundary_states(right, boundary)
  ) = match equality
    reflexive() -> reflexive(filter_boundary_states(left, boundary))

  fn staged_machine_next_equation(
    {shape: ShapeCode},
    compilation: ThompsonCompilation(shape),
    state: Bounded(thompson_state_count(compilation)),
    char: Char
  ) -> Equivalent(
    List(MachineState(thompson_state_count(compilation))),
    pattern_machine_next_at(staged_machine_from_compilation(compilation), state, char),
    transition_rows_next(direct_staged_rows_values_from_compilation(compilation), state, char)
  ) = staged_machine_rows_transition_equivalent(compilation, state, char)

  ## Group's Thompson clause brackets the inner machine with a capture frame.
  ## This first complete instance proves the atomic inner machine end-to-end:
  ## construction, accepted path, capture execution, and String evidence.
  type GroupedPredicateStartsView indices (starts: List(MachineState(S(Z()))))
    GroupedPredicateStartsExact : GroupedPredicateStartsView(Cons(Active(First(), Cons(BeginCapture(), Nil()), Nil()), Nil()))

  type GroupedPredicateDestinationsView indices (holds: Bool, char: Char, destinations: List(MachineState(S(Z()))))
    GroupedPredicateRejects : GroupedPredicateDestinationsView(false, char, Nil())
    GroupedPredicateAccepts : GroupedPredicateDestinationsView(true, char, Cons(Accepted(Cons(EmitChar(char), Cons(EndCapture(), Nil())), Nil()), Nil()))

  type GroupedPredicateInitialView indices (evidence: List(Evidence), captures: List(CaptureFrame))
    GroupedPredicateInitialExact : GroupedPredicateInitialView(Nil(), Cons(CaptureFrame(Nil(), Nil()), Nil()))

  fn transport_encodes_output({shape: ShapeCode}, {left: List(Evidence)}, {right: List(Evidence)}, {rest: List(Evidence)}, equality: Equivalent(List(Evidence), left, right), encoded: Encodes(shape, left, rest)) -> Encodes(shape, right, rest) = match equality
    reflexive() -> encoded

  fn impossible_concat_accepted_tail(regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {result: Type}, prior: ListMember(MachineState(plus(S(Z()), S(Z()))), Accepted(regular, constraints), Nil())) -> result = match prior

  fn impossible_concat_active_tail(destination: Bounded(plus(S(Z()), S(Z()))), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint), {result: Type}, prior: ListMember(MachineState(plus(S(Z()), S(Z()))), Active(destination, regular, constraints), Nil())) -> result = match prior

  ## Alternate preserves the chosen branch in the evidence stream. This atomic
  ## instance proves both injected halves of the finite-state sum, including the
  ## right-hand state shift and the final EmitLeft/EmitRight marker.
  @reducible
  fn predicate_alternate_mode_machine(left: Char -> Bool, right: Char -> Bool, prefer_right: Bool) -> PatternMachine(plus(S(Z()), S(Z()))) =
    alternate_pattern_machine(S(Z()), predicate_pattern_machine(left), S(Z()), predicate_pattern_machine(right), prefer_right)

  @reducible
  fn predicate_alternate_left_start() -> MachineState(plus(S(Z()), S(Z()))) = Active(First(), Nil(), Nil())

  @reducible
  fn predicate_alternate_right_start() -> MachineState(plus(S(Z()), S(Z()))) = Active(Next(First()), Nil(), Nil())

  type PredicateAlternateLeftDestinationsView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateAlternateLeftRejects : PredicateAlternateLeftDestinationsView(false, char, Nil())
    PredicateAlternateLeftAccepts : PredicateAlternateLeftDestinationsView(true, char, Cons(Accepted(Cons(EmitChar(char), Cons(EmitLeft(), Nil())), Nil()), Nil()))

  type PredicateAlternateRightDestinationsView indices (holds: Bool, char: Char, destinations: List(MachineState(plus(S(Z()), S(Z())))))
    PredicateAlternateRightRejects : PredicateAlternateRightDestinationsView(false, char, Nil())
    PredicateAlternateRightAccepts : PredicateAlternateRightDestinationsView(true, char, Cons(Accepted(Cons(EmitChar(char), Cons(EmitRight(), Nil())), Nil()), Nil()))
end
