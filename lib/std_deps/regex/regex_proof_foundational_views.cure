  ## Structural inverses for Group's two routine transformations. These retain
  ## the original membership witness, so later projection can rebuild an inner
  ## accepting edge without guessing from function-valued transition tables.
  type PrefixRoutineOrigin(n: Nat, instruction: EvidenceInstruction, states: List(MachineState(n))) indices (prefixed: MachineState(n))
    PrefixedActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), states)) -> PrefixRoutineOrigin(n, instruction, states, Active(state, Cons(instruction, routine), constraints))
    PrefixedAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), states)) -> PrefixRoutineOrigin(n, instruction, states, Accepted(Cons(instruction, routine), constraints))

  type FinishCaptureOrigin(n: Nat, states: List(MachineState(n))) indices (finished: MachineState(n))
    CaptureActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), states)) -> FinishCaptureOrigin(n, states, Active(state, routine, constraints))
    CaptureAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), states)) -> FinishCaptureOrigin(n, states, Accepted(append_routine(routine, Cons(EndCapture(), Nil())), constraints))

  @reducible
  fn finish_capture_state({n: Nat}, state: MachineState(n)) -> MachineState(n) = match state
    Active(destination, routine, constraints) -> Active(destination, routine, constraints)
    Accepted(routine, constraints) -> Accepted(append_routine(routine, Cons(EndCapture(), Nil())), constraints)

  @reducible
  fn prefix_routine_state({n: Nat}, instruction: EvidenceInstruction, state: MachineState(n)) -> MachineState(n) = match state
    Active(destination, routine, constraints) -> Active(destination, Cons(instruction, routine), constraints)
    Accepted(routine, constraints) -> Accepted(Cons(instruction, routine), constraints)

