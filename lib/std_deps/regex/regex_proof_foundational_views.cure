  use Std.Regex.Runtime.StagedOps

  use Std.Regex.Runtime.PatternMachines

  use Std.Regex.Runtime.StateOps

  use Std.Regex.Runtime.TransitionRows

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Regex.Runtime

  use Std.Equivalent

  fn split_appended_routine_execution(left: List(EvidenceInstruction), right: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: RoutineExecution(append_routine(left, right), input_evidence, input_captures, output_evidence, output_captures)) -> AppendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> AppendedRoutineExecuted(input_evidence, input_captures, RoutineDone(), execution)
    Cons(instruction, rest) -> match execution
      RoutineStep(_, suffix) -> match split_appended_routine_execution(rest, right, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), suffix)
        AppendedRoutineExecuted(middle_evidence, middle_captures, left_execution, right_execution) -> AppendedRoutineExecuted(middle_evidence, middle_captures, RoutineStep(instruction, left_execution), right_execution)

  type EndCaptureExecutionView indices (routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
    EndCaptureWithoutFrame : (middle_evidence: List(Evidence)) -> (inner: RoutineExecution(routine, input_evidence, input_captures, middle_evidence, Nil())) -> (view_output_evidence: List(Evidence)) -> (evidence_exact: Equivalent(List(Evidence), view_output_evidence, middle_evidence)) -> (view_output_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), view_output_captures, Nil())) -> EndCaptureExecutionView(routine, input_evidence, input_captures, view_output_evidence, view_output_captures)
    EndCaptureWithFrame : (middle_evidence: List(Evidence)) -> (chars: List(Char)) -> (saved: List(Evidence)) -> (outer: List(CaptureFrame)) -> (inner: RoutineExecution(routine, input_evidence, input_captures, middle_evidence, Cons(CaptureFrame(chars, saved), outer))) -> (view_output_evidence: List(Evidence)) -> (evidence_exact: Equivalent(List(Evidence), view_output_evidence, Cons(StringEvidence(captured_string(chars)), saved))) -> (view_output_captures: List(CaptureFrame)) -> (captures_exact: Equivalent(List(CaptureFrame), view_output_captures, outer)) -> EndCaptureExecutionView(routine, input_evidence, input_captures, view_output_evidence, view_output_captures)

  fn routine_execution_unique(routine: List(EvidenceInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {first_evidence: List(Evidence)}, {first_captures: List(CaptureFrame)}, {second_evidence: List(Evidence)}, {second_captures: List(CaptureFrame)}, first: RoutineExecution(routine, input_evidence, input_captures, first_evidence, first_captures), second: RoutineExecution(routine, input_evidence, input_captures, second_evidence, second_captures)) -> ExecutionOutputsEqual(first_evidence, first_captures, second_evidence, second_captures) = match routine
    Nil() -> match first
      RoutineDone() -> match second
        RoutineDone() -> %[reflexive(input_evidence), reflexive(input_captures)]
    Cons(instruction, rest) -> match first
      RoutineStep(_, first_suffix) -> match second
        RoutineStep(_, second_suffix) -> routine_execution_unique(rest, executed_evidence(execute_instruction(instruction, input_evidence, input_captures)), executed_captures(execute_instruction(instruction, input_evidence, input_captures)), first_suffix, second_suffix)

  fn extended_routine_execution_unique({routine: List(ExtendedInstruction)}, input_evidence: List(Evidence), input_captures: List(CaptureFrame), {first_evidence: List(Evidence)}, {first_captures: List(CaptureFrame)}, {second_evidence: List(Evidence)}, {second_captures: List(CaptureFrame)}, first: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, first_evidence, first_captures), second: ExtendedEvidenceRoutineExecution(routine, input_evidence, input_captures, second_evidence, second_captures)) -> ExecutionOutputsEqual(first_evidence, first_captures, second_evidence, second_captures) = match first
    ExtendedEvidenceDone() -> match second
      ExtendedEvidenceDone() -> %[reflexive(input_evidence), reflexive(input_captures)]
    ExtendedEvidenceObserve(char, first_suffix) -> match second
      ExtendedEvidenceObserve(_, second_suffix) -> extended_routine_execution_unique(input_evidence, record_capture_char(input_captures, char), first_suffix, second_suffix)
    ExtendedEvidenceRegular(regular, first_suffix) -> match second
      ExtendedEvidenceRegular(_, second_suffix) -> extended_routine_execution_unique(executed_evidence(execute_instruction(regular, input_evidence, input_captures)), executed_captures(execute_instruction(regular, input_evidence, input_captures)), first_suffix, second_suffix)

  fn split_appended_extended_routine_execution(left: List(ExtendedInstruction), right: List(ExtendedInstruction), input_evidence: List(Evidence), input_captures: List(CaptureFrame), {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: ExtendedEvidenceRoutineExecution(append_extended_routines(left, right), input_evidence, input_captures, output_evidence, output_captures)) -> AppendedExtendedRoutineExecution(left, right, input_evidence, input_captures, output_evidence, output_captures) = match left
    Nil() -> AppendedExtendedRoutineExecuted(input_evidence, input_captures, ExtendedEvidenceDone(), execution)
    Cons(instruction, rest) -> match instruction
      Observe(char) -> match execution
        ExtendedEvidenceObserve(_, suffix) -> match split_appended_extended_routine_execution(rest, right, input_evidence, record_capture_char(input_captures, char), suffix)
          AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, left_execution, right_execution) -> AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, ExtendedEvidenceObserve(char, left_execution), right_execution)
      Regular(regular) -> match execution
        ExtendedEvidenceRegular(_, suffix) -> match split_appended_extended_routine_execution(rest, right, executed_evidence(execute_instruction(regular, input_evidence, input_captures)), executed_captures(execute_instruction(regular, input_evidence, input_captures)), suffix)
          AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, left_execution, right_execution) -> AppendedExtendedRoutineExecuted(middle_evidence, middle_captures, ExtendedEvidenceRegular(regular, left_execution), right_execution)

  typealias AcceptancePath(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), final_evidence: List(Evidence)) = AcceptancePathFrom(n, machine, position, input, after_input, Nil(), Nil(), final_evidence)

  typealias ConcatRightAcceptance(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), input_evidence: List(Evidence), final_evidence: List(Evidence), position: InitialPosition, input_captures: List(CaptureFrame)) = AcceptanceStartView(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)

  fn acceptance_start_view(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AcceptanceStartView(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(execution, path)))))) -> match destination
      Active(state, regular, constraints) -> AcceptanceStartsActive(state, regular, constraints, initial_evidence, initial_captures, path_routine, edge, execution, path)
      Accepted(regular, constraints) -> AcceptanceStartsAccepted(regular, constraints, initial_evidence, initial_captures, path_routine, edge, execution, path)

  fn acceptance_from_start_view(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), view: AcceptanceStartView(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence) = match view
    AcceptanceStartsActive(state, regular, constraints, initial_evidence, initial_captures, path_routine, edge, execution, path) -> %[Active(state, regular, constraints), initial_evidence, initial_captures, path_routine, edge, execution, path]
    AcceptanceStartsAccepted(regular, constraints, initial_evidence, initial_captures, path_routine, edge, execution, path) -> %[Accepted(regular, constraints), initial_evidence, initial_captures, path_routine, edge, execution, path]

  @reducible
  fn acceptance_extended_routine(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> List(ExtendedInstruction) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> append_extended_routines(regular_routine(machine_state_routine(n, destination)), path_routine)

  fn accepting_path_execution(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, state, current_evidence, captures, final_evidence, routine)) -> PathExecution(routine, current_evidence, captures, final_evidence) = match input
    Nil() -> match path
      AcceptingNow() -> PathExecuted(captures, ExtendedEvidenceDone())
    Cons(char, rest) -> match path
      AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match accepting_path_execution(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
        PathExecuted(final_captures, suffix_execution) -> PathExecuted(final_captures, ExtendedEvidenceObserve(char, append_extended_routine_execution(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, final_evidence, final_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), suffix_execution)))
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> match accepting_path_execution(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)
        PathExecuted(final_captures, suffix_execution) -> PathExecuted(final_captures, ExtendedEvidenceObserve(char, append_extended_routine_execution(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, final_evidence, final_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), suffix_execution)))

  fn accepting_path_execution_exact(n: Nat, machine: PatternMachine(n), input: List(Char), after_input: List(Char), state: ThreadState(n), current_evidence: List(Evidence), captures: List(CaptureFrame), @erased final_evidence: List(Evidence), @erased routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, state, current_evidence, captures, final_evidence, routine)) -> ExtendedEvidenceRoutineExecution(routine, current_evidence, captures, final_evidence, accepting_final_captures(n, machine, input, after_input, state, current_evidence, captures, final_evidence, routine, path)) = match input
    Nil() -> match path
      AcceptingNow() -> ExtendedEvidenceDone()
    Cons(char, rest) -> match path
      AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> ExtendedEvidenceObserve(char, append_extended_routine_execution_inferred(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), accepting_path_execution_exact(n, machine, rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)))
      AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix) -> ExtendedEvidenceObserve(char, append_extended_routine_execution_inferred(regular_routine(regular), suffix_routine, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, extend_routine_execution(regular, current_evidence, record_capture_char(captures, char), destination_evidence, destination_captures, execution), accepting_path_execution_exact(n, machine, rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, final_evidence, suffix_routine, suffix)))

  type AcceptanceExecutionMatch indices (final_evidence: List(Evidence), supplied_captures: List(CaptureFrame))
    MatchedAcceptanceExecution : (canonical_captures: List(CaptureFrame)) -> (outputs_equal: ExecutionOutputsEqual(final_evidence, canonical_captures, final_evidence, supplied_captures)) -> AcceptanceExecutionMatch(final_evidence, supplied_captures)

  @reducible
  fn acceptance_path_final_captures(n: Nat, machine: PatternMachine(n), position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame), final_evidence: List(Evidence), acceptance: AcceptancePathFrom(n, machine, position, input, after_input, input_evidence, input_captures, final_evidence)) -> List(CaptureFrame) = match acceptance
    mk_pair(destination, mk_pair(initial_evidence, mk_pair(initial_captures, mk_pair(path_routine, mk_pair(edge, mk_pair(initial_execution, path)))))) -> accepting_final_captures(n, machine, input, after_input, machine_state_thread(n, destination), initial_evidence, initial_captures, final_evidence, path_routine, path)

  ## The atomic case of the thesis's generalized Thompson theorem. It is
  ## independent of the NFA and of any evidence/captures already in the VM.
  fn predicate_transition_routine_encodes(char: Char, {input_evidence: List(Evidence)}, {input_captures: List(CaptureFrame)}, {output_evidence: List(Evidence)}, {output_captures: List(CaptureFrame)}, execution: ExtendedEvidenceRoutineExecution(transition_routine(char, Cons(EmitChar(char), Nil())), input_evidence, input_captures, output_evidence, output_captures)) -> Encodes(CharC, output_evidence, input_evidence) = match execution
    ExtendedEvidenceObserve(_, after_observe) -> match after_observe
      ExtendedEvidenceRegular(_, after_emit) -> match after_emit
        ExtendedEvidenceDone() -> EncodesCharacter(char)

  type PredicateRoutineView indices (char: Char, routine: List(ExtendedInstruction))
    PredicateRoutineExact : PredicateRoutineView(char, transition_routine(char, Cons(EmitChar(char), Nil())))

  type PredicatePathView indices (char: Char, final_evidence: List(Evidence), routine: List(ExtendedInstruction))
    PredicatePathExact : PredicatePathView(char, Cons(CharacterEvidence(char), Nil()), transition_routine(char, Cons(EmitChar(char), Nil())))

  type PredicateEvidenceView indices (char: Char, evidence: List(Evidence), captures: List(CaptureFrame))
    PredicateEvidenceExact : PredicateEvidenceView(char, Cons(CharacterEvidence(char), Nil()), Nil())

  type PredicateDestinationsView indices (test: Char -> Bool, char: Char, boundary: Boundary, destinations: List(MachineState(S(Z()))))
    PredicateRejects : PredicateDestinationsView(test, char, boundary, Nil())
    PredicateAccepts : PredicateDestinationsView(test, char, boundary, Cons(predicate_accepting_destination(char), Nil()))

  type PredicateStartsView indices (starts: List(MachineState(S(Z()))))
    PredicateStartsExact : PredicateStartsView(Cons(predicate_machine_start(), Nil()))

  @reducible
  fn boundary_accepting_destination() -> MachineState(Z()) =
    let routine: List(EvidenceInstruction) = Cons(EmitUnit(), Nil())
    let constraints: List(BoundaryConstraint) = Nil()
    Accepted(routine, constraints)

  @reducible
  fn predicate_concat_machine(left: Char -> Bool, right: Char -> Bool) -> PatternMachine(plus(S(Z()), S(Z()))) =
    let right_starts: List(MachineState(S(Z()))) = Cons(predicate_machine_start(), Nil())
    let starts: List(MachineState(plus(S(Z()), S(Z())))) = continue_with_right(S(Z()), Cons(predicate_machine_start(), Nil()), right_starts)
    MkPatternMachine(starts, concat_machine_next(S(Z()), predicate_machine_next(left), right_starts, predicate_machine_next(right)))

  @reducible
  fn predicate_concat_start() -> MachineState(plus(S(Z()), S(Z()))) =
    Active(First(), Nil(), Nil())

  @reducible
  fn predicate_concat_middle(char: Char) -> MachineState(plus(S(Z()), S(Z()))) =
    Active(1, Cons(EmitChar(char), Nil()), Nil())

  @reducible
  fn predicate_concat_middle_thread() -> ThreadState(plus(S(Z()), S(Z()))) =
    ThreadActive(Next(First()))

  @reducible
  fn predicate_concat_accepting(char: Char) -> MachineState(plus(S(Z()), S(Z()))) =
    Accepted(Cons(EmitChar(char), Cons(EmitPair(), Nil())), Nil())

  type PredicateConcatAcceptedEdgeView indices (char: Char, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint))
    PredicateConcatAcceptedEdgeExact : PredicateConcatAcceptedEdgeView(char, Cons(EmitChar(char), Cons(EmitPair(), Nil())), Nil())

  type PredicateConcatActiveEdgeView indices (char: Char, destination: Bounded(plus(S(Z()), S(Z()))), regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint))
    PredicateConcatActiveEdgeExact : PredicateConcatActiveEdgeView(char, 1, Cons(EmitChar(char), Nil()), Nil())

  fn impossible_list_member({item_type: Type}, {item: item_type}, {result: Type}, membership: ListMember(item_type, item, Nil())) -> result = match membership

  type AcceptedPathView(n: Nat, machine: PatternMachine(n), after_input: List(Char)) indices (input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction))
    AcceptedPathNow : AcceptedPathView(n, machine, after_input, Nil(), evidence, captures, evidence, Nil())

  type ExactAcceptedPathView(n: Nat, machine: PatternMachine(n), after_input: List(Char)) indices (input: List(Char), current_evidence: List(Evidence), captures: List(CaptureFrame), final_evidence: List(Evidence), routine: List(ExtendedInstruction), path: AcceptingFrom(n, machine, input, after_input, ThreadAccepted(), current_evidence, captures, final_evidence, routine))
    ExactAcceptedPathNow : ExactAcceptedPathView(n, machine, after_input, Nil(), evidence, captures, evidence, Nil(), AcceptingNow())

  @reducible
  fn proof_empty_characters() -> List(Char) = Nil()

  @reducible
  fn empty_evidence() -> List(Evidence) = Nil()

  @reducible
  fn empty_captures() -> List(CaptureFrame) = Nil()

  @reducible
  fn empty_characters() -> List(Char) = Nil()

  @reducible
  fn empty_constraints() -> List(BoundaryConstraint) = Nil()

  fn encodes_character_on(char: Char, @erased rest: List(Evidence)) -> Encodes(CharC, Cons(CharacterEvidence(char), rest), rest) = EncodesCharacter(char)

  fn encodes_many_empty(@erased shape: ShapeCode, @erased rest: List(Evidence)) -> EncodesMany(shape, Cons(BeginListEvidence(), rest), rest) = EncodesManyEmpty()

  ## Any actual member of the predicate transition relation certifies that its
  ## predicate held.  The dependent edge is transported by `with`; in the false
  ## branch its destination list is definitionally empty.
  type PredicateTransitionTruth indices (test: Char -> Bool, char: Char)
    PredicateTransitionHeld : (proof: Equivalent(Bool, test(char), True())) -> PredicateTransitionTruth(test, char)

  ## Invert the two list transformations used by Thompson alternation.  The
  ## result retains the exact child edge and records whether the combined state
  ## is an injected active state or an accepting state whose routine has the
  ## branch marker appended.  Recursive path projection uses these relations
  ## instead of guessing from a combined state's runtime representation.
  type AppendMemberOrigin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) indices (value: MachineState(n))
    AppendMemberLeft : (edge: ListMember(MachineState(n), value, left)) -> AppendMemberOrigin(n, left, right, value)
    AppendMemberRight : (edge: ListMember(MachineState(n), value, right)) -> AppendMemberOrigin(n, left, right, value)

  fn lift_append_right_member(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), value: MachineState(n), edge: ListMember(MachineState(n), value, right)) -> ListMember(MachineState(n), value, append_machine_states(n, left, right)) = match left
    Nil() -> edge
    Cons(head, rest) -> member_there(head, lift_append_right_member(n, rest, right, value, edge))

  ## Repetition re-enters only active child starts.  This inversion retains the
  ## exact child start edge and the routine/constraint prefix contributed by the
  ## just-completed iteration.
  type EnterRepeatStateOrigin(n: Nat, routine: List(EvidenceInstruction), constraints: List(BoundaryConstraint), starts: List(MachineState(n))) indices (entered: MachineState(n))
    EnterRepeatActiveOrigin : (state: Bounded(n)) -> (start_routine: List(EvidenceInstruction)) -> (start_constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> EnterRepeatStateOrigin(n, routine, constraints, starts, Active(state, append_routine(routine, start_routine), append_constraints(constraints, start_constraints)))

  ## Lift one complete child path as the final item of a Repeat continuation.
  ## Active steps retain their routines and executions; the unique accepted
  ## step appends `EndList`, closes the evidence list, and becomes the Repeat
  ## machine's accepted destination.
  type ExactRepeatChildActivePathView(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), after_input: List(Char), source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence)) indices (input: List(Char), routine: List(ExtendedInstruction), path: AcceptingFrom(n, MkPatternMachine(starts, next), input, after_input, ThreadActive(source), current_evidence, current_captures, child_final_evidence, routine))
    ExactRepeatChildNextActive : (char: Char) -> (rest: List(Char)) -> (destination: Bounded(n)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge: ListMember(MachineState(n), Active(destination, regular, constraints), machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input)))) -> (execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures)) -> (suffix: AcceptingFrom(n, MkPatternMachine(starts, next), rest, after_input, ThreadActive(destination), destination_evidence, destination_captures, child_final_evidence, suffix_routine)) -> ExactRepeatChildActivePathView(n, starts, next, after_input, source, current_evidence, current_captures, child_final_evidence, Cons(char, rest), append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix))
    ExactRepeatChildNextAccepted : (char: Char) -> (rest: List(Char)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge: ListMember(MachineState(n), Accepted(regular, constraints), machine_destinations(n, MkPatternMachine(starts, next), ThreadActive(source), char, transition_boundary_before(char, rest, after_input)))) -> (execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures)) -> (suffix: AcceptingFrom(n, MkPatternMachine(starts, next), rest, after_input, ThreadAccepted(), destination_evidence, destination_captures, child_final_evidence, suffix_routine)) -> ExactRepeatChildActivePathView(n, starts, next, after_input, source, current_evidence, current_captures, child_final_evidence, Cons(char, rest), append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix))

  type RepeatClosingPathEmbedding(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame), child_final_evidence: List(Evidence)) indices (input: List(Char), after_input: List(Char))
    RepeatClosingPathLifted : (routine: List(ExtendedInstruction)) -> (path: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), input, after_input, ThreadActive(source), current_evidence, current_captures, Cons(EndListEvidence(), child_final_evidence), routine)) -> RepeatClosingPathEmbedding(n, starts, next, lazy, source, current_evidence, current_captures, child_final_evidence, input, after_input)

  ## A recursive Repeat continuation begins at an ordinary child start but its
  ## path already runs in the Repeat machine.  This is precisely the induction
  ## hypothesis required to splice a preceding child without reopening the
  ## evidence list.
  type RepeatContinuationFrom(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices ()
    RepeatContinuationActive : (state: Bounded(n)) -> (start_regular: List(EvidenceInstruction)) -> (start_evidence: List(Evidence)) -> (start_captures: List(CaptureFrame)) -> (final_evidence: List(Evidence)) -> (path_routine: List(ExtendedInstruction)) -> (start_edge: ListMember(MachineState(n), Active(state, start_regular, Nil()), initial_machine_destinations(n, MkPatternMachine(starts, next), position, input, after_input))) -> (start_execution: RoutineExecution(start_regular, input_evidence, input_captures, start_evidence, start_captures)) -> (path: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), input, after_input, ThreadActive(state), start_evidence, start_captures, final_evidence, path_routine)) -> RepeatContinuationFrom(n, starts, next, lazy, position, input, after_input, input_evidence, input_captures)

  type CompletedRepeatContinuation(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, position: InitialPosition, input: List(Char), after_input: List(Char), input_evidence: List(Evidence), input_captures: List(CaptureFrame)) indices ()
    RepeatContinuationAccepted : (final_evidence: List(Evidence)) -> (acceptance: AcceptancePathFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), position, input, after_input, input_evidence, input_captures, final_evidence)) -> CompletedRepeatContinuation(n, starts, next, lazy, position, input, after_input, input_evidence, input_captures)

  type RepeatReentryPathEmbedding(n: Nat, starts: List(MachineState(n)), next: (Bounded(n)) -> Char -> List(MachineState(n)), lazy: Bool, source: Bounded(n), current_evidence: List(Evidence), current_captures: List(CaptureFrame)) indices (child_input: List(Char), remaining_input: List(Char), after_input: List(Char))
    RepeatReentryPathLifted : (final_evidence: List(Evidence)) -> (routine: List(ExtendedInstruction)) -> (path: AcceptingFrom(n, repeat_pattern_machine(n, MkPatternMachine(starts, next), lazy), append_characters(child_input, remaining_input), after_input, ThreadActive(source), current_evidence, current_captures, final_evidence, routine)) -> RepeatReentryPathEmbedding(n, starts, next, lazy, source, current_evidence, current_captures, child_input, remaining_input, after_input)

  ## Invert the full `repeat_destinations` map while retaining the exact child
  ## edge. Active child destinations pass through unchanged; accepted child
  ## destinations either close the list or re-enter an active child start.
  type RepeatDestinationsOrigin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool) indices (destination: MachineState(n))
    RepeatChildActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), destinations)) -> RepeatDestinationsOrigin(n, destinations, starts, lazy, Active(state, routine, constraints))
    RepeatChildClosingOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> RepeatDestinationsOrigin(n, destinations, starts, lazy, Accepted(append_routine(routine, Cons(EndList(), Nil())), constraints))
    RepeatChildReenteredOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> (state: Bounded(n)) -> (start_routine: List(EvidenceInstruction)) -> (start_constraints: List(BoundaryConstraint)) -> (start_edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> RepeatDestinationsOrigin(n, destinations, starts, lazy, Active(state, append_routine(routine, start_routine), append_constraints(constraints, start_constraints)))

  type FilteredRepeatDestinationsOrigin(n: Nat, destinations: List(MachineState(n)), starts: List(MachineState(n)), lazy: Bool, boundary: Boundary) indices (filtered: MachineState(n))
    FilteredRepeatChildActiveOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), destinations)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Active(state, routine, Nil()))
    FilteredRepeatAcceptingOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Accepted(append_routine(routine, Cons(EndList(), Nil())), Nil()))
    FilteredRepeatReenteredOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Accepted(routine, constraints), destinations)) -> (state: Bounded(n)) -> (start_routine: List(EvidenceInstruction)) -> (start_constraints: List(BoundaryConstraint)) -> (start_edge: ListMember(MachineState(n), Active(state, start_routine, start_constraints), starts)) -> (holds: Equivalent(Bool, constraints_hold(append_constraints(constraints, start_constraints), boundary), True())) -> FilteredRepeatDestinationsOrigin(n, destinations, starts, lazy, boundary, Active(state, append_routine(routine, start_routine), Nil()))

  type RepeatStartsOrigin(n: Nat, starts: List(MachineState(n)), lazy: Bool) indices (destination: MachineState(n))
    RepeatEmptyStartOrigin : RepeatStartsOrigin(n, starts, lazy, Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()))
    RepeatEnteredStartOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> RepeatStartsOrigin(n, starts, lazy, Active(state, Cons(BeginList(), routine), constraints))

  type FilteredRepeatStartsOrigin(n: Nat, starts: List(MachineState(n)), lazy: Bool, boundary: Boundary) indices (filtered: MachineState(n))
    FilteredRepeatEmptyStartOrigin : FilteredRepeatStartsOrigin(n, starts, lazy, boundary, Accepted(Cons(BeginList(), Cons(EndList(), Nil())), Nil()))
    FilteredRepeatEnteredStartOrigin : (state: Bounded(n)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(n), Active(state, routine, constraints), starts)) -> (holds: Equivalent(Bool, constraints_hold(constraints, boundary), True())) -> FilteredRepeatStartsOrigin(n, starts, lazy, boundary, Active(state, Cons(BeginList(), routine), Nil()))

  type FilteredAppendMemberOrigin(n: Nat, left: List(MachineState(n)), right: List(MachineState(n))) indices (value: MachineState(n))
    FilteredAppendMemberLeft : (edge: ListMember(MachineState(n), value, left)) -> FilteredAppendMemberOrigin(n, left, right, value)
    FilteredAppendMemberRight : (edge: ListMember(MachineState(n), value, right)) -> FilteredAppendMemberOrigin(n, left, right, value)

  fn lift_filtered_append_right_member(n: Nat, left: List(MachineState(n)), right: List(MachineState(n)), boundary: Boundary, value: MachineState(n), edge: ListMember(MachineState(n), value, filter_machine_states(n, right, boundary))) -> ListMember(MachineState(n), value, filter_machine_states(n, append_machine_states(n, left, right), boundary)) = match left
    Nil() -> edge
    Cons(Active(state, routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> member_there(Active(state, routine, Nil()), lift_filtered_append_right_member(n, rest, right, boundary, value, edge))
      False() -> lift_filtered_append_right_member(n, rest, right, boundary, value, edge)
    Cons(Accepted(routine, constraints), rest) -> with constraints_hold(constraints, boundary)
      True() -> member_there(Accepted(routine, Nil()), lift_filtered_append_right_member(n, rest, right, boundary, value, edge))
      False() -> lift_filtered_append_right_member(n, rest, right, boundary, value, edge)

  type LeftMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(left_count))) indices (combined: MachineState(plus(left_count, right_count)))
    LeftMarkedActiveOrigin : (state: Bounded(left_count)) -> (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Active(state, routine, constraints), states)) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, Active(inject_alternate_left(left_count, right_count, state), routine, constraints))
    LeftMarkedAcceptedOrigin : (routine: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (edge: ListMember(MachineState(left_count), Accepted(routine, constraints), states)) -> LeftMarkedStateOrigin(left_count, right_count, marker, states, Accepted(append_branch_marker(routine, marker), constraints))

  type RightMarkedStateOrigin(left_count: Nat, right_count: Nat, marker: EvidenceInstruction, states: List(MachineState(right_count))) indices (combined: MachineState(plus(left_count, right_count)))
