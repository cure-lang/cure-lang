    reflexive() -> first

  type PredicateAcceptedEdgeView indices (test: Char -> Bool, char: Char, regular: List(EvidenceInstruction), constraints: List(BoundaryConstraint))
    PredicateAcceptedEdgeExact : PredicateAcceptedEdgeView(test, char, Cons(EmitChar(char), Nil()), Nil())

  type PredicateCaptureExecutionView indices (test: Char -> Bool, char: Char, input_evidence: List(Evidence), input_captures: List(CaptureFrame), output_evidence: List(Evidence), output_captures: List(CaptureFrame))
