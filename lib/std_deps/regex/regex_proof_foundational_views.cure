    ConcatLeftActiveNextActive : (char: Char) -> (rest: List(Char)) -> (destination: Bounded(left_count)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge: ListMember(MachineState(left_count), Active(destination, regular, constraints), machine_destinations(left_count, MkPatternMachine(left_starts, left_next), ThreadActive(source), char, transition_boundary_before(char, rest, append_characters(right_input, after_input))))) -> (execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures)) -> (suffix: AcceptingFrom(left_count, MkPatternMachine(left_starts, left_next), rest, append_characters(right_input, after_input), ThreadActive(destination), destination_evidence, destination_captures, left_final_evidence, suffix_routine)) -> (left_final_captures: List(CaptureFrame)) -> (left_captures_exact: Equivalent(List(CaptureFrame), left_final_captures, accepting_final_captures(left_count, MkPatternMachine(left_starts, left_next), Cons(char, rest), append_characters(right_input, after_input), ThreadActive(source), current_evidence, current_captures, left_final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextActive(destination, regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix)))) -> (right_acceptance: AcceptancePathFrom(right_count, MkPatternMachine(right_starts, right_next), advance_initial_position(position, Cons(char, rest)), right_input, after_input, left_final_evidence, left_final_captures, right_final_evidence)) -> ConcatLeftActiveInputView(left_count, left_starts, left_next, right_count, right_starts, right_next, position, right_input, after_input, source, current_evidence, current_captures, left_final_evidence, right_final_evidence, Cons(char, rest))
    ConcatLeftActiveNextAccepted : (char: Char) -> (rest: List(Char)) -> (regular: List(EvidenceInstruction)) -> (constraints: List(BoundaryConstraint)) -> (destination_evidence: List(Evidence)) -> (destination_captures: List(CaptureFrame)) -> (suffix_routine: List(ExtendedInstruction)) -> (edge: ListMember(MachineState(left_count), Accepted(regular, constraints), machine_destinations(left_count, MkPatternMachine(left_starts, left_next), ThreadActive(source), char, transition_boundary_before(char, rest, append_characters(right_input, after_input))))) -> (execution: RoutineExecution(regular, current_evidence, record_capture_char(current_captures, char), destination_evidence, destination_captures)) -> (suffix: AcceptingFrom(left_count, MkPatternMachine(left_starts, left_next), rest, append_characters(right_input, after_input), ThreadAccepted(), destination_evidence, destination_captures, left_final_evidence, suffix_routine)) -> (left_final_captures: List(CaptureFrame)) -> (left_captures_exact: Equivalent(List(CaptureFrame), left_final_captures, accepting_final_captures(left_count, MkPatternMachine(left_starts, left_next), Cons(char, rest), append_characters(right_input, after_input), ThreadActive(source), current_evidence, current_captures, left_final_evidence, append_extended_routines(transition_routine(char, regular), suffix_routine), AcceptingNextAccepted(regular, constraints, destination_evidence, destination_captures, suffix_routine, edge, execution, suffix)))) -> (right_acceptance: AcceptancePathFrom(right_count, MkPatternMachine(right_starts, right_next), advance_initial_position(position, Cons(char, rest)), right_input, after_input, left_final_evidence, left_final_captures, right_final_evidence)) -> ConcatLeftActiveInputView(left_count, left_starts, left_next, right_count, right_starts, right_next, position, right_input, after_input, source, current_evidence, current_captures, left_final_evidence, right_final_evidence, Cons(char, rest))

  type ConcatLeftActiveMachinesView(left_count: Nat, right_count: Nat, position: InitialPosition, left_input: List(Char), right_input: List(Char), after_input: List(Char), source: Bounded(left_count), current_evidence: List(Evidence), current_captures: List(CaptureFrame), left_final_evidence: List(Evidence), left_path_routine: List(ExtendedInstruction), right_final_evidence: List(Evidence)) indices (left_machine: PatternMachine(left_count), right_machine: PatternMachine(right_count))
