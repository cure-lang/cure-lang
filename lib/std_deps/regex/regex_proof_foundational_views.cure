  type ThompsonEvidenceProof indices (shape: ShapeCode, compilation: ThompsonCompilation(shape))
    ThompsonEvidenceEmpty : ThompsonEvidenceProof(UnitC(), ThompsonEmpty())
    ThompsonEvidenceBoundary : (constraint: BoundaryConstraint) -> ThompsonEvidenceProof(UnitC(), ThompsonBoundary(constraint))
    ThompsonEvidencePredicate : (test: (Char -> Bool)) -> ThompsonEvidenceProof(CharC(), ThompsonPredicate(test))
    ThompsonEvidenceConcat : {@erased left_shape: ShapeCode} -> {@erased right_shape: ShapeCode} -> (left: ThompsonCompilation(left_shape)) -> (right: ThompsonCompilation(right_shape)) -> (left_proof: ThompsonEvidenceProof(left_shape, left)) -> (right_proof: ThompsonEvidenceProof(right_shape, right)) -> ThompsonEvidenceProof(PairC(left_shape, right_shape), ThompsonConcat(left, right))
    ThompsonEvidenceGroup : {@erased inner_shape: ShapeCode} -> (inner: ThompsonCompilation(inner_shape)) -> (inner_proof: ThompsonEvidenceProof(inner_shape, inner)) -> ThompsonEvidenceProof(StringC(), ThompsonGroup(inner))
    ThompsonEvidenceAlternate : {@erased left_shape: ShapeCode} -> {@erased right_shape: ShapeCode} -> (left: ThompsonCompilation(left_shape)) -> (right: ThompsonCompilation(right_shape)) -> (prefer_right: Bool) -> (left_proof: ThompsonEvidenceProof(left_shape, left)) -> (right_proof: ThompsonEvidenceProof(right_shape, right)) -> ThompsonEvidenceProof(ChoiceC(left_shape, right_shape), ThompsonAlternate(left, right, prefer_right))
    ThompsonEvidenceRepeat : {@erased inner_shape: ShapeCode} -> (inner: ThompsonCompilation(inner_shape)) -> (lazy: Bool) -> (inner_proof: ThompsonEvidenceProof(inner_shape, inner)) -> ThompsonEvidenceProof(ListC(inner_shape), ThompsonRepeat(inner, lazy))

  @reducible
  fn record_capture_input(captures: List(CaptureFrame), input: List(Char)) -> List(CaptureFrame) = match input
    Nil() -> captures
    Cons(char, rest) -> record_capture_input(record_capture_char(captures, char), rest)

