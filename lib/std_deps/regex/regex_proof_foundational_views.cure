    reflexive() -> first

  fn capture_equivalent_transitive_inferred(left: List(CaptureFrame), right: List(CaptureFrame), {middle: List(CaptureFrame)}, first: Equivalent(List(CaptureFrame), left, middle), second: Equivalent(List(CaptureFrame), middle, right)) -> Equivalent(List(CaptureFrame), left, right) = match first
    reflexive() -> second

