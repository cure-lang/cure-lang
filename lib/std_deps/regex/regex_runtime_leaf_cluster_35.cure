  ## A non-empty rejected tail may carry an active child whose destination
  ## cursor is already exhausted.  The parent rejection and selected trace are
  ## refined together at this construction site; the child refutation,
  ## selected-child suffix, and child trace then feed the canonical exhausted
  ## child eliminator without promoting any proof tag into runtime control.
  fn atomic_path_tail_active_child_destinations_exhausted_excludes_selected_suffix(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased child_prefix: AtomicPathFailurePrefixEvidence(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      Nil(),
      child_prefix_kind
    ),
    child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      Nil(),
      AtomicPathFailureDestinationsExhausted()
    ),
    child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, Nil()),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    child_selected_current: List(LookaroundAdmittedState(n)),
    child_selection_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    matched: List(Char),
    remaining_input: List(Char),
    selected_routine: List(ExtendedInstruction),
    child_selected_routine: List(ExtendedInstruction),
    child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    right_case: () -> Empty
  ) -> Empty = atomic_path_tail_active_child_failure_dispatch(
    machine,
    char,
    child_char,
    child_rest,
    after_input,
    source,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    active_state,
    active_routine,
    active_constraints,
    active_assertion_routine,
    active_assertion_markers,
    active_nested_decisions,
    tail_remaining,
    tail_failure,
    child_whole,
    Nil(),
    child_prefix_kind,
    child_prefix,
    AtomicPathFailureDestinationsExhausted(),
    child_failure,
    child_suffix,
    child_failure_origin,
    child_failure_origin_equivalence,
    child_failure_origin_canonical,
    child_selected_origin,
    child_selected_origin_canonical,
    child_selected_current,
    child_selection_suffix,
    selected_remaining,
    matched,
    remaining_input,
    selected_routine,
    child_selected_routine,
    child_path,
    path,
    right_case,
    right_case,
    right_case
  )

  @reducible
  fn atomic_path_active_child_rejection_excludes_aligned_trace(
    {@erased depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    destination: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    child_scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    @erased failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure_current: List(LookaroundAdmittedState(n)),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    selected_whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      failure_current,
      AtomicPathFailureDestinationRejected()
    ),
    {child_path_current: List(LookaroundAdmittedState(n))},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      child_path_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = match child_failure
    AtomicPathDestinationRejected(
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _, _, _, _,
      _,
      _child_origin_canonical,
      _,
      _,
      _,
      _,
      _,
      _,
      _,
      _
    ) ->
      atomic_path_active_child_rejection_head_excludes_trace(
        failure_whole,
        failure_current,
        failure_suffix,
        failure_nonempty,
        selected_whole,
        selected_whole_equivalence,
        selected_suffix,
        left_case,
        left_tail_case,
        right_case
      )

  ## First-order induction over a rejected destination's sibling tail.  The
  ## selected trace is either aligned with the rejected head (the supplied
  ## construction-site contradiction) or starts in the tail.  In the latter
  ## case the refutation's own tail is structurally smaller, so the canonical
  ## fold consumes it without packing an existential callback or opening an
  ## erased failure kind.  This construction-site boundary supplies the
  ## aligned and tail contradictions to that fold; destination exhaustion is
  ## its recursive base, while input exhaustion and exact acceptance are
  ## excluded by the active/non-empty indices before any runtime branch can be
  ## generated.
  @reducible
  fn atomic_path_destination_rejection_excludes_recursive_tail_induction(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    rest: List(Char),
    after_input: List(Char),
    state: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    @erased candidate: LookaroundAdmittedState(n),
    {remaining: List(LookaroundAdmittedState(n))},
    @erased failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(candidate, remaining),
      AtomicPathFailureDestinationRejected()
    ),
    {candidate_current: List(LookaroundAdmittedState(n))},
    @erased matched: List(Char),
    @erased remaining_input: List(Char),
    @erased routine: List(ExtendedInstruction),
    selection_from_current: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(candidate, remaining),
      candidate_current
    ),
    @erased tail_alignment: LookaroundAdmittedStateCursorSuffix(
      n,
      remaining,
      candidate_current
    ),
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, rest),
      after_input,
      ThreadActive(state),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      candidate_current,
      matched,
      remaining_input,
      routine
    ),
    head_case: Empty,
    tail_case: Empty
  ) -> Empty = atomic_path_destination_rejection_excludes_recursive_tail_rejected(
    machine,
    char,
    rest,
    after_input,
    state,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    candidate,
    failure,
    matched,
    remaining_input,
    routine,
    selection_from_current,
    tail_alignment,
    path,
    head_case,
    tail_case
  )
end
