## Proof infrastructure for the typed regular-expression evidence machine.
## These views expose the structural laws used to assemble and invert compiled
## evidence routines while retaining their dependent input and output indices.
@group(:text)
mod Std.Regex.Proof.SingleCharacterString
  use Std.Regex.Proof.EquivalenceLaws

  use Std.Regex.Proof.MarkerExecution

  use Std.Regex.Runtime.MemberTransport

  use Std.Regex.Runtime.MachineSearch

  use Std.Regex.Runtime.MachineTransitions

  use Std.Regex.Runtime.MachineEntry

  use Std.Regex.Runtime.Conversion

  use Std.Regex.Runtime.ProgramTypes

  use Std.Regex.Runtime.PublicTypes

  use Std.Regex.Runtime.NewlinePolicy

  use Std.Regex.Runtime.EvidenceThreads

  use Std.Regex.Runtime.LookaroundContext

  use Std.Regex.Runtime.AtomicPlan

  use Std.Regex.Runtime.Compiler

  use Std.Regex.Runtime.NamedCapture

  use Std.Regex.Runtime.Evidence

  use Std.Regex.Runtime.Position

  use Std.Regex.Runtime.CharacterPredicates

  use Std.Regex.Runtime.SubjectContext

  use Std.Regex.Runtime.MachineFilters

  use Std.Regex.Runtime.MachineLaws

  use Std.Regex.Runtime.Compilation

  use Std.Regex.Runtime.StagedOps

  use Std.Regex.Runtime.PatternMachines

  use Std.Regex.Runtime.StateOps

  use Std.Regex.Runtime.TransitionRows

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Regex.Runtime

  use Std.Equivalent

  @reducible
  fn single_character_string(char: Char) -> String = Std.String.from_characters(Cons(char, Nil()))
end
