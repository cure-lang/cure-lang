  ## Wire the concrete accepted-root contradiction into the public
  ## selected-trace consumer. Accepted roots consume a non-empty exact child
  ## input, so the package carries the child refutation and cursor suffix that
  ## the exact-child eliminator needs. The root wrapper, package, failure,
  ## evidence, witness, membership, and selected trace all share one indexed
  ## accepted-head spine.
  @reducible
  fn atomic_start_refutation_rejected_accepted_selected_trace(
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    position: InitialPosition,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    reversed_prefix: List(Char),
    accepted_routine: List(EvidenceInstruction),
    accepted_constraints: List(BoundaryConstraint),
    accepted_assertion_routine: List(ExtendedInstruction),
    accepted_assertion_markers: List(EvidenceInstruction),
    accepted_nested_decisions: List(LookaroundNestedDecision),
    rest: List(LookaroundAdmittedState(n)),
    selected_start: LookaroundAdmittedState(n),
    {@erased blocked_depth: Option(Nat)},
    {@erased kind: AtomicStartSkipKind},
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {selected_routine: List(ExtendedInstruction)},
    @erased _refutation: AtomicStartRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    {child_whole: List(LookaroundAdmittedState(n))},
    {child_current: List(LookaroundAdmittedState(n))},
    @erased package: AtomicStartAcceptedRejectedTailPackage(
      depth,
      n,
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      child_whole,
      child_current
    ),
    @erased failure: AtomicStartMembersRefutation(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased evidence: AtomicStartNoEvidence(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      AtomicStartFailureRejected()
    ),
    @erased witness: AtomicSelectedStartWitness(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      selected_start,
      blocked_depth,
      kind,
      matched,
      remaining_input,
      selected_routine
    ),
    membership: ListMember(
      LookaroundAdmittedState(n),
      selected_start,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest)
    ),
    @erased path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions),
      matched,
      remaining_input,
      selected_routine
    ),
    @erased selected_path: AtomicSelectedTrace(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    ),
    sibling_tail_case: (AtomicStartSelectedTailPackage(
      depth,
      n,
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), rest),
      rest,
      selected_start,
      matched,
      remaining_input,
      selected_routine
    )) -> Empty
  ) -> Empty = let head_case: Empty = atomic_start_rejected_member_there_nonempty_tail_accepted_excludes_trace(
      machine,
      position,
      child_char,
      child_rest,
      after_input,
      history,
      capture_context,
      policy,
      reversed_prefix,
      accepted_routine,
      accepted_constraints,
      accepted_assertion_routine,
      accepted_assertion_markers,
      accepted_nested_decisions,
      package,
      membership,
      path,
      selected_path,
      sibling_tail_case
    )
    atomic_start_refutation_excludes_selected_trace(
      machine,
      position,
      Cons(child_char, child_rest),
      after_input,
      history,
      capture_context,
      policy,
      False(),
      reversed_prefix,
      _refutation,
      failure,
      evidence,
      witness,
      membership,
      selected_path,
      head_case,
      sibling_tail_case
    )

  ## Recurse over an arbitrary sibling tail before consuming the selected
  ## active child.  The selected-tail cursor is the induction index; the
  ## generic fold keeps each existential tail failure at its construction
  ## site and hands the adjacent selected candidate to the base consumer.
  @reducible
  fn atomic_path_tail_active_child_rejection_excludes_selected_suffix(
    {result: Type},
    {depth: Nat},
    {n: Nat},
    machine: PatternMachine(n),
    char: Char,
    child_char: Char,
    child_rest: List(Char),
    after_input: List(Char),
    source: Bounded(n),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    scope_depth: Nat,
    prefix_mode: Bool,
    reversed_prefix: List(Char),
    whole: List(LookaroundAdmittedState(n)),
    {@erased head: LookaroundAdmittedState(n)},
    active_state: Bounded(n),
    active_routine: List(EvidenceInstruction),
    active_constraints: List(BoundaryConstraint),
    active_assertion_routine: List(ExtendedInstruction),
    active_assertion_markers: List(EvidenceInstruction),
    active_nested_decisions: List(LookaroundNestedDecision),
    tail_remaining: List(LookaroundAdmittedState(n)),
    @erased tail_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      whole,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      AtomicPathFailureDestinationRejected()
    ),
    child_whole: List(LookaroundAdmittedState(n)),
    child_current: List(LookaroundAdmittedState(n)),
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_whole,
      child_current,
      AtomicPathFailureDestinationRejected()
    ),
    @erased child_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_suffix: LookaroundAdmittedStateCursorSuffix(n, child_whole, child_current),
    child_failure_head: LookaroundAdmittedState(n),
    child_failure_tail: List(LookaroundAdmittedState(n)),
    child_failure_nonempty_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      Cons(child_failure_head, child_failure_tail)
    ),
    child_failure_origin: List(LookaroundAdmittedState(n)),
    child_failure_origin_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      child_whole,
      child_failure_origin
    ),
    child_failure_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_failure_origin
    ),
    child_selected_origin: List(LookaroundAdmittedState(n)),
    child_selected_origin_canonical: AtomicPathSearchOrigin(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      child_selected_origin
    ),
    {child_selected_current: List(LookaroundAdmittedState(n))},
    child_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      child_selected_origin,
      child_selected_current
    ),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(active_state),
      history_push_bounded(history, char),
      append_routine(append_routine(capture_context, active_routine), active_assertion_markers),
      policy,
      atomic_scope_depth_after(active_routine, scope_depth),
      prefix_mode,
      Cons(char, reversed_prefix),
      child_selected_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    selected_remaining: List(LookaroundAdmittedState(n)),
    _tail_selected_suffix: LookaroundAdmittedStateCursorSuffix(
      n,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), tail_remaining),
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining)
    ),
    {selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(char, Cons(child_char, child_rest)),
      after_input,
      ThreadActive(source),
      history,
      capture_context,
      policy,
      scope_depth,
      prefix_mode,
      reversed_prefix,
      Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), selected_remaining),
      matched,
      remaining_input,
      selected_routine
    ),
    child_left_case: () -> Empty,
    child_left_tail_case: () -> Empty,
    child_right_case: () -> Empty
  ) -> Empty = atomic_path_rejected_tail_fold_to_active(
    machine,
    char,
    child_char,
    child_rest,
    after_input,
    source,
    history,
    capture_context,
    policy,
    scope_depth,
    prefix_mode,
    reversed_prefix,
    whole,
    tail_failure,
    active_state,
    active_routine,
    active_constraints,
    active_assertion_routine,
    active_assertion_markers,
    active_nested_decisions,
    child_whole,
    child_current,
    child_failure,
    child_suffix,
    child_failure_suffix,
    child_failure_head,
    child_failure_tail,
    child_failure_nonempty_equivalence,
    child_failure_origin,
    child_failure_origin_equivalence,
    child_failure_origin_canonical,
    child_selected_origin,
    child_selected_origin_canonical,
    child_selected_suffix,
    child_path,
    selected_remaining,
    _tail_selected_suffix,
    path,
    child_left_case,
    child_left_tail_case,
    child_right_case
  )
end
