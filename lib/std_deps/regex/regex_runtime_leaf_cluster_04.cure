  ## A commit-cause kind fixes exactly one constructor.  These projections are
  ## therefore safe across an erased cause: unlike the rejected generic
  ## projection, none of them performs runtime case analysis on proof data.
  @reducible
  fn atomic_path_commit_after_failure_nonempty(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased input: List(Char)}, {@erased after_input: List(Char)},
    {@erased state: ThreadState(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased current: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    {@erased child_prefix_kind: AtomicPathFailurePrefixKind},
    {@erased child_kind: AtomicPathFailureKind},
    @erased cause: AtomicPathCommitCause(depth, n, machine, input, after_input, state, history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, current, commit_depth, AtomicPathCommitAfterFailureKind(child_prefix_kind, child_kind))
  ) -> LookaroundAdmittedNonempty(n, current) = match cause
    AtomicPathCommitAfterFailure(_, _, _, candidate, remaining, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> LookaroundAdmittedNonemptyPacked(candidate, remaining, reflexive(Cons(candidate, remaining)))

