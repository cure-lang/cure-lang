  ) -> LookaroundAdmittedNonempty(n, current) = match cause
    AtomicPathCommitFromChild(_, _, _, candidate, remaining, _, _, _, _, _, _, _, _, _, _, _, _) -> LookaroundAdmittedNonemptyPacked(candidate, remaining, reflexive(Cons(candidate, remaining)))

