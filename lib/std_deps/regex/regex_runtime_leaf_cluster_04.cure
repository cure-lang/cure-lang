  ## Terminal leaf for the escaped-head/selected-head contradiction.  The
  ## skipped head records a child commitment whose local rejected candidate
  ## ran out of input. Selecting that same outer head exposes the child trace;
  ## the recursively indexed cause kind fixes both erased constructors before
  ## the input-exhaustion eliminator consumes them.
  @reducible
  fn atomic_path_escaped_skipped_head_after_input_exhausted_excludes_selected_trace(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased active_state: Bounded(n)},
    {@erased active_routine: List(EvidenceInstruction)},
    {@erased active_constraints: List(BoundaryConstraint)},
    {@erased active_assertion_routine: List(ExtendedInstruction)},
    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased current: List(LookaroundAdmittedState(n))},
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased package: AtomicPathEscapedSkippedHeadPackage(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), current), current, AtomicPathSkippedPrefixEscapedOneKind(AtomicPathCommitAfterFailureKind(child_prefix_kind, AtomicPathFailureInputExhausted()))),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), current), matched, remaining_input, selected_routine),
    trace_package: AtomicSelectedPathTracePackage(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), current), matched, remaining_input, selected_routine, path)
  ) -> Empty = match package
    AtomicPathEscapedSkippedHeadPacked(_) -> match trace_package
      AtomicSelectedPathTracePrefixDonePacked() -> impossible
      AtomicSelectedPathTraceExactDonePacked() -> impossible
      AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix_package, _) -> match suffix_package
        AtomicSelectedPathTracePrefixDonePacked() -> impossible
        AtomicSelectedPathTraceExactDonePacked() -> impossible
        AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
        AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## Accepted-thread dual of the exhausted-input leaf.  A successful selection
  ## of the same accepted outer head would expose a selected child trace at an
  ## accepted thread with input still remaining, for which the trace family has
  ## no constructor.
  @reducible
  fn atomic_path_escaped_skipped_head_after_exact_accepted_excludes_selected_trace(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased child_char: Char},
    {@erased child_rest: List(Char)}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased accepted_routine: List(EvidenceInstruction)},
    {@erased accepted_constraints: List(BoundaryConstraint)},
    {@erased accepted_assertion_routine: List(ExtendedInstruction)},
    {@erased accepted_assertion_markers: List(EvidenceInstruction)},
    {@erased accepted_nested_decisions: List(LookaroundNestedDecision)},
    {@erased current: List(LookaroundAdmittedState(n))},
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased package: AtomicPathEscapedSkippedHeadPackage(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, False(), reversed_prefix, whole, Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), current), current, AtomicPathSkippedPrefixEscapedOneKind(AtomicPathCommitAfterFailureKind(child_prefix_kind, AtomicPathFailureExactAccepted()))),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, False(), reversed_prefix, Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), current), matched, remaining_input, selected_routine),
    trace_package: AtomicSelectedPathTracePackage(depth, n, machine, Cons(char, Cons(child_char, child_rest)), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, False(), reversed_prefix, Cons(LookaroundAdmittedAccepted(accepted_routine, accepted_constraints, accepted_assertion_routine, accepted_assertion_markers, accepted_nested_decisions), current), matched, remaining_input, selected_routine, path)
  ) -> Empty = match package
    AtomicPathEscapedSkippedHeadPacked(_) -> match trace_package
      AtomicSelectedPathTracePrefixDonePacked() -> impossible
      AtomicSelectedPathTraceExactDonePacked() -> impossible
      AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
      AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, suffix_package, _) -> match suffix_package
        AtomicSelectedPathTracePrefixDonePacked() -> impossible
        AtomicSelectedPathTraceExactDonePacked() -> impossible
        AtomicSelectedPathTraceActivePacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
        AtomicSelectedPathTraceAcceptedPacked(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible

  ## Same-cursor versions of the two terminal local-failure leaves. These are
  ## consumed after canonical commit/selection alignment has rewritten the
  ## selected child cursor to the commit cursor.
  @reducible
  fn atomic_path_commit_after_input_exhausted_excludes_aligned_selected_trace(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    {@erased char: Char}, {@erased after_input: List(Char)},
    {@erased source: Bounded(n)}, {@erased history: List(Char)},
    {@erased capture_context: List(EvidenceInstruction)},
    {@erased policy: NewlinePolicy}, {@erased scope_depth: Nat},
    {@erased prefix_mode: Bool}, {@erased reversed_prefix: List(Char)},
    {@erased whole: List(LookaroundAdmittedState(n))},
    {@erased active_state: Bounded(n)},
    {@erased active_routine: List(EvidenceInstruction)},
    {@erased active_constraints: List(BoundaryConstraint)},
    {@erased active_assertion_routine: List(ExtendedInstruction)},
    {@erased active_assertion_markers: List(EvidenceInstruction)},
    {@erased active_nested_decisions: List(LookaroundNestedDecision)},
    {@erased remaining: List(LookaroundAdmittedState(n))},
    {@erased commit_depth: Nat},
    child_prefix_kind: AtomicPathFailurePrefixKind,
    @erased cause: AtomicPathCommitCause(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, whole, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining), commit_depth, AtomicPathCommitAfterFailureKind(child_prefix_kind, AtomicPathFailureInputExhausted())),
    {@erased matched: List(Char)},
    {@erased remaining_input: List(Char)},
    {@erased selected_routine: List(ExtendedInstruction)},
    @erased path: AtomicSelectedPathTrace(depth, n, machine, Cons(char, Nil()), after_input, ThreadActive(source), history, capture_context, policy, scope_depth, prefix_mode, reversed_prefix, Cons(LookaroundAdmittedActive(active_state, active_routine, active_constraints, active_assertion_routine, active_assertion_markers, active_nested_decisions), remaining), matched, remaining_input, selected_routine)
  ) -> Empty = match cause
    AtomicPathCommitAfterFailure(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> match path
      AtomicSelectedPrefixDone() -> impossible
      AtomicSelectedExactDone() -> impossible
      AtomicSelectedTransitionActive(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_trace) -> atomic_path_input_exhaustion_excludes_trace_erased(child_trace)
      AtomicSelectedTransitionAccepted(_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> impossible
end
