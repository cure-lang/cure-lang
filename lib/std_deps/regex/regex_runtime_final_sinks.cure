  ## Converse direction for exact assertion search.  Any independently
  ## constructed accepting path rules out the evaluator's rejected branch, so
  ## the computed result is constructively known to contain a path.
  fn lookaround_search_path_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    path: LookaroundSearchPath(depth, n, machine, capture_context, starts, input, after_input, history, policy)
  ) -> LookaroundSearchPathCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(failure) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))
    LookaroundSearchResultFound(found_path) -> LookaroundSearchPathComplete(found_path)

  ## The dual theorem says that an independently constructed complete failure
  ## tree forces the evaluator into its rejected branch.
  fn lookaround_search_refutation_completeness(
    depth: Nat,
    n: Nat,
    machine: PatternMachine(n),
    input: List(Char),
    after_input: List(Char),
    history: List(Char),
    capture_context: List(EvidenceInstruction),
    policy: NewlinePolicy,
    starts: List(MachineState(n)),
    result: LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context),
    @erased computed: Equivalent(LookaroundSearchResult(depth, n, machine, starts, input, after_input, history, policy, capture_context), result, lookaround_search_path(depth, n, machine, input, after_input, history, capture_context, policy, starts)),
    failure: LookaroundSearchFailure(depth, n, machine, input, after_input, history, capture_context, policy, starts, starts)
  ) -> LookaroundSearchRefutationCompleteness(depth, n, machine, input, after_input, history, policy, capture_context, starts, result) = match result
    LookaroundSearchResultRejected(found_failure) -> LookaroundSearchRefutationComplete(found_failure)
    LookaroundSearchResultFound(path) -> lookaround_absurd(lookaround_search_failure_excludes_path(depth, n, machine, input, after_input, history, capture_context, policy, failure, path))

  fn atomic_path_recursive_commit_selected_child_same_after_failure_here_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    package: AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePackage(
      depth, n, machine
    ),
    empty_case: (AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(
      depth, n, machine
    )) -> Empty
  ) -> Empty = match package
    AtomicPathRecursiveCommitSelectedChildSameAfterFailureHerePacked(
      _, selected_child, _
    ) -> match selected_child
      AtomicPathSkippedPrefixCursorShapedExistentialPacked(selected_payload) -> match selected_payload
        AtomicPathSkippedPrefixCursorShapedEmptyPacked(structure) -> match structure
          AtomicPathSkippedPrefixStructureEmptyPacked(_) ->
            empty_case(
              AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPacked(package)
            )

  fn atomic_path_recursive_commit_selected_child_same_continuation_package(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    )
  ) -> AtomicPathRecursiveCommitSelectedChildSameContinuationPackage(
    depth, n, machine
  ) = match aligned
    AtomicPathRecursiveCommitSelectedChildSameAlignedActivePacked(
      commit, _, _, _, _, _
    ) -> match commit
      AtomicPathCommitStructureCursorClassifiedAfterFailurePacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSameAfterFailurePacked(aligned)
      AtomicPathCommitStructureCursorClassifiedFromChildPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructureFromChildPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSameFromChildPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_from_child_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastEscapedPacked(child_commit) ->
        match child_commit
          AtomicPathCommitStructureCursorExistentialPacked(
            _, _, child_structure
          ) -> match child_structure
            AtomicPathCommitStructurePastEscapedPacked(
              _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
            ) ->
              AtomicPathRecursiveCommitSelectedChildSamePastEscapedPacked(
                AtomicPathRecursiveCommitSelectedChildSameProjectedPacked(
                  atomic_path_commit_structure_cursor_past_escaped_child_package(
                    child_commit
                  ),
                  aligned
                )
              )
      AtomicPathCommitStructureCursorClassifiedPastRejectedPacked(_) ->
        AtomicPathRecursiveCommitSelectedChildSamePastRejectedPacked(aligned)
    AtomicPathRecursiveCommitSelectedChildSameAlignedAcceptedPacked(
      _, _, _, _, _, _
    ) ->
      AtomicPathRecursiveCommitSelectedChildSameAcceptedImpossiblePacked(
        aligned
      )

  ## Terminal classification has already removed the three local child
  ## terminal kinds before this fold is entered. Descend the relevant selected
  ## skipped-prefix spine to its exact empty tail, retain that correlated
  ## package across child-kind dispatch, and expose only destination rejection
  ## to the recursive consumer. Any inconsistent terminal or commit
  ## classification remains an explicit impossible obligation.
  fn atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    here_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ), AtomicPathRecursiveCommitSelectedChildSameAfterFailureHereEmptyPackage(
      depth, n, machine
    )) -> Empty,
    there_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ), AtomicPathRecursiveCommitSelectedChildSameAfterFailureThereEmptyPackage(
      depth, n, machine
    )) -> Empty,
    reverse_case: (AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ), AtomicPathRecursiveCommitSelectedChildSameAfterFailureReverseEmptyPackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(after_failure_empty) ->
            atomic_path_recursive_commit_selected_child_same_after_failure_empty_kind_dispatch(
              after_failure_empty,
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(destination_rejected) ->
                atomic_path_recursive_commit_selected_child_same_destination_rejected_alignment_fold(
                  aligned,
                  destination_rejected,
                  here_case,
                  there_case,
                  reverse_case,
                  invalid_case
                ),
              invalid_case
            ),
          fn(_) -> invalid_case(),
          invalid_case
      )
    )

  ## Pair-aware companion for the common induction entry.  It follows the
  ## same terminal filtering as the transport-only fold, but publishes both
  ## outcomes of rejected-selection availability through one indexed result.
  ## A missing sibling pair remains a local child case, not permission to
  ## fabricate an induction hypothesis.
  @reducible
  fn atomic_path_recursive_commit_selected_child_same_after_failure_unclassified_pair_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    outcome_case: (AtomicPathActiveChildRejectionOutcome(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(after_failure_empty) ->
            atomic_path_recursive_commit_selected_child_same_after_failure_empty_kind_dispatch(
              after_failure_empty,
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(_) -> invalid_case(),
              fn(destination_rejected) ->
                atomic_path_recursive_commit_selected_child_same_destination_rejected_pair_fold(
                  aligned,
                  destination_rejected,
                  outcome_case,
                  invalid_case
                ),
              invalid_case
            ),
          fn(_) -> invalid_case(),
          invalid_case
        )
    )

  ## PastRejected carries a recursive sibling commit, but its selected prefix
  ## may still expose any of the four relevant constructors. Consume that
  ## prefix structurally before projecting the sibling: the callback receives
  ## one exact empty authority, while AfterFailure and malformed propagated
  ## classifications remain explicit invalid obligations.
  fn atomic_path_recursive_commit_selected_child_same_past_rejected_empty_fold(
    {depth: Nat}, {n: Nat}, {@erased machine: PatternMachine(n)},
    aligned: AtomicPathRecursiveCommitSelectedChildSameAlignedPackage(
      depth, n, machine
    ),
    past_rejected_case: (AtomicPathRecursiveCommitSelectedChildSamePastRejectedReversePackage(
      depth, n, machine
    )) -> Empty,
    invalid_case: () -> Empty
  ) -> Empty =
    atomic_path_recursive_commit_selected_child_same_skipped_tail_empty_fold(
      atomic_path_recursive_commit_selected_child_same_skipped_tail_package(aligned),
      fn(empty) ->
        atomic_path_recursive_commit_selected_child_same_skipped_empty_dispatch(
          empty,
          fn(_) -> invalid_case(),
          fn(past_rejected) ->
            atomic_path_recursive_commit_selected_child_same_past_rejected_reverse_fold(
              past_rejected,
              past_rejected_case,
              invalid_case
            ),
          invalid_case
        )
    )

  ## Consume a recursively rejected active-child refutation at the construction
  ## site. This named boundary retains the child/refutation distinction while
  ## delegating the ordered cursor cases to the single alignment authority.
  ## Keeping the wrapper proof-only avoids rebuilding erased GADT evidence in a
  ## runtime-valued parent fold.
  @reducible
  fn atomic_path_active_child_rejection_excludes_trace(
    {@erased depth: Nat},
    {n: Nat},
    @erased machine: PatternMachine(n),
    @erased child_char: Char,
    @erased child_rest: List(Char),
    @erased after_input: List(Char),
    @erased destination: Bounded(n),
    @erased history: List(Char),
    @erased capture_context: List(EvidenceInstruction),
    @erased policy: NewlinePolicy,
    @erased child_scope_depth: Nat,
    @erased prefix_mode: Bool,
    @erased reversed_prefix: List(Char),
    @erased failure_whole: List(LookaroundAdmittedState(n)),
    @erased failure_current: List(LookaroundAdmittedState(n)),
    failure_suffix: LookaroundAdmittedStateCursorSuffix(n, failure_whole, failure_current),
    @erased failure_nonempty: LookaroundAdmittedNonempty(n, failure_whole),
    @erased selected_whole: List(LookaroundAdmittedState(n)),
    {selected_current: List(LookaroundAdmittedState(n))},
    selected_whole_equivalence: Equivalent(
      List(LookaroundAdmittedState(n)),
      failure_whole,
      selected_whole
    ),
    selected_suffix: LookaroundAdmittedStateCursorSuffix(n, selected_whole, selected_current),
    {matched: List(Char)},
    {remaining_input: List(Char)},
    @erased child_failure: AtomicPathRefutation(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      failure_whole,
      failure_current,
      AtomicPathFailureDestinationRejected()
    ),
    {child_path_current: List(LookaroundAdmittedState(n))},
    {child_selected_routine: List(ExtendedInstruction)},
    @erased child_path: AtomicSelectedPathTrace(
      depth,
      n,
      machine,
      Cons(child_char, child_rest),
      after_input,
      ThreadActive(destination),
      history,
      capture_context,
      policy,
      child_scope_depth,
      prefix_mode,
      reversed_prefix,
      child_path_current,
      matched,
      remaining_input,
      child_selected_routine
    ),
    left_case: () -> Empty,
    left_tail_case: () -> Empty,
    right_case: () -> Empty
  ) -> Empty = atomic_path_active_child_rejection_excludes_aligned_trace(
    machine,
    child_char,
    child_rest,
    after_input,
    destination,
    history,
    capture_context,
    policy,
    child_scope_depth,
    prefix_mode,
    reversed_prefix,
    failure_whole,
    failure_current,
    failure_suffix,
    failure_nonempty,
    selected_whole,
    selected_whole_equivalence,
    selected_suffix,
    child_failure,
    child_path,
    left_case,
    left_tail_case,
    right_case
  )

  ## The recursive `Here` consumer for a rejected child whose input extends
  ## beyond the singleton leaf.  The pair retains the rejected child cursor
  ## package and the selected trace package; opening both packages at this
  ## boundary gives the existing induction theorem the exact suffixes it
  ## needs.  The selected suffix is transported back to the rejected child's
  ## outer list using the two canonical origin equalities, so no erased list
  ## is reconstructed as a runtime value.
  fn atomic_path_active_child_rejection_here_recursive_destination_pair_excludes_trace(
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    pair: AtomicPathRejectedSelectedTracePairExistentialPackage(
      depth, n, machine
    ),
    otherwise_case: () -> Empty
  ) -> Empty = match pair
    AtomicPathRejectedSelectedTracePairExistentialPacked(package) -> match package
      AtomicPathRejectedSelectedTracePairPacked(
        Cons(child_char, child_rest),
        after_input,
        ThreadActive(destination),
        history,
        capture_context,
        _,
        policy,
        child_scope_depth,
        prefix_mode,
        reversed_prefix,
        failure_whole,
        failure_current,
        _,
        failure_cursor_package,
        child_failure,
        _,
        _,
        _,
        _,
        selected_trace_package
      ) -> match child_failure
        AtomicPathDestinationRejected(
          _, _, _, _, _, _, _, _, _, _, _, _, _,
          failure_origin_equivalence,
          failure_origin_canonical,
          _, _, _, _, _, _, _
        ) -> match selected_trace_package
          AtomicSelectedPathTracePrefixDonePacked() -> otherwise_case()
          AtomicSelectedPathTraceExactDonePacked() -> otherwise_case()
          AtomicSelectedPathTraceAcceptedPacked(
            _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
          ) -> otherwise_case()
          AtomicSelectedPathTraceActivePacked(
            _, _, _, _, _, _, _, _, _, _, _, _, _, _,
            selected_origin_canonical,
            _, _, _, _, selected_cursor_package, _, _, _, child_path, _, _
          ) -> match atomic_path_search_origin_alignment(
              failure_origin_canonical,
              selected_origin_canonical
            )
              AtomicPathSearchOriginsAligned(origin_equivalence) ->
                let outer_equivalence = trans(
                  failure_origin_equivalence,
                  origin_equivalence
                )
                let failure_suffix =
                  lookaround_admitted_cursor_suffix_package_evidence(
                    failure_cursor_package
                  )
                let selected_suffix =
                  transport_lookaround_admitted_cursor_suffix_outer(
                    outer_equivalence,
                    lookaround_admitted_cursor_suffix_package_evidence(
                      selected_cursor_package
                    )
                  )
                atomic_path_active_child_rejection_excludes_trace(
                  machine,
                  child_char,
                  child_rest,
                  after_input,
                  destination,
                  history,
                  capture_context,
                  policy,
                  child_scope_depth,
                  prefix_mode,
                  reversed_prefix,
                  failure_whole,
                  failure_current,
                  failure_suffix,
                  lookaround_admitted_cursor_suffix_nonempty(failure_suffix),
                  failure_whole,
                  reflexive(),
                  selected_suffix,
                  child_failure,
                  child_path,
                  otherwise_case,
                  otherwise_case,
                  otherwise_case
                )

  ## The first strict `Here` leaf is the singleton child case.  The retained
  ## pair has already been classified as a destination rejection by the
  ## outcome dispatcher; its child input is therefore safe to inspect only as
  ## an indexed proof distinction.  A one-character child cannot expose a
  ## successful active or accepted selected trace, so reuse the existing
  ## erased terminal contradictions.  Longer children remain on the common
  ## induction path supplied by `otherwise_case`.
  @reducible
  fn atomic_path_active_child_rejection_singleton_destination_pair_excludes_trace(
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    pair: AtomicPathRejectedSelectedTracePairExistentialPackage(
      depth, n, machine
    ),
    otherwise_case: () -> Empty
  ) -> Empty = match pair
    AtomicPathRejectedSelectedTracePairExistentialPacked(package) -> match package
      AtomicPathRejectedSelectedTracePairPacked(
        rejected_child_input, _, _, _, _, _, _, _, _, _, _, _, _, _,
        child_failure, _, _, _, _, selected_trace_package
      ) -> match rejected_child_input
        Cons(_, Nil()) -> match selected_trace_package
          AtomicSelectedPathTracePrefixDonePacked() -> otherwise_case()
          AtomicSelectedPathTraceExactDonePacked() -> otherwise_case()
          AtomicSelectedPathTraceAcceptedPacked(
            _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _
          ) -> atomic_path_accepted_child_rejection_singleton_excludes_trace_erased(
            child_failure
          )
          AtomicSelectedPathTraceActivePacked(
            _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, child_trace, _, _
          ) -> atomic_path_active_child_rejection_singleton_active_excludes_trace_erased(
            child_failure,
            child_trace
          )
        Cons(_, Cons(_, _)) ->
          atomic_path_active_child_rejection_here_recursive_destination_pair_excludes_trace(
            pair,
            otherwise_case
          )
        Nil() -> otherwise_case()

  ## Restrict the singleton leaf to the relevant `Here` authority.  `There`
  ## and `Reverse` are not singleton contradictions: their retained direction
  ## is the ordered sibling induction evidence and must be passed onward.
  @reducible
  fn atomic_path_active_child_rejection_here_singleton_pair_dispatch(
    {depth: Nat},
    {n: Nat},
    {@erased machine: PatternMachine(n)},
    directional: AtomicPathActiveChildDirectionalPackage(
      depth, n, machine
    ),
    pair: AtomicPathRejectedSelectedTracePairExistentialPackage(
      depth, n, machine
    ),
    otherwise_case: () -> Empty
  ) -> Empty = match directional
    AtomicPathActiveChildDirectionalHerePacked(_) ->
      atomic_path_active_child_rejection_singleton_destination_pair_excludes_trace(
        pair,
        otherwise_case
      )
    AtomicPathActiveChildDirectionalTherePacked(_, _) -> otherwise_case()
    AtomicPathActiveChildDirectionalReversePacked(_, _) -> otherwise_case()
end
