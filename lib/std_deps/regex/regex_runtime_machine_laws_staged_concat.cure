@group(:text)
mod Std.Regex.Runtime.MachineLaws.StagedConcat
  use Std.Regex.Runtime.StateOps

  use Std.Regex.Runtime.PatternMachines

  use Std.Regex.Runtime.StagedOps

  use Std.Regex.Runtime.Compilation

  use Std.Regex.Runtime.TransitionRows

  use Std.Regex.Runtime.CaptureConditions

  use Std.Regex.Runtime.Boundaries

  use Std.Regex.Runtime.AtomicDiagnostics

  use Std.Regex.Runtime.ClassKinds

  use Std.Regex.Runtime.Named

  use Std.Regex.Runtime.Split

  use Std.Regex.Core.Capture

  use Std.Regex.Core.Boundary

  use Std.Regex.Core.Initial

  use Std.Regex.Core.Newline

  use Std.Regex.Core.Evidence

  use Std.Regex.Core.Limits

  use Std.Regex.Core

  use Std.Char

  use Std.Option

  use Std.List

  use Std.String

  use Std.Syntax

  use Std.Bounded

  use Std.Equivalent

  use Std.Sigma

  use Std.Decision

  fn staged_concat_rows_transition_equation(
    left_count: Nat,
    right_count: Nat,
    left_rows: TransitionRows(left_count),
    right_starts: List(MachineState(right_count)),
    right_rows: TransitionRows(right_count),
    state: Bounded(plus(left_count, right_count)),
    char: Char
  ) -> Equivalent(
    List(MachineState(plus(left_count, right_count))),
    transition_rows_next(rows_from_next(plus(left_count, right_count), staged_concat_next_function(left_count, left_rows, right_starts, right_rows)), state, char),
    staged_concat_next(left_count, left_rows, right_starts, right_rows, state, char)
  ) = rows_from_next_equivalent(
    plus(left_count, right_count),
    staged_concat_next_function(left_count, left_rows, right_starts, right_rows),
    state,
    char
  )
end
