" Vim syntax file for Cure programming language
" Language: Cure
" Maintainer: Cure Core Team
"
" Fallback for when the tree-sitter parser is not available. Keyword lists
" are generated by `mix cure.editors.sync`; the rest mirrors the token rules
" of tree-sitter-cure/grammar.js.

if exists("b:current_syntax")
  finish
endif

" Comments: `#`, `##` doc lines, and `###` fences closed by a line starting
" with `###`.
syn match cureComment "#.*$" contains=@Spell
syn match cureDocComment "##.*$" contains=@Spell
syn region cureDocComment start="###" end="^\s*###.*$" contains=@Spell

" BEGIN generated by mix cure.editors.sync
syn keyword cureKeyword mod fn let type typealias opaque primitive indexed indices rec proto impl local use as interface implementation deriving match pickup if elif else then for do end in try catch finally throw return yield spawn send receive after when where extern quote unsafe
syn keyword cureOperatorWord and or not band bor bxor bsl bsr bnot
syn keyword cureBoolean true false
syn keyword cureNil nil
syn match cureContainer "\<\(actor\|app\|behavior\|fsm\|sup\|proof\)\ze\s\+\u"
" END generated by mix cure.editors.sync

" Contextual keywords: identifiers except in these positions.
syn match cureKeyword "^\s*\zs\(have\)\ze\s\+\l"
syn match cureKeyword "\<requires\ze\s\+\u"
syn match cureKeyword "^\s*\zs\(precedencegroup\)\ze\s\+\u"
syn match cureKeyword "^\s*\zs\(infix\|prefix\|postfix\)\ze\s\+`"
syn match cureKeyword "\<proof\s\+chain\>"
syn match cureKeyword "^\s*\zs\(because\)\>"

" Macro entries: these words only mean something at the start of a line.
syn match cureKeyword "^\s*\zs\(syntax\|accepts\|expands\|literal\|example\|explain\|fail\|open\|includes\|optional\|repeated\|one_or_more\|keyword\)\>"
syn match cureKeyword "\<\(syntax\s\+family\|expands\s\+with\|computed\s\+\(directly\s\+\)\=by\)\>"
syn match cureKeyword "\<\(becomes\|contextual\)\>"
syn match cureKeyword ">\s*\zs\(is\)\>"

" Lifecycle callbacks in container bodies: `on_start`, `on_transition`, ...
syn match cureCallback "^\s*\zson_[a-z_]\+\>"

" Declarations
" (lookbehind: `fn` is a keyword, and keywords win at their own position)
syn match cureFunction "\(\<fn\s\+\)\@<=[a-z_][a-zA-Z0-9_$]*?\?"

" Decorators: `@extern(...)`, `@derive`, `@linear`
syn match cureDecorator "@[a-z_][a-zA-Z0-9_]*"

" Builtin Constructors
syn keyword cureConstructor Ok Error Some None True False Z S

" Types and modules
syn match cureType "\<\u[a-zA-Z0-9_]*\>"

" Strings & Interpolation
syn region cureString start='"' skip='\\\\\|\\"' end='"' contains=cureEscape,cureInterpolation,@Spell
syn match cureEscape "\\." contained
syn region cureInterpolation matchgroup=cureInterpolationDelimiter start="#{" end="}" contained contains=TOP

" Chars and regexes
syn match cureChar "'''"
syn match cureChar "'[^'\\]'"
syn match cureChar "'\\.[^']*'"
syn match cureRegex "\~r/\([^/\\]\|\\.\)*/[a-zA-Z]*"

" Atoms and holes
syn match cureAtom ":[a-zA-Z_][a-zA-Z0-9_]*[?!]\?"
syn match cureHole "?[a-zA-Z_][a-zA-Z0-9_]*"

" Numbers
syn match cureNumber "\<0[xX][0-9a-fA-F_]\+\>"
syn match cureNumber "\<0[bB][01_]\+\>"
syn match cureNumber "\<0[oO][0-7_]\+\>"
syn match cureNumber "\<[0-9][0-9_]*\(\.[0-9][0-9_]*\)\?\([eE][+-]\?[0-9]\+\)\?\>"

" Operators & Special Punctuation
syn match cureOperator "[=|&\-+*/%<>!^~\\]\+"
syn match cureArrow "->"
syn match cureFatArrow "=>"
syn match cureMelquiades "<-|"
syn match cureMelquiades "✉"
syn match curePipe "|>"

" FSM transitions: `Locked --coin--> Unlocked`. After the operators, so they
" win at the same position.
syn match cureTransition "--[a-zA-Z_][a-zA-Z0-9_]*?\?"
syn match cureTransition "!\?-->"

" Highlight Links
hi def link cureComment Comment
hi def link cureDocComment SpecialComment
hi def link cureKeyword Keyword
hi def link cureOperatorWord Operator
hi def link cureContainer Structure
hi def link cureCallback Special
hi def link cureFunction Function
hi def link cureDecorator PreProc
hi def link cureTransition Label
hi def link cureBoolean Boolean
hi def link cureNil Constant
hi def link cureConstructor Constant
hi def link cureType Type
hi def link cureString String
hi def link cureEscape SpecialChar
hi def link cureInterpolationDelimiter Delimiter
hi def link cureChar Character
hi def link cureRegex String
hi def link cureAtom Constant
hi def link cureHole Identifier
hi def link cureNumber Number
hi def link cureOperator Operator
hi def link cureArrow Operator
hi def link cureFatArrow Operator
hi def link cureMelquiades Special
hi def link curePipe Special

let b:current_syntax = "cure"
