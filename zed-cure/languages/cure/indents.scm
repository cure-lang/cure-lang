; Indentation rules for Cure in Zed

[
  (module_declaration)
  (function_declaration)
  (type_declaration)
  (record_declaration)
  (actor_declaration)
  (fsm_declaration)
  (match_expression)
  (if_expression)
  (pickup_expression)
] @indent

[
  "elif"
  "else"
  "catch"
  "finally"
  "after"
] @outdent
